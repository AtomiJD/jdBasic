OPTION EXPLICIT

' A REPL for the jdBasic kernel target: screen, keyboard and a small
' interpreter, all in jdBasic. Modules route calls through the VM bridge, which
' ring 0 does not have, so this image is one file.
'
' Screen positions, scancodes and scanner offsets are INTEGER; DOUBLE carries
' the values the interpreter computes, so 10/4 stays 2.5.

CONST VGA_BASE = $B8000
CONST SCR_COLS = 80
CONST SCR_ROWS = 25
CONST CRTC_INDEX = $3D4
CONST CRTC_DATA = $3D5
CONST KBD_DATA = $60
CONST KBD_STATUS = $64

CONST KEY_ESC = 27
CONST KEY_BACK = 8
CONST KEY_ENTER = 13

CONST MAX_VARS = 64

CONST K_UP = 256
CONST K_DOWN = 257
CONST K_LEFT = 258
CONST K_RIGHT = 259
CONST K_HOME = 260
CONST K_END = 261
CONST K_DEL = 262
CONST K_PGUP = 263
CONST K_PGDN = 264
CONST K_F2 = 265
CONST K_F5 = 266

CONST ED_MAXLINES = 200
CONST ED_ROWS = 23
CONST DSK_MAX = 16

DIM scrAttr AS INTEGER
DIM scrPos AS INTEGER

DIM kbBase[128]
DIM kbShift[128]
DIM kbAltgr[128]
DIM kbShiftDown AS INTEGER
DIM kbAltgrDown AS INTEGER
DIM kbExtended AS INTEGER
DIM lineExit AS INTEGER

DIM edLines[ED_MAXLINES] AS STRING
DIM edCount AS INTEGER
DIM edRow AS INTEGER
DIM edCol AS INTEGER
DIM edTop AS INTEGER

DIM dskNames[DSK_MAX] AS STRING
DIM dskText[DSK_MAX] AS STRING
DIM dskCount AS INTEGER

DIM srcText AS STRING
DIM cur AS INTEGER
DIM errCode AS INTEGER

DIM varNames[MAX_VARS] AS STRING
DIM varVals[MAX_VARS]
DIM varCount AS INTEGER

' ── Screen ─────────────────────────────────────────────────────────────────

SUB SCR_CURSOR(idx AS INTEGER)
    SYS.OUTB(CRTC_INDEX, 15)
    SYS.OUTB(CRTC_DATA, idx MOD 256)
    SYS.OUTB(CRTC_INDEX, 14)
    SYS.OUTB(CRTC_DATA, (idx \ 256) MOD 256)
ENDSUB

SUB SCR_CELL(idx AS INTEGER, ch AS INTEGER, attr AS INTEGER)
    SYS.POKEW(VGA_BASE + idx * 2, attr * 256 + ch)
ENDSUB

SUB SCR_CLEAR()
    DIM i AS INTEGER
    FOR i = 0 TO SCR_COLS * SCR_ROWS - 1
        SCR_CELL(i, 32, scrAttr)
    NEXT i
    scrPos = 0
    SCR_CURSOR(0)
ENDSUB

SUB SCR_SCROLL()
    DIM i AS INTEGER
    DIM last AS INTEGER
    last = (SCR_ROWS - 1) * SCR_COLS
    FOR i = 0 TO last - 1
        SYS.POKEW(VGA_BASE + i * 2, SYS.PEEKW(VGA_BASE + (i + SCR_COLS) * 2))
    NEXT i
    FOR i = last TO SCR_COLS * SCR_ROWS - 1
        SCR_CELL(i, 32, scrAttr)
    NEXT i
    scrPos = last
ENDSUB

SUB SCR_NEWLINE()
    scrPos = (scrPos \ SCR_COLS + 1) * SCR_COLS
    IF scrPos >= SCR_COLS * SCR_ROWS THEN
        SCR_SCROLL()
    ENDIF
    SCR_CURSOR(scrPos)
ENDSUB

SUB SCR_PUTCHAR(ch AS INTEGER)
    IF ch = 10 THEN
        SCR_NEWLINE()
    ELSE
        SCR_CELL(scrPos, ch, scrAttr)
        scrPos = scrPos + 1
        IF scrPos >= SCR_COLS * SCR_ROWS THEN
            SCR_SCROLL()
        ENDIF
        SCR_CURSOR(scrPos)
    ENDIF
ENDSUB

SUB SCR_BACKSPACE()
    IF scrPos > 0 THEN
        scrPos = scrPos - 1
        SCR_CELL(scrPos, 32, scrAttr)
        SCR_CURSOR(scrPos)
    ENDIF
ENDSUB

SUB SCR_WRITE(msg AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(msg) - 1
        SCR_PUTCHAR(BYTEAT(msg, i))
    NEXT i
ENDSUB

SUB SCR_WRITELN(msg AS STRING)
    SCR_WRITE(msg)
    SCR_NEWLINE()
ENDSUB

SUB SCR_WRITEINT(v AS DOUBLE)
    DIM digits AS STRING
    DIM n AS INTEGER
    n = CINT(v)
    IF n < 0 THEN
        SCR_PUTCHAR(45)
        n = 0 - n
    ENDIF
    IF n = 0 THEN
        SCR_PUTCHAR(48)
        RETURN
    ENDIF
    digits = ""
    DO
        digits = CHR$(48 + n MOD 10) + digits
        n = n \ 10
    LOOP WHILE n > 0
    SCR_WRITE(digits)
ENDSUB

' Whole numbers print bare, anything else gets six decimals.
SUB SCR_WRITEVAL(v AS DOUBLE)
    DIM whole AS INTEGER
    DIM frac AS DOUBLE
    DIM i AS INTEGER
    DIM digit AS INTEGER

    frac = v
    IF frac < 0 THEN frac = 0 - frac
    whole = CINT(frac)
    frac = frac - whole

    IF frac = 0 THEN
        SCR_WRITEINT(v)
        RETURN
    ENDIF

    IF v < 0 THEN SCR_PUTCHAR(45)
    SCR_WRITEINT(whole)
    SCR_PUTCHAR(46)
    FOR i = 1 TO 6
        frac = frac * 10
        digit = CINT(frac)
        SCR_PUTCHAR(48 + digit)
        frac = frac - digit
    NEXT i
ENDSUB

' ── Keyboard ───────────────────────────────────────────────────────────────

SUB KB_ROW(startCode AS INTEGER, chars AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(chars) - 1
        kbBase[startCode + i] = BYTEAT(chars, i)
    NEXT i
ENDSUB

SUB KB_INIT()
    DIM i AS INTEGER

    FOR i = 0 TO 127
        kbBase[i] = 0
        kbShift[i] = 0
        kbAltgr[i] = 0
    NEXT i

    KB_ROW(2, "1234567890")
    KB_ROW(16, "qwertzuiop")
    KB_ROW(30, "asdfghjkl")
    KB_ROW(44, "yxcvbnm")

    kbBase[12] = 225
    kbBase[26] = 129
    kbBase[27] = 43
    kbBase[39] = 148
    kbBase[40] = 132
    kbBase[41] = 94
    kbBase[43] = 35
    kbBase[51] = 44
    kbBase[52] = 46
    kbBase[53] = 45
    kbBase[57] = 32
    kbBase[86] = 60

    FOR i = 0 TO 127
        IF kbBase[i] >= 97 AND kbBase[i] <= 122 THEN
            kbShift[i] = kbBase[i] - 32
        ELSE
            kbShift[i] = kbBase[i]
        ENDIF
    NEXT i

    kbShift[2] = 33
    kbShift[3] = 34
    kbShift[4] = 21
    kbShift[5] = 36
    kbShift[6] = 37
    kbShift[7] = 38
    kbShift[8] = 47
    kbShift[9] = 40
    kbShift[10] = 41
    kbShift[11] = 61
    kbShift[12] = 63
    kbShift[26] = 154
    kbShift[27] = 42
    kbShift[39] = 153
    kbShift[40] = 142
    kbShift[41] = 248
    kbShift[43] = 39
    kbShift[51] = 59
    kbShift[52] = 58
    kbShift[53] = 95
    kbShift[86] = 62

    kbAltgr[8] = 123
    kbAltgr[9] = 91
    kbAltgr[10] = 93
    kbAltgr[11] = 125
    kbAltgr[12] = 92
    kbAltgr[16] = 64
    kbAltgr[27] = 126
    kbAltgr[86] = 124

    kbShiftDown = 0
    kbAltgrDown = 0
    kbExtended = 0
ENDSUB

FUNC KB_EXTENDED(code AS INTEGER) AS INTEGER
    IF code = 72 THEN RETURN K_UP
    IF code = 80 THEN RETURN K_DOWN
    IF code = 75 THEN RETURN K_LEFT
    IF code = 77 THEN RETURN K_RIGHT
    IF code = 71 THEN RETURN K_HOME
    IF code = 79 THEN RETURN K_END
    IF code = 83 THEN RETURN K_DEL
    IF code = 73 THEN RETURN K_PGUP
    IF code = 81 THEN RETURN K_PGDN
    RETURN 0
ENDFUNC

FUNC KB_ASCII(code AS INTEGER) AS INTEGER
    IF code = 1 THEN RETURN KEY_ESC
    IF code = 60 THEN RETURN K_F2
    IF code = 63 THEN RETURN K_F5
    IF code = 14 THEN RETURN KEY_BACK
    IF code = 28 THEN RETURN KEY_ENTER
    IF code > 127 THEN RETURN 0
    IF kbAltgrDown = 1 THEN RETURN kbAltgr[code]
    IF kbShiftDown = 1 THEN RETURN kbShift[code]
    RETURN kbBase[code]
ENDFUNC

FUNC KB_READ() AS INTEGER
    DIM kbStatus AS INTEGER
    DIM code AS INTEGER
    DIM ch AS INTEGER

    DO
        kbStatus = SYS.INB(KBD_STATUS)
        IF (kbStatus MOD 2) = 1 THEN
            code = SYS.INB(KBD_DATA)

            IF code = 224 THEN
                kbExtended = 1
            ELSE
                IF code >= 128 THEN
                    code = code - 128
                    IF code = 42 OR code = 54 THEN kbShiftDown = 0
                    IF code = 56 AND kbExtended = 1 THEN kbAltgrDown = 0
                    kbExtended = 0
                ELSE
                    IF code = 42 OR code = 54 THEN
                        kbShiftDown = 1
                        kbExtended = 0
                    ELSE
                        IF code = 56 AND kbExtended = 1 THEN
                            kbAltgrDown = 1
                            kbExtended = 0
                        ELSE
                            IF kbExtended = 1 THEN
                                kbExtended = 0
                                ch = CINT(KB_EXTENDED(code))
                            ELSE
                                ch = CINT(KB_ASCII(code))
                            ENDIF
                            IF ch > 0 THEN RETURN ch
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    LOOP
ENDFUNC

' lineExit reports how the line ended: 0 Enter, 1 ESC, 2 F2.
FUNC KB_READLINE$() AS STRING
    DIM buf AS STRING
    DIM ch AS INTEGER
    buf = ""
    lineExit = 0
    DO
        ch = CINT(KB_READ())
        IF ch = KEY_ENTER THEN
            SCR_NEWLINE()
            RETURN buf
        ENDIF
        IF ch = KEY_ESC THEN
            lineExit = 1
            RETURN buf
        ENDIF
        IF ch = K_F2 THEN
            lineExit = 2
            RETURN buf
        ENDIF
        IF ch = KEY_BACK THEN
            IF LEN(buf) > 0 THEN
                buf = LEFT$(buf, LEN(buf) - 1)
                SCR_BACKSPACE()
            ENDIF
        ELSE
            IF ch >= 32 AND ch < 256 THEN
                buf = buf + CHR$(ch)
                SCR_PUTCHAR(ch)
            ENDIF
        ENDIF
    LOOP
ENDFUNC

' ── Variables ──────────────────────────────────────────────────────────────

FUNC VAR_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO varCount - 1
        IF varNames[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

FUNC VAR_GET(nm AS STRING) AS DOUBLE
    DIM idx AS INTEGER
    idx = CINT(VAR_FIND(nm))
    IF idx < 0 THEN RETURN 0
    RETURN varVals[idx]
ENDFUNC

SUB VAR_SET(nm AS STRING, v AS DOUBLE)
    DIM idx AS INTEGER
    idx = CINT(VAR_FIND(nm))
    IF idx >= 0 THEN
        varVals[idx] = v
        RETURN
    ENDIF
    IF varCount >= MAX_VARS THEN

        errCode = 6
        RETURN
    ENDIF
    varNames[varCount] = nm
    varVals[varCount] = v
    varCount = varCount + 1
ENDSUB

' ── Scanner ────────────────────────────────────────────────────────────────

FUNC PEEKC() AS INTEGER
    IF cur >= LEN(srcText) THEN RETURN 0
    RETURN BYTEAT(srcText, cur)
ENDFUNC

FUNC PEEKC2() AS INTEGER
    IF cur + 1 >= LEN(srcText) THEN RETURN 0
    RETURN BYTEAT(srcText, cur + 1)
ENDFUNC

SUB SKIPSP()
    DIM c AS INTEGER
    DO
        c = CINT(PEEKC())
        IF c <> 32 AND c <> 9 AND c <> 10 AND c <> 13 THEN RETURN
        cur = cur + 1
    LOOP
ENDSUB

FUNC IS_DIGIT(c AS INTEGER) AS INTEGER
    IF c >= 48 AND c <= 57 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_ALPHA(c AS INTEGER) AS INTEGER
    IF c >= 97 AND c <= 122 THEN RETURN 1
    IF c >= 65 AND c <= 90 THEN RETURN 1
    IF c = 95 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC SCAN_NUMBER() AS DOUBLE
    DIM v AS DOUBLE
    DIM scale AS DOUBLE
    v = 0
    DO
        IF IS_DIGIT(PEEKC()) = 0 THEN EXITDO
        v = v * 10 + (PEEKC() - 48)
        cur = cur + 1
    LOOP
    IF PEEKC() = 46 AND IS_DIGIT(PEEKC2()) = 1 THEN
        cur = cur + 1
        scale = 1
        DO
            IF IS_DIGIT(PEEKC()) = 0 THEN EXITDO
            scale = scale / 10
            v = v + (PEEKC() - 48) * scale
            cur = cur + 1
        LOOP
    ENDIF
    RETURN v
ENDFUNC

FUNC SCAN_IDENT$() AS STRING
    DIM start AS INTEGER
    start = cur
    DO
        IF IS_ALPHA(PEEKC()) = 0 AND IS_DIGIT(PEEKC()) = 0 THEN EXITDO
        cur = cur + 1
    LOOP
    RETURN MID$(srcText, start, cur - start)
ENDFUNC

' True when the word at the cursor is exactly lit, not a longer identifier.
FUNC SCAN_KEYWORD(lit AS STRING) AS INTEGER
    DIM after AS INTEGER
    SKIPSP()
    IF MID$(srcText, cur, LEN(lit)) <> lit THEN RETURN 0
    after = cur + LEN(lit)
    IF after < LEN(srcText) THEN
        IF IS_ALPHA(BYTEAT(srcText, after)) = 1 THEN RETURN 0
        IF IS_DIGIT(BYTEAT(srcText, after)) = 1 THEN RETURN 0
    ENDIF
    cur = after
    RETURN 1
ENDFUNC

' ── Expressions ────────────────────────────────────────────────────────────


FUNC EVAL_FACTOR() AS DOUBLE
    DIM v AS DOUBLE
    DIM nm AS STRING

    SKIPSP()

    IF PEEKC() = 45 THEN
        cur = cur + 1
        RETURN 0 - EVAL_FACTOR()
    ENDIF

    IF PEEKC() = 40 THEN
        cur = cur + 1
        v = EVAL_COMPARE()
        SKIPSP()
        IF PEEKC() <> 41 THEN

            errCode = 1
            RETURN 0
        ENDIF
        cur = cur + 1
        RETURN v
    ENDIF

    IF IS_DIGIT(PEEKC()) = 1 THEN RETURN SCAN_NUMBER()

    IF IS_ALPHA(PEEKC()) = 1 THEN
        nm = SCAN_IDENT$()
        RETURN VAR_GET(nm)
    ENDIF


    errCode = 3
    RETURN 0
ENDFUNC

FUNC EVAL_TERM() AS DOUBLE
    DIM v AS DOUBLE
    DIM rhs AS DOUBLE
    DIM op AS INTEGER

    v = EVAL_FACTOR()
    DO
        IF errCode > 0 THEN RETURN v
        SKIPSP()
        op = CINT(PEEKC())
        IF op <> 42 AND op <> 47 AND op <> 37 THEN RETURN v
        cur = cur + 1
        rhs = EVAL_FACTOR()
        IF op = 42 THEN
            v = v * rhs
        ELSE
            IF rhs = 0 THEN

                errCode = 2
                RETURN 0
            ENDIF
            IF op = 47 THEN
                v = v / rhs
            ELSE
                v = v MOD rhs
            ENDIF
        ENDIF
    LOOP
ENDFUNC

FUNC EVAL_EXPR() AS DOUBLE
    DIM v AS DOUBLE
    DIM op AS INTEGER

    v = EVAL_TERM()
    DO
        IF errCode > 0 THEN RETURN v
        SKIPSP()
        op = CINT(PEEKC())
        IF op <> 43 AND op <> 45 THEN RETURN v
        cur = cur + 1
        IF op = 43 THEN
            v = v + EVAL_TERM()
        ELSE
            v = v - EVAL_TERM()
        ENDIF
    LOOP
ENDFUNC

' Assignment uses a single =, so comparison for equality is ==.
FUNC EVAL_COMPARE() AS DOUBLE
    DIM lhs AS DOUBLE
    DIM rhs AS DOUBLE
    DIM c1 AS INTEGER
    DIM c2 AS INTEGER
    DIM kind AS INTEGER

    lhs = EVAL_EXPR()
    IF errCode > 0 THEN RETURN lhs

    SKIPSP()
    c1 = CINT(PEEKC())
    c2 = CINT(PEEKC2())
    kind = 0

    IF c1 = 61 AND c2 = 61 THEN kind = 1
    IF c1 = 60 AND c2 = 62 THEN kind = 2
    IF c1 = 60 AND c2 = 61 THEN kind = 3
    IF c1 = 62 AND c2 = 61 THEN kind = 4

    IF kind > 0 THEN
        cur = cur + 2
    ELSE
        IF c1 = 60 THEN kind = 5
        IF c1 = 62 THEN kind = 6
        IF kind = 0 THEN RETURN lhs
        cur = cur + 1
    ENDIF

    rhs = EVAL_EXPR()
    IF errCode > 0 THEN RETURN 0

    IF kind = 1 AND lhs = rhs THEN RETURN 1
    IF kind = 2 AND lhs <> rhs THEN RETURN 1
    IF kind = 3 AND lhs <= rhs THEN RETURN 1
    IF kind = 4 AND lhs >= rhs THEN RETURN 1
    IF kind = 5 AND lhs < rhs THEN RETURN 1
    IF kind = 6 AND lhs > rhs THEN RETURN 1
    RETURN 0
ENDFUNC

' ── Statements ─────────────────────────────────────────────────────────────

FUNC ERR_TEXT$(code AS INTEGER) AS STRING
    IF code = 1 THEN RETURN "expected )"
    IF code = 2 THEN RETURN "division by zero"
    IF code = 3 THEN RETURN "unexpected character"
    IF code = 4 THEN RETURN "expected {"
    IF code = 5 THEN RETURN "unclosed {"
    IF code = 6 THEN RETURN "too many variables"
    IF code = 7 THEN RETURN "loop ran too long"
    IF code = 8 THEN RETURN "too many functions"
    IF code = 9 THEN RETURN "too many parameters"
    IF code = 10 THEN RETURN "unknown function"
    IF code = 11 THEN RETURN "return outside a function"
    RETURN "error"
ENDFUNC


' Steps the cursor past a brace-delimited block without executing it.
SUB SKIP_BLOCK()
    DIM depth AS INTEGER
    DIM c AS INTEGER
    SKIPSP()
    IF PEEKC() <> 123 THEN

        errCode = 4
        RETURN
    ENDIF
    depth = 0
    DO
        c = CINT(PEEKC())
        IF c = 0 THEN

            errCode = 5
            RETURN
        ENDIF
        IF c = 123 THEN depth = depth + 1
        IF c = 125 THEN depth = depth - 1
        cur = cur + 1
        IF depth = 0 THEN RETURN
    LOOP
ENDSUB

SUB RUN_BLOCK()
    SKIPSP()
    IF PEEKC() <> 123 THEN

        errCode = 4
        RETURN
    ENDIF
    cur = cur + 1
    DO
        IF errCode > 0 THEN RETURN
        SKIPSP()
        IF PEEKC() = 125 THEN
            cur = cur + 1
            RETURN
        ENDIF
        IF PEEKC() = 0 THEN

            errCode = 5
            RETURN
        ENDIF
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            RUN_STATEMENT()
        ENDIF
    LOOP
ENDSUB

SUB RUN_IF()
    IF EVAL_COMPARE() <> 0 THEN
        RUN_BLOCK()
    ELSE
        SKIP_BLOCK()
    ENDIF
ENDSUB

SUB RUN_WHILE()
    DIM condPos AS INTEGER
    DIM guard AS INTEGER
    condPos = cur
    guard = 0
    DO
        IF errCode > 0 THEN RETURN
        guard = guard + 1
        IF guard > 1000000 THEN

            errCode = 7
            RETURN
        ENDIF
        cur = condPos
        IF EVAL_COMPARE() = 0 THEN
            SKIP_BLOCK()
            RETURN
        ENDIF
        RUN_BLOCK()
    LOOP
ENDSUB

SUB RUN_STATEMENT()
    DIM nm AS STRING
    DIM savePos AS INTEGER
    DIM discard AS DOUBLE
    DIM shown AS DOUBLE

    SKIPSP()
    IF PEEKC() = 0 THEN RETURN

    IF PEEKC() = 63 THEN
        cur = cur + 1
        shown = EVAL_COMPARE()
        IF errCode = 0 THEN
            SCR_WRITEVAL(shown)
            SCR_NEWLINE()
        ENDIF
        RETURN
    ENDIF

    IF SCAN_KEYWORD("if") = 1 THEN
        RUN_IF()
        RETURN
    ENDIF

    IF SCAN_KEYWORD("while") = 1 THEN
        RUN_WHILE()
        RETURN
    ENDIF

    ' An identifier followed by a lone = is an assignment; == falls through
    ' to the expression path.
    IF IS_ALPHA(PEEKC()) = 1 THEN
        savePos = cur
        nm = SCAN_IDENT$()
        SKIPSP()
        IF PEEKC() = 61 AND PEEKC2() <> 61 THEN
            cur = cur + 1
            VAR_SET(nm, EVAL_COMPARE())
            RETURN
        ENDIF
        cur = savePos
    ENDIF

    discard = EVAL_COMPARE()
ENDSUB

' Interprets one line of source.
SUB RUN_TEXT(lineIn AS STRING)
    srcText = lineIn
    RUN_LINE()
ENDSUB

SUB RUN_LINE()
    cur = 0
    errCode = 0
    DO
        IF errCode > 0 THEN EXITDO
        SKIPSP()
        IF PEEKC() = 0 THEN EXITDO
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            RUN_STATEMENT()
        ENDIF
    LOOP
    IF errCode > 0 THEN
        scrAttr = 12
        SCR_WRITE("error: ")
        SCR_WRITELN(ERR_TEXT$(errCode))
        scrAttr = 7
    ENDIF
ENDSUB

' ── Editor ─────────────────────────────────────────────────────────────────
'
' Lines are held one per array slot, so an edit rewrites a single line rather
' than the whole buffer. lallang keeps one flat byte buffer and rescans it for
' every line boundary, which is what a language without arrays forces.

SUB ED_INIT()
    DIM i AS INTEGER
    FOR i = 0 TO ED_MAXLINES - 1
        edLines[i] = ""
    NEXT i
    edCount = 1
    edRow = 0
    edCol = 0
    edTop = 0
ENDSUB

SUB ED_CLAMP()
    IF edRow < 0 THEN edRow = 0
    IF edRow > edCount - 1 THEN edRow = edCount - 1
    IF edCol < 0 THEN edCol = 0
    IF edCol > LEN(edLines[edRow]) THEN edCol = LEN(edLines[edRow])
ENDSUB

SUB ED_INSERT(ch AS INTEGER)
    DIM s AS STRING
    s = edLines[edRow]
    edLines[edRow] = LEFT$(s, edCol) + CHR$(ch) + MID$(s, edCol, LEN(s) - edCol)
    edCol = edCol + 1
ENDSUB

SUB ED_ENTER()
    DIM s AS STRING
    DIM i AS INTEGER
    IF edCount >= ED_MAXLINES THEN RETURN
    s = edLines[edRow]
    FOR i = edCount TO edRow + 1 STEP -1
        edLines[i] = edLines[i - 1]
    NEXT i
    edLines[edRow] = LEFT$(s, edCol)
    edLines[edRow + 1] = MID$(s, edCol, LEN(s) - edCol)
    edCount = edCount + 1
    edRow = edRow + 1
    edCol = 0
ENDSUB

SUB ED_JOIN(row AS INTEGER)
    DIM i AS INTEGER
    IF row < 0 THEN RETURN
    IF row >= edCount - 1 THEN RETURN
    edLines[row] = edLines[row] + edLines[row + 1]
    FOR i = row + 1 TO edCount - 2
        edLines[i] = edLines[i + 1]
    NEXT i
    edLines[edCount - 1] = ""
    edCount = edCount - 1
ENDSUB

SUB ED_BACKSPACE()
    DIM s AS STRING
    IF edCol > 0 THEN
        s = edLines[edRow]
        edLines[edRow] = LEFT$(s, edCol - 1) + MID$(s, edCol, LEN(s) - edCol)
        edCol = edCol - 1
        RETURN
    ENDIF
    IF edRow = 0 THEN RETURN
    edCol = LEN(edLines[edRow - 1])
    ED_JOIN(edRow - 1)
    edRow = edRow - 1
ENDSUB

SUB ED_DELETE()
    DIM s AS STRING
    s = edLines[edRow]
    IF edCol < LEN(s) THEN
        edLines[edRow] = LEFT$(s, edCol) + MID$(s, edCol + 1, LEN(s) - edCol - 1)
        RETURN
    ENDIF
    ED_JOIN(edRow)
ENDSUB

' ── Rendering ──────────────────────────────────────────────────────────────

FUNC ED_CLASSIFY(word AS STRING) AS INTEGER
    IF word = "if" THEN RETURN 13
    IF word = "while" THEN RETURN 13
    RETURN 10
ENDFUNC

SUB ED_DRAWLINE(screenRow AS INTEGER, msg AS STRING)
    DIM base AS INTEGER
    DIM j AS INTEGER
    DIM c AS INTEGER
    DIM wordStart AS INTEGER
    DIM attr AS INTEGER
    DIM k AS INTEGER

    base = screenRow * SCR_COLS
    j = 0
    DO
        IF j >= LEN(msg) THEN EXITDO
        c = CINT(BYTEAT(msg, j))

        IF c = 39 THEN
            DO
                IF j >= LEN(msg) THEN EXITDO
                IF j >= SCR_COLS THEN EXITDO
                SCR_CELL(base + j, CINT(BYTEAT(msg, j)), 8)
                j = j + 1
            LOOP
            EXITDO
        ENDIF

        IF IS_DIGIT(c) = 1 THEN
            DO
                IF j >= LEN(msg) THEN EXITDO
                IF IS_DIGIT(CINT(BYTEAT(msg, j))) = 0 THEN EXITDO
                IF j < SCR_COLS THEN SCR_CELL(base + j, CINT(BYTEAT(msg, j)), 14)
                j = j + 1
            LOOP
        ELSE
            IF IS_ALPHA(c) = 1 THEN
                wordStart = j
                DO
                    IF j >= LEN(msg) THEN EXITDO
                    IF IS_ALPHA(CINT(BYTEAT(msg, j))) = 0 AND IS_DIGIT(CINT(BYTEAT(msg, j))) = 0 THEN EXITDO
                    j = j + 1
                LOOP
                attr = CINT(ED_CLASSIFY(MID$(msg, wordStart, j - wordStart)))
                FOR k = wordStart TO j - 1
                    IF k < SCR_COLS THEN SCR_CELL(base + k, CINT(BYTEAT(msg, k)), attr)
                NEXT k
            ELSE
                IF j < SCR_COLS THEN SCR_CELL(base + j, c, 15)
                j = j + 1
            ENDIF
        ENDIF
    LOOP

    DO
        IF j >= SCR_COLS THEN EXITDO
        SCR_CELL(base + j, 32, 7)
        j = j + 1
    LOOP
ENDSUB

SUB ED_BAR(screenRow AS INTEGER, msg AS STRING, attr AS INTEGER)
    DIM base AS INTEGER
    DIM j AS INTEGER
    base = screenRow * SCR_COLS
    FOR j = 0 TO SCR_COLS - 1
        IF j < LEN(msg) THEN
            SCR_CELL(base + j, CINT(BYTEAT(msg, j)), attr)
        ELSE
            SCR_CELL(base + j, 32, attr)
        ENDIF
    NEXT j
ENDSUB

FUNC ED_NUM$(v AS INTEGER) AS STRING
    DIM digits AS STRING
    DIM n AS INTEGER
    n = v
    IF n = 0 THEN RETURN "0"
    digits = ""
    DO
        digits = CHR$(48 + n MOD 10) + digits
        n = n \ 10
    LOOP WHILE n > 0
    RETURN digits
ENDFUNC

SUB ED_SCROLL()
    IF edRow < edTop THEN edTop = edRow
    IF edRow > edTop + ED_ROWS - 1 THEN edTop = edRow - ED_ROWS + 1
    IF edTop < 0 THEN edTop = 0
ENDSUB

SUB ED_RENDER()
    DIM sr AS INTEGER
    DIM lineNo AS INTEGER
    DIM base AS INTEGER
    DIM j AS INTEGER
    DIM status AS STRING

    ED_SCROLL()
    FOR sr = 0 TO ED_ROWS - 1
        lineNo = edTop + sr
        IF lineNo < edCount THEN
            ED_DRAWLINE(sr, edLines[lineNo])
        ELSE
            base = sr * SCR_COLS
            SCR_CELL(base, 126, 9)
            FOR j = 1 TO SCR_COLS - 1
                SCR_CELL(base + j, 32, 7)
            NEXT j
        ENDIF
    NEXT sr

    status = " line " + ED_NUM$(edRow + 1) + "/" + ED_NUM$(edCount)
    status = status + "   col " + ED_NUM$(edCol + 1)
    ED_BAR(ED_ROWS, status, 112)
    ED_BAR(ED_ROWS + 1, " F5 run   ESC back to the prompt   arrows move", 112)

    SCR_CURSOR((edRow - edTop) * SCR_COLS + edCol)
ENDSUB

' ── Running the buffer ─────────────────────────────────────────────────────

SUB ED_RUN()
    DIM i AS INTEGER
    DIM discard AS INTEGER
    scrAttr = 7
    SCR_CLEAR()
    FOR i = 0 TO edCount - 1
        IF LEN(edLines[i]) > 0 THEN
            RUN_TEXT(edLines[i])
        ENDIF
    NEXT i
    SCR_NEWLINE()
    scrAttr = 15
    SCR_WRITE("-- press a key --")
    scrAttr = 7
    discard = CINT(KB_READ())
ENDSUB

SUB ED_MAIN()
    DIM ch AS INTEGER
    DIM j AS INTEGER

    DO
        ED_RENDER()
        ch = CINT(KB_READ())

        IF ch = KEY_ESC THEN RETURN
        IF ch = K_F5 THEN ED_RUN()
        IF ch = K_UP THEN edRow = edRow - 1
        IF ch = K_DOWN THEN edRow = edRow + 1
        IF ch = K_LEFT THEN edCol = edCol - 1
        IF ch = K_RIGHT THEN edCol = edCol + 1
        IF ch = K_HOME THEN edCol = 0
        IF ch = K_END THEN edCol = LEN(edLines[edRow])
        IF ch = K_PGUP THEN edRow = edRow - ED_ROWS
        IF ch = K_PGDN THEN edRow = edRow + ED_ROWS
        IF ch = K_DEL THEN ED_DELETE()
        IF ch = KEY_BACK THEN ED_BACKSPACE()
        IF ch = KEY_ENTER THEN ED_ENTER()
        IF ch = 9 THEN
            FOR j = 1 TO 4
                ED_INSERT(32)
            NEXT j
        ENDIF
        IF ch >= 32 AND ch < 256 THEN ED_INSERT(ch)

        ED_CLAMP()
    LOOP
ENDSUB

' ── RAM disk and commands ──────────────────────────────────────────────────
'
' Programs are kept as one string per slot with CHR$(10) between lines, so the
' whole disk is two string arrays. A line whose first character is an uppercase
' letter is a command rather than code.

FUNC IS_UPPER(c AS INTEGER) AS INTEGER
    IF c >= 65 AND c <= 90 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC ED_TEXT$() AS STRING
    DIM out AS STRING
    DIM i AS INTEGER
    out = ""
    FOR i = 0 TO edCount - 1
        IF i > 0 THEN out = out + CHR$(10)
        out = out + edLines[i]
    NEXT i
    RETURN out
ENDFUNC

SUB ED_SETTEXT(body AS STRING)
    DIM rest AS STRING
    DIM p AS INTEGER
    DIM n AS INTEGER

    ED_INIT()
    rest = body
    n = 0
    DO
        IF n >= ED_MAXLINES THEN EXITDO
        p = CINT(INSTR(rest, CHR$(10)))
        IF p < 0 THEN
            edLines[n] = rest
            n = n + 1
            EXITDO
        ENDIF
        edLines[n] = LEFT$(rest, p)
        n = n + 1
        rest = MID$(rest, p + 1, LEN(rest) - p - 1)
    LOOP
    edCount = n
    IF edCount < 1 THEN edCount = 1
ENDSUB

FUNC DSK_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO dskCount - 1
        IF dskNames[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

SUB DSK_SAVE(nm AS STRING)
    DIM idx AS INTEGER
    IF LEN(nm) = 0 THEN
        SCR_WRITELN("save needs a name")
        RETURN
    ENDIF
    idx = CINT(DSK_FIND(nm))
    IF idx < 0 THEN
        IF dskCount >= DSK_MAX THEN
            SCR_WRITELN("disk full")
            RETURN
        ENDIF
        idx = dskCount
        dskCount = dskCount + 1
    ENDIF
    dskNames[idx] = nm
    dskText[idx] = ED_TEXT$()
    SCR_WRITE("saved ")
    SCR_WRITELN(nm)
ENDSUB

SUB DSK_LOAD(nm AS STRING)
    DIM idx AS INTEGER
    idx = CINT(DSK_FIND(nm))
    IF idx < 0 THEN
        SCR_WRITELN("not found")
        RETURN
    ENDIF
    ED_SETTEXT(dskText[idx])
    SCR_WRITE("loaded ")
    SCR_WRITELN(nm)
ENDSUB

SUB DSK_DIR()
    DIM i AS INTEGER
    IF dskCount = 0 THEN
        SCR_WRITELN("no programs")
        RETURN
    ENDIF
    FOR i = 0 TO dskCount - 1
        SCR_WRITE("  ")
        SCR_WRITELN(dskNames[i])
    NEXT i
ENDSUB

SUB ED_LIST()
    DIM i AS INTEGER
    FOR i = 0 TO edCount - 1
        SCR_WRITELN(edLines[i])
    NEXT i
ENDSUB

SUB RUN_BUFFER()
    DIM i AS INTEGER
    FOR i = 0 TO edCount - 1
        IF LEN(edLines[i]) > 0 THEN
            RUN_TEXT(edLines[i])
        ENDIF
    NEXT i
ENDSUB

' COMP translates the whole editor buffer to machine code and keeps the entry
' point; CALL enters it. lallang spells these with an explicit address, which
' is unnecessary here because the code buffer belongs to the OS.
SUB CMD_COMP()
    jitEntry = CINT(JIT_COMPILE(ED_TEXT$()))
    IF jitEntry < 0 THEN RETURN
    SCR_WRITE("compiled ")
    SCR_WRITEINT(jitPos)
    SCR_WRITELN(" bytes")
ENDSUB

SUB CMD_CALL()
    DIM result AS INTEGER
    IF jitEntry < 0 THEN
        SCR_WRITELN("nothing compiled")
        RETURN
    ENDIF
    result = CINT(JIT_ENTER(jitEntry))
    SCR_WRITEINT(result)
    SCR_NEWLINE()
ENDSUB

SUB CMD_HELP()
    SCR_WRITELN("DIR          list stored programs")
    SCR_WRITELN("SAVE name    store the buffer")
    SCR_WRITELN("LOAD name    recall into the buffer")
    SCR_WRITELN("RUN [name]   run the buffer, or load then run")
    SCR_WRITELN("COMP         compile the buffer to machine code")
    SCR_WRITELN("CALL         run the compiled code")
    SCR_WRITELN("LIST         print the buffer")
    SCR_WRITELN("NEW          empty the buffer")
    SCR_WRITELN("CLS          clear the screen")
    SCR_WRITELN("F2           open the editor")
ENDSUB

SUB RUN_COMMAND(lineIn AS STRING)
    DIM word AS STRING
    DIM arg AS STRING
    DIM p AS INTEGER

    p = CINT(INSTR(lineIn, " "))
    IF p < 0 THEN
        word = lineIn
        arg = ""
    ELSE
        word = LEFT$(lineIn, p)
        arg = MID$(lineIn, p + 1, LEN(lineIn) - p - 1)
        DO
            IF LEN(arg) = 0 THEN EXITDO
            IF BYTEAT(arg, 0) <> 32 THEN EXITDO
            arg = MID$(arg, 1, LEN(arg) - 1)
        LOOP
    ENDIF

    IF word = "CLS" THEN
        SCR_CLEAR()
        RETURN
    ENDIF
    IF word = "NEW" THEN
        ED_INIT()
        SCR_WRITELN("new")
        RETURN
    ENDIF
    IF word = "LIST" THEN
        ED_LIST()
        RETURN
    ENDIF
    IF word = "DIR" THEN
        DSK_DIR()
        RETURN
    ENDIF
    IF word = "SAVE" THEN
        DSK_SAVE(arg)
        RETURN
    ENDIF
    IF word = "LOAD" THEN
        DSK_LOAD(arg)
        RETURN
    ENDIF
    IF word = "RUN" THEN
        IF LEN(arg) > 0 THEN DSK_LOAD(arg)
        RUN_BUFFER()
        RETURN
    ENDIF
    IF word = "COMP" THEN
        CMD_COMP()
        RETURN
    ENDIF
    IF word = "CALL" THEN
        CMD_CALL()
        RETURN
    ENDIF
    IF word = "HELP" THEN
        CMD_HELP()
        RETURN
    ENDIF

    SCR_WRITE("unknown command: ")
    SCR_WRITELN(word)
ENDSUB

' ── JIT: user-defined functions ────────────────────────────────────────────
'
' Every function gets a real stack frame and its address goes into a table in
' memory. Calls read the target out of that table at run time, so a function
' may call one defined later, and two may call each other.
'
' Parameters live in the frame; any other name inside a function body is the
' same global slot the rest of the JIT uses. That is lallang's rule too, and it
' is why a recursive function cannot keep local state yet.

CONST JIT_FNTAB = $B80000
CONST JIT_MAXFN = 16
CONST JIT_MAXPARAM = 4

DIM jfnNames[JIT_MAXFN] AS STRING
DIM jfnBody[JIT_MAXFN] AS STRING
DIM jfnParams[64] AS STRING
DIM jfnArity[JIT_MAXFN]
DIM jfnCount AS INTEGER

DIM jitInFunc AS INTEGER
DIM jitParams[JIT_MAXPARAM] AS STRING
DIM jitArity AS INTEGER

' ── Frame instructions ─────────────────────────────────────────────────────

SUB J_PROLOGUE()
    J_B($55)
    J_B($48)
    J_B($89)
    J_B($E5)
ENDSUB

SUB J_EPILOGUE()
    J_B($48)
    J_B($89)
    J_B($EC)
    J_B($5D)
    J_B($C3)
ENDSUB

' Argument i of n sits above the saved rbp and the return address, in the
' order the caller pushed them.
SUB J_LOAD_PARAM(idx AS INTEGER, n AS INTEGER)
    J_B($48)
    J_B($8B)
    J_B($45)
    J_B(16 + 8 * (n - 1 - idx))
ENDSUB

' call [JIT_FNTAB + idx*8]: the target is read from memory at call time, which
' is what lets a forward reference resolve.
SUB J_CALL_SLOT(idx AS INTEGER)
    J_B($48)
    J_B($B8)
    J_64(JIT_FNTAB + idx * 8)
    J_B($FF)
    J_B($10)
ENDSUB

SUB J_DROP_ARGS(n AS INTEGER)
    IF n = 0 THEN RETURN
    J_B($48)
    J_B($83)
    J_B($C4)
    J_B(8 * n)
ENDSUB

' ── The function table ─────────────────────────────────────────────────────

FUNC JFN_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO jfnCount - 1
        IF jfnNames[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

FUNC JIT_PARAM_INDEX(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    IF jitInFunc = 0 THEN RETURN -1
    FOR i = 0 TO jitArity - 1
        IF jitParams[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

' Reads the text between matching braces and leaves the cursor past them.
FUNC JIT_BLOCK_TEXT$() AS STRING
    DIM depth AS INTEGER
    DIM start AS INTEGER
    DIM c AS INTEGER

    SKIPSP()
    IF PEEKC() <> 123 THEN
        errCode = 4
        RETURN ""
    ENDIF
    cur = cur + 1
    start = cur
    depth = 1
    DO
        c = CINT(PEEKC())
        IF c = 0 THEN
            errCode = 5
            RETURN ""
        ENDIF
        IF c = 123 THEN depth = depth + 1
        IF c = 125 THEN
            depth = depth - 1
            IF depth = 0 THEN
                cur = cur + 1
                RETURN MID$(srcText, start, cur - start - 1)
            ENDIF
        ENDIF
        cur = cur + 1
    LOOP
ENDFUNC

' func name(a, b) { ... } records the definition; nothing is emitted here.
SUB JIT_DEFINE()
    DIM nm AS STRING
    DIM pn AS STRING
    DIM idx AS INTEGER
    DIM n AS INTEGER

    SKIPSP()
    IF IS_ALPHA(CINT(PEEKC())) = 0 THEN
        errCode = 3
        RETURN
    ENDIF
    nm = SCAN_IDENT$()

    SKIPSP()
    IF PEEKC() <> 40 THEN
        errCode = 1
        RETURN
    ENDIF
    cur = cur + 1

    idx = CINT(JFN_FIND(nm))
    IF idx < 0 THEN
        IF jfnCount >= JIT_MAXFN THEN
            errCode = 8
            RETURN
        ENDIF
        idx = jfnCount
        jfnCount = jfnCount + 1
    ENDIF
    jfnNames[idx] = nm

    n = 0
    DO
        SKIPSP()
        IF PEEKC() = 41 THEN
            cur = cur + 1
            EXITDO
        ENDIF
        IF PEEKC() = 44 THEN
            cur = cur + 1
        ELSE
            IF IS_ALPHA(CINT(PEEKC())) = 0 THEN
                errCode = 3
                RETURN
            ENDIF
            IF n >= JIT_MAXPARAM THEN
                errCode = 9
                RETURN
            ENDIF
            pn = SCAN_IDENT$()
            jfnParams[idx * JIT_MAXPARAM + n] = pn
            n = n + 1
        ENDIF
    LOOP

    jfnArity[idx] = n
    jfnBody[idx] = JIT_BLOCK_TEXT$()
ENDSUB

' ── Compiling a function ───────────────────────────────────────────────────

SUB JIT_COMPILE_FUNC(idx AS INTEGER)
    DIM savedText AS STRING
    DIM savedCur AS INTEGER
    DIM i AS INTEGER
    DIM body AS STRING

    SYS.POKE(JIT_FNTAB + idx * 8, JIT_CODE + jitPos)
    SYS.POKE(JIT_FNTAB + idx * 8 + 4, 0)

    savedText = srcText
    savedCur = cur

    jitArity = CINT(jfnArity[idx])
    FOR i = 0 TO jitArity - 1
        jitParams[i] = jfnParams[idx * JIT_MAXPARAM + i]
    NEXT i
    jitInFunc = 1

    J_PROLOGUE()

    body = jfnBody[idx]
    srcText = body
    cur = 0
    DO
        IF errCode > 0 THEN EXITDO
        SKIPSP()
        IF PEEKC() = 0 THEN EXITDO
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            JIT_STATEMENT()
        ENDIF
    LOOP

    ' A body that runs off the end answers 0.
    J_MOV_RAX_IMM(0)
    J_EPILOGUE()

    jitInFunc = 0
    srcText = savedText
    cur = savedCur
ENDSUB

SUB JIT_COMPILE_ALL()
    DIM i AS INTEGER
    FOR i = 0 TO jfnCount - 1
        IF errCode > 0 THEN RETURN
        JIT_COMPILE_FUNC(i)
    NEXT i
ENDSUB

' ── In-OS JIT ──────────────────────────────────────────────────────────────
'
' Compiles a line to real x86-64 machine code in RAM and calls it. lallang's
' JIT emits 32-bit code; this kernel runs in long mode, so the encodings carry
' REX prefixes and variables are reached with movabs to an absolute address.
'
' Values are 64-bit integers here, unlike the interpreter's doubles. The two
' share the same name table: the slots are copied in before the code runs and
' back out afterwards, so `x = 5` at the prompt is visible to `?? x + 1`.

CONST JIT_CODE = $A00000
CONST JIT_VARS = $B00000

DIM jitPos AS INTEGER
DIM jitEntry AS INTEGER

' ── Emitter ────────────────────────────────────────────────────────────────

SUB J_B(b AS INTEGER)
    SYS.POKEB(JIT_CODE + jitPos, b MOD 256)
    jitPos = jitPos + 1
ENDSUB

' Little endian, two's complement for the negative displacements a jump needs.
SUB J_32(v AS INTEGER)
    DIM n AS INTEGER
    DIM i AS INTEGER
    n = v
    IF n < 0 THEN n = n + 4294967296
    FOR i = 1 TO 4
        J_B(n MOD 256)
        n = n \ 256
    NEXT i
ENDSUB

SUB J_64(v AS INTEGER)
    DIM n AS INTEGER
    DIM i AS INTEGER
    n = v
    FOR i = 1 TO 8
        J_B(n MOD 256)
        n = n \ 256
    NEXT i
ENDSUB

SUB J_PATCH32(at AS INTEGER, v AS INTEGER)
    DIM n AS INTEGER
    DIM i AS INTEGER
    n = v
    IF n < 0 THEN n = n + 4294967296
    FOR i = 0 TO 3
        SYS.POKEB(JIT_CODE + at + i, n MOD 256)
        n = n \ 256
    NEXT i
ENDSUB

' ── Instructions ───────────────────────────────────────────────────────────

SUB J_MOV_RAX_IMM(v AS INTEGER)
    J_B($48)
    J_B($B8)
    J_64(v)
ENDSUB

SUB J_LOAD_VAR(idx AS INTEGER)
    J_B($48)
    J_B($A1)
    J_64(JIT_VARS + idx * 8)
ENDSUB

SUB J_STORE_VAR(idx AS INTEGER)
    J_B($48)
    J_B($A3)
    J_64(JIT_VARS + idx * 8)
ENDSUB

SUB J_PUSH_RAX()
    J_B($50)
ENDSUB

' The right operand is in rax; park it in rbx and restore the left from the
' stack, so rax holds the left and rbx the right for every binary op below.
SUB J_TAKE_RHS()
    J_B($48)
    J_B($89)
    J_B($C3)
    J_B($58)
ENDSUB

SUB J_NEG_RAX()
    J_B($48)
    J_B($F7)
    J_B($D8)
ENDSUB

SUB J_ADD()
    J_B($48)
    J_B($01)
    J_B($D8)
ENDSUB

SUB J_SUB()
    J_B($48)
    J_B($29)
    J_B($D8)
ENDSUB

SUB J_IMUL()
    J_B($48)
    J_B($0F)
    J_B($AF)
    J_B($C3)
ENDSUB

' cqo sign-extends rax into rdx, which idiv needs; the quotient lands in rax
' and the remainder in rdx.
SUB J_IDIV()
    J_B($48)
    J_B($99)
    J_B($48)
    J_B($F7)
    J_B($FB)
ENDSUB

SUB J_MOV_RAX_RDX()
    J_B($48)
    J_B($89)
    J_B($D0)
ENDSUB

' kind: 1 == , 2 <> , 3 <= , 4 >= , 5 < , 6 >
SUB J_CMP(kind AS INTEGER)
    J_B($48)
    J_B($39)
    J_B($D8)
    J_B($0F)
    IF kind = 1 THEN J_B($94)
    IF kind = 2 THEN J_B($95)
    IF kind = 3 THEN J_B($9E)
    IF kind = 4 THEN J_B($9D)
    IF kind = 5 THEN J_B($9C)
    IF kind = 6 THEN J_B($9F)
    J_B($C0)
    J_B($48)
    J_B($0F)
    J_B($B6)
    J_B($C0)
ENDSUB

SUB J_TEST_RAX()
    J_B($48)
    J_B($85)
    J_B($C0)
ENDSUB

' Emits a conditional jump with a placeholder displacement and answers where
' that displacement sits, so the caller can patch it once the target is known.
FUNC J_JE_HOLE() AS INTEGER
    DIM at AS INTEGER
    J_B($0F)
    J_B($84)
    at = jitPos
    J_32(0)
    RETURN at
ENDFUNC

FUNC J_JMP_HOLE() AS INTEGER
    DIM at AS INTEGER
    J_B($E9)
    at = jitPos
    J_32(0)
    RETURN at
ENDFUNC

SUB J_JMP_BACK(target AS INTEGER)
    J_B($E9)
    J_32(target - (jitPos + 4))
ENDSUB

SUB J_PATCH_HERE(at AS INTEGER)
    J_PATCH32(at, jitPos - (at + 4))
ENDSUB

SUB J_RET()
    J_B($C3)
ENDSUB

' ── Compiler ───────────────────────────────────────────────────────────────

FUNC JIT_SLOT(nm AS STRING) AS INTEGER
    DIM idx AS INTEGER
    idx = CINT(VAR_FIND(nm))
    IF idx >= 0 THEN RETURN idx
    IF varCount >= MAX_VARS THEN
        errCode = 6
        RETURN 0
    ENDIF
    varNames[varCount] = nm
    varVals[varCount] = 0
    varCount = varCount + 1
    RETURN varCount - 1
ENDFUNC

SUB JIT_FACTOR()
    DIM nm AS STRING
    DIM pidx AS INTEGER

    SKIPSP()

    IF PEEKC() = 45 THEN
        cur = cur + 1
        JIT_FACTOR()
        J_NEG_RAX()
        RETURN
    ENDIF

    IF PEEKC() = 40 THEN
        cur = cur + 1
        JIT_COMPARE()
        SKIPSP()
        IF PEEKC() <> 41 THEN
            errCode = 1
            RETURN
        ENDIF
        cur = cur + 1
        RETURN
    ENDIF

    IF IS_DIGIT(CINT(PEEKC())) = 1 THEN
        J_MOV_RAX_IMM(CINT(SCAN_NUMBER()))
        RETURN
    ENDIF

    IF IS_ALPHA(CINT(PEEKC())) = 1 THEN
        nm = SCAN_IDENT$()
        SKIPSP()
        IF PEEKC() = 40 THEN
            IF JIT_BUILTIN(nm) = 1 THEN RETURN
            JIT_CALL(nm)
            RETURN
        ENDIF
        pidx = CINT(JIT_PARAM_INDEX(nm))
        IF pidx >= 0 THEN
            J_LOAD_PARAM(pidx, jitArity)
        ELSE
            J_LOAD_VAR(CINT(JIT_SLOT(nm)))
        ENDIF
        RETURN
    ENDIF

    errCode = 3
ENDSUB

' Hardware and memory reach compiled code the same way they reach the rest of
' the OS, but inline rather than through a call. This is what lets a compiled
' program drive the screen and the keyboard itself.
FUNC JIT_BUILTIN(nm AS STRING) AS INTEGER
    DIM one AS INTEGER
    DIM two AS INTEGER

    one = 0
    two = 0
    IF nm = "peekb" THEN one = 1
    IF nm = "peekw" THEN one = 1
    IF nm = "peek" THEN one = 1
    IF nm = "inb" THEN one = 1
    IF nm = "pokeb" THEN two = 1
    IF nm = "pokew" THEN two = 1
    IF nm = "poke" THEN two = 1
    IF nm = "outb" THEN two = 1
    IF one = 0 AND two = 0 THEN RETURN 0

    cur = cur + 1
    JIT_COMPARE()
    IF errCode > 0 THEN RETURN 1

    IF two = 1 THEN
        SKIPSP()
        IF PEEKC() <> 44 THEN
            errCode = 1
            RETURN 1
        ENDIF
        cur = cur + 1
        J_PUSH_RAX()
        JIT_COMPARE()
        IF errCode > 0 THEN RETURN 1
        J_TAKE_RHS()
    ENDIF

    SKIPSP()
    IF PEEKC() <> 41 THEN
        errCode = 1
        RETURN 1
    ENDIF
    cur = cur + 1

    ' One-argument forms take the address or port in rax.
    IF nm = "peekb" THEN
        J_B($48)
        J_B($0F)
        J_B($B6)
        J_B($00)
    ENDIF
    IF nm = "peekw" THEN
        J_B($48)
        J_B($0F)
        J_B($B7)
        J_B($00)
    ENDIF
    IF nm = "peek" THEN
        J_B($8B)
        J_B($00)
    ENDIF
    IF nm = "inb" THEN
        J_B($48)
        J_B($89)
        J_B($C2)
        J_B($31)
        J_B($C0)
        J_B($EC)
        J_B($48)
        J_B($0F)
        J_B($B6)
        J_B($C0)
    ENDIF

    ' Two-argument forms have the address or port in rax and the value in rbx.
    IF nm = "pokeb" THEN
        J_B($88)
        J_B($18)
    ENDIF
    IF nm = "pokew" THEN
        J_B($66)
        J_B($89)
        J_B($18)
    ENDIF
    IF nm = "poke" THEN
        J_B($89)
        J_B($18)
    ENDIF
    IF nm = "outb" THEN
        J_B($48)
        J_B($89)
        J_B($C2)
        J_B($48)
        J_B($89)
        J_B($D8)
        J_B($EE)
    ENDIF

    RETURN 1
ENDFUNC

' Arguments are pushed left to right and dropped by the caller afterwards.
SUB JIT_CALL(nm AS STRING)
    DIM idx AS INTEGER
    DIM n AS INTEGER
    idx = CINT(JFN_FIND(nm))
    IF idx < 0 THEN
        errCode = 10
        RETURN
    ENDIF
    cur = cur + 1
    n = 0
    DO
        SKIPSP()
        IF PEEKC() = 41 THEN
            cur = cur + 1
            EXITDO
        ENDIF
        IF PEEKC() = 0 THEN
            errCode = 1
            RETURN
        ENDIF
        IF PEEKC() = 44 THEN
            cur = cur + 1
        ELSE
            JIT_COMPARE()
            IF errCode > 0 THEN RETURN
            J_PUSH_RAX()
            n = n + 1
        ENDIF
    LOOP
    J_CALL_SLOT(idx)
    J_DROP_ARGS(n)
ENDSUB

' Steps over one statement textually, for the pass that only collects
' definitions.
SUB JIT_SKIP_STMT()
    DIM depth AS INTEGER
    DIM c AS INTEGER
    depth = 0
    DO
        c = CINT(PEEKC())
        IF c = 0 THEN RETURN
        IF c = 123 THEN depth = depth + 1
        IF c = 125 THEN depth = depth - 1
        IF c = 59 AND depth <= 0 THEN RETURN
        cur = cur + 1
    LOOP
ENDSUB

SUB JIT_TERM()
    DIM op AS INTEGER
    JIT_FACTOR()
    DO
        IF errCode > 0 THEN RETURN
        SKIPSP()
        op = CINT(PEEKC())
        IF op <> 42 AND op <> 47 AND op <> 37 THEN RETURN
        cur = cur + 1
        J_PUSH_RAX()
        JIT_FACTOR()
        J_TAKE_RHS()
        IF op = 42 THEN
            J_IMUL()
        ELSE
            J_IDIV()
            IF op = 37 THEN J_MOV_RAX_RDX()
        ENDIF
    LOOP
ENDSUB

SUB JIT_EXPR()
    DIM op AS INTEGER
    JIT_TERM()
    DO
        IF errCode > 0 THEN RETURN
        SKIPSP()
        op = CINT(PEEKC())
        IF op <> 43 AND op <> 45 THEN RETURN
        cur = cur + 1
        J_PUSH_RAX()
        JIT_TERM()
        J_TAKE_RHS()
        IF op = 43 THEN
            J_ADD()
        ELSE
            J_SUB()
        ENDIF
    LOOP
ENDSUB

SUB JIT_COMPARE()
    DIM c1 AS INTEGER
    DIM c2 AS INTEGER
    DIM kind AS INTEGER

    JIT_EXPR()
    IF errCode > 0 THEN RETURN

    SKIPSP()
    c1 = CINT(PEEKC())
    c2 = CINT(PEEKC2())
    kind = 0

    IF c1 = 61 AND c2 = 61 THEN kind = 1
    IF c1 = 60 AND c2 = 62 THEN kind = 2
    IF c1 = 60 AND c2 = 61 THEN kind = 3
    IF c1 = 62 AND c2 = 61 THEN kind = 4

    IF kind > 0 THEN
        cur = cur + 2
    ELSE
        IF c1 = 60 THEN kind = 5
        IF c1 = 62 THEN kind = 6
        IF kind = 0 THEN RETURN
        cur = cur + 1
    ENDIF

    J_PUSH_RAX()
    JIT_EXPR()
    IF errCode > 0 THEN RETURN
    J_TAKE_RHS()
    J_CMP(kind)
ENDSUB

SUB JIT_STATEMENT()
    DIM nm AS STRING
    DIM savePos AS INTEGER
    DIM condPos AS INTEGER
    DIM hole AS INTEGER

    SKIPSP()
    IF PEEKC() = 0 THEN RETURN

    IF SCAN_KEYWORD("return") = 1 THEN
        IF jitInFunc = 0 THEN
            errCode = 11
            RETURN
        ENDIF
        JIT_COMPARE()
        IF errCode > 0 THEN RETURN
        J_EPILOGUE()
        RETURN
    ENDIF

    IF SCAN_KEYWORD("if") = 1 THEN
        JIT_COMPARE()
        IF errCode > 0 THEN RETURN
        J_TEST_RAX()
        hole = CINT(J_JE_HOLE())
        JIT_BLOCK()
        J_PATCH_HERE(hole)
        RETURN
    ENDIF

    IF SCAN_KEYWORD("while") = 1 THEN
        condPos = jitPos
        JIT_COMPARE()
        IF errCode > 0 THEN RETURN
        J_TEST_RAX()
        hole = CINT(J_JE_HOLE())
        JIT_BLOCK()
        J_JMP_BACK(condPos)
        J_PATCH_HERE(hole)
        RETURN
    ENDIF

    IF IS_ALPHA(CINT(PEEKC())) = 1 THEN
        savePos = cur
        nm = SCAN_IDENT$()
        SKIPSP()
        IF PEEKC() = 61 AND PEEKC2() <> 61 THEN
            cur = cur + 1
            JIT_COMPARE()
            IF errCode > 0 THEN RETURN
            J_STORE_VAR(CINT(JIT_SLOT(nm)))
            RETURN
        ENDIF
        cur = savePos
    ENDIF

    JIT_COMPARE()
ENDSUB

SUB JIT_BLOCK()
    SKIPSP()
    IF PEEKC() <> 123 THEN
        errCode = 4
        RETURN
    ENDIF
    cur = cur + 1
    DO
        IF errCode > 0 THEN RETURN
        SKIPSP()
        IF PEEKC() = 125 THEN
            cur = cur + 1
            RETURN
        ENDIF
        IF PEEKC() = 0 THEN
            errCode = 5
            RETURN
        ENDIF
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            JIT_STATEMENT()
        ENDIF
    LOOP
ENDSUB

' ── Driving it ─────────────────────────────────────────────────────────────

SUB JIT_SYNC_IN()
    DIM i AS INTEGER
    FOR i = 0 TO varCount - 1
        SYS.POKE(JIT_VARS + i * 8, CINT(varVals[i]))
        SYS.POKE(JIT_VARS + i * 8 + 4, 0)
    NEXT i
ENDSUB

SUB JIT_SYNC_OUT()
    DIM i AS INTEGER
    FOR i = 0 TO varCount - 1
        varVals[i] = SYS.PEEK(JIT_VARS + i * 8)
    NEXT i
ENDSUB

' Compiles the source after the leading ?? and runs it. The value of a trailing
' expression is whatever the last statement left in rax.
FUNC JIT_COMPILE(srcIn AS STRING) AS INTEGER
    DIM startCur AS INTEGER
    DIM mainEntry AS INTEGER

    srcText = srcIn
    cur = 0
    jitPos = 0
    errCode = 0
    startCur = cur

    ' First pass collects definitions so a call may name a function that is
    ' defined further along the line, or on an earlier one.
    DO
        IF errCode > 0 THEN EXITDO
        SKIPSP()
        IF PEEKC() = 0 THEN EXITDO
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            IF SCAN_KEYWORD("func") = 1 THEN
                JIT_DEFINE()
            ELSE
                JIT_SKIP_STMT()
            ENDIF
        ENDIF
    LOOP

    IF errCode = 0 THEN JIT_COMPILE_ALL()

    mainEntry = jitPos
    J_MOV_RAX_IMM(0)
    cur = startCur

    DO
        IF errCode > 0 THEN EXITDO
        SKIPSP()
        IF PEEKC() = 0 THEN EXITDO
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            IF SCAN_KEYWORD("func") = 1 THEN
                JIT_DEFINE()
            ELSE
                JIT_STATEMENT()
            ENDIF
        ENDIF
    LOOP

    IF errCode > 0 THEN
        scrAttr = 12
        SCR_WRITE("error: ")
        SCR_WRITELN(ERR_TEXT$(errCode))
        scrAttr = 7
        RETURN -1
    ENDIF

    J_RET()
    RETURN mainEntry
ENDFUNC

FUNC JIT_ENTER(entry AS INTEGER) AS INTEGER
    DIM result AS INTEGER
    JIT_SYNC_IN()
    result = CINT(SYS.CALL(JIT_CODE + entry))
    JIT_SYNC_OUT()
    RETURN result
ENDFUNC

SUB JIT_LINE(lineIn AS STRING)
    DIM entry AS INTEGER
    DIM result AS INTEGER
    entry = CINT(JIT_COMPILE(MID$(lineIn, 2, LEN(lineIn) - 2)))
    IF entry < 0 THEN RETURN
    result = CINT(JIT_ENTER(entry))
    SCR_WRITEINT(result)
    SCR_WRITE("   [")
    SCR_WRITEINT(jitPos)
    SCR_WRITELN(" bytes of x86]")
ENDSUB

' ── Preloaded program ──────────────────────────────────────────────────────
'
' A paddle-and-ball game written in the OS's own language, sitting on the RAM
' disk at boot the way lallang bakes invaders.os into slot 0. It reaches the
' screen and the keyboard through the JIT's builtins, so it only runs as
' compiled code: LOAD pong, COMP, CALL.
'
' 753664 is $B8000, the text buffer. A cell is attribute times 256 plus the
' character, so 3840 is white on black and 3872 a white space.

SUB DSK_DEFAULTS()
    DIM g AS STRING

    g = ""
    g = g + "func cell(r, c, ch) { pokew(753664 + (r*80 + c)*2, 3840 + ch) }" + CHR$(10)
    g = g + "func wipe() { i = 0; while i < 2000 { pokew(753664 + i*2, 3872); i = i+1 } }" + CHR$(10)
    g = g + "func row(r, ch) { i = 0; while i < 80 { cell(r, i, ch); i = i+1 } }" + CHR$(10)
    g = g + "func digits() {" + CHR$(10)
    g = g + "  cell(0,0,83); cell(0,1,67); cell(0,2,79); cell(0,3,82); cell(0,4,69); cell(0,5,58)" + CHR$(10)
    g = g + "  cell(0,7,48 + (score/10)%10); cell(0,8,48 + score%10)" + CHR$(10)
    g = g + "  cell(0,11,76); cell(0,12,58); cell(0,14,48 + lives)" + CHR$(10)
    g = g + "}" + CHR$(10)
    g = g + "wipe()" + CHR$(10)
    g = g + "bx = 34; by = 15; dx = 1; dy = 1; px = 36; score = 0; alive = 1; lives = 3" + CHR$(10)
    g = g + "while alive == 1 {" + CHR$(10)
    g = g + "  cell(by, bx, 32)" + CHR$(10)
    g = g + "  bx = bx + dx; by = by + dy" + CHR$(10)
    g = g + "  if bx < 1 { bx = 1; dx = 1 }" + CHR$(10)
    g = g + "  if bx > 78 { bx = 78; dx = 0 - 1 }" + CHR$(10)
    g = g + "  if by < 2 { by = 2; dy = 1 }" + CHR$(10)
    g = g + "  if by > 21 {" + CHR$(10)
    g = g + "    if bx > px - 1 { if bx < px + 8 { by = 21; dy = 0 - 1; score = score + 1 } }" + CHR$(10)
    g = g + "  }" + CHR$(10)
    g = g + "  if by > 23 { lives = lives - 1; bx = 34; by = 6; dy = 1; dx = 1 }" + CHR$(10)
    g = g + "  if lives < 1 { alive = 0 }" + CHR$(10)
    g = g + "  cell(by, bx, 79)" + CHR$(10)
    g = g + "  row(23, 32)" + CHR$(10)
    g = g + "  i = 0; while i < 8 { cell(23, px + i, 61); i = i+1 }" + CHR$(10)
    g = g + "  digits()" + CHR$(10)
    g = g + "  k = inb(96)" + CHR$(10)
    g = g + "  if k == 30 { if px > 0 { px = px - 3 } }" + CHR$(10)
    g = g + "  if k == 32 { if px < 71 { px = px + 3 } }" + CHR$(10)
    g = g + "  if k == 1 { alive = 0 }" + CHR$(10)
    g = g + "  d = 0; while d < 35000000 { d = d+1 }" + CHR$(10)
    g = g + "}" + CHR$(10)
    g = g + "score" + CHR$(10)

    dskNames[0] = "pong"
    dskText[0] = g
    dskCount = 1
ENDSUB

' ── Main ───────────────────────────────────────────────────────────────────

DIM lineText AS STRING

scrAttr = 7
scrPos = 0
varCount = 0
errCode = 0

SCR_CLEAR()
scrAttr = 15
SCR_WRITELN("jdBasic OS - a REPL written in jdBasic")
scrAttr = 7
SCR_WRITELN("? interprets   ?? compiles to x86 and runs it   if/while cond { }")
SCR_WRITELN("F2 opens the editor, HELP lists commands, ESC halts")
SCR_NEWLINE()

KB_INIT()

ED_INIT()
dskCount = 0
jitEntry = -1
jfnCount = 0
DSK_DEFAULTS()

DO
    SCR_WRITE("> ")
    lineText = KB_READLINE$()
    IF lineExit = 1 THEN
        SCR_NEWLINE()
        SCR_WRITELN("halted.")
        EXITDO
    ENDIF
    IF lineExit = 2 THEN
        ED_MAIN()
        scrAttr = 7
        SCR_CLEAR()
        SCR_WRITELN("back at the prompt")
    ELSE
        IF LEN(lineText) > 1 AND BYTEAT(lineText, 0) = 63 AND BYTEAT(lineText, 1) = 63 THEN
            JIT_LINE(lineText)
        ELSE
            IF LEN(lineText) > 0 AND IS_UPPER(CINT(BYTEAT(lineText, 0))) = 1 THEN
                RUN_COMMAND(lineText)
            ELSE
                RUN_TEXT(lineText)
            ENDIF
        ENDIF
    ENDIF
LOOP
