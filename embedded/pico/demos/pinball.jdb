' PINBALL for the Fruit Jam, and the desktop window.
'
' A table of straight segments: a rounded top, four rollover lanes, three
' pop bumpers, a bank of three drop targets, a spinner, two slingshots,
' two outlanes with a kickback on the left, and two flippers. The ball
' is a circle under gravity, moved in four small steps a frame so it
' never skips a wall. The table is cut into 32 pixel cells, each knowing
' the segments that reach into it, so a step tests two or three rather
' than all of them, and a frame redraws only what the ball's wipe may
' have cut.
'
' Keys: the two shift keys, or the arrows left and right, are the
' flippers, space held and released is the plunger, the arrow down
' nudges, q quits. On the board
' the two buttons beside BOOT are the flippers, and both together while
' the ball waits in the lane charge the plunger.
' Without a key for ten seconds the table plays itself. Every 300 frames
' a line on the console says what a frame costs.
'
' Scoring: bumper 100, target 200 and a cleared bank 1000, slingshot 10,
' spinner 5 a turn, rollover lane 50 and all four lit 500 plus one on
' the multiplier, kickback 500, skill shot into the lit lane 1000, the
' end of a ball pays 100 a lit lane. An extra ball at 10000. Three
' nudges in two seconds tilt the table until the ball is lost.

PBOARD = 1
TRY
    junk = SYS.FREE()
CATCH
    PBOARD = 0
ENDTRY

DIM RUNNING = 1
SUB OnQuit()
    RUNNING = 0
ENDSUB

IF PBOARD = 1 THEN
    GFX.CONSOLE 0
    KLEFT = 180
    KRIGHT = 183
    KLSHIFT = 142
    KRSHIFT = 143
    KDOWN = 182
    KSPACE = 32
    KQUIT = 113
    PLAY.VOLUME(20)
ELSE
    SCREEN 320, 240, "PINBALL", 3
    ON "QUIT" CALL OnQuit
    KLEFT = 80
    KRIGHT = 79
    KLSHIFT = 225
    KRSHIFT = 229
    KDOWN = 81
    KSPACE = 44
    KQUIT = 20
ENDIF

' ---- the table --------------------------------------------------------
' Playfield x 60 to 260, the plunger lane at its right edge, the margins
' left and right carry the score and the help.

CONST R = 4
CONST G = 0.012
CONST VMAX = 3.4
CONST SUBSTEPS = 3
CONST BR = 10
CONST FLEN = 42
CONST FSPEED = 0.22
CONST FKICK = 2.0
CONST BKICK = 1.5
CONST CELL = 32
CONST GW = 10
CONST GH = 8
CONST GMAX = 12

' the walls: left, lane divider, lane floor, the rounded top from the
' left wall over to the lane, the right wall below the top
SX1 = [60,  244, 244, 60,  66,  80,  100, 130, 200, 228, 248, 258, 260]
SY1 = [60,  70,  239, 60,  34,  16,  5,   0,   0,   6,   22,  45,  70]
SX2 = [60,  244, 260, 66,  80,  100, 130, 200, 228, 248, 258, 260, 260]
SY2 = [239, 239, 239, 34,  16,  5,   0,   0,   6,   22,  45,  70,  239]
' the four rollover lanes at the top, three dividers
SX1 = APPEND(SX1, [112, 142, 172])
SY1 = APPEND(SY1, [26, 22, 26])
SX2 = APPEND(SX2, [112, 142, 172])
SY2 = APPEND(SY2, [50, 46, 50])
' the outlane posts, the slingshots (the left one leaves an outlane open,
' the right one reaches the lane divider), the plain stretch of each
' slingshot down to the flipper pivot, where a ball may rest on a raised
' flipper without being kicked, and a guide that closes the gap between
' the target bank and the divider
SX1 = APPEND(SX1, [84, 220, 72, 244, 92, 216, 230])
SY1 = APPEND(SY1, [140, 140, 170, 165, 195, 193, 112])
SX2 = APPEND(SX2, [84, 220, 92, 216, 106, 198, 244])
SY2 = APPEND(SY2, [160, 160, 195, 193, 205, 205, 100])
NSEG = LEN(SX1)
SLING1 = NSEG - 5
SLING2 = NSEG - 4
' bounce per segment, above 1 is a kick; the top arc keeps most of the
' launch
SE = []
FOR i = 0 TO NSEG - 1
    SE = APPEND(SE, 0.5)
NEXT i
FOR i = 3 TO 11
    SE[i] = 0.7
NEXT i
SE[SLING1] = 1.3
SE[SLING2] = 1.3
SE[NSEG - 3] = 0.3
SE[NSEG - 2] = 0.3

' Every cell lists the segments within a ball's reach of it: GN[c] how
' many, GL[c * GMAX + k] which.
GN = []
GL = []
FOR c = 0 TO GW * GH - 1
    GN = APPEND(GN, 0)
NEXT c
FOR c = 0 TO GW * GH * GMAX - 1
    GL = APPEND(GL, 0)
NEXT c
FOR i = 0 TO NSEG - 1
    cx0 = INT((MIN([SX1[i], SX2[i]]) - R - 2) / CELL)
    cx1 = INT((MAX([SX1[i], SX2[i]]) + R + 2) / CELL)
    cy0 = INT((MIN([SY1[i], SY2[i]]) - R - 2) / CELL)
    cy1 = INT((MAX([SY1[i], SY2[i]]) + R + 2) / CELL)
    IF cx0 < 0 THEN cx0 = 0
    IF cy0 < 0 THEN cy0 = 0
    IF cx1 > GW - 1 THEN cx1 = GW - 1
    IF cy1 > GH - 1 THEN cy1 = GH - 1
    FOR cy = cy0 TO cy1
        FOR cx = cx0 TO cx1
            c = cx + cy * GW
            IF GN[c] < GMAX THEN
                GL[c * GMAX + GN[c]] = i
                GN[c] = GN[c] + 1
            ENDIF
        NEXT cx
    NEXT cy
NEXT i

' pop bumpers
BX = [118, 168, 150]
BY = [92, 80, 124]
BHIT = [0, 0, 0]

' a diagonal bank on the right, facing the flippers
T1X = [206, 218, 230]
T1Y = [124, 136, 148]
T2X = [214, 226, 238]
T2Y = [132, 144, 156]
TUP = [1, 1, 1]

' the rollover lanes between the dividers, lit when the ball rolls through
LX1 = [88, 113, 143, 173]
LX2 = [111, 141, 171, 198]
LLIT = [0, 0, 0, 0]
SKILL = 1

' the spinner, a bar the ball turns on its way down the left side
SPX = 74
SPY = 118
SPIN = 0
SPA = 0

LFX = 106
LFY = 205
RFX = 198
RFY = 205
LREST = 0.45
LUP = -0.45
RREST = PI - 0.45
RUP = PI + 0.45

' ---- the game ---------------------------------------------------------

px = 252
py = 228
vx = 0
vy = 0
ox = px
oy = py
la = LREST
ra = RREST
ola = la
ora = ra
score = 0
balls = 3
mult = 1
extra = 0
kick = 1
saver = 0
tilt = 0
nudges = 0
nudget = 0
charge = 0
hiscore = 0
TRY
    hiscore = VAL(TXTREADER$("pinhi.txt"))
CATCH
    hiscore = 0
ENDTRY
hud = 1
snd = 0
sndf = 0
flash = 0
autowait = 30
launching = 0
AUTO = 1
idle = 0
blink = 0
over = 0
HIT = 0
TDRAW = 1
LDRAW = 1
msg$ = ""
msgt = 0
chase = 0

SUB ADDSCORE(n)
    score = score + n * mult
    hud = 1
    IF extra = 0 ANDALSO score >= 10000 THEN
        extra = 1
        balls = balls + 1
        msg$ = "EXTRA BALL"
        msgt = 120
        flash = 8
        IF PBOARD = 1 THEN PLAY "T240 O5 L16 C E G > C < G > C"
    ENDIF
ENDSUB

' ---- physics ----------------------------------------------------------

' The ball against one segment: pushed out along the normal, the
' velocity mirrored with the segment's bounce. kickv is what a moving
' flipper adds, more towards its tip.
SUB HITSEG(x1, y1, x2, y2, e, kickv)
    DIM ddx, ddy, l2, t, qx, qy, dx, dy, d2, d, nx, ny, vn, k, eb
    ddx = x2 - x1
    ddy = y2 - y1
    l2 = ddx * ddx + ddy * ddy
    t = ((px - x1) * ddx + (py - y1) * ddy) / l2
    IF t < 0 THEN t = 0
    IF t > 1 THEN t = 1
    qx = x1 + t * ddx
    qy = y1 + t * ddy
    dx = px - qx
    dy = py - qy
    d2 = dx * dx + dy * dy
    IF d2 >= R * R ORELSE d2 = 0 THEN RETURN
    HIT = 1
    d = SQR(d2)
    nx = dx / d
    ny = dy / d
    px = qx + nx * R
    py = qy + ny * R
    vn = vx * nx + vy * ny
    IF vn < 0 THEN
        ' a slingshot kicks a ball that arrives with some speed; one
        ' that merely rests against it is a wall
        eb = e
        IF e > 1 ANDALSO vn > -0.4 THEN eb = 0.3
        vx = vx - (1 + eb) * vn * nx
        vy = vy - (1 + eb) * vn * ny
        IF eb > 1 THEN
            ADDSCORE(10)
            snd = 440
            sndf = 2
        ENDIF
    ENDIF
    IF kickv > 0 THEN
        k = kickv * (0.5 + t)
        vn = vx * nx + vy * ny
        IF vn < k THEN
            vx = vx + (k - vn) * nx
            vy = vy + (k - vn) * ny
        ENDIF
    ENDIF
ENDSUB

SUB PHYSTEP(lmove, rmove)
    DIM i, k, c, dx, dy, d2, d, nx, ny, sp, lk, rk
    vy = vy + G
    sp = SQR(vx * vx + vy * vy)
    IF sp > VMAX THEN
        vx = vx * VMAX / sp
        vy = vy * VMAX / sp
    ENDIF
    px = px + vx
    py = py + vy
    c = INT(px / CELL) + INT(py / CELL) * GW
    IF c >= 0 ANDALSO c < GW * GH THEN
        FOR k = 0 TO GN[c] - 1
            i = GL[c * GMAX + k]
            HITSEG(SX1[i], SY1[i], SX2[i], SY2[i], SE[i], 0)
        NEXT k
    ENDIF
    IF py > 160 ANDALSO px < 244 THEN
        IF px < 152 THEN
            lk = 0
            IF lmove = 1 THEN lk = FKICK
            HITSEG(LFX, LFY, LFX + FLEN * COS(la), LFY + FLEN * SIN(la), 0.6, lk)
        ELSE
            rk = 0
            IF rmove = 1 THEN rk = FKICK
            HITSEG(RFX, RFY, RFX + FLEN * COS(ra), RFY + FLEN * SIN(ra), 0.6, rk)
        ENDIF
        ' the kickback throws a ball in the left outlane back up, once
        IF kick = 1 ANDALSO px < 72 ANDALSO py > 222 THEN
            kick = 0
            vy = -VMAX
            vx = 0
            px = 66
            ADDSCORE(500)
            snd = 700
            sndf = 4
            flash = 4
            msg$ = "KICK BACK"
            msgt = 60
        ENDIF
    ENDIF
    ' the targets: a standing one is a wall that falls when struck
    IF px > 198 ANDALSO px < 246 ANDALSO py > 116 ANDALSO py < 164 THEN
        FOR i = 0 TO 2
            IF TUP[i] = 1 THEN
                HIT = 0
                HITSEG(T1X[i], T1Y[i], T2X[i], T2Y[i], 0.6, 0)
                IF HIT = 1 THEN
                    TUP[i] = 0
                    TDRAW = 1
                    ADDSCORE(200)
                    snd = 660
                    sndf = 3
                    flash = 2
                    IF TUP[0] + TUP[1] + TUP[2] = 0 THEN
                        ADDSCORE(1000)
                        TUP[0] = 1
                        TUP[1] = 1
                        TUP[2] = 1
                        kick = 1
                        msg$ = "BANK 1000"
                        msgt = 90
                        IF PBOARD = 1 THEN PLAY "T240 O5 L16 C E G > C"
                        flash = 6
                    ENDIF
                ENDIF
            ENDIF
        NEXT i
    ENDIF
    ' the bumpers throw the ball away from their centre
    IF py < 150 THEN
        FOR i = 0 TO 2
            dx = px - BX[i]
            dy = py - BY[i]
            d2 = dx * dx + dy * dy
            IF d2 < (R + BR) * (R + BR) ANDALSO d2 > 0 THEN
                d = SQR(d2)
                nx = dx / d
                ny = dy / d
                px = BX[i] + nx * (R + BR)
                py = BY[i] + ny * (R + BR)
                vx = nx * BKICK
                vy = ny * BKICK
                ADDSCORE(100)
                BHIT[i] = 6
                snd = 880
                sndf = 3
                flash = 3
            ENDIF
        NEXT i
    ENDIF
    ' the spinner turns while the ball passes through it
    IF ABS(px - SPX) < 10 ANDALSO ABS(py - SPY) < R + 2 ANDALSO SPIN < 10 THEN
        SPIN = 48
    ENDIF
    ' the rollover lanes light up as the ball passes their row
    IF py > 34 ANDALSO py < 42 THEN
        FOR i = 0 TO 3
            IF px > LX1[i] ANDALSO px < LX2[i] ANDALSO LLIT[i] = 0 THEN
                LLIT[i] = 1
                LDRAW = 1
                IF i = SKILL ANDALSO saver > 0 THEN
                    ADDSCORE(1000)
                    msg$ = "SKILL SHOT"
                    msgt = 90
                    flash = 6
                    snd = 1500
                    sndf = 4
                ELSE
                    ADDSCORE(50)
                    snd = 1200
                    sndf = 2
                ENDIF
                IF LLIT[0] + LLIT[1] + LLIT[2] + LLIT[3] = 4 THEN
                    ADDSCORE(500)
                    LLIT[0] = 0
                    LLIT[1] = 0
                    LLIT[2] = 0
                    LLIT[3] = 0
                    IF mult < 5 THEN mult = mult + 1
                    msg$ = "BONUS X" + STR$(mult)
                    msgt = 90
                    IF PBOARD = 1 THEN PLAY "T240 O5 L16 G E C E G"
                    flash = 6
                ENDIF
            ENDIF
        NEXT i
    ENDIF
ENDSUB

' ---- drawing ----------------------------------------------------------

SUB DRAWSEG(i)
    IF SE[i] > 1 THEN
        DRAWCOLOR 255, 160, 40
    ELSE
        DRAWCOLOR 80, 200, 255
    ENDIF
    LINE SX1[i], SY1[i], SX2[i], SY2[i]
ENDSUB

SUB DRAWBUMPER(i)
    IF BHIT[i] > 0 THEN
        DRAWCOLOR 255, 255, 255
        CIRCLE BX[i], BY[i], BR, 1
    ELSE
        DRAWCOLOR 0, 0, 0
        CIRCLE BX[i], BY[i], BR - 1, 1
        DRAWCOLOR 230, 80, 230
        CIRCLE BX[i], BY[i], BR
        CIRCLE BX[i], BY[i], 3, 1
    ENDIF
ENDSUB

SUB DRAWTARGETS()
    DIM i
    FOR i = 0 TO 2
        IF TUP[i] = 1 THEN
            DRAWCOLOR 255, 80, 80
        ELSE
            DRAWCOLOR 0, 0, 0
        ENDIF
        LINE T1X[i], T1Y[i], T2X[i], T2Y[i]
        LINE T1X[i] + 1, T1Y[i], T2X[i] + 1, T2Y[i]
        LINE T1X[i], T1Y[i] + 1, T2X[i], T2Y[i] + 1
    NEXT i
ENDSUB

SUB DRAWLANES()
    DIM i
    FOR i = 0 TO 3
        IF LLIT[i] = 1 THEN
            DRAWCOLOR 255, 230, 60
            CIRCLE (LX1[i] + LX2[i]) / 2, 38, 3, 1
        ELSE
            DRAWCOLOR 0, 0, 0
            CIRCLE (LX1[i] + LX2[i]) / 2, 38, 2, 1
            IF i = SKILL ANDALSO saver > 0 THEN
                DRAWCOLOR 255, 160, 40
            ELSE
                DRAWCOLOR 90, 90, 40
            ENDIF
            CIRCLE (LX1[i] + LX2[i]) / 2, 38, 3
        ENDIF
    NEXT i
ENDSUB

SUB DRAWSPINNER(cr, cg, cb)
    DIM dx, dy
    dx = 8 * COS(SPA)
    dy = 3 * SIN(SPA)
    DRAWCOLOR cr, cg, cb
    LINE SPX - dx, SPY - dy, SPX + dx, SPY + dy
    LINE SPX - dx, SPY - dy + 1, SPX + dx, SPY + dy + 1
ENDSUB

' The name on the apron between the flippers, redrawn with them.
SUB DRAWTITLE()
    DRAWCOLOR 70, 70, 150
    TEXT 124, 222, "jdBASIC"
    DRAWCOLOR 45, 45, 100
    TEXT 124, 230, "PINBALL"
ENDSUB

SUB DRAWKICK()
    IF kick = 1 THEN
        DRAWCOLOR 60, 255, 120
    ELSE
        DRAWCOLOR 30, 60, 40
    ENDIF
    RECT 61, 226, 10, 3, 1
ENDSUB

SUB DRAWTABLE()
    DIM i
    FOR i = 0 TO NSEG - 1
        DRAWSEG(i)
    NEXT i
    FOR i = 0 TO 2
        DRAWBUMPER(i)
    NEXT i
    DRAWTARGETS
    DRAWLANES
    DRAWSPINNER(120, 255, 200)
    DRAWKICK
ENDSUB

SUB DRAWFLIPPER(x0, y0, a, cr, cg, cb)
    DIM tx, ty
    tx = x0 + FLEN * COS(a)
    ty = y0 + FLEN * SIN(a)
    DRAWCOLOR cr, cg, cb
    LINE x0, y0 - 2, tx, ty - 1
    LINE x0, y0, tx, ty
    LINE x0, y0 + 2, tx, ty + 1
    CIRCLE x0, y0, 3, 1
ENDSUB

SUB DRAWHUD()
    DRAWCOLOR 0, 0, 0
    RECT 0, 0, 58, 130, 1
    DRAWCOLOR 255, 230, 60
    TEXT 2, 4, "SCORE"
    TEXT 2, 14, STR$(score)
    DRAWCOLOR 200, 200, 200
    TEXT 2, 30, "HIGH"
    TEXT 2, 40, STR$(hiscore)
    TEXT 2, 56, "BALL " + STR$(balls)
    IF mult > 1 THEN
        DRAWCOLOR 255, 160, 40
        TEXT 2, 68, "BONUS"
        TEXT 2, 78, "X" + STR$(mult)
    ENDIF
    IF saver > 0 THEN
        DRAWCOLOR 60, 255, 120
        TEXT 2, 92, "SAVE"
    ENDIF
    IF tilt = 1 THEN
        DRAWCOLOR 255, 80, 80
        TEXT 2, 106, "TILT"
    ENDIF
    IF over = 1 THEN
        DRAWCOLOR 255, 80, 80
        TEXT 2, 106, "GAME"
        TEXT 2, 116, "OVER"
    ENDIF
ENDSUB

' The margin is seven characters wide; a message breaks at its space.
SUB DRAWMSG()
    DIM sp
    DRAWCOLOR 0, 0, 0
    RECT 262, 130, 58, 40, 1
    IF msgt > 0 THEN
        DRAWCOLOR 255, 230, 60
        sp = INSTR(msg$, " ")
        IF sp < 0 THEN
            TEXT 264, 134, LEFT$(msg$, 7)
        ELSE
            TEXT 264, 134, LEFT$(msg$, sp)
            TEXT 264, 144, LEFT$(MID$(msg$, sp + 1, LEN(msg$)), 7)
        ENDIF
    ENDIF
ENDSUB

SUB DRAWHELP()
    DRAWCOLOR 0, 0, 0
    RECT 262, 0, 58, 120, 1
    DRAWCOLOR 200, 200, 200
    TEXT 264, 4, "SHIFTS"
    TEXT 264, 14, "FLIP"
    TEXT 264, 30, "SPACE"
    TEXT 264, 40, "HOLD"
    TEXT 264, 50, "LAUNCH"
    TEXT 264, 66, "DOWN"
    TEXT 264, 76, "NUDGE"
    TEXT 264, 92, "Q QUIT"
ENDSUB

SUB DRAWCHARGE()
    DRAWCOLOR 0, 0, 0
    RECT 247, 190, 12, 46, 1
    IF charge > 0 THEN
        DRAWCOLOR 255, 120, 40
        RECT 248, 236 - charge * 44, 10, charge * 44, 1
    ENDIF
ENDSUB

SUB LEDS(r, g, b)
    DIM i
    FOR i = 0 TO 4
        NEOPIXEL.SET(i, r, g, b)
    NEXT i
    NEOPIXEL.SHOW
ENDSUB

SUB LEDBALLS()
    DIM i
    FOR i = 0 TO 4
        IF i < balls THEN
            NEOPIXEL.SET(i, 0, 40, 0)
        ELSE
            NEOPIXEL.SET(i, 0, 0, 0)
        ENDIF
    NEXT i
    NEOPIXEL.SHOW
ENDSUB

SUB NEWGAME()
    over = 0
    balls = 3
    score = 0
    mult = 1
    extra = 0
    kick = 1
    tilt = 0
    LLIT[0] = 0
    LLIT[1] = 0
    LLIT[2] = 0
    LLIT[3] = 0
    LDRAW = 1
    hud = 1
    IF PBOARD = 1 THEN PLAY "T200 O4 L16 C E G > C"
ENDSUB

DRAWCOLOR 0, 0, 0
RECT 0, 0, 320, 240, 1
DRAWTABLE
DRAWFLIPPER(LFX, LFY, la, 255, 255, 255)
DRAWFLIPPER(RFX, RFY, ra, 255, 255, 255)
DRAWTITLE
DRAWHUD
DRAWHELP
DRAWCOLOR 60, 255, 120
TEXT 2, 196, "jdBASIC"
DRAWCOLOR 200, 200, 200
TEXT 2, 206, "PINBALL"
DRAWCOLOR 90, 90, 40
TEXT 2, 222, "V1"
IF PBOARD = 1 THEN LEDBALLS

' ---- the frame loop ---------------------------------------------------

frames = 0
busy = 0
busymax = 0
tphys = 0
tdraw = 0

DO WHILE RUNNING = 1
    t0 = TICK()

    inlane = 0
    IF px > 244 ANDALSO py > 220 ANDALSO ABS(vy) < 0.5 THEN inlane = 1
    lhold = 0
    rhold = 0
    space = 0
    nudge = 0
    IF GFX.KEYSTATE(KLEFT) ORELSE GFX.KEYSTATE(KLSHIFT) THEN lhold = 1
    IF GFX.KEYSTATE(KRIGHT) ORELSE GFX.KEYSTATE(KRSHIFT) THEN rhold = 1
    IF GFX.KEYSTATE(KSPACE) THEN space = 1
    IF GFX.KEYSTATE(KDOWN) THEN nudge = 1
    IF GFX.KEYSTATE(KQUIT) THEN RUNNING = 0
    ' the two buttons beside BOOT: flippers, and both together while the
    ' ball waits in the lane is the plunger
    IF PBOARD = 1 THEN
        b2 = 0
        b3 = 0
        IF BUTTON.GET(2) THEN b2 = 1
        IF BUTTON.GET(3) THEN b3 = 1
        IF inlane = 1 ANDALSO b2 = 1 ANDALSO b3 = 1 THEN
            space = 1
        ELSE
            IF b2 = 1 THEN lhold = 1
            IF b3 = 1 THEN rhold = 1
        ENDIF
    ENDIF
    IF lhold = 1 ORELSE rhold = 1 ORELSE space = 1 ORELSE nudge = 1 THEN
        IF AUTO = 1 THEN
            AUTO = 0
            IF over = 1 THEN NEWGAME
        ENDIF
        idle = 0
    ELSE
        idle = idle + 1
        IF idle > 600 THEN AUTO = 1
    ENDIF
    launch = 0
    IF AUTO = 1 THEN
        IF py > 175 ANDALSO px < 152 ANDALSO vy > 0 THEN lhold = 1
        IF py > 175 ANDALSO px >= 152 ANDALSO px < 244 ANDALSO vy > 0 THEN rhold = 1
        IF inlane = 1 THEN
            autowait = autowait - 1
            IF autowait <= 0 THEN
                launch = 0.6 + RND(1) * 0.4
                autowait = 30
            ENDIF
        ENDIF
    ELSE
        ' the plunger charges while space is held and fires on release
        IF inlane = 1 ANDALSO space = 1 THEN
            charge = charge + 0.025
            IF charge > 1 THEN charge = 1
            IF frames MOD 4 = 0 THEN DRAWCHARGE
        ENDIF
        IF inlane = 1 ANDALSO space = 0 ANDALSO charge > 0 THEN
            launch = charge
            charge = 0
            DRAWCHARGE
        ENDIF
    ENDIF

    IF launch > 0 THEN
        vy = -(1.5 + launch * (VMAX - 1.5))
        vx = 0
        launching = 6
        saver = 180
        SKILL = INT(RND(1) * 4)
        LDRAW = 1
        hud = 1
        IF over = 1 THEN NEWGAME
    ENDIF
    IF launching > 0 THEN
        snd = 300 + (6 - launching) * 120
        sndf = 1
        launching = launching - 1
    ENDIF
    IF saver > 0 THEN
        saver = saver - 1
        IF saver = 0 THEN hud = 1
    ENDIF

    ' a nudge shoves the ball sideways; three of them in two seconds tilt
    IF nudge = 1 ANDALSO nudget = 0 ANDALSO tilt = 0 THEN
        vx = vx + (RND(1) - 0.5)
        vy = vy - 0.2
        nudget = 15
        nudges = nudges + 1
        snd = 150
        sndf = 2
        IF nudges >= 3 THEN
            tilt = 1
            msg$ = "TILT"
            msgt = 120
            hud = 1
            IF PBOARD = 1 THEN PLAY "T120 O3 L4 C"
        ENDIF
    ENDIF
    IF nudget > 0 THEN nudget = nudget - 1
    IF frames MOD 120 = 0 THEN nudges = 0
    IF tilt = 1 THEN
        lhold = 0
        rhold = 0
    ENDIF

    ' flippers swing between rest and up at a fixed speed
    lmove = 0
    IF lhold = 1 ANDALSO la > LUP THEN
        IF la = LREST THEN
            snd = 200
            sndf = 1
        ENDIF
        la = la - FSPEED
        IF la < LUP THEN la = LUP
        lmove = 1
    ENDIF
    IF lhold = 0 ANDALSO la < LREST THEN
        la = la + FSPEED
        IF la > LREST THEN la = LREST
    ENDIF
    rmove = 0
    IF rhold = 1 ANDALSO ra < RUP THEN
        IF ra = RREST THEN
            snd = 200
            sndf = 1
        ENDIF
        ra = ra + FSPEED
        IF ra > RUP THEN ra = RUP
        rmove = 1
    ENDIF
    IF rhold = 0 ANDALSO ra > RREST THEN
        ra = ra - FSPEED
        IF ra < RREST THEN ra = RREST
    ENDIF

    ' a ball resting in the lane has nothing to compute
    t1 = TICK()
    HIT = 0
    ' The flippers move a third of their frame's swing per step, so a
    ' ball never finds one on the far side of where it was a moment ago.
    IF inlane = 0 ORELSE launch > 0 THEN
        lt = la
        rt = ra
        FOR s = 1 TO SUBSTEPS
            la = ola + (lt - ola) * s / SUBSTEPS
            ra = ora + (rt - ora) * s / SUBSTEPS
            PHYSTEP(lmove, rmove)
        NEXT s
        la = lt
        ra = rt
    ENDIF
    tphys = tphys + (TICK() - t1)
    IF SPIN > 0 THEN
        SPIN = SPIN - 1
        SPA = SPA + 0.35
        IF SPIN MOD 4 = 0 THEN
            ADDSCORE(5)
            snd = 500 + SPIN * 10
            sndf = 1
        ENDIF
    ENDIF

    ' the drain: the saver hands the ball back, otherwise it is gone
    IF py > 246 THEN
        px = 252
        py = 228
        vx = 0
        vy = 0
        autowait = 40
        IF saver > 0 THEN
            saver = 0
            msg$ = "BALL SAVED"
            msgt = 90
            IF AUTO = 0 THEN launch = 1
            IF PBOARD = 1 THEN PLAY "T200 O5 L16 E G E G"
        ELSE
            bonus = (LLIT[0] + LLIT[1] + LLIT[2] + LLIT[3]) * 100
            IF bonus > 0 THEN
                ADDSCORE(bonus)
                msg$ = "BONUS " + STR$(bonus * mult)
                msgt = 90
            ENDIF
            balls = balls - 1
            tilt = 0
            kick = 1
            hud = 1
            IF balls <= 0 THEN
                over = 1
                IF score > hiscore THEN
                    hiscore = score
                    TRY
                        TXTWRITER "pinhi.txt", STR$(hiscore)
                    CATCH
                        junk = 0
                    ENDTRY
                    msg$ = "NEW HIGH"
                    msgt = 180
                ENDIF
                IF PBOARD = 1 THEN PLAY "T120 O4 L8 E C < A2"
            ELSE
                IF PBOARD = 1 THEN PLAY "T200 O3 L16 C < B A G"
            ENDIF
            IF PBOARD = 1 THEN LEDBALLS
        ENDIF
        IF launch = 1 THEN
            vy = -VMAX
            saver = 0
            launching = 6
        ENDIF
    ENDIF

    ' Wipe the ball and, when they moved or the ball is near them, the
    ' flippers; then put back what the wipes may have cut: the segments
    ' of the ball's cell, and the parts that sit near it.
    t1 = TICK()
    flip = 0
    IF la <> ola ORELSE ra <> ora ORELSE oy > 165 THEN flip = 1
    DRAWCOLOR 0, 0, 0
    CIRCLE ox, oy, R + 1, 1
    IF flip = 1 THEN
        DRAWFLIPPER(LFX, LFY, ola, 0, 0, 0)
        DRAWFLIPPER(RFX, RFY, ora, 0, 0, 0)
    ENDIF
    c = INT(ox / CELL) + INT(oy / CELL) * GW
    IF c >= 0 ANDALSO c < GW * GH THEN
        FOR k = 0 TO GN[c] - 1
            DRAWSEG(GL[c * GMAX + k])
        NEXT k
    ENDIF
    IF flip = 1 THEN
        DRAWSEG(SLING1)
        DRAWSEG(SLING2)
        DRAWSEG(NSEG - 3)
        DRAWSEG(NSEG - 2)
        DRAWKICK
        DRAWTITLE
    ENDIF
    FOR i = 0 TO 2
        IF BHIT[i] > 0 THEN
            BHIT[i] = BHIT[i] - 1
            DRAWBUMPER(i)
        ELSE
            IF ABS(ox - BX[i]) < BR + R + 2 ANDALSO ABS(oy - BY[i]) < BR + R + 2 THEN DRAWBUMPER(i)
        ENDIF
    NEXT i
    IF TDRAW = 1 ORELSE (ox > 196 ANDALSO ox < 246 ANDALSO oy > 114 ANDALSO oy < 166) THEN
        DRAWTARGETS
        TDRAW = 0
    ENDIF
    IF LDRAW = 1 ORELSE oy < 48 THEN
        DRAWLANES
        LDRAW = 0
    ENDIF
    IF SPIN > 0 ORELSE (ABS(ox - SPX) < 14 ANDALSO ABS(oy - SPY) < 10) THEN
        DRAWCOLOR 0, 0, 0
        RECT SPX - 9, SPY - 4, 19, 9, 1
        DRAWSPINNER(120, 255, 200)
    ENDIF
    IF flip = 1 THEN
        DRAWFLIPPER(LFX, LFY, la, 255, 255, 255)
        DRAWFLIPPER(RFX, RFY, ra, 255, 255, 255)
    ENDIF
    DRAWCOLOR 255, 230, 60
    CIRCLE px, py, R, 1
    DRAWCOLOR 255, 255, 255
    CIRCLE px - 1, py - 1, 1, 1
    IF hud = 1 THEN
        DRAWHUD
        hud = 0
    ENDIF
    IF msgt > 0 THEN
        IF msgt MOD 10 = 0 THEN DRAWMSG
        msgt = msgt - 1
        IF msgt = 0 THEN DRAWMSG
    ENDIF
    blink = blink + 1
    IF AUTO = 1 ANDALSO over = 0 THEN
        IF blink MOD 60 = 0 THEN
            DRAWCOLOR 255, 230, 60
            TEXT 264, 180, "PRESS"
            TEXT 264, 190, "SPACE"
        ENDIF
        IF blink MOD 60 = 30 THEN
            DRAWCOLOR 0, 0, 0
            RECT 262, 178, 58, 22, 1
        ENDIF
    ENDIF
    SCREENFLIP
    tdraw = tdraw + (TICK() - t1)
    ox = px
    oy = py
    ola = la
    ora = ra

    IF PBOARD = 1 THEN
        IF sndf > 0 THEN
            TONE snd
            sndf = sndf - 1
            IF sndf = 0 THEN TONE 0
        ENDIF
        IF flash > 0 THEN
            LEDS(80, 80, 80)
            flash = flash - 1
            IF flash = 0 THEN LEDBALLS
        ELSE
            IF AUTO = 1 ANDALSO blink MOD 8 = 0 THEN
                chase = (chase + 1) MOD 5
                FOR i = 0 TO 4
                    IF i = chase THEN
                        NEOPIXEL.SET(i, 40, 0, 60)
                    ELSE
                        NEOPIXEL.SET(i, 0, 0, 0)
                    ENDIF
                NEXT i
                NEOPIXEL.SHOW
            ENDIF
        ENDIF
    ENDIF

    frames = frames + 1
    el = TICK() - t0
    busy = busy + el
    IF el > busymax THEN busymax = el
    IF frames MOD 300 = 0 THEN
        PRINT "frames "; frames; "  busy "; FORMAT$("{:.1f}", busy / 300); " ms  physics "; FORMAT$("{:.1f}", tphys / 300); "  draw "; FORMAT$("{:.1f}", tdraw / 300); "  worst "; busymax; "  score "; score; "  ball "; INT(px); ","; INT(py)
        busy = 0
        busymax = 0
        tphys = 0
        tdraw = 0
    ENDIF
    IF el < 16 THEN SLEEP 16 - el
LOOP

IF PBOARD = 1 THEN
    TONE 0
    LEDS(0, 0, 0)
    GFX.CONSOLE 1
ENDIF
PRINT "pinball closed, score "; score; "  high "; hiscore
