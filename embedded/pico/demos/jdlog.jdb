' Autonomous temperature logger. This is the power-on program:
'
'     AUTORUN jdlog.jdb
'
' It does not load the plotter. Nobody is looking at the panel while the board
' is away, and the library costs 33 KB and a few seconds of loading that the
' logging job does not need. The samples go to log.csv on the flash store.
'
' To see them, load the plotter and draw the file:
'
'     RUN jdmload.jdb
'     RUN jdshow.jdb
'
' The first sample is taken immediately, so the screen says something within a
' second of power-on rather than after the first interval.
'
' Any of ESC, Ctrl-C or q stops it and hands back the prompt. The PicoCalc
' keyboard does not send the same code as a serial terminal, so the handler
' accepts several - run keycode.jdb to see what a given key sends here.

DIM PERIOD
DIM RUNNING
DIM SEQ
PERIOD = 60000
RUNNING = 1
SEQ = 0

SUB TAKESAMPLE()
    DIM c
    c = ADC.TEMP()
    SEQ = SEQ + 1
    TXTWRITER("log.csv", STR$(SEQ) + "," + FORMAT$("{:.2f}", c) + CHR$(10), TRUE)
    PRINT SEQ; ": "; FORMAT$("{:.2f}", c); " degC"
ENDSUB

SUB ONSAMPLE(d)
    TAKESAMPLE
ENDSUB

SUB ONKEY(d)
    DIM k
    k = d[0]
    ' 177 is the PicoCalc's ESC key, measured with keycode.jdb - the keyboard
    ' controller has its own block up there, the arrows being 180 to 183. 27 is
    ' ESC from a serial terminal, 3 is Ctrl-C, and q works from either.
    IF k = 177 ORELSE k = 27 ORELSE k = 3 ORELSE k = 113 ORELSE k = 81 THEN RUNNING = 0
ENDSUB

ON "TICK" CALL ONSAMPLE
ON "KEY" CALL ONKEY
KEY.WATCH(TRUE)

CLS
PRINT "jdlog - a sample every "; PERIOD / 1000; " s"
PRINT "ESC, Ctrl-C or q stops"
TAKESAMPLE
TIMER.EVERY(PERIOD)

DO WHILE RUNNING = 1
    SLEEP 200
LOOP

TIMER.STOP()
KEY.WATCH(FALSE)
PRINT "stopped after "; SEQ; " samples - log.csv has them"
