' STELLAR DRIFT, the Fruit Jam cut. 320 by 240 over DVI, no back buffer:
' the framebuffer is what the wire is reading, so everything that moves
' is erased in black at its old place and drawn at its new one.
'
' Arrows fly, space or button 2 fires, q leaves. Written small on
' purpose: the board has about forty kilobytes for a program.

GFX.CONSOLE 0
GFX.CLEAR 0

DIM sx[10]
DIM sy[10]
DIM bx[4]
DIM by[4]
DIM ex[4]
DIM ey[4]

FOR i = 0 TO 9
  sx[i] = RND(1) * 318
  sy[i] = RND(1) * 200 + 14
NEXT i
FOR i = 0 TO 3
  by[i] = 0 - 1
  ex[i] = RND(1) * 300 + 10
  ey[i] = RND(1) * 100 + 14
NEXT i

px = 160
op = 160
sc = 0
go = 1

DRAWCOLOR 255, 255, 255
TEXT 4, 4, "STELLAR DRIFT", 1

DO
  k = KEY.NOW()
  IF k = 180 THEN px = px - 6
  IF k = 183 THEN px = px + 6
  IF k = 113 THEN go = 0
  IF px < 10 THEN px = 10
  IF px > 310 THEN px = 310

  IF k = 32 OR BUTTON.GET(2) THEN
    FOR i = 0 TO 3
      IF by[i] < 0 THEN
        bx[i] = px
        by[i] = 206
        EXITFOR
      ENDIF
    NEXT i
  ENDIF

  FOR i = 0 TO 9
    DRAWCOLOR 0, 0, 0
    PSET sx[i], sy[i]
    sy[i] = sy[i] + 1
    IF sy[i] > 205 THEN
      sy[i] = 14
      sx[i] = RND(1) * 318
    ENDIF
    DRAWCOLOR 130, 130, 170
    PSET sx[i], sy[i]
  NEXT i

  FOR i = 0 TO 3
    IF by[i] >= 0 THEN
      DRAWCOLOR 0, 0, 0
      LINE bx[i], by[i], bx[i], by[i] + 4
      by[i] = by[i] - 8
      IF by[i] < 14 THEN
        by[i] = 0 - 1
      ELSE
        DRAWCOLOR 255, 230, 60
        LINE bx[i], by[i], bx[i], by[i] + 4
      ENDIF
    ENDIF
  NEXT i

  FOR i = 0 TO 3
    DRAWCOLOR 0, 0, 0
    LINE ex[i] - 6, ey[i], ex[i] + 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] - 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] + 6, ey[i]
    ey[i] = ey[i] + 2
    IF ey[i] > 200 THEN
      ey[i] = 14
      ex[i] = RND(1) * 300 + 10
    ENDIF
    FOR j = 0 TO 3
      IF by[j] >= 0 THEN
        dx = bx[j] - ex[i]
        IF dx < 0 THEN dx = 0 - dx
        dy = by[j] - ey[i]
        IF dy < 0 THEN dy = 0 - dy
        IF dx < 8 AND dy < 9 THEN
          DRAWCOLOR 0, 0, 0
          LINE bx[j], by[j], bx[j], by[j] + 4
          by[j] = 0 - 1
          ey[i] = 14
          ex[i] = RND(1) * 300 + 10
          sc = sc + 10
        ENDIF
      ENDIF
    NEXT j
    DRAWCOLOR 230, 60, 60
    LINE ex[i] - 6, ey[i], ex[i] + 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] - 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] + 6, ey[i]
  NEXT i

  IF px <> op THEN
    DRAWCOLOR 0, 0, 0
    LINE op, 214, op - 7, 228
    LINE op, 214, op + 7, 228
    LINE op - 7, 228, op + 7, 228
    op = px
  ENDIF
  DRAWCOLOR 40, 220, 90
  LINE px, 214, px - 7, 228
  LINE px, 214, px + 7, 228
  LINE px - 7, 228, px + 7, 228

  SLEEP 20
LOOP WHILE go = 1

GFX.CLEAR 0
GFX.CONSOLE 1
PRINT "score "; sc
