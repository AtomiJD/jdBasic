' STELLAR DRIFT, the Fruit Jam cut. 320 by 240 over DVI, no back buffer:
' the framebuffer is what the wire is reading, so everything that moves
' is erased in black at its old place and drawn at its new one.
'
' A DualShock flies it: left stick or d-pad to steer, cross or R2 to
' fire, options to leave. The keyboard still works - arrows, space, q -
' so it plays without a pad too.
'
' Written small on purpose: the board has about seventy kilobytes for a
' program and the compiler is the part that spends them.

GFX.CONSOLE 0
GFX.CLEAR 0

DIM sx[10]
DIM sy[10]
DIM bx[4]
DIM by[4]
DIM ex[4]
DIM ey[4]

FOR i = 0 TO 9
  sx[i] = RND(1) * 318
  sy[i] = RND(1) * 200 + 14
NEXT i
FOR i = 0 TO 3
  by[i] = 0 - 1
  ex[i] = RND(1) * 300 + 10
  ey[i] = RND(1) * 100 + 14
NEXT i

px = 160
op = 160
sc = 0
go = 1
pad = JOY.COUNT()
fired = 0

DRAWCOLOR 255, 255, 255
TEXT 4, 4, "STELLAR DRIFT", 1
IF pad > 0 THEN TEXT 4, 240 - 10, JOY.NAME$(0), 1

DO
  ' Held, not typed. The key queue gives one character a press and then
  ' a pause, which is right for an editor and useless for steering.
  IF GFX.KEYSTATE(180) THEN px = px - 6
  IF GFX.KEYSTATE(183) THEN px = px + 6
  shoot = 0
  IF GFX.KEYSTATE(32) THEN shoot = 1
  IF GFX.KEYSTATE(113) THEN go = 0

  IF pad > 0 THEN
    ' The stick steers by how far it is pushed; the hat is all or
    ' nothing. Bit 2 of the hat is right, bit 8 is left.
    ax = JOY.AXIS(0, 0)
    px = px + ax * 7
    h = JOY.HAT(0)
    IF h = 2 OR h = 3 OR h = 1 + 2 THEN px = px + 5
    IF h = 8 OR h = 12 OR h = 9 THEN px = px - 5
    ' Cross, or the right trigger pulled past halfway.
    IF JOY.BUTTON(0, 1) OR JOY.AXIS(0, 5) > 0.5 THEN shoot = 1
    IF JOY.BUTTON(0, 9) THEN go = 0
  ENDIF

  IF px < 10 THEN px = 10
  IF px > 310 THEN px = 310

  ' One shot a press, so holding the button does not empty the magazine
  ' in a single frame.
  IF shoot = 1 AND fired = 0 THEN
    FOR i = 0 TO 3
      IF by[i] < 0 THEN
        bx[i] = px
        by[i] = 206
        EXITFOR
      ENDIF
    NEXT i
  ENDIF
  fired = shoot

  FOR i = 0 TO 9
    DRAWCOLOR 0, 0, 0
    PSET sx[i], sy[i]
    sy[i] = sy[i] + 1
    IF sy[i] > 205 THEN
      sy[i] = 14
      sx[i] = RND(1) * 318
    ENDIF
    DRAWCOLOR 130, 130, 170
    PSET sx[i], sy[i]
  NEXT i

  FOR i = 0 TO 3
    IF by[i] >= 0 THEN
      DRAWCOLOR 0, 0, 0
      LINE bx[i], by[i], bx[i], by[i] + 4
      by[i] = by[i] - 8
      IF by[i] < 14 THEN
        by[i] = 0 - 1
      ELSE
        DRAWCOLOR 255, 230, 60
        LINE bx[i], by[i], bx[i], by[i] + 4
      ENDIF
    ENDIF
  NEXT i

  FOR i = 0 TO 3
    DRAWCOLOR 0, 0, 0
    LINE ex[i] - 6, ey[i], ex[i] + 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] - 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] + 6, ey[i]
    ey[i] = ey[i] + 2
    IF ey[i] > 200 THEN
      ey[i] = 14
      ex[i] = RND(1) * 300 + 10
    ENDIF
    FOR j = 0 TO 3
      IF by[j] >= 0 THEN
        dx = bx[j] - ex[i]
        IF dx < 0 THEN dx = 0 - dx
        dy = by[j] - ey[i]
        IF dy < 0 THEN dy = 0 - dy
        IF dx < 8 AND dy < 9 THEN
          DRAWCOLOR 0, 0, 0
          LINE bx[j], by[j], bx[j], by[j] + 4
          by[j] = 0 - 1
          ey[i] = 14
          ex[i] = RND(1) * 300 + 10
          sc = sc + 10
        ENDIF
      ENDIF
    NEXT j
    DRAWCOLOR 230, 60, 60
    LINE ex[i] - 6, ey[i], ex[i] + 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] - 6, ey[i]
    LINE ex[i], ey[i] + 7, ex[i] + 6, ey[i]
  NEXT i

  IF px <> op THEN
    DRAWCOLOR 0, 0, 0
    LINE op, 214, op - 7, 228
    LINE op, 214, op + 7, 228
    LINE op - 7, 228, op + 7, 228
    op = px
  ENDIF
  DRAWCOLOR 40, 220, 90
  LINE px, 214, px - 7, 228
  LINE px, 214, px + 7, 228
  LINE px - 7, 228, px + 7, 228

  SLEEP 20
LOOP WHILE go = 1

GFX.CLEAR 0
GFX.CONSOLE 1
PRINT "score "; sc
