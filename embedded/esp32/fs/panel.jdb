' The 2.8 inch panel, drawn with the same verbs as every other jdBasic
' screen. Everything goes into a framebuffer in PSRAM; SCREENFLIP is
' what reaches the glass.

SCREEN 320, 240

DIM W = GFX.WIDTH
DIM H = GFX.HEIGHT

GFX.CLEAR 8, 12, 40

' A horizon of bars, brightest at the top.
DIM i
FOR i = 0 TO 15
    DRAWCOLOR 20 + i * 12, 40 + i * 8, 90 + i * 10
    RECT 0, i * 6, W, 6, 1
NEXT

DRAWCOLOR 240, 70, 70
CIRCLE 60, 150, 34, 1
DRAWCOLOR 90, 220, 120
CIRCLE 150, 150, 34, 1
DRAWCOLOR 90, 150, 240
CIRCLE 240, 150, 34, 1

DRAWCOLOR 255, 255, 255
TEXT 16, 105, "jdBasic on ES3C28P", 1
TEXT 16, 205, "SCREEN / RECT / CIRCLE / TEXT", 1

DRAWCOLOR 255, 210, 60
LINE 0, 196, W - 1, 196
LINE 0, 224, W - 1, 224

SCREENFLIP

PRINT "panel "; W; "x"; H
PRINT "transfers "; GFX.DIAG
