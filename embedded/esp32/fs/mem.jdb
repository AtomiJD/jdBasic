' Where an array actually lives. Anything past the 16 KB threshold goes
' to PSRAM, so the internal figure barely moves while the PSRAM one
' drops by about 24 bytes an element.

DIM i0, p0
i0 = SYS.INTERNAL()
p0 = SYS.PSRAM()

DIM a = IOTA(100000)

PRINT "100000 elements"
PRINT "  internal spent : "; i0 - SYS.INTERNAL()
PRINT "  psram spent    : "; p0 - SYS.PSRAM()
PRINT "  bytes each     : "; (p0 - SYS.PSRAM()) / 100000
PRINT
PRINT "and it computes: SUM = "; SUM(a)
