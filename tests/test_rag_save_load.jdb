' Test: RAG_SAVE / RAG_LOAD Round-Trip mit TF-IDF
PRINT "=== Test 1: Speichern und Laden eines TF-IDF Index ==="

DIM rag = AI.RAG_CREATE(0, 200, 20)
AI.RAG_ADD rag, "jdBasic ist ein BASIC Interpreter mit AI Features.", "doc1"
AI.RAG_ADD rag, "Der RAG Store nutzt TF-IDF zur Textsuche.", "doc2"
AI.RAG_ADD rag, "PDF Dateien werden mit FlateDecode dekomprimiert.", "doc3"

DIM info1 = AI.RAG_INFO(rag)
PRINT "Vor Save: chunks="; info1{"chunks"}; " mode="; info1{"mode"}; " vocab="; info1{"vocab"}

AI.RAG_SAVE rag, "tests/test_rag.bin"

' Neuen RAG laden
DIM rag2 = AI.RAG_LOAD("tests/test_rag.bin")
DIM info2 = AI.RAG_INFO(rag2)
PRINT "Nach Load: chunks="; info2{"chunks"}; " mode="; info2{"mode"}; " vocab="; info2{"vocab"}

PRINT ""
PRINT "=== Suche im geladenen Index ==="
DIM hits = AI.RAG_SEARCH(rag2, "PDF dekomprimieren", 2)
FOR i = 0 TO LEN(hits) - 1
  PRINT "  ["; i; "] score="; hits[i]{"score"}; " src="; hits[i]{"source"}
  PRINT "      "; hits[i]{"text"}
NEXT i

PRINT ""
PRINT "=== Vergleich mit Original-Store ==="
DIM hits_orig = AI.RAG_SEARCH(rag, "PDF dekomprimieren", 2)
DIM ok = 1
FOR i = 0 TO LEN(hits) - 1
  IF hits[i]{"source"} <> hits_orig[i]{"source"} THEN ok = 0
NEXT i
IF ok = 1 THEN
  PRINT "  OK: Roundtrip identisch"
ELSE
  PRINT "  FAIL: Unterschied gefunden"
ENDIF

PRINT ""
PRINT "Done."
