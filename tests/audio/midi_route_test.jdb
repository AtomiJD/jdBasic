' ============================================================
' MIDI input on the synth: SOUND.MIDIIN, SOUND.ZONE, SOUND.MIDISTATS,
' MIDI.ROUTE. Note on/off per key, velocity, sustain pedal, all sound
' off, pitch bend, zones with channel, range and transpose.
' ============================================================
' Self-checking. Each failure prints [FAIL]; the RESULTS line last.
' Renders offline (SOUND.INIT "PULL"): no audio device, no MIDI device.

OPTION "EXPLICIT"
OPTION "STRICT"

DIM PASS_COUNT AS INTEGER = 0
DIM FAIL_COUNT AS INTEGER = 0

SUB CHECK(name$, cond AS INTEGER, detail$)
    IF cond THEN
        PASS_COUNT = PASS_COUNT + 1
    ELSE
        FAIL_COUNT = FAIL_COUNT + 1
        PRINT "[FAIL] "; name$; "  "; detail$
    ENDIF
ENDSUB

' Root mean square of the left channel, frames a..b-1
FUNC RMS(buf, a AS INTEGER, b AS INTEGER) AS DOUBLE
    DIM acc AS DOUBLE = 0
    DIM i AS INTEGER
    DIM x AS DOUBLE
    FOR i = a TO b - 1
        x = buf[i * 2]
        acc = acc + x * x
    NEXT i
    RETURN SQR(acc / (b - a))
ENDFUNC

' Upward zero crossings of the left channel, frames a..b-1
FUNC CROSSINGS(buf, a AS INTEGER, b AS INTEGER) AS INTEGER
    DIM n AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = a + 1 TO b - 1
        IF buf[i * 2 - 2] < 0 ANDALSO buf[i * 2] >= 0 THEN n = n + 1
    NEXT i
    RETURN n
ENDFUNC

' The level of the next `frames` frames, skipping the first 500
FUNC LEVEL(frames AS INTEGER) AS DOUBLE
    DIM buf = SOUND.RENDER(frames)
    RETURN RMS(buf, 500, frames)
ENDFUNC

SUB FRESH()
    SOUND.RESET
    SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
    SOUND.VOICE 1, "SINE", 0.001, 0.01, 1.0, 0.005
ENDSUB

IF NOT OS.FEATURE("SOUND") THEN
    PRINT "SKIP: build has no SOUND sequencer"
    PRINT "RESULTS: 0 passed, 0 failed"
    END
ENDIF

SOUND.INIT "PULL"
DIM lvl AS DOUBLE
DIM lvl2 AS DOUBLE

' ---------- note on / note off ----------
FRESH()
CHECK "silent before a key", LEVEL(2000) < 0.001, ""
SOUND.MIDIIN 144, 60, 127
lvl = LEVEL(4000)
CHECK "note on sounds", lvl > 0.3, "rms=" + STR$(lvl)
SOUND.MIDIIN 128, 60, 0
lvl = LEVEL(4000)
CHECK "note off releases", lvl < 0.001, "rms=" + STR$(lvl)
SOUND.MIDIIN 144, 60, 100
SOUND.MIDIIN 144, 60, 0
lvl = LEVEL(4000)
CHECK "note on with velocity 0 is a note off", lvl < 0.001, "rms=" + STR$(lvl)

' ---------- velocity ----------
FRESH()
SOUND.MIDIIN 144, 60, 127
lvl = LEVEL(4000)
SOUND.MIDIIN 128, 60, 0
lvl2 = LEVEL(4000)
SOUND.MIDIIN 144, 60, 32
lvl2 = LEVEL(4000)
CHECK "velocity 32 is a quarter of 127", ABS(lvl2 / lvl - 32.0 / 127.0) < 0.02, "ratio=" + STR$(lvl2 / lvl)

' ---------- note off releases only its own key ----------
FRESH()
SOUND.MIDIIN 144, 60, 127
SOUND.MIDIIN 144, 67, 127
lvl = LEVEL(2000)
SOUND.MIDIIN 128, 60, 0
lvl2 = LEVEL(4000)
CHECK "the other key keeps sounding", lvl2 > 0.3, "rms=" + STR$(lvl2)
SOUND.MIDIIN 128, 67, 0
CHECK "both keys up is silence", LEVEL(4000) < 0.001, ""

' ---------- channel of the note off ----------
FRESH()
SOUND.MIDIIN 144, 60, 127
SOUND.MIDIIN 129, 60, 0
CHECK "note off on another channel keeps the key", LEVEL(4000) > 0.3, ""
SOUND.MIDIIN 128, 60, 0
CHECK "note off on its channel releases", LEVEL(4000) < 0.001, ""

' ---------- sustain pedal ----------
FRESH()
SOUND.MIDIIN 176, 64, 127
SOUND.MIDIIN 144, 60, 127
lvl = LEVEL(2000)
SOUND.MIDIIN 128, 60, 0
lvl = LEVEL(4000)
CHECK "pedal holds a released key", lvl > 0.3, "rms=" + STR$(lvl)
SOUND.MIDIIN 176, 64, 0
lvl = LEVEL(4000)
CHECK "pedal up releases it", lvl < 0.001, "rms=" + STR$(lvl)
SOUND.MIDIIN 144, 62, 127
SOUND.MIDIIN 128, 62, 0
CHECK "without pedal the key releases at once", LEVEL(4000) < 0.001, ""

' ---------- all sound off / all notes off ----------
FRESH()
SOUND.MIDIIN 144, 60, 127
SOUND.MIDIIN 144, 64, 127
lvl = LEVEL(2000)
SOUND.MIDIIN 176, 120, 0
CHECK "CC 120 cuts every voice", LEVEL(2000) < 0.001, ""
SOUND.MIDIIN 176, 64, 127
SOUND.MIDIIN 144, 60, 127
lvl = LEVEL(2000)
SOUND.MIDIIN 176, 123, 0
CHECK "CC 123 releases even under the pedal", LEVEL(4000) < 0.001, ""
SOUND.MIDIIN 176, 64, 0

' ---------- pitch bend ----------
FRESH()
DIM buf = []
DIM zc0 AS INTEGER
DIM zc1 AS INTEGER
SOUND.MIDIIN 144, 69, 127
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "A4 is 440 Hz", ABS(zc0 - 440) <= 2, "crossings=" + STR$(zc0)
SOUND.MIDIIN 224, 127, 127
buf = SOUND.RENDER(44100)
zc1 = CROSSINGS(buf, 0, 44100)
CHECK "full bend up is 2 semitones", ABS(zc1 - 494) <= 2, "crossings=" + STR$(zc1)
SOUND.MIDIIN 224, 0, 64
buf = SOUND.RENDER(44100)
zc1 = CROSSINGS(buf, 0, 44100)
CHECK "centre bend is back at 440", ABS(zc1 - 440) <= 2, "crossings=" + STR$(zc1)
SOUND.MIDIIN 128, 69, 0

' ---------- zones ----------
FRESH()
CHECK "two zones", SOUND.ZONE(0, 0, 59) = 1 ANDALSO SOUND.ZONE(1, 60, 127, 0, 12) = 2, ""
SOUND.GAIN 1, 0
SOUND.MIDIIN 144, 72, 127
CHECK "a key in the muted zone is silent", LEVEL(4000) < 0.001, ""
SOUND.MIDIIN 128, 72, 0
SOUND.MIDIIN 144, 57, 127
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "the left zone plays its track", ABS(zc0 - 220) <= 2, "crossings=" + STR$(zc0)
SOUND.MIDIIN 128, 57, 0
SOUND.GAIN 1, 1
SOUND.GAIN 0, 0
SOUND.MIDIIN 144, 69, 127
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "transpose 12 plays an octave up", ABS(zc0 - 880) <= 3, "crossings=" + STR$(zc0)
SOUND.MIDIIN 128, 69, 0

FRESH()
CHECK "zone on channel 2", SOUND.ZONE(0, 0, 127, 2) = 1, ""
SOUND.MIDIIN 144, 60, 127
CHECK "channel 1 does not play a channel 2 zone", LEVEL(4000) < 0.001, ""
SOUND.MIDIIN 145, 60, 127
CHECK "channel 2 plays it", LEVEL(4000) > 0.3, ""
SOUND.MIDIIN 129, 60, 0

FRESH()
CHECK "two zones on the same keys", SOUND.ZONE(0) = 1 ANDALSO SOUND.ZONE(1) = 2, ""
DIM levels = SOUND.LEVELS()
SOUND.MIDIIN 144, 60, 127
lvl = LEVEL(4000)
levels = SOUND.LEVELS()
SOUND.MIDIIN 128, 60, 0
CHECK "a layer plays both tracks", levels[0] > 0.3 ANDALSO levels[1] > 0.3, "levels=" + STR$(levels[0]) + "," + STR$(levels[1])
CHECK "SOUND.ZONE -1 clears", SOUND.ZONE(-1) = 0, ""

DIM err_msg AS STRING = ""
TRY
    lvl = SOUND.ZONE(16)
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "track 16 is refused", INSTR(err_msg, "SOUND.ZONE") >= 0, "msg=" + err_msg
err_msg = ""
TRY
    lvl = SOUND.ZONE(0, 0, 127, 17)
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "channel 17 is refused", INSTR(err_msg, "channel") >= 0, "msg=" + err_msg

' ---------- zone options ----------
FRESH()
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"vel_hi": 64})
lvl = SOUND.ZONE(1, 0, 127, 0, 0, {"vel_lo": 65})
DIM lv = SOUND.LEVELS()
SOUND.MIDIIN 144, 60, 40
lvl = LEVEL(4000)
lv = SOUND.LEVELS()
SOUND.MIDIIN 128, 60, 0
lvl = LEVEL(4000)
CHECK "a soft key plays the soft zone only", lv[0] > 0.1 ANDALSO lv[1] = 0, "levels=" + STR$(lv[0]) + "," + STR$(lv[1])
lv = SOUND.LEVELS()
SOUND.MIDIIN 144, 60, 120
lvl = LEVEL(4000)
lv = SOUND.LEVELS()
SOUND.MIDIIN 128, 60, 0
CHECK "a hard key plays the hard zone only", lv[0] = 0 ANDALSO lv[1] > 0.1, "levels=" + STR$(lv[0]) + "," + STR$(lv[1])

FRESH()
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"bend": 0})
SOUND.MIDIIN 144, 69, 127
SOUND.MIDIIN 224, 127, 127
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "bend 0 ignores the wheel", ABS(zc0 - 440) <= 2, "crossings=" + STR$(zc0)
SOUND.MIDIIN 128, 69, 0
lvl = SOUND.ZONE(-1)
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"bend": 12})
SOUND.MIDIIN 144, 69, 127
SOUND.MIDIIN 224, 127, 127
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "bend 12 bends an octave", ABS(zc0 - 880) <= 3, "crossings=" + STR$(zc0)
SOUND.MIDIIN 224, 0, 64
SOUND.MIDIIN 128, 69, 0

FRESH()
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"sustain": FALSE})
SOUND.MIDIIN 176, 64, 127
SOUND.MIDIIN 144, 60, 127
lvl = LEVEL(2000)
SOUND.MIDIIN 128, 60, 0
CHECK "a zone without sustain ignores the pedal", LEVEL(4000) < 0.001, ""
SOUND.MIDIIN 176, 64, 0

' ---------- mono and legato ----------
FRESH()
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"mono": TRUE})
SOUND.MIDIIN 144, 69, 127
SOUND.MIDIIN 144, 81, 127
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "mono plays only the newest key", ABS(zc0 - 880) <= 3, "crossings=" + STR$(zc0)
SOUND.MIDIIN 128, 81, 0
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "mono falls back to the key still held", ABS(zc0 - 440) <= 3, "crossings=" + STR$(zc0)
SOUND.MIDIIN 128, 69, 0
CHECK "mono is silent with no key held", LEVEL(4000) < 0.001, ""

FRESH()
SOUND.VOICE 0, "SINE", 0.3, 0.01, 1.0, 0.005
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"mono": TRUE})
SOUND.MIDIIN 144, 69, 127
lvl = LEVEL(30000)
SOUND.MIDIIN 144, 81, 127
buf = SOUND.RENDER(2000)
lvl = RMS(buf, 0, 2000)
CHECK "mono restarts the envelope", lvl < 0.2, "rms=" + STR$(lvl)
SOUND.MIDIIN 176, 123, 0
lvl = LEVEL(4000)

FRESH()
SOUND.VOICE 0, "SINE", 0.3, 0.01, 1.0, 0.005
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"legato": TRUE})
SOUND.MIDIIN 144, 69, 127
lvl = LEVEL(30000)
SOUND.MIDIIN 144, 81, 127
buf = SOUND.RENDER(2000)
lvl = RMS(buf, 0, 2000)
CHECK "legato keeps the envelope", lvl > 0.3, "rms=" + STR$(lvl)
buf = SOUND.RENDER(44100)
zc0 = CROSSINGS(buf, 0, 44100)
CHECK "legato moves to the new key", ABS(zc0 - 880) <= 3, "crossings=" + STR$(zc0)
SOUND.MIDIIN 176, 123, 0
lvl = LEVEL(4000)

' ---------- velocity and mod wheel on the filter ----------
FRESH()
SOUND.FILTER 0, 2000, 0, "LP"
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"vel_cutoff": 4})
SOUND.MIDIIN 144, 93, 127
lvl = LEVEL(8000) / 1.0
SOUND.MIDIIN 128, 93, 0
lvl2 = LEVEL(4000)
SOUND.MIDIIN 144, 93, 64
lvl2 = LEVEL(8000) / (64.0 / 127.0)
SOUND.MIDIIN 128, 93, 0
CHECK "a soft key closes the filter", lvl2 < lvl * 0.5, "hard=" + STR$(lvl) + " soft=" + STR$(lvl2)

FRESH()
SOUND.FILTER 0, 300, 0, "LP"
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"mod_cutoff": 3})
SOUND.MIDIIN 144, 93, 127
lvl = LEVEL(8000)
SOUND.MIDIIN 176, 1, 127
lvl2 = LEVEL(8000)
SOUND.MIDIIN 176, 1, 0
SOUND.MIDIIN 128, 93, 0
CHECK "the mod wheel opens the filter", lvl2 > lvl * 3, "closed=" + STR$(lvl) + " open=" + STR$(lvl2)

FRESH()
lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"mod_vibrato": 3})
SOUND.MIDIIN 144, 69, 127
SOUND.MIDIIN 176, 1, 127
buf = SOUND.RENDER(44100)
DIM zmin AS INTEGER = 9999
DIM zmax AS INTEGER = 0
DIM w AS INTEGER
FOR w = 0 TO 9
    zc0 = CROSSINGS(buf, w * 4410, w * 4410 + 4410)
    IF zc0 < zmin THEN zmin = zc0
    IF zc0 > zmax THEN zmax = zc0
NEXT w
CHECK "the mod wheel adds vibrato", zmax - zmin >= 5, "min=" + STR$(zmin) + " max=" + STR$(zmax)
SOUND.MIDIIN 176, 1, 0
SOUND.MIDIIN 128, 69, 0

DIM opt_err AS STRING = ""
TRY
    lvl = SOUND.ZONE(0, 0, 127, 0, 0, {"velocity": 1})
CATCH
    opt_err = ERRMSG$
ENDTRY
CHECK "an unknown zone option is refused", INSTR(opt_err, "unknown option") >= 0, "msg=" + opt_err

' ---------- last note, for split learning ----------
FRESH()
DIM ln = SOUND.LASTNOTE()
CHECK "no key yet", ln{"note"} = -1 ANDALSO ln{"count"} = 0, ""
SOUND.MIDIIN 146, 55, 99
SOUND.MIDIIN 130, 55, 0
lvl = LEVEL(1000)
ln = SOUND.LASTNOTE()
CHECK "the last key is known", ln{"note"} = 55 ANDALSO ln{"velocity"} = 99 ANDALSO ln{"channel"} = 3 ANDALSO ln{"count"} = 1, ""

' ---------- controllers mapped to parameters ----------
FRESH()
SOUND.FILTER 0, 5000, 0, "LP"
CHECK "one mapping", SOUND.CCMAP(74, 0, "cutoff", 200, 5000, "EXP", 0, FALSE) = 1, ""
SOUND.MIDIIN 144, 93, 127
lvl = LEVEL(8000)
SOUND.MIDIIN 176, 74, 0
lvl2 = LEVEL(8000)
CHECK "CC 74 at 0 closes the filter", lvl2 < lvl * 0.2, "open=" + STR$(lvl) + " closed=" + STR$(lvl2)
SOUND.MIDIIN 176, 74, 127
lvl2 = LEVEL(8000)
CHECK "CC 74 at 127 opens it again", ABS(lvl2 - lvl) < 0.02, "open=" + STR$(lvl) + " again=" + STR$(lvl2)
SOUND.MIDIIN 128, 93, 0

FRESH()
SOUND.FILTER 0, 5000, 0, "LP"
lvl = SOUND.CCMAP(74, 0, "cutoff", 200, 5000, "EXP")
SOUND.MIDIIN 144, 93, 127
lvl = LEVEL(8000)
SOUND.MIDIIN 176, 74, 10
lvl2 = LEVEL(8000)
CHECK "pickup ignores a knob far from the value", ABS(lvl2 - lvl) < 0.02, "before=" + STR$(lvl) + " after=" + STR$(lvl2)
SOUND.MIDIIN 176, 74, 127
SOUND.MIDIIN 176, 74, 0
lvl2 = LEVEL(8000)
CHECK "after passing the value the knob takes over", lvl2 < lvl * 0.2, "before=" + STR$(lvl) + " after=" + STR$(lvl2)
SOUND.MIDIIN 128, 93, 0
CHECK "SOUND.CCMAP -1 clears", SOUND.CCMAP(-1) = 0, ""

err_msg = ""
TRY
    lvl = SOUND.CCMAP(74, 0, "colour", 0, 1)
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "an unknown parameter is refused", INSTR(err_msg, "unknown parameter") >= 0, "msg=" + err_msg
err_msg = ""
TRY
    lvl = SOUND.CCMAP(74, 0, "cutoff", 0, 1000, "EXP")
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "EXP needs lo above 0", INSTR(err_msg, "above 0") >= 0, "msg=" + err_msg
err_msg = ""
TRY
    SOUND.MOD 0, "release", "OFF"
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "SOUND.MOD takes the envelope parameters", err_msg = "", "msg=" + err_msg

' ---------- latency counters ----------
FRESH()
DIM stats = SOUND.MIDISTATS()
SOUND.MIDIIN 144, 60, 127
SOUND.MIDIIN 128, 60, 0
lvl = LEVEL(1000)
stats = SOUND.MIDISTATS()
CHECK "two events counted", stats{"events"} = 2, "events=" + STR$(stats{"events"})
CHECK "no offset without a device", stats{"offset_max_ms"} = 0, ""
stats = SOUND.MIDISTATS()
CHECK "counters reset after a read", stats{"events"} = 0, ""

' ---------- kit tracks play MIDI notes as drums ----------
FRESH()
SOUND.KIT 2, "SYNTH"
lvl = SOUND.ZONE(2, 0, 127, 10)
lvl = SOUND.ZONE(0, 0, 127, 1)
SOUND.GAIN 0, 0
SOUND.MIDIIN 153, 36, 127
lvl = LEVEL(6000)
CHECK "note 36 on channel 10 is a kick", lvl > 0.05, "rms=" + STR$(lvl)
SOUND.MIDIIN 137, 36, 0
lvl = LEVEL(4000)
SOUND.MIDIIN 153, 38, 127
SOUND.MIDIIN 137, 38, 0
lvl = LEVEL(3000)
CHECK "a hit plays on after its note off", lvl > 0.01, "rms=" + STR$(lvl)
lvl = LEVEL(44100)
SOUND.MIDIIN 153, 100, 127
lvl = LEVEL(4000)
CHECK "a note with no General MIDI drum is silent", lvl < 0.001, "rms=" + STR$(lvl)
SOUND.PADMAP 2, 100, "cp"
SOUND.MIDIIN 153, 100, 127
lvl = LEVEL(4000)
CHECK "PADMAP gives a note a sound", lvl > 0.01, "rms=" + STR$(lvl)
SOUND.PADMAP 2, 100, ""
lvl = LEVEL(44100)
SOUND.MIDIIN 153, 100, 127
lvl = LEVEL(4000)
CHECK "PADMAP with an empty name forgets it", lvl < 0.001, "rms=" + STR$(lvl)
lvl = LEVEL(44100)
SOUND.MIDIIN 153, 36, 127
DIM hard AS DOUBLE = LEVEL(6000)
lvl = LEVEL(44100)
SOUND.MIDIIN 153, 36, 32
lvl2 = LEVEL(6000)
CHECK "velocity scales a hit", lvl2 < hard * 0.5 ANDALSO lvl2 > 0, "hard=" + STR$(hard) + " soft=" + STR$(lvl2)
lvl = LEVEL(44100)
lv = SOUND.LEVELS()
SOUND.MIDIIN 144, 36, 127
lvl = LEVEL(4000)
lv = SOUND.LEVELS()
CHECK "the channel 1 zone does not play the kit", lv[2] = 0, "kit=" + STR$(lv[2])
SOUND.MIDIIN 128, 36, 0
err_msg = ""
TRY
    SOUND.PADMAP 2, 128, "bd"
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "PADMAP note 128 is refused", INSTR(err_msg, "note") >= 0, "msg=" + err_msg
SOUND.KIT 2

' ---------- MIDI.ROUTE ----------
DIM route_ok AS BOOLEAN = FALSE
IF OS.FEATURE("MIDI") THEN
    CHECK "ROUTE on an unknown handle is FALSE", MIDI.ROUTE(9999) = FALSE, ""
    CHECK "ROUTE CC on an unknown handle is FALSE", MIDI.ROUTE(9999, "CC") = FALSE, ""
    err_msg = ""
    TRY
        route_ok = MIDI.ROUTE(9999, "DRUMS")
    CATCH
        err_msg = ERRMSG$
    ENDTRY
    CHECK "an unknown ROUTE mode is refused", INSTR(err_msg, "mode") >= 0, "msg=" + err_msg
    err_msg = ""
    TRY
        route_ok = MIDI.ROUTE(9999, "ALL", 17)
    CATCH
        err_msg = ERRMSG$
    ENDTRY
    CHECK "ROUTE to channel 17 is refused", INSTR(err_msg, "channel") >= 0, "msg=" + err_msg

    CHECK "CLOCK on an unknown handle is FALSE", MIDI.CLOCK(9999, TRUE) = FALSE, ""
    CHECK "CLOCK START on an unknown handle is FALSE", MIDI.CLOCK(9999, "START") = FALSE, ""
    err_msg = ""
    TRY
        route_ok = MIDI.CLOCK(9999, "FAST")
    CATCH
        err_msg = ERRMSG$
    ENDTRY
    CHECK "an unknown CLOCK mode is refused", INSTR(err_msg, "mode") >= 0, "msg=" + err_msg
    DIM ck = MIDI.CLOCKIN(9999)
    CHECK "CLOCKIN of an unknown handle has no tempo", ck{"bpm"} = 0, "bpm=" + STR$(ck{"bpm"})
    CHECK "CLOCKIN of an unknown handle is not running", ck{"running"} = FALSE, ""
    CHECK "CLOCKIN of an unknown handle has no ticks", ck{"ticks"} = 0, ""
ENDIF

' ---------- MON.SYNTH (no device opened here) ----------
DIM syn_ms AS DOUBLE
IF OS.FEATURE("MINIAUDIO") THEN
    syn_ms = MON.SYNTH(0)
    CHECK "MON.SYNTH 0 with nothing playing", syn_ms = 0, "ms=" + STR$(syn_ms)
    FRESH()
    SOUND.MIDIIN 144, 60, 127
    CHECK "PULL renders by itself after MON.SYNTH 0", LEVEL(4000) > 0.3, ""
    SOUND.MIDIIN 128, 60, 0
ENDIF

SOUND.RESET
PRINT "RESULTS: "; PASS_COUNT; " passed, "; FAIL_COUNT; " failed"
