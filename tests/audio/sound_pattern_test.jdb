' ============================================================
' SOUND sequencer: mini-notation patterns, cycle-quantized pattern
' swap, sample-accurate onsets, state-variable filter, filter
' envelope and parameter modulation
' ============================================================
' Self-checking. Each failure prints [FAIL]; the RESULTS line last.
' The audio half renders offline (SOUND.INIT "PULL"), so it needs no
' audio device and gives the same samples on every run.

OPTION "EXPLICIT"
OPTION "STRICT"

DIM PASS_COUNT AS INTEGER = 0
DIM FAIL_COUNT AS INTEGER = 0
DIM NL AS STRING = CHR$(10)

SUB CHECK_STR(name$, expected AS STRING, actual AS STRING)
    IF expected = actual THEN
        PASS_COUNT = PASS_COUNT + 1
    ELSE
        FAIL_COUNT = FAIL_COUNT + 1
        PRINT "[FAIL] "; name$; "  expected=["; expected; "]  actual=["; actual; "]"
    ENDIF
ENDSUB

SUB CHECK(name$, cond AS INTEGER, detail$)
    IF cond THEN
        PASS_COUNT = PASS_COUNT + 1
    ELSE
        FAIL_COUNT = FAIL_COUNT + 1
        PRINT "[FAIL] "; name$; "  "; detail$
    ENDIF
ENDSUB

FUNC EV$(pattern$, cycles AS INTEGER) AS STRING
    RETURN SOUND.EVENTS$(pattern$, cycles)
ENDFUNC

' Root mean square of the left channel, frames a..b-1
FUNC RMS(buf, a AS INTEGER, b AS INTEGER) AS DOUBLE
    DIM acc AS DOUBLE = 0
    DIM i AS INTEGER
    DIM x AS DOUBLE
    FOR i = a TO b - 1
        x = buf[i * 2]
        acc = acc + x * x
    NEXT i
    RETURN SQR(acc / (b - a))
ENDFUNC

' RMS of the sample-to-sample difference: grows with high-frequency content
FUNC DIFF_RMS(buf, a AS INTEGER, b AS INTEGER) AS DOUBLE
    DIM acc AS DOUBLE = 0
    DIM i AS INTEGER
    DIM x AS DOUBLE
    FOR i = a TO b - 1
        x = buf[i * 2 + 2] - buf[i * 2]
        acc = acc + x * x
    NEXT i
    RETURN SQR(acc / (b - a))
ENDFUNC

FUNC TRIGGERS() AS INTEGER
    DIM s AS STRING = SOUND.STATS$()
    DIM p AS INTEGER = INSTR(s, "triggers=")
    DIM q AS INTEGER = INSTR(s, " ")
    RETURN VAL(MID$(s, p + 9, q - p - 9))
ENDFUNC

IF NOT OS.FEATURE("SOUND") THEN
    PRINT "SKIP: build has no SOUND sequencer"
    PRINT "RESULTS: 0 passed, 0 failed"
    END
ENDIF

' ---------- 1. Mini-notation ----------
CHECK_STR "sequence", "0 0.5 a" + NL + "0.5 0.5 b", EV$("a b", 1)
CHECK_STR "rest", "0.5 0.5 c4", EV$("~ c4", 1)
CHECK_STR "dot rest", "0.5 0.5 a", EV$(". a", 1)
CHECK_STR "empty", "", EV$("", 1)
CHECK_STR "alternation", "0 1 a" + NL + "1 1 b" + NL + "2 1 c", EV$("<a b c>", 3)
CHECK_STR "nested alternation", "0 1 a" + NL + "1 1 b" + NL + "2 1 a" + NL + "3 1 c", EV$("<a <b c>>", 4)
CHECK_STR "fast", "0 0.25 a" + NL + "0.25 0.25 a" + NL + "0.5 0.5 b", EV$("a*2 b", 1)
CHECK_STR "fast alternation", "0 0.5 a" + NL + "0.5 0.5 b", EV$("<a b>*2", 1)
CHECK_STR "slow group", "0 1 a" + NL + "1 1 b", EV$("[a b]/2", 2)
CHECK_STR "slow atom", "0 2 a", EV$("a/2", 2)
CHECK_STR "replicate", "0 0.25 a" + NL + "0.25 0.25 a" + NL + "0.5 0.25 a" + NL + "0.75 0.25 b", EV$("a!3 b", 1)
CHECK_STR "bare bang", "0 0.333333 a" + NL + "0.333333 0.333333 a" + NL + "0.666667 0.333333 b", EV$("a ! b", 1)
CHECK_STR "weight", "0 0.75 a" + NL + "0.75 0.25 b", EV$("a@3 b", 1)
CHECK_STR "hold", "0 0.75 a" + NL + "0.75 0.25 b", EV$("a _ _ b", 1)
CHECK_STR "euclid", "0 0.125 x" + NL + "0.375 0.125 x" + NL + "0.75 0.125 x", EV$("x(3,8)", 1)
CHECK_STR "euclid rotated", "0.125 0.125 x" + NL + "0.5 0.125 x" + NL + "0.75 0.125 x", EV$("x(3,8,2)", 1)
CHECK_STR "euclid 5,8", "0 0.125 x" + NL + "0.25 0.125 x" + NL + "0.375 0.125 x" + NL + "0.625 0.125 x" + NL + "0.75 0.125 x", EV$("x(5,8)", 1)
CHECK_STR "stack", "0 1 a" + NL + "0 0.5 b" + NL + "0.5 0.5 c", EV$("[a, b c]", 1)
CHECK_STR "chord", "0 0.5 c3" + NL + "0 0.5 e3" + NL + "0 0.5 g3", EV$("[c3,e3,g3] ~", 1)
CHECK_STR "probability", "0 0.5 c3?0.25", EV$("c3?0.25 ~", 1)
CHECK_STR "default probability", "0 0.5 a?0.5" + NL + "0.5 0.5 b", EV$("a? b", 1)
CHECK_STR "old repeat", "0 0.25 c4" + NL + "0.25 0.25 c4" + NL + "0.5 0.25 c4" + NL + "0.75 0.25 c4", EV$("c4*4", 1)
CHECK_STR "later cycles", "2 1 c", SOUND.EVENTS$("<a b c>", 1, 2)
CHECK "thirds stay in their cycle", LEN(SPLIT(EV$("a b c", 3), NL)) = 9, EV$("a b c", 3)

' ---------- 1b. Transforms ----------
CHECK_STR "rev", "0 0.25 c" + NL + "0.25 0.25 b" + NL + "0.5 0.5 a", EV$("rev(a [b c])", 1)
CHECK_STR "fast", "0 0.25 a" + NL + "0.25 0.25 b" + NL + "0.5 0.25 a" + NL + "0.75 0.25 b", EV$("fast(2, a b)", 1)
CHECK_STR "slow", "0 1 a" + NL + "1 1 b", EV$("slow(2, a b)", 2)
CHECK_STR "ply", "0 0.25 a" + NL + "0.25 0.25 a" + NL + "0.5 0.25 b" + NL + "0.75 0.25 b", EV$("ply(2, a b)", 1)
CHECK_STR "add", "0 0.25 c4" + NL + "0.25 0.25 d#4" + NL + "0.5 0.25 12" + NL + "0.75 0.25 bd", EV$("add(12, c3 eb3 0 bd)", 1)
CHECK_STR "add down", "0 1 b3", EV$("add(-1, c4)", 1)
CHECK_STR "every", "0 1 c4" + NL + "1 1 c3" + NL + "2 1 c4", EV$("every(2, add(12), c3)", 3)
CHECK_STR "off", "0 0.5 c3" + NL + "0.25 0.5 g3", EV$("off(0.25, add(7), c3 ~)", 1)
CHECK_STR "jux", "0 0.5 a pan=0" + NL + "0 0.5 b pan=1" + NL + "0.5 0.5 b pan=0" + NL + "0.5 0.5 a pan=1", EV$("jux(rev, a b)", 1)
CHECK_STR "juxBy", "0 1 a pan=0.25" + NL + "0 1 a pan=0.75", EV$("juxBy(0.5, rev, a)", 1)
CHECK_STR "iter", "1 0.25 b" + NL + "1.25 0.25 c" + NL + "1.5 0.25 d" + NL + "1.75 0.25 a", SOUND.EVENTS$("iter(4, a b c d)", 1, 1)
CHECK_STR "palindrome", "1 0.333333 c" + NL + "1.33333 0.333333 b" + NL + "1.66667 0.333333 a", SOUND.EVENTS$("palindrome(a b c)", 1, 1)
CHECK_STR "arp up", "0 0.333333 c3" + NL + "0.333333 0.333333 e3" + NL + "0.666667 0.333333 g3", EV$("arp(up, [c3,e3,g3])", 1)
CHECK_STR "arp updown", "0 0.125 c3" + NL + "0.125 0.125 e3" + NL + "0.25 0.125 g3" + NL + "0.375 0.125 e3", EV$("arp(updown, [c3,e3,g3] ~)", 1)
CHECK_STR "arp down, chord changes", "1 0.333333 c4" + NL + "1.33333 0.333333 a3" + NL + "1.66667 0.333333 f3", SOUND.EVENTS$("arp(down, <[c3,e3,g3] [f3,a3,c4]>)", 1, 1)
CHECK_STR "nested function", "0 0.5 c3" + NL + "0.25 0.5 c4" + NL + "1 0.5 c3" + NL + "1.25 0.5 c3", EV$("off(0.25, every(2, add(12)), c3 ~)", 2)
CHECK_STR "transform then speed", "0 0.25 b" + NL + "0.25 0.25 a" + NL + "0.5 0.25 b" + NL + "0.75 0.25 a", EV$("rev(a b)*2", 1)
CHECK_STR "transform inside a stack", "0 0.5 a" + NL + "0 0.25 c" + NL + "0.25 0.25 b" + NL + "0.5 0.5 d", EV$("[a, rev(b c)] d", 1)

' degrade keeps about half, the same half every time; sometimes splits the events
DIM deg$ AS STRING = EV$("degrade(a*64)", 1)
DIM kept AS INTEGER = LEN(SPLIT(deg$, NL))
CHECK "degrade keeps about half", kept > 20 ANDALSO kept < 44, "kept=" + STR$(kept)
CHECK_STR "degrade is repeatable", deg$, EV$("degrade(a*64)", 1)
DIM some$ AS STRING = EV$("sometimes(add(12), c3*64)", 1)
DIM all_lines = SPLIT(some$, NL)
DIM n_up AS INTEGER = LEN(SPLIT(EV$("sometimes(add(12), c3*64)", 1), "c4")) - 1
CHECK "sometimes keeps every step", LEN(all_lines) = 64, "lines=" + STR$(LEN(all_lines))
CHECK "sometimes changes about half", n_up > 20 ANDALSO n_up < 44, "changed=" + STR$(n_up)

' per-event values: a number, or a number pattern read at each onset
CHECK_STR "gain", "0 0.5 a gain=0.5" + NL + "0.5 0.5 b gain=0.5", EV$("gain(0.5, a b)", 1)
CHECK_STR "gain pattern", "0 0.25 hh" + NL + "0.25 0.25 hh gain=0.6" + NL + "0.5 0.25 hh" + NL + "0.75 0.25 hh gain=0.6", EV$("gain([1 0.6]*2, hh*4)", 1)
CHECK_STR "gain per cycle", "0 1 a" + NL + "1 1 a gain=0.5", EV$("gain(<1 0.5>, a)", 2)
CHECK_STR "legato, clip", "0 0.5 a legato=0.25" + NL + "0.5 0.5 b legato=1", EV$("[legato(0.25, a) clip(1, b)]", 1)
CHECK_STR "pan", "0 0.5 a pan=0" + NL + "0.5 0.5 b pan=0" + NL + "1 0.5 a pan=1" + NL + "1.5 0.5 b pan=1", EV$("pan(<0 1>, a b)", 2)
CHECK_STR "velocity as a function", "0 1 a gain=0.3" + NL + "1 1 a", EV$("every(2, velocity(0.3), a)", 2)
CHECK_STR "swing", "0 0.25 a" + NL + "0.916667 0.25 b", EV$("swing(2, a ~ ~ b)", 1)
CHECK_STR "swing hats", "0 0.125 h" + NL + "0.208333 0.125 h" + NL + "0.25 0.125 h" + NL + "0.458333 0.125 h", EV$("swing(4, h*4 ~)", 1)
CHECK_STR "swing keeps the first half", "0 0.25 a" + NL + "0.25 0.25 a" + NL + "0.5 0.25 c" + NL + "0.75 0.25 c", EV$("swingBy(0.5, 2, a b c d)", 1)

FUNC PARSE_ERR$(pattern$) AS STRING
    TRY
        DIM r AS STRING = SOUND.EVENTS$(pattern$, 1)
    CATCH
        RETURN ERRMSG$
    ENDTRY
    RETURN ""
ENDFUNC
CHECK "transform missing paren", INSTR(PARSE_ERR$("rev(a b"), "missing ')'") >= 0, PARSE_ERR$("rev(a b")
CHECK "every needs a count", INSTR(PARSE_ERR$("every(0, rev, a)"), "at least 1") >= 0, PARSE_ERR$("every(0, rev, a)")
CHECK "arp mode", INSTR(PARSE_ERR$("arp(sideways, a)"), "arp mode") >= 0, PARSE_ERR$("arp(sideways, a)")
CHECK "unknown function", INSTR(PARSE_ERR$("every(2, foo, a)"), "transform expected") >= 0, PARSE_ERR$("every(2, foo, a)")

' random choice: one option per cycle, both options over 32 cycles
DIM rnd$ AS STRING = EV$("a | b", 32)
DIM lines = SPLIT(rnd$, NL)
CHECK "choice one per cycle", LEN(lines) = 32, "lines=" + STR$(LEN(lines))
CHECK "choice picks a", INSTR(rnd$, " a") >= 0, rnd$
CHECK "choice picks b", INSTR(rnd$, " b") >= 0, rnd$
CHECK_STR "choice is repeatable", rnd$, EV$("a | b", 32)

DIM err_msg AS STRING = ""
TRY
    DIM bad AS STRING = SOUND.EVENTS$("[a b", 1)
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "unclosed bracket", INSTR(err_msg, "missing") >= 0, "msg=" + err_msg

' chord symbols, voice-led in the order they are written
CHECK_STR "chord minor", "0 1 a3" + NL + "0 1 c4" + NL + "0 1 e4", EV$("Am", 1)
CHECK_STR "chord led to F", "1 1 a3" + NL + "1 1 c4" + NL + "1 1 f4", MID$(EV$("<Am F>", 2), 21)
CHECK_STR "chord led to G", "3 1 g3" + NL + "3 1 b3" + NL + "3 1 d4", MID$(EV$("<Am F C G>", 4), 63)
CHECK_STR "chord seventh", "0 1 g3" + NL + "0 1 b3" + NL + "0 1 c4" + NL + "0 1 e4", EV$("Cmaj7", 1)
CHECK_STR "chord flat root", "0 1 f3" + NL + "0 1 a#3" + NL + "0 1 d4", EV$("Bb", 1)
CHECK_STR "slash bass", "0 1 e3" + NL + "0 1 a3" + NL + "0 1 c4" + NL + "0 1 e4", EV$("Am/E", 1)
CHECK_STR "numerals", "0 1 0" + NL + "0 1 2" + NL + "0 1 4" + NL + "1 1 0" + NL + "1 1 2" + NL + "1 1 5", EV$("<i VI>", 2)
CHECK_STR "numeral seventh", "0 1 1" + NL + "0 1 3" + NL + "0 1 4" + NL + "0 1 6", EV$("V7", 1)
CHECK_STR "lower case is a note", "0 1 c4", EV$("c4", 1)
CHECK_STR "chord with transform", "0 0.333333 a3" + NL + "0.333333 0.333333 c4" + NL + "0.666667 0.333333 e4", EV$("arp(up, Am)", 1)
err_msg = ""
TRY
    DIM bad_bass AS STRING = SOUND.EVENTS$("Am/x", 1)
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "slash bass needs a note", LEN(err_msg) > 0, "msg=" + err_msg

' ---------- 2. Engine, rendered offline ----------
SOUND.INIT "PULL"
SOUND.BPM 240
DIM CYC AS INTEGER = 44100

' onsets are sample-accurate inside one large render
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "~ c4", "VOICE"
DIM buf = SOUND.RENDER(CYC)
CHECK "silent before onset", RMS(buf, 0, 22000) < 0.001, "rms=" + STR$(RMS(buf, 0, 22000))
CHECK "sound after onset", RMS(buf, 22200, 30000) > 0.3, "rms=" + STR$(RMS(buf, 22200, 30000))

' a new pattern waits for the next cycle
SOUND.RESET
DIM n AS INTEGER = TRIGGERS()
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "c4*4", "VOICE"
buf = SOUND.RENDER(CYC / 2)
CHECK "first half old pattern", TRIGGERS() = 2, ""
SOUND.SEQ 0, "c4*8", "VOICE"
buf = SOUND.RENDER(CYC / 2)
CHECK "second half still old", TRIGGERS() = 2, ""
buf = SOUND.RENDER(CYC)
CHECK "next cycle new pattern", TRIGGERS() = 8, ""
SOUND.SEQ 0, "<c4 [c4 c4 c4]>", "VOICE"
buf = SOUND.RENDER(CYC)
n = TRIGGERS()
buf = SOUND.RENDER(CYC)
CHECK "alternation plays", n + TRIGGERS() = 4, "n=" + STR$(n)

' jux pans the copies apart: plain c4 left, the octave above right
SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.GAIN 0, 0.2
SOUND.SEQ 0, "jux(add(12), c4)", "VOICE"
buf = SOUND.RENDER(8000)
DIM jl AS DOUBLE = DIFF_RMS(buf, 2000, 7990) / RMS(buf, 2000, 7990)
DIM right_buf = buf[IOTA(15998, 0) + 1]
DIM jr AS DOUBLE = DIFF_RMS(right_buf, 2000, 7990) / RMS(right_buf, 2000, 7990)
CHECK "jux right copy is higher", jr > jl * 1.8, "left=" + STR$(jl) + " right=" + STR$(jr)

' high-pass removes a low sine that the low-pass keeps
SOUND.RESET
SOUND.VOICE 1, "SINE", 0.001, 0.01, 1.0, 0.01
SOUND.FILTER 1, 2000, 0, "LP"
SOUND.PLAY 1, 100
buf = SOUND.RENDER(8000)
DIM lp_rms AS DOUBLE = RMS(buf, 2000, 8000)
SOUND.RESET
SOUND.VOICE 1, "SINE", 0.001, 0.01, 1.0, 0.01
SOUND.FILTER 1, 2000, 0, "HP"
SOUND.PLAY 1, 100
buf = SOUND.RENDER(8000)
DIM hp_rms AS DOUBLE = RMS(buf, 2000, 8000)
CHECK "low-pass passes", lp_rms > 0.6, "lp=" + STR$(lp_rms)
CHECK "high-pass blocks", hp_rms < 0.02, "hp=" + STR$(hp_rms)

' resonance lifts the cutoff frequency (kept quiet, below the soft clip)
SOUND.RESET
SOUND.VOICE 1, "SINE", 0.001, 0.01, 1.0, 0.01
SOUND.FILTER 1, 1000, 0
SOUND.GAIN 1, 0.1
SOUND.PLAY 1, 1000
buf = SOUND.RENDER(8000)
DIM flat_rms AS DOUBLE = RMS(buf, 2000, 8000)
SOUND.RESET
SOUND.VOICE 1, "SINE", 0.001, 0.01, 1.0, 0.01
SOUND.FILTER 1, 1000, 0.9
SOUND.GAIN 1, 0.1
SOUND.PLAY 1, 1000
buf = SOUND.RENDER(8000)
DIM res_rms AS DOUBLE = RMS(buf, 2000, 8000)
CHECK "resonance boosts", res_rms > flat_rms * 3, "flat=" + STR$(flat_rms) + " res=" + STR$(res_rms)

' the filter envelope opens a dark saw at the start of the note
SOUND.RESET
SOUND.VOICE 2, "SAW", 0.001, 0.01, 1.0, 0.01
SOUND.FILTER 2, 200, 0
SOUND.FENV 2, 5, 0.002, 0.1
SOUND.PLAY 2, 110
buf = SOUND.RENDER(30000)
DIM early AS DOUBLE = DIFF_RMS(buf, 300, 1500)
DIM late AS DOUBLE = DIFF_RMS(buf, 25000, 29000)
CHECK "filter envelope opens", early > late * 2, "early=" + STR$(early) + " late=" + STR$(late)

' a square modulator gates the gain: silent first half, full second half
SOUND.RESET
SOUND.VOICE 3, "SINE", 0.001, 0.01, 1.0, 0.01
SOUND.MOD 3, "GAIN", "SQUARE", 0, 1, 1
SOUND.PLAY 3, 440
buf = SOUND.RENDER(CYC)
CHECK "mod low half", RMS(buf, 1000, 21000) < 0.001, "rms=" + STR$(RMS(buf, 1000, 21000))
CHECK "mod high half", RMS(buf, 23000, 43000) > 0.6, "rms=" + STR$(RMS(buf, 23000, 43000))
SOUND.MOD 3, "GAIN", "OFF"
buf = SOUND.RENDER(CYC / 2)
CHECK "mod off restores", RMS(buf, 0, 20000) > 0.6, "rms=" + STR$(RMS(buf, 0, 20000))

err_msg = ""
TRY
    SOUND.MOD 3, "WOBBLE", "SINE"
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "unknown mod parameter", INSTR(err_msg, "WOBBLE") >= 0, "msg=" + err_msg

' ---------- 2a. Formants, glide, pitch, chorus, width, synced delay ----------
' Frequency of the left channel from its rising zero crossings
FUNC ZC_HZ(buf, a AS INTEGER, b AS INTEGER) AS DOUBLE
    DIM crossings AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = a TO b - 2
        IF buf[i * 2] <= 0 AND buf[i * 2 + 2] > 0 THEN crossings = crossings + 1
    NEXT i
    RETURN crossings * 44100.0 / (b - a)
ENDFUNC

FUNC RMS_R(buf, a AS INTEGER, b AS INTEGER) AS DOUBLE
    DIM acc AS DOUBLE = 0
    DIM i AS INTEGER
    DIM x AS DOUBLE
    FOR i = a TO b - 1
        x = buf[i * 2 + 1]
        acc = acc + x * x
    NEXT i
    RETURN SQR(acc / (b - a))
ENDFUNC

FUNC RMS_SIDE(buf, a AS INTEGER, b AS INTEGER) AS DOUBLE
    DIM acc AS DOUBLE = 0
    DIM i AS INTEGER
    DIM x AS DOUBLE
    FOR i = a TO b - 1
        x = buf[i * 2] - buf[i * 2 + 1]
        acc = acc + x * x
    NEXT i
    RETURN SQR(acc / (b - a))
ENDFUNC

' The level of one frequency in the left channel, 8192 frames from start
FUNC TONE_LEVEL(buf, hz AS DOUBLE, start AS INTEGER) AS DOUBLE
    DIM re AS DOUBLE = 0
    DIM im AS DOUBLE = 0
    DIM w AS DOUBLE
    DIM i AS INTEGER
    FOR i = 0 TO 8191
        w = 2 * MATH.PI * hz * i / 44100
        re = re + buf[(start + i) * 2] * COS(w)
        im = im + buf[(start + i) * 2] * SIN(w)
    NEXT i
    RETURN SQR(re * re + im * im) / 8192
ENDFUNC

' the vowel shapes the spectrum: ee has its second formant near 2.2 kHz,
' oo none; the level of the 20th harmonic of 110 Hz tells them apart
FUNC VOWEL_BRIGHTNESS(vowel$) AS DOUBLE
    SOUND.RESET
    SOUND.VOICE 4, "SAW", 0.001, 0.01, 1.0, 0.01
    SOUND.GAIN 4, 0.3
    SOUND.FORMANT 4, vowel$, 1.0
    SOUND.PLAY 4, 110
    DIM vb = SOUND.RENDER(12192)
    RETURN TONE_LEVEL(vb, 2200, 4000)
ENDFUNC
DIM bright_ee AS DOUBLE = VOWEL_BRIGHTNESS("ee")
DIM bright_oo AS DOUBLE = VOWEL_BRIGHTNESS("oo")
CHECK "formant ee brighter than oo", bright_ee > bright_oo * 4, "ee=" + STR$(bright_ee) + " oo=" + STR$(bright_oo)

SOUND.RESET
SOUND.VOICE 4, "SAW", 0.001, 0.01, 1.0, 0.01
SOUND.GAIN 4, 0.3
SOUND.PLAY 4, 110
buf = SOUND.RENDER(12000)
DIM dry_rms AS DOUBLE = RMS(buf, 4000, 12000)
SOUND.RESET
SOUND.VOICE 4, "SAW", 0.001, 0.01, 1.0, 0.01
SOUND.GAIN 4, 0.3
SOUND.FORMANT 4, "ah", 1.0
SOUND.PLAY 4, 110
buf = SOUND.RENDER(12000)
DIM ah_rms AS DOUBLE = RMS(buf, 4000, 12000)
CHECK "formant keeps the level", ah_rms > dry_rms * 0.5 AND ah_rms < dry_rms * 2, "dry=" + STR$(dry_rms) + " ah=" + STR$(ah_rms)

err_msg = ""
TRY
    SOUND.FORMANT 4, "zz", 1.0
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "unknown vowel", INSTR(err_msg, "vowel") >= 0, "msg=" + err_msg

' glide: the second note starts at the first one's pitch and slides up
FUNC SECOND_NOTE_HZ(glide_ms AS INTEGER, mode$, pattern$, a AS INTEGER, b AS INTEGER) AS DOUBLE
    SOUND.RESET
    SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
    IF glide_ms > 0 THEN SOUND.GLIDE 0, glide_ms, mode$
    SOUND.SEQ 0, "legato(1, " + pattern$ + ")", "VOICE"
    DIM gb = SOUND.RENDER(CYC)
    RETURN ZC_HZ(gb, 22050 + a, 22050 + b)
ENDFUNC
DIM hz_jump AS DOUBLE = SECOND_NOTE_HZ(0, "ALL", "c4 c5", 200, 2400)
DIM hz_glide AS DOUBLE = SECOND_NOTE_HZ(200, "ALL", "c4 c5", 200, 2400)
DIM hz_landed AS DOUBLE = SECOND_NOTE_HZ(100, "ALL", "c4 c5", 9000, 21000)
CHECK "no glide jumps", hz_jump > 480, "hz=" + STR$(hz_jump)
CHECK "glide starts low", hz_glide < 400, "hz=" + STR$(hz_glide)
CHECK "glide lands", ABS(hz_landed - 523.25) < 15, "hz=" + STR$(hz_landed)
DIM hz_unmarked AS DOUBLE = SECOND_NOTE_HZ(200, "SLIDE", "c4 c5", 200, 2400)
DIM hz_marked AS DOUBLE = SECOND_NOTE_HZ(200, "SLIDE", "c4 c5^", 200, 2400)
CHECK "slide mode skips unmarked", hz_unmarked > 480, "hz=" + STR$(hz_unmarked)
CHECK "slide mode glides into ^", hz_marked < 400, "hz=" + STR$(hz_marked)

' PITCH moves the whole track by semitones
SOUND.RESET
SOUND.VOICE 3, "SINE", 0.001, 0.01, 1.0, 0.01
SOUND.MOD 3, "PITCH", "SQUARE", 0, 12, 1
SOUND.PLAY 3, 440
buf = SOUND.RENDER(CYC)
DIM hz_low AS DOUBLE = ZC_HZ(buf, 2000, 20000)
DIM hz_high AS DOUBLE = ZC_HZ(buf, 24000, 42000)
CHECK "pitch mod low", ABS(hz_low - 440) < 10, "hz=" + STR$(hz_low)
CHECK "pitch mod an octave up", ABS(hz_high - 880) < 15, "hz=" + STR$(hz_high)

' chorus spreads a centred tone, width 0 folds it back to mono
SOUND.RESET
SOUND.VOICE 5, "SAW", 0.001, 0.01, 1.0, 0.01
SOUND.GAIN 5, 0.3
SOUND.CHORUS 5, 1.0, 1.5, 4
SOUND.PLAY 5, 220
buf = SOUND.RENDER(20000)
DIM side_chorus AS DOUBLE = RMS_SIDE(buf, 4000, 20000)
SOUND.WIDTH 5, 0
buf = SOUND.RENDER(8000)
DIM side_mono AS DOUBLE = RMS_SIDE(buf, 2000, 8000)
CHECK "chorus widens", side_chorus > 0.05, "side=" + STR$(side_chorus)
CHECK "width 0 is mono", side_mono < 0.0001, "side=" + STR$(side_mono)

' a chorus tail runs out while its track is silent and does not come
' back when another insert track starts (track 6 is silent, gain 0)
SOUND.RESET
SOUND.VOICE 5, "SAW", 0.001, 0.01, 1.0, 0.005
SOUND.CHORUS 5, 1.0, 1.5, 4
SOUND.VOICE 6, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.GAIN 6, 0
SOUND.WIDTH 6, 1.5
SOUND.SEQ 5, "c4 ~ ~ ~", "VOICE"
SOUND.AT 1
SOUND.SEQ 5, "", "VOICE"
SOUND.AT 3
SOUND.SEQ 6, "c4", "VOICE"
SOUND.AT
buf = SOUND.RENDER(CYC * 4)
CHECK "chorus tail heard", RMS(buf, 8900, 9800) > 0.0005, "rms=" + STR$(RMS(buf, 8900, 9800))
CHECK "chorus tail does not return", RMS(buf, CYC * 3, CYC * 3 + 1500) < 0.0001, "rms=" + STR$(RMS(buf, CYC * 3, CYC * 3 + 1500))

' a delay of 1/4 at 240 BPM repeats a quarter second later
FUNC ECHO_BUF(pingpong AS INTEGER)
    SOUND.RESET
    SOUND.DELAY TRUE, "1/4", 0.5, 1.0, 0, pingpong
    SOUND.VOICE 0, "SINE", 0.001, 0.02, 0.0, 0.01
    SOUND.DELAYSEND 0, 1.0
    SOUND.SEQ 0, "c5 ~ ~ ~", "VOICE"
    RETURN SOUND.RENDER(CYC)
ENDFUNC
buf = ECHO_BUF(FALSE)
CHECK "synced delay quiet before the echo", RMS(buf, 4000, 10500) < 0.01, "rms=" + STR$(RMS(buf, 4000, 10500))
CHECK "synced delay echoes on the beat", RMS(buf, 11100, 11800) > 0.05, "rms=" + STR$(RMS(buf, 11100, 11800))
buf = ECHO_BUF(TRUE)
CHECK "ping-pong first echo left", RMS(buf, 11100, 11800) > RMS_R(buf, 11100, 11800) * 4, "l=" + STR$(RMS(buf, 11100, 11800)) + " r=" + STR$(RMS_R(buf, 11100, 11800))
CHECK "ping-pong second echo right", RMS_R(buf, 22150, 22850) > RMS(buf, 22150, 22850) * 4, "l=" + STR$(RMS(buf, 22150, 22850)) + " r=" + STR$(RMS_R(buf, 22150, 22850))

'' a second oscillator an octave down adds 220 Hz under a 440 Hz sine
FUNC SUB_OCTAVE_LEVEL(wave$, mix AS DOUBLE) AS DOUBLE
    SOUND.RESET
    SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.01
    SOUND.GAIN 0, 0.3
    IF LEN(wave$) > 0 THEN SOUND.OSC2 0, wave$, -12, mix
    SOUND.PLAY 0, 440
    DIM ob = SOUND.RENDER(12192)
    RETURN TONE_LEVEL(ob, 220, 4000)
ENDFUNC
DIM sub_none AS DOUBLE = SUB_OCTAVE_LEVEL("", 0)
DIM sub_osc2 AS DOUBLE = SUB_OCTAVE_LEVEL("SINE", 1.0)
DIM sub_off AS DOUBLE = SUB_OCTAVE_LEVEL("OFF", 1.0)
CHECK "osc2 adds the octave below", sub_osc2 > 0.05 AND sub_osc2 > sub_none * 50, "with=" + STR$(sub_osc2) + " without=" + STR$(sub_none)
CHECK "osc2 off is silent", sub_off < 0.002, "off=" + STR$(sub_off)
err_msg = ""
TRY
    SOUND.OSC2 0, "PIANO", 0, 0.5
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "osc2 wave checked", INSTR(err_msg, "OSC2") >= 0, "msg=" + err_msg

err_msg = ""
TRY
    SOUND.DELAY TRUE, "quarter", 0.3, 0.3
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "delay note value checked", INSTR(err_msg, "note value") >= 0, "msg=" + err_msg

' ---------- 2b. Per-event values, nudge, orbits, tracks, clock ----------
FUNC TONE_RMS(pattern$, a AS INTEGER, b AS INTEGER) AS DOUBLE
    SOUND.RESET
    SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
    SOUND.GAIN 0, 0.3
    SOUND.SEQ 0, pattern$, "VOICE"
    RETURN RMS(SOUND.RENDER(CYC), a, b)
ENDFUNC

DIM full_rms AS DOUBLE = TONE_RMS("c4", 2000, 20000)
CHECK "event gain scales", ABS(TONE_RMS("gain(0.5, c4)", 2000, 20000) / full_rms - 0.5) < 0.01, "full=" + STR$(full_rms)
CHECK "default gate is 0.8 of the step", TONE_RMS("c4", 30000, 34000) > 0.1, ""
CHECK "legato shortens the gate", TONE_RMS("legato(0.25, c4)", 30000, 34000) < 0.001, ""
CHECK "legato above 1 overlaps", TONE_RMS("legato(1.5, c4 ~)", 30000, 34000) > 0.1, ""

SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.NUDGE 0, 100
SOUND.SEQ 0, "c4", "VOICE"
buf = SOUND.RENDER(8000)
CHECK "nudge delays the onset", RMS(buf, 0, 4300) < 0.001 ANDALSO RMS(buf, 4600, 8000) > 0.1, "early=" + STR$(RMS(buf, 0, 4300))

' a reverb on orbit 1 only answers the tracks sent to orbit 1
FUNC TAIL_RMS(orbit AS INTEGER) AS DOUBLE
    SOUND.RESET
    SOUND.REVERB 0.9, 0.3, 1.0, 1.0, 1
    SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
    SOUND.REVERBSEND 0, 1
    SOUND.ORBIT 0, orbit
    SOUND.SEQ 0, "legato(0.2, c4) ~ ~ ~", "VOICE"
    RETURN RMS(SOUND.RENDER(CYC / 2), 12000, 20000)
ENDFUNC
DIM tail0 AS DOUBLE = TAIL_RMS(0)
DIM tail1 AS DOUBLE = TAIL_RMS(1)
CHECK "orbit routes the sends", tail1 > 0.005 ANDALSO tail0 < 0.0005, "orbit0=" + STR$(tail0) + " orbit1=" + STR$(tail1)

err_msg = ""
TRY
    SOUND.ORBIT 0, 9
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "orbit range", INSTR(err_msg, "orbit is 0 to 3") >= 0, "msg=" + err_msg

SOUND.RESET
n = TRIGGERS()
SOUND.VOICE 15, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 15, "legato(1, c4*4)", "VOICE"
buf = SOUND.RENDER(CYC)
CHECK "sixteen tracks", TRIGGERS() = 4, ""
CHECK "clock in cycles", ABS(SOUND.CYCLE() - 1.0) < 0.000001, "cycle=" + STR$(SOUND.CYCLE())
CHECK "scope holds the output", MAX(ABS(SOUND.GET_WAVE())) > 0.1, ""


' ---------- 3. Master: AUTO divides by the voices, FIXED keeps levels ----------
' track 0 plays on the left only, track 1 on the right only
FUNC LEFT_RMS(both AS INTEGER) AS DOUBLE
    SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.01
    SOUND.VOICE 1, "SINE", 0.001, 0.01, 1.0, 0.01
    SOUND.GAIN 0, 0.3
    SOUND.GAIN 1, 0.3
    SOUND.PAN 0, 0
    SOUND.PAN 1, 1
    SOUND.PLAY 0, 220
    IF both THEN SOUND.PLAY 1, 330
    RETURN RMS(SOUND.RENDER(8000), 2000, 8000)
ENDFUNC

SOUND.RESET
DIM auto_one AS DOUBLE = LEFT_RMS(FALSE)
SOUND.RESET
DIM auto_two AS DOUBLE = LEFT_RMS(TRUE)
CHECK "auto: a second voice lowers the first", auto_two < auto_one * 0.75, "one=" + STR$(auto_one) + " two=" + STR$(auto_two)
SOUND.RESET
SOUND.MASTER "FIXED", 0.5
DIM fixed_one AS DOUBLE = LEFT_RMS(FALSE)
SOUND.RESET
SOUND.MASTER "FIXED", 0.5
DIM fixed_two AS DOUBLE = LEFT_RMS(TRUE)
CHECK "fixed: a second voice leaves the first", ABS(fixed_two - fixed_one) < 0.0001, "one=" + STR$(fixed_one) + " two=" + STR$(fixed_two)
CHECK "fixed: headroom scales", ABS(fixed_one / auto_one - 0.5) < 0.01, "auto=" + STR$(auto_one) + " fixed=" + STR$(fixed_one)

' the output bends smoothly below full scale instead of clipping
SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.01
SOUND.GAIN 0, 4
SOUND.PLAY 0, 220
buf = SOUND.RENDER(8000)
CHECK "soft clip stays below 1", MAX(ABS(buf)) <= 1.0, "peak=" + STR$(MAX(ABS(buf)))
CHECK "soft clip is loud", MAX(ABS(buf)) > 0.95, "peak=" + STR$(MAX(ABS(buf)))

err_msg = ""
TRY
    SOUND.MASTER "LOUD"
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "unknown master mode", INSTR(err_msg, "LOUD") >= 0, "msg=" + err_msg
SOUND.RESET

' ---------- 4. Drum kit: atoms name samples ----------
DIM KIT_DIR AS STRING = "jdb/demos/sound/SynthesizerPercussion-SFZ-20220718/"

FUNC KIT_RENDER(pattern$, frames AS INTEGER)
    SOUND.RESET
    SOUND.KIT 0, KIT_DIR + "kit.txt"
    SOUND.SEQ 0, pattern$, "VOICE"
    RETURN SOUND.RENDER(frames)
ENDFUNC

buf = KIT_RENDER("~ bd", CYC)
CHECK "kit silent before hit", RMS(buf, 0, 22000) < 0.001, "rms=" + STR$(RMS(buf, 0, 22000))
CHECK "kit hit sounds", RMS(buf, 22050, 26000) > 0.05, "rms=" + STR$(RMS(buf, 22050, 26000))

DIM v0 AS DOUBLE = RMS(KIT_RENDER("bd", 4000), 0, 4000)
DIM v1 AS DOUBLE = RMS(KIT_RENDER("bd:1", 4000), 0, 4000)
DIM v2 AS DOUBLE = RMS(KIT_RENDER("bd:2", 4000), 0, 4000)
CHECK "variants differ", ABS(v0 - v1) > 0.001, "bd=" + STR$(v0) + " bd:1=" + STR$(v1)
CHECK "variant index wraps", ABS(v0 - v2) < 0.000001, "bd=" + STR$(v0) + " bd:2=" + STR$(v2)

' the crash outlives its eighth-cycle event
buf = KIT_RENDER("cr ~ ~ ~ ~ ~ ~ ~", CYC / 2)
CHECK "hit plays its whole sample", RMS(buf, 15000, 20000) > 0.005, "rms=" + STR$(RMS(buf, 15000, 20000))

n = TRIGGERS()
buf = KIT_RENDER("nosuch bd", CYC)
n = TRIGGERS()
CHECK "unknown name is skipped", n = 1, "triggers=" + STR$(n)

' gain= in the kit file scales the sound against the same sample from a MAP
DIM sh_kit AS DOUBLE = RMS(KIT_RENDER("sh", 4000), 0, 4000)
SOUND.RESET
SOUND.KIT 0, {"sh": KIT_DIR + "samples/Shaker04.wav"}
SOUND.SEQ 0, "sh", "VOICE"
buf = SOUND.RENDER(4000)
DIM sh_map AS DOUBLE = RMS(buf, 0, 4000)
CHECK "kit gain", ABS(sh_kit / sh_map - 0.45) < 0.02, "kit=" + STR$(sh_kit) + " map=" + STR$(sh_map)

' a MAP entry may name an SFX.LOAD id
SFX.LOAD 7, KIT_DIR + "samples/Clap01.wav"
SOUND.RESET
SOUND.KIT 0, {"CP": 7}
SOUND.SEQ 0, "cp", "VOICE"
buf = SOUND.RENDER(4000)
CHECK "kit names are case-blind, ids work", RMS(buf, 0, 4000) > 0.05, "rms=" + STR$(RMS(buf, 0, 4000))

buf = KIT_RENDER("clip(0.05, cr) ~", CYC / 2)
CHECK "clip cuts a kit hit", RMS(buf, 15000, 20000) < 0.001, "rms=" + STR$(RMS(buf, 15000, 20000))


' one long render plays a busy kit without running out of voices
SOUND.RESET
SOUND.KIT 0, KIT_DIR + "kit.txt"
SOUND.SEQ 0, "hh*32, bd*8, cp*8", "VOICE"
n = TRIGGERS()
buf = SOUND.RENDER(CYC * 4)
CHECK "long render keeps every hit", INSTR(SOUND.STATS$(), "triggers=192 alloc_fail=0") >= 0, ""

' the built-in synthesized kit needs no files
FUNC SYNTH_RMS(pattern$, a AS INTEGER, b AS INTEGER) AS DOUBLE
    SOUND.RESET
    SOUND.KIT 0, "synth"
    SOUND.SEQ 0, pattern$, "VOICE"
    RETURN RMS(SOUND.RENDER(CYC), a, b)
ENDFUNC

DIM synth_names AS STRING = "bd bd:1 sd hh oh cr cp lt mt ht rim cb cl sh"
DIM nm AS STRING
DIM quiet AS STRING = ""
FOR EACH nm IN SPLIT(synth_names, " ")
    IF SYNTH_RMS(nm, 0, 2000) < 0.02 THEN quiet = quiet + nm + " "
NEXT
CHECK_STR "synth kit sounds", "", quiet

' choke: a closed hat cuts the open hat, a rim shot does not
DIM oh_tail AS DOUBLE = SYNTH_RMS("oh rim", 30050, 38050)
DIM choked AS DOUBLE = SYNTH_RMS("oh hh", 30050, 38050)
CHECK "hh chokes oh", choked < oh_tail * 0.1, "rim=" + STR$(oh_tail) + " hh=" + STR$(choked)

err_msg = ""
TRY
    SOUND.KIT 0, "no_such_kit.txt"
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "missing kit file", INSTR(err_msg, "no_such_kit.txt") >= 0, "msg=" + err_msg

' ---------- 3. SOUND.AT: commands queued for a cycle ----------
' a pattern sent in cycle 0 for cycle 2 starts on its first frame
SOUND.RESET
n = TRIGGERS()
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.AT 2
SOUND.SEQ 0, "c4", "VOICE"
SOUND.AT
CHECK "AT queues", SOUND.PENDING() = 1, "pending=" + STR$(SOUND.PENDING())
buf = SOUND.RENDER(CYC * 3)
CHECK "AT silent before", RMS(buf, CYC * 2 - 400, CYC * 2 - 2) < 0.0001, "rms=" + STR$(RMS(buf, CYC * 2 - 400, CYC * 2 - 2))
CHECK "AT sounds on the bar", RMS(buf, CYC * 2 + 60, CYC * 2 + 400) > 0.3, "rms=" + STR$(RMS(buf, CYC * 2 + 60, CYC * 2 + 400))
CHECK "AT applied", SOUND.PENDING() = 0, "pending=" + STR$(SOUND.PENDING())
CHECK "AT one note", TRIGGERS() = 1, ""

' at a tempo whose bar is no whole number of frames the downbeat survives
SOUND.RESET
SOUND.BPM 138
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.VOICE 1, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 1, "c3", "VOICE"
SOUND.AT 3
SOUND.SEQ 0, "c4*4", "VOICE"
SOUND.AT
DIM fpb138 AS DOUBLE = 44100 * 240 / 138
buf = SOUND.RENDER(INT(fpb138 * 3))
n = TRIGGERS()
buf = SOUND.RENDER(INT(fpb138))
CHECK "AT keeps the downbeat", TRIGGERS() = 5, ""
SOUND.BPM 240

' a playing pattern swaps on the target cycle, the later of two sends wins
SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "c4*4", "VOICE"
SOUND.AT 1
SOUND.SEQ 0, "c4*2", "VOICE"
SOUND.SEQ 0, "c4*8", "VOICE"
SOUND.AT
n = TRIGGERS()
buf = SOUND.RENDER(CYC)
CHECK "AT old until the bar", TRIGGERS() = 4, ""
buf = SOUND.RENDER(CYC)
CHECK "AT later send wins", TRIGGERS() = 8, ""

' a queued switch inside a cycle applies on its own frame
SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "c4*4", "VOICE"
SOUND.AT 1.5
SOUND.SEQ 0, "", "VOICE"
SOUND.AT 1.75
SOUND.SEQ 0, "c4*16", "VOICE"
SOUND.AT
n = TRIGGERS()
buf = SOUND.RENDER(CYC)
CHECK "AT mid-cycle, first cycle whole", TRIGGERS() = 4, ""
buf = SOUND.RENDER(CYC)
CHECK "AT mid-cycle stop is silent", RMS(buf, CYC / 2 + 2000, CYC * 3 / 4 - 100) < 0.001, "rms=" + STR$(RMS(buf, CYC / 2 + 2000, CYC * 3 / 4 - 100))
CHECK "AT mid-cycle switch plays at once", TRIGGERS() = 6, ""

' a parameter changes on the frame of a fractional target
SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "legato(1, c4)", "VOICE"
SOUND.AT 0.5
SOUND.GAIN 0, 0
SOUND.AT
buf = SOUND.RENDER(CYC)
CHECK "AT gain before", RMS(buf, 18000, 22000) > 0.3, "rms=" + STR$(RMS(buf, 18000, 22000))
CHECK "AT gain after", RMS(buf, 23500, 30000) < 0.01, "rms=" + STR$(RMS(buf, 23500, 30000))

' a target already reached applies at once
SOUND.AT 0
SOUND.GAIN 0, 1
SOUND.AT
CHECK "AT past applies now", SOUND.PENDING() = 0, "pending=" + STR$(SOUND.PENDING())

' a bad pattern fails when sent, not when due
err_msg = ""
SOUND.AT 9
TRY
    SOUND.SEQ 0, "[c4", "VOICE"
CATCH
    err_msg = ERRMSG$
ENDTRY
SOUND.AT
CHECK "AT checks the pattern", INSTR(err_msg, "SOUND.SEQ") >= 0 ANDALSO SOUND.PENDING() = 0, "msg=" + err_msg

' SOUND.RECORD writes what SOUND.RENDER puts out as 16-bit stereo
SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "legato(1, c4)", "VOICE"
DIM wav_path AS STRING = "sound_record_test.wav"
SOUND.RECORD wav_path
buf = SOUND.RENDER(4410)
SOUND.RECORD
DIM wav$ AS STRING = BINREADER$(wav_path)
CHECK "RECORD file size", LEN(wav$) = 44 + 4410 * 4, "len=" + STR$(LEN(wav$))
CHECK "RECORD header", MID$(wav$, 0, 4) = "RIFF" ANDALSO MID$(wav$, 8, 4) = "WAVE", ""
DIM wav_head = UNPACK("<4a i 4a 4a i s s i i s s 4a i", wav$)
CHECK "RECORD data size", wav_head[12] = 4410 * 4, "data=" + STR$(wav_head[12])
DIM peak_s AS INTEGER = 0
DIM wi AS INTEGER
DIM wv = [0]
FOR wi = 2000 TO 2100
    wv = UNPACK("<h", wav$, 44 + wi * 4)
    IF ABS(wv[0]) > peak_s THEN peak_s = ABS(wv[0])
NEXT wi
CHECK "RECORD carries the tone", peak_s > 3000, "peak=" + STR$(peak_s)
KILL wav_path

' RESET empties the queue and leaves scheduling
SOUND.AT 9
SOUND.SEQ 0, "c4", "VOICE"
SOUND.RESET
CHECK "RESET clears the queue", SOUND.PENDING() = 0, "pending=" + STR$(SOUND.PENDING())
SOUND.SEQ 0, "c4", "VOICE"
CHECK "RESET ends AT", SOUND.PENDING() = 0, "pending=" + STR$(SOUND.PENDING())

' the limiter holds its ceiling and settles on it
SOUND.RESET
SOUND.MASTER "FIXED", 1.0
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.GAIN 0, 0.9
SOUND.LIMITER -6
SOUND.SEQ 0, "legato(1, b5)", "VOICE"
buf = SOUND.RENDER(CYC / 2)
DIM lim_max AS DOUBLE = MAX(ABS(buf))
DIM lim_ceil AS DOUBLE = 10 ^ (-6 / 20)
CHECK "LIMITER holds the ceiling", lim_max <= lim_ceil + 0.000001, "max=" + STR$(lim_max)
CHECK "LIMITER settles on the ceiling", lim_max > lim_ceil - 0.01, "max=" + STR$(lim_max)
DIM lim_meter = SOUND.LOUDNESS()
CHECK "LOUDNESS reports the reduction", lim_meter{"reduction_max"} < -2.5, "red=" + STR$(lim_meter{"reduction_max"})
SOUND.LIMITER
buf = SOUND.RENDER(CYC / 4)
CHECK "LIMITER off passes the level", MAX(ABS(buf)) > 0.75, "max=" + STR$(MAX(ABS(buf)))
DIM lim_err AS STRING = ""
TRY
    SOUND.LIMITER 3
CATCH
    lim_err = ERRMSG$
ENDTRY
CHECK "LIMITER rejects a ceiling above 0 dB", INSTR(lim_err, "ceiling") >= 0, lim_err

' a 988 Hz sine at amplitude 0.5 in both channels reads -6.02 LUFS
SOUND.RESET
SOUND.MASTER "FIXED", 1.0
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.GAIN 0, 0.5
SOUND.SEQ 0, "legato(1, b5)", "VOICE"
buf = SOUND.RENDER(CYC * 4)
DIM lm = SOUND.LOUDNESS(TRUE)
CHECK "LOUDNESS integrated", ABS(lm{"integrated"} + 6.02) < 0.15, "lufs=" + STR$(lm{"integrated"})
CHECK "LOUDNESS short term", ABS(lm{"SHORT"} + 6.02) < 0.15, "lufs=" + STR$(lm{"SHORT"})
CHECK "LOUDNESS measured 4 s", lm{"SECONDS"} = 4, "s=" + STR$(lm{"SECONDS"})
lm = SOUND.LOUDNESS()
CHECK "LOUDNESS reset", lm{"integrated"} = -120 ANDALSO lm{"SECONDS"} = 0, "lufs=" + STR$(lm{"integrated"})
buf = SOUND.RENDER(CYC / 2)
lm = SOUND.LOUDNESS()
CHECK "LOUDNESS momentary after 0.5 s", ABS(lm{"momentary"} + 6.02) < 0.15, "lufs=" + STR$(lm{"momentary"})
CHECK "LOUDNESS short term needs 3 s", lm{"SHORT"} = -120, "lufs=" + STR$(lm{"SHORT"})

' SEEK moves the clock and holds the score until SOUND.AT ends it;
' then the passed commands apply at once, inside the cycle
SOUND.RESET
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "c4*4", "VOICE"
buf = SOUND.RENDER(CYC / 2)
SOUND.SEEK 5
CHECK "SEEK moves the clock", ABS(SOUND.CYCLE() - 5) < 0.000001, "cycle=" + STR$(SOUND.CYCLE())
SOUND.AT 3
SOUND.SEQ 0, "c4*8", "VOICE"
SOUND.AT 7
SOUND.SEQ 0, "~", "VOICE"
CHECK "SEEK holds a passed command", SOUND.PENDING() = 2, "pending=" + STR$(SOUND.PENDING())
n = TRIGGERS()
buf = SOUND.RENDER(CYC / 4)
CHECK "held commands wait", TRIGGERS() = 1, ""
SOUND.AT
buf = SOUND.RENDER(CYC / 4)
CHECK "released, the passed switch plays at once", TRIGGERS() = 2, ""
CHECK "released, the later command waits", SOUND.PENDING() = 1, "pending=" + STR$(SOUND.PENDING())

' MUTE silences a track that keeps playing; LEVELS meters every track
SOUND.RESET
SOUND.MASTER "FIXED", 1.0
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.GAIN 0, 0.5
SOUND.SEQ 0, "legato(1, b5)", "VOICE"
buf = SOUND.RENDER(CYC / 4)
DIM lv = SOUND.LEVELS()
CHECK "LEVELS has a value per track", LEN(lv) = 16, "len=" + STR$(LEN(lv))
CHECK "LEVELS reads the playing track", lv[0] > 0.4 ANDALSO lv[1] = 0, "l0=" + STR$(lv[0])
SOUND.MUTE 0, TRUE
buf = SOUND.RENDER(CYC / 4)
CHECK "MUTE silences the track", MAX(ABS(buf)) < 0.0001, "max=" + STR$(MAX(ABS(buf)))
lv = SOUND.LEVELS()
CHECK "a muted track still meters", lv[0] > 0.4, "l0=" + STR$(lv[0])
SOUND.MUTE 0, FALSE
buf = SOUND.RENDER(CYC / 4)
CHECK "MUTE off brings it back", MAX(ABS(buf)) > 0.4, "max=" + STR$(MAX(ABS(buf)))
SOUND.MUTE 0, TRUE
SOUND.RESET
SOUND.MASTER "FIXED", 1.0
SOUND.VOICE 0, "SINE", 0.001, 0.01, 1.0, 0.005
SOUND.SEQ 0, "legato(1, b5)", "VOICE"
buf = SOUND.RENDER(CYC / 4)
CHECK "RESET lifts the mutes", MAX(ABS(buf)) > 0.4, "max=" + STR$(MAX(ABS(buf)))

' singing: every note sings the next syllable of the lyric; the vocoder
' lets the 20th harmonic of 110 Hz through on ee, hardly on oo
FUNC SUNG_BRIGHTNESS(lyric$) AS DOUBLE
    SOUND.RESET
    SOUND.VOICE 4, "SAW", 0.001, 0.01, 1.0, 0.01
    SOUND.GAIN 4, 0.3
    SOUND.SING 4, lyric$
    SOUND.SEQ 4, "legato(1, a2)", "VOICE"
    DIM sb = SOUND.RENDER(14192)
    RETURN TONE_LEVEL(sb, 2200, 6000) / (TONE_LEVEL(sb, 440, 6000) + 0.000001)
ENDFUNC
DIM sung_ee AS DOUBLE = SUNG_BRIGHTNESS("ee")
DIM sung_oo AS DOUBLE = SUNG_BRIGHTNESS("oo")
CHECK "sung ee brighter than oo", sung_ee > sung_oo * 3, "ee=" + STR$(sung_ee) + " oo=" + STR$(sung_oo)

SOUND.RESET
SOUND.VOICE 4, "SAW", 0.001, 0.01, 1.0, 0.01
SOUND.SING 4, "nee - sa _"
SOUND.SEQ 4, "a2 a2 a2 a2", "VOICE"
DIM heard$ AS STRING = ""
DIM q AS INTEGER
FOR q = 0 TO 3
    buf = SOUND.RENDER(CYC / 8)
    heard$ = heard$ + SOUND.SUNG$(4) + ","
    buf = SOUND.RENDER(CYC / 8)
NEXT q
CHECK_STR "SUNG$ follows the syllables", "i,i,a,,", heard$
CHECK "SUNG counts the notes", SOUND.SUNG(4) = 4, "n=" + STR$(SOUND.SUNG(4))
SOUND.SING 4, ""
buf = SOUND.RENDER(CYC / 8)
CHECK_STR "SING empty stops singing", "", SOUND.SUNG$(4)

err_msg = ""
TRY
    SOUND.SING 4, "la 9"
CATCH
    err_msg = ERRMSG$
ENDTRY
CHECK "unknown sound in a syllable", INSTR(err_msg, "no sound") >= 0, "msg=" + err_msg
SOUND.RESET
CHECK "RESET forgets the lyric", SOUND.SUNG(4) = 0, "n=" + STR$(SOUND.SUNG(4))

SOUND.RESET
PRINT "RESULTS: "; PASS_COUNT; " passed, "; FAIL_COUNT; " failed"
