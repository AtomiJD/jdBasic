' One pattern of work, run 3 * rounds times, with the C heap read after each
' third. A pattern that releases what it allocates prints three close
' figures; one that leaks prints a staircase. tests/leak_check.sh runs every
' pattern in both backends and judges the staircase.
'
'   jdBasic leak_patterns.jdb <pattern> <rounds>
'
' Prints one line: HEAP <pattern> <h1> <h2> <h3>

OPTION "EXPLICIT"

TYPE Probe
    Label AS STRING
    Size AS DOUBLE
ENDTYPE

DIM cli = OS.ARGS()
DIM pattern$ AS STRING = "concat"
DIM rounds AS INTEGER = 20000
IF LEN(cli) >= 2 THEN
    pattern$ = cli[LEN(cli) - 2]
    rounds = CINT(VAL(cli[LEN(cli) - 1]))
ENDIF

DIM passes AS INTEGER = 3 * rounds
DIM i AS INTEGER = 0
DIM sink$ AS STRING = ""
DIM total AS DOUBLE = 0.0
DIM marks$ AS STRING = ""
DIM glob AS ARRAY = []
DIM base8 AS ARRAY = RESHAPE(IOTA(64), [8, 8])
DIM kept$ AS STRING = ""
DIM shelf AS ARRAY = []
ON "LEAKPING" CALL OnLeakPing@

IF pattern$ = "concat" THEN
    FOR i = 1 TO passes
        sink$ = "row " + STR$(i)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mapread" THEN
    DIM bag AS MAP
    bag{"k"} = "value"
    FOR i = 1 TO passes
        sink$ = bag{"k"}
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mapwrite" THEN
    DIM store AS MAP
    FOR i = 1 TO passes
        store{"k"} = "row " + STR$(i)
        store{"n"} = i
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "func" THEN
    FOR i = 1 TO passes
        sink$ = Decorate$(i)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "arg" THEN
    FOR i = 1 TO passes
        total = total + LEN("row " + STR$(i)) + Measure("cell " + STR$(i))
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "escape" THEN
    FOR i = 1 TO passes
        sink$ = Echo$("row " + STR$(i))
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "dyn" THEN
    DIM cells = [1, 2, 3]
    FOR i = 1 TO passes
        sink$ = Render$(cells)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "typeof" THEN
    DIM probe = 42
    FOR i = 1 TO passes
        sink$ = TYPEOF(probe)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "field" THEN
    DIM box = CHAN.OPEN(2)
    CHAN.SEND box, {"NAME": "song/clock", "WAVE": IOTA(64)}
    DIM msg = CHAN.RECV(box, 100)
    FOR i = 1 TO passes
        total = total + LEN(msg{"WAVE"}) + Measure("at " + msg{"NAME"})
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "send" THEN
    DIM box2 = CHAN.OPEN(2)
    DIM got = {}
    FOR i = 1 TO passes
        CHAN.SEND box2, {"TOPIC": "song/clock", "N": i, "DATA": {"T": i}}
        got = CHAN.RECV(box2, 100)
        total = total + got{"N"}
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "json" THEN
    FOR i = 1 TO passes
        sink$ = JSON.STRINGIFY$({"A": i, "B": {"C": "x"}})
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "foreach" THEN
    DIM keyed AS MAP
    keyed{"alpha"} = 1
    keyed{"beta"} = 2
    FOR i = 1 TO passes
        FOR EACH k$ IN keyed
            total = total + LEN(k$)
        NEXT
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "maplit" THEN
    DIM env = {}
    FOR i = 1 TO passes
        env = {"T": i, "NAME": "clock"}
        total = total + env{"T"}
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "split" THEN
    DIM parts = SPLIT("a,b", ",")
    FOR i = 1 TO passes
        parts = SPLIT("a,b," + STR$(i), ",")
        total = total + LEN(parts)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "strlit" THEN
    DIM labels = ["", ""]
    FOR i = 1 TO passes
        labels = ["row " + STR$(i), "fixed"]
        total = total + LEN(labels)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "pushrow" THEN
    DIM batch = []
    FOR i = 1 TO passes
        batch = []
        PUSH(batch, [i, i + 1])
        PUSH(batch, [i, i + 2])
        total = total + LEN(batch)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "gridrow" THEN
    DIM grid = [[0, 0], [0, 0], [0, 0]]
    FOR i = 1 TO passes
        grid[i MOD 3] = [i, i * 2]
        total = total + LEN(grid)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "arraylit" THEN
    DIM row = [0, 0, 0]
    FOR i = 1 TO passes
        row = [i, i + 1, i + 2]
        total = total + row[1]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "arith" THEN
    DIM a AS ARRAY = RESHAPE(IOTA(64), [8, 8])
    DIM x AS ARRAY = a
    FOR i = 1 TO passes
        x = a * a + 1
        total = total + x[1][1]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "matmul" THEN
    DIM m AS ARRAY = RESHAPE(IOTA(64), [8, 8])
    DIM p AS ARRAY = m
    FOR i = 1 TO passes
        p = MATMUL(m, m)
        total = total + p[1][1]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "zerosgrid" THEN
    DIM z AS ARRAY = []
    FOR i = 1 TO passes
        z = ZEROS([8, 4])
        z = ONES([4, 8])
        total = total + LEN(z)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "moves" THEN
    DIM board AS ARRAY = RESHAPE(IOTA(64), [8, 8])
    DIM turn AS ARRAY = [1, 1]
    DIM mv AS ARRAY = []
    DIM col AS ARRAY = []
    FOR i = 1 TO passes
        mv = ROTATE(board, turn)
        mv = SHIFT(board, turn, 0)
        col = SLICE(board, 1, 2)
        col = SLICE(board, 1, 1, 3)
        total = total + mv[1][1] + LEN(col)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "takedrop" THEN
    DIM seq16 AS ARRAY = IOTA(16)
    DIM part AS ARRAY = []
    FOR i = 1 TO passes
        part = TAKE(3, seq16)
        part = DROP(3, seq16)
        total = total + part[0]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "chain" THEN
    DIM base AS ARRAY = RESHAPE(IOTA(64), [8, 8])
    DIM acc AS ARRAY = base
    FOR i = 1 TO passes
        acc = MATMUL(acc, base)
        acc = ROTATE(acc, [1, 1])
        acc = SHIFT(acc, 1, 0)
        total = total + acc[1][1]
        IF i MOD 7 = 0 THEN acc = base
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "chainstr" THEN
    DIM names AS ARRAY = ["delta", "alpha", "charlie", "bravo"]
    DIM ranked AS ARRAY = names
    FOR i = 1 TO passes
        ranked = SORT(ranked)
        ranked = REVERSE(ranked)
        ranked = TAKE(3, ranked)
        total = total + LEN(ranked[0])
        IF i MOD 5 = 0 THEN ranked = names
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "subglobal" THEN
    SubLoop(passes)
ELSEIF pattern$ = "iota" THEN
    DIM seq AS ARRAY = []
    FOR i = 1 TO passes
        seq = RESHAPE(IOTA(16), [4, 4])
        total = total + LEN(seq)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "pushvar" THEN
    DIM backlog AS ARRAY = []
    DIM item AS ARRAY = []
    FOR i = 1 TO passes
        backlog = []
        item = [i, i + 1]
        PUSH(backlog, item)
        item = [i, i + 2]
        PUSH(backlog, item)
        total = total + LEN(backlog)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "pushcall" THEN
    DIM made AS ARRAY = []
    FOR i = 1 TO passes
        made = []
        PUSH(made, IOTA(4))
        PUSH(made, RESHAPE(IOTA(4), [2, 2]))
        total = total + LEN(made)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "deepcell" THEN
    DIM cube AS ARRAY = [[[0, 0], [0, 0]], [[0, 0], [0, 0]]]
    FOR i = 1 TO passes
        cube[i MOD 2][(i + 1) MOD 2] = [i, i * 2]
        total = total + LEN(cube)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "gridvar" THEN
    DIM lattice AS ARRAY = [[0, 0], [0, 0], [0, 0]]
    DIM fresh AS ARRAY = []
    FOR i = 1 TO passes
        fresh = [i, i * 2]
        lattice[i MOD 3] = fresh
        total = total + LEN(lattice)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mapcell" THEN
    DIM slots AS MAP
    FOR i = 1 TO passes
        slots{"k"} = [i, i + 1]
        slots{"n"} = {"T": i}
        slots{"c"} = IOTA(3)
        total = total + LEN(slots{"k"})
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mapcellvar" THEN
    DIM slots2 AS MAP
    DIM spot AS ARRAY = []
    FOR i = 1 TO passes
        spot = [i, i + 1]
        slots2{"k"} = spot
        total = total + LEN(slots2{"k"})
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "nestlit" THEN
    DIM cube2 AS ARRAY = []
    FOR i = 1 TO passes
        cube2 = [[i, 0], [0, i]]
        total = total + cube2[1][1]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "nestmap" THEN
    DIM scene AS MAP
    FOR i = 1 TO passes
        scene = {"T": i, "AT": [i, i], "SUB": {"A": i}}
        total = total + scene{"T"}
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "strkeep" THEN
    FOR i = 1 TO passes
        Keep("row " + STR$(i))
        total = total + LEN(kept$)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "strwrap" THEN
    FOR i = 1 TO passes
        sink$ = Wrap$("row " + STR$(i))
        total = total + LEN(sink$)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "strshelf" THEN
    FOR i = 1 TO passes
        shelf = []
        Shelve("row " + STR$(i))
        total = total + LEN(shelf)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "pushstr" THEN
    DIM rack AS ARRAY = []
    FOR i = 1 TO passes
        rack = []
        PUSH(rack, "row " + STR$(i))
        PUSH(rack, "fixed")
        total = total + LEN(rack)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mathop" THEN
    DIM curve AS ARRAY = base8 * 1
    FOR i = 1 TO passes
        curve = TANH(base8 * 0.01) + CLAMP(base8, 2, 9) + IOTA(64, 1)[0]
        total = total + curve[0, 0]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mapop" THEN
    DIM opcells AS MAP
    FOR i = 1 TO passes
        opcells = {}
        opcells{"a"} = base8 * i
        opcells{"b"} = {"w": base8 + i}
        total = total + opcells{"a"}[0, 0]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "twocells" THEN
    DIM twin AS MAP
    DIM shared AS ARRAY = base8 * 1
    FOR i = 1 TO passes
        twin = {}
        shared = base8 * i
        twin{"a"} = shared
        twin{"b"} = shared
        total = total + twin{"b"}[0, 0]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "shadowname" THEN
    DIM ledger AS MAP
    FOR i = 1 TO passes
        ledger = {}
        ledger{"a"} = base8 * i
        total = total + ledger{"a"}[0, 0] + LedgerLen(i)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "tapenode" THEN
    FOR i = 1 TO passes
        TapeStep(i)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "gather" THEN
    DIM picks AS ARRAY = [0, 2, 4]
    DIM src8 AS ARRAY = IOTA(8)
    FOR i = 1 TO passes
        glob = src8[picks]
        total = total + SUM(src8[picks])
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "hofresult" THEN
    DIM hsrc AS ARRAY = IOTA(8)
    DIM lim AS INTEGER = 3
    FOR i = 1 TO passes
        glob = SELECT(Twice@, hsrc)
        glob = FILTER(LAMBDA USE(lim) x -> x > lim, hsrc)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "udtlocal" THEN
    FOR i = 1 TO passes
        total = total + ProbeSize(i)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "strcompare" THEN
    DIM hits AS INTEGER = 0
    FOR i = 1 TO passes
        IF "x" + STR$(i) = "y" THEN hits = hits + 1
        IF "x" + STR$(i) < "a" THEN hits = hits + 1
        IF STR$(i) = i THEN hits = hits + 1
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "formattagged" THEN
    DIM fbag AS MAP = {}
    fbag{"n"} = 5
    DIM fsmall AS ARRAY = [1, 2]
    FOR i = 1 TO passes
        sink$ = FORMAT$("{} {} {} {}", fbag{"n"}, TRUE, fsmall, "r" + STR$(i))
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mapkey" THEN
    DIM kbag AS MAP = {}
    kbag{"k1"} = 1
    FOR i = 1 TO passes
        IF MAP.EXISTS(kbag, "k" + STR$(i)) THEN total = total + 1
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "strops" THEN
    FOR i = 1 TO passes
        sink$ = ("a" + STR$(i)) * 2
        sink$ = ("abc" + STR$(i)) - "b"
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "pop" THEN
    FOR i = 1 TO passes
        DIM popped_from AS ARRAY = [[i, 2, 3], [4, 5, i]]
        DIM popped_row AS ARRAY = POP(popped_from)
        total = total + popped_row[2]
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "eventraise" THEN
    FOR i = 1 TO passes
        RAISEEVENT "LEAKPING", "data" + STR$(i)
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "closurefunc" THEN
    FOR i = 1 TO passes
        total = total + CountAbove(3)
        glob = AGG([1, 2, 1], [10, 20, 30], LAMBDA g -> SUM(g))
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "strcells" THEN
    FOR i = 1 TO passes
        glob = STR$([1, 2, 3])
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "textcells" THEN
    DIM tc$ AS ARRAY = ["a", "b", "c"]
    DIM twords AS ARRAY = [" ab ", " cd "]
    DIM tbag AS MAP = {}
    tbag{"s"} = "abc"
    DIM tv = tbag{"s"}
    FOR i = 1 TO passes
        tc$[1] = "row" + STR$(i)
        tv = "v" + STR$(i)
        tv = tbag{"s"}
        total = total + LEN(JOIN(TRIM$(UCASE$(twords)), ""))
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSEIF pattern$ = "mapjoin" THEN
    DIM jbag AS MAP = {}
    jbag{"s"} = "abc"
    jbag{"n"} = 5
    FOR i = 1 TO passes
        sink$ = jbag{"s"} + jbag{"n"}
        IF jbag{"s"} = i THEN total = total + 1
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ELSE
    FOR i = 1 TO passes
        total = total + i * 0.5
        IF i MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT i
ENDIF

PRINT "HEAP " + pattern$ + marks$

FUNC Decorate$(n)
    DIM body$ = "row " + STR$(n)
    DIM framed$ = "[" + body$ + "]"
    RETURN framed$
ENDFUNC

FUNC Measure(s$)
    RETURN LEN(s$) + INSTR(s$, "1")
ENDFUNC

FUNC Echo$(s$)
    RETURN s$
ENDFUNC

FUNC Render$(v)
    DIM out$ = ""
    DIM k AS INTEGER
    FOR k = 0 TO LEN(v) - 1
        out$ = out$ + STR$(v[k])
    NEXT k
    RETURN out$ + "."
ENDFUNC

' A temp handed to a parameter that is copied into a global, laid into a
' literal or pushed into an owner's array dies with the call.
SUB Keep(s$ AS STRING)
    kept$ = s$
ENDSUB

FUNC Wrap$(s$ AS STRING)
    DIM pair AS ARRAY = [s$, "x"]
    RETURN pair[0] + "!"
ENDFUNC

SUB Shelve(s$ AS STRING)
    PUSH(shelf, s$)
ENDSUB

' A global reassigned inside a SUB's loop: what it let go of is freed within
' the SUB, not only once the main program loops.
SUB SubLoop(n AS INTEGER)
    DIM j AS INTEGER
    glob = base8
    FOR j = 1 TO n
        glob = MATMUL(glob, base8)
        glob = [j, j + 1]
        glob = base8
        IF j MOD rounds = 0 THEN marks$ = marks$ + " " + STR$(SYS.HEAP())
    NEXT j
ENDSUB

' A node built in a local map and filed whole into a map of the main program,
' then read back through a copy of its cell and updated with a value whose
' kind is known only when it runs: the shape of an autograd tape.
DIM tape = {}
SUB TapeStep(n AS INTEGER)
    DIM nd = {}
    tape = {}
    nd{"v"} = base8 * n
    tape{"x"} = nd
    DIM back = tape{"x"}
    tape{"g"} = back{"v"} * 0.5
    tape{"g"} = tape{"g"} * 0 + base8
    total = total + LEN(tape{"g"})
ENDSUB

' A FUNC's own local of the name a variable of the main program has, handed
' on whole: it says nothing about the main program's variable.
FUNC LedgerLen(n AS INTEGER) AS INTEGER
    DIM ledger AS ARRAY = [n, n + 1]
    RETURN LEN(Render$(ledger))
ENDFUNC

' A UDT local only used for its fields: freed with its frame.
FUNC ProbeSize(n AS INTEGER) AS DOUBLE
    DIM pr AS Probe
    pr.Label = "p" + STR$(n)
    pr.Size = n
    RETURN pr.Size + LEN(pr.Label)
ENDFUNC

FUNC Twice(x)
    RETURN x * 2
ENDFUNC

' A closure built inside a FUNC for one call.
FUNC CountAbove(lim AS INTEGER) AS INTEGER
    DIM seen AS ARRAY = FILTER(LAMBDA USE(lim) x -> x > lim, [1, 2, 3, 4, 5])
    RETURN LEN(seen)
ENDFUNC

SUB OnLeakPing(args AS ARRAY)
    total = total + LEN(args)
ENDSUB
