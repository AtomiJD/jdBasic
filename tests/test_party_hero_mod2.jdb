' Main module also has EXPORT MODULE pattern (like rpg_engine)
EXPORT MODULE TEST_PARTY_HERO_MOD2

IMPORT TEST_PARTY_HERO_MOD

EXPORT DIM hero = -1
EXPORT DIM followers = []
EXPORT DIM follow_count = 0
EXPORT DIM npcs = []
EXPORT DIM npc_count = 0

EXPORT SUB INIT_HERO()
    hero = 42
    npc_count = 2
    n = {} : n{"name"} = "npc1" : PUSH npcs, n
    n2 = {} : n2{"name"} = "npc2" : PUSH npcs, n2
ENDSUB

EXPORT SUB UPDATE_FOLLOWERS()
    FOR fi = 1 TO TEST_PARTY_HERO_MOD.member_count - 1
        IF fi - 1 >= follow_count THEN
            pm = TEST_PARTY_HERO_MOD.GET_MEMBER(fi)
            PRINT "  fi="; fi; " pm.name="; pm{"name"}
            ' Simulate SPRITE.LOAD
            fs = 100 + fi
            PRINT "  inside SUB, hero="; hero; " fs="; fs
            IF hero <> 42 THEN PRINT "FAIL: hero changed inside SUB"
            ' Simulate: scan npcs and toggle visibility (like RPG)
            pm_name$ = pm{"name"}
            FOR ni = 0 TO npc_count - 1
                nn = npcs[ni]
                PRINT "    ni="; ni; " nn.name="; nn{"name"}
            NEXT ni
            PUSH followers, fs
            follow_count = follow_count + 1
        ENDIF
    NEXT fi
ENDSUB

EXPORT SUB RECRUIT(char_id$)
    TEST_PARTY_HERO_MOD.ADD_MEMBER char_id$
    PRINT "after ADD_MEMBER, hero="; hero
    UPDATE_FOLLOWERS
    PRINT "after UPDATE_FOLLOWERS, hero="; hero
ENDSUB
