props = {}
props{"sprite"} = "moehrchen.png"

' Baseline: direct (works)
nd0 = {}
nd0{"sprite"} = props{"sprite"}
PRINT "0 '"; nd0{"sprite"}; "'"

' Other bridge function in cond
nd1 = {}
IF LEN("xyz") > 0 THEN nd1{"sprite"} = props{"sprite"}
PRINT "1 '"; nd1{"sprite"}; "'"

' LEN with non-map arg in cond
nd2 = {}
IF LEN("abcd") > 2 THEN nd2{"sprite"} = props{"sprite"}
PRINT "2 '"; nd2{"sprite"}; "'"

' Stress: nested condition
nd3 = {}
flag = TRUE
IF flag AND flag THEN nd3{"sprite"} = props{"sprite"}
PRINT "3 '"; nd3{"sprite"}; "'"

' Deliberately reading map again after other call
nd4 = {}
dummy = LEN("x")
IF dummy > 0 THEN nd4{"sprite"} = props{"sprite"}
PRINT "4 '"; nd4{"sprite"}; "'"
