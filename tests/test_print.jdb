' Comma = space between values
PRINT "A", "B", "C"

' Semicolon = no space between values
PRINT "A"; "B"; "C"

' Mixed
PRINT "Name:"; " John", "Age:", 42

' Trailing semicolon = no newline
PRINT "Hello ";
PRINT "World!"

' Trailing comma = no newline
PRINT "One ",
PRINT "Two"

' FOR with semicolon (no spaces, no newline)
FOR i = 1 TO 10: PRINT i;: NEXT i
PRINT ""

' FOR with comma (spaces between)
FOR i = 1 TO 5: PRINT i,: NEXT i
PRINT ""
