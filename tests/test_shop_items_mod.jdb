EXPORT MODULE TEST_SHOP_ITEMS_MOD

EXPORT DIM item_db = {}

EXPORT SUB LOAD_DB()
    data = JSON.PARSE$(TXTREADER$("tests/test_items.json"))
    item_db = data{"items"}
ENDSUB

EXPORT FUNC RESOLVE(id_list)
    result = []
    FOR i = 0 TO LEN(id_list) - 1
        id$ = id_list[i]
        IF MAP.EXISTS(item_db, id$) THEN
            itm = item_db{id$}
            PUSH result, itm
        ENDIF
    NEXT i
    RETURN result
ENDFUNC
