' An untyped FUNC parameter that different call sites pass a string and a
' number to. It carries its own kind through the ABI now, so both calls
' answer what they were given - the refusal that used to stand here guarded
' against a segfault the compiler no longer produces. The supported spelling,
' TYPEOF in the body, has to keep working too.
'
'   jdbasic tests/native_param_conflict_test.jdb    (needs a NATIVEC build)
'
' The compiler is driven as a process because what it says about a program is
' only observable from outside: a test cannot assert about a compile that
' never happens.

DIM pass = 0
DIM fail = 0

SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  is ["; got$; "] want ["; want$; "]"
    ENDIF
ENDSUB

' The interpreter is jdBasic.exe from build.bat and jdbasic from build.sh, and
' the test is run either from the repository root or from its own directory.
' PATH.JOIN$ answers with the separator the platform's shell accepts: cmd
' reads a forward slash as the start of a switch.
FUNC FIND_INTERPRETER$() AS STRING
    DIM cand$ = PATH.JOIN$("build", "jdBasic.exe")
    IF FILE.EXISTS(cand$) THEN RETURN cand$
    cand$ = PATH.JOIN$("build", "jdbasic")
    IF FILE.EXISTS(cand$) THEN RETURN cand$
    DIM up$ = PATH.JOIN$(PATH.JOIN$("..", ".."), "build")
    cand$ = PATH.JOIN$(up$, "jdBasic.exe")
    IF FILE.EXISTS(cand$) THEN RETURN cand$
    cand$ = PATH.JOIN$(up$, "jdbasic")
    IF FILE.EXISTS(cand$) THEN RETURN cand$
    RETURN ""
ENDFUNC

DIM exe$ = FIND_INTERPRETER$()
' A leading "." keeps the produced program executable without a PATH lookup.
DIM tmp$ = PATH.JOIN$(".", "tmp_param_conflict.jdb")
DIM tmpexe$ = PATH.JOIN$(".", "tmp_param_conflict.exe")

FUNC COMPILE(src$) AS OBJECT
    TXTWRITER tmp$, src$
    RETURN OS.EXEC(exe$, ["-c", tmp$])
ENDFUNC

DIM nl$ = CHR$(10)

IF exe$ = "" THEN
    PRINT "SKIP: no interpreter under build to compile the three programs with"
    PRINT "native_param_conflict_test: passed 0, failed 0"
    END
ENDIF

PRINT "--- one parameter with two types compiles and runs"

DIM bad$ = "FUNC id(v)" + nl$ + "  RETURN v" + nl$ + "ENDFUNC" + nl$ + _
    "PRINT id(" + CHR$(34) + "a" + CHR$(34) + ")" + nl$ + "PRINT id(5)" + nl$
DIM r1 = COMPILE(bad$)
CHECK("the compile goes through", STR$(r1{"EXIT_CODE"}), "0")
CHECK("without a conflict message", STR$(INSTR("" + r1{"OUTPUT"}, "is called with") >= 0), "FALSE")
DIM ran = OS.EXEC(tmpexe$)
CHECK("the string arrives as a string", STR$(INSTR("" + ran{"OUTPUT"}, "a") >= 0), "TRUE")
CHECK("the number as a number", STR$(INSTR("" + ran{"OUTPUT"}, "5") >= 0), "TRUE")

PRINT "--- with TYPEOF in the body the same call compiles"

' This is the documented way: a parameter the body asks TYPEOF about becomes
' runtime-tagged and carries its own type through the ABI.
DIM good$ = "FUNC show$(v)" + nl$ + _
    "  IF TYPEOF(v) = " + CHR$(34) + "STRING" + CHR$(34) + " THEN RETURN v" + nl$ + _
    "  RETURN STR$(v)" + nl$ + "ENDFUNC" + nl$ + _
    "PRINT show$(" + CHR$(34) + "a" + CHR$(34) + ")" + nl$ + "PRINT show$(5)" + nl$
DIM r2 = COMPILE(good$)
CHECK("the compile goes through", STR$(r2{"EXIT_CODE"}), "0")
CHECK("  without a conflict message", STR$(INSTR("" + r2{"OUTPUT"}, "is called with") >= 0), "FALSE")

PRINT "--- and an annotated parameter likewise"

DIM ann$ = "FUNC twice(v AS DOUBLE)" + nl$ + "  RETURN v * 2" + nl$ + "ENDFUNC" + nl$ + _
    "PRINT twice(5)" + nl$
DIM r3 = COMPILE(ann$)
CHECK("annotated compiles", STR$(r3{"EXIT_CODE"}), "0")

PRINT ""
PRINT "native_param_conflict_test: passed "; pass; ", failed "; fail

KILL tmp$
IF FILE.EXISTS(tmpexe$) THEN KILL tmpexe$
IF fail > 0 THEN END 1
