' An untyped FUNC parameter that different call sites pass a string and a
' number to. It carries its own kind through the ABI now, so both calls
' answer what they were given - the refusal that used to stand here guarded
' against a segfault the compiler no longer produces. The supported spelling,
' TYPEOF in the body, has to keep working too.
'
'   jdbasic tests/native_param_conflict_test.jdb    (needs a NATIVEC build)
'
' The compiler is driven as a process because what it says about a program is
' only observable from outside: a test cannot assert about a compile that
' never happens.

DIM pass = 0
DIM fail = 0

SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  ist ["; got$; "] soll ["; want$; "]"
    ENDIF
ENDSUB

DIM exe$ = "build" + CHR$(92) + "jdBasic.exe"
DIM tmp$ = "tests" + CHR$(92) + "tmp_param_conflict.jdb"
DIM tmpexe$ = "tests" + CHR$(92) + "tmp_param_conflict.exe"

FUNC COMPILE(src$) AS OBJECT
    TXTWRITER tmp$, src$
    RETURN OS.EXEC(exe$ + " -c " + tmp$)
ENDFUNC

DIM nl$ = CHR$(10)

PRINT "--- ein Parameter mit zwei Typen uebersetzt und laeuft"

DIM bad$ = "FUNC id(v)" + nl$ + "  RETURN v" + nl$ + "ENDFUNC" + nl$ + _
    "PRINT id(" + CHR$(34) + "a" + CHR$(34) + ")" + nl$ + "PRINT id(5)" + nl$
DIM r1 = COMPILE(bad$)
CHECK("die Uebersetzung geht durch", STR$(r1{"EXIT_CODE"}), "0")
CHECK("ohne Konflikt-Meldung", STR$(INSTR("" + r1{"OUTPUT"}, "is called with") >= 0), "FALSE")
DIM ran = OS.EXEC(tmpexe$)
CHECK("der String kommt als String an", STR$(INSTR("" + ran{"OUTPUT"}, "a") >= 0), "TRUE")
CHECK("die Zahl als Zahl", STR$(INSTR("" + ran{"OUTPUT"}, "5") >= 0), "TRUE")

PRINT "--- mit TYPEOF im Rumpf uebersetzt derselbe Aufruf"

' This is the documented way: a parameter the body asks TYPEOF about becomes
' runtime-tagged and carries its own type through the ABI.
DIM good$ = "FUNC show$(v)" + nl$ + _
    "  IF TYPEOF(v) = " + CHR$(34) + "STRING" + CHR$(34) + " THEN RETURN v" + nl$ + _
    "  RETURN STR$(v)" + nl$ + "ENDFUNC" + nl$ + _
    "PRINT show$(" + CHR$(34) + "a" + CHR$(34) + ")" + nl$ + "PRINT show$(5)" + nl$
DIM r2 = COMPILE(good$)
CHECK("die Uebersetzung geht durch", STR$(r2{"EXIT_CODE"}), "0")
CHECK("  ohne Konflikt-Meldung", STR$(INSTR("" + r2{"OUTPUT"}, "is called with") >= 0), "FALSE")

PRINT "--- und ein annotierter Parameter ebenso"

DIM ann$ = "FUNC twice(v AS DOUBLE)" + nl$ + "  RETURN v * 2" + nl$ + "ENDFUNC" + nl$ + _
    "PRINT twice(5)" + nl$
DIM r3 = COMPILE(ann$)
CHECK("annotiert uebersetzt", STR$(r3{"EXIT_CODE"}), "0")

PRINT ""
PRINT "native_param_conflict_test: bestanden "; pass; ", gefallen "; fail

KILL tmp$
IF FILE.EXISTS(tmpexe$) THEN KILL tmpexe$
IF fail > 0 THEN END 1
