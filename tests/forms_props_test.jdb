' The property surface: colours, fonts, tag, tooltip, mask and tab order.
'
'   jdbasic tests/forms_props_test.jdb        (needs a FORMS build)
'
' Values are asserted through FORM.GET, and the window is photographed so the
' half only an eye can judge - does the red label actually come out red - can
' be looked at afterwards in tmp/forms_props.png.

DIM pass = 0
DIM fail = 0

SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  got ["; got$; "] want ["; want$; "]"
    ENDIF
ENDSUB

CONST RED = 13369344
CONST CREAM = 16775906
CONST NAVY = 2050956

DIM frm = FORM.CREATE("Properties", 460, 300, "PF")
FORM.SET(frm, "BACKCOLOR", CREAM)

DIM lb1 = FORM.LABEL(frm, "L1", "Red, bold and right", 20, 20, 300, 22)
FORM.SET(lb1, "FORECOLOR", RED)
FORM.SET(lb1, "FONT", { "bold": TRUE, "size": 12 })
FORM.SET(lb1, "ALIGN", "RIGHT")

DIM lb2 = FORM.LABEL(frm, "L2", "White on navy, italic", 20, 50, 300, 22)
FORM.SET(lb2, "FORECOLOR", 16777215)
FORM.SET(lb2, "BACKCOLOR", NAVY)
FORM.SET(lb2, "FONT", { "italic": TRUE })

DIM pw = FORM.TEXTBOX(frm, "PW", "secret", 20, 84, 200, 24)
FORM.SET(pw, "PASSWORD", TRUE)
FORM.SET(pw, "MAXLENGTH", 8)

DIM ro = FORM.TEXTBOX(frm, "RO", "read only", 20, 116, 200, 24)
FORM.SET(ro, "LOCKED", TRUE)
FORM.SET(ro, "BACKCOLOR", 15132390)

DIM btn = FORM.BUTTON(frm, "B1", "&Wait", 20, 152, 120, 28)
FORM.SET(btn, "TOOLTIP", "Shows the hourglass")
FORM.SET(btn, "CURSOR", "WAIT")
FORM.SET(btn, "TAG", { "kind": "demo", "n": 7 })

DIM t1 = FORM.TEXTBOX(frm, "T1", "first", 240, 84, 180, 24)
DIM t2 = FORM.TEXTBOX(frm, "T2", "second", 240, 116, 180, 24)
FORM.SET(t2, "TABSTOP", FALSE)

' A handle is gone once its window is, so everything is read while the form
' still stands and only judged afterwards.
DIM got AS MAP = {}
DIM shot = 0

SUB PF_LOAD(e)
    shot = 1
ENDSUB

DIM tmr = FORM.TIMER(frm, "TT", 400)

SUB TT_TICK(e)
    IF shot = 1 THEN
        shot = 2
        DIM r = OS.SCREENSHOT("tmp/forms_props.png", "window", "Properties")
        PRINT "Screenshot: "; r; " (0 = written)"
        got{"fore"} = FORM.GET(lb1, "FORECOLOR")
        got{"back"} = FORM.GET(lb2, "BACKCOLOR")
        got{"formback"} = FORM.GET(frm, "BACKCOLOR")
        got{"nofore"} = FORM.GET(t1, "FORECOLOR")
        got{"maxlen"} = FORM.GET(pw, "MAXLENGTH")
        got{"locked"} = FORM.GET(ro, "LOCKED")
        got{"unlocked"} = FORM.GET(t1, "LOCKED")
        got{"notab"} = FORM.GET(t2, "TABSTOP")
        got{"tab"} = FORM.GET(t1, "TABSTOP")
        got{"tip"} = FORM.GET(btn, "TOOLTIP")
        got{"tag"} = FORM.GET(btn, "TAG")
        FORM.CLOSE(frm)
    ENDIF
ENDSUB

FORM.RUN(frm)

PRINT ""
CHECK("FORECOLOR comes back", STR$(got{"fore"}), STR$(RED))
CHECK("BACKCOLOR comes back", STR$(got{"back"}), STR$(NAVY))
CHECK("the form carries its own", STR$(got{"formback"}), STR$(CREAM))
CHECK("an unset colour answers -1", STR$(got{"nofore"}), "-1")
CHECK("MAXLENGTH comes back", STR$(got{"maxlen"}), "8")
CHECK("LOCKED comes back", STR$(got{"locked"}), "TRUE")
CHECK("  and another field is not", STR$(got{"unlocked"}), "FALSE")
CHECK("TABSTOP can be switched off", STR$(got{"notab"}), "FALSE")
CHECK("  and stays set otherwise", STR$(got{"tab"}), "TRUE")
CHECK("TOOLTIP comes back", "" + got{"tip"}, "Shows the hourglass")
CHECK("TAG holds a whole map", STR$(got{"tag"}{"n"}), "7")
CHECK("  and the text inside it", "" + got{"tag"}{"kind"}, "demo")

PRINT ""
PRINT "forms_props_test: " + STR$(pass) + " passed, " + STR$(fail) + " failed"
IF fail = 0 THEN PRINT "ALL FORMS PROPS TESTS PASSED!"
