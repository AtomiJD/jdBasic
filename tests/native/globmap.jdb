' Helper module for test_native_global_map_return.jdb.
EXPORT MODULE GLOBMAP

DIM gLast = {}

FUNC Make()
    DIM m AS MAP
    m{"a"} = [1, 2]
    RETURN {"index": m, "n": 1}
ENDFUNC

EXPORT FUNC RUN()
    DIM r = Make()
    gLast = r{"index"}
    RETURN 1
ENDFUNC

EXPORT FUNC LAST()
    RETURN gLast
ENDFUNC
