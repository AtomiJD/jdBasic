OPTION "EXPLICIT"
OPTION "STRICT"

DIM GW = 4
DIM GH = 3

DIM XS = IOTA(GW) - 2
DIM YS = IOTA(GH) - 1
PRINT "XS:", XS
PRINT "YS:", YS
PRINT "YS*0:", YS*0
DIM GX = OUTER(YS*0, XS, "+")
PRINT "GX:", GX
DIM GY = OUTER(YS, XS*0, "+")
PRINT "GY:", GY
DIM DIST = SQR(GX^2 + GY^2)
PRINT "DIST:", DIST
DIM Z0 = SIN(DIST)
PRINT "Z0:", Z0
DIM SX = GX * 30 + 400
PRINT "SX:", SX
DIM VX1 = DROP(-1, SX)
PRINT "VX1:", VX1
DIM NV = (GH - 1) * GW
PRINT "NV:", NV
DIM FLAT = RESHAPE(VX1, [NV])
PRINT "FLAT:", FLAT
END
