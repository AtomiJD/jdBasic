REM Repro: building an array literal from map-get values where elements are strings
REM should yield a string-bearing array, not zeros.
OPTION "EXPLICIT"
DIM m AS MAP
m{"a"} = "alpha"
m{"b"} = "beta"
m{"c"} = "gamma"
m{"x"} = 42

PRINT "direct map gets:"
PRINT "  m{a}=["; m{"a"}; "]"
PRINT "  m{b}=["; m{"b"}; "]"
PRINT "  m{x}=["; m{"x"}; "]"

PRINT "via DIM AS STRING:"
DIM s$ = m{"a"}
PRINT "  s$=["; s$; "]"

PRINT "Array literal of map values:"
DIM arr = [m{"a"}, m{"b"}, m{"c"}]
PRINT "  arr[0]=["; arr[0]; "]"
PRINT "  arr[1]=["; arr[1]; "]"
PRINT "  arr[2]=["; arr[2]; "]"

PRINT "Mixed array literal of map values + int:"
DIM arr2 = [m{"a"}, m{"b"}, m{"x"}]
PRINT "  arr2[0]=["; arr2[0]; "]"
PRINT "  arr2[1]=["; arr2[1]; "]"
PRINT "  arr2[2]=["; arr2[2]; "]"
