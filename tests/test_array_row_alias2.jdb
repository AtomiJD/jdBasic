' Repro for Tier 1b: variant from Mandelbrot bench.
' Pattern is: aliased reads of MULTIPLE related arrays inside a FOR loop,
' followed by writebacks to the same arrays.

OPTION "EXPLICIT"

DIM h AS INTEGER = 4
DIM w AS INTEGER = 3

LET ZR = []
LET ZI = []
LET ITERS = []
DIM i AS INTEGER
FOR i = 0 TO h - 1
    PUSH ZR, [(i + 1) *10, (i + 1) *20, (i + 1) *30]
    PUSH ZI, [(i + 1) *100, (i + 1) *200, (i + 1) *300]
    PUSH ITERS, [i, i, i]
NEXT i

PRINT "Before:"
FOR i = 0 TO h - 1
    PRINT "  ZR["; i; "]="; ZR[i]; "  ZI["; i; "]="; ZI[i]; "  ITERS["; i; "]="; ITERS[i]
NEXT i

DIM r AS INTEGER
FOR r = 0 TO h - 1
    LET cur_zr = ZR[r]
    LET cur_zi = ZI[r]
    LET nzr = cur_zr * cur_zr - cur_zi * cur_zi
    ZR[r] = nzr
    ZI[r] = 2 * cur_zr * cur_zi
NEXT r

PRINT
PRINT "After (should be (cur_zr^2 - cur_zi^2) and (2*cur_zr*cur_zi) per row):"
FOR i = 0 TO h - 1
    PRINT "  ZR["; i; "]="; ZR[i]; "  ZI["; i; "]="; ZI[i]
NEXT i
