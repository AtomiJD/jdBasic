' Mimics rpg_engine.jdb more closely, with TYPE use + cross-mod calls
EXPORT MODULE TEST_RECRUIT_ENGINE
IMPORT TEST_RECRUIT_MOD

EXPORT DIM hero = -1
EXPORT DIM npcs = []
EXPORT DIM npc_count = 0
EXPORT DIM follow_sprites = []
EXPORT DIM follow_count = 0

EXPORT SUB INIT()
    hero = 42
    follow_sprites = []
    follow_count = 0
    ' Create npcs with TYPE
    DIM n1 AS TEST_RECRUIT_MOD.T_NPC
    n1.INIT "vally", 2
    PUSH npcs, n1
    DIM n2 AS TEST_RECRUIT_MOD.T_NPC
    n2.INIT "mohrchen", 3
    PUSH npcs, n2
    npc_count = 2
ENDSUB

EXPORT SUB UPDATE_FOLLOW_SPRITES()
    FOR fi = 1 TO TEST_RECRUIT_MOD.member_count - 1
        IF fi - 1 >= follow_count THEN
            pm = TEST_RECRUIT_MOD.GET_MEMBER(fi)
            fs = 100 + fi
            ' The critical line: INDEX+builtin-like ops with hero
            PRINT "  [UFS] hero="; hero; " fs="; fs; " pm.name="; pm{"name"}
            IF hero = 0 THEN PRINT "FAIL: hero=0 inside UPDATE_FOLLOW_SPRITES"
            ' Hide matching NPC sprite (like RPG)
            pm_name$ = pm{"name"}
            FOR ni = 0 TO npc_count - 1
                nn = npcs[ni]
                IF nn.name$ = pm_name$ THEN
                    nn.SET_VISIBLE FALSE
                    PRINT "    hide "; nn.name$; " sid="; nn.sprite_id
                ENDIF
            NEXT ni
            PUSH follow_sprites, fs
            follow_count = follow_count + 1
        ENDIF
    NEXT fi
ENDSUB

EXPORT SUB UPDATE_FOLLOW_POSITIONS()
    PRINT "  [UFP] hero="; hero; " count="; follow_count
    IF follow_count = 0 THEN RETURN
    hx = hero * 10
    FOR fi = 0 TO follow_count - 1
        IF follow_sprites[fi] < 0 THEN CONTINUEFOR
        cur = follow_sprites[fi]
        PRINT "    fi="; fi; " cur="; cur
        IF cur = 0 THEN PRINT "FAIL: follow_sprites["; fi; "] = 0"
    NEXT fi
ENDSUB

EXPORT SUB RECRUIT(rid$)
    TEST_RECRUIT_MOD.ADD_MEMBER rid$
    UPDATE_FOLLOW_SPRITES
ENDSUB
