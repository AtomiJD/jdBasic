' ══════════════════════════════════════════════════════════════════
' Group A demo - String padding, number theory, bit rotations, env
' ══════════════════════════════════════════════════════════════════
' Showcases LPAD$/RPAD$/REPEAT$/GCD/LCM/ROTL/ROTR/SETENV/MKTEMP$/RMDIR

OPTION "EXPLICIT"

' ── 1. Pretty report table with pad/repeat ────────────────────────
PRINT REPEAT$("═", 56)
PRINT "│ " + RPAD$("PRODUCT", 20) + RPAD$("UNITS", 10) + LPAD$("PRICE", 10) + LPAD$("TOTAL", 12) + " │"
PRINT "├" + REPEAT$("─", 54) + "┤"

DIM items[3, 3]
items[0, 0] = "Widgets"
items[0, 1] = 3
items[0, 2] = 4.99
items[1, 0] = "Gadgets"
items[1, 1] = 12
items[1, 2] = 1.25
items[2, 0] = "Doohickeys"
items[2, 1] = 7
items[2, 2] = 9.00

DIM grand = 0.0
FOR i = 0 TO 2
    DIM name$ = items[i, 0]
    DIM qty = items[i, 1]
    DIM price = items[i, 2]
    DIM line_total = qty * price
    grand = grand + line_total
    PRINT "│ " + RPAD$(name$, 20) + RPAD$(STR$(qty), 10) + LPAD$(FORMAT$("{:.2f}", price), 10) + LPAD$(FORMAT$("{:.2f}", line_total), 12) + " │"
NEXT i

PRINT "├" + REPEAT$("─", 54) + "┤"
PRINT "│ " + RPAD$("GRAND TOTAL", 40) + LPAD$(FORMAT$("{:.2f}", grand), 12) + " │"
PRINT REPEAT$("═", 56)
PRINT ""

' ── 2. Number theory - reduce a fraction ──────────────────────────
PRINT "Reduce 84/126 by GCD = "; GCD(84, 126); " → "; (84 / GCD(84, 126)); "/"; (126 / GCD(84, 126))

' LCM helps with periodic events lining up
PRINT "Event A every 8 days, event B every 12 days: align every "; LCM(8, 12); " days"

' Variadic GCD of a shopping list
PRINT "Common packaging unit for [24, 36, 60, 84]: "; GCD(24, 36, 60, 84)
PRINT ""

' ── 3. Tiny rotate-based scrambler (symmetric) ────────────────────
' ROTL by 3 → ROTR by 3 must return the same bits
DIM key = 3
DIM plain = $DEADBEEF
DIM scrambled = ROTL(plain, key)
DIM unscrambled = ROTR(scrambled, key)
PRINT "plain      = "; HEX$(plain)
PRINT "scrambled  = "; HEX$(scrambled)
PRINT "round-trip = "; HEX$(unscrambled); "  (match: "; (unscrambled = plain); ")"
PRINT ""

' ── 4. Scratch workspace with SETENV/MKTEMP$/RMDIR ────────────────
DIM work = MKTEMP$("demo-a")
' MKTEMP$ returns a path without creating the file, so the filename
' is a usable unique token - we'll turn it into a directory.
DIM workdir = work + "-dir"
MKDIR workdir
SETENV "DEMO_A_WORK", workdir
PRINT "Scratch directory: "; GETENV$("DEMO_A_WORK")

' Write a note inside
DIM note = workdir + "/readme.txt"
TXTWRITER note, "Report generated by demo_group_a"

PRINT "Note written: "; FILE.EXISTS(note) = 1

KILL note
RMDIR workdir
PRINT "Workspace cleaned up: "; FILE.EXISTS(workdir) = 0
