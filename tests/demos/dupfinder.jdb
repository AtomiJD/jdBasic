' dupfinder.jdb — find duplicate files by SHA256, group, sort by recoverable size.
' Usage:  dupfinder.exe <path>     (defaults to "." when no argument given)
'
' Storage shape: three parallel 1D arrays, one entry per group. Pipe-joined
' path strings keep everything as flat string vectors so jdBasic's APL-style
' tracking (string_array_vars, vector ops, mask indexing) works native.

OPTION EXPLICIT
OPTION STRICT

FUNC walk(path AS STRING)
  DIM out AS ARRAY = []
  DIM names = DIR$(path + "/*", FALSE)
  DIM n AS INTEGER = LEN(names)
  IF n = 0 THEN RETURN out
  DIM i AS INTEGER
  FOR i = 0 TO n - 1
    DIM nm AS STRING = names[i]
    DIM full AS STRING = path + "/" + nm
    IF FILE.ISDIR(full) THEN
      out = APPEND(out, walk(full))
    ELSE
      out = APPEND(out, [full])
    ENDIF
  NEXT i
  RETURN out
ENDFUNC

FUNC where_true(mask)
  DIM idx AS ARRAY = []
  DIM i AS INTEGER
  FOR i = 0 TO LEN(mask) - 1
    IF mask[i] THEN idx = APPEND(idx, [i])
  NEXT i
  RETURN idx
ENDFUNC

FUNC hash_file$(path AS STRING)
  RETURN CODEC.SHA256$(BINREADER$(path))
ENDFUNC

' --- main ---

' OS.ARGS slot 0 is the invocation (script.jdb in interp, EXE path in
' native). User-supplied args start at slot 1. Defaults to "." otherwise.
DIM args = OS.ARGS()
DIM root AS STRING = "."
IF LEN(args) >= 2 THEN root = args[1]

IF FILE.ISDIR(root) = 0 THEN
  PRINT "error: not a directory: "; root
  END
ENDIF

DIM files = walk(root)
IF LEN(files) = 0 THEN
  PRINT "no files under "; root
  END
ENDIF

DIM hashes = SELECT(hash_file$@, files)
DIM uniq = UNIQUE(hashes)

' Three parallel 1D arrays — one row per duplicate group.
DIM g_saved AS ARRAY = []
DIM g_count AS ARRAY = []
DIM g_paths AS ARRAY = []

DIM h AS STRING
FOR EACH h IN uniq
  DIM m = (hashes = h)
  DIM c AS INTEGER = SUM(m)
  IF c >= 2 THEN
    DIM matching = files{where_true(m)}
    DIM sz AS INTEGER = FILE.SIZE(matching[0])
    DIM saved AS INTEGER = sz * (c - 1)
    g_saved = APPEND(g_saved, [saved])
    g_count = APPEND(g_count, [c])
    g_paths = APPEND(g_paths, [JOIN(matching, "|")])
  ENDIF
NEXT

PRINT "Scanned "; LEN(files); " files in "; root

IF LEN(g_saved) = 0 THEN
  PRINT "no duplicates found"
  END
ENDIF

DIM order = GRADE(0 - g_saved)
DIM total AS INTEGER = SUM(g_saved)

PRINT LEN(g_saved); " duplicate groups, "; FORMAT$("{:.1f}", total/1048576.0); " MB recoverable"
PRINT ""

DIM i AS INTEGER
FOR i = 0 TO LEN(order) - 1
  DIM idx AS INTEGER = order[i]
  DIM joined AS STRING = g_paths[idx]
  DIM parts = SPLIT(joined, "|")
  PRINT FORMAT$("[{}] {:>7.2f} MB x {}  ", i+1, g_saved[idx]/1048576.0, g_count[idx]); parts[0]
  DIM j AS INTEGER
  FOR j = 1 TO LEN(parts) - 1
    PRINT "                        "; parts[j]
  NEXT j
NEXT i
