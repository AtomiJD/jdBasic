' SECRET: password hashes checked against Python's hashlib.pbkdf2_hmac in
' the hex format and Django's pbkdf2_sha256, new hashes, rehash decisions,
' the constant-time compare, tokens and API keys.

IMPORT TESTKIT, SECRET

DIM UML$ = "p" + CHR$(195) + CHR$(164) + "ssw" + CHR$(195) + CHR$(182) + "rd"

FUNC HashWithoutRounds(x)
    RETURN SECRET.HASH$("pw", 0)
ENDFUNC

FUNC TokenOfNothing(x)
    RETURN SECRET.TOKEN$(0)
ENDFUNC

FUNC TokenInOctal(x)
    RETURN SECRET.TOKEN$(8, "octal")
ENDFUNC

TESTKIT.SUITE("hashes made by Python")
DIM py_hex$ = "pbkdf2-sha256$1000$000102030405060708090a0b0c0d0e0f$9a22ca840e451d19c92a54fc9721aefff4f93c89130183b8a180b98523d74f42"
TESTKIT.ISTRUE(SECRET.VERIFY("correct horse", py_hex$), "the hex format")
TESTKIT.ISFALSE(SECRET.VERIFY("correct horsE", py_hex$), "refuses a password one letter off")
TESTKIT.ISTRUE(SECRET.VERIFY("", "pbkdf2-sha256$1$ffffffffffffffffffffffffffffffff$6f0c3310f652c4e88901e422781e3a71d1e5f34062ee050f31ebd64ff3cb9744"), "an empty password with one round")
TESTKIT.ISTRUE(SECRET.VERIFY(UML$, "pbkdf2-sha256$2000$00000000000000000000000000000000$e1765f829ec18b680faede17e52450472b7558cd39437c8bac512db2c5abd718"), "a password with umlauts as UTF-8")
TESTKIT.ISTRUE(SECRET.VERIFY("secret", "pbkdf2_sha256$1000$seasalt$+hs9qSCcGyNSGDNojIEbomuX9WI/mzTF5yfwAXqyKOo="), "Django's format")
TESTKIT.ISTRUE(SECRET.VERIFY("correct horse", "pbkdf2_sha256$870000$abcdefghijklmnopqrstuv$RpUxzrDjtpsLGApqM8e9EVPBnN7Rtb/5aWzlaMR/wTk="), "Django's format with its 870000 rounds")
TESTKIT.ISTRUE(SECRET.VERIFY(UML$, "pbkdf2_sha256$5$saltysalt$TaXzQD2RwskcN8zHtOB2xzbQU65dKQEkF5+cYM6a2IM="), "Django's format with umlauts")
TESTKIT.ISFALSE(SECRET.VERIFY("public", "pbkdf2_sha256$1000$seasalt$+hs9qSCcGyNSGDNojIEbomuX9WI/mzTF5yfwAXqyKOo="), "and a wrong password there")

TESTKIT.SUITE("new hashes")
DIM made$ = SECRET.HASH$("hunter2", 1000)
DIM parts = SPLIT(made$, "$")
TESTKIT.EQ(LEN(parts), 4, "four parts")
DIM scheme$ = parts[0]
DIM rounds$ = parts[1]
DIM salt$ = parts[2]
DIM key$ = parts[3]
TESTKIT.EQ(scheme$, "pbkdf2-sha256", "the scheme")
TESTKIT.EQ(rounds$, "1000", "the rounds asked for")
TESTKIT.EQ(LEN(salt$), 32, "a salt of 32 hex digits")
TESTKIT.EQ(LEN(key$), 64, "a key of 64 hex digits")
TESTKIT.ISTRUE(SECRET.VERIFY("hunter2", made$), "verifies")
TESTKIT.ISFALSE(SECRET.VERIFY("hunter3", made$), "and refuses another password")
TESTKIT.ISTRUE(SECRET.HASH$("hunter2", 1000) <> made$, "the same password hashes differently each time")
DIM slow$ = SECRET.HASH$("pw")
DIM slow_parts = SPLIT(slow$, "$")
DIM slow_rounds$ = slow_parts[1]
TESTKIT.EQ(slow_rounds$, "600000", "600000 rounds by default")
TESTKIT.ISTRUE(SECRET.VERIFY("pw", slow$), "which verify too")
TESTKIT.THROWS(HashWithoutRounds@, 0, "zero rounds are refused")

TESTKIT.SUITE("damaged hashes")
TESTKIT.ISFALSE(SECRET.VERIFY("pw", ""), "an empty text")
TESTKIT.ISFALSE(SECRET.VERIFY("pw", "pbkdf2-sha256$abc$00$" + key$), "rounds that are no number")
TESTKIT.ISFALSE(SECRET.VERIFY("pw", "pbkdf2-sha256$0$" + salt$ + "$" + key$), "zero rounds")
TESTKIT.ISFALSE(SECRET.VERIFY("hunter2", "pbkdf2-sha256$1000$" + salt$ + "$" + LEFT$(key$, 63)), "a key one digit short")
TESTKIT.ISFALSE(SECRET.VERIFY("hunter2", "md5$1000$" + salt$ + "$" + key$), "an unknown scheme")
TESTKIT.ISFALSE(SECRET.VERIFY("hunter2", made$ + "$extra"), "a fifth part")

TESTKIT.SUITE("rehashing")
TESTKIT.ISTRUE(SECRET.NEEDS_REHASH(made$), "1000 rounds are too few for the default")
TESTKIT.ISFALSE(SECRET.NEEDS_REHASH(made$, 1000), "but enough when 1000 are asked for")
TESTKIT.ISFALSE(SECRET.NEEDS_REHASH(slow$), "a hash with the default rounds stays")
TESTKIT.ISTRUE(SECRET.NEEDS_REHASH("pbkdf2_sha256$870000$abcdefghijklmnopqrstuv$RpUxzrDjtpsLGApqM8e9EVPBnN7Rtb/5aWzlaMR/wTk="), "a Django hash moves to the own format")
TESTKIT.ISTRUE(SECRET.NEEDS_REHASH(CODEC.SHA256$("salt:pw")), "and so does a bare SHA-256")
TESTKIT.ISTRUE(SECRET.NEEDS_REHASH("pbkdf2-sha256$600000$abcd$" + key$), "a short salt")

TESTKIT.SUITE("comparison")
TESTKIT.ISTRUE(SECRET.EQUAL("abc", "abc"), "equal texts")
TESTKIT.ISFALSE(SECRET.EQUAL("abc", "abd"), "the last letter differs")
TESTKIT.ISFALSE(SECRET.EQUAL("abc", "abcd"), "a longer text")
TESTKIT.ISTRUE(SECRET.EQUAL("", ""), "two empty texts")
TESTKIT.ISFALSE(SECRET.EQUAL("a" + CHR$(0) + "b", "a" + CHR$(0) + "c"), "a difference after a NUL byte")

TESTKIT.SUITE("tokens")
DIM t1$ = SECRET.TOKEN$()
DIM t2$ = SECRET.TOKEN$()
TESTKIT.EQ(LEN(t1$), 43, "32 bytes are 43 base64url characters")
TESTKIT.ISTRUE(INSTR(t1$ + t2$, "+") < 0 ANDALSO INSTR(t1$ + t2$, "/") < 0 ANDALSO INSTR(t1$ + t2$, "=") < 0, "without + / or =")
TESTKIT.ISTRUE(t1$ <> t2$, "a new one each time")
DIM hex_token$ = SECRET.TOKEN$(16, "hex")
TESTKIT.EQ(LEN(hex_token$), 32, "16 bytes in hex")
TESTKIT.ISTRUE(REGEX.MATCH("[0-9a-f]{32}", hex_token$), "lower-case hex digits")
TESTKIT.EQ(LEN(SECRET.TOKEN$(32, "base64")), 44, "standard base64 keeps its padding")
TESTKIT.THROWS(TokenOfNothing@, 0, "zero bytes are refused")
TESTKIT.THROWS(TokenInOctal@, 0, "an unknown format is refused")

TESTKIT.SUITE("API keys")
DIM api_key$ = SECRET.APIKEY$("jdk")
TESTKIT.EQ(LEFT$(api_key$, 4), "jdk_", "the prefix and an underscore")
TESTKIT.EQ(LEN(api_key$), 47, "before 43 random characters")
TESTKIT.EQ(LEN(SECRET.APIKEY$()), 43, "no prefix, no underscore")
TESTKIT.EQ(SECRET.KEYHASH$("jdk_abc"), "21b88e18c18c6cf99fcb01459a51586dec359fee1d129e74969ed546834a99e2", "KEYHASH$ is the SHA-256 Python gives")
DIM kept$ = SECRET.KEYHASH$(api_key$)
TESTKIT.ISTRUE(SECRET.KEYMATCH(api_key$, kept$), "the key matches its hash")
TESTKIT.ISTRUE(SECRET.KEYMATCH(api_key$, UCASE$(kept$)), "also when the hash was stored in capitals")
TESTKIT.ISFALSE(SECRET.KEYMATCH(api_key$ + "x", kept$), "another key does not")

TESTKIT.REPORT()
