' HTMLDOM: the tolerant parser (unclosed tags, implicit closes, unquoted
' attributes, raw text, entities), the tree, the text and markup of a
' node, every selector form, and the documentation fixture the
' acceptance asks for: its table of contents and its code blocks.

IMPORT TESTKIT, HTMLDOM

DIM NL$ = CHR$(10)
DIM Q$ = CHR$(34)

TESTKIT.SUITE("parsing")
DIM one = HTMLDOM.PARSE("<p>hello</p>")
TESTKIT.EQ(HTMLDOM.SIZE(one), 3, "document, element and text")
TESTKIT.EQ(HTMLDOM.KIND$(one, 0), "document", "node zero is the document")
TESTKIT.EQ(HTMLDOM.KIND$(one, 1), "element", "the element")
TESTKIT.EQ(HTMLDOM.KIND$(one, 2), "text", "the text")
TESTKIT.EQ(HTMLDOM.TAG$(one, 1), "p", "the tag")
TESTKIT.EQ(HTMLDOM.PARENT(one, 2), 1, "the text hangs under the element")
TESTKIT.EQ(JSON.STRINGIFY$(HTMLDOM.CHILDREN(one, 1)), "[2]", "the children of the element")
DIM cased = HTMLDOM.PARSE("<DIV CLASS=Box>x</DIV>")
TESTKIT.EQ(HTMLDOM.TAG$(cased, 1), "div", "a tag is lowered")
TESTKIT.EQ(HTMLDOM.ATTR$(cased, 1, "class"), "Box", "an attribute name is lowered, its value is not")
DIM attrs = HTMLDOM.PARSE("<a href='/x' title=" + Q$ + "T" + Q$ + " data-n=3 hidden>t</a>")
TESTKIT.EQ(HTMLDOM.ATTR$(attrs, 1, "href"), "/x", "a single quoted value")
TESTKIT.EQ(HTMLDOM.ATTR$(attrs, 1, "title"), "T", "a double quoted value")
TESTKIT.EQ(HTMLDOM.ATTR$(attrs, 1, "data-n"), "3", "an unquoted value")
TESTKIT.EQ(HTMLDOM.ATTR$(attrs, 1, "hidden"), "", "a boolean attribute is empty")
TESTKIT.ISTRUE(HTMLDOM.HAS(attrs, 1, "hidden"), "and it is there")
TESTKIT.ISFALSE(HTMLDOM.HAS(attrs, 1, "nope"), "one that is not")
TESTKIT.EQ(HTMLDOM.ATTR$(attrs, 1, "nope", "fallback"), "fallback", "the fallback of a missing attribute")
TESTKIT.EQ(LEN(MAP.KEYS(HTMLDOM.ATTRS(attrs, 1))), 4, "every attribute")
DIM voids = HTMLDOM.PARSE("<p>a<br>b<img src=x.png>c</p>")
TESTKIT.EQ(LEN(HTMLDOM.ELEMENTS(voids, 1)), 2, "a void element takes no children")
TESTKIT.EQ(HTMLDOM.TEXT$(voids, 1), "abc", "the text around them")
TESTKIT.EQ(LEN(HTMLDOM.ELEMENTS(HTMLDOM.PARSE("<div><br/><hr /></div>"), 1)), 2, "self closing tags")
DIM messy = HTMLDOM.PARSE("<!doctype html><!-- note --><div>a < b</div>")
TESTKIT.EQ(HTMLDOM.SIZE(messy), 6, "the doctype is dropped, the comment is a node")
TESTKIT.EQ(HTMLDOM.KIND$(messy, 1), "comment", "the comment")
TESTKIT.EQ(HTMLDOM.TEXT$(messy, HTMLDOM.FIND(messy, "div")), "a < b", "a stray less-than is text")
DIM unclosed = HTMLDOM.PARSE("<div><span>deep")
TESTKIT.EQ(HTMLDOM.TAG$(unclosed, HTMLDOM.PARENT(unclosed, 3)), "span", "what is open at the end is closed")
TESTKIT.EQ(HTMLDOM.TEXT$(unclosed, 1), "deep", "and keeps its text")
DIM stray = HTMLDOM.PARSE("<div>a</span>b</div>")
TESTKIT.EQ(HTMLDOM.TEXT$(stray, HTMLDOM.FIND(stray, "div")), "ab", "a close tag for nothing open is dropped")

TESTKIT.SUITE("implicit closes")
DIM items = HTMLDOM.PARSE("<ul><li>one<li>two<li>three</ul>")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(items, "li")), 3, "three list items")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(items, "li li")), 0, "none inside another")
TESTKIT.EQ(HTMLDOM.FLAT$(items, HTMLDOM.FINDALL(items, "li")[1]), "two", "the second one")
DIM paras = HTMLDOM.PARSE("<div><p>one<p>two</div>")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(paras, "div > p")), 2, "a paragraph ends the one before it")
DIM blocked = HTMLDOM.PARSE("<p>text<h2>heading</h2>")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(blocked, "p h2")), 0, "a block ends an open paragraph")
TESTKIT.EQ(HTMLDOM.FLAT$(blocked, HTMLDOM.FIND(blocked, "p")), "text", "the paragraph keeps its own text")
DIM grid = HTMLDOM.PARSE("<table><tr><td>a<td>b<tr><td>c<td>d</table>")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(grid, "tr")), 2, "two rows")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(grid, "td")), 4, "four cells")
TESTKIT.EQ(HTMLDOM.FLAT$(grid, HTMLDOM.FINDALL(grid, "tr")[1]), "cd", "the second row")
DIM terms = HTMLDOM.PARSE("<dl><dt>a<dd>one<dt>b<dd>two</dl>")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(terms, "dl > dt")), 2, "terms and definitions end each other")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(terms, "dl > dd")), 2, "both of them")

TESTKIT.SUITE("raw text")
DIM scripted = HTMLDOM.PARSE("<script>if (a < b) { s = '</b>'; }</script><p>after</p>")
TESTKIT.EQ(HTMLDOM.TEXT$(scripted, HTMLDOM.FIND(scripted, "script")), "if (a < b) { s = '</b>'; }", "a script keeps its markup as text")
TESTKIT.EQ(HTMLDOM.FLAT$(scripted, HTMLDOM.FIND(scripted, "p")), "after", "and the page goes on")
DIM styled = HTMLDOM.PARSE("<style>a > b { color: red }</style>")
TESTKIT.EQ(HTMLDOM.TEXT$(styled, 1), "a > b { color: red }", "a style keeps its rules")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(styled, "b")), 0, "nothing inside it is an element")

TESTKIT.SUITE("entities")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("a &amp; b"), "a & b", "the ampersand")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("&lt;tag&gt;"), "<tag>", "the angle brackets")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("&quot;q&quot; &apos;a&apos;"), Q$ + "q" + Q$ + " 'a'", "the quotes")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("one&nbsp;two"), "one two", "a non-breaking space becomes a plain one")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("a&mdash;b &hellip;"), "a-b ...", "the dash and the ellipsis have plain forms")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("&#65;&#x42;"), "AB", "decimal and hexadecimal")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("&#233;"), CHR$(195) + CHR$(169), "a code point above ASCII comes out as UTF-8")
TESTKIT.EQ(LEN(HTMLDOM.UNESCAPE$("&rsaquo;")), 3, "and a three byte one as three bytes")
TESTKIT.EQ(HTMLDOM.UNESCAPE$("&nope; & plain"), "&nope; & plain", "an unknown entity and a bare ampersand stay")
TESTKIT.EQ(HTMLDOM.TEXT$(HTMLDOM.PARSE("<p>5 &lt; 6</p>"), 1), "5 < 6", "text is decoded while parsing")
TESTKIT.EQ(HTMLDOM.ATTR$(HTMLDOM.PARSE("<a title='a &amp; b'>x</a>"), 1, "title"), "a & b", "an attribute value too")
TESTKIT.EQ(HTMLDOM.ESCAPE$("<a href=" + Q$ + "x" + Q$ + ">&</a>"), "&lt;a href=&quot;x&quot;&gt;&amp;&lt;/a&gt;", "and back again")

TESTKIT.SUITE("text and markup")
DIM rich = HTMLDOM.PARSE("<div> <p>One <em>two</em>  three</p> <!-- x --> </div>")
TESTKIT.EQ(HTMLDOM.TEXT$(rich, HTMLDOM.FIND(rich, "p")), "One two  three", "the text of a subtree")
TESTKIT.EQ(HTMLDOM.FLAT$(rich, HTMLDOM.FIND(rich, "p")), "One two three", "the same squeezed to one line")
TESTKIT.EQ(HTMLDOM.INNER$(rich, HTMLDOM.FIND(rich, "p")), "One <em>two</em>  three", "the markup inside")
TESTKIT.EQ(HTMLDOM.HTML$(rich, HTMLDOM.FIND(rich, "em")), "<em>two</em>", "the markup of a node")
TESTKIT.EQ(HTMLDOM.HTML$(HTMLDOM.PARSE("<img src=a.png alt='&lt;x&gt;'>"), 1), "<img src=" + Q$ + "a.png" + Q$ + " alt=" + Q$ + "&lt;x&gt;" + Q$ + " />", "a void element and an escaped value")
TESTKIT.EQ(HTMLDOM.TEXT$(rich, HTMLDOM.FIND(rich, "div")), " One two  three  ", "a comment carries no text")

TESTKIT.SUITE("selectors")
DIM page = HTMLDOM.PARSE("<body><nav class='toc side'><ul id=list><li class=item><a href='#a' rel=x>A</a></li><li class='item last'><a href='/b'>B</a></li></ul></nav><main><p class=item>P</p><span>S</span></main></body>")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "a")), 2, "by tag")
TESTKIT.EQ(HTMLDOM.TAG$(page, HTMLDOM.FIND(page, "#list")), "ul", "by id")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, ".item")), 3, "by class")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "li.item.last")), 1, "by two classes")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "nav.toc")), 1, "a class of several")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "nav a")), 2, "a descendant")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "ul > a")), 0, "a direct child that is not one")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "li > a")), 2, "a direct child that is")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "*")), 10, "every element")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "[rel]")), 1, "an attribute that is there")
TESTKIT.EQ(HTMLDOM.PICK$(page, "a[href='/b']"), "B", "an attribute with a value")
TESTKIT.EQ(HTMLDOM.PICK$(page, "a[href^=#]"), "A", "a value that starts with")
TESTKIT.EQ(HTMLDOM.PICK$(page, "a[href$=b]"), "B", "one that ends with")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "[class*=ite]")), 3, "one that contains")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "[class~=last]")), 1, "one word of a list")
TESTKIT.EQ(HTMLDOM.PICK$(page, "li:nth-child(2) a"), "B", "the second child")
TESTKIT.EQ(HTMLDOM.PICK$(page, "li:first-child a"), "A", "the first child")
TESTKIT.EQ(HTMLDOM.PICK$(page, "li:last-child a"), "B", "the last child")
TESTKIT.EQ(HTMLDOM.PICK$(page, "main p:nth-of-type(1)"), "P", "the first of its type")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "p, span")), 2, "two selectors at once")
TESTKIT.EQ(JSON.STRINGIFY$(HTMLDOM.FINDALL(page, "span, p")), JSON.STRINGIFY$(HTMLDOM.FINDALL(page, "p, span")), "a group answers in document order")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(page, "a", HTMLDOM.FIND(page, "li.last"))), 1, "a search under one node")
TESTKIT.ISTRUE(HTMLDOM.MATCHES(page, HTMLDOM.FIND(page, "a"), "nav li > a[href^=#]"), "one node against a chain")
TESTKIT.ISFALSE(HTMLDOM.MATCHES(page, HTMLDOM.FIND(page, "a"), "main a"), "and against one it does not match")
TESTKIT.EQ(HTMLDOM.FIND(page, "table"), -1, "nothing found is -1")
TESTKIT.EQ(HTMLDOM.PICK$(page, "table", "none"), "none", "and PICK$ answers its fallback")

TESTKIT.SUITE("the documentation page")
DIM base$ = "tests/jdlibs/fixtures/"
IF NOT FILE.EXISTS(base$ + "docpage.html") THEN base$ = "fixtures/"
DIM doc = HTMLDOM.PARSEFILE(base$ + "docpage.html")
TESTKIT.EQ(HTMLDOM.PICK$(doc, "title"), "Arrays & matrices - jdBasic docs", "the title, entities and all")
TESTKIT.EQ(HTMLDOM.PICK$(doc, "main h1"), "Arrays & matrices", "the heading")
TESTKIT.EQ(HTMLDOM.ATTR$(doc, HTMLDOM.FIND(doc, "body"), "data-version"), "1.0.33", "an unquoted attribute of the body")
TESTKIT.EQ(HTMLDOM.PICK$(doc, "nav.crumbs"), "Docs " + CHR$(226) + CHR$(128) + CHR$(186) + " Arrays", "a UTF-8 entity in the crumbs")

DIM toc = HTMLDOM.FINDALL(doc, "nav.toc a")
TESTKIT.EQ(LEN(toc), 6, "six entries in the table of contents")
DIM targets = []
DIM titles = []
DIM i = 0
FOR i = 0 TO LEN(toc) - 1
    PUSH(targets, HTMLDOM.ATTR$(doc, toc[i], "href"))
    PUSH(titles, HTMLDOM.FLAT$(doc, toc[i]))
NEXT i
TESTKIT.EQ(JOIN(targets, " "), "#shapes #slicing #slicing-rows #slicing-cells #reducers #pitfalls", "their targets, in document order")
TESTKIT.EQ(JOIN(titles, " | "), "Shapes and ranks | Slicing | Rows | Cells | Reducers | Pitfalls", "their titles")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "nav.toc > ul > li")), 4, "four at the top level")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "nav.toc ul ul li")), 2, "two one level down")
DIM sections = []
DIM heads = HTMLDOM.FINDALL(doc, "h2[id]")
FOR i = 0 TO LEN(heads) - 1
    PUSH(sections, "#" + HTMLDOM.ATTR$(doc, heads[i], "id"))
NEXT i
TESTKIT.EQ(JOIN(sections, " "), "#shapes #slicing #reducers #pitfalls", "every section the contents point at exists")

DIM blocks = HTMLDOM.FINDALL(doc, "pre > code")
TESTKIT.EQ(LEN(blocks), 3, "three code blocks")
DIM langs = []
DIM lines = []
FOR i = 0 TO LEN(blocks) - 1
    PUSH(langs, HTMLDOM.ATTR$(doc, blocks[i], "class"))
    PUSH(lines, STR$(LEN(SPLIT(TRIM$(HTMLDOM.TEXT$(doc, blocks[i])), NL$))))
NEXT i
TESTKIT.EQ(JOIN(langs, " "), "language-basic language-basic language-basic", "each one names its language")
TESTKIT.EQ(JOIN(lines, " "), "3 2 2", "and carries its lines")
TESTKIT.EQ(SPLIT(HTMLDOM.TEXT$(doc, blocks[0]), NL$)[0], "DIM v = IOTA(5)", "the first line of the first block")
TESTKIT.EQ(SPLIT(HTMLDOM.TEXT$(doc, blocks[1]), NL$)[1], "PRINT row[0] <= row[1]", "an escaped operator inside a block")
TESTKIT.ISTRUE(INSTR(HTMLDOM.TEXT$(doc, blocks[2]), "MAX([a, b])") >= 0, "and the brackets of the third")

TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "table.grid tbody tr")), 3, "the rows of the table")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "table.grid thead th")), 3, "its headers")
TESTKIT.EQ(HTMLDOM.PICK$(doc, "table.grid tbody tr:nth-child(2) td:nth-child(2)"), "a cell", "a cell by position")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "dl dt")), 2, "the terms of the list")
TESTKIT.EQ(HTMLDOM.PICK$(doc, "dl dd"), "A bare assignment may share storage; force a copy element by element.", "the first definition")
TESTKIT.EQ(HTMLDOM.ATTR$(doc, HTMLDOM.FIND(doc, "main img"), "alt"), "A 5 by 1 matrix", "the image")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "form input")), 2, "the inputs of the form")
TESTKIT.ISTRUE(HTMLDOM.HAS(doc, HTMLDOM.FIND(doc, "input[type=checkbox]"), "disabled"), "a boolean attribute of one")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "a[href^=/]")), 3, "the links that are absolute")
TESTKIT.EQ(HTMLDOM.PICK$(doc, "footer p"), "(c) 2026 jdBasic - the docs are CC BY 4.0. Built 12.09.2026.", "the footer")
TESTKIT.EQ(HTMLDOM.FLAT$(doc, HTMLDOM.FINDALL(doc, "footer p")[1]), "5 < 6 and 6 > 5 are both true.", "its second line")
TESTKIT.EQ(LEN(HTMLDOM.FINDALL(doc, "script")), 2, "both scripts")
TESTKIT.ISTRUE(INSTR(HTMLDOM.TEXT$(doc, HTMLDOM.FIND(doc, "script")), "3 < 4") >= 0, "the first keeps its comparison")
TESTKIT.EQ(HTMLDOM.ATTR$(doc, HTMLDOM.FINDALL(doc, "script")[1], "src"), "/static/doc.js", "the second is only a source")
TESTKIT.ISTRUE(INSTR(HTMLDOM.TEXT$(doc, HTMLDOM.FIND(doc, "style")), "pre > code") >= 0, "the stylesheet keeps its selector")

TESTKIT.REPORT()
