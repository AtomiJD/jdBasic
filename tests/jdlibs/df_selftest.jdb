' DF: frames built four ways, shape and access, slicing, column and row
' operations, sorting, grouping, joins, pivots, summaries, CSV round
' trips, text output, and the workshop sales set timed on the way
' through load, group and sort.

IMPORT TESTKIT, DF, CONSOLE

DIM NL$ = CHR$(10)
CONSOLE.PLAIN(TRUE)

DIM sales = DF.FROM([["north", "widget", 3, 9.5], ["south", "gadget", 1, 20], ["north", "gadget", 2, 20], ["west", "widget", 5, 9.5]], ["region", "product", "qty", "price"])

TESTKIT.SUITE("construction")
TESTKIT.EQ(JSON.STRINGIFY$(DF.NAMES(sales)), "[" + CHR$(34) + "region" + CHR$(34) + "," + CHR$(34) + "product" + CHR$(34) + "," + CHR$(34) + "qty" + CHR$(34) + "," + CHR$(34) + "price" + CHR$(34) + "]", "names from a matrix")
TESTKIT.EQ(DF.NROWS(sales), 4, "four rows")
TESTKIT.EQ(DF.NCOLS(sales), 4, "four columns")
TESTKIT.EQ(JSON.STRINGIFY$(DF.SHAPE(sales)), "[4,4]", "the shape")
DIM ragged = DF.FROM([[1, 2], [3]], ["a", "b"])
TESTKIT.EQ(TYPEOF(DF.COL(ragged, "b")[1]), "NONE", "a short row is padded with NONE")
DIM from_rows = DF.FROMROWS([{"a": 1, "b": "x"}, {"a": 2, "c": TRUE}])
TESTKIT.EQ(JSON.STRINGIFY$(DF.NAMES(from_rows)), "[" + CHR$(34) + "a" + CHR$(34) + "," + CHR$(34) + "b" + CHR$(34) + "," + CHR$(34) + "c" + CHR$(34) + "]", "row maps give the union of keys")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(from_rows, "a")), "[1,2]", "a column from row maps")
TESTKIT.EQ(TYPEOF(DF.COL(from_rows, "c")[0]), "NONE", "a missing key is NONE")
DIM from_cols = DF.FROMCOLS({"x": [1, 2, 3], "y": ["a", "b", "c"]})
TESTKIT.EQ(DF.NROWS(from_cols), 3, "rows from a column map")
TESTKIT.EQ(DF.COL(from_cols, "y")[2], "c", "a string column from a column map")

TESTKIT.SUITE("access")
TESTKIT.ISTRUE(DF.HAS(sales, "qty"), "a column that exists")
TESTKIT.ISFALSE(DF.HAS(sales, "revenue"), "a column that does not")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(sales, "qty")), "[3,1,2,5]", "a numeric column")
TESTKIT.EQ(DF.COL(sales, "region")[3], "west", "a string column")
DIM second = DF.ROW(sales, 1)
TESTKIT.EQ(second{"product"}, "gadget", "a row as a map")
TESTKIT.EQ(second{"price"}, 20, "a row map holds numbers")
TESTKIT.EQ(LEN(DF.ROWS(sales)), 4, "every row as a map")
TESTKIT.EQ(DF.ROWS(sales)[2]{"qty"}, 2, "the third row map")
DIM m = DF.MATRIX(sales)
TESTKIT.EQ(LEN(m), 4, "the matrix has one row per row")
TESTKIT.EQ(m[3][0], "west", "the matrix keeps strings")
TESTKIT.EQ(m[0][2], 3, "the matrix keeps numbers")
FUNC UnknownColumn(df)
    RETURN DF.COL(df, "nope")
ENDFUNC
TESTKIT.THROWS(UnknownColumn@, sales, "an unknown column throws")

TESTKIT.SUITE("slicing")
TESTKIT.EQ(DF.NROWS(DF.HEAD(sales, 2)), 2, "head")
TESTKIT.EQ(DF.COL(DF.HEAD(sales, 2), "region")[1], "south", "head keeps the first rows")
TESTKIT.EQ(DF.NROWS(DF.HEAD(sales)), 4, "head of a short frame is the frame")
TESTKIT.EQ(DF.NROWS(DF.TAIL(sales, 3)), 3, "tail")
TESTKIT.EQ(DF.COL(DF.TAIL(sales, 3), "region")[0], "south", "tail keeps the last rows")
DIM middle = DF.SLICE(sales, 1, 2)
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(middle, "qty")), "[1,2]", "a slice from an index")
TESTKIT.EQ(DF.NROWS(DF.SLICE(sales, 2)), 2, "a slice without a count runs to the end")
TESTKIT.EQ(DF.NROWS(DF.SLICE(sales, 9)), 0, "a slice past the end is empty")

TESTKIT.SUITE("columns")
DIM with_rev = DF.WITH(sales, "revenue", DF.COL(sales, "qty") * DF.COL(sales, "price"))
TESTKIT.EQ(DF.NCOLS(with_rev), 5, "a column is added")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(with_rev, "revenue")), "[28.5,20,40,47.5]", "the added values")
TESTKIT.EQ(DF.NCOLS(sales), 4, "the source frame is untouched")
FUNC Doubled(row)
    RETURN row{"qty"} * 2
ENDFUNC
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(DF.WITH(sales, "twice", Doubled@), "twice")), "[6,2,4,10]", "a column computed from each row")
DIM replaced = DF.WITH(sales, "qty", [7, 8, 9, 10])
TESTKIT.EQ(DF.NCOLS(replaced), 4, "an existing name is replaced")
TESTKIT.EQ(DF.COL(replaced, "qty")[0], 7, "with the new values")
FUNC ShortColumn(df)
    RETURN DF.WITH(df, "bad", [1, 2])
ENDFUNC
TESTKIT.THROWS(ShortColumn@, sales, "a column of the wrong length throws")
DIM picked = DF.SELECT(sales, ["price", "region"])
TESTKIT.EQ(JSON.STRINGIFY$(DF.NAMES(picked)), "[" + CHR$(34) + "price" + CHR$(34) + "," + CHR$(34) + "region" + CHR$(34) + "]", "select keeps the order asked for")
TESTKIT.EQ(DF.NCOLS(DF.SELECT(sales, "qty")), 1, "select with one name")
DIM dropped = DF.DROP(sales, ["price", "product"])
TESTKIT.EQ(JSON.STRINGIFY$(DF.NAMES(dropped)), "[" + CHR$(34) + "region" + CHR$(34) + "," + CHR$(34) + "qty" + CHR$(34) + "]", "drop removes columns")
TESTKIT.EQ(DF.NCOLS(DF.DROP(sales, "qty")), 3, "drop with one name")
DIM renamed = DF.RENAME(sales, "qty", "amount")
TESTKIT.ISTRUE(DF.HAS(renamed, "amount"), "renamed")
TESTKIT.ISFALSE(DF.HAS(renamed, "qty"), "the old name is gone")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(renamed, "amount")), "[3,1,2,5]", "the values ride along")

TESTKIT.SUITE("rows")
DIM cheap = DF.WHERE(sales, DF.COL(sales, "price") < 10)
TESTKIT.EQ(DF.NROWS(cheap), 2, "where with a mask")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(cheap, "region")), "[" + CHR$(34) + "north" + CHR$(34) + "," + CHR$(34) + "west" + CHR$(34) + "]", "the rows the mask selects")
FUNC Big(row)
    RETURN row{"qty"} >= 3
ENDFUNC
DIM big = DF.FILTER(sales, Big@)
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(big, "qty")), "[3,5]", "filter with a predicate")
DIM by_qty = DF.SORT(sales, "qty")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(by_qty, "qty")), "[1,2,3,5]", "sort ascending")
TESTKIT.EQ(DF.COL(by_qty, "region")[0], "south", "the other columns follow")
DIM by_qty_desc = DF.SORT(sales, "qty", TRUE)
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(by_qty_desc, "qty")), "[5,3,2,1]", "sort descending")
DIM by_region = DF.SORT(sales, "region")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(by_region, "region")), "[" + CHR$(34) + "north" + CHR$(34) + "," + CHR$(34) + "north" + CHR$(34) + "," + CHR$(34) + "south" + CHR$(34) + "," + CHR$(34) + "west" + CHR$(34) + "]", "sort by a string column")
TESTKIT.EQ(JSON.STRINGIFY$(DF.DISTINCT(sales, "product")), "[" + CHR$(34) + "widget" + CHR$(34) + "," + CHR$(34) + "gadget" + CHR$(34) + "]", "distinct values in first-seen order")

TESTKIT.SUITE("groupby")
DIM g = DF.GROUPBY(with_rev, "region", {"revenue": ["sum", "revenue"], "orders": ["count"], "biggest": ["max", "qty"], "avg_price": ["mean", "price"]})
TESTKIT.EQ(JSON.STRINGIFY$(DF.NAMES(g)), "[" + CHR$(34) + "region" + CHR$(34) + "," + CHR$(34) + "revenue" + CHR$(34) + "," + CHR$(34) + "orders" + CHR$(34) + "," + CHR$(34) + "biggest" + CHR$(34) + "," + CHR$(34) + "avg_price" + CHR$(34) + "]", "the key first, then the outputs")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g, "region")), "[" + CHR$(34) + "north" + CHR$(34) + "," + CHR$(34) + "south" + CHR$(34) + "," + CHR$(34) + "west" + CHR$(34) + "]", "groups in first-seen order")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g, "revenue")), "[68.5,20,47.5]", "sum per group")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g, "orders")), "[2,1,1]", "count per group")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g, "biggest")), "[3,1,5]", "max per group")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g, "avg_price")), "[14.75,20,9.5]", "mean per group")
DIM g2 = DF.GROUPBY(sales, ["region", "product"], {"qty": ["sum", "qty"], "first_price": ["first", "price"], "last_price": ["last", "price"]})
TESTKIT.EQ(DF.NROWS(g2), 4, "two keys make four groups here")
TESTKIT.EQ(DF.COL(g2, "product")[1], "gadget", "the second key column")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g2, "qty")), "[3,1,2,5]", "sum with two keys")
TESTKIT.EQ(DF.COL(g2, "first_price")[0], 9.5, "first per group")
TESTKIT.EQ(DF.COL(g2, "last_price")[0], 9.5, "last per group")
DIM g3 = DF.GROUPBY(sales, "product", {"lowest": ["min", "price"], "middle": ["median", "qty"], "spread": ["stdev", "qty"]})
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g3, "lowest")), "[9.5,20]", "min per group")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(g3, "middle")), "[4,1.5]", "median per group")
TESTKIT.EQ(DF.COL(g3, "spread")[0], 1, "stdev per group")
FUNC UnknownAggregation(df)
    RETURN DF.GROUPBY(df, "region", {"x": ["mode", "qty"]})
ENDFUNC
TESTKIT.THROWS(UnknownAggregation@, sales, "an unknown aggregation throws")

TESTKIT.SUITE("join")
DIM colours = DF.FROM([["widget", "blue"], ["gadget", "red"], ["gizmo", "green"]], ["product", "colour"])
DIM inner = DF.JOIN(sales, colours, "product")
TESTKIT.EQ(DF.NROWS(inner), 4, "inner join keeps the matching rows")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(inner, "colour")), "[" + CHR$(34) + "blue" + CHR$(34) + "," + CHR$(34) + "red" + CHR$(34) + "," + CHR$(34) + "red" + CHR$(34) + "," + CHR$(34) + "blue" + CHR$(34) + "]", "the joined column")
TESTKIT.EQ(DF.NCOLS(inner), 5, "the key is not repeated")
DIM stock = DF.FROM([["widget", 10]], ["item", "on_hand"])
DIM left = DF.JOIN(sales, stock, ["product", "item"], "left")
TESTKIT.EQ(DF.NROWS(left), 4, "left join keeps every left row")
TESTKIT.EQ(DF.COL(left, "on_hand")[0], 10, "a match fills the value")
TESTKIT.EQ(TYPEOF(DF.COL(left, "on_hand")[1]), "NONE", "no match is NONE")
DIM inner2 = DF.JOIN(sales, stock, ["product", "item"])
TESTKIT.EQ(DF.NROWS(inner2), 2, "inner join with differently named keys")
DIM clash = DF.FROM([["widget", 1]], ["product", "qty"])
DIM joined = DF.JOIN(sales, clash, "product")
TESTKIT.ISTRUE(DF.HAS(joined, "qty_b"), "a shared name gets the suffix")

TESTKIT.SUITE("pivot")
DIM p = DF.PIVOT(sales, "region", "product", "qty")
TESTKIT.EQ(JSON.STRINGIFY$(DF.NAMES(p)), "[" + CHR$(34) + "region" + CHR$(34) + "," + CHR$(34) + "widget" + CHR$(34) + "," + CHR$(34) + "gadget" + CHR$(34) + "]", "one column per distinct value")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(p, "widget")), "[3,null,5]", "an empty cell is NONE")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(p, "gadget")), "[2,1,null]", "the other column")
DIM p2 = DF.PIVOT(with_rev, "product", "region", "revenue", "count")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(p2, "north")), "[1,1]", "a count pivot")

TESTKIT.SUITE("describe")
DIM d = DF.DESCRIBE(with_rev)
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(d, "column")), "[" + CHR$(34) + "qty" + CHR$(34) + "," + CHR$(34) + "price" + CHR$(34) + "," + CHR$(34) + "revenue" + CHR$(34) + "]", "only the numeric columns")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(d, "count")), "[4,4,4]", "count")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(d, "min")), "[1,9.5,20]", "min")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(d, "max")), "[5,20,47.5]", "max")
TESTKIT.EQ(DF.COL(d, "mean")[0], 2.75, "mean")
TESTKIT.NEAR(DF.COL(d, "stdev")[0], 1.479020, 0.00001, "stdev")

TESTKIT.SUITE("csv")
DIM path$ = MKTEMP$("df") + ".csv"
DF.WRITECSV(with_rev, path$)
DIM back = DF.READCSV(path$)
TESTKIT.EQ(JSON.STRINGIFY$(DF.NAMES(back)), JSON.STRINGIFY$(DF.NAMES(with_rev)), "the header comes back")
TESTKIT.EQ(DF.NROWS(back), 4, "every row comes back")
TESTKIT.EQ(DF.COL(back, "region")[1], "south", "strings come back as strings")
TESTKIT.EQ(DF.COL(back, "revenue")[3], 47.5, "numbers come back as numbers")
DF.WRITECSV(with_rev, path$, ";")
DIM back2 = DF.READCSV(path$, ";")
TESTKIT.EQ(DF.NCOLS(back2), 5, "another delimiter")
KILL path$

TESTKIT.SUITE("text")
DIM text$ = DF.TEXT$(sales)
DIM lines = SPLIT(text$, NL$)
TESTKIT.EQ(LEN(lines), 8, "a table with a header rule, four rows and a frame")
TESTKIT.EQ(lines[1], "| region | product | qty | price |", "the header line")
TESTKIT.EQ(lines[3], "| north  | widget  |   3 |   9.5 |", "numbers right aligned, text left")
DIM short$ = DF.TEXT$(sales, 2)
TESTKIT.EQ(RIGHT$(short$, 11), "2 more rows", "a row limit says what is left")
DIM md$ = DF.TEXT$(sales, 0, {"border": "markdown"})
TESTKIT.EQ(LEFT$(md$, 10), "| region |", "table options pass through")

TESTKIT.SUITE("workshop")
DIM regions = ["north", "south", "east", "west"]
DIM products = ["widget", "gadget", "gizmo"]
DIM rows = []
DIM i = 0
FOR i = 0 TO 19999
    PUSH(rows, [regions[i MOD 4], products[(i * 7) MOD 3], (i MOD 13) + 1, ((i * 37) MOD 1000) / 10, "2026-" + LPAD$(STR$((i MOD 12) + 1), 2, "0") + "-15"])
NEXT i
DIM big_path$ = MKTEMP$("dfsales") + ".csv"
CSVWRITER big_path$, rows, ",", ["region", "product", "qty", "price", "date"]
DIM t0 = TICK()
DIM big_sales = DF.READCSV(big_path$)
DIM t1 = TICK()
big_sales = DF.WITH(big_sales, "revenue", DF.COL(big_sales, "qty") * DF.COL(big_sales, "price"))
DIM t2 = TICK()
DIM per_region = DF.GROUPBY(big_sales, "region", {"revenue": ["sum", "revenue"], "orders": ["count"]})
DIM t3 = TICK()
DIM ranked = DF.SORT(big_sales, "revenue", TRUE)
DIM t4 = TICK()
KILL big_path$
TESTKIT.EQ(JSON.STRINGIFY$(DF.SHAPE(big_sales)), "[20000,6]", "the sales set loads")
TESTKIT.EQ(DF.NROWS(per_region), 4, "four regions")
TESTKIT.EQ(JSON.STRINGIFY$(DF.COL(per_region, "orders")), "[5000,5000,5000,5000]", "five thousand orders each")
TESTKIT.NEAR(SUM(DF.COL(per_region, "revenue")), SUM(DF.COL(big_sales, "revenue")), 0.01, "the group sums add up to the total")
TESTKIT.EQ(DF.COL(ranked, "revenue")[0], 1298.7, "the biggest order first")
PRINT "  timing: load "; ROUND(t1 - t0); " ms, revenue column "; ROUND(t2 - t1); " ms, groupby region "; ROUND(t3 - t2); " ms, sort "; ROUND(t4 - t3); " ms"

TESTKIT.REPORT()
