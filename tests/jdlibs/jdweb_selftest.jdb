' JDWEB: routes with parameters, method dispatch and 405, middleware before
' and after, error and missing pages, in-memory sessions, static files and
' JSON, driven through JDWEB.FETCH against a server in this process; the
' dispatcher called directly with request maps; then the page and
' cookie-login helpers jdTrakr is built on.
'
' The served suites run interpreted, and compiled when JDWEB_TEST_SERVER is
' set.

IMPORT TESTKIT, JDWEB

DIM PORT = 9983
DIM Q$ = CHR$(34)
DIM base$ = "tests/jdlibs/fixtures/"
IF NOT FILE.EXISTS(base$ + "jdweb_static/hello.txt") THEN base$ = "fixtures/"
DIM tpl$ = "jdb/demos/web/jdweb_tpl"
IF NOT FILE.EXISTS(tpl$ + "/layout.html") THEN tpl$ = "../../jdb/demos/web/jdweb_tpl"
DIM gArgs = OS.ARGS()
DIM gScript$ = gArgs[0]
DIM gServed = (LCASE$(RIGHT$(gScript$, 4)) = ".jdb") ORELSE GETENV$("JDWEB_TEST_SERVER") <> ""

FUNC ShowUser(request)
    DIM id$ = JDWEB.PARAM$(request, "id")
    RETURN {"id": id$}
ENDFUNC

FUNC CreateUser(request)
    DIM sent = JSON.PARSE$(request{"BODY"})
    DIM name$ = sent{"name"}
    RETURN JDWEB.REPLY_JSON({"created": name$}, 201)
ENDFUNC

FUNC DeleteUser(request)
    RETURN JDWEB.REPLY("", 204, "text/plain")
ENDFUNC

FUNC Files(request)
    RETURN "path=" + JDWEB.PARAM$(request, "path")
ENDFUNC

FUNC Hello(request)
    RETURN "<h1>hello " + JDWEB.PARAM$(request, "name") + "</h1>"
ENDFUNC

FUNC Boom(request)
    THROW "broken on purpose"
    RETURN ""
ENDFUNC

FUNC Counter(request)
    DIM sess = JDWEB.SESSION(request)
    DIM n = 0
    IF MAP.EXISTS(sess, "count") THEN n = sess{"count"}
    n = n + 1
    sess{"count"} = n
    RETURN {"count": n}
ENDFUNC

FUNC Logout(request)
    JDWEB.SESSION_END(request)
    RETURN {"ok": TRUE}
ENDFUNC

FUNC Admin(request)
    RETURN "admin area"
ENDFUNC

FUNC Anything(request)
    DIM method$ = request{"METHOD"}
    RETURN "any " + method$
ENDFUNC

FUNC Guard(request)
    DIM p$ = request{"PATH"}
    IF LEFT$(p$, 6) = "/admin" THEN
        DIM hs = request{"HEADERS"}
        IF NOT MAP.EXISTS(hs, "x-key") THEN RETURN JDWEB.REPLY("no key", 401, "text/plain")
    ENDIF
    RETURN JDWEB.PASS()
ENDFUNC

FUNC Stamp(request)
    RETURN {"X-Served-By": "jdweb", "X-Status": STR$(JDWEB.CURRENT_STATUS())}
ENDFUNC

FUNC Missing(request)
    DIM p$ = request{"PATH"}
    RETURN "<p>nothing at " + p$ + "</p>"
ENDFUNC

FUNC Failed(request)
    DIM message$ = JDWEB.ERROR_MESSAGE$()
    RETURN JDWEB.REPLY_JSON({"error": message$}, 500)
ENDFUNC

FUNC HeaderOf$(response, name$)
    DIM hs = response{"headers"}
    IF NOT MAP.EXISTS(hs, name$) THEN RETURN ""
    DIM v$ = hs{name$}
    RETURN v$
ENDFUNC

FUNC Themed(request)
    DIM sess = JDWEB.SESSION(request)
    sess{"theme"} = "dark"
    DIM answer = JDWEB.REPLY("themed", 200, "text/plain")
    RETURN JDWEB.HEADER(answer, "Set-Cookie", "theme=dark; Path=/")
ENDFUNC

FUNC Rotated(request)
    DIM sess = JDWEB.SESSION_ROTATE(request)
    DIM n = 0
    IF MAP.EXISTS(sess, "count") THEN n = sess{"count"}
    RETURN {"count": n}
ENDFUNC

FUNC FormPage(request)
    RETURN JDWEB.CSRF_TOKEN$(request)
ENDFUNC

FUNC Saved(request)
    RETURN "saved"
ENDFUNC

FUNC ApiWrite(request)
    RETURN "api ok"
ENDFUNC

FUNC SetFlash(request)
    JDWEB.FLASH(request, "note saved")
    JDWEB.FLASH(request, "check the date", "warning")
    RETURN JDWEB.REDIRECT_TO("/shown")
ENDFUNC

FUNC ShowFlash(request)
    DIM items = JDWEB.FLASHES(request)
    DIM texts$ = ""
    DIM k = 0
    FOR k = 0 TO LEN(items) - 1
        DIM item = items[k]
        DIM kind$ = item{"kind"}
        DIM text$ = item{"text"}
        texts$ = texts$ + kind$ + ":" + text$ + ";"
    NEXT k
    RETURN texts$
ENDFUNC

FUNC BadSetting(x)
    JDWEB.SESSION_CONFIG({"tll": 1})
    RETURN 0
ENDFUNC

' A request map for DISPATCH: sid$ goes in the session cookie, token$ in the
' X-CSRF-Token header and form$ is sent as a form body; "" leaves each out.
FUNC Ask(method$, path$, sid$, token$, form$)
    DIM hs AS MAP
    DIM no_params AS MAP
    IF sid$ <> "" THEN hs{"cookie"} = "jdwsid=" + sid$
    IF token$ <> "" THEN hs{"x-csrf-token"} = token$
    IF form$ <> "" THEN hs{"content-type"} = "application/x-www-form-urlencoded"
    RETURN {"METHOD": method$, "PATH": path$, "HEADERS": hs, "PARAMS": no_params, "BODY": form$}
ENDFUNC

' The Set-Cookie line a DISPATCH answer carries for a cookie, or "".
FUNC SetCookieOf$(response, name$)
    DIM hs = response{"__http_headers"}
    IF NOT MAP.EXISTS(hs, "Set-Cookie") THEN RETURN ""
    DIM raw = hs{"Set-Cookie"}
    IF TYPEOF(raw) = "ARRAY" THEN
        DIM k = 0
        FOR k = 0 TO LEN(raw) - 1
            DIM each$ = raw[k]
            IF LEFT$(each$, LEN(name$) + 1) = name$ + "=" THEN RETURN each$
        NEXT k
        RETURN ""
    ENDIF
    DIM one$ = raw
    IF LEFT$(one$, LEN(name$) + 1) = name$ + "=" THEN RETURN one$
    RETURN ""
ENDFUNC

FUNC SidOf$(line$)
    DIM eq = CINT(INSTR(line$, "="))
    DIM semi = CINT(INSTR(line$, ";"))
    IF eq < 0 ORELSE semi < 0 THEN RETURN ""
    RETURN MID$(line$, eq + 1, semi - eq - 1)
ENDFUNC

FUNC CountOf(response)
    DIM body$ = response{"__http_body"}
    DIM parsed = JSON.PARSE$(body$)
    DIM n = parsed{"count"}
    RETURN n
ENDFUNC

JDWEB.GET("/themed", Themed@)
JDWEB.GET("/rotate", Rotated@)
JDWEB.GET("/form", FormPage@)
JDWEB.POST("/save", Saved@)
JDWEB.POST("/api/write", ApiWrite@)
JDWEB.GET("/flash", SetFlash@)
JDWEB.GET("/shown", ShowFlash@)
JDWEB.GET("/users/:id", ShowUser@)
JDWEB.POST("/users", CreateUser@)
JDWEB.DELETE("/users/:id", DeleteUser@)
JDWEB.GET("/files/*path", Files@)
JDWEB.GET("/hello", Hello@)
JDWEB.GET("/boom", Boom@)
JDWEB.GET("/count", Counter@)
JDWEB.POST("/logout", Logout@)
JDWEB.GET("/admin", Admin@)
JDWEB.ANY("/any", Anything@)
JDWEB.BEFORE(Guard@)
JDWEB.AFTER(Stamp@)
JDWEB.ON_MISSING(Missing@)
JDWEB.ON_ERROR(Failed@)
JDWEB.ASSETS("/static", base$ + "jdweb_static")
JDWEB.ASSETS("/img", base$)

TESTKIT.SUITE("responses")
DIM reply = JDWEB.REPLY("hi", 202, "text/plain")
TESTKIT.EQ(reply{"__http_status"}, 202, "REPLY sets the status")
TESTKIT.EQ(reply{"__http_content_type"}, "text/plain", "and the content type")
DIM with_header = JDWEB.HEADER(reply, "X-One", "1")
DIM wh = with_header{"__http_headers"}
TESTKIT.EQ(wh{"X-One"}, "1", "HEADER adds a header")
TESTKIT.EQ(with_header{"__http_body"}, "hi", "to a copy that keeps the body")
DIM one_cookie = JDWEB.HEADER(reply, "Set-Cookie", "a=1")
DIM two_cookies = JDWEB.HEADER(one_cookie, "set-cookie", "b=2")
DIM tch = two_cookies{"__http_headers"}
DIM both_cookies = tch{"Set-Cookie"}
TESTKIT.EQ(TYPEOF(both_cookies), "ARRAY", "a second Set-Cookie is added beside the first")
TESTKIT.EQ(LEN(both_cookies), 2, "so both are sent")
DIM second_cookie$ = both_cookies[1]
TESTKIT.EQ(second_cookie$, "b=2", "in the order they were added")
DIM replaced = JDWEB.HEADER(with_header, "X-One", "2")
DIM rh = replaced{"__http_headers"}
TESTKIT.EQ(rh{"X-One"}, "2", "any other header name is replaced")
DIM js = JDWEB.REPLY_JSON({"a": 1}, 201)
TESTKIT.EQ(js{"__http_body"}, "{" + Q$ + "a" + Q$ + ":1}", "REPLY_JSON writes the value as JSON")
TESTKIT.EQ(js{"__http_status"}, 201, "with its status")
DIM passing = JDWEB.PASS()
TESTKIT.ISTRUE(MAP.EXISTS(passing, "__jdweb_pass"), "PASS is recognisable")

TESTKIT.SUITE("dispatch")
DIM no_headers AS MAP
DIM no_params AS MAP
DIM req_user = {"METHOD": "GET", "PATH": "/users/42", "HEADERS": no_headers, "PARAMS": no_params, "BODY": ""}
DIM d = JDWEB.DISPATCH(req_user)
TESTKIT.EQ(d{"__http_status"}, 200, "DISPATCH answers a request map without a server")
DIM d_body$ = d{"__http_body"}
TESTKIT.ISTRUE(INSTR(d_body$, "42") >= 0, "with the route's answer")
DIM d_headers = d{"__http_headers"}
TESTKIT.ISTRUE(MAP.EXISTS(d_headers, "X-Served-By"), "and the after middleware's header")
DIM req_put = {"METHOD": "PUT", "PATH": "/users/7", "HEADERS": no_headers, "PARAMS": no_params, "BODY": ""}
DIM d2 = JDWEB.DISPATCH(req_put)
TESTKIT.EQ(d2{"__http_status"}, 405, "a known path with another method is 405")
DIM req_none = {"METHOD": "GET", "PATH": "/nowhere", "HEADERS": no_headers, "PARAMS": no_params, "BODY": ""}
DIM d3 = JDWEB.DISPATCH(req_none)
TESTKIT.EQ(d3{"__http_status"}, 404, "an unknown path is 404")
DIM req_admin = {"METHOD": "GET", "PATH": "/admin", "HEADERS": no_headers, "PARAMS": no_params, "BODY": ""}
DIM d4 = JDWEB.DISPATCH(req_admin)
TESTKIT.EQ(d4{"__http_status"}, 401, "a before middleware answers")

IF gServed THEN
    IF NOT JDWEB.LISTEN(PORT) THEN
        PRINT "could not start the server on " + STR$(PORT)
        END 1
    ENDIF

    TESTKIT.SUITE("routes")
    DIM r = JDWEB.FETCH(PORT, "GET", "/users/42")
    TESTKIT.EQ(r{"status"}, 200, "a path parameter route answers")
    DIM user = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(user{"id"}, "42", "and hands the parameter over")
    TESTKIT.EQ(HeaderOf$(r, "x-served-by"), "jdweb", "the after middleware added its header")
    TESTKIT.EQ(HeaderOf$(r, "x-status"), "200", "knowing the status")
    TESTKIT.ISTRUE(INSTR(HeaderOf$(r, "content-type"), "application/json") >= 0, "a map goes out as JSON")
    r = JDWEB.FETCH(PORT, "GET", "/users/J%C3%BCrgen")
    user = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(user{"id"}, "Jürgen", "a parameter is percent-decoded")
    r = JDWEB.FETCH(PORT, "GET", "/users/42/")
    TESTKIT.EQ(r{"status"}, 200, "a trailing slash matches too")
    r = JDWEB.FETCH(PORT, "POST", "/users", "{" + Q$ + "name" + Q$ + ":" + Q$ + "Ann" + Q$ + "}")
    TESTKIT.EQ(r{"status"}, 201, "POST with a status of its own")
    DIM made = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(made{"created"}, "Ann", "reads the JSON body")
    r = JDWEB.FETCH(PORT, "DELETE", "/users/7")
    TESTKIT.EQ(r{"status"}, 204, "DELETE")
    r = JDWEB.FETCH(PORT, "PUT", "/users/7")
    TESTKIT.EQ(r{"status"}, 405, "a known path with another method is 405")
    TESTKIT.ISTRUE(INSTR(HeaderOf$(r, "allow"), "GET") >= 0 ANDALSO INSTR(HeaderOf$(r, "allow"), "DELETE") >= 0, "and names the methods allowed")
    r = JDWEB.FETCH(PORT, "GET", "/files/a/b/c.txt")
    TESTKIT.EQ(r{"body"}, "path=a/b/c.txt", "a star segment takes the rest of the path")
    r = JDWEB.FETCH(PORT, "GET", "/hello?name=Ann")
    TESTKIT.EQ(r{"body"}, "<h1>hello Ann</h1>", "a query parameter through PARAM$")
    TESTKIT.ISTRUE(INSTR(HeaderOf$(r, "content-type"), "text/html") >= 0, "a string goes out as HTML")
    r = JDWEB.FETCH(PORT, "PATCH", "/any")
    TESTKIT.EQ(r{"body"}, "any PATCH", "ANY takes every method")
    r = JDWEB.FETCH(PORT, "GET", "/nowhere")
    TESTKIT.EQ(r{"status"}, 404, "an unknown path is 404")
    TESTKIT.EQ(r{"body"}, "<p>nothing at /nowhere</p>", "rendered by the missing handler")
    TESTKIT.EQ(HeaderOf$(r, "x-status"), "404", "and the after middleware sees the 404")
    r = JDWEB.FETCH(PORT, "GET", "/boom")
    TESTKIT.EQ(r{"status"}, 500, "a handler that throws is 500")
    DIM failure = JSON.PARSE$(r{"body"})
    TESTKIT.ISTRUE(INSTR(failure{"error"}, "broken on purpose") >= 0, "the error handler gets the message")

    TESTKIT.SUITE("middleware")
    r = JDWEB.FETCH(PORT, "GET", "/admin")
    TESTKIT.EQ(r{"status"}, 401, "a before middleware can answer instead of the route")
    TESTKIT.EQ(r{"body"}, "no key", "with its own body")
    TESTKIT.EQ(HeaderOf$(r, "x-served-by"), "jdweb", "and the after middleware still runs")
    r = JDWEB.FETCH(PORT, "GET", "/admin", "", {"X-Key": "secret"})
    TESTKIT.EQ(r{"status"}, 200, "or let the request through")
    TESTKIT.EQ(r{"body"}, "admin area", "to the route")

    TESTKIT.SUITE("sessions")
    r = JDWEB.FETCH(PORT, "GET", "/count")
    DIM counted = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(counted{"count"}, 1, "a new visitor starts at one")
    DIM sid$ = JDWEB.COOKIE_OF$(r, "jdwsid")
    TESTKIT.ISTRUE(LEN(sid$) > 10, "and gets a session cookie")
    DIM jar = {"Cookie": "jdwsid=" + sid$}
    r = JDWEB.FETCH(PORT, "GET", "/count", "", jar)
    counted = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(counted{"count"}, 2, "the session remembers")
    TESTKIT.EQ(JDWEB.COOKIE_OF$(r, "jdwsid"), "", "without setting the cookie again")
    r = JDWEB.FETCH(PORT, "GET", "/count", "", jar)
    counted = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(counted{"count"}, 3, "and counts on")
    r = JDWEB.FETCH(PORT, "GET", "/count")
    counted = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(counted{"count"}, 1, "another visitor has a session of their own")
    r = JDWEB.FETCH(PORT, "POST", "/logout", "", jar)
    TESTKIT.ISTRUE(INSTR(HeaderOf$(r, "set-cookie"), "Max-Age=0") >= 0, "SESSION_END clears the cookie")
    r = JDWEB.FETCH(PORT, "GET", "/count", "", jar)
    counted = JSON.PARSE$(r{"body"})
    TESTKIT.EQ(counted{"count"}, 1, "and forgets the session")
    r = JDWEB.FETCH(PORT, "GET", "/themed")
    TESTKIT.EQ(r{"body"}, "themed", "a route that sets a cookie of its own in a new session")
    TESTKIT.EQ(JDWEB.COOKIE_OF$(r, "theme"), "dark", "sends its cookie")
    TESTKIT.ISTRUE(LEN(JDWEB.COOKIE_OF$(r, "jdwsid")) > 10, "and the session cookie beside it")

    TESTKIT.SUITE("static files")
    r = JDWEB.FETCH(PORT, "GET", "/static/hello.txt")
    TESTKIT.EQ(r{"status"}, 200, "a file under the prefix")
    TESTKIT.EQ(r{"body"}, TXTREADER$(base$ + "jdweb_static/hello.txt"), "with its content")
    TESTKIT.ISTRUE(INSTR(HeaderOf$(r, "content-type"), "text/plain") >= 0, "and the type of its extension")
    r = JDWEB.FETCH(PORT, "GET", "/static/css/site.css")
    TESTKIT.ISTRUE(INSTR(HeaderOf$(r, "content-type"), "text/css") >= 0, "a file in a subfolder")
    r = JDWEB.FETCH(PORT, "GET", "/static/")
    TESTKIT.EQ(r{"body"}, "<h1>index</h1>" + CHR$(10), "a folder serves its index.html")
    r = JDWEB.FETCH(PORT, "GET", "/static/%2e%2e/jdweb_selftest.jdb")
    TESTKIT.EQ(r{"status"}, 403, "a way out of the folder is refused")
    r = JDWEB.FETCH(PORT, "GET", "/static/none.txt")
    TESTKIT.EQ(r{"status"}, 404, "a missing file falls through to 404")
    r = JDWEB.FETCH(PORT, "GET", "/img/pdfgen_logo.jpg")
    TESTKIT.EQ(LEN(r{"body"}), LEN(BINREADER$(base$ + "pdfgen_logo.jpg")), "a binary file arrives whole")
    TESTKIT.ISTRUE(INSTR(HeaderOf$(r, "content-type"), "image/jpeg") >= 0, "as image/jpeg")

    TESTKIT.SUITE("CSRF over HTTP")
    JDWEB.CSRF_PROTECT()
    r = JDWEB.FETCH(PORT, "GET", "/form")
    DIM served_token$ = r{"body"}
    DIM served_sid$ = JDWEB.COOKIE_OF$(r, "jdwsid")
    r = JDWEB.FETCH(PORT, "POST", "/save", "", {"Cookie": "jdwsid=" + served_sid$})
    TESTKIT.EQ(r{"status"}, 403, "a POST without the token is refused")
    r = JDWEB.FETCH(PORT, "POST", "/save", "", {"Cookie": "jdwsid=" + served_sid$, "X-CSRF-Token": served_token$})
    TESTKIT.EQ(r{"status"}, 200, "and let through with it")
    JDWEB.CSRF_PROTECT(FALSE)

    HTTP.SERVER.STOP()
ELSE
    TESTKIT.SUITE("served routes")
    TESTKIT.SKIP("routes served from a compiled program: #412")
ENDIF

TESTKIT.SUITE("cookies")
TESTKIT.EQ(JDWEB.COOKIE$("a", "1"), "a=1; Path=/; HttpOnly; SameSite=Lax", "COOKIE$ with the defaults")
DIM prefs = {"max_age": 60, "secure": TRUE, "domain": "example.org"}
TESTKIT.EQ(JDWEB.COOKIE$("pref", "a b;c", prefs), "pref=a%20b%3Bc; Max-Age=60; Path=/; Domain=example.org; Secure; HttpOnly; SameSite=Lax", "a value a cookie cannot carry is encoded, attributes in order")
DIM bare = {"max_age": 0, "httponly": FALSE, "samesite": ""}
TESTKIT.EQ(JDWEB.COOKIE$("x", "", bare), "x=; Max-Age=0; Path=/", "a cookie deleted, without HttpOnly and SameSite")
DIM cross = {"samesite": "None"}
TESTKIT.ISTRUE(INSTR(JDWEB.COOKIE$("t", "1", cross), "; Secure") >= 0, "SameSite None always gets Secure")
DIM jar_req = {"HEADERS": {"cookie": "pref=a%20b%3Bc; z=1"}}
TESTKIT.EQ(JDWEB.COOKIE_VAL$(jar_req, "pref"), "a b;c", "COOKIE_VAL$ decodes it again")
DIM with_cookie = JDWEB.SET_COOKIE(JDWEB.REPLY("ok"), "pref", "dark")
TESTKIT.EQ(SetCookieOf$(with_cookie, "pref"), "pref=dark; Path=/; HttpOnly; SameSite=Lax", "SET_COOKIE puts it on a response")

TESTKIT.SUITE("session lifetime")
JDWEB.SESSION_CONFIG({"ttl": 600, "lifetime": 3600})
DIM ask1 = Ask("GET", "/count", "", "", "")
DIM d_count = JDWEB.DISPATCH(ask1)
DIM line1$ = SetCookieOf$(d_count, "jdwsid")
DIM sid1$ = SidOf$(line1$)
TESTKIT.EQ(LEN(sid1$), 43, "a session id is 43 random characters")
TESTKIT.ISTRUE(INSTR(line1$, "HttpOnly") >= 0 ANDALSO INSTR(line1$, "SameSite=Lax") >= 0, "in an HttpOnly SameSite=Lax cookie")
DIM ask2 = Ask("GET", "/count", sid1$, "", "")
TESTKIT.EQ(CountOf(JDWEB.DISPATCH(ask2)), 2, "the cookie brings the session back")
JDWEB.SESSION_CLOCK(500)
TESTKIT.EQ(CountOf(JDWEB.DISPATCH(ask2)), 3, "500 seconds later it is still there")
JDWEB.SESSION_CLOCK(1000)
TESTKIT.EQ(CountOf(JDWEB.DISPATCH(ask2)), 4, "each use starts the 600 seconds again")
JDWEB.SESSION_CLOCK(1700)
DIM d_late = JDWEB.DISPATCH(ask2)
TESTKIT.EQ(CountOf(d_late), 1, "700 seconds without use end it")
DIM sid2$ = SidOf$(SetCookieOf$(d_late, "jdwsid"))
TESTKIT.ISTRUE(LEN(sid2$) = 43 ANDALSO sid2$ <> sid1$, "and the visitor gets a new id")
DIM ask3 = Ask("GET", "/count", sid2$, "", "")
DIM clocks = [2200, 2700, 3200, 3700, 4200, 4700, 5200]
DIM ci = 0
FOR ci = 0 TO LEN(clocks) - 1
    JDWEB.SESSION_CLOCK(clocks[ci])
    DIM d_step = JDWEB.DISPATCH(ask3)
NEXT ci
TESTKIT.EQ(CountOf(d_step), 8, "a session used every 500 seconds lives on")
JDWEB.SESSION_CLOCK(5400)
TESTKIT.EQ(CountOf(JDWEB.DISPATCH(ask3)), 1, "until its lifetime of 3600 seconds is over")
DIM ask_idle = Ask("GET", "/count", "", "", "")
DIM d_idle = JDWEB.DISPATCH(ask_idle)
JDWEB.SESSION_CLOCK(9000)
TESTKIT.ISTRUE(CINT(JDWEB.SESSION_CLEANUP()) >= 1, "SESSION_CLEANUP removes sessions nobody used")
JDWEB.SESSION_CLOCK(0)
JDWEB.SESSION_CONFIG({"ttl": 86400, "lifetime": 0})
TESTKIT.THROWS(BadSetting@, 0, "an unknown setting is refused")

TESTKIT.SUITE("session rotation and settings")
DIM ask_r = Ask("GET", "/count", "", "", "")
DIM d_r = JDWEB.DISPATCH(ask_r)
DIM sid_r$ = SidOf$(SetCookieOf$(d_r, "jdwsid"))
DIM ask_r2 = Ask("GET", "/count", sid_r$, "", "")
DIM d_r2 = JDWEB.DISPATCH(ask_r2)
DIM ask_rot = Ask("GET", "/rotate", sid_r$, "", "")
DIM d_rot = JDWEB.DISPATCH(ask_rot)
DIM sid_rot$ = SidOf$(SetCookieOf$(d_rot, "jdwsid"))
TESTKIT.ISTRUE(LEN(sid_rot$) = 43 ANDALSO sid_rot$ <> sid_r$, "SESSION_ROTATE hands out a new id")
TESTKIT.EQ(CountOf(d_rot), 2, "with what the session held")
DIM ask_new = Ask("GET", "/count", sid_rot$, "", "")
TESTKIT.EQ(CountOf(JDWEB.DISPATCH(ask_new)), 3, "the new id carries on")
TESTKIT.EQ(CountOf(JDWEB.DISPATCH(ask_r2)), 1, "the old id is worth nothing")
JDWEB.SESSION_CONFIG({"secure": TRUE, "samesite": "Strict", "cookie": "appsid"})
DIM d_set = JDWEB.DISPATCH(ask_r)
DIM line_set$ = SetCookieOf$(d_set, "appsid")
TESTKIT.ISTRUE(LEN(line_set$) > 0, "the cookie name is a setting")
TESTKIT.ISTRUE(INSTR(line_set$, "; Secure") >= 0 ANDALSO INSTR(line_set$, "SameSite=Strict") >= 0, "and so are Secure and SameSite")
JDWEB.SESSION_CONFIG({"secure": FALSE, "samesite": "Lax", "cookie": "jdwsid"})

TESTKIT.SUITE("flash messages")
DIM ask_f = Ask("GET", "/flash", "", "", "")
DIM d_f = JDWEB.DISPATCH(ask_f)
TESTKIT.EQ(d_f{"__http_status"}, 302, "a handler leaves messages and redirects")
DIM sid_f$ = SidOf$(SetCookieOf$(d_f, "jdwsid"))
DIM ask_shown = Ask("GET", "/shown", sid_f$, "", "")
DIM d_shown = JDWEB.DISPATCH(ask_shown)
TESTKIT.EQ(d_shown{"__http_body"}, "info:note saved;warning:check the date;", "the next page reads them in order with their kinds")
DIM d_again = JDWEB.DISPATCH(ask_shown)
TESTKIT.EQ(d_again{"__http_body"}, "", "and they are gone after that")

TESTKIT.SUITE("CSRF")
JDWEB.CSRF_PROTECT()
JDWEB.CSRF_EXEMPT("/api/")
DIM ask_anon = Ask("POST", "/save", "", "", "")
TESTKIT.EQ(JDWEB.DISPATCH(ask_anon){"__http_status"}, 403, "a POST without a session is refused")
DIM ask_form = Ask("GET", "/form", "", "", "")
DIM d_form = JDWEB.DISPATCH(ask_form)
DIM token$ = d_form{"__http_body"}
DIM sid_c$ = SidOf$(SetCookieOf$(d_form, "jdwsid"))
TESTKIT.EQ(LEN(token$), 43, "CSRF_TOKEN$ gives the session a token")
DIM ask_none = Ask("POST", "/save", sid_c$, "", "")
TESTKIT.EQ(JDWEB.DISPATCH(ask_none){"__http_status"}, 403, "a session without the token is refused")
DIM ask_header = Ask("POST", "/save", sid_c$, token$, "")
DIM d_header = JDWEB.DISPATCH(ask_header)
TESTKIT.EQ(d_header{"__http_body"}, "saved", "the token in the X-CSRF-Token header lets it through")
DIM ask_wrong = Ask("POST", "/save", sid_c$, LEFT$(token$, 42) + "x", "")
TESTKIT.EQ(JDWEB.DISPATCH(ask_wrong){"__http_status"}, 403, "a token one character off is refused")
DIM ask_field = Ask("POST", "/save", sid_c$, "", "note=hi&csrf_token=" + token$)
TESTKIT.EQ(JDWEB.DISPATCH(ask_field){"__http_body"}, "saved", "so does the csrf_token field of a form")
DIM ask_api = Ask("POST", "/api/write", "", "", "")
TESTKIT.EQ(JDWEB.DISPATCH(ask_api){"__http_body"}, "api ok", "an exempt prefix needs no token")
DIM ask_get = Ask("GET", "/count", "", "", "")
TESTKIT.EQ(JDWEB.DISPATCH(ask_get){"__http_status"}, 200, "GET needs none")
JDWEB.CSRF_PROTECT(FALSE)
TESTKIT.EQ(JDWEB.DISPATCH(ask_anon){"__http_body"}, "saved", "CSRF_PROTECT(FALSE) turns the check off")

TESTKIT.SUITE("sessions in a database")
IF OS.FEATURE("SQLITE") THEN
    DIM sdb = SQL.OPEN(":memory:")
    JDWEB.SESSION_CONFIG({"db": sdb})
    DIM ask_s = Ask("GET", "/count", "", "", "")
    DIM d_s = JDWEB.DISPATCH(ask_s)
    DIM sid_s$ = SidOf$(SetCookieOf$(d_s, "jdwsid"))
    DIM ask_s2 = Ask("GET", "/count", sid_s$, "", "")
    DIM d_s2 = JDWEB.DISPATCH(ask_s2)
    DIM stored_rows = SQL.TABLE(sdb, "SELECT data FROM jdweb_sessions WHERE id = '" + sid_s$ + "'")
    TESTKIT.EQ(LEN(stored_rows), 1, "a session is written to jdweb_sessions")
    DIM stored_data$ = stored_rows[0, 0]
    TESTKIT.ISTRUE(INSTR(stored_data$, "count") >= 0, "with what it holds as JSON")
    JDWEB.SESSION_CONFIG({"db": sdb})
    TESTKIT.EQ(CountOf(JDWEB.DISPATCH(ask_s2)), 3, "and read back once memory is dropped, as after a restart")
    DIM ask_out = Ask("POST", "/logout", sid_s$, "", "")
    DIM d_out = JDWEB.DISPATCH(ask_out)
    DIM left_rows = SQL.TABLE(sdb, "SELECT COUNT(*) FROM jdweb_sessions WHERE id = '" + sid_s$ + "'")
    DIM left_n = left_rows[0, 0]
    TESTKIT.EQ(CINT(left_n), 0, "SESSION_END removes its row")
    JDWEB.SESSION_CONFIG({"db": 0})
    SQL.CLOSE(sdb)
ELSE
    TESTKIT.SKIP("sessions in a database need a build with SQLITE")
ENDIF

TESTKIT.SUITE("pages and login")
JDWEB.TEMPLATES(tpl$)
DIM cfg = {"app": "Selftest", "sub": "checks", "nav": [{"path": "/", "label": "Home"}], "cookies": FALSE}
DIM page$ = JDWEB.PAGE$(cfg, "Selftest - Home", JDWEB.NAV_HTML$(cfg, "/"), "<p>body</p>")
TESTKIT.ISTRUE(INSTR(page$, "<title>Selftest - Home</title>") >= 0, "PAGE$ writes the title")
TESTKIT.ISTRUE(INSTR(page$, "<p>body</p>") >= 0, "and the content")
TESTKIT.ISTRUE(INSTR(page$, "Home") >= 0, "and the navigation")
DIM missing = JDWEB.NOT_FOUND$(cfg)
TESTKIT.EQ(missing{"__http_status"}, 404, "NOT_FOUND$ is a 404")
DIM moved = JDWEB.REDIRECT_TO("/login")
TESTKIT.EQ(moved{"__http_status"}, 302, "REDIRECT_TO is a 302")
DIM denied = JDWEB.UNAUTH()
TESTKIT.EQ(denied{"__http_status"}, 401, "UNAUTH is a 401")
TESTKIT.EQ(JDWEB.HASH_PW$("salt", "pw"), CODEC.SHA256$("salt:pw"), "HASH_PW$ is a salted SHA-256")
DIM cookie_req = {"HEADERS": {"cookie": "a=1; jdwsession=tok123; b=2"}}
TESTKIT.EQ(JDWEB.COOKIE_VAL$(cookie_req, "jdwsession"), "tok123", "COOKIE_VAL$ finds a cookie between others")
TESTKIT.EQ(JDWEB.COOKIE_VAL$(cookie_req, "zzz"), "", "and nothing for an absent one")
IF OS.FEATURE("SQLITE") THEN
    DIM db = SQL.OPEN(":memory:")
    JDWEB.AUTH_INIT(db)
    DIM login_req = {"BODY": "{" + Q$ + "name" + Q$ + ":" + Q$ + "owner" + Q$ + "," + Q$ + "password" + Q$ + ":" + Q$ + "pw1" + Q$ + "}", "HEADERS": {}}
    DIM login = JDWEB.AUTH_LOGIN(db, login_req, FALSE)
    TESTKIT.EQ(login{"__http_status"}, 200, "the first login creates the owner")
    DIM login_headers = login{"__http_headers"}
    DIM set_cookie$ = login_headers{"Set-Cookie"}
    TESTKIT.ISTRUE(LEFT$(set_cookie$, 11) = "jdwsession=", "and sets the session cookie")
    DIM token$ = MID$(set_cookie$, 11, CINT(INSTR(set_cookie$, ";")) - 11)
    DIM me_req = {"HEADERS": {"cookie": "jdwsession=" + token$}}
    TESTKIT.EQ(JDWEB.AUTH_USER$(db, me_req), "owner", "AUTH_USER$ knows the signed-in user")
    DIM wrong_req = {"BODY": "{" + Q$ + "name" + Q$ + ":" + Q$ + "owner" + Q$ + "," + Q$ + "password" + Q$ + ":" + Q$ + "nope" + Q$ + "}", "HEADERS": {}}
    DIM wrong = JDWEB.AUTH_LOGIN(db, wrong_req, FALSE)
    TESTKIT.EQ(wrong{"error"}, "wrong password", "a wrong password is refused")
    DIM out = JDWEB.AUTH_LOGOUT(db, me_req)
    TESTKIT.EQ(out{"__http_status"}, 200, "logout answers")
    TESTKIT.EQ(JDWEB.AUTH_USER$(db, me_req), "", "and ends the session")
    DIM login2 = JDWEB.AUTH_LOGIN(db, login_req, TRUE)
    DIM login2_headers = login2{"__http_headers"}
    DIM cookie2$ = login2_headers{"Set-Cookie"}
    DIM token2$ = MID$(cookie2$, 11, CINT(INSTR(cookie2$, ";")) - 11)
    TESTKIT.EQ(LEN(token2$), 43, "a sign-in token is 43 random characters")
    TESTKIT.ISTRUE(INSTR(cookie2$, "; Secure") >= 0, "a secure sign-in sets a Secure cookie")
    DIM me2_req = {"HEADERS": {"cookie": "jdwsession=" + token2$}}
    TESTKIT.EQ(JDWEB.AUTH_USER$(db, me2_req), "owner", "the new sign-in is known")
    SQL.EXEC(db, "UPDATE sessions SET last_seen = last_seen - 3000000 WHERE token = '" + token2$ + "'")
    TESTKIT.EQ(JDWEB.AUTH_USER$(db, me2_req), "", "a sign-in unused for longer than auth_ttl ends")
    DIM login3 = JDWEB.AUTH_LOGIN(db, login_req, FALSE)
    DIM login3_headers = login3{"__http_headers"}
    DIM cookie3$ = login3_headers{"Set-Cookie"}
    DIM token3$ = MID$(cookie3$, 11, CINT(INSTR(cookie3$, ";")) - 11)
    SQL.EXEC(db, "UPDATE sessions SET last_seen = last_seen - 3000000 WHERE token = '" + token3$ + "'")
    TESTKIT.EQ(CINT(JDWEB.AUTH_CLEANUP(db)), 1, "AUTH_CLEANUP removes an old sign-in")
    DIM auth_left = SQL.TABLE(db, "SELECT COUNT(*) FROM sessions")
    DIM auth_left_n = auth_left[0, 0]
    TESTKIT.EQ(CINT(auth_left_n), 0, "and its row")

    DIM owner_rows = SQL.TABLE(db, "SELECT salt, pass_hash FROM users WHERE name = 'owner'")
    DIM owner_salt$ = owner_rows[0, 0]
    DIM owner_hash$ = owner_rows[0, 1]
    TESTKIT.EQ(LEFT$(owner_hash$, 21), "pbkdf2-sha256$600000$", "a password is kept as a PBKDF2 hash with 600000 rounds")
    TESTKIT.EQ(owner_salt$, "", "without a salt column of its own")
    JDWEB.SESSION_CONFIG({"auth_rounds": 1000})
    SQL.EXEC(db, "INSERT INTO users (name, salt, pass_hash) VALUES ('legacy', 'abc', '" + CODEC.SHA256$("abc:old pw") + "')")
    DIM legacy_req = {"BODY": "{" + Q$ + "name" + Q$ + ":" + Q$ + "legacy" + Q$ + "," + Q$ + "password" + Q$ + ":" + Q$ + "old pw" + Q$ + "}", "HEADERS": {}}
    DIM legacy_login = JDWEB.AUTH_LOGIN(db, legacy_req, FALSE)
    TESTKIT.EQ(legacy_login{"__http_status"}, 200, "a password of the salted SHA-256 scheme still signs in")
    DIM legacy_rows = SQL.TABLE(db, "SELECT salt, pass_hash FROM users WHERE name = 'legacy'")
    DIM legacy_salt$ = legacy_rows[0, 0]
    DIM legacy_hash$ = legacy_rows[0, 1]
    TESTKIT.ISTRUE(LEFT$(legacy_hash$, 19) = "pbkdf2-sha256$1000$" ANDALSO legacy_salt$ = "", "and is hashed again with PBKDF2 at that sign-in")
    DIM legacy_again = JDWEB.AUTH_LOGIN(db, legacy_req, FALSE)
    TESTKIT.EQ(legacy_again{"__http_status"}, 200, "the new hash verifies")
    DIM legacy_bad_req = {"BODY": "{" + Q$ + "name" + Q$ + ":" + Q$ + "legacy" + Q$ + "," + Q$ + "password" + Q$ + ":" + Q$ + "old pv" + Q$ + "}", "HEADERS": {}}
    DIM legacy_bad = JDWEB.AUTH_LOGIN(db, legacy_bad_req, FALSE)
    TESTKIT.EQ(legacy_bad{"error"}, "wrong password", "and refuses a wrong password")
    JDWEB.SESSION_CONFIG({"auth_rounds": 2000})
    DIM legacy_more = JDWEB.AUTH_LOGIN(db, legacy_req, FALSE)
    DIM more_rows = SQL.TABLE(db, "SELECT pass_hash FROM users WHERE name = 'legacy'")
    DIM more_hash$ = more_rows[0, 0]
    TESTKIT.EQ(LEFT$(more_hash$, 19), "pbkdf2-sha256$2000$", "more auth_rounds renew a hash at the next sign-in")
    JDWEB.SESSION_CONFIG({"auth_rounds": 600000})
ELSE
    TESTKIT.SKIP("cookie login needs a build with SQLITE")
ENDIF

TESTKIT.REPORT()
