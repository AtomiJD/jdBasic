' CONF: dotenv, INI and the TOML subset from text and from files, and
' the dotted GET over the map they all produce.

IMPORT TESTKIT, CONF

DIM NL$ = CHR$(10)
DIM Q$ = CHR$(34)
DIM BS$ = CHR$(92)

FUNC Dup(text$)
    RETURN CONF.INI_TEXT(text$, "error")
ENDFUNC

FUNC BadToml(text$)
    RETURN CONF.TOML_TEXT(text$)
ENDFUNC

' The message a TOML text raises, or "" when it reads.
FUNC TomlError$(text$)
    TRY
        DIM ok = CONF.TOML_TEXT(text$)
    CATCH
        RETURN ERRMSG$
    ENDTRY
    RETURN ""
ENDFUNC

FUNC Has(text$, part$)
    RETURN INSTR(text$, part$) >= 0
ENDFUNC

TESTKIT.SUITE("dotenv")
DIM env_text$ = "# database" + NL$ + _
    "DB_URL=postgres://localhost/app" + NL$ + _
    "export API_KEY=abc123" + NL$ + _
    "GREETING=" + Q$ + "hello" + BS$ + "nworld" + Q$ + NL$ + _
    "RAW='a # not a comment'" + NL$ + _
    "NOTE=value # a comment" + NL$ + _
    "EMPTY=" + NL$ + _
    "QUOTED_HASH=" + Q$ + "a#b" + Q$ + NL$ + _
    "  SPACED  =  padded  " + NL$ + _
    "garbage line" + NL$
DIM env = CONF.ENV_TEXT(env_text$)
TESTKIT.EQ(env{"DB_URL"}, "postgres://localhost/app", "a plain value")
TESTKIT.EQ(env{"API_KEY"}, "abc123", "the export prefix is tolerated")
TESTKIT.EQ(env{"GREETING"}, "hello" + NL$ + "world", "double quotes with an escape")
TESTKIT.EQ(env{"RAW"}, "a # not a comment", "single quotes keep a hash")
TESTKIT.EQ(env{"NOTE"}, "value", "an unquoted trailing comment is dropped")
TESTKIT.EQ(env{"EMPTY"}, "", "an empty value")
TESTKIT.EQ(env{"QUOTED_HASH"}, "a#b", "a hash inside quotes stays")
TESTKIT.EQ(env{"SPACED"}, "padded", "whitespace around key and value goes")
TESTKIT.ISFALSE(MAP.EXISTS(env, "garbage line"), "a line without = is skipped")
TESTKIT.EQ(LEN(MAP.KEYS(env)), 8, "eight keys")
SETENV "JDB_CONF_PROBE", ""
DIM applied = CONF.ENV_TEXT("JDB_CONF_PROBE=live", TRUE)
TESTKIT.EQ(GETENV$("JDB_CONF_PROBE"), "live", "apply pushes into the environment")
SETENV "JDB_CONF_PROBE", ""

TESTKIT.SUITE("INI")
DIM ini_text$ = "; top" + NL$ + _
    "name = demo" + NL$ + _
    "[server]" + NL$ + _
    "host = 0.0.0.0" + NL$ + _
    "port: 8080" + NL$ + _
    "# comment" + NL$ + _
    "[server]" + NL$ + _
    "port = 9090" + NL$ + _
    "[paths]" + NL$ + _
    "data = C:" + BS$ + "data" + NL$
DIM ini = CONF.INI_TEXT(ini_text$)
TESTKIT.EQ(ini{""}{"name"}, "demo", "a key before the first section lands in the empty section")
TESTKIT.EQ(ini{"server"}{"host"}, "0.0.0.0", "a section key")
TESTKIT.EQ(ini{"server"}{"port"}, "9090", "the last duplicate wins by default")
TESTKIT.EQ(ini{"paths"}{"data"}, "C:" + BS$ + "data", "values are kept as written")
TESTKIT.EQ(CONF.INI_TEXT(ini_text$, "first"){"server"}{"port"}, "8080", "or the first, by policy")
TESTKIT.THROWS(Dup@, ini_text$, "or a duplicate raises")
TESTKIT.EQ(LEN(MAP.KEYS(CONF.INI_TEXT("[a]" + NL$ + "x=1"))), 1, "no empty section when nothing precedes")

TESTKIT.SUITE("TOML")
DIM toml_text$ = "title = " + Q$ + "demo" + Q$ + NL$ + _
    "debug = false" + NL$ + _
    "ratio = 0.75" + NL$ + _
    "big = 1_000_000" + NL$ + _
    "when = 2026-09-11T15:00:00Z" + NL$ + _
    "path = 'C:" + BS$ + "tmp'" + NL$ + _
    "escaped = " + Q$ + "a" + BS$ + "tb" + Q$ + NL$ + _
    "tags = [" + Q$ + "a" + Q$ + ", " + Q$ + "b, c" + Q$ + ", 3]" + NL$ + _
    "nested = [[1, 2], [3]]" + NL$ + _
    "point = { x = 1, y = " + Q$ + "two" + Q$ + " }" + NL$ + _
    "" + NL$ + _
    "[server]" + NL$ + _
    "port = 8080 # inline comment" + NL$ + _
    "hosts = [" + Q$ + "a" + Q$ + ", " + Q$ + "b" + Q$ + "]" + NL$ + _
    "[server.tls]" + NL$ + _
    "enabled = true" + NL$ + _
    "[[jobs]]" + NL$ + _
    "name = " + Q$ + "first" + Q$ + NL$ + _
    "[[jobs]]" + NL$ + _
    "name = " + Q$ + "second" + Q$ + NL$ + _
    "[jobs.opts]" + NL$ + _
    "retries = 2" + NL$
DIM toml = CONF.TOML_TEXT(toml_text$)
TESTKIT.EQ(toml{"title"}, "demo", "a basic string")
TESTKIT.EQ(toml{"debug"}, FALSE, "a boolean")
TESTKIT.EQ(toml{"ratio"}, 0.75, "a float")
TESTKIT.EQ(toml{"big"}, 1000000, "an integer with underscores")
TESTKIT.EQ(TYPEOF(toml{"big"}), "INT64", "as an integer")
TESTKIT.EQ(toml{"when"}, "2026-09-11T15:00:00Z", "a datetime is kept as text")
TESTKIT.EQ(toml{"path"}, "C:" + BS$ + "tmp", "a literal string keeps its backslash")
TESTKIT.EQ(toml{"escaped"}, "a" + CHR$(9) + "b", "a basic string unescapes")
TESTKIT.EQARRAY(toml{"tags"}, ["a", "b, c", 3], "an array with a comma inside a string")
TESTKIT.EQ(toml{"nested"}[1][0], 3, "nested arrays")
TESTKIT.EQ(toml{"point"}{"y"}, "two", "an inline table")
TESTKIT.EQ(toml{"server"}{"port"}, 8080, "a table key with a trailing comment")
TESTKIT.EQARRAY(toml{"server"}{"hosts"}, ["a", "b"], "an array in a table")
TESTKIT.EQ(toml{"server"}{"tls"}{"enabled"}, TRUE, "a dotted table header nests")
TESTKIT.EQ(LEN(toml{"jobs"}), 2, "an array of tables")
TESTKIT.EQ(toml{"jobs"}[1]{"name"}, "second", "in order")
TESTKIT.EQ(toml{"jobs"}[1]{"opts"}{"retries"}, 2, "a table under the last array entry")
TESTKIT.THROWS(BadToml@, "no equals here", "a line that is no assignment raises")
DIM multi_text$ = "files = [" + NL$ + _
    "    " + Q$ + "a [1].md" + Q$ + ",   # the first" + NL$ + _
    "    'b # not a comment.md'," + NL$ + _
    "    [1," + NL$ + _
    "     2]," + NL$ + _
    "]" + NL$ + _
    "after = 1" + NL$ + _
    "[next]" + NL$ + _
    "x = 2" + NL$
DIM multi = CONF.TOML_TEXT(multi_text$)
TESTKIT.EQ(LEN(multi{"files"}), 3, "an array over several lines with a trailing comma")
TESTKIT.EQ(multi{"files"}[0], "a [1].md", "brackets and comments around a string")
TESTKIT.EQ(multi{"files"}[1], "b # not a comment.md", "a # inside a literal string")
TESTKIT.EQ(multi{"files"}[2][1], 2, "a nested array that spans lines")
TESTKIT.EQ(multi{"after"}, 1, "the line after the array")
TESTKIT.EQ(multi{"next"}{"x"}, 2, "and the table after it")

TESTKIT.SUITE("TOML escapes and mistakes")
DIM esc_text$ = "u = " + Q$ + "5 " + BS$ + "u20AC" + Q$ + NL$ + _
    "e = " + Q$ + "caf" + BS$ + "u00E9" + Q$ + NL$ + _
    "path = " + Q$ + "C:" + BS$ + BS$ + "Users" + BS$ + BS$ + "mia" + Q$ + NL$ + _
    "lit = 'C:" + BS$ + "Users" + BS$ + "mia'" + NL$ + _
    "[box]  # a heading with a comment" + NL$ + _
    "x = 1" + NL$
DIM esc = CONF.TOML_TEXT(esc_text$)
TESTKIT.EQ(esc{"u"}, "5 " + CHR$(8364), "a \u escape gives the character in UTF-8")
TESTKIT.EQ(esc{"e"}, "caf" + CHR$(195) + CHR$(169), "also below 256")
TESTKIT.EQ(esc{"path"}, "C:" + BS$ + "Users" + BS$ + "mia", "doubled backslashes are one each")
TESTKIT.EQ(esc{"lit"}, "C:" + BS$ + "Users" + BS$ + "mia", "single quotes keep backslashes")
TESTKIT.EQ(esc{"box"}{"x"}, 1, "a heading may carry a comment")
DIM win$ = TomlError$("a = 1" + NL$ + "dir = " + Q$ + "C:" + BS$ + "Users" + BS$ + "mia" + Q$ + NL$)
TESTKIT.ISTRUE(Has(win$, "line 2"), "a Windows path in double quotes names its line")
TESTKIT.ISTRUE(Has(win$, "C:/Users/mia"), "and shows the forward slashes")
DIM tab$ = TomlError$("dir = " + Q$ + "D:" + BS$ + "temp" + Q$)
TESTKIT.ISTRUE(Has(tab$, "Windows path"), "even when the backslash looks like an escape")
DIM odd$ = TomlError$("x = " + Q$ + "a" + BS$ + "q" + Q$)
TESTKIT.ISTRUE(Has(odd$, "line 1") ANDALSO Has(odd$, "not an escape"), "an unknown escape raises")
DIM open$ = TomlError$("[a]" + NL$ + "x = 1" + NL$ + "[scans" + NL$ + "y = 2")
TESTKIT.ISTRUE(Has(open$, "line 3") ANDALSO Has(open$, "closing bracket"), "a heading without ] raises")
DIM quote$ = TomlError$("list = [" + NL$ + "  1," + NL$ + "]" + NL$ + "name = " + Q$ + "abc")
TESTKIT.ISTRUE(Has(quote$, "line 4") ANDALSO Has(quote$, "closing quote"), "lines count after an array over several lines")
DIM bare$ = TomlError$("[user]" + NL$ + "name = Mia Example")
TESTKIT.ISTRUE(Has(bare$, "line 2") ANDALSO Has(bare$, Q$ + "Mia Example" + Q$), "text without quotes raises and shows the quoted form")
DIM when = CONF.TOML_TEXT("day = 2026-10-04" + NL$ + "at = 07:30:00" + NL$ + "big = inf")
TESTKIT.EQ(when{"day"} + " " + when{"at"} + " " + when{"big"}, "2026-10-04 07:30:00 inf", "dates, times and inf stay bare")

TESTKIT.SUITE("GET")
TESTKIT.EQ(CONF.GET(toml, "server.tls.enabled", FALSE), TRUE, "a dotted path")
TESTKIT.EQ(CONF.GET(toml, "server.port"), 8080, "two levels")
TESTKIT.EQ(CONF.GET(toml, "server.missing", 42), 42, "the fallback for a missing key")
TESTKIT.EQ(CONF.GET(toml, "title.deeper", "x"), "x", "the fallback when the path runs through a scalar")
TESTKIT.EQ(CONF.GET(ini, "server.host", ""), "0.0.0.0", "the same read on an INI map")

TESTKIT.SUITE("files")
DIM work$ = MKTEMP$("jdbconf")
MKDIR work$
TXTWRITER work$ + "/.env", env_text$
TXTWRITER work$ + "/app.ini", ini_text$
TXTWRITER work$ + "/app.toml", toml_text$
TESTKIT.EQ(CONF.ENV(work$ + "/.env"){"API_KEY"}, "abc123", "ENV reads a file")
TESTKIT.EQ(CONF.INI(work$ + "/app.ini"){"server"}{"port"}, "9090", "INI reads a file")
TESTKIT.EQ(CONF.TOML(work$ + "/app.toml"){"server"}{"port"}, 8080, "TOML reads a file")
TXTWRITER work$ + "/bad.toml", "[a]" + NL$ + "x = " + Q$ + "open" + NL$
DIM file_err$ = ""
TRY
    DIM bad = CONF.TOML(work$ + "/bad.toml")
CATCH
    file_err$ = ERRMSG$
ENDTRY
TESTKIT.ISTRUE(Has(file_err$, "bad.toml line 2"), "a mistake in a file names the file and the line")

PRINT TESTKIT.REPORT()
