' TESTKIT testing itself. Runs in both backends.

IMPORT TESTKIT

TESTKIT.SUITE("equality")
TESTKIT.EQ(1 + 1, 2, "integers")
TESTKIT.EQ("ab" + "c", "abc", "strings")
TESTKIT.EQARRAY([1, 2, 3], [1, 2, 3], "arrays element by element")
TESTKIT.NE(1, "1", "a number is not its own spelling")
TESTKIT.NEARRAY([1, 2], [2, 1], "order matters")
TESTKIT.EQARRAY(RESHAPE(IOTA(6), [2, 3]), RESHAPE(IOTA(6), [2, 3]), "2-D arrays cell by cell")
TESTKIT.NEARRAY(RESHAPE(IOTA(6), [2, 3]), RESHAPE(IOTA(6) + 1, [2, 3]), "2-D arrays that differ")

TESTKIT.SUITE("truthiness")
TESTKIT.ISTRUE(3 > 2, "greater than")
TESTKIT.ISFALSE(2 > 3, "less than")
TESTKIT.ISTRUE(LEN("abc") = 3, "string length")

TESTKIT.SUITE("tolerance")
TESTKIT.NEAR(2.0 / 3.0, 0.66667, 0.001, "two thirds")
TESTKIT.NEAR(SQR(2), 1.41421356, 0.000001, "root of two")

TESTKIT.SUITE("missing values")
DIM empty AS MAP
TESTKIT.EQ(empty{"nope"}, empty{"also nope"}, "two absent keys are the same")
TESTKIT.NE(empty{"nope"}, 0, "an absent key is not zero")
TESTKIT.NE(empty{"nope"}, "", "an absent key is not an empty string")


TESTKIT.SUITE("a check after the report")
IF OS.FEATURE("INTERPRETER") THEN
    DIM late_dir$ = MKTEMP$("testkit")
    MKDIR late_dir$
    DIM late$ = PATH.JOIN$(late_dir$, "late.jdb")
    DIM lf$ = CHR$(10)
    TXTWRITER late$, "IMPORT TESTKIT" + lf$ + "TESTKIT.EQ(1, 1, " + CHR$(34) + "fine" + CHR$(34) + ")" + lf$ + _
        "DIM r = TESTKIT.REPORT()" + lf$ + "TESTKIT.EQ(1, 2, " + CHR$(34) + "late" + CHR$(34) + ")" + lf$
    DIM late_run = OS.EXEC(OS.SELF$(), [late$])
    TESTKIT.NE(late_run{"exit_code"}, 0, "a check that fails after REPORT() fails the run")
    TESTKIT.ISTRUE(INSTR(late_run{"output"}, "after REPORT()") >= 0, "and says where it belongs")
    KILL late$
    RMDIR late_dir$
ELSE
    TESTKIT.SKIP("needs jdbasic to start a second program")
ENDIF

TESTKIT.SUITE("skipping")
TESTKIT.SKIP("a case that needs a network")

PRINT TESTKIT.REPORT()
