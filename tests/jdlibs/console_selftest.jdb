' CONSOLE: tables in every border style, styled text, rules, panels,
' key and value blocks, wrapping, and the progress bar as text.

IMPORT TESTKIT, CONSOLE

DIM NL$ = CHR$(10)
DIM ESC$ = CHR$(27)

CONSOLE.PLAIN(TRUE)
CONSOLE.SET_WIDTH(40)

TESTKIT.SUITE("mode")
TESTKIT.ISTRUE(CONSOLE.IS_PLAIN(), "plain mode is on")
TESTKIT.EQ(CONSOLE.WIDTH(), 40, "the width that was set")
TESTKIT.EQ(CONSOLE.STYLE$("x", "bold red"), "x", "plain mode leaves text alone")
CONSOLE.PLAIN(FALSE)
TESTKIT.ISTRUE(NOT CONSOLE.IS_PLAIN(), "escapes are back")
DIM styled$ = CONSOLE.STYLE$("x", "bold red")
TESTKIT.EQ(styled$, ESC$ + "[1;31mx" + ESC$ + "[0m", "a bold red x")
TESTKIT.EQ(CONSOLE.STYLE$("x", "on_blue underline"), ESC$ + "[44;4mx" + ESC$ + "[0m", "background and underline")
TESTKIT.EQ(CONSOLE.STYLE$("x", "nonsense"), "x", "an unknown word adds nothing")
TESTKIT.EQ(CONSOLE.GREEN$("ok"), ESC$ + "[32mok" + ESC$ + "[0m", "a colour shortcut")
TESTKIT.EQ(CONSOLE.STRIP$(styled$), "x", "the escapes stripped")
TESTKIT.EQ(CONSOLE.VISIBLE(styled$), 1, "one visible character")
TESTKIT.EQ(CONSOLE.FIT$(styled$, 4, "l"), styled$ + "   ", "padding counts visible characters")
CONSOLE.PLAIN(TRUE)

TESTKIT.SUITE("fit")
TESTKIT.EQ(CONSOLE.FIT$("ab", 5), "ab   ", "left")
TESTKIT.EQ(CONSOLE.FIT$("ab", 5, "r"), "   ab", "right")
TESTKIT.EQ(CONSOLE.FIT$("ab", 6, "c"), "  ab  ", "centred")
TESTKIT.EQ(CONSOLE.FIT$("abcdefgh", 5), "abcd~", "cut with a tilde")
TESTKIT.EQ(CONSOLE.FIT$("abc", 1), "a", "a width of one keeps one character")

TESTKIT.SUITE("box table")
DIM rows = [["Widget", 3, 9.5], ["Gadget", 12, 0.25]]
DIM box = SPLIT(CONSOLE.TABLE$(rows, {"headers": ["Item", "Qty", "Price"]}), NL$)
TESTKIT.EQ(LEN(box), 6, "six lines")
TESTKIT.EQ(box[0], "+--------+-----+-------+", "the top edge")
TESTKIT.EQ(box[1], "| Item   | Qty | Price |", "the header row")
TESTKIT.EQ(box[3], "| Widget |   3 |   9.5 |", "numbers right aligned")
TESTKIT.EQ(box[4], "| Gadget |  12 |  0.25 |", "the second row")
TESTKIT.EQ(box[5], box[0], "the bottom edge")
DIM headless = SPLIT(CONSOLE.TABLE$(rows), NL$)
TESTKIT.EQ(LEN(headless), 4, "no header row without headers")
TESTKIT.EQ(headless[1], "| Widget |  3 |  9.5 |", "widths from the body alone")

TESTKIT.SUITE("other borders")
DIM md = SPLIT(CONSOLE.TABLE$(rows, {"headers": ["Item", "Qty", "Price"], "border": "markdown"}), NL$)
TESTKIT.EQ(md[0], "| Item   | Qty | Price |", "markdown header")
TESTKIT.EQ(md[1], "| ------ | --: | ----: |", "markdown rule with alignment")
TESTKIT.EQ(md[2], "| Widget |   3 |   9.5 |", "markdown row")
DIM plain = SPLIT(CONSOLE.TABLE$(rows, {"headers": ["Item", "Qty", "Price"], "border": "plain"}), NL$)
TESTKIT.EQ(plain[0], "Item    Qty  Price", "plain header")
TESTKIT.EQ(plain[1], "------  ---  -----", "plain rule")
TESTKIT.EQ(plain[2], "Widget    3    9.5", "plain row")
DIM bare = SPLIT(CONSOLE.TABLE$(rows, {"border": "none"}), NL$)
TESTKIT.EQ(LEN(bare), 2, "no borders, no header")
TESTKIT.EQ(bare[0], "Widget   3   9.5", "bare row")
TESTKIT.EQ(CONSOLE.TABLE$([]), "", "an empty table is an empty string")
CONSOLE.PLAIN(FALSE)
DIM styled_md$ = CONSOLE.TABLE$(rows, {"headers": ["Item", "Qty", "Price"], "border": "markdown"})
TESTKIT.EQ(INSTR(styled_md$, ESC$), -1, "a markdown table carries no escapes with styling on")
DIM styled_box$ = CONSOLE.TABLE$(rows, {"headers": ["Item", "Qty", "Price"], "border": "box"})
TESTKIT.ISTRUE(INSTR(styled_box$, ESC$ + "[1mItem") >= 0, "a box header is bold with styling on")
CONSOLE.PLAIN(TRUE)

TESTKIT.SUITE("map rows")
DIM people = [{"name": "ann", "age": 41}, {"name": "bob", "age": 7, "city": "Bonn"}]
DIM mt = SPLIT(CONSOLE.TABLE$(people, {"border": "markdown"}), NL$)
TESTKIT.EQ(mt[0], "| name | age | city |", "headers are the union of the keys")
TESTKIT.EQ(mt[2], "| ann  |  41 |      |", "a missing key is an empty cell")
TESTKIT.EQ(mt[3], "| bob  |   7 | Bonn |", "the row with the extra key")
DIM chosen = SPLIT(CONSOLE.TABLE$(people, {"headers": ["age", "name"], "border": "none"}), NL$)
TESTKIT.EQ(chosen[0], "age  name", "explicit headers pick and order the columns")
TESTKIT.EQ(chosen[1], " 41  ann", "values follow the header order")

TESTKIT.SUITE("cells")
DIM mixed = SPLIT(CONSOLE.TABLE$([[TRUE, [1, 2], {"k": 1}, NONE]], {"border": "none"}), NL$)
TESTKIT.EQ(mixed[0], "TRUE  [1,2]  {" + CHR$(34) + "k" + CHR$(34) + ":1}", "booleans, arrays and maps render, NONE is empty")
DIM aligned = SPLIT(CONSOLE.TABLE$([["a", 1], ["bb", 22]], {"align": ["r", "l"], "border": "none"}), NL$)
TESTKIT.EQ(aligned[0], " a  1", "alignment overrides per column")
TESTKIT.EQ(aligned[1], "bb  22", "the second row")

TESTKIT.SUITE("widths")
DIM cut = SPLIT(CONSOLE.TABLE$([["a very long cell content here", "b"]], {"headers": ["h1", "h2"], "widths": [8, 0]}), NL$)
TESTKIT.EQ(cut[3], "| a very ~ | b  |", "a column width cuts the cell")
DIM squeezed = SPLIT(CONSOLE.TABLE$([["a very long cell content here", "b"]], {"headers": ["h1", "h2"], "max_width": 24}), NL$)
TESTKIT.EQ(LEN(squeezed[0]), 24, "the table fits the maximum width")
TESTKIT.EQ(squeezed[3], "| a very long ce~ | b  |", "the widest column gives way")
DIM titled = SPLIT(CONSOLE.TABLE$([["x"]], {"title": "Report", "border": "none"}), NL$)
TESTKIT.EQ(titled[0], "Report", "the title is the first line")

TESTKIT.SUITE("blocks")
TESTKIT.EQ(CONSOLE.RULE$(), "-" * 40, "a rule across the width")
TESTKIT.EQ(CONSOLE.RULE$("go", "="), "=" * 18 + " go " + "=" * 18, "a titled rule")
DIM panel = SPLIT(CONSOLE.PANEL$("The quick brown fox jumps over the lazy dog.", "note", 30), NL$)
TESTKIT.EQ(panel[0], "+- note ---------------------+", "the panel title sits on the top edge")
TESTKIT.EQ(panel[1], "| The quick brown fox jumps  |", "wrapped to the inner width")
TESTKIT.EQ(panel[2], "| over the lazy dog.         |", "the second line")
TESTKIT.EQ(panel[3], "+----------------------------+", "the bottom edge")
TESTKIT.EQ(LEN(panel), 4, "four lines")
DIM kv = SPLIT(CONSOLE.KV$({"host": "cortex", "port": 8080}), NL$)
TESTKIT.EQ(kv[0], "host  cortex", "keys padded to the longest")
TESTKIT.EQ(kv[1], "port  8080", "a numeric value")
DIM kv2 = SPLIT(CONSOLE.KV$([["a", 1], ["bbb", TRUE]], 2), NL$)
TESTKIT.EQ(kv2[0], "  a    1", "pairs with an indent")
TESTKIT.EQ(kv2[1], "  bbb  TRUE", "a boolean value")
TESTKIT.EQARRAY(CONSOLE.WRAP("one two three four five", 9), ["one two", "three", "four five"], "words wrap at the width")
TESTKIT.EQARRAY(CONSOLE.WRAP("abcdefghij", 4), ["abcd", "efgh", "ij"], "a long word is cut")
TESTKIT.EQARRAY(CONSOLE.WRAP("a" + NL$ + "b c", 5), ["a", "b c"], "a line break starts a new paragraph")

TESTKIT.SUITE("progress")
DIM bar = CONSOLE.PROGRESS(4, "pack", 8)
TESTKIT.EQ(CONSOLE.PROGRESS$(bar), "pack [........] 0%   0/4", "the empty bar")
CONSOLE.ADVANCE(bar)
TESTKIT.EQ(CONSOLE.PROGRESS$(bar), "pack [##......] 25%  1/4", "a quarter")
CONSOLE.ADVANCE(bar, 3)
TESTKIT.ISTRUE(STARTSWITH(CONSOLE.PROGRESS$(bar), "pack [########] 100% 4/4 in "), "full, with the elapsed time")
CONSOLE.ADVANCE(bar, 5)
TESTKIT.EQ(bar{"done"}, 4, "advancing past the end stops at the total")
CONSOLE.FINISH(bar)
TESTKIT.EQ(CONSOLE.DURATION$(3), "3s", "seconds")
TESTKIT.EQ(CONSOLE.DURATION$(125), "2m05s", "minutes and seconds")
TESTKIT.EQ(CONSOLE.DURATION$(3725), "1h02m", "hours and minutes")
DIM sp = CONSOLE.SPINNER("thinking")
CONSOLE.SPIN(sp)
CONSOLE.SPIN(sp)
TESTKIT.EQ(sp{"frame"}, 2, "the spinner keeps its frame")
CONSOLE.DONE(sp, "ok")

TESTKIT.REPORT()
