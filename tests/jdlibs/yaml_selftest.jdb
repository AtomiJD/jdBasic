' YAML: scalars and their implicit types, block mappings and sequences,
' nesting, block scalars with folding and chomping, comments, documents,
' flow collections, the dotted path, writing, and the two fixture files
' the acceptance asks for.

IMPORT TESTKIT, YAML

DIM NL$ = CHR$(10)
DIM Q$ = CHR$(34)

TESTKIT.SUITE("scalars")
TESTKIT.EQ(YAML.PARSE("a: hello"){"a"}, "hello", "a plain string")
TESTKIT.EQ(YAML.PARSE("a: 42"){"a"}, 42, "an integer")
TESTKIT.EQ(YAML.PARSE("a: -1.5"){"a"}, -1.5, "a negative decimal")
TESTKIT.EQ(YAML.PARSE("a: 1.5e3"){"a"}, 1500, "an exponent")
TESTKIT.EQ(YAML.PARSE("a: 0x1f"){"a"}, 31, "a hexadecimal literal")
TESTKIT.EQ(YAML.PARSE("a: 1.2.3"){"a"}, "1.2.3", "a version stays a string")
TESTKIT.EQ(YAML.PARSE("a: 8080:80"){"a"}, "8080:80", "a colon without a space after it stays in the scalar")
TESTKIT.ISTRUE(YAML.PARSE("a: true"){"a"}, "true")
TESTKIT.ISTRUE(YAML.PARSE("a: yes"){"a"}, "yes")
TESTKIT.ISTRUE(YAML.PARSE("a: On"){"a"}, "on, whatever its case")
TESTKIT.ISFALSE(YAML.PARSE("a: false"){"a"}, "false")
TESTKIT.ISFALSE(YAML.PARSE("a: off"){"a"}, "off")
TESTKIT.EQ(TYPEOF(YAML.PARSE("a: null"){"a"}), "NONE", "null")
TESTKIT.EQ(TYPEOF(YAML.PARSE("a: ~"){"a"}), "NONE", "a tilde")
TESTKIT.EQ(TYPEOF(YAML.PARSE("a:"){"a"}), "NONE", "an empty value")
TESTKIT.EQ(YAML.PARSE("a: " + Q$ + "42" + Q$){"a"}, "42", "quoting keeps a number a string")
TESTKIT.EQ(YAML.PARSE("a: 'it''s'"){"a"}, "it's", "a doubled single quote")
TESTKIT.EQ(YAML.PARSE("a: " + Q$ + "one" + CHR$(92) + "ntwo" + Q$){"a"}, "one" + NL$ + "two", "an escape in double quotes")
TESTKIT.EQ(YAML.PARSE("a: he said " + Q$ + "no" + Q$){"a"}, "he said " + Q$ + "no" + Q$, "quotes inside a plain scalar")
TESTKIT.EQ(YAML.PARSE("a: text   "){"a"}, "text", "trailing spaces go")

TESTKIT.SUITE("mappings")
DIM flat = YAML.PARSE("one: 1" + NL$ + "two: 2" + NL$ + "three: 3")
TESTKIT.EQ(JSON.STRINGIFY$(MAP.KEYS(flat)), "[" + Q$ + "one" + Q$ + "," + Q$ + "two" + Q$ + "," + Q$ + "three" + Q$ + "]", "keys in order")
TESTKIT.EQ(flat{"two"}, 2, "the second value")
DIM deep = YAML.PARSE("a:" + NL$ + "  b:" + NL$ + "    c: found" + NL$ + "  d: 2" + NL$ + "e: 3")
TESTKIT.EQ(deep{"a"}{"b"}{"c"}, "found", "three levels")
TESTKIT.EQ(deep{"a"}{"d"}, 2, "back one level")
TESTKIT.EQ(deep{"e"}, 3, "back to the top")
DIM quoted = YAML.PARSE(Q$ + "a key" + Q$ + ": 1" + NL$ + "'b': 2")
TESTKIT.EQ(quoted{"a key"}, 1, "a quoted key")
TESTKIT.EQ(quoted{"b"}, 2, "a single quoted key")
TESTKIT.EQ(YAML.PARSE("url: http://x.y/z#frag"){"url"}, "http://x.y/z#frag", "a hash inside a word is not a comment")

TESTKIT.SUITE("sequences")
DIM plain = YAML.PARSE("- a" + NL$ + "- b" + NL$ + "- c")
TESTKIT.EQ(JSON.STRINGIFY$(plain), "[" + Q$ + "a" + Q$ + "," + Q$ + "b" + Q$ + "," + Q$ + "c" + Q$ + "]", "a document that is a sequence")
DIM under = YAML.PARSE("items:" + NL$ + "  - 1" + NL$ + "  - 2")
TESTKIT.EQ(JSON.STRINGIFY$(under{"items"}), "[1,2]", "a sequence under a key")
DIM level = YAML.PARSE("items:" + NL$ + "- 1" + NL$ + "- 2" + NL$ + "other: 3")
TESTKIT.EQ(JSON.STRINGIFY$(level{"items"}), "[1,2]", "a sequence at the key's own indentation")
TESTKIT.EQ(level{"other"}, 3, "the key after it")
DIM maps = YAML.PARSE("- name: a" + NL$ + "  size: 1" + NL$ + "- name: b" + NL$ + "  size: 2")
TESTKIT.EQ(LEN(maps), 2, "two mappings in a sequence")
TESTKIT.EQ(maps[1]{"name"}, "b", "the second one")
TESTKIT.EQ(maps[0]{"size"}, 1, "a key of the first")
DIM nested = YAML.PARSE("- - 1" + NL$ + "  - 2" + NL$ + "- - 3")
TESTKIT.EQ(JSON.STRINGIFY$(nested), "[[1,2],[3]]", "a sequence of sequences")
DIM deeper = YAML.PARSE("jobs:" + NL$ + "  - steps:" + NL$ + "      - run: one" + NL$ + "      - run: two")
TESTKIT.EQ(LEN(deeper{"jobs"}[0]{"steps"}), 2, "sequences inside sequences of mappings")
TESTKIT.EQ(deeper{"jobs"}[0]{"steps"}[1]{"run"}, "two", "the value at the bottom")
DIM empties = YAML.PARSE("- " + NL$ + "- x")
TESTKIT.EQ(TYPEOF(empties[0]), "NONE", "an empty item")

TESTKIT.SUITE("block scalars")
DIM literal = YAML.PARSE("s: |" + NL$ + "  one" + NL$ + "  two")
TESTKIT.EQ(literal{"s"}, "one" + NL$ + "two" + NL$, "a literal block keeps its newlines")
DIM folded = YAML.PARSE("s: >" + NL$ + "  one" + NL$ + "  two")
TESTKIT.EQ(folded{"s"}, "one two" + NL$, "a folded block joins its lines")
DIM stripped = YAML.PARSE("s: |-" + NL$ + "  one" + NL$ + "  two")
TESTKIT.EQ(stripped{"s"}, "one" + NL$ + "two", "the minus strips the last newline")
DIM kept = YAML.PARSE("s: |+" + NL$ + "  one" + NL$ + NL$)
TESTKIT.EQ(kept{"s"}, "one" + NL$, "the plus keeps it")
DIM inner_blank = YAML.PARSE("s: |" + NL$ + "  one" + NL$ + NL$ + "  three" + NL$ + "t: 1")
TESTKIT.EQ(inner_blank{"s"}, "one" + NL$ + NL$ + "three" + NL$, "a blank line inside the block")
TESTKIT.EQ(inner_blank{"t"}, 1, "the key after the block")
DIM indented = YAML.PARSE("s: |" + NL$ + "  one" + NL$ + "    two" + NL$ + "  three")
TESTKIT.EQ(indented{"s"}, "one" + NL$ + "  two" + NL$ + "three" + NL$, "the deeper line keeps its indentation")
DIM folded_para = YAML.PARSE("s: >" + NL$ + "  one" + NL$ + NL$ + "  two")
TESTKIT.EQ(folded_para{"s"}, "one" + NL$ + "two" + NL$, "a blank line separates folded paragraphs")

TESTKIT.SUITE("comments and documents")
DIM commented = YAML.PARSE("# top" + NL$ + "a: 1  # trailing" + NL$ + "" + NL$ + "b: 2")
TESTKIT.EQ(commented{"a"}, 1, "a trailing comment goes")
TESTKIT.EQ(commented{"b"}, 2, "a blank line and a comment line are skipped")
TESTKIT.EQ(YAML.PARSE("a: " + Q$ + "x # y" + Q$){"a"}, "x # y", "a hash inside quotes stays")
DIM docs = YAML.PARSE_ALL("---" + NL$ + "a: 1" + NL$ + "---" + NL$ + "a: 2" + NL$ + "...")
TESTKIT.EQ(LEN(docs), 2, "two documents")
TESTKIT.EQ(docs[1]{"a"}, 2, "the second document")
TESTKIT.EQ(YAML.PARSE("---" + NL$ + "a: 1"){"a"}, 1, "a leading document marker")
TESTKIT.EQ(TYPEOF(YAML.PARSE("")), "NONE", "an empty text")
TESTKIT.EQ(TYPEOF(YAML.PARSE("# only a comment")), "NONE", "a text that is all comment")

TESTKIT.SUITE("flow collections")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.PARSE("a: [1, 2, 3]"){"a"}), "[1,2,3]", "a flow sequence")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.PARSE("a: []"){"a"}), "[]", "an empty flow sequence")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.PARSE("a: [main, " + Q$ + "release/1" + Q$ + "]"){"a"}), "[" + Q$ + "main" + Q$ + "," + Q$ + "release/1" + Q$ + "]", "quoted and plain items")
TESTKIT.EQ(YAML.PARSE("a: {x: 1, y: two}"){"a"}{"y"}, "two", "a flow mapping")
TESTKIT.EQ(LEN(MAP.KEYS(YAML.PARSE("a: {}"){"a"})), 0, "an empty flow mapping")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.PARSE("a: [[1, 2], [3]]"){"a"}), "[[1,2],[3]]", "nested flow sequences")

TESTKIT.SUITE("errors")
FUNC Anchored(text$)
    RETURN YAML.PARSE(text$)
ENDFUNC
TESTKIT.THROWS(Anchored@, "a: &anchor 1", "an anchor is refused")
TESTKIT.THROWS(Anchored@, "a: *alias", "an alias is refused")
TESTKIT.THROWS(Anchored@, "a: !!str 1", "a tag is refused")
TESTKIT.THROWS(Anchored@, "a: 1" + NL$ + "  oops: 2", "an unexpected indentation is refused")

TESTKIT.SUITE("the dotted path")
DIM tree = YAML.PARSE("a:" + NL$ + "  b:" + NL$ + "    - x: 1" + NL$ + "    - x: 2")
TESTKIT.EQ(YAML.GET(tree, "a.b.1.x"), 2, "a path through a sequence")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.GET(tree, "a.b")), "[{" + Q$ + "x" + Q$ + ":1},{" + Q$ + "x" + Q$ + ":2}]", "a path to a container")
TESTKIT.EQ(YAML.GET(tree, "a.nope", "fallback"), "fallback", "a missing key")
TESTKIT.EQ(YAML.GET(tree, "a.b.9", "fallback"), "fallback", "an index past the end")
TESTKIT.EQ(YAML.GET(tree, "a.b.0.x.deeper", "fallback"), "fallback", "a path through a scalar")

TESTKIT.SUITE("writing")
TESTKIT.EQ(YAML.DUMP$({"a": 1, "b": "x"}), "a: 1" + NL$ + "b: x" + NL$, "a flat mapping")
TESTKIT.EQ(YAML.DUMP$({"a": {"b": 1}}), "a:" + NL$ + "  b: 1" + NL$, "a nested mapping")
TESTKIT.EQ(YAML.DUMP$({"a": [1, 2]}), "a:" + NL$ + "  - 1" + NL$ + "  - 2" + NL$, "a sequence")
TESTKIT.EQ(YAML.DUMP$({"a": [{"b": 1, "c": 2}]}), "a:" + NL$ + "  - b: 1" + NL$ + "    c: 2" + NL$, "a mapping in a sequence shares the dash")
TESTKIT.EQ(YAML.DUMP$({"a": TRUE, "b": FALSE}), "a: true" + NL$ + "b: false" + NL$, "truth values")
TESTKIT.EQ(YAML.DUMP$({"a": NONE}), "a: null" + NL$, "the absent value")
TESTKIT.EQ(YAML.DUMP$({"a": "42"}), "a: " + Q$ + "42" + Q$ + NL$, "a string that reads as a number is quoted")
TESTKIT.EQ(YAML.DUMP$({"a": "yes"}), "a: " + Q$ + "yes" + Q$ + NL$, "a string that reads as a truth value is quoted")
TESTKIT.EQ(YAML.DUMP$({"a": "x: y"}), "a: " + Q$ + "x: y" + Q$ + NL$, "a colon in a value is quoted")
TESTKIT.EQ(YAML.DUMP$({"a": ""}), "a: " + Q$ + Q$ + NL$, "an empty string is quoted")
TESTKIT.EQ(YAML.DUMP$({"a": "one" + NL$ + "two"}), "a: |" + NL$ + "  one" + NL$ + "  two" + NL$, "a text goes into a block scalar")
TESTKIT.EQ(YAML.DUMP$({"a": {}}), "a: {}" + NL$, "an empty mapping")
TESTKIT.EQ(YAML.DUMP$({"a": []}), "a: []" + NL$, "an empty sequence")
TESTKIT.EQ(YAML.DUMP$({"a": 1}, {"document": TRUE}), "---" + NL$ + "a: 1" + NL$, "a document marker on request")
TESTKIT.EQ(YAML.DUMP$({"a": {"b": 1}}, {"indent": 4}), "a:" + NL$ + "    b: 1" + NL$, "a wider indent")

TESTKIT.SUITE("round trip")
DIM source$ = "name: demo" + NL$ + "count: 3" + NL$ + "on: true" + NL$ + "tags:" + NL$ + "  - one" + NL$ + "  - two" + NL$ + "jobs:" + NL$ + "  - id: a" + NL$ + "    script: |" + NL$ + "      line one" + NL$ + "      line two" + NL$ + "  - id: b" + NL$ + "empty: {}"
DIM once = YAML.PARSE(source$)
DIM twice = YAML.PARSE(YAML.DUMP$(once))
TESTKIT.EQ(JSON.STRINGIFY$(twice), JSON.STRINGIFY$(once), "a document survives writing and reading")

TESTKIT.SUITE("the fixtures")
DIM base$ = "tests/jdlibs/fixtures/"
IF NOT FILE.EXISTS(base$ + "workflow.yml") THEN base$ = "fixtures/"
DIM wf = YAML.PARSEFILE(base$ + "workflow.yml")
TESTKIT.EQ(wf{"name"}, "gate", "the workflow name")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.GET(wf, "on.push.branches")), "[" + Q$ + "main" + Q$ + "," + Q$ + "release" + Q$ + "]", "the branches of the push trigger")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.GET(wf, "on.push.paths-ignore")), "[" + Q$ + "doc/**" + Q$ + "]", "the ignored paths")
TESTKIT.EQ(YAML.GET(wf, "on.schedule.0.cron"), "0 3 * * 1", "the cron entry")
TESTKIT.EQ(YAML.GET(wf, "env.BUILD_FLAGS"), "HTTP GFX IMGUI NATIVEC", "an environment value")
TESTKIT.EQ(YAML.GET(wf, "env.RETRIES"), 3, "a numeric environment value")
TESTKIT.ISFALSE(YAML.GET(wf, "env.VERBOSE"), "a truth value in the environment")
TESTKIT.EQ(JSON.STRINGIFY$(MAP.KEYS(wf{"jobs"})), "[" + Q$ + "build" + Q$ + "," + Q$ + "publish" + Q$ + "]", "the jobs")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.runs-on"), "windows-latest", "the runner")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.timeout-minutes"), 45, "the timeout")
TESTKIT.ISFALSE(YAML.GET(wf, "jobs.build.strategy.fail-fast"), "fail-fast off")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.GET(wf, "jobs.build.strategy.matrix.backend")), "[" + Q$ + "interpreter" + Q$ + "," + Q$ + "native" + Q$ + "]", "the matrix")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.strategy.matrix.include.0.flags"), "-c", "the matrix addition")
TESTKIT.EQ(LEN(YAML.GET(wf, "jobs.build.steps")), 4, "four steps")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.steps.0.uses"), "actions/checkout@v4", "the first step")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.steps.0.with.fetch-depth"), 0, "a nested option of a step")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.steps.1.run"), "build.bat %BUILD_FLAGS%" + NL$ + "build_rt.bat %BUILD_FLAGS%" + NL$, "a literal script")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.steps.2.run"), "jdBasic tests/gate/comprehensive_test.jdb && jdBasic tests/gate/native_test.jdb" + NL$, "a folded script")
TESTKIT.EQ(YAML.GET(wf, "jobs.build.steps.3.if"), "always()", "a condition")
TESTKIT.EQ(YAML.GET(wf, "jobs.publish.needs"), "build", "the dependency of the second job")

DIM compose = YAML.PARSEFILE(base$ + "compose.yml")
TESTKIT.EQ(JSON.STRINGIFY$(MAP.KEYS(compose{"services"})), "[" + Q$ + "web" + Q$ + "," + Q$ + "worker" + Q$ + "," + Q$ + "store" + Q$ + "]", "the services")
TESTKIT.EQ(YAML.GET(compose, "services.web.image"), "jdbasic/web:1.0.32", "an image tag keeps its colon")
TESTKIT.EQ(YAML.GET(compose, "services.web.command"), "jdBasic serve.jdb --port 8080", "a command line")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.GET(compose, "services.web.ports")), "[" + Q$ + "8080:8080" + Q$ + "," + Q$ + "8443:443" + Q$ + "]", "the quoted port mappings")
TESTKIT.EQ(YAML.GET(compose, "services.web.environment.WORKERS"), 4, "a numeric environment value")
TESTKIT.ISFALSE(YAML.GET(compose, "services.web.environment.DEBUG"), "no is a truth value")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.GET(compose, "services.web.depends_on")), "[" + Q$ + "store" + Q$ + "]", "the dependency")
TESTKIT.EQ(LEN(YAML.GET(compose, "services.web.healthcheck.test")), 4, "the health check command")
TESTKIT.EQ(YAML.GET(compose, "services.web.healthcheck.test.3"), "http://localhost:8080/health", "its last argument")
TESTKIT.EQ(YAML.GET(compose, "services.web.deploy.resources.limits.memory"), "512M", "a value five levels down")
TESTKIT.EQ(YAML.GET(compose, "services.worker.entrypoint"), "jdBasic worker.jdb --queue default" + NL$, "a folded entrypoint")
TESTKIT.EQ(JSON.STRINGIFY$(YAML.GET(compose, "services.worker.volumes")), "[" + Q$ + "./data:/srv/data:ro" + Q$ + "]", "a volume with two colons")
TESTKIT.EQ(LEN(MAP.KEYS(YAML.GET(compose, "volumes.store-data"))), 0, "an empty mapping value")
TESTKIT.EQ(YAML.GET(compose, "networks.default.name"), "appliance", "the network name")

TESTKIT.REPORT()
