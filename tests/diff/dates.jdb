' Dates: parts, arithmetic, formatting, from fixed dates so the output is stable.
OPTION "EXPLICIT"
DIM d AS DATE = CVDATE("2026-03-29 12:30:45")
DIM e AS DATE = CVDATE("2026-10-25")
DIM old AS DATE = CVDATE("1969-07-20")
PRINT "parts: "; YEAR(d); " "; MONTH(d); " "; DAY(d); " "; HOUR(d); " "; MINUTE(d); " "; SECOND(d); " "; WEEKDAY(d)
PRINT "parts old: "; YEAR(old); " "; MONTH(old); " "; DAY(old); " "; WEEKDAY(old)
PRINT "print: "; d; " "; e; " "; old
PRINT "format: "; FORMAT_DATE(d, "YYYY-MM-DD"); " "; FORMAT_DATE(d, "DD.MM.YYYY HH:NN:SS"); " "; FORMAT_DATE(e, "MMM D, YYYY")
PRINT "add: "; DATEADD("D", 3, e); " "; DATEADD("M", 1, CVDATE("2026-01-31")); " "; DATEADD("Y", -1, d); " "; DATEADD("H", 25, d)
PRINT "add n s: "; DATEADD("N", 90, d); " "; DATEADD("S", 3600, d); " "; DATEADD("W", 2, e)
PRINT "diff: "; DATEDIFF("D", e, d); " "; DATEDIFF("D", CVDATE("2026-01-01"), CVDATE("2026-10-01")); " "; DATEDIFF("H", d, DATEADD("D", 1, d))
PRINT "diff s: "; DATEDIFF("S", d, DATEADD("N", 1, d)); " "; DATEDIFF("N", d, DATEADD("H", 2, d))
PRINT "eomonth: "; EOMONTH(e); " "; EOMONTH(CVDATE("2024-02-10")); " "; EOMONTH(e, 1); " "; DAY(EOMONTH(CVDATE("2023-02-01")))
PRINT "cmp: "; d < e; " "; d = d; " "; old > e
PRINT "arith: "; e - d; " "; INT(e - d); " "; CLNG(e)
PRINT "cvdate forms: "; CVDATE("25.10.2026"); " "; CVDATE("2026-10-25 08:05:00"); " "; CVDATE("2026-10-25T08:05:00")
PRINT "parts map: "; DATE.PARTS(d){"year"}; " "; DATE.PARTS(d){"month"}; " "; DATE.PARTS(d){"day"}
PRINT "range: "; LEN(DATERANGE(e, DATEADD("D", 6, e))); " "; DATERANGE(e, DATEADD("D", 2, e))
PRINT "weekday week: "; WEEKDAY(CVDATE("2026-10-26")); " "; WEEKDAY(CVDATE("2026-10-25"))
PRINT "leap: "; DAY(DATEADD("D", 1, CVDATE("2024-02-28"))); " "; DAY(DATEADD("D", 1, CVDATE("2023-02-28")))
PRINT "epoch: "; CLNG(CVDATE("1970-01-01 00:00:00")); " "; CLNG(CVDATE("2000-01-01"))
PRINT "str: "; STR$(d); " "; "" + e
