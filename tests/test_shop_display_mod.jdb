EXPORT MODULE TEST_SHOP_DISPLAY_MOD

EXPORT FUNC OPEN_SHOP(shop_name$, shop_items)
    n = LEN(shop_items)
    PRINT "OPEN_SHOP "; shop_name$; " n="; n
    purchases = 0
    FOR i = 0 TO n - 1
        itm = shop_items[i]
        nm$ = itm{"name"}
        pr = INT(itm{"price"})
        PRINT "  row "; i; " name="; nm$; " price="; pr
        IF LEN(nm$) > 0 AND pr > 0 THEN purchases = purchases + 1
    NEXT i
    RETURN purchases
ENDFUNC
