' Helper module for cross-module FUNC ... AS TYPE coverage in native_test.
EXPORT MODULE NATIVE_TEST_MODX

EXPORT FUNC mx_str$(s$) AS STRING
    RETURN s$ + "_X"
ENDFUNC

EXPORT FUNC mx_arr() AS ARRAY
    RETURN [10, 20, 30]
ENDFUNC

EXPORT FUNC mx_obj(s$) AS OBJECT
    RETURN JSON.PARSE$(s$)
ENDFUNC

EXPORT FUNC mx_dbl(x AS DOUBLE) AS DOUBLE
    RETURN x * 2.5
ENDFUNC

' Wrapper that itself calls a typed FUNC — exercises return-tag flow
' through a chain that crosses the module boundary.
EXPORT FUNC mx_obj_wrap(s$) AS OBJECT
    RETURN mx_obj(s$)
ENDFUNC

' Module-qualified indexed-assign regression coverage. Writer in another
' compilation unit must be able to do `NATIVE_TEST_MODX.mx_grid[i, j] = v`
' under -c. Pre-2026-05-20 the parser routed this through the no-parens
' dotted-call branch and the runtime died "Undefined function: ...mx_grid".
EXPORT DIM mx_grid[8, 8] AS INTEGER
EXPORT DIM mx_row[16]    AS DOUBLE
EXPORT DIM mx_names$[4]  AS STRING

EXPORT FUNC mx_grid_at(r AS INTEGER, c AS INTEGER) AS INTEGER
    RETURN mx_grid[r, c]
ENDFUNC

EXPORT FUNC mx_row_at(i AS INTEGER) AS DOUBLE
    RETURN mx_row[i]
ENDFUNC

EXPORT FUNC mx_name_at$(i AS INTEGER) AS STRING
    RETURN mx_names$[i]
ENDFUNC
