W = 10 : H = 5
DIM C = RESHAPE([" "], [H, W])
DIM PY = [0, 1, 2, 3, 4, 4, 3, 2, 1, 0]
DIM EY = [4, 4, 3, 3, 2, 2, 1, 1, 0, 0]
DIM IY = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
DIM XS = IOTA(W) - 1
PRINT "--- After P ---"
C[PY, XS] = "P"
PRINT FRMV$(C)
PRINT "--- After E ---"
C[EY, XS] = "E"
PRINT FRMV$(C)
PRINT "--- After I ---"
C[IY, XS] = "I"
PRINT FRMV$(C)
