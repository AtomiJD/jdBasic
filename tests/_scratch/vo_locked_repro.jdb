OPTION "EXPLICIT"
DIM vstate AS MAP

SUB render()
    DIM vi_arr = ["(keiner)", "Anna", "Bob"]
    vstate{"vertreter_items"} = vi_arr
    DIM vn$ = "(keiner)"
    DIM vidx AS INTEGER = 0
    PRINT "[a]"
    vn$ = vstate{"vertreter_items"}[vidx]
    PRINT "[b] vn$=["; vn$; "]"
ENDSUB

render()
PRINT "DONE"
