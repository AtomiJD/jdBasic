' Diagnose: ist die FFI-Function im native registriert?
' Zwei Varianten:
'  (1) Funktion sichtlich registriert + Wert hardcoded (MessageBeep, async)
'  (2) Funktion mit definitivem Rückgabewert (GetTickCount, immer >0)

PRINT "=== Native FFI diagnostic ==="

' kernel32.GetTickCount() gibt monoton steigende ms zurück (immer > 0 nach Boot)
DECLARE FUNC GetTickCount LIB "kernel32.dll" ALIAS "GetTickCount" () AS INTEGER
ticks = GetTickCount()
PRINT "GetTickCount() = " + STR$(ticks)
IF ticks = 0 THEN
    PRINT "  → FAILED: returned 0: FFI call probably never reached the DLL"
ELSE
    PRINT "  → OK: FFI call propagates correctly"
ENDIF

' user32.GetSystemMetrics(0) - primary screen width
DECLARE FUNC GetSystemMetrics LIB "user32.dll" ALIAS "GetSystemMetrics" (n AS INTEGER) AS INTEGER
w = GetSystemMetrics(0)
PRINT "GetSystemMetrics(0) = " + STR$(w)

' kernel32.GetCurrentProcessId() - always > 0
DECLARE FUNC GetCurrentProcessId LIB "kernel32.dll" ALIAS "GetCurrentProcessId" () AS INTEGER
pid = GetCurrentProcessId()
PRINT "GetCurrentProcessId() = " + STR$(pid)

PRINT "=== done ==="
