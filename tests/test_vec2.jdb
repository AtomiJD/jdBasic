' Case insensitive variables
let a = 42
print A
let X = [1,2,3]
print x

' Case insensitive functions
print iota(5)
print Iota(5, 0)
print SIN(0)

' Auto-vectorize: SIN on array
print "sin(iota(5)) = "; sin(iota(5))
print "cos(iota(5)) = "; cos(iota(5))
print "abs([-3,-2,-1,0,1]) = "; abs([-3,-2,-1,0,1])
print "sqr(iota(5)) = "; sqr(iota(5))
print "exp([0,1,2]) = "; exp([0,1,2])

' Nested vectorized calls
print "abs(sin(iota(10))) = "; abs(sin(iota(10)))

' Multi-arg function vectorized
print "left([\"hello\",\"world\"], 3) = "; left(["hello","world"], 3)

' Mixed scalar + array
print "log([1,10,100]) = "; log([1,10,100])

' INT on float array
print "int(sin(iota(5))*100) = "; int(sin(iota(5))*100)
