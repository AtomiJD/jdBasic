' Reproduziert den "KV-Cache Overflow" Bug: viele Queries nacheinander
PRINT "Loading LLM..."
llm = AI.LOAD_LLM("models/Phi-3-mini-4k-instruct-q4.gguf", 4096, 99)
AI.SET llm, "max_tokens", 100
AI.SET llm, "temperature", 0.2
AI.SET llm, "system", "You are a helpful assistant. Answer concisely based on the context."

PRINT "Loading embedding model..."
emb = AI.LOAD_EMBEDDINGS("models/nomic-embed-text-v1.5.Q4_K_M.gguf", 2048, 99)

PRINT "Building RAG store..."
DIM rag = AI.RAG_CREATE(llm, 300, 30, emb)
AI.RAG_ADD rag, "Berlin ist die Hauptstadt von Deutschland und hat etwa 3.7 Millionen Einwohner.", "wiki_berlin"
AI.RAG_ADD rag, "Paris ist die Hauptstadt von Frankreich und hat etwa 2.1 Millionen Einwohner.", "wiki_paris"
AI.RAG_ADD rag, "Tokyo ist die Hauptstadt von Japan und hat etwa 14 Millionen Einwohner.", "wiki_tokyo"
AI.RAG_ADD rag, "Wien ist die Hauptstadt von Oesterreich und hat etwa 1.9 Millionen Einwohner.", "wiki_wien"

PRINT ""
PRINT "=== 5 queries in a row — testing KV cache handling ==="

DIM questions = ["Wie viele Einwohner hat Berlin?", "Nenne mir die Hauptstadt von Frankreich.", "Wo liegt Tokyo und wie gross ist die Stadt?", "Vergleiche Berlin und Wien.", "Welche Stadt ist die kleinste der vier?"]

FOR i = 0 TO LEN(questions) - 1
  PRINT ""
  PRINT "Q" + STR(i+1) + ": " + questions[i]
  DIM r = AI.RAG_QUERY(rag, questions[i], 3)
  PRINT "A" + STR(i+1) + ": " + r
NEXT i

AI.FREE_LLM llm
AI.FREE_LLM emb
PRINT ""
PRINT "Done — 5/5 queries succeeded."
