' ── String Operators ───────────────────────────────
PRINT "=== String Operators ==="
PRINT "Hello " + "World!"
PRINT "abababac" - "ab"
PRINT "-" * 20
PRINT 5 / "Welcome"
PRINT "Welcome" / 4
PRINT -"ABC"

' ── Bitwise ───────────────────────────────────────
PRINT ""
PRINT "=== Bitwise ==="
PRINT "5 BAND 3 = "; 5 BAND 3
PRINT "5 BOR 3 = "; 5 BOR 3
PRINT "5 BXOR 3 = "; 5 BXOR 3
PRINT "SHL(1, 4) = "; SHL(1, 4)
PRINT "SHR(16, 2) = "; SHR(16, 2)

' ── ANDALSO / ORELSE ──────────────────────────────
PRINT ""
PRINT "=== Short-circuit ==="
LET X = 0
IF FALSE ANDALSO (1/X > 0) THEN
    PRINT "Should not print"
ELSE
    PRINT "ANDALSO short-circuited (no div-by-zero!)"
ENDIF

IF TRUE ORELSE (1/X > 0) THEN
    PRINT "ORELSE short-circuited (no div-by-zero!)"
ENDIF

' ── IN Operator ───────────────────────────────────
PRINT ""
PRINT "=== IN Operator ==="
DIM MyMap = {"name": "jd", "value": 100}
PRINT "'name' IN map: "; "name" IN MyMap
PRINT "'missing' IN map: "; "missing" IN MyMap

DIM arr = [10, 20, 30]
PRINT "20 IN array: "; 20 IN arr
PRINT "99 IN array: "; 99 IN arr
PRINT "'World' IN string: "; "World" IN "Hello World"

' ── Chained access ────────────────────────────────
PRINT ""
PRINT "=== Chained Access ==="
DIM json = JSON.PARSE$("{\"data\": {\"items\": [10, 20, 30]}, \"name\": \"test\"}")
PRINT "json{'data'}{'items'}[1] = "; json{"data"}{"items"}[1]
PRINT "json{'name'} = "; json{"name"}

' ── Regression ────────────────────────────────────
PRINT ""
PRINT "=== ALL TESTS PASSED ==="
