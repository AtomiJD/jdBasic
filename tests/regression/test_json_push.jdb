' PUSH a VM-handle map into an array, then read back
data = JSON.PARSE$(TXTREADER$("tests/test_items.json"))
item_db = data{"items"}

result = []
itm = item_db{"apple"}
PUSH result, itm
PRINT "after push LEN="; LEN(result)

itm2 = result[0]
nm$ = itm2{"name"}
pr = INT(itm2{"price"})
PRINT "nm$="; nm$; " pr="; pr
IF nm$ = "Apple" AND pr = 5 THEN
    PRINT "PASS"
ELSE
    PRINT "FAIL"
ENDIF
