TYPE T_NODE
    INPUT1 AS DOUBLE
    OUTPUT1 AS DOUBLE
    COST AS DOUBLE

    FUNC Process(A)
        RETURN A + THIS.COST
    ENDFUNC
ENDTYPE

DIM N1 AS T_NODE
DIM N2 AS T_NODE

N1.COST = 0
N2.COST = 5

N1.OUTPUT1 -> N1.INPUT1 * 2
N2.INPUT1 -> N1.OUTPUT1
N2.OUTPUT1 -> N2.Process(N2.INPUT1)

N1.INPUT1 = 10
PRINT "N1.OUTPUT1 = "; N1.OUTPUT1
PRINT "N2.INPUT1 = "; N2.INPUT1
PRINT "N2.OUTPUT1 = "; N2.OUTPUT1

N1.INPUT1 = 50
PRINT ""
PRINT "After N1.INPUT1 = 50:"
PRINT "N1.OUTPUT1 = "; N1.OUTPUT1
PRINT "N2.INPUT1 = "; N2.INPUT1
PRINT "N2.OUTPUT1 = "; N2.OUTPUT1
