' The compiled form answers what the interpreter answers where a value's
' kind decides the answer: values read from maps and arrays, untyped
' parameters of functions, ASYNC functions and methods, the string
' operators, AND/OR and truth, and FOR EACH over an array that changes.

DIM failed AS INTEGER = 0
DIM calls AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

FUNC Pair$(a, b)
    RETURN a + "/" + STR$(b)
ENDFUNC

FUNC Noted(v AS INTEGER) AS INTEGER
    calls = calls + 1
    RETURN v
ENDFUNC

FUNC KindOf(v)
    RETURN TYPEOF(v)
ENDFUNC

ASYNC FUNC KindLater(v)
    RETURN TYPEOF(v)
ENDFUNC

FUNC NextOf(v)
    RETURN v + 1
ENDFUNC

FUNC TimesTwo(v)
    RETURN v * 2
ENDFUNC

FUNC Pick(x)
    IF x > 1 THEN
        RETURN "big"
    ENDIF
    RETURN x
ENDFUNC

ASYNC FUNC KindOf(v)
    RETURN TYPEOF(v)
ENDFUNC

TYPE Probe
    N AS DOUBLE
    FUNC KindOf(x)
        RETURN TYPEOF(x)
    ENDFUNC
ENDTYPE

' Indexing a cell that holds a number raises the interpreter's error.
DIM flat AS ARRAY = [1, 2, 3]
DIM caught AS INTEGER = 0
TRY
    DIM nested = flat[1][0]
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "indexing a number cell is an error")
DIM m AS MAP = {"k": 5}
caught = 0
TRY
    DIM keyed = m{"k"}[0]
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "indexing a number in a map is an error")

' A string through a funcref to an untyped parameter.
DIM f = Pair$@
DIM word AS STRING = "hello"
Check(f(word, 7) = "hello/7", "a string through a funcref stays a string")

' A variable declared from a funcref call can be assigned again.
DIM r = f(word, 7)
r = f(word, 8)
Check(r = "hello/8", "reassigning a variable declared from a funcref call")

' HTTP.GET_ASYNC$ answers its task id as a number.
DIM task = HTTP.GET_ASYNC("http://127.0.0.1:1/none")
Check(TYPEOF(task) = "INT64", "HTTP.GET_ASYNC$ answers a number")
DIM ignored = AWAIT(task)

' VAL of a number is that number.
DIM seven AS INTEGER = 7
Check(VAL(seven) = 7, "VAL of an integer")

' Dividing a value of runtime kind by zero is an error.
DIM nums AS MAP = {"a": 6, "z": 0}
caught = 0
TRY
    DIM q1 = nums{"a"} / 0
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "a map value divided by zero")
caught = 0
TRY
    DIM q2 = nums{"a"} / nums{"z"}
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "a map value divided by a zero map value")
Check(nums{"a"} / 2 = 3, "a map value divided by a number")

' A string of runtime kind meets a number the way the string operators say.
DIM texts AS MAP = {"s": "abc", "d": "4", "a": [1, 2], "n": 9}
Check(texts{"s"} + 1 = "abc1", "a map string plus a number joins")
Check(1 + texts{"s"} = "1abc", "a number plus a map string joins")
Check(texts{"d"} * 2 = "44", "a map string times a number repeats")
Check(texts{"s"} / 2 = "bc", "a map string divided by a number slices")
DIM joined AS ARRAY = texts{"a"} + texts{"s"}
Check(joined[1] = "2abc", "a map array plus a map string joins per element")

' A number of runtime kind against a string counts the string as 0.
Check(NOT (texts{"n"} = "9"), "a map number equals no string")
Check(NOT (texts{"n"} < "10"), "a map number against a string counts it as 0")
Check(texts{"s"} = "abc", "a map string equals the same text")

' An untyped parameter of an ASYNC FUNC or of a TYPE method holds a string.
DIM greeting AS STRING = "World"
DIM t1 = KindOf(greeting)
DIM k1 = AWAIT t1
Check(k1 = "STRING", "a string handed to an ASYNC FUNC")
DIM t2 = KindOf(42)
DIM k2 = AWAIT t2
Check(k2 <> "STRING", "a number handed to the same ASYNC FUNC")
DIM pr AS Probe
Check(pr.KindOf("abc") = "STRING", "a string handed to a method")
Check(pr.KindOf(5) <> "STRING", "a number handed to the same method")

' A function answering a number or a string keeps each kind through SELECT.
DIM picked AS ARRAY = SELECT(Pick@, [1, 2, 3])
Check(picked[0] = 1 ANDALSO picked[1] = "big", "SELECT over a function of mixed answers")

' A map value handed to a builtin over an array keeps its kind.
DIM bag AS MAP = {"n": "b", "start": "a", "t": 86400}
DIM words AS ARRAY = ["abc", "xxb"]
DIM found AS ARRAY = INSTR(words, bag{"n"})
Check(found[0] = 1 ANDALSO found[1] = 2, "INSTR over an array with a map needle")
Check(REDUCE(LAMBDA acc, x -> acc + x, ["b", "c"], bag{"start"}) = "abc", "REDUCE from a map start value")
Check(CVDATE(bag{"t"}) = CVDATE(86400), "CVDATE of a map number")

' AND and OR evaluate both sides; an empty string is false.
DIM lhs_zero AS INTEGER = 0
DIM both = lhs_zero AND Noted(3)
Check(calls = 1, "AND evaluates its right side")
DIM empty AS STRING = ""
Check(NOT empty, "an empty string is false")
Check((empty ORELSE "b") = "b", "ORELSE passes an empty string by")
DIM flags AS ARRAY = [1, 0, 1]
DIM one AS INTEGER = 1
DIM masked AS ARRAY = one AND flags
Check(masked[0] = TRUE ANDALSO masked[1] = FALSE, "a number AND an array is element-wise")
DIM masked2 AS ARRAY = flags AND bag{"start"}
Check(LEN(masked2) = 3, "an array AND a map value is element-wise")

' A string with MOD, ^, \ or a number subtracted joins the texts.
DIM word3 AS STRING = "abc"
Check(word3 MOD 2 = "abc2", "a string MOD a number joins")
Check(word3 - 1 = "abc1", "a string minus a number joins")
Check(word3 ^ 2 = "abc2", "a string to a power joins")

' FOR EACH over an array the body shrinks stops at its current end.
DIM shrink AS ARRAY = [1, 2, 3, 4]
DIM passes AS INTEGER = 0
DIM popped = 0
FOR EACH v IN shrink
    popped = POP(shrink)
    passes = passes + 1
NEXT
Check(passes = 2, "FOR EACH over an array its body shrinks")

' An integer stays an integer through a funcref and an ASYNC call, and
' runtime-typed integer arithmetic stays integer until it overflows.
DIM kind_ref = KindOf@
Check(kind_ref(7) = "INT64", "an integer through a funcref")
Check(kind_ref("x") = "STRING", "a string through a funcref")
Check(kind_ref(2.5) = "FLOAT64", "a float through a funcref")
DIM kind_task = KindLater(7)
Check(AWAIT kind_task = "INT64", "an integer through an ASYNC call")
Check(NextOf(7) = 8, "integer plus one on a runtime-typed parameter")
Check(NextOf("a") = "a1", "string plus one on a runtime-typed parameter")
DIM next_ref = NextOf@
Check(TYPEOF(next_ref(7)) = "INT64", "an integer answer through a funcref")
Check(TYPEOF(NextOf(40)) = "INT64", "an integer answer from a runtime-typed parameter")
Check(TYPEOF(TimesTwo(40)) = "INT64", "integer times integer stays an integer")
Check(TYPEOF(TimesTwo(1.5)) = "FLOAT64", "a float times an integer is a float")
Check(TimesTwo("ab") = "abab", "a string times an integer repeats")

' A map has keys, not members.
DIM keyed AS MAP
keyed{"a"} = 1
Check(TYPEOF(keyed.a) = "NONE", "a dot on a map is NONE")
Check(keyed{"a"} = 1, "a key on a map reads the value")

IF failed > 0 THEN END 1
PRINT "OK"
