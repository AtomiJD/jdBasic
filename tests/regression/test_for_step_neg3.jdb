SUB MY_SAY(text$)
    box_w = 600
    margin = 16
    FS = 16
    char_w = INT(FS * 0.65)
    max_w = box_w - margin * 2
    chars_per_line = INT(max_w / char_w)

    frame = 0
    DO
        frame = frame + 1
        visible$ = LEFT$(text$, frame * 2)
        line_start = 0
        DO WHILE line_start < LEN(visible$)
            remaining = LEN(visible$) - line_start
            IF remaining <= chars_per_line THEN
                line_start = LEN(visible$)
            ELSE
                cut = chars_per_line
                iter = 0
                FOR j = line_start + chars_per_line TO line_start STEP -1
                    iter = iter + 1
                    IF iter <= 3 THEN PRINT "frame="; frame; " j="; j
                    IF iter > 200 THEN
                        PRINT "INFINITE j="; j; " iter="; iter
                        RETURN
                    ENDIF
                    c$ = MID$(text$, j, 1)
                    IF c$ = " " THEN
                        cut = j - line_start
                        EXITFOR
                    ENDIF
                NEXT j
                line_start = line_start + cut + 1
            ENDIF
        LOOP
        IF frame >= 40 THEN EXITDO
    LOOP
    PRINT "DONE frame="; frame
ENDSUB

MY_SAY "Spiel wird beendet. Ungespeicherter Fortschritt geht verloren!"
