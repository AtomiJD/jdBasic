' Repro: NPC sprite path — asset_path$ + data{"sprite"}
' Native must concat the dynamic-tagged string correctly.

DIM data = {}
data{"sprite"} = "moehrchen.png"
data{"name"} = "Möhrchen"
data{"x"} = 100

asset_path$ = "sprites/"

' Direct read → $-var (hinted): already green per test_tag7_to_str
s1$ = data{"sprite"}
PRINT "s1$='"; s1$; "'"

' Concat map value with string literal — no $-hint
full$ = asset_path$ + data{"sprite"}
PRINT "full$='"; full$; "'"

IF full$ <> "sprites/moehrchen.png" THEN PRINT "FAIL concat" : END

' Dimension check: IF img_w >= fw * 3 — does a bare map lookup cast to int?
data{"frame_w"} = 64
fw = INT(data{"frame_w"})
PRINT "fw="; fw
IF fw <> 64 THEN PRINT "FAIL fw" : END

PRINT "ALL PASS"
