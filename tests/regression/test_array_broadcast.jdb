' Two arrays under an operator: equal lengths meet cell by cell, a flat array
' meets every row of a matrix, an array of one cell gives it to every cell,
' and any other pair of lengths is an error, in both backends.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

FUNC Rows$(m AS ARRAY) AS STRING
    DIM s$ AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m) - 1
        s$ = s$ + JOIN(m[i], ",") + ";"
    NEXT i
    RETURN s$
ENDFUNC

DIM m AS ARRAY = [[1, 2, 3], [4, 5, 6]]
DIM v AS ARRAY = [10, 20, 30]
DIM one AS ARRAY = [[10, 20, 30]]
DIM col AS ARRAY = [[100], [200]]
DIM lone AS ARRAY = [1000]

Check(Rows$(m + v) = "11,22,33;14,25,36;", "a flat array meets every row")
Check(Rows$(v + m) = "11,22,33;14,25,36;", "and from the left")
Check(Rows$(m + one) = "11,22,33;14,25,36;", "a one-row matrix meets every row")
Check(Rows$(m * col) = "100,200,300;800,1000,1200;", "a column gives its cell to its row")
Check(Rows$(col * m) = "100,200,300;800,1000,1200;", "a column from the left")
Check(Rows$(m + lone) = "1001,1002,1003;1004,1005,1006;", "one cell meets every cell")
Check(JOIN(v + lone, ",") = "1010,1020,1030", "one cell meets every cell of a flat array")
Check(JOIN(v + [1, 2, 3], ",") = "11,22,33", "equal lengths meet cell by cell")
Check(Rows$(m - m) = "0,0,0;0,0,0;", "equal matrices meet row by row")

DIM lt AS ARRAY = m < v
Check(Rows$(lt) = "TRUE,TRUE,TRUE;TRUE,TRUE,TRUE;", "a comparison takes the same rule")
DIM gt AS ARRAY = col > m
Check(Rows$(gt) = "TRUE,TRUE,TRUE;TRUE,TRUE,TRUE;", "a comparison from the left is turned around")
DIM eq AS ARRAY = v = [10, 0, 30]
Check(JOIN(eq, ",") = "TRUE,FALSE,TRUE", "equal lengths compare cell by cell")

DIM caught AS INTEGER = 0
TRY
    DIM bad AS ARRAY = v + [1, 2]
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "3 cells against 2 is an error")
caught = 0
TRY
    DIM bad2 AS ARRAY = m + [[1], [2], [3]]
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "2 rows against 3 is an error")

IF failed > 0 THEN END 1
PRINT "OK"
