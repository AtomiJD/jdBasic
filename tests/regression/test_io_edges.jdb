' Library edges that used to answer wrongly without a word: numbers read
' under a locale with a decimal comma, a regex the engine gives up on, a
' damaged ZIP entry, a file whose last line has no newline.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

DIM dir$ AS STRING = MKTEMP$("io_edges")
MKDIR dir$

' A locale changes how numbers print, not how they read.
SETLOCALE "de_DE"
Check(VAL("3.5") = 3.5, "VAL reads a point under de_DE")
DIM csv$ AS STRING = dir$ + "/n.csv"
TXTWRITER csv$, "1.5,2.25" + CHR$(10)
DIM rows AS ARRAY = CSVREADER(csv$)
Check(rows[0][0] + rows[0][1] = 3.75, "CSV numbers read with a point under de_DE")
SETLOCALE "C"

' The regex engine running out of stack is an error, not "no match".
DIM caught AS INTEGER = 0
TRY
    DIM hit = REGEX.MATCH("( |x)*$", SPACE$(20000))
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "a regex the engine gives up on raises an error")
Check(REGEX.MATCH("ab+c", "abbbc"), "an ordinary regex still matches")

' A ZIP entry whose bytes do not match its CRC is refused.
DIM files AS MAP = {"a.txt": "abc"}
DIM good$ AS STRING = dir$ + "/good.zip"
DIM bad$ AS STRING = dir$ + "/bad.zip"
DIM written = ZIP.WRITE(good$, files)
DIM raw$ AS STRING = BINREADER$(good$)
BINWRITER bad$, LEFT$(raw$, 35) + "X" + MID$(raw$, 36)
DIM back AS MAP = ZIP.READ(good$)
Check(back{"a.txt"} = "abc", "an intact ZIP reads back")
caught = 0
TRY
    DIM broken = ZIP.READ(bad$)
CATCH
    caught = 1
ENDTRY
Check(caught = 1, "a damaged ZIP entry raises an error")

' The documented loop, DO WHILE NOT AT_EOF, sees a last line without newline.
DIM txt$ AS STRING = dir$ + "/three.txt"
TXTWRITER txt$, "one" + CHR$(10) + "two" + CHR$(10) + "three"
DIM h = FILE.OPEN_LINES(txt$)
DIM seen AS INTEGER = 0
DIM last$ AS STRING = ""
DO WHILE NOT FILE.AT_EOF(h)
    DIM text_line$ AS STRING = FILE.READLINE$(h)
    seen = seen + 1
    last$ = text_line$
LOOP
FILE.CLOSE h
Check(seen = 3, "three lines read")
Check(last$ = "three", "the last line without a newline is read")

KILL csv$
KILL good$
KILL bad$
KILL txt$
RMDIR dir$

IF failed > 0 THEN END 1
PRINT "OK"
