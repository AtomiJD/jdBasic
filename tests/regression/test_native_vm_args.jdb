' A VM value handed straight from a builtin to an untyped parameter, and a
' key whose kind only the running program knows: JSON.PARSE(...) written
' as the argument reaches the FUNC as the map it is (it read as 0), and
' acc{rec{"user"}} = v writes the key "ada" (it wrote the text's pointer as
' a number), while arr[rec{"i"}] = v with a number field still writes a
' position.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

FUNC UserOf$(rec)
    RETURN rec{"user"}
ENDFUNC

FUNC Record(rec, acc)
    acc{rec{"user"}} = rec{"score"}
    RETURN LEN(MAP.KEYS(acc))
ENDFUNC

FUNC PutAt(rec, arr)
    arr[rec{"i"}] = 7
    RETURN 0
ENDFUNC

FUNC Group(rec, acc)
    acc{rec{"user"}} = [rec{"score"}, 1]
    RETURN 0
ENDFUNC

Check(UserOf$(JSON.PARSE("{""user"": ""ada""}")) = "ada", "a parsed map handed straight to a FUNC")
Check(UserOf$({"user": "bob"}) = "bob", "a native map at another call site of the same FUNC")
DIM parsed = JSON.PARSE("{""user"": ""cy""}")
Check(UserOf$(parsed) = "cy", "a parsed map through a variable")

DIM accepted = {}
DIM n AS INTEGER = Record(JSON.PARSE("{""user"": ""ada"", ""score"": 90}"), accepted)
n = Record(JSON.PARSE("{""user"": ""margaret"", ""score"": 89.5}"), accepted)
Check(n = 2, "two keys written by a parsed field")
Check(JOIN(MAP.KEYS(accepted), ", ") = "ada, margaret", "the keys are the names, not numbers")
Check(accepted{"margaret"} = 89.5, "the value under a parsed key")

DIM cells = [1, 2, 3]
DIM r = PutAt(JSON.PARSE("{""i"": 1}"), cells)
Check(cells[1] = 7 ANDALSO cells[0] = 1, "a number field is a position")

DIM groups = {}
r = Group(JSON.PARSE("{""user"": ""ada"", ""score"": 3}"), groups)
Check(groups{"ada"}[0] = 3 ANDALSO LEN(groups{"ada"}) = 2, "an array written under a parsed key")

' A text field kept in an untyped local is the local's own copy, and a key
' read out for one lookup goes back afterwards: both must still read right
' after the bridge's buffers are gone (JDB_RC_POISON=1 turns a freed text
' into rubbish), also over many calls.
FUNC KeepName$(rec)
    DIM name = rec{"user"}
    DIM again = rec{"user"}
    name = rec{"score"}
    name = rec{"user"}
    RETURN name + "/" + again
ENDFUNC
FUNC CountUnder(rec, acc) AS INTEGER
    acc{rec{"user"}} = [rec{"score"}, 1]
    RETURN LEN(acc{rec{"user"}})
ENDFUNC
DIM probe = JSON.PARSE("{""user"": ""ada"", ""score"": 3}")
DIM kept$ = ""
DIM counted AS INTEGER = 0
DIM round AS INTEGER
DIM store = {}
FOR round = 1 TO 200
    kept$ = KeepName$(probe)
    counted = counted + CountUnder(probe, store)
NEXT round
Check(kept$ = "ada/ada", "a text field kept in an untyped local")
Check(counted = 400 ANDALSO store{"ada"}[1] = 1, "a key read out for each lookup, 200 times")

' A VM map read with a key out of FOR EACH ... MAP.KEYS of it: the key is a
' text, so it is a key and not a position (the copy came out all null).
FUNC WithDefaults(overrides, base)
    DIM merged = {}
    FOR EACH k IN MAP.KEYS(base)
        merged{k} = base{k}
    NEXT
    FOR EACH k IN MAP.KEYS(overrides)
        merged{k} = overrides{k}
    NEXT
    RETURN merged
ENDFUNC
DIM user = JSON.PARSE("{""size"": 14, ""font"": ""mono"", ""tags"": [1, 2]}")
DIM merged = WithDefaults(user, {"theme": "dark", "size": 12})
Check(JSON.STRINGIFY$(merged) = "{""theme"":""dark"",""size"":14,""font"":""mono"",""tags"":[1,2]}", "a VM map merged key by key")
DIM copied = {}
FOR EACH key IN MAP.KEYS(user)
    copied{key} = user{key}
NEXT
Check(copied{"font"} = "mono" ANDALSO copied{"size"} = 14, "a VM map copied at the top level")
DIM nums = JSON.PARSE("[10, 20, 30]")
DIM at = nums[0] - 9
Check(nums[at] = 20, "a VM array read by a position of run-time kind")

' An element of a VM array looked up with IN in a native array: a text is
' found by its content and a number by its value.
DIM allowed = ["admin", "dev", 3]
DIM roles = []
roles = JSON.PARSE("{""roles"": [""admin"", ""root"", 3]}"){"roles"}
DIM hits$ = ""
FOR EACH role IN roles
    IF role IN allowed THEN hits$ = hits$ + "+" ELSE hits$ = hits$ + "-"
NEXT
Check(hits$ = "+-+", "VM array elements found with IN in a native array")
Check(roles[0] IN allowed ANDALSO NOT (roles[1] IN allowed), "a VM array element read by position, with IN")
DIM first = roles[0]
Check(first IN allowed, "a VM array element kept in a variable, with IN")
Check(roles[0] IN "the admin role", "a VM text found inside a text")
Check(roles[0] IN {"admin": 1}, "a VM text as a map key with IN")

IF failed = 0 THEN PRINT "RESULTS: 1 passed, 0 failed" ELSE PRINT "RESULTS: 0 passed, 1 failed"
