' OS.EXEC hands back the output of a console program as UTF-8: bytes in
' the OEM codepage (0x81 is u with umlaut in 437 and 850) are converted,
' UTF-8 output stays as it is.
DIM path$ = MKTEMP$("oem") + ".txt"
DIM u_uml$ = CHR$(195) + CHR$(188)
DIM sharp_s$ = CHR$(195) + CHR$(159)
DIM bad = 0

TXTWRITER path$, "Ung" + CHR$(129) + "ltig"
DIM r = OS.EXEC("cmd", ["/c", "type", REPLACE$(path$, "/", "\")])
IF TRIM$(r{"OUTPUT"}) = "Ung" + u_uml$ + "ltig" THEN
    PRINT "PASS an OEM byte becomes UTF-8"
ELSE
    PRINT "FAIL an OEM byte: got ["; r{"OUTPUT"}; "]"
    bad = bad + 1
ENDIF

DIM word$ = "Gr" + u_uml$ + sharp_s$ + "e " + CHR$(8364)
TXTWRITER path$, word$
DIM u = OS.EXEC("cmd", ["/c", "type", REPLACE$(path$, "/", "\")])
IF TRIM$(u{"OUTPUT"}) = word$ THEN
    PRINT "PASS UTF-8 output stays as it is"
ELSE
    PRINT "FAIL UTF-8 output: got ["; u{"OUTPUT"}; "]"
    bad = bad + 1
ENDIF
KILL path$

IF bad = 0 THEN PRINT "ALL TESTS PASSED!" ELSE PRINT bad; " failed"
