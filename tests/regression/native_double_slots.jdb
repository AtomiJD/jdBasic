' ============================================================
' Regression: DOUBLE slots and STRING globals under native -c
' ============================================================
' Self-checking. Each failure prints [FAIL].
' Green in the interpreter by construction; the point is `-c`.
'
' Covers three codegen defects:
'   1. FOR with a control variable declared AS DOUBLE ran the counter in
'      i64 and stored the bits in the double slot, so the body read ~0.
'      A fractional STEP truncated to 0 and the loop never terminated.
'   2. `\` with a DOUBLE operand had no case in the float branch of the
'      binary-op switch and fell through to a constant 0.
'   3. `DIM s AS STRING` without a $ suffix left an integer slot, so a SUB
'      could not write to it and LEN() inside a FUNC picked the array
'      overload and read heap bytes past the text.

OPTION "EXPLICIT"
OPTION "STRICT"

DIM PASS_COUNT AS INTEGER = 0
DIM FAIL_COUNT AS INTEGER = 0

SUB CHECK_EQ(name$, expected, actual)
    IF expected = actual THEN
        PASS_COUNT = PASS_COUNT + 1
    ELSE
        FAIL_COUNT = FAIL_COUNT + 1
        PRINT "[FAIL] "; name$; "  expected="; expected; "  actual="; actual
    ENDIF
ENDSUB

SUB CHECK_STR(name$, expected$, actual$)
    IF expected$ = actual$ THEN
        PASS_COUNT = PASS_COUNT + 1
    ELSE
        FAIL_COUNT = FAIL_COUNT + 1
        PRINT "[FAIL] "; name$; "  expected="; expected$; "  actual="; actual$
    ENDIF
ENDSUB

' ── 1. FOR with a DOUBLE control variable ──────────────────────────────

DIM d AS DOUBLE
DIM i AS INTEGER
DIM seen AS DOUBLE
DIM steps AS INTEGER

seen = 0
FOR d = 1 TO 3
    seen = seen + d
NEXT d
CHECK_EQ("for double var sums 1+2+3", 6, seen)

seen = 0
steps = 0
FOR d = 0 TO 1 STEP 0.5
    seen = seen + d
    steps = steps + 1
NEXT d
CHECK_EQ("for double step 0.5 iterates 3x", 3, steps)
CHECK_EQ("for double step 0.5 sums 0+0.5+1", 1.5, seen)

steps = 0
FOR d = 3 TO 1 STEP -1
    steps = steps + 1
NEXT d
CHECK_EQ("for double var counts down", 3, steps)

seen = 0
FOR i = 1 TO 3
    seen = seen + i
NEXT i
CHECK_EQ("for integer var still sums 1+2+3", 6, seen)

' ── 2. Integer division with a DOUBLE operand ──────────────────────────
' `\` divides then truncates the quotient toward zero, which is why
' 7.9 \ 2.9 is 2 and not 3.

DIM a AS DOUBLE
DIM b AS DOUBLE

a = 80
b = 80
CHECK_EQ("80 \ 80 on doubles", 1, a \ b)

a = 7.9
b = 2.9
CHECK_EQ("7.9 \ 2.9 truncates the quotient", 2, a \ b)

a = -7.9
CHECK_EQ("-7.9 \ 2.9 truncates toward zero", -2, a \ b)

a = 7.5
b = 2
CHECK_EQ("7.5 \ 2", 3, a \ b)

a = -7
CHECK_EQ("-7 \ 2", -3, a \ b)

CHECK_EQ("integer operands unchanged", 5, 11 \ 2)
CHECK_EQ("MOD on doubles unchanged", 3, 80 MOD 7)

' ── 3. STRING globals across function bodies ───────────────────────────

DIM gtext AS STRING
DIM gbuilt AS STRING

SUB SET_GLOBAL_STRING()
    gtext = "written from a SUB"
ENDSUB

FUNC LEN_FROM_FUNC() AS INTEGER
    RETURN LEN(gtext)
ENDFUNC

FUNC BYTE_FROM_FUNC(idx AS INTEGER) AS INTEGER
    RETURN BYTEAT(gtext, idx)
ENDFUNC

SET_GLOBAL_STRING()
CHECK_STR("SUB wrote the string global", "written from a SUB", gtext)
CHECK_EQ("LEN at top level", 18, LEN(gtext))
CHECK_EQ("LEN inside a FUNC", 18, LEN_FROM_FUNC())
CHECK_EQ("BYTEAT inside a FUNC", 119, BYTE_FROM_FUNC(0))

' A runtime-built string, so the value is heap memory rather than a literal.
gbuilt = ""
FOR i = 1 TO 5
    gbuilt = gbuilt + CHR$(64 + i)
NEXT i
gtext = gbuilt
CHECK_STR("built string round trip", "ABCDE", gtext)
CHECK_EQ("LEN of a built string inside a FUNC", 5, LEN_FROM_FUNC())
CHECK_EQ("BYTEAT of a built string inside a FUNC", 69, BYTE_FROM_FUNC(4))

' String arrays must stay arrays: the scalar-string case must not swallow
' `DIM names[N] AS STRING`, which desugars to an array.
DIM names[4] AS STRING
names[0] = "alpha"
names[3] = "delta"
CHECK_STR("string array element", "alpha", names[0])
CHECK_STR("string array tail element", "delta", names[3])
CHECK_EQ("string array LEN is the count", 4, LEN(names))

' ── 4. A string array element assigned to a STRING global from a SUB ────
' The element arrives runtime-tagged. Letting it retag the global left every
' function body reading that global on the runtime dispatch, whose non-string
' arm answers 0, so the value looked fine at top level and empty inside a FUNC.

DIM slot[4] AS STRING
DIM gsel AS STRING

SUB PICK(idx AS INTEGER)
    gsel = slot[idx]
ENDSUB

SUB PICK_LITERAL()
    gsel = "literal"
ENDSUB

FUNC SEL_LEN() AS INTEGER
    RETURN LEN(gsel)
ENDFUNC

FUNC SEL_BYTE(idx AS INTEGER) AS INTEGER
    RETURN BYTEAT(gsel, idx)
ENDFUNC

slot[0] = "hello"
slot[2] = "kernel"

PICK_LITERAL()
CHECK_STR("literal via SUB", "literal", gsel)
CHECK_EQ("literal LEN in a FUNC", 7, SEL_LEN())

PICK(0)
CHECK_STR("array element via SUB", "hello", gsel)
CHECK_EQ("array element LEN at top level", 5, LEN(gsel))
CHECK_EQ("array element LEN in a FUNC", 5, SEL_LEN())
CHECK_EQ("array element BYTEAT in a FUNC", 104, SEL_BYTE(0))

PICK(2)
CHECK_STR("second element via SUB", "kernel", gsel)
CHECK_EQ("second element LEN in a FUNC", 6, SEL_LEN())

' The reading function declared BEFORE the writing SUB is the order that
' failed: a pre-pass promoted the global to runtime-tagged after scanning the
' whole file, so the reader was already compiled around the wrong shape.

DIM early[4] AS STRING
DIM gearly AS STRING

FUNC EARLY_LEN() AS INTEGER
    RETURN LEN(gearly)
ENDFUNC

SUB EARLY_PICK(idx AS INTEGER)
    gearly = early[idx]
ENDSUB

early[1] = "freestanding"
EARLY_PICK(1)
CHECK_STR("reader declared first, value", "freestanding", gearly)
CHECK_EQ("reader declared first, LEN at top level", 12, LEN(gearly))
CHECK_EQ("reader declared first, LEN in the FUNC", 12, EARLY_LEN())

' ── Summary ────────────────────────────────────────────────────────────

PRINT "============================================="
PRINT "RESULTS: "; PASS_COUNT; " passed, "; FAIL_COUNT; " failed"
PRINT "============================================="
