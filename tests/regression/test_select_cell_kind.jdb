' A lambda that answers a cell of an array hands SELECT the cell with its
' kind: rows stay rows, strings stay strings, numbers stay numbers, also for
' a builtin that reads the result through the bridge.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

DIM freq = TALLY(-"abbccc")
DIM order = [2, 1, 0]
DIM picked = SELECT(LAMBDA i -> freq[i], order)
Check(LEN(picked) = 3, "three rows")
Check(picked[0][0] = "c", "row read in place")
Check(picked[0][1] = 3, "count read in place")
DIM lf$ = CHR$(10)
Check(FRMV$(picked, "{}={}") = "c=3" + lf$ + "b=2" + lf$ + "a=1" + lf$, "rows through a builtin")

DIM names$ = ["x", "y", "z"]
DIM back = SELECT(LAMBDA i -> names$[i], order)
Check(JOIN(back, ",") = "z,y,x", "strings picked by index")

DIM nums = [10, 20, 30]
DIM again = SELECT(LAMBDA i -> nums[i], order)
Check(SUM(again) = 60, "numbers picked by index")
Check(again[0] + 1 = 31, "a picked number in arithmetic")

DIM recs = [{"N": 1}, {"N": 2}]
DIM flipped = SELECT(LAMBDA i -> recs[i], [1, 0])
Check(flipped[0]{"N"} = 2, "maps picked by index")

IF failed > 0 THEN END 1
PRINT "OK"
