' ── Array manipulation ──────────────────────────────
PRINT "APPEND([1,2], [3,4]) = "; APPEND([1,2], [3,4])
PRINT "APPEND([1,2], 99) = "; APPEND([1,2], 99)
PRINT "DIFF([1,2,3,4,5], [2,4]) = "; DIFF([1,2,3,4,5], [2,4])
PRINT "TAKE(3, IOTA(10)) = "; TAKE(3, IOTA(10))
PRINT "TAKE(-3, IOTA(10)) = "; TAKE(-3, IOTA(10))
PRINT "DROP(3, IOTA(6)) = "; DROP(3, IOTA(6))
PRINT "REVERSE(IOTA(5)) = "; REVERSE(IOTA(5))
PRINT "UNIQUE([1,2,2,3,3,3]) = "; UNIQUE([1,2,2,3,3,3])
PRINT "FIND_IN_ARRAY([10,20,30], 20) = "; FIND_IN_ARRAY([10,20,30], 20)
PRINT "ROTATE([1,2,3,4,5], 2) = "; ROTATE([1,2,3,4,5], 2)
PRINT "SHIFT([1,2,3,4,5], 2) = "; SHIFT([1,2,3,4,5], 2)
PRINT "GRADE([30,10,20]) = "; GRADE([30,10,20])
PRINT "XSORT([3,1,4,1,5]) = "; XSORT([3,1,4,1,5])
PRINT "NORMALIZE([2,4,6,8,10]) = "; NORMALIZE([2,4,6,8,10])

' ── Reductions ────────────────────────────────────
PRINT ""
PRINT "SUM(IOTA(100)) = "; SUM(IOTA(100))
PRINT "PRODUCT(IOTA(5)) = "; PRODUCT(IOTA(5))
PRINT "MIN([5,2,8,1,9]) = "; MIN([5,2,8,1,9])
PRINT "MAX([5,2,8,1,9]) = "; MAX([5,2,8,1,9])
PRINT "ANY([0,0,1,0]) = "; ANY([0,0,1,0])
PRINT "ALL([1,1,1]) = "; ALL([1,1,1])
PRINT "SCAN('+', IOTA(5)) = "; SCAN("+", IOTA(5))

' ── Matrix operations ─────────────────────────────
PRINT ""
DIM M = RESHAPE(IOTA(6), [2,3])
PRINT "M = "; M
PRINT "TRANSPOSE(M) = "; TRANSPOSE(M)
PRINT "SLICE(M, 0, 1) = "; SLICE(M, 0, 1)
PRINT "SLICE(M, 1, 0) = "; SLICE(M, 1, 0)

DIM A = RESHAPE([1,2,3,4], [2,2])
DIM B = RESHAPE([5,6,7,8], [2,2])
PRINT "MATMUL(A,B) = "; MATMUL(A, B)

PRINT "STACK(0,[1,2],[3,4]) = "; STACK(0, [1,2], [3,4])

' ── Linear algebra ────────────────────────────────
PRINT ""
DIM S = RESHAPE([2,1,1,3], [2,2])
PRINT "SOLVE([[2,1],[1,3]], [5,7]) = "; SOLVE(S, [5,7])
PRINT "INVERT([[2,1],[1,3]]) = "; INVERT(S)

' ── OUTER ─────────────────────────────────────────
PRINT ""
PRINT "OUTER([1,2,3],[1,2,3],'*') = "; OUTER([1,2,3], [1,2,3], "*")

' ── SUM with dimension ────────────────────────────
DIM D = RESHAPE(IOTA(6), [2,3])
PRINT "D = "; D
PRINT "SUM(D, 0) = "; SUM(D, 0)
PRINT "SUM(D, 1) = "; SUM(D, 1)

' ── Higher-order: SELECT, FILTER, REDUCE ──────────
PRINT ""
FUNCTION Double(x)
    RETURN x * 2
END FUNCTION

FUNCTION IsEven(x)
    RETURN x MOD 2 = 0
END FUNCTION

FUNCTION Add(a, b)
    RETURN a + b
END FUNCTION

PRINT "SELECT(Double@, IOTA(5)) = "; SELECT(Double@, IOTA(5))
PRINT "FILTER(IsEven@, IOTA(10)) = "; FILTER(IsEven@, IOTA(10))
PRINT "REDUCE(Add@, IOTA(5)) = "; REDUCE(Add@, IOTA(5))

' ── LERP ──────────────────────────────────────────
PRINT ""
PRINT "LERP(0, 10, 0.5) = "; LERP(0, 10, 0.5)
PRINT "DISTANCE([0,0], [3,4]) = "; DISTANCE([0,0], [3,4])

' ── INTEGRATE ─────────────────────────────────────
FUNCTION Square(x)
    RETURN x * x
END FUNCTION

PRINT "INTEGRATE(Square@, [0,1]) = "; INTEGRATE(Square@, [0, 1])
