' Element-wise operators and builtins that a compiled program answered
' wrong: integer division of arrays, ROUND of an array with places, and a
' string array or a number array joined with a string.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

DIM v AS ARRAY = [3, 1, 2]
DIM w AS ARRAY = [10, 20, 30]
DIM s AS ARRAY = ["b", "a", "c"]
DIM m AS ARRAY = [[7, 8], [9, 10]]

Check(JOIN(w \ v, ",") = "3,20,15", "array \ array")
Check(JOIN(w \ 3, ",") = "3,6,10", "array \ number")
Check(JOIN(100 \ w, ",") = "10,5,3", "number \ array")
Check(JOIN(FLATTEN(m \ 2), ",") = "3,4,4,5", "matrix \ number")
Check(JOIN(ROUND([1.25, 1.35], 1), ",") = "1.3,1.4", "ROUND of an array with places")
Check(JOIN(ROUND([1234, 5678], -2), ",") = "1200,5700", "ROUND of an array with negative places")
Check(JOIN(FLATTEN(ROUND([[1.234, 5.678]], 2)), ",") = "1.23,5.68", "ROUND of a matrix with places")
Check(JOIN(s + "!", "") = "b!a!c!", "string array plus string")
Check(JOIN("<" + s, "") = "<b<a<c", "string plus string array")
Check(JOIN([1, 2] + "x", ",") = "1x,2x", "number array plus string")
Check(JOIN("n" + [1.5, 2], ",") = "n1.5,n2", "string plus number array")

IF failed > 0 THEN END 1
PRINT "OK"
