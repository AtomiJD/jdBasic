' Values whose shape only the running program knows, in the forms real
' programs write them: a number or a vector written over a matrix row, a
' VM map handed to a MAP parameter, kind tests on element reads, a key
' path into a VM map, minus on a cell of unknown kind, FORMAT_DATE$ on a
' cell inside a call, a parameter handed on from a mixed-site answer, a
' map cell read by MEAN, and a sum carried through a loop.

DIM failed AS INTEGER = 0

SUB Check(ok AS BOOLEAN, what AS STRING)
    IF NOT ok THEN
        PRINT "FAIL "; what
        failed = failed + 1
    ENDIF
ENDSUB

' --- a number or a vector written over a matrix row ---
SUB FillRow(grid, r AS INTEGER, v AS INTEGER)
    grid[r] = v
ENDSUB

SUB PatternRow(grid, r AS INTEGER, pattern)
    grid[r] = pattern
ENDSUB

DIM stats = RESHAPE(IOTA(9), [3, 3])
stats[1] = 0
Check(SUM(stats[1]) = 0 ANDALSO LEN(stats[1]) = 3, "a number fills a matrix row")
DIM w = 0
DIM l = 0
DIM v = 0
[w, l, v] = stats[2]
Check(w = 7 AND l = 8 AND v = 9, "a row after the fill destructures")

DIM g = RESHAPE(IOTA(12), [3, 4])
FillRow(g, 0, 7)
Check(SUM(g[0]) = 28, "a number fills a row through a SUB parameter")
PatternRow(g, 2, [1, 0])
Check(g[2][0] = 1 AND g[2][1] = 0 AND g[2][2] = 1 AND g[2][3] = 0, "a shorter vector repeats across a row")
DIM cube = RESHAPE(IOTA(8), [2, 2, 2])
cube[0] = 99
Check(SUM(cube[0]) = 396 ANDALSO SUM(cube[1]) = 26, "a number fills a layer of a cube")

TYPE ShapePt
    px AS DOUBLE
ENDTYPE
DIM pa AS ShapePt
DIM pb AS ShapePt
pa.px = 1
pb.px = 2
DIM objs = [pa, pb]
objs[0] = 0
Check(objs[0] = 0 AND pb.px = 2, "a number over a UDT cell replaces the cell")

' --- a VM map handed to a MAP parameter; kind tests on element reads ---
FUNC Has(rec AS MAP, f$) AS BOOLEAN
    RETURN MAP.EXISTS(rec, f$)
ENDFUNC

FUNC IsNumField(rec AS MAP, f$) AS BOOLEAN
    RETURN ISNUM(rec{f$})
ENDFUNC

DIM rec = {}
rec = JSON.PARSE("{""id"": 1, ""user"": ""ada""}")
Check(Has(rec, "id") AND NOT Has(rec, "zz"), "MAP.EXISTS on a VM map through a MAP parameter")
Check(IsNumField(rec, "id") AND NOT IsNumField(rec, "user"), "ISNUM of a key read through a MAP parameter")
DIM mixed = [1, "x", [2]]
Check(ISNUM(mixed[0]) AND ISSTR(mixed[1]) AND ISARR(mixed[2]), "kind tests on cells of a mixed array")

' --- a key path into a VM map, at top level and in a SUB ---
DIM cfg = JSON.PARSE("{""server"": {""host"": ""a"", ""port"": 8080}}")
SUB PutKey(s$, k$, val$)
    cfg{s$}{k$} = val$
ENDSUB
cfg{"server"}{"port"} = 9443
PutKey("server", "host", "z")
Check(cfg{"server"}{"port"} = 9443, "a key path written at top level")
Check(cfg{"server"}{"host"} = "z", "a key path written in a SUB")

' --- minus on a cell of unknown kind; a string array FILTER keeps ---
FUNC WordsOf(s$) AS ARRAY
    RETURN FILTER(LAMBDA wd -> LEN(wd) > 0, SPLIT(s$, " "))
ENDFUNC

DIM fields = []
fields = SPLIT("A-17,4x", ",")
DIM bad = FILTER(LAMBDA c -> INSTR("0123456789", c) < 0, -TRIM$(fields[1]))
Check(LEN(bad) = 1 ANDALSO bad[0] = "x", "minus splits a string cell into characters")
DIM words = WordsOf("level ab noon")
DIM pals = FILTER(LAMBDA wd -> JOIN(REVERSE(-wd), "") = wd, words)
Check(LEN(pals) = 2 ANDALSO pals[1] = "noon", "a FILTERed string array keeps string cells")

' --- FORMAT_DATE$ on a cell inside a call ---
FUNC Weekday$(key$, wd AS INTEGER)
    RETURN key$ + "/" + STR$(wd)
ENDFUNC

DIM days = DATERANGE(CVDATE("2026-03-01"), CVDATE("2026-03-03"), "D")
Check(Weekday$(FORMAT_DATE$(days[1], "%Y-%m-%d"), CINT(WEEKDAY(days[1]))) = "2026-03-02/1", "FORMAT_DATE$ of a date cell handed to a string parameter")

' --- a parameter handed on from a mixed-site answer ---
FUNC FracPart(x)
    RETURN x - TRUNC(x)
ENDFUNC

FUNC Near(got, want)
    RETURN ABS(got - want) < 0.000001
ENDFUNC

SUB Relay(got, want)
    Check(Near(got, want), "a mixed-site answer handed on through two parameters")
ENDSUB

DIM fracs = FracPart([3.75, -3.75])
Relay(FracPart(-0.25), -0.25)
Check(LEN(fracs) = 2 ANDALSO ABS(fracs[0] - 0.75) < 0.000001, "the array call site of the same FUNC")

FUNC ToCents(amount)
    RETURN FLOOR(amount * 100 + 0.5)
ENDFUNC

DIM prices = [4.99, 0.35]
Check(ToCents(19.99) = 1999, "a number where another site hands a top-level array")
Check(SUM(ToCents(prices)) = 534, "the array site through a top-level variable")

' --- a map cell read by MEAN; a sum carried through a loop ---
FUNC Spread(xs)
    DIM m = MEAN(xs)
    RETURN SUM(ABS(xs - m))
ENDFUNC

FUNC Total(jobs)
    DIM t = 0
    FOR i = 0 TO LEN(jobs) - 1
        t = t + jobs[i]
    NEXT
    RETURN t
ENDFUNC

FUNC Divisor(weights, scale)
    DIM d = scale
    IF d = 0 THEN
        FOR i = 0 TO LEN(weights) - 1
            d = d + weights[i]
        NEXT
    ENDIF
    RETURN d
ENDFUNC

DIM batches = {"A": [12, 15, 11, 14, 13]}
DIM key$ = "A"
Check(Spread(batches{key$}) = 6, "MEAN and SUM of a map cell through an untyped parameter")
Check(Total([17, 23, 8.5]) = 48.5, "a sum of array cells carried through a loop")
Check(Divisor([1, 2, 3], 0) = 6, "a sum in a loop inside a branch that runs")
Check(Divisor([1, 2, 3], 16) = 16, "the same variable when the branch is skipped")

' --- TAKE and DROP hand on the cells of a string array ---
DIM waiting = ["A", "B", "C", "D", "E"]
DIM cargo = []
DIM trips AS INTEGER = 0
DO WHILE LEN(waiting) > 0
    trips = trips + 1
    cargo = TAKE(2, waiting)
    waiting = DROP(2, waiting)
LOOP
Check(trips = 3 ANDALSO LEN(cargo) = 1 ANDALSO cargo[0] = "E", "TAKE and DROP of a string array in a loop")

' --- LEN of a cell into a number, texts appended to a global in a SUB ---
FUNC Widest(cells AS ARRAY, minWidth = 0) AS INTEGER
    DIM best AS INTEGER = minWidth
    FOR i = 0 TO LEN(cells) - 1
        IF LEN(cells[i]) > best THEN best = LEN(cells[i])
    NEXT
    RETURN best
ENDFUNC

DIM regions = []
SUB AddRegion(r$)
    regions = APPEND(regions, r$)
ENDSUB
AddRegion("North")
AddRegion("South-East")
Check(Widest(regions, 3) = 10, "LEN of a text cell assigned to an INTEGER")
Check(regions[1] + "!" = "South-East!", "a global a SUB filled with texts reads them back")

' --- kind tests on a parameter, a mixed answer, truth values in cells ---
FUNC Kind$(tok)
    IF ISBOOL(tok) THEN RETURN "flag"
    IF ISNUM(tok) THEN RETURN "num"
    IF ISSTR(tok) THEN RETURN "word"
    RETURN "?"
ENDFUNC

FUNC Tokens(line$)
    DIM parts = []
    FOR EACH w$ IN SPLIT(line$, " ")
        IF w$ = "yes" OR w$ = "no" THEN
            parts = APPEND(parts, w$ = "yes")
        ELSEIF INSTR("0123456789", LEFT$(w$, 1)) >= 0 THEN
            parts = APPEND(parts, VAL(w$))
        ELSE
            parts = APPEND(parts, w$)
        ENDIF
    NEXT
    RETURN parts
ENDFUNC

DIM toks = Tokens("crate 12 yes")
Check(Kind$(toks[0]) = "word" AND Kind$(toks[1]) = "num" AND Kind$(toks[2]) = "flag", "kind tests on cells of a mixed answer")
DIM flags = [TRUE]
flags = APPEND(flags, 3)
Check(ISBOOL(flags[0]) AND NOT ISBOOL(flags[1]), "a number appended to truth values keeps both kinds")

' --- a variable DIMmed AS INTEGER summing cells of a 2D array ---
DIM grid2[2, 3]
grid2[1, 0] = 8
grid2[1, 1] = 9
grid2[1, 2] = 10
DIM rowsum AS INTEGER = 0
FOR c2 = 0 TO 2
    rowsum = rowsum + grid2[1, c2]
NEXT
Check(rowsum = 27, "a declared INTEGER keeps its kind when cells are added in a loop")

' --- a text variable written into a cell, then reassigned ---
FUNC Mirror(v AS INTEGER) AS INTEGER
    RETURN 3 - v
ENDFUNC
DIM letters = SPLIT("A,B,C,D", ",")
DIM perm = []
FOR q = 0 TO 3
    perm = APPEND(perm, Mirror(q))
NEXT
DIM held$ = ""
FOR q = 0 TO 3
    IF q < perm[q] THEN
        held$ = letters[q]
        letters[q] = letters[perm[q]]
        letters[perm[q]] = held$
    ENDIF
NEXT
Check(JOIN(letters, "") = "DCBA", "a text variable stored in a cell keeps the cell valid")

' --- an index whose kind only the run knows, inside loops ---
FUNC FewestCoins(coins, target AS INTEGER)
    DIM best = [0]
    DIM pick = [0]
    FOR v = 1 TO target
        best = APPEND(best, -1)
        pick = APPEND(pick, 0)
        FOR EACH c IN coins
            IF c <= v ANDALSO best[v - c] >= 0 ANDALSO (best[v] < 0 ORELSE best[v - c] + 1 < best[v]) THEN
                best[v] = best[v - c] + 1
                pick[v] = c
            ENDIF
        NEXT
    NEXT
    DIM used = []
    DIM rest = target
    DO WHILE rest > 0 ANDALSO best[target] >= 0
        used = APPEND(used, pick[rest])
        rest = rest - pick[rest]
    LOOP
    RETURN used
ENDFUNC

DIM coinSpec = JSON.PARSE("{""coins"": [1, 7, 10, 22]}")
Check(JOIN(FewestCoins(coinSpec{"coins"}, 14), ",") = "7,7", "a cell difference indexes inside a FOR EACH")
Check(JOIN(FewestCoins([1, 7, 10, 22], 29), ",") = "7,22", "a loop variable fed by a mixed array cell")

FUNC PeekAt(xs)
    DIM out$ = ""
    DIM ref = [10, 20, 30, 40]
    FOR EACH x IN xs
        out$ = out$ + STR$(ref[3 - x])
    NEXT
    RETURN out$
ENDFUNC
Check(PeekAt([1, 2]) = "3020", "a runtime-typed index into a local array")

' --- a row written back into the cell it was read from, in a loop ---
DIM tally = RESHAPE(IOTA(12) * 0, [3, 4])
SUB Bump(club AS INTEGER, n AS INTEGER)
    DIM rowCopy = tally[club]
    rowCopy[1] = rowCopy[1] + n
    tally[club] = rowCopy
ENDSUB
FOR q = 0 TO 2
    Bump(q, 1)
    Bump(2 - q, 2)
NEXT
DIM churn = [[9, 9, 9, 9], [9, 9, 9, 9]]
Check(SUM(SLICE(tally, 1, 1)) = 9 ANDALSO tally[0][1] = 3, "a row written back into its own cell stays valid")

' --- SWITCH ranges on a value of run-time kind ---
FUNC Bands$(xs)
    DIM out$ = ""
    FOR EACH x IN xs
        SWITCH x
            CASE 1 TO 5
                out$ = out$ + "l"
            CASE 6
                out$ = out$ + "s"
            DEFAULT
                out$ = out$ + "h"
        ENDSWITCH
    NEXT
    RETURN out$
ENDFUNC
Check(Bands$([3, 6, 9]) = "lsh", "SWITCH on cells of a native array")
Check(Bands$(JSON.PARSE("[2, 6, 70]")) = "lsh", "SWITCH on cells of a VM array")

' --- ISNONE on a parameter, keys typed AS STRING ---
FUNC FieldKind$(v)
    IF ISNONE(v) THEN RETURN "missing"
    IF ISNUM(v) THEN RETURN "number"
    RETURN "other"
ENDFUNC
DIM parsedCfg = JSON.PARSE("{""a"": 1}")
DIM nativeCfg = {"a": 1}
DIM gone$ = "zz"
Check(FieldKind$(parsedCfg{"zz"}) = "missing" ANDALSO FieldKind$(parsedCfg{"a"}) = "number", "ISNONE of a VM map miss through a parameter")
Check(FieldKind$(nativeCfg{gone$}) = "missing" ANDALSO FieldKind$(5) = "number", "ISNONE of a native map miss through a parameter")

SUB Debit(m AS MAP, item AS STRING, n AS INTEGER)
    m{item} = m{item} - n
ENDSUB
DIM stockMap = {"bolt": 120}
Debit(stockMap, "bolt", 5)
Check(stockMap{"bolt"} = 115, "a map key held in a variable AS STRING")

' --- MAP fields and MAP parameters of a user type ---
TYPE Shelf
    Stock AS MAP
    SUB INIT(m AS MAP, item AS STRING, n AS INTEGER)
        THIS.Stock = {"seed": 1}
        m{item} = m{item} - n
    ENDSUB
    FUNC Total() AS DOUBLE
        DIM t = 0.0
        FOR EACH k IN MAP.KEYS(THIS.Stock)
            t = t + THIS.Stock{k}
        NEXT
        RETURN t
    ENDFUNC
    SUB Put(item AS STRING, n AS DOUBLE)
        DIM m = THIS.Stock
        m{item} = n
    ENDSUB
ENDTYPE
DIM store = {"bolt": 120}
DIM shelfA AS Shelf(store, "bolt", 25)
shelfA.Put("rice", 2.5)
Check(store{"bolt"} = 95, "a MAP parameter of INIT writes the caller's map")
Check(shelfA.Total() = 3.5, "MAP.KEYS and reads of a MAP field with an untyped key")

' --- JOIN of values a channel handed out ---
DIM ring = CHAN.OPEN(3, "ring")
FOR EACH entry$ IN ["boot", "sync", "idle"]
    CHAN.SEND ring, entry$
NEXT
DIM drained = []
DIM got = CHAN.TRY_RECV(ring)
DO WHILE NOT (CHAN.IS_TIMEOUT(got) ORELSE CHAN.IS_EOF(got))
    drained = APPEND(drained, got)
    got = CHAN.TRY_RECV(ring)
LOOP
Check(JOIN(drained, "|") = "boot|sync|idle", "JOIN of values received from a channel")

' --- numbers received from a channel, summed by array builtins ---
DIM feed = CHAN.OPEN(4)
CHAN.SEND feed, 120
CHAN.SEND feed, 80
CHAN.CLOSE feed
DIM samplesIn = []
DIM msgIn = CHAN.TRY_RECV(feed)
DO WHILE NOT (CHAN.IS_TIMEOUT(msgIn) ORELSE CHAN.IS_EOF(msgIn))
    samplesIn = APPEND(samplesIn, msgIn)
    msgIn = CHAN.TRY_RECV(feed)
LOOP
Check(MEAN(samplesIn) = 100 ANDALSO MAX(samplesIn) = 120, "MEAN and MAX of numbers received from a channel")

' --- a method calling one the TYPE lists further down; AGG answered by a FUNC ---
TYPE Banner
    Wide AS INTEGER
    SUB INIT(w AS INTEGER)
        THIS.Wide = w
        THIS.Draw("=")
    ENDSUB
    SUB Draw(ch$)
        bannerLine$ = REPLACE$(SPACE$(THIS.Wide), " ", ch$)
    ENDSUB
ENDTYPE
DIM bannerLine$ = ""
DIM banner AS Banner(3)
Check(bannerLine$ = "===", "INIT calls a method declared after it")

FUNC SumsBy(keys AS ARRAY, amounts AS ARRAY)
    RETURN AGG(keys, amounts, LAMBDA grp -> SUM(grp))
ENDFUNC
DIM grouped = SumsBy(["a", "b", "a"], [1, 2, 3])
Check(LEN(grouped) = 2 ANDALSO JOIN(SLICE(grouped, 1, 0), ",") = "a,b", "a FUNC answers what AGG built")

' --- an IIF arm read from a cell whose kind only the run knows ---
FUNC PassOn(xs)
    RETURN xs
ENDFUNC
DIM handed = PassOn(["a", "b", "c"])
Check(IIF(handed[1] = "", "-", handed[1]) = "b", "an IIF arm that is a text cell of an untyped answer")
DIM parts = REGEX.MATCH("^( *)([0-9]+[.)])(?:([ \t]+)(.*))?$", "3.")
Check(IIF(parts[2] = "", " ", parts[2]) = " ", "an IIF arm over an empty capture group")
DIM nums = PassOn([4, 5])
Check(IIF(nums[0] > 4, nums[0], nums[1]) + 1 = 6, "an IIF arm that is a number cell stays a number")
DIM picked = IIF([7, 1, 9] > 5, nums[0], nums[1])
Check(LEN(picked) = 3 ANDALSO picked[0] = 4 ANDALSO picked[1] = 5, "an array condition picks cell arms cell by cell")

' --- a global text array that also takes text cell writes ---
DIM board = []
SUB FillBoard()
    board = []
    FOR EACH g$ IN SPLIT("#,R,c", ",")
        board = APPEND(board, g$)
    NEXT
ENDSUB
FillBoard()
board[1] = "."
Check(JOIN(board, "") = "#.c" ANDALSO board[2] + "!" = "c!", "a global text array written cell by cell")

' --- a reactive binding stops a compiled program with a message ---
IF NOT OS.FEATURE("INTERPRETER") THEN
    DIM rx AS REACT INTEGER
    DIM ry AS REACT INTEGER
    DIM stopped AS BOOLEAN = FALSE
    TRY
        ry -> rx * 2
    CATCH
        stopped = INSTR(ERRMSG$, "reactive binding") >= 0
    ENDTRY
    Check(stopped, "a reactive binding raises an error natively")
ENDIF

IF failed = 0 THEN
    PRINT "ALL NATIVE RUNTIME SHAPE TESTS PASSED!"
ELSE
    PRINT failed; " failed"
    END 1
ENDIF
