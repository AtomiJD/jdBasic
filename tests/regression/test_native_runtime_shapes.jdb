' Values whose shape only the running program knows, in the forms real
' programs write them: a number or a vector written over a matrix row, a
' VM map handed to a MAP parameter, kind tests on element reads, a key
' path into a VM map, minus on a cell of unknown kind, FORMAT_DATE$ on a
' cell inside a call, a parameter handed on from a mixed-site answer, a
' map cell read by MEAN, and a sum carried through a loop.

DIM failed AS INTEGER = 0

SUB Check(ok AS BOOLEAN, what AS STRING)
    IF NOT ok THEN
        PRINT "FAIL "; what
        failed = failed + 1
    ENDIF
ENDSUB

' --- a number or a vector written over a matrix row ---
SUB FillRow(grid, r AS INTEGER, v AS INTEGER)
    grid[r] = v
ENDSUB

SUB PatternRow(grid, r AS INTEGER, pattern)
    grid[r] = pattern
ENDSUB

DIM stats = RESHAPE(IOTA(9), [3, 3])
stats[1] = 0
Check(SUM(stats[1]) = 0 ANDALSO LEN(stats[1]) = 3, "a number fills a matrix row")
DIM w = 0
DIM l = 0
DIM v = 0
[w, l, v] = stats[2]
Check(w = 7 AND l = 8 AND v = 9, "a row after the fill destructures")

DIM g = RESHAPE(IOTA(12), [3, 4])
FillRow(g, 0, 7)
Check(SUM(g[0]) = 28, "a number fills a row through a SUB parameter")
PatternRow(g, 2, [1, 0])
Check(g[2][0] = 1 AND g[2][1] = 0 AND g[2][2] = 1 AND g[2][3] = 0, "a shorter vector repeats across a row")
DIM cube = RESHAPE(IOTA(8), [2, 2, 2])
cube[0] = 99
Check(SUM(cube[0]) = 396 ANDALSO SUM(cube[1]) = 26, "a number fills a layer of a cube")

TYPE ShapePt
    px AS DOUBLE
ENDTYPE
DIM pa AS ShapePt
DIM pb AS ShapePt
pa.px = 1
pb.px = 2
DIM objs = [pa, pb]
objs[0] = 0
Check(objs[0] = 0 AND pb.px = 2, "a number over a UDT cell replaces the cell")

' --- a VM map handed to a MAP parameter; kind tests on element reads ---
FUNC Has(rec AS MAP, f$) AS BOOLEAN
    RETURN MAP.EXISTS(rec, f$)
ENDFUNC

FUNC IsNumField(rec AS MAP, f$) AS BOOLEAN
    RETURN ISNUM(rec{f$})
ENDFUNC

DIM rec = {}
rec = JSON.PARSE("{""id"": 1, ""user"": ""ada""}")
Check(Has(rec, "id") AND NOT Has(rec, "zz"), "MAP.EXISTS on a VM map through a MAP parameter")
Check(IsNumField(rec, "id") AND NOT IsNumField(rec, "user"), "ISNUM of a key read through a MAP parameter")
DIM mixed = [1, "x", [2]]
Check(ISNUM(mixed[0]) AND ISSTR(mixed[1]) AND ISARR(mixed[2]), "kind tests on cells of a mixed array")

' --- a key path into a VM map, at top level and in a SUB ---
DIM cfg = JSON.PARSE("{""server"": {""host"": ""a"", ""port"": 8080}}")
SUB PutKey(s$, k$, val$)
    cfg{s$}{k$} = val$
ENDSUB
cfg{"server"}{"port"} = 9443
PutKey("server", "host", "z")
Check(cfg{"server"}{"port"} = 9443, "a key path written at top level")
Check(cfg{"server"}{"host"} = "z", "a key path written in a SUB")

' --- minus on a cell of unknown kind; a string array FILTER keeps ---
FUNC WordsOf(s$) AS ARRAY
    RETURN FILTER(LAMBDA wd -> LEN(wd) > 0, SPLIT(s$, " "))
ENDFUNC

DIM fields = []
fields = SPLIT("A-17,4x", ",")
DIM bad = FILTER(LAMBDA c -> INSTR("0123456789", c) < 0, -TRIM$(fields[1]))
Check(LEN(bad) = 1 ANDALSO bad[0] = "x", "minus splits a string cell into characters")
DIM words = WordsOf("level ab noon")
DIM pals = FILTER(LAMBDA wd -> JOIN(REVERSE(-wd), "") = wd, words)
Check(LEN(pals) = 2 ANDALSO pals[1] = "noon", "a FILTERed string array keeps string cells")

' --- FORMAT_DATE$ on a cell inside a call ---
FUNC Weekday$(key$, wd AS INTEGER)
    RETURN key$ + "/" + STR$(wd)
ENDFUNC

DIM days = DATERANGE(CVDATE("2026-03-01"), CVDATE("2026-03-03"), "D")
Check(Weekday$(FORMAT_DATE$(days[1], "%Y-%m-%d"), CINT(WEEKDAY(days[1]))) = "2026-03-02/1", "FORMAT_DATE$ of a date cell handed to a string parameter")

' --- a parameter handed on from a mixed-site answer ---
FUNC FracPart(x)
    RETURN x - TRUNC(x)
ENDFUNC

FUNC Near(got, want)
    RETURN ABS(got - want) < 0.000001
ENDFUNC

SUB Relay(got, want)
    Check(Near(got, want), "a mixed-site answer handed on through two parameters")
ENDSUB

DIM fracs = FracPart([3.75, -3.75])
Relay(FracPart(-0.25), -0.25)
Check(LEN(fracs) = 2 ANDALSO ABS(fracs[0] - 0.75) < 0.000001, "the array call site of the same FUNC")

FUNC ToCents(amount)
    RETURN FLOOR(amount * 100 + 0.5)
ENDFUNC

DIM prices = [4.99, 0.35]
Check(ToCents(19.99) = 1999, "a number where another site hands a top-level array")
Check(SUM(ToCents(prices)) = 534, "the array site through a top-level variable")

' --- a map cell read by MEAN; a sum carried through a loop ---
FUNC Spread(xs)
    DIM m = MEAN(xs)
    RETURN SUM(ABS(xs - m))
ENDFUNC

FUNC Total(jobs)
    DIM t = 0
    FOR i = 0 TO LEN(jobs) - 1
        t = t + jobs[i]
    NEXT
    RETURN t
ENDFUNC

FUNC Divisor(weights, scale)
    DIM d = scale
    IF d = 0 THEN
        FOR i = 0 TO LEN(weights) - 1
            d = d + weights[i]
        NEXT
    ENDIF
    RETURN d
ENDFUNC

DIM batches = {"A": [12, 15, 11, 14, 13]}
DIM key$ = "A"
Check(Spread(batches{key$}) = 6, "MEAN and SUM of a map cell through an untyped parameter")
Check(Total([17, 23, 8.5]) = 48.5, "a sum of array cells carried through a loop")
Check(Divisor([1, 2, 3], 0) = 6, "a sum in a loop inside a branch that runs")
Check(Divisor([1, 2, 3], 16) = 16, "the same variable when the branch is skipped")

' --- TAKE and DROP hand on the cells of a string array ---
DIM waiting = ["A", "B", "C", "D", "E"]
DIM cargo = []
DIM trips AS INTEGER = 0
DO WHILE LEN(waiting) > 0
    trips = trips + 1
    cargo = TAKE(2, waiting)
    waiting = DROP(2, waiting)
LOOP
Check(trips = 3 ANDALSO LEN(cargo) = 1 ANDALSO cargo[0] = "E", "TAKE and DROP of a string array in a loop")

' --- LEN of a cell into a number, texts appended to a global in a SUB ---
FUNC Widest(cells AS ARRAY, minWidth = 0) AS INTEGER
    DIM best AS INTEGER = minWidth
    FOR i = 0 TO LEN(cells) - 1
        IF LEN(cells[i]) > best THEN best = LEN(cells[i])
    NEXT
    RETURN best
ENDFUNC

DIM regions = []
SUB AddRegion(r$)
    regions = APPEND(regions, r$)
ENDSUB
AddRegion("North")
AddRegion("South-East")
Check(Widest(regions, 3) = 10, "LEN of a text cell assigned to an INTEGER")
Check(regions[1] + "!" = "South-East!", "a global a SUB filled with texts reads them back")

' --- kind tests on a parameter, a mixed answer, truth values in cells ---
FUNC Kind$(tok)
    IF ISBOOL(tok) THEN RETURN "flag"
    IF ISNUM(tok) THEN RETURN "num"
    IF ISSTR(tok) THEN RETURN "word"
    RETURN "?"
ENDFUNC

FUNC Tokens(line$)
    DIM parts = []
    FOR EACH w$ IN SPLIT(line$, " ")
        IF w$ = "yes" OR w$ = "no" THEN
            parts = APPEND(parts, w$ = "yes")
        ELSEIF INSTR("0123456789", LEFT$(w$, 1)) >= 0 THEN
            parts = APPEND(parts, VAL(w$))
        ELSE
            parts = APPEND(parts, w$)
        ENDIF
    NEXT
    RETURN parts
ENDFUNC

DIM toks = Tokens("crate 12 yes")
Check(Kind$(toks[0]) = "word" AND Kind$(toks[1]) = "num" AND Kind$(toks[2]) = "flag", "kind tests on cells of a mixed answer")
DIM flags = [TRUE]
flags = APPEND(flags, 3)
Check(ISBOOL(flags[0]) AND NOT ISBOOL(flags[1]), "a number appended to truth values keeps both kinds")

' --- a variable DIMmed AS INTEGER summing cells of a 2D array ---
DIM grid2[2, 3]
grid2[1, 0] = 8
grid2[1, 1] = 9
grid2[1, 2] = 10
DIM rowsum AS INTEGER = 0
FOR c2 = 0 TO 2
    rowsum = rowsum + grid2[1, c2]
NEXT
Check(rowsum = 27, "a declared INTEGER keeps its kind when cells are added in a loop")

' --- a text variable written into a cell, then reassigned ---
FUNC Mirror(v AS INTEGER) AS INTEGER
    RETURN 3 - v
ENDFUNC
DIM letters = SPLIT("A,B,C,D", ",")
DIM perm = []
FOR q = 0 TO 3
    perm = APPEND(perm, Mirror(q))
NEXT
DIM held$ = ""
FOR q = 0 TO 3
    IF q < perm[q] THEN
        held$ = letters[q]
        letters[q] = letters[perm[q]]
        letters[perm[q]] = held$
    ENDIF
NEXT
Check(JOIN(letters, "") = "DCBA", "a text variable stored in a cell keeps the cell valid")

' --- a reactive binding stops a compiled program with a message ---
IF NOT OS.FEATURE("INTERPRETER") THEN
    DIM rx AS REACT INTEGER
    DIM ry AS REACT INTEGER
    DIM stopped AS BOOLEAN = FALSE
    TRY
        ry -> rx * 2
    CATCH
        stopped = INSTR(ERRMSG$, "reactive binding") >= 0
    ENDTRY
    Check(stopped, "a reactive binding raises an error natively")
ENDIF

IF failed = 0 THEN
    PRINT "ALL NATIVE RUNTIME SHAPE TESTS PASSED!"
ELSE
    PRINT failed; " failed"
    END 1
ENDIF
