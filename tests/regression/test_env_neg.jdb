' Test: -ARR / scalar → EXP envelope
OPTION "EXPLICIT"
OPTION "STRICT"
DIM XS = (IOTA(5) - 3) * 1.0
DIM YS = (IOTA(3) - 2) * 1.0
DIM GX = OUTER(YS*0, XS, "+")
DIM GY = OUTER(YS, XS*0, "+")
PRINT "GX:", GX
PRINT "GY:", GY
DIM DSQ = GX*GX + GY*GY
PRINT "DSQ:", DSQ
DIM SIG_SQ AS DOUBLE = 6.25
DIM A = -DSQ
PRINT "-DSQ:", A
DIM B = -DSQ / SIG_SQ
PRINT "-DSQ/SIG_SQ:", B
DIM ENV = EXP(-DSQ / SIG_SQ)
PRINT "EXP(-DSQ/SIG_SQ):", ENV
PRINT "ENV[1,2]:", ENV[1,2]
PRINT "ENV[0,0]:", ENV[0,0]
END
