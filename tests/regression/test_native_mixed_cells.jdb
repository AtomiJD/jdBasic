' Arrays whose cells are of different kinds - numbers next to rows, strings
' next to numbers - and string arrays answer cell by cell in both backends:
' reductions, arithmetic, unary math, comparisons, FLATTEN, RESHAPE, STR$,
' a gather. An ordering compare with the plain value on the left mirrors the
' operator. A gather keeps its rows when its source is replaced. FORMAT$
' keeps a placeholder of any length.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

DIM a AS ARRAY = [1, 2, 3]
a[1] = [4, 5]
Check(SUM(a) = 13, "SUM over a number and a row")
DIM ap AS ARRAY = a + 1
Check(ap[0] = 2 ANDALSO ap[1][1] = 6 ANDALSO ap[2] = 4, "ragged + number")
DIM asn AS ARRAY = SIN(a)
Check(ABS(asn[1][0] - SIN(4)) < 0.000001 ANDALSO ABS(asn[2] - SIN(3)) < 0.000001, "SIN of a ragged array")
DIM acs AS ARRAY = CUMSUM(a)
Check(acs[0] = 1 ANDALSO acs[1][1] = 9 ANDALSO acs[2] = 4, "CUMSUM of a ragged array")
DIM afl AS ARRAY = FLATTEN(a)
Check(LEN(afl) = 4 ANDALSO afl[1] = 4 ANDALSO afl[3] = 3, "FLATTEN of a ragged array")
DIM amx AS ARRAY = [[1, 2], [3, 4]]
DIM amr AS ARRAY = ROUND(amx / 3, 2)
Check(amr[1][1] = 1.33, "ROUND to places of a matrix")

DIM b AS ARRAY = [1, 2, 3]
b[1] = "x"
DIM bs AS ARRAY = b + "!"
Check(bs[0] = "1!" ANDALSO bs[1] = "x!" ANDALSO bs[2] = "3!", "mixed + string")
DIM bt AS ARRAY = STR$(b)
Check(bt[0] = "1" ANDALSO bt[1] = "x", "STR$ of a mixed array")
DIM b1 AS ARRAY = b + 1
Check(b1[0] = 2 ANDALSO b1[1] = "x1" ANDALSO b1[2] = 4, "mixed + number")
DIM b1l AS ARRAY = 1 + b
Check(b1l[1] = "1x", "number + mixed")
DIM b2 AS ARRAY = b * 2
Check(b2[1] = "xx" ANDALSO b2[2] = 6, "mixed * number repeats the string")
DIM bv AS ARRAY = b + [10, 20, 30]
Check(bv[0] = 11 ANDALSO bv[1] = "x20" ANDALSO bv[2] = 33, "mixed + numbers")
Check(SUM(b) = 4 ANDALSO MAX(b) = 3 ANDALSO MIN(b) = 0 ANDALSO PRODUCT(b) = 0, "reductions count a string as 0")
Check(ANY(b) ANDALSO ALL(b), "ANY and ALL take a non-empty string as true")
Check(MEAN(["aaa", "bbb"]) = 0, "MEAN of strings")
DIM br AS ARRAY = RESHAPE(b, [2, 2])
Check(br[0][1] = "x" ANDALSO br[1][1] = 1 ANDALSO br[1][0] = 3, "RESHAPE of a mixed array")

DIM sp AS ARRAY = SPLIT("a,b", ",") + [1, 2]
Check(sp[0] = "a1" ANDALSO sp[1] = "b2", "strings + numbers")
DIM eq AS ARRAY = ["x", 1] = ["y", 1]
Check(eq[0] = FALSE ANDALSO eq[1] = TRUE, "mixed = mixed")
DIM fs AS ARRAY = FLATTEN(SPLIT("a,b", ","))
Check(LEN(fs) = 2 ANDALSO fs[1] = "b", "FLATTEN of strings")
DIM fv AS ARRAY = FILLV(SPLIT("a,b", ","), 1)
Check(fv[0] = 1 ANDALSO fv[1] = 1, "FILLV over strings")

DIM c AS ARRAY = [1, "x", 3]
DIM g AS ARRAY = c[[1, 0]]
Check(g[0] = "x" ANDALSO g[1] = 1, "a gather keeps the kind of each cell")

DIM n AS ARRAY = SPLIT("a,z", ",")
DIM le AS ARRAY = n <= "m"
Check(le[0] = TRUE ANDALSO le[1] = FALSE, "strings <= string")
DIM gt AS ARRAY = n > "m"
Check(gt[0] = FALSE ANDALSO gt[1] = TRUE, "strings > string")
DIM sl AS ARRAY = "m" < n
Check(sl[0] = FALSE ANDALSO sl[1] = TRUE, "string < strings")
DIM q AS ARRAY = [1, 3]
DIM nl AS ARRAY = 2 < q
Check(nl[0] = FALSE ANDALSO nl[1] = TRUE, "number < numbers")
DIM nge AS ARRAY = 2 >= q
Check(nge[0] = TRUE ANDALSO nge[1] = FALSE, "number >= numbers")

DIM src AS ARRAY = [[1, 2], [3, 4], [5, 6]]
DIM sel AS ARRAY = src[[0, 2]]
DIM k AS INTEGER
FOR k = 1 TO 3
    src = [[k, k]]
NEXT k
Check(sel[0][1] = 2 ANDALSO sel[1][0] = 5, "a gather keeps its rows when its source goes")
DIM shuf AS ARRAY = SHUFFLE([[1, 2], [3, 4]])
Check(SUM(shuf) = 10, "SHUFFLE of rows")

DIM pm AS ARRAY = [[1, 2], [3, 4], [5, 6]]
DIM pr AS ARRAY = POP(pm)
DIM pq AS ARRAY = POP(pm)
pm = [[0]]
Check(pr[1] = 6 ANDALSO pq[0] = 3, "popped rows outlive their array")
DIM pmm AS ARRAY = [{"a": 1}, {"b": 2}]
DIM px = POP(pmm)
pmm = []
Check(px{"b"} = 2, "a popped map outlives its array")

Check(LEN(FORMAT$("{}", SPACE$(400))) = 400, "FORMAT$ keeps a long text")
Check(LEN(FORMAT$("{:500}", 1)) = 500, "FORMAT$ keeps a wide field")

IF failed > 0 THEN END 1
PRINT "OK"
