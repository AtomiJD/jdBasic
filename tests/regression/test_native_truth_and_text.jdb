' What a compiled program prints for truth values, whole numbers and text:
' a parameter handed only truth values, a FUNC name used as text, a method
' with a text local that answers a number, FORMAT$ of a whole number past
' 2^53, a PRINT whose call raised, and a running maximum of ABS over cells.

DIM pass = 0
DIM fail = 0

SUB Check(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; ": got '"; got$; "', want '"; want$; "'"
    ENDIF
ENDSUB

' --- parameters handed only truth values ---
FUNC InRange(n)
    RETURN n >= 0 ANDALSO n <= 9
ENDFUNC
FUNC Shown$(label$, got, want)
    IF got = want THEN RETURN label$ + " ok " + STR$(got)
    RETURN label$ + " off " + STR$(got)
ENDFUNC
DIM agree = TRUE
agree = agree AND InRange(4)
Check("a truth answer handed to an untyped parameter", Shown$("a", InRange(3), TRUE), "a ok " + STR$(TRUE))
Check("a false truth answer", Shown$("b", InRange(12), FALSE), "b ok " + STR$(FALSE))
Check("a variable that only ever holds truth values", Shown$("c", agree, TRUE), "c ok " + STR$(TRUE))
SUB Flagged(flag AS BOOLEAN)
    Check("a parameter declared AS BOOLEAN", STR$(flag) + " " + STR$(NOT flag), STR$(TRUE) + " " + STR$(FALSE))
ENDSUB
Flagged(2 > 1)
FUNC Picked(mask, at)
    RETURN mask[at]
ENDFUNC
Check("a comparison of arrays handed to a parameter that indexes it", STR$(Picked([1, 5, 9] > 4, 1) = TRUE), STR$(TRUE))
FUNC IsOdd(n)
    RETURN n MOD 2 = 1
ENDFUNC
DIM odd = IsOdd@
Check("a truth-valued FUNC through a variable", STR$(odd(3)) + " " + STR$(odd(4)), STR$(TRUE) + " " + STR$(FALSE))

' --- a FUNC name used as text ---
FUNC Solved()
    RETURN 1
ENDFUNC
DIM state$ = "PLAYING"
IF Solved() = 1 THEN state$ = "SOLVED"
Check("a text variable given the name of a FUNC", state$, "SOLVED")
DIM mode AS STRING = "Solved"
Check("a STRING variable given the name of a FUNC", mode, "Solved")

' --- a method with a text local answers a number ---
TYPE Note
    Body AS STRING
    FUNC Marks(extra)
        DIM lowered$ = LCASE$(THIS.Body)
        DIM bangs = LEN(lowered$) - LEN(REPLACE$(lowered$, "!", ""))
        RETURN bangs + extra
    ENDFUNC
    FUNC Title(extra)
        DIM sep$ = ": "
        RETURN THIS.Body
    ENDFUNC
ENDTYPE
DIM memo AS Note
memo.Body = "Hi! Now!"
Check("a method with a text local answering a number", STR$(memo.Marks(1) * 100), "300")
Check("a method answering a text field", memo.Title(0), "Hi! Now!")

' --- FORMAT$ of a whole number past 2^53 ---
DIM big AS INTEGER = 999999999999999999
Check("FORMAT$ of a large whole number", FORMAT$("{}", big), "999999999999999999")
Check("FORMAT$ of a large whole number in a field", FORMAT$("{:>20}", big), "  999999999999999999")
Check("FORMAT$ of a whole number as hex", FORMAT$("{:X}", big), "DE0B6B3A763FFFF")

' --- a PRINT whose call raised prints nothing ---
OUTPUT.CAPTURE_BEGIN
TRY
    PRINT LEN(CODEC.INFLATE$("not deflate data"))
CATCH
    PRINT "rejected"
ENDTRY
DIM printed$ = OUTPUT.CAPTURE_END$()
Check("a PRINT whose call raised", TRIM$(printed$), "rejected")

' --- a running maximum of ABS over cells ---
DIM wanted = {}
wanted{"sky"} = [135, 206, 235]
DIM got_back = [132, 207, 239]
DIM orig = []
DIM worst = 0
DIM delta = 0
orig = wanted{"sky"}
FOR k = 0 TO 2
    delta = ABS(orig[k] - got_back[k])
    IF delta > worst THEN worst = delta
NEXT
Check("a running maximum of ABS over cells", STR$(worst), "4")

' --- text fields of a local instance kept after the SUB ends ---
TYPE LogRow
    Origin AS STRING
    Body AS STRING
    SUB INIT(raw AS STRING)
        THIS.Origin = TRIM$(LEFT$(raw, 4))
        THIS.Body = MID$(raw, 4)
    ENDSUB
ENDTYPE
DIM origins = []
DIM widest$ = ""
SUB Absorb(raw$)
    DIM ln AS LogRow(raw$)
    origins = APPEND(origins, ln.Origin)
    IF LEN(ln.Body) > LEN(widest$) THEN widest$ = ln.Body
ENDSUB
Absorb("api the first line")
Absorb("db  second")
Absorb("aux a much longer third line here")
DIM churn = []
FOR q = 1 TO 200
    churn = APPEND(churn, REPEAT$("x", q MOD 40) + STR$(q))
NEXT
Check("text fields appended after the instance is gone", JOIN(origins, ","), "api,db,aux")
Check("a text field kept in a global after the instance is gone", widest$, "a much longer third line here")

' --- a destructure inside a SUB writes the globals it names ---
DIM spotRow = 2
DIM spotCol = 2
SUB MoveSpot(toRow, toCol)
    [spotRow, spotCol] = [toRow, toCol]
ENDSUB
MoveSpot(1, 0)
Check("a destructure into globals inside a SUB", STR$(spotRow) + "," + STR$(spotCol), "1,0")

' --- IN over a parameter handed a cell of a table ---
DIM LIMIT AS INTEGER = 6
FUNC Usable$(skipped)
    DIM s$ = ""
    FOR spot = 0 TO LIMIT - 1
        IF NOT (spot IN skipped) THEN s$ = s$ + STR$(spot)
    NEXT
    RETURN s$
ENDFUNC
DIM skipSets = [[], [1, 3, 4]]
DIM which = 1
Check("IN over a parameter handed a cell of a table", Usable$(skipSets[which]), "025")

' --- a text field copied out, then written again; a BOOLEAN method ---
TYPE Grid
    Cells AS STRING
    FUNC IsLit(at AS INTEGER) AS BOOLEAN
        RETURN MID$(THIS.Cells, at, 1) = "#"
    ENDFUNC
    SUB Toggle(at AS INTEGER)
        DIM mark$ = "#"
        IF THIS.IsLit(at) THEN mark$ = "."
        THIS.Cells = LEFT$(THIS.Cells, at) + mark$ + MID$(THIS.Cells, at + 1)
    ENDSUB
ENDTYPE
DIM panel AS Grid
panel.Cells = "#..#."
DIM saved$ = panel.Cells
panel.Toggle(1)
panel.Toggle(3)
panel.Cells = saved$
panel.Toggle(4)
Check("a text field copied out survives the field being written", saved$, "#..#.")
Check("a method declared AS BOOLEAN", STR$(panel.IsLit(0)) + " " + STR$(panel.IsLit(1)), STR$(TRUE) + " " + STR$(FALSE))

' --- an untyped FUNC answering a whole number answers INT64 ---
FUNC Halved(n AS INTEGER)
    DIM lo = 0
    lo = n \ 2
    RETURN lo
ENDFUNC
DIM huge AS INTEGER = 999999999999999998
DIM half = Halved(huge)
Check("an untyped FUNC answering a whole local", TYPEOF(half) + " " + STR$(half), "INT64 499999999999999999")
Check("integer division of its answer past 2^53", STR$(huge \ (half + 1)), "1")

' --- a FOR counter inside a SUB is local ---
DIM step_no = 0
SUB CountUp()
    FOR step_no = 1 TO 3
    NEXT
ENDSUB
CountUp()
Check("a FOR counter inside a SUB leaves the global of its name", STR$(step_no), "0")

PRINT pass; " passed, "; fail; " failed"
IF fail > 0 THEN END 1
