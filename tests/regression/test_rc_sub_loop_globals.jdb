' A global reassigned inside a SUB's loop frees what it let go of there, and
' what a FUNC's loop lets go of waits for the caller, who may be half way
' through an expression over the old value. Both read right afterwards, in
' both backends and under JDB_RC_POISON=1, where a freed array reads as
' rubbish.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

DIM base AS ARRAY = RESHAPE(IOTA(9), [3, 3])
DIM grid AS ARRAY = base
DIM tally AS ARRAY = [1, 2, 3]

SUB Churn(n AS INTEGER)
    DIM j AS INTEGER
    FOR j = 1 TO n
        grid = MATMUL(grid, base)
        grid = ROTATE(grid, [1, 0])
        grid = base
        tally = tally + 1
    NEXT j
ENDSUB

Churn(300)
Check(grid[1][1] = 5, "a global matrix reassigned in a SUB loop reads right after it")
Check(JOIN(tally, ",") = "301,302,303", "a global vector reassigned in a SUB loop reads right after it")

FUNC Bump(n AS INTEGER) AS ARRAY
    DIM j AS INTEGER
    FOR j = 1 TO n
        tally = tally + 1
    NEXT j
    RETURN [0, 0, 0]
ENDFUNC

' The caller loads tally before Bump runs and reads it after: the old
' array may not be freed under the FUNC's loop.
DIM held AS ARRAY = tally + Bump(300)
Check(JOIN(held, ",") = "301,302,303", "the value a caller holds survives a FUNC's loop: " + JOIN(held, ","))
Check(JOIN(tally, ",") = "601,602,603", "the global reads its new value afterwards")

DIM k AS INTEGER
FOR k = 1 TO 3
    Churn(100)
    held = tally + Bump(100)
NEXT k
Check(JOIN(tally, ",") = "1201,1202,1203", "SUB and FUNC loops alternate under a main loop: " + JOIN(tally, ","))

IF failed > 0 THEN END 1
PRINT "OK"
