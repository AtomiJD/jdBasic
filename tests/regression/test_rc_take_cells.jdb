' A variable whose array owns the texts in its cells stays the owner when
' it is also handed the answer of a builtin that passes on cells of its
' argument (FILTER, TAKE, DROP, SORT, SELECT ...): the texts come in as the
' array's own copies. They must read right after the source let go of
' them, in both backends and under JDB_RC_POISON=1, where a freed text
' reads as rubbish; and the loop of fresh texts must not leak (leak
' pattern strcells).

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

DIM glob = []
DIM src = ["apple", "kiwi", "banana", "fig"]
DIM pass AS INTEGER

' Fresh texts, then cells of another array, into the same name.
FOR pass = 1 TO 3
    glob = STR$([pass, pass + 1, pass + 2])
    Check(glob[2] = STR$(pass + 2), "fresh texts in pass " + STR$(pass))
    glob = FILTER(LAMBDA w -> LEN(w) > 3, src)
    Check(LEN(glob) = 3 ANDALSO glob[0] = "apple", "filtered texts in pass " + STR$(pass))
NEXT pass

' The source lets go of its texts; the copies stay.
src = ["x", "y"]
Check(glob[0] = "apple" ANDALSO glob[1] = "kiwi" ANDALSO glob[2] = "banana", "filtered texts after the source was replaced")

' TAKE, DROP and SORT of a text array, the source overwritten cell by cell.
DIM words = ["delta", "alpha", "charlie", "bravo"]
glob = SORT(words)
words[0] = "zulu"
words[1] = "yankee"
Check(glob[0] = "alpha" ANDALSO glob[3] = "delta", "sorted texts after the source cells changed")
glob = TAKE(2, words)
glob = DROP(1, glob)
Check(LEN(glob) = 1 ANDALSO glob[0] = "yankee", "TAKE then DROP of texts")
words = []
Check(glob[0] = "yankee", "texts after the source was emptied")

' A cell written over in an array that took its texts.
glob = FILTER(LAMBDA w -> LEN(w) > 0, ["one", "two"])
glob[0] = "uno"
Check(glob[0] = "uno" ANDALSO glob[1] = "two", "a cell written over after the copy")

' Inside a FUNC, the same name pattern on a local.
FUNC Shortest$(items) AS STRING
    DIM pick = []
    pick = STR$([1, 22, 333])
    pick = SORT(FILTER(LAMBDA s -> LEN(s) > 0, items))
    RETURN pick[0]
ENDFUNC
Check(Shortest$(["pear", "apple", "date"]) = "apple", "a local that takes sorted texts")

IF failed = 0 THEN PRINT "RESULTS: 1 passed, 0 failed" ELSE PRINT "RESULTS: 0 passed, 1 failed"
