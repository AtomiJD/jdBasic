' A reducer with an axis on a 3-D array answers the array with that axis
' taken out, in both backends; an axis the array does not have is an error.

DIM failed AS INTEGER = 0

SUB Check(ok, what$)
    IF NOT ok THEN
        PRINT "FAIL "; what$
        failed = failed + 1
    ENDIF
ENDSUB

FUNC Rows$(m AS ARRAY) AS STRING
    DIM s$ AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m) - 1
        s$ = s$ + JOIN(m[i], ",") + ";"
    NEXT i
    RETURN s$
ENDFUNC

DIM t AS ARRAY = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
DIM m AS ARRAY = [[1, 2, 3], [4, 5, 6]]

Check(Rows$(SUM(t, 0)) = "6,8;10,12;", "SUM over axis 0 of a 3-D array")
Check(Rows$(SUM(t, 1)) = "4,6;12,14;", "SUM over axis 1")
Check(Rows$(SUM(t, 2)) = "3,7;11,15;", "SUM over axis 2")
Check(Rows$(MAX(t, 0)) = "5,6;7,8;", "MAX over axis 0")
Check(Rows$(MIN(t, 2)) = "1,3;5,7;", "MIN over axis 2")
Check(Rows$(MEAN(t, 1)) = "2,3;6,7;", "MEAN over axis 1")
Check(Rows$(PRODUCT(t, 2)) = "2,12;30,56;", "PRODUCT over axis 2")
Check(Rows$(ANY(t > 6, 2)) = "FALSE,FALSE;FALSE,TRUE;", "ANY over axis 2 answers truth values")
Check(Rows$(ALL(t > 0, 0)) = "TRUE,TRUE;TRUE,TRUE;", "ALL over axis 0")
Check(JOIN(SUM(m, 0), ",") = "5,7,9" ANDALSO JOIN(SUM(m, 1), ",") = "6,15", "a matrix as before")
Check(SUM(t) = 36 ANDALSO MAX(t) = 8, "the whole array as before")

DIM caught$ AS STRING = ""
TRY
    DIM bad AS ARRAY = SUM(m, 2)
CATCH
    caught$ = ERRMSG$
ENDTRY
Check(INSTR(caught$, "axis 2") >= 0, "axis 2 of a matrix is an error: " + caught$)
caught$ = ""
TRY
    DIM bad3 AS ARRAY = SUM(t, 3)
CATCH
    caught$ = ERRMSG$
ENDTRY
Check(INSTR(caught$, "axis 3") >= 0, "axis 3 of a 3-D array is an error: " + caught$)

IF failed > 0 THEN END 1
PRINT "OK"
