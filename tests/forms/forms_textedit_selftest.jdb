' Edit-control text surface: SELSTART/SELLENGTH/SELTEXT in UTF-8 bytes,
' UNDO/CUT/COPY/PASTE, MODIFIED, caret line/column and the WORDWRAP rebuild.
' Needs a FORMS build on Windows; the clipboard is borrowed and restored.

N_PASS = 0
N_FAIL = 0

SUB Check(cond, label$)
    IF cond THEN
        N_PASS = N_PASS + 1
    ELSE
        N_FAIL = N_FAIL + 1
        PRINT "FAIL: "; label$
    ENDIF
ENDSUB

CRLF$ = CHR$(13) + CHR$(10)
frm = FORM.CREATE("Textedit Selftest", 360, 200, "MAIN")
txt = FORM.TEXTBOX(frm, "txtDoc", "", 0, 0, 360, 200, TRUE)
tmr = FORM.TIMER(frm, "tmrMain", 100)
saved_clip$ = CLIPBOARD.GET$()

FORM.SET(txt, "TEXT", "Grüße hello" + CRLF$ + "second line")
Check(FORM.GET(txt, "MODIFIED") = FALSE, "TEXT set leaves MODIFIED clear")

' "Grüße " is 8 bytes: ü and ß take two each
pos = INSTR(FORM.GET(txt, "TEXT"), "hello")
Check(pos = 8, "INSTR byte position of hello")
FORM.SET(txt, "SELSTART", pos)
FORM.SET(txt, "SELLENGTH", 5)
Check(FORM.GET(txt, "SELSTART") = 8, "SELSTART round-trips in bytes")
Check(FORM.GET(txt, "SELLENGTH") = 5, "SELLENGTH round-trips")
Check(FORM.GET(txt, "SELTEXT") = "hello", "SELTEXT reads the selection")

FORM.SET(txt, "SELSTART", 0)
FORM.SET(txt, "SELLENGTH", 7)
Check(FORM.GET(txt, "SELTEXT") = "Grüße", "SELLENGTH spans multibyte chars")

FORM.SET(txt, "SELSTART", 8)
FORM.SET(txt, "SELLENGTH", 5)
FORM.SET(txt, "SELTEXT", "world")
Check(LEFT$(FORM.GET(txt, "TEXT"), 13) = "Grüße world", "SELTEXT replaces the selection")
Check(FORM.GET(txt, "MODIFIED"), "SELTEXT sets MODIFIED")
Check(FORM.GET(txt, "CANUNDO"), "SELTEXT is undoable")
FORM.SET(txt, "UNDO", TRUE)
Check(LEFT$(FORM.GET(txt, "TEXT"), 13) = "Grüße hello", "UNDO restores the text")
FORM.SET(txt, "MODIFIED", FALSE)
Check(FORM.GET(txt, "MODIFIED") = FALSE, "MODIFIED can be cleared")

Check(FORM.GET(txt, "LINECOUNT") = 2, "LINECOUNT")
FORM.SET(txt, "SELSTART", INSTR(FORM.GET(txt, "TEXT"), "line"))
Check(FORM.GET(txt, "CARETLINE") = 2, "CARETLINE is 1-based")
Check(FORM.GET(txt, "CARETCOL") = 8, "CARETCOL is 1-based")

FORM.SET(txt, "SELSTART", 0)
FORM.SET(txt, "SELLENGTH", 7)
FORM.SET(txt, "COPY", TRUE)
Check(CLIPBOARD.GET$() = "Grüße", "COPY puts the selection on the clipboard")
FORM.SET(txt, "CUT", TRUE)
Check(LEFT$(FORM.GET(txt, "TEXT"), 6) = " hello", "CUT removes the selection")
FORM.SET(txt, "PASTE", TRUE)
Check(LEFT$(FORM.GET(txt, "TEXT"), 13) = "Grüße hello", "PASTE inserts the clipboard")

Check(FORM.GET(txt, "WORDWRAP"), "multiline TEXTBOX wraps by default")
FORM.SET(txt, "SELSTART", 8)
FORM.SET(txt, "SELLENGTH", 5)
FORM.SET(txt, "MODIFIED", TRUE)
FORM.SET(txt, "WORDWRAP", FALSE)
Check(FORM.GET(txt, "HIDESELECTION"), "HIDESELECTION on by default")
FORM.SET(txt, "HIDESELECTION", FALSE)
Check(FORM.GET(txt, "HIDESELECTION") = FALSE, "HIDESELECTION off")
Check(FORM.GET(txt, "SELTEXT") = "hello", "HIDESELECTION keeps the selection")
Check(FORM.GET(txt, "DROPFILES") = FALSE, "DROPFILES off by default")
FORM.SET(txt, "DROPFILES", TRUE)
Check(FORM.GET(txt, "DROPFILES"), "DROPFILES on")
Check(FORM.GET(txt, "WORDWRAP") = FALSE, "WORDWRAP off")
Check(FORM.GET(txt, "SELTEXT") = "hello", "WORDWRAP keeps the selection")
Check(FORM.GET(txt, "MODIFIED"), "WORDWRAP keeps MODIFIED")
Check(FORM.FIND(frm, "txtDoc") = txt, "WORDWRAP keeps the handle")
Check(FORM.GET(txt, "WIDTH") = 360, "WORDWRAP keeps the geometry")
Check(FORM.GET(txt, "DROPFILES"), "WORDWRAP keeps DROPFILES")
Check(FORM.GET(txt, "HIDESELECTION") = FALSE, "WORDWRAP keeps HIDESELECTION")
FORM.SET(txt, "WORDWRAP", TRUE)
Check(FORM.GET(txt, "WORDWRAP"), "WORDWRAP back on")

' Rich edit: CRLF counts once inside the control, positions still match TEXT
rt = FORM.RICHTEXT(frm, "rtDoc", 0, 0, 360, 200)
FORM.SET(rt, "PLAINTEXT", TRUE)
Check(FORM.GET(rt, "PLAINTEXT"), "RICHTEXT PLAINTEXT")
FORM.SET(rt, "MAXLENGTH", 0)
FORM.SET(rt, "TEXT", "ab" + CRLF$ + "Grüße" + CRLF$ + "xyz")
p2 = INSTR(FORM.GET(rt, "TEXT"), "xyz")
FORM.SET(rt, "SELSTART", p2)
FORM.SET(rt, "SELLENGTH", 3)
Check(FORM.GET(rt, "SELTEXT") = "xyz", "RICHTEXT selection after two CRLFs")
Check(FORM.GET(rt, "SELSTART") = p2, "RICHTEXT SELSTART round-trips")
Check(FORM.GET(rt, "CARETLINE") = 3, "RICHTEXT CARETLINE")
Check(FORM.GET(rt, "CARETCOL") = 4, "RICHTEXT CARETCOL")
Check(FORM.GET(rt, "LINECOUNT") = 3, "RICHTEXT LINECOUNT")
FORM.SET(rt, "SELTEXT", "one")
FORM.SET(rt, "SELTEXT", "two")
FORM.SET(rt, "UNDO", TRUE)
FORM.SET(rt, "UNDO", TRUE)
Check(RIGHT$(FORM.GET(rt, "TEXT"), 3) = "xyz", "RICHTEXT multi-level UNDO")
Check(FORM.GET(rt, "CANREDO"), "RICHTEXT CANREDO")
FORM.SET(rt, "REDO", TRUE)
Check(RIGHT$(FORM.GET(rt, "TEXT"), 3) = "one", "RICHTEXT REDO")
FORM.SET(rt, "ZOOM", 150)
Check(FORM.GET(rt, "ZOOM") = 150, "RICHTEXT ZOOM")
FORM.SET(rt, "ZOOM", 100)
Check(FORM.GET(rt, "ZOOM") = 100, "RICHTEXT ZOOM reset")
FORM.SET(rt, "SPELLCHECK", TRUE)
Check(FORM.GET(rt, "SPELLCHECK"), "RICHTEXT SPELLCHECK")
FORM.SET(rt, "WORDWRAP", FALSE)
Check(FORM.GET(rt, "WORDWRAP") = FALSE, "RICHTEXT WORDWRAP off")
FORM.SET(rt, "HIDESELECTION", FALSE)
Check(FORM.GET(rt, "HIDESELECTION") = FALSE, "RICHTEXT HIDESELECTION off")
FORM.SET(rt, "ACCEPTSTAB", TRUE)
Check(FORM.GET(rt, "ACCEPTSTAB"), "RICHTEXT ACCEPTSTAB")
FORM.SET(rt, "TABWIDTH", 4)
Check(FORM.GET(rt, "TABWIDTH") = 4, "RICHTEXT TABWIDTH")
FORM.SET(rt, "DROPFILES", TRUE)
Check(FORM.GET(rt, "DROPFILES"), "RICHTEXT DROPFILES")
FORM.SET(rt, "BACKCOLOR", $202020)
Check(FORM.GET(rt, "BACKCOLOR") = $202020, "RICHTEXT BACKCOLOR")

' Tab reaches an edit field that asked for it
DECLARE FUNC SendMessageW LIB "user32.dll" ALIAS "SendMessageW" (hwnd AS INTEGER, msg AS INTEGER, wp AS INTEGER, lp AS INTEGER) AS INTEGER
Check((SendMessageW(FORM.GET(rt, "HWND"), 135, 9, 0) BAND 2) = 2, "ACCEPTSTAB answers DLGC_WANTTAB")
Check(FORM.GET(txt, "CARETLINE") >= 1, "TEXTBOX CARETLINE still answers")

dlg = FORM.CREATE("Dialog", 200, 80, "DLG")
Check(FORM.GET(dlg, "BORDERSTYLE") = 2, "BORDERSTYLE sizable by default")
FORM.SET(dlg, "BORDERSTYLE", 3)
Check(FORM.GET(dlg, "BORDERSTYLE") = 3, "BORDERSTYLE fixed dialog")
Check(FORM.GET(dlg, "WIDTH") >= 200, "BORDERSTYLE keeps the client width")
FORM.SET(dlg, "BORDERSTYLE", 4)
Check(FORM.GET(dlg, "BORDERSTYLE") = 4, "BORDERSTYLE fixed tool window")
FORM.SET(dlg, "BORDERSTYLE", 5)
Check(FORM.GET(dlg, "BORDERSTYLE") = 5, "BORDERSTYLE sizable tool window")
FORM.SET(dlg, "BORDERSTYLE", 1)
Check(FORM.GET(dlg, "BORDERSTYLE") = 1, "BORDERSTYLE fixed single")
Check(FORM.GET(dlg, "OWNER") = 0, "OWNER none by default")
FORM.SET(dlg, "OWNER", frm)
Check(FORM.GET(dlg, "OWNER") = frm, "OWNER set")
FORM.SET(dlg, "OWNER", 0)
Check(FORM.GET(dlg, "OWNER") = 0, "OWNER cleared")
FORM.CLOSE(dlg)

changes = 0
SUB TXTDOC_CHANGE(e)
    changes = changes + 1
ENDSUB

ticks = 0
SUB TMRMAIN_TICK(e)
    ticks = ticks + 1
    IF ticks = 1 THEN FORM.SET(txt, "SELTEXT", "x")
    IF ticks >= 3 THEN FORM.CLOSE(frm)
ENDSUB

FORM.RUN(frm)
CLIPBOARD.SET saved_clip$

Check(changes >= 1, "rebuilt control still fires CHANGE")

PRINT ""
PRINT "RESULTS: "; N_PASS; " passed, "; N_FAIL; " failed"
IF N_FAIL = 0 THEN PRINT "ALL TEXTEDIT TESTS PASSED!"
