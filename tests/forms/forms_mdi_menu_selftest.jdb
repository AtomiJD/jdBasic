' Menus + MDI self-test. A timer drives everything: programmatic menu
' clicks, checked/enabled round-trips, child lifetime rules (closing all
' children keeps the frame alive), then closes the frame.

N_PASS = 0
N_FAIL = 0

SUB Check(cond, label$)
    IF cond THEN
        N_PASS = N_PASS + 1
    ELSE
        N_FAIL = N_FAIL + 1
        PRINT "FAIL: "; label$
    ENDIF
ENDSUB

frame = 0
child1 = 0
child2 = 0
opens = 0
checks = 0
ticks = 0

SUB MNUOPEN_CLICK(e)
    opens = opens + 1
ENDSUB

SUB MNUWRAP_CLICK(e)
    checks = checks + 1
ENDSUB

frame = FORM.MDI("MDI Selftest", 640, 420, "FRAME")
FORM.MENU(frame, [ _
    { "text": "&File", "items": [ _
        { "name": "mnuOpen", "text": "&Open", "key": "Ctrl+O" }, _
        "-", _
        { "name": "mnuExit", "text": "E&xit" } _
    ]}, _
    { "text": "&View", "items": [ _
        { "name": "mnuWrap", "text": "&Word Wrap" } _
    ]} _
])

mnuOpen = FORM.FIND(frame, "mnuOpen")
mnuWrap = FORM.FIND(frame, "mnuWrap")
Check(mnuOpen > 0, "FIND locates a menu item")
Check(FORM.GET(mnuOpen, "KIND") = "MENU", "menu item KIND")

Check(FORM.GET(mnuWrap, "CHECKED") = FALSE, "menu item starts unchecked")
FORM.SET(mnuWrap, "CHECKED", TRUE)
Check(FORM.GET(mnuWrap, "CHECKED"), "menu CHECKED after SET")

FORM.SET(mnuOpen, "ENABLED", FALSE)
Check(FORM.GET(mnuOpen, "ENABLED") = FALSE, "menu ENABLED FALSE")
FORM.SET(mnuOpen, "ENABLED", TRUE)
Check(FORM.GET(mnuOpen, "ENABLED"), "menu ENABLED TRUE")

tbclicks = 0

SUB TBNEW_CLICK(e)
    tbclicks = tbclicks + 1
ENDSUB

tbar = FORM.TOOLBAR(frame, "tbMain", [ _
    { "name": "tbNew", "text": "New document", "icon": "NEW" }, _
    { "name": "tbOpen", "text": "Open", "icon": "OPEN" }, _
    "-", _
    { "name": "tbBold", "text": "Bold", "icon": "PROPERTIES", "check": TRUE } _
])
tbNew = FORM.FIND(frame, "tbNew")
tbBold = FORM.FIND(frame, "tbBold")
Check(tbNew > 0, "FIND locates a toolbar button")
Check(FORM.GET(tbNew, "KIND") = "TOOLBTN", "toolbar button KIND")
Check(FORM.GET(tbNew, "ENABLED"), "toolbar button starts enabled")
FORM.SET(tbNew, "ENABLED", FALSE)
Check(FORM.GET(tbNew, "ENABLED") = FALSE, "toolbar ENABLED FALSE")
FORM.SET(tbNew, "ENABLED", TRUE)
FORM.SET(tbBold, "CHECKED", TRUE)
Check(FORM.GET(tbBold, "CHECKED"), "toolbar check button CHECKED")

sbar = FORM.STATUSBAR(frame, "sbMain", [200, 150, -1])
Check(sbar > 0, "STATUSBAR created")
Check(FORM.GET(sbar, "KIND") = "STATUSBAR", "statusbar KIND")
FORM.SET(sbar, "TEXT", "Ready")
Check(FORM.GET(sbar, "TEXT") = "Ready", "statusbar TEXT round-trip")
FORM.SET(sbar, "TEXT", ["Part A", "Part B", "Part C"])
Check(FORM.GET(sbar, "TEXT") = "Part A", "statusbar array TEXT sets part 0")

child1 = FORM.CHILD(frame, "Doc 1", 300, 200, "DOC1")
child2 = FORM.CHILD(frame, "Doc 2", 300, 200, "DOC2")
lbl = FORM.LABEL(child1, "lblDoc", "content", 10, 10, 100, 18)
Check(FORM.GET(child1, "KIND") = "MDICHILD", "child KIND")
Check(FORM.GET(lbl, "TEXT") = "content", "control on a child works")

SUB TMRMAIN_TICK(e)
    ticks = ticks + 1
    IF ticks = 1 THEN FORM.SET(mnuOpen, "VALUE", TRUE)
    IF ticks = 2 THEN
        FORM.SET(mnuWrap, "VALUE", TRUE)
        FORM.SET(tbNew, "VALUE", TRUE)
    ENDIF
    IF ticks = 3 THEN
        ' maximize a child, restore it, then close both while one was
        ' maximized moments before - the frame must survive all of it
        FORM.SET(child1, "MAXIMIZED", TRUE)
        Check(FORM.GET(child1, "MAXIMIZED"), "child MAXIMIZED after SET")
        FORM.SET(child1, "MAXIMIZED", FALSE)
        Check(FORM.GET(child1, "MAXIMIZED") = FALSE, "child restored")
        FORM.SET(child2, "MAXIMIZED", TRUE)
        FORM.CLOSE(child1)
        FORM.CLOSE(child2)
    ENDIF
    IF ticks = 4 THEN
        ' both children are gone, the frame must still be running
        Check(FORM.FIND(frame, "DOC1") = 0, "closed child is gone from the registry")
        Check(opens = 1, "menu click dispatched MNUOPEN_CLICK")
        Check(checks = 1, "second menu click dispatched MNUWRAP_CLICK")
        Check(tbclicks = 1, "toolbar click dispatched TBNEW_CLICK")
    ENDIF
    IF ticks >= 5 THEN FORM.CLOSE(frame)
ENDSUB
ON "TMRMAIN_TICK" CALL TMRMAIN_TICK

tmr = FORM.TIMER(frame, "tmrMain", 100)
FORM.RUN(frame)

Check(ticks >= 5, "frame survived the children closing")

' The frame cascade must not leave child controls behind: a fresh form
' with recycled names still works.
frm2 = FORM.CREATE("after mdi", 200, 120, "FRAME")
Check(FORM.FIND(frm2, "lblDoc") = 0, "no stale entries after the cascade")
FORM.CLOSE(frm2)

PRINT ""
PRINT "RESULTS: "; N_PASS; " passed, "; N_FAIL; " failed"
IF N_FAIL = 0 THEN PRINT "ALL MDI MENU TESTS PASSED!"
