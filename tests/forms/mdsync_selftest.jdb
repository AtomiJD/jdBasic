' MDSYNC: a Markdown source and its view in a RICHTEXT kept in step. Edits
' are made the way a user makes them (typing over a selection, a format on
' the selection, a paragraph break, a joined paragraph), each followed by
' VIEWCHANGED; the source must change only where the edit reached, and the
' span VIEWCHANGED answers must turn the old source into the new one.
' Needs a FORMS build on Windows.
OPTION "EXPLICIT"
IMPORT MDSYNC

DIM N_PASS AS INTEGER = 0
DIM N_FAIL AS INTEGER = 0
DIM NL AS STRING = CHR$(10)
DIM CRLF AS STRING = CHR$(13) + CHR$(10)
DIM mirror AS STRING = ""

SUB Check(cond AS BOOLEAN, label AS STRING)
    IF cond THEN
        N_PASS = N_PASS + 1
    ELSE
        N_FAIL = N_FAIL + 1
        PRINT "FAIL: "; label
    ENDIF
ENDSUB

' Applies a source span to the mirror, as an editor showing the source would.
SUB Apply(d AS MAP)
    IF d{"changed"} = TRUE THEN
        DIM at AS INTEGER = d{"start"}
        DIM gone AS INTEGER = d{"old_len"}
        DIM put AS STRING = d{"text"}
        mirror = LEFT$(mirror, at) + put + MID$(mirror, at + gone, LEN(mirror) - at - gone)
    ENDIF
ENDSUB

SUB SelectText(h AS DOUBLE, part AS STRING)
    DIM t AS STRING = FORM.GET(h, "TEXT")
    FORM.SET(h, "SELSTART", INSTR(t, part))
    FORM.SET(h, "SELLENGTH", LEN(part))
ENDSUB

' Puts the caret right after part.
SUB CaretAfter(h AS DOUBLE, part AS STRING)
    DIM t AS STRING = FORM.GET(h, "TEXT")
    FORM.SET(h, "SELSTART", INSTR(t, part) + LEN(part))
    FORM.SET(h, "SELLENGTH", 0)
ENDSUB

DIM md AS STRING = "# Title" + NL + NL + "First paragraph here." + NL + NL
md = md + "- one" + NL + "- two" + NL + NL + "1. alpha" + NL + "2. beta" + NL + NL
md = md + "Last words." + NL
mirror = md

DIM frm AS DOUBLE = FORM.CREATE("MDSYNC selftest", 640, 480, "MAIN")
DIM rt AS DOUBLE = FORM.RICHTEXT(frm, "rtView", 0, 0, 640, 480)
DIM doc AS MAP = MDSYNC.OPEN(rt, md)
DIM d AS MAP
Check(MDSYNC.SOURCE$(doc) = md, "OPEN keeps the source")
Check(LEN(SPLIT(FORM.GET(rt, "TEXT"), CRLF)) = LEN(MDSYNC.BLOCKS(doc)), "one paragraph per block")

d = MDSYNC.VIEWCHANGED(doc)
Check(d{"changed"} = FALSE, "nothing changed, nothing to do")

' typing over a word
SelectText(rt, "here")
FORM.SET(rt, "SELTEXT", "there")
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(MDSYNC.SOURCE$(doc) = REPLACE$(md, "here.", "there."), "typed text reaches the source")
Check(d{"old_len"} < 10, "the span is only what changed")
Check(mirror = MDSYNC.SOURCE$(doc), "the span turns the old source into the new")

' a format on the selection
SelectText(rt, "First")
FORM.SET(rt, "SELBOLD", TRUE)
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), "**First** paragraph there." + NL) >= 0, "bold reaches the source")
Check(mirror = MDSYNC.SOURCE$(doc), "span after bold")

' Enter after a paragraph, then typing
CaretAfter(rt, "there.")
FORM.SET(rt, "SELTEXT", CRLF)
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
FORM.SET(rt, "SELTEXT", "Second one.")
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), "**First** paragraph there." + NL + NL + "Second one." + NL + NL + "- one") >= 0, "a new paragraph with blank lines around it")
Check(mirror = MDSYNC.SOURCE$(doc), "span after a new paragraph")

' Enter after the heading gives a plain paragraph
CaretAfter(rt, "Title")
FORM.SET(rt, "SELTEXT", CRLF)
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
FORM.SET(rt, "SELTEXT", "Intro")
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(LEFT$(MDSYNC.SOURCE$(doc), 15) = "# Title" + NL + NL + "Intro" + NL, "a paragraph after the heading, not a heading")
SelectText(rt, "Intro")
Check(FORM.GET(rt, "SELBOLD") = FALSE, "the new paragraph is drawn plain")
Check(mirror = MDSYNC.SOURCE$(doc), "span after the heading split")

' Enter after a bullet item gives the next item
CaretAfter(rt, "two")
FORM.SET(rt, "SELTEXT", CRLF)
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
FORM.SET(rt, "SELTEXT", "three")
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), "- one" + NL + "- two" + NL + "- three" + NL + NL + "1. alpha") >= 0, "a new bullet item")
Check(mirror = MDSYNC.SOURCE$(doc), "span after a new item")

' Enter after a numbered item continues the numbers
CaretAfter(rt, "beta")
FORM.SET(rt, "SELTEXT", CRLF)
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
FORM.SET(rt, "SELTEXT", "gamma")
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), "2. beta" + NL + "3. gamma" + NL) >= 0, "a new numbered item is 3.")
Check(INSTR(FORM.GET(rt, "TEXT"), "3." + CHR$(9) + "gamma") >= 0, "the view draws its number")
Check(mirror = MDSYNC.SOURCE$(doc), "span after a numbered item")

' Backspace at the start of an item joins it to the paragraph before
DIM t AS STRING = FORM.GET(rt, "TEXT")
FORM.SET(rt, "SELSTART", INSTR(t, "Second one.") + LEN("Second one."))
FORM.SET(rt, "SELLENGTH", 2)
FORM.SET(rt, "SELTEXT", "")
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), NL + "Second one.one" + NL + "- two" + NL) >= 0, "a joined paragraph and item: the paragraph kind, the next item stays")
Check(LEN(SPLIT(FORM.GET(rt, "TEXT"), CRLF)) = LEN(MDSYNC.BLOCKS(doc)), "still one paragraph per block")
Check(mirror = MDSYNC.SOURCE$(doc), "span after a join")

' an edit of the source redraws its block
DIM src AS STRING = MDSYNC.SOURCE$(doc)
src = REPLACE$(src, "Last words.", "Final *words*.")
Check(MDSYNC.SOURCECHANGED(doc, src) = TRUE, "a source edit redraws")
mirror = src
Check(INSTR(FORM.GET(rt, "TEXT"), "Final words.") >= 0, "the view shows the new text")
SelectText(rt, "words")
Check(FORM.GET(rt, "SELITALIC") = TRUE, "and its format")
Check(LEN(SPLIT(FORM.GET(rt, "TEXT"), CRLF)) = LEN(MDSYNC.BLOCKS(doc)), "paragraphs after a source edit")
Check(MDSYNC.SOURCECHANGED(doc, src) = FALSE, "the same source changes nothing")

' a new block in the source
src = src + NL + "## Appendix" + NL
Check(MDSYNC.SOURCECHANGED(doc, src) = TRUE, "an appended heading")
mirror = src
SelectText(rt, "Appendix")
Check(FORM.GET(rt, "SELFONTSIZE") = 18, "drawn as a level 2 heading")

' a kind change from the toolbar
CaretAfter(rt, "Intro")
d = MDSYNC.SETKIND(doc, MDSYNC.BLOCKAT(doc, CINT(FORM.GET(rt, "SELSTART"))), "heading", 3)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), NL + "### Intro" + NL) >= 0, "a paragraph becomes a level 3 heading")
Check(mirror = MDSYNC.SOURCE$(doc), "span after a kind change")

' a link
SelectText(rt, "Final")
d = MDSYNC.SETLINK(doc, "https://jdbasic.org")
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), "[Final](https://jdbasic.org) *words*.") >= 0, "a link with its URL")
Check(mirror = MDSYNC.SOURCE$(doc), "span after a link")

' a paragraph of spaces only is an empty paragraph
CaretAfter(rt, "Intro")
FORM.SET(rt, "SELTEXT", CRLF)
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
FORM.SET(rt, "SELTEXT", "   ")
d = MDSYNC.VIEWCHANGED(doc)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(doc), "### Intro" + NL) >= 0, "a blank paragraph leaves the heading alone")
Check(mirror = MDSYNC.SOURCE$(doc), "span after a blank paragraph")
Check(LEN(SPLIT(FORM.GET(rt, "TEXT"), CRLF)) = LEN(MDSYNC.BLOCKS(doc)), "the blank paragraph is a block")

' everything still reads back to the same view
DIM again AS MAP = MDSYNC.OPEN(rt, MDSYNC.SOURCE$(doc))
Check(MDSYNC.SOURCE$(again) = mirror, "the edited source opens again")

' an empty document: a link before anything is typed, then text
DIM empty AS MAP = MDSYNC.OPEN(rt, "")
FORM.SET(rt, "SELSTART", 0)
FORM.SET(rt, "SELTEXT", "Hello")
FORM.SET(rt, "SELSTART", 0)
FORM.SET(rt, "SELLENGTH", 5)
d = MDSYNC.SETLINK(empty, "https://x.y/")
Check(MDSYNC.SOURCE$(empty) = "[Hello](https://x.y/)" + NL, "typing into an empty document, with a link")

' Enter in an empty document, then text in the second paragraph
DIM blank AS MAP = MDSYNC.OPEN(rt, "")
FORM.SET(rt, "SELSTART", 0)
FORM.SET(rt, "SELTEXT", CRLF)
d = MDSYNC.VIEWCHANGED(blank)
FORM.SET(rt, "SELTEXT", "Second")
d = MDSYNC.VIEWCHANGED(blank)
Check(INSTR(MDSYNC.SOURCE$(blank), "Second" + NL) >= 0, "Enter in an empty document")
Check(LEN(SPLIT(FORM.GET(rt, "TEXT"), CRLF)) = LEN(MDSYNC.BLOCKS(blank)), "paragraphs and blocks after Enter in an empty document")

' ordered lists count on after an item is added, made or removed
DIM listMd AS STRING = "Intro" + NL + NL + "1. alpha" + NL + "2. beta" + NL + "3. gamma" + NL + NL + "End" + NL
mirror = listMd
DIM lst AS MAP = MDSYNC.OPEN(rt, listMd)
CaretAfter(rt, "alpha")
FORM.SET(rt, "SELTEXT", CRLF)
d = MDSYNC.VIEWCHANGED(lst)
Apply(d)
FORM.SET(rt, "SELTEXT", "between")
d = MDSYNC.VIEWCHANGED(lst)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(lst), "1. alpha" + NL + "2. between" + NL + "3. beta" + NL + "4. gamma" + NL) >= 0, "items after an inserted one count on")
Check(INSTR(FORM.GET(rt, "TEXT"), "4." + CHR$(9) + "gamma") >= 0, "the view draws the new numbers")
Check(mirror = MDSYNC.SOURCE$(lst), "span after renumbering")

SelectText(rt, "between")
FORM.SET(rt, "SELSTART", INSTR(FORM.GET(rt, "TEXT"), "alpha") + 5)
FORM.SET(rt, "SELLENGTH", INSTR(FORM.GET(rt, "TEXT"), "between") + 7 - INSTR(FORM.GET(rt, "TEXT"), "alpha") - 5)
FORM.SET(rt, "SELTEXT", "")
d = MDSYNC.VIEWCHANGED(lst)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(lst), "1. alpha" + NL + "2. beta" + NL + "3. gamma" + NL) >= 0, "items after a removed one count back")
Check(mirror = MDSYNC.SOURCE$(lst), "span after removing an item")

DIM mix AS MAP = MDSYNC.OPEN(rt, "1. one" + NL + NL + "plain" + NL + NL + "1. two" + NL + "2. three" + NL)
mirror = MDSYNC.SOURCE$(mix)
d = MDSYNC.SETKIND(mix, 1, "ordered", 0)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(mix), "2. plain" + NL) >= 0, "a paragraph made an item takes the next number")
Check(INSTR(MDSYNC.SOURCE$(mix), "3. two" + NL + "4. three" + NL) >= 0, "the items after it count on")
Check(mirror = MDSYNC.SOURCE$(mix), "span after making an item")

DIM odd AS MAP = MDSYNC.OPEN(rt, "Top" + NL + NL + "1. a" + NL + "1. b" + NL)
mirror = MDSYNC.SOURCE$(odd)
CaretAfter(rt, "Top")
FORM.SET(rt, "SELTEXT", "!")
d = MDSYNC.VIEWCHANGED(odd)
Apply(d)
Check(INSTR(MDSYNC.SOURCE$(odd), "1. a" + NL + "1. b" + NL) >= 0, "a list the edit did not reach keeps its numbers")

' INSERT puts blocks of their own after a block
DIM insMd AS STRING = "# Head" + NL + "Text here." + NL + NL + "More." + NL
DIM ins AS MAP = MDSYNC.OPEN(rt, insMd)
mirror = insMd
d = MDSYNC.INSERT(ins, 1, "---")
Apply(d)
Check(MDSYNC.SOURCE$(ins) = "# Head" + NL + "Text here." + NL + NL + "---" + NL + NL + "More." + NL, "a rule between two paragraphs")
Check(mirror = MDSYNC.SOURCE$(ins), "span after an insert")
Check(MDSYNC.BLOCKS(ins)[2]{"kind"} = "rule", "the rule is a block")
d = MDSYNC.INSERT(ins, LEN(MDSYNC.BLOCKS(ins)) - 1, "| A | B |" + NL + "| --- | --- |" + NL + "| 1 | 2 |")
Apply(d)
Check(RIGHT$(MDSYNC.SOURCE$(ins), 40) = RIGHT$("More." + NL + NL + "| A | B |" + NL + "| --- | --- |" + NL + "| 1 | 2 |" + NL, 40), "a table at the end")
Check(mirror = MDSYNC.SOURCE$(ins), "span after a table at the end")
Check(LEN(SPLIT(FORM.GET(rt, "TEXT"), CRLF)) = LEN(MDSYNC.BLOCKS(ins)), "one paragraph per block after inserts")
d = MDSYNC.INSERT(ins, -1, "Lead line")
Apply(d)
Check(LEFT$(MDSYNC.SOURCE$(ins), 18) = "Lead line" + NL + NL + "# Head" + NL, "a paragraph at the top")
Check(mirror = MDSYNC.SOURCE$(ins), "span after an insert at the top")
Check(CINT(FORM.GET(rt, "SELSTART")) = 0, "the caret is on the inserted block")

FORM.CLOSE(frm)

PRINT
PRINT "RESULTS: "; N_PASS; " passed, "; N_FAIL; " failed"
IF N_FAIL = 0 THEN PRINT "ALL MDSYNC TESTS PASSED!"
