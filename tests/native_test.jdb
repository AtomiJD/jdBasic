' ══════════════════════════════════════════════════════════════════
'  jdBasic Native Compiler Test Suite
'  Tests the features supported by the LLVM native compiler
' ══════════════════════════════════════════════════════════════════

DIM PASS = 0
DIM FAIL = 0

test_num = 0
SUB Assert(N,cond)
    test_num = test_num + 1
    IF cond THEN
        PASS = PASS + 1
    ELSE
        PRINT "FAIL Test #";N
        FAIL = FAIL + 1
    ENDIF
ENDSUB

' ── 1. ARITHMETIC ────────────────────────────────────────────
PRINT "── Arithmetic ──"
Assert(2,2 + 3 = 5)
Assert(3,10 - 4 = 6)
Assert(4,3 * 7 = 21)
Assert(5,15 / 3 = 5)
Assert(6,17 MOD 5 = 2)
Assert(7,2 ^ 10 = 1024)
Assert(8,-5 + 10 = 5)

' ── 2. COMPARISONS ───────────────────────────────────────────
PRINT "── Comparisons ──"
Assert(9,5 > 3)
Assert(10,3 < 5)
Assert(11,5 >= 5)
Assert(12,5 <= 5)
Assert(13,5 = 5)
Assert(14,5 <> 3)

' ── 3. LOGIC ─────────────────────────────────────────────────
PRINT "── Logic ──"
Assert(15,1 AND 1)
Assert(16,1 OR 0)
Assert(17,NOT 0)
Assert(18,NOT (1 AND 0))

' ── 4. VARIABLES ─────────────────────────────────────────────
PRINT "── Variables ──"
x = 42
Assert(19,x = 42)
x = x + 1
Assert(20,x = 43)
y = 3.14
Assert(21,y > 3)

' ── 5. IF/ELSEIF/ELSE ────────────────────────────────────────
PRINT "── IF/ELSE ──"
a = 10
IF a > 5 THEN
    Assert(22,1)
ELSE
    Assert(23,0)
ENDIF

IF a > 100 THEN
    Assert(24,0)
ELSEIF a > 5 THEN
    Assert(25,1)
ELSE
    Assert(26,0)
ENDIF

' ── 6. FOR LOOP ──────────────────────────────────────────────
PRINT "── FOR Loop ──"
s = 0
FOR i = 1 TO 10
    s = s + i
NEXT i
Assert(27,s = 55)

s2 = 0
FOR i = 0 TO 10 STEP 2
    s2 = s2 + i
NEXT i
Assert(28,s2 = 30)

' ── 7. DO LOOP ───────────────────────────────────────────────
PRINT "── DO Loop ──"
c = 0
DO WHILE c < 5
    c = c + 1
LOOP
Assert(29,c = 5)

d = 10
DO
    d = d - 1
LOOP UNTIL d = 5
Assert(30,d = 5)

' ── 8. FUNC/SUB ──────────────────────────────────────────────
PRINT "── FUNC/SUB ──"

FUNC Add(a, b)
    RETURN a + b
ENDFUNC

FUNC Factorial(n)
    IF n <= 1 THEN RETURN 1
    RETURN n * Factorial(n - 1)
ENDFUNC

Assert(31,Add(3, 7) = 10)
Assert(32,Factorial(5) = 120)
Assert(33,Factorial(10) = 3628800)

' ── 9. GLOBAL VARS IN FUNC ──────────────────────────────────
PRINT "── Globals in FUNC ──"
counter = 0
SUB Increment()
    counter = counter + 1
ENDSUB
Increment
Increment
Increment
Assert(34,counter = 3)

