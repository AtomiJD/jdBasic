' ── 48. PIPE OPERATOR ────────────────────────────────────────
PRINT "── PIPE ──"
pipe_r1 = 21 |> lambda x -> x * 2
Assert(172,pipe_r1 = 42)

FUNC PipeDouble(x)
    RETURN x * 2
ENDFUNC
pipe_r2 = 25 |> PipeDouble
Assert(173,pipe_r2 = 50)

pipe_r3 = IOTA(5) |> FILTER(lambda x -> x > 3, ?)
Assert(174,LEN(pipe_r3) = 2)
Assert(175,pipe_r3[0] = 4)

' ── 49. LAMBDA SQUARES + CHAIN ───────────────────────────────
PRINT "── Lambda Chain ──"
la_chain = FILTER(lambda x -> x > 10, SELECT(lambda x -> x ^ 2, IOTA(5)))
Assert(176,la_chain[0] = 16)
Assert(177,la_chain[1] = 25)
Assert(178,LEN(la_chain) = 2)

' ── 50. STRING-ARRAY ELEMENT EXTRACTION ──────────────────────
'   Regression for native codegen bugs (2026-05-01) where arr[i]
'   and FOR EACH over dynamically-typed string arrays returned 0
'   instead of the actual string. DIR$(FALSE) and OS.ARGS were
'   the production triggers.
PRINT "── String-Array Element Extraction ──"

' Literal: already tracked, sanity guard.
sa_lits = ["alpha", "beta", "gamma"]
Assert(179, sa_lits[0] = "alpha")
Assert(180, sa_lits[2] = "gamma")

' SPLIT: already tracked, sanity guard.
sa_parts = SPLIT("a,b,c,d", ",")
Assert(181, sa_parts[0] = "a")
Assert(182, sa_parts[3] = "d")

' DIR$(*, FALSE) — was broken.
MKDIR "_sa_tmp"
TXTWRITER "_sa_tmp/alpha.txt", "a"
TXTWRITER "_sa_tmp/bravo.txt", "b"
TXTWRITER "_sa_tmp/charlie.txt", "c"
sa_names = DIR$("_sa_tmp/*", FALSE)
Assert(183, LEN(sa_names) = 3)
Assert(184, LEN(sa_names[0]) > 0)
sa_saw = 0
sa_i = 0
FOR sa_i = 0 TO LEN(sa_names) - 1
    IF sa_names[sa_i] = "alpha.txt" THEN sa_saw = 1
NEXT sa_i
Assert(185, sa_saw = 1)

' FOR EACH over string array — iter-var was 0 in native.
sa_concat = ""
sa_s = ""
FOR EACH sa_s IN sa_parts
    sa_concat = sa_concat + sa_s
NEXT
Assert(186, sa_concat = "abcd")

sa_seen = 0
sa_nm = ""
FOR EACH sa_nm IN sa_names
    IF LEN(sa_nm) > 0 THEN sa_seen = sa_seen + 1
NEXT
Assert(187, sa_seen = 3)

KILL "_sa_tmp/alpha.txt"
KILL "_sa_tmp/bravo.txt"
KILL "_sa_tmp/charlie.txt"
RMDIR "_sa_tmp"

' OS.ARGS — runtime-test of element type. When this script is invoked
' as `jdBasic.exe -c native_test.jdb` (no extra args), OS.ARGS is
' empty; the dedicated tests/test_native_os_args.jdb is the runner
' that asserts non-empty OS.ARGS()[0] is a real string.
sa_args = OS.ARGS()
Assert(188, LEN(sa_args) >= 0)

' APPEND(string_arr_a, string_arr_b) — result must keep its strings.
sa_x = ["aa", "bb"]
sa_y = ["cc", "dd"]
sa_xy = APPEND(sa_x, sa_y)
Assert(189, LEN(sa_xy) = 4)
sa_xy0 = ""
sa_xy3 = ""
sa_xy0 = sa_xy[0]
sa_xy3 = sa_xy[3]
Assert(190, sa_xy0 = "aa")
Assert(191, sa_xy3 = "dd")

' ── 51. DIM SHADOWING INSIDE FUNC/SUB ────────────────────────
'   Native regression: `DIM x` inside a FUNC/SUB used to find an
'   outer same-named global via lookup_var and write into THAT slot
'   instead of allocating a fresh local. Recursive walk()'s `DIM i`
'   then clobbered the caller's `DIM i AS INTEGER` loop counter →
'   wedge.
PRINT "── DIM Shadowing ──"

shd_calls = 0
FUNC shd_walk(depth AS INTEGER)
    shd_calls = shd_calls + 1
    IF depth = 0 THEN RETURN 0
    DIM i AS INTEGER
    DIM total AS INTEGER = 0
    FOR i = 0 TO 2
        total = total + shd_walk(depth - 1)
    NEXT i
    RETURN total
ENDFUNC

DIM i AS INTEGER
shd_outer = 0
FOR i = 0 TO 1
    shd_outer = shd_outer + 1
    shd_walk(2)
NEXT i
Assert(192, shd_outer = 2)
Assert(193, shd_calls = 26)

shd_x = 5
SUB shd_local_only()
    DIM shd_x AS INTEGER
    shd_x = 99
ENDSUB
shd_local_only
Assert(194, shd_x = 5)

shd_v = 7
FUNC shd_get_v(shd_v AS INTEGER)
    RETURN shd_v + 1
ENDFUNC
Assert(195, shd_get_v(40) = 41)
Assert(196, shd_v = 7)

' ── 52. VECTOR STRING EQUALITY + UNIQUE ──────────────────────
'   `(string_arr = scalar_str)` and UNIQUE(string_arr) used to
'   compare punned-pointer bits in native; identical text in
'   separate allocations slipped through.
PRINT "── Vector String Equality ──"

vse_xs = SPLIT("aa,bb,aa,cc,aa", ",")
vse_h = "aa"
vse_mask = (vse_xs = vse_h)
Assert(197, SUM(vse_mask) = 3)
Assert(198, LEN(vse_mask) = 5)
vse_neq = (vse_xs <> vse_h)
Assert(199, SUM(vse_neq) = 2)

vse_a = SPLIT("alpha,beta,alpha,gamma,beta", ",")
vse_u = UNIQUE(vse_a)
Assert(200, LEN(vse_u) = 3)

vse_sa = CODEC.SHA256$("hello")
vse_sb = CODEC.SHA256$("hello")
vse_sc = CODEC.SHA256$("world")
vse_hashes = [vse_sa, vse_sb, vse_sc]
vse_huniq = UNIQUE(vse_hashes)
Assert(201, LEN(vse_huniq) = 2)

' ── 53. ARRAY-TRANSFORMER FLAG PROPAGATION ───────────────────
'   Runtime audit: each transformer (REVERSE / SORT / TAKE / DROP /
'   APPEND / DIFF / FLATTEN / SHUFFLE / UNIQUE / STR$ / apply_ss)
'   must preserve the string-elements flag on its result so the
'   PRINT path's flag-driven dispatch keeps rendering strings.
PRINT "── String-array flag propagation ──"

tfp_xs = SPLIT("alpha,beta,gamma", ",")
tfp_x0 = ""
tfp_x0 = tfp_xs[0]
Assert(202, tfp_x0 = "alpha")
tfp_x2 = ""
tfp_x2 = tfp_xs[2]
Assert(203, tfp_x2 = "gamma")

tfp_rev = REVERSE(tfp_xs)
tfp_r0 = ""
tfp_r0 = tfp_rev[0]
Assert(204, tfp_r0 = "gamma")

tfp_tk = TAKE(2, tfp_xs)
tfp_tk0 = ""
tfp_tk0 = tfp_tk[0]
Assert(205, tfp_tk0 = "alpha")

tfp_dr = DROP(1, tfp_xs)
tfp_dr0 = ""
tfp_dr0 = tfp_dr[0]
Assert(206, tfp_dr0 = "beta")

tfp_ext = APPEND(tfp_xs, ["delta"])
Assert(207, LEN(tfp_ext) = 4)
tfp_e3 = ""
tfp_e3 = tfp_ext[3]
Assert(208, tfp_e3 = "delta")

tfp_chain = UNIQUE(APPEND(REVERSE(tfp_xs), ["alpha"]))
Assert(209, LEN(tfp_chain) = 3)
tfp_c0 = ""
tfp_c2 = ""
tfp_c0 = tfp_chain[0]
tfp_c2 = tfp_chain[2]
Assert(210, tfp_c0 = "gamma")
Assert(211, tfp_c2 = "alpha")

tfp_nums = [10, 20, 30]
tfp_strs = STR$(tfp_nums)
Assert(212, LEN(tfp_strs) = 3)
tfp_s0 = ""
tfp_s0 = tfp_strs[0]
Assert(213, tfp_s0 = "10")

' ══════════════════════════════════════════════════════════════════
' FUNC AS TYPE return-type annotations
' ──────────────────────────────────────────────────────────────────
' Regression for the codegen: explicit `AS STRING / ARRAY / OBJECT
' / DOUBLE` on a FUNC must override the f64-default that historically
' bit-pun'd ptr returns through a double. Covers literal returns,
' nested wrapping, and module-crossing flow.
' ══════════════════════════════════════════════════════════════════
PRINT "── FUNC AS TYPE ──"

IMPORT NATIVE_TEST_MODX

' AS STRING — single FUNC, $-suffix harmless
FUNC ft_str$() AS STRING
    RETURN "abc"
ENDFUNC
DIM ftS$ = ft_str$()
Assert(214, ftS$ = "abc")
Assert(215, LEN(ft_str$()) = 3)

' AS STRING — nested FUNC chain
FUNC ft_str_inner$() AS STRING
    RETURN "deep"
ENDFUNC
FUNC ft_str_outer$() AS STRING
    RETURN ft_str_inner$() + "_W"
ENDFUNC
DIM ftSW$ = ft_str_outer$()
Assert(216, ftSW$ = "deep_W")

' AS ARRAY — direct
FUNC ft_arr() AS ARRAY
    RETURN [1, 2, 3, 4]
ENDFUNC
DIM ftA = ft_arr()
Assert(217, LEN(ftA) = 4)
Assert(218, ftA[0] = 1)
Assert(219, ftA[3] = 4)

' AS ARRAY — nested wrapper
FUNC ft_arr_wrap() AS ARRAY
    RETURN ft_arr()
ENDFUNC
DIM ftAW = ft_arr_wrap()
Assert(220, LEN(ftAW) = 4)
Assert(221, ftAW[2] = 3)

' AS OBJECT — JSON handle direct
FUNC ft_obj(s$) AS OBJECT
    RETURN JSON.PARSE$(s$)
ENDFUNC
DIM ftO = ft_obj("[100,200,300]")
Assert(222, LEN(ftO) = 3)
' VM_HANDLE-element equality: stringify then compare so the test
' doesn't depend on the (separately-tracked) runtime-tagged-equals
' codegen path. The element value itself is materialised correctly,
' as PRINT confirms — only `=` on a raw RUNTIME tag is unfinished.
Assert(223, STR$(ftO[1]) = "200")

' AS OBJECT — nested chain
FUNC ft_obj_outer(s$) AS OBJECT
    RETURN ft_obj(s$)
ENDFUNC
DIM ftOO = ft_obj_outer("[1,2,3,4,5]")
Assert(224, LEN(ftOO) = 5)
Assert(225, STR$(ftOO[4]) = "5")

' AS DOUBLE — direct
FUNC ft_dbl(x AS DOUBLE) AS DOUBLE
    RETURN x * 1.5
ENDFUNC
DIM ftD = ft_dbl(4.0)
Assert(226, ftD = 6.0)

' Cross-module STRING
DIM mxS$ = NATIVE_TEST_MODX.mx_str$("hello")
Assert(227, mxS$ = "hello_X")

' Cross-module ARRAY
DIM mxA = NATIVE_TEST_MODX.mx_arr()
Assert(228, LEN(mxA) = 3)
Assert(229, mxA[1] = 20)

' Cross-module OBJECT
DIM mxO = NATIVE_TEST_MODX.mx_obj("[7,8,9]")
Assert(230, LEN(mxO) = 3)
Assert(231, STR$(mxO[2]) = "9")

' Cross-module + nested OBJECT (the SQLITE.QUERY → DB.QROWS pattern)
DIM mxOW = NATIVE_TEST_MODX.mx_obj_wrap("[42]")
Assert(232, LEN(mxOW) = 1)
Assert(233, STR$(mxOW[0]) = "42")

' Cross-module DOUBLE
DIM mxD = NATIVE_TEST_MODX.mx_dbl(4.0)
Assert(234, mxD = 10.0)

' OBJECT handle stored into a MAP slot (the vstate{"list"} = QROWS()
' pattern — caused vstate{"list"} to read back garbage when map_set
' coerce'd the handle through __jdrt_val_to_f64 instead of pun-storing
' the raw key bits).
DIM ftMap AS MAP
ftMap{"data"} = ft_obj("[10,20,30,40]")
DIM ftMapData = ftMap{"data"}
Assert(235, LEN(ftMapData) = 4)
Assert(236, STR$(ftMapData[2]) = "30")

' Multi-statement OBJECT-returning FUNC with empty-array fallback
' (equivalent of SQLITE.QUERY's `RETURN []` in the error path).
FUNC ft_maybe_obj(empty AS INTEGER) AS OBJECT
    IF empty <> 0 THEN
        RETURN JSON.PARSE$("[]")
    ENDIF
    RETURN JSON.PARSE$("[1,2,3]")
ENDFUNC
DIM ftMaybe = ft_maybe_obj(0)
Assert(237, LEN(ftMaybe) = 3)

' ══════════════════════════════════════════════════════════════════
' Tests 238-265: ARRAY_LITERAL with map-lookup elements (per-cell tags),
' tag-aware FUNC ABI for FUNCs that use TYPEOF on a parameter, BINARY
' comparison BOOL inference, and ambient-state-leak audit across user
' FUNC / SUB / builtin / VM-bridge call sites.
' ══════════════════════════════════════════════════════════════════
DIM mxMap AS MAP
mxMap{"name"} = "Anna"
mxMap{"email"} = "anna@example.com"
mxMap{"age"} = 42
mxMap{"score"} = 99.5

' Simple: ARRAY_LITERAL with single map-lookup element. Pre-fix segfaulted
' on PRINT and arr[0] returned the empty-array repr "[]".
DIM mxArr1 = [mxMap{"name"}]
Assert(238, mxArr1[0] = "Anna")

' All-string map values
DIM mxArr2 = [mxMap{"name"}, mxMap{"email"}]
Assert(239, mxArr2[0] = "Anna")
Assert(240, mxArr2[1] = "anna@example.com")

' Mixed string + number map values — per-cell tags must distinguish
DIM mxArr3 = [mxMap{"name"}, mxMap{"age"}, mxMap{"score"}, mxMap{"email"}]
Assert(241, mxArr3[0] = "Anna")
Assert(242, STR$(mxArr3[1]) = "42")
Assert(243, STR$(mxArr3[2]) = "99.5")
Assert(244, mxArr3[3] = "anna@example.com")

' Map-stored array literal containing map-lookups. The outer
' vstate{"items"}[i] reads must dispatch to the per-cell tag.
DIM mxState AS MAP
mxState{"items"} = [mxMap{"name"}, mxMap{"age"}]
Assert(245, mxState{"items"}[0] = "Anna")
Assert(246, STR$(mxState{"items"}[1]) = "42")

' Tag-aware FUNC ABI: a FUNC param used with TYPEOF becomes RUNTIME-typed
' (i64 val + i32 tag pair). Calling such a FUNC across a boundary must
' preserve the per-cell tag through the ABI.
FUNC mxQuoteForSql$(v)
    DIM t$ = TYPEOF(v)
    IF t$ = "STRING" THEN
        RETURN "'" + v + "'"
    ENDIF
    RETURN STR$(v)
ENDFUNC

' Direct: scalar string literal — tag survives through the param.
Assert(247, mxQuoteForSql$("foo") = "'foo'")

' Direct: scalar number — tag survives, no quotes.
Assert(248, mxQuoteForSql$(42) = "42")

' Cross-FUNC: param value read from map-of-mixed-tagged-array.
Assert(249, mxQuoteForSql$(mxArr3[0]) = "'Anna'")
Assert(250, mxQuoteForSql$(mxArr3[1]) = "42")
Assert(251, mxQuoteForSql$(mxArr3[3]) = "'anna@example.com'")

' Cross-FUNC: param value read from a map directly — also RUNTIME-tagged.
Assert(252, mxQuoteForSql$(mxMap{"name"}) = "'Anna'")
Assert(253, mxQuoteForSql$(mxMap{"score"}) = "99.5")

' Cross-FUNC via INNER FUNC — tagged value flows through two FUNC
' calls (caller -> fmt$ -> q$).
FUNC mxFmt$(template$, params AS DYNAMIC)
    DIM out$ = ""
    DIM pidx AS INTEGER = 0
    DIM n AS INTEGER = LEN(template$)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM c$ = MID$(template$, i, 1)
        IF c$ = "?" THEN
            out$ = out$ + mxQuoteForSql$(params[pidx])
            pidx = pidx + 1
        ELSE
            out$ = out$ + c$
        ENDIF
    NEXT i
    RETURN out$
ENDFUNC
DIM mxSql$ = mxFmt$("INSERT t(name,age,email) VALUES (?,?,?)", _
    [mxMap{"name"}, mxMap{"age"}, mxMap{"email"}])
Assert(254, mxSql$ = "INSERT t(name,age,email) VALUES ('Anna',42,'anna@example.com')")

' Pre-pass infer_tag for BINARY: comparison ops yield BOOL, not the operand
' tag. Without this, `DIM x = ("a" <> "b")` mis-inferred x's slot as STR
' (taking the tag of the left operand) and the codegen STR-pun'd a 1/0
' boolean into a bogus pointer.
DIM mxBool1 = ("a" <> "b")
Assert(255, mxBool1 = TRUE)
DIM mxBool2 = ("a" = "b")
Assert(256, mxBool2 = FALSE)
DIM mxBool3 = (1 < 2)
Assert(257, mxBool3 = TRUE)
DIM mxBool4 = (3.14 >= 3.0)
Assert(258, mxBool4 = TRUE)

' Comparison binding to BOOLEAN slot — the BOOL tag must thread through
' to make STRICT mode accept the assignment.
DIM mxBool5 AS BOOLEAN = ("foo" = "foo")
Assert(259, mxBool5 = TRUE)
DIM mxBool6 AS BOOLEAN = (10 > 5) AND ("a" <> "b")
Assert(260, mxBool6 = TRUE)

' Ambient-state-leak audit: outer assignment hint must not leak into
' inner FUNC call args, builtin args, or VM-bridge args. Without the
' RAII guards / scoped hints these patterns silently returned wrong
' types or segfaulted.

' Outer assignment to STR slot wrapping a JOIN whose array arg is a
' map-lookup. Pre-fix the STR hint leaked into JOIN's i8_ptr arg,
' picking the map_get_str fast-path that snprintf'd the array bits
' as "%g" and then JOIN read it as a JdbArray* -> segfault.
DIM mxStrArr AS MAP
mxStrArr{"items"} = ["alpha", "beta", "gamma"]
DIM mxJoined$ = JOIN(mxStrArr{"items"}, ",")
Assert(261, mxJoined$ = "alpha,beta,gamma")

' Outer INTEGER-slot assignment + map-lookup arg to a builtin. Pre-fix
' the I64 hint leaked, the inner map-get took the F64 fast-path and
' the array silently came back empty.
DIM mxLen AS INTEGER = LEN(mxStrArr{"items"})
Assert(262, mxLen = 3)

' User FUNC call with map-lookup arg. The leaf-hint scoping fix at the
' user-FUNC call site keeps the inner INDEX dispatch tag-aware so the
' callee receives a real STRING.
FUNC mxIdent$(s$)
    RETURN s$
ENDFUNC
DIM mxId$ = mxIdent$(mxMap{"name"})
Assert(263, mxId$ = "Anna")

' SUB call (no return) — same path. Side-effect via map mutation.
SUB mxStashName(target AS MAP, val$)
    target{"stash"} = val$
ENDSUB
DIM mxSink AS MAP
mxStashName(mxSink, mxMap{"name"})
Assert(264, mxSink{"stash"} = "Anna")

' Tagged array passed across FUNC boundary; iterating each element must
' not crash even when caller is a fresh literal.
SUB mxRead(arr AS DYNAMIC)
    DIM ri AS INTEGER
    FOR ri = 0 TO LEN(arr) - 1
        DIM tmp = arr[ri]
    NEXT ri
ENDSUB
mxRead([mxMap{"name"}, mxMap{"age"}, mxMap{"email"}])
Assert(265, TRUE)

' ══════════════════════════════════════════════════════════════════
' RESULTS
' ══════════════════════════════════════════════════════════════════
PRINT ""
PRINT "══════════════════════════════════════════"
PRINT " NATIVE COMPILER TEST RESULTS"
PRINT "══════════════════════════════════════════"
PRINT " PASS:     "; PASS
PRINT " FAIL:     "; FAIL
PRINT "══════════════════════════════════════════"
IF FAIL = 0 THEN
    PRINT " ALL TESTS PASSED!"
ELSE
    PRINT " SOME TESTS FAILED!"
ENDIF
PRINT "══════════════════════════════════════════"

