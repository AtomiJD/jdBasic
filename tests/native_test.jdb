PRINT "── Arrays ──"
DIM arr[5]
FOR i = 0 TO 4
    arr[i] = (i + 1) * 10
NEXT i
Assert(35,arr[0] = 10)
Assert(36,arr[4] = 50)
Assert(37,LEN(arr) = 5)

b = IOTA(5)
Assert(38,b[0] = 1)
Assert(39,b[4] = 5)
Assert(40,SUM(b) = 15)

