' Like RPG_TYPES + RPG_ENGINE + RPG_PARTY combined mini-pattern
EXPORT MODULE TEST_RECRUIT_MOD

EXPORT TYPE T_NPC
    sprite_id
    name$
    visible

    SUB INIT(nm$, sid)
        THIS.name$ = nm$
        THIS.sprite_id = sid
        THIS.visible = TRUE
    ENDSUB

    SUB SET_VISIBLE(v)
        THIS.visible = v
    ENDSUB
ENDTYPE

EXPORT DIM members = []
EXPORT DIM member_count = 0

EXPORT FUNC ADD_MEMBER(cid$)
    FOR i = 0 TO member_count - 1
        IF members[i]{"id"} = cid$ THEN RETURN FALSE
    NEXT i
    m = {}
    m{"id"} = cid$
    m{"name"} = cid$ + "_n"
    m{"sprite"} = cid$ + "_spr"
    m{"sprite_id"} = -1
    PUSH members, m
    member_count = member_count + 1
    RETURN TRUE
ENDFUNC

EXPORT FUNC GET_MEMBER(idx)
    IF idx < 0 OR idx >= member_count THEN RETURN {}
    RETURN members[idx]
ENDFUNC
