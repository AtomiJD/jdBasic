IMPORT TEST_RECRUIT_ENGINE
IMPORT TEST_RECRUIT_MOD

TEST_RECRUIT_ENGINE.INIT
TEST_RECRUIT_MOD.ADD_MEMBER "vally"

PRINT "initial hero="; TEST_RECRUIT_ENGINE.hero
TEST_RECRUIT_ENGINE.RECRUIT "mohrchen"
TEST_RECRUIT_ENGINE.UPDATE_FOLLOW_POSITIONS

PRINT "final hero="; TEST_RECRUIT_ENGINE.hero
PRINT "follow_count="; TEST_RECRUIT_ENGINE.follow_count
IF TEST_RECRUIT_ENGINE.hero <> 42 THEN PRINT "FAIL: hero should be 42"
IF TEST_RECRUIT_ENGINE.follow_count <> 1 THEN PRINT "FAIL: follow_count should be 1"
PRINT "DONE"
