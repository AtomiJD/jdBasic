' WAV.READ has to understand what real recorders actually write: 8/16/24/32-bit
' PCM, IEEE float, and WAVE_FORMAT_EXTENSIBLE (the default of WASAPI and ffmpeg).
' Every case is a hand-built file, so the test needs no recorder installed.
'
'   jdbasic tests/wav_format_test.jdb        (needs an FX build)
'
' The capture block at the end needs MINIAUDIO and a capture device; it reports
' itself as skipped when there is none.

DIM pass = 0
DIM fail = 0

SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  got ["; got$; "] want ["; want$; "]"
    ENDIF
ENDSUB

SUB CHECKF(what$, got, want)
    IF ABS(got - want) <= 0.0001 THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  got ["; got; "] want ["; want; "]"
    ENDIF
ENDSUB

' ---- little-endian byte builders ----

FUNC LE16$(v)
    DIM x = v
    IF x < 0 THEN x = x + 65536
    RETURN CHR$(x MOD 256) + CHR$(INT(x / 256) MOD 256)
ENDFUNC

FUNC LE24$(v)
    DIM x = v
    IF x < 0 THEN x = x + 16777216
    RETURN CHR$(x MOD 256) + CHR$(INT(x / 256) MOD 256) + CHR$(INT(x / 65536) MOD 256)
ENDFUNC

FUNC LE32$(v)
    DIM x = v
    IF x < 0 THEN x = x + 4294967296
    RETURN CHR$(x MOD 256) + CHR$(INT(x / 256) MOD 256) + _
           CHR$(INT(x / 65536) MOD 256) + CHR$(INT(x / 16777216) MOD 256)
ENDFUNC

' fmt chunk body for a canonical (non-extensible) header
FUNC MKFMT$(tag, bits, nch, rate)
    DIM align = nch * INT(bits / 8)
    RETURN LE16$(tag) + LE16$(nch) + LE32$(rate) + LE32$(rate * align) + _
           LE16$(align) + LE16$(bits)
ENDFUNC

' WAVE_FORMAT_EXTENSIBLE: tag 0xFFFE, real format in the SubFormat GUID
FUNC MKFMTEXT$(realtag, bits, nch, rate)
    DIM guid$ = LE16$(realtag) + CHR$(0) + CHR$(0) + _
                CHR$(0) + CHR$(0) + CHR$(16) + CHR$(0) + _
                CHR$(128) + CHR$(0) + CHR$(0) + CHR$(170) + _
                CHR$(0) + CHR$(56) + CHR$(155) + CHR$(113)
    RETURN MKFMT$(65534, bits, nch, rate) + LE16$(22) + LE16$(bits) + LE32$(3) + guid$
ENDFUNC

FUNC MKCHUNK$(id$, body$)
    DIM pad$ = ""
    IF (LEN(body$) MOD 2) = 1 THEN pad$ = CHR$(0)
    RETURN id$ + LE32$(LEN(body$)) + body$ + pad$
ENDFUNC

FUNC MKWAV$(chunks$)
    RETURN "RIFF" + LE32$(4 + LEN(chunks$)) + "WAVE" + chunks$
ENDFUNC

' write a file and read it straight back
FUNC READBACK(path$, chunks$) AS OBJECT
    BINWRITER path$, MKWAV$(chunks$)
    RETURN WAV.READ(path$)
ENDFUNC

DIM tmp$ = "tests" + CHR$(92) + "tmp_wavfmt.wav"

PRINT "--- 16-bit PCM, the format WAV.WRITE produces"

DIM body16$ = LE16$(0) + LE16$(16384) + LE16$(-16384) + LE16$(32767) + LE16$(-32768)
DIM w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(1, 16, 1, 44100)) + MKCHUNK$("data", body16$))
CHECK("16-bit is read", TYPEOF(w), "OBJECT")
CHECK("  rate", STR$(w{"rate"}), "44100")
CHECK("  channels", STR$(w{"channels"}), "1")
CHECK("  frames", STR$(w{"frames"}), "5")
DIM s = w{"samples"}
CHECKF("  Sample 0", s[0], 0.0)
CHECKF("  Sample 1", s[1], 0.5)
CHECKF("  Sample 2", s[2], -0.5)
CHECKF("  Sample 4", s[4], -1.0)

PRINT "--- 24-bit PCM, what every audio interface produces"

DIM body24$ = LE24$(0) + LE24$(4194304) + LE24$(-4194304) + LE24$(-8388608)
w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(1, 24, 1, 48000)) + MKCHUNK$("data", body24$))
CHECK("24-bit is read", TYPEOF(w), "OBJECT")
CHECK("  rate", STR$(w{"rate"}), "48000")
CHECK("  frames", STR$(w{"frames"}), "4")
s = w{"samples"}
CHECKF("  Sample 0", s[0], 0.0)
CHECKF("  Sample 1", s[1], 0.5)
CHECKF("  a negative value is sign extended", s[2], -0.5)
CHECKF("  full scale negative", s[3], -1.0)

PRINT "--- 32-bit PCM"

DIM body32$ = LE32$(0) + LE32$(1073741824) + LE32$(-1073741824)
w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(1, 32, 1, 48000)) + MKCHUNK$("data", body32$))
CHECK("32-bit is read", TYPEOF(w), "OBJECT")
s = w{"samples"}
CHECKF("  Sample 1", s[1], 0.5)
CHECKF("  Sample 2", s[2], -0.5)

PRINT "--- 8-bit PCM is unsigned"

DIM body8$ = CHR$(128) + CHR$(192) + CHR$(64) + CHR$(0)
w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(1, 8, 1, 22050)) + MKCHUNK$("data", body8$))
s = w{"samples"}
CHECKF("  the midpoint is zero", s[0], 0.0)
CHECKF("  Sample 1", s[1], 0.5)
CHECKF("  Sample 3", s[3], -1.0)

PRINT "--- IEEE float32 and float64"

DIM f32$ = CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0) + _
           CHR$(0)+CHR$(0)+CHR$(0)+CHR$(63) + _
           CHR$(0)+CHR$(0)+CHR$(128)+CHR$(191)
w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(3, 32, 1, 48000)) + MKCHUNK$("data", f32$))
CHECK("float32 is read", TYPEOF(w), "OBJECT")
s = w{"samples"}
CHECKF("  0.5", s[1], 0.5)
CHECKF("  -1.0", s[2], -1.0)

DIM f64$ = CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(224)+CHR$(63) + _
           CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(240)+CHR$(191)
w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(3, 64, 1, 48000)) + MKCHUNK$("data", f64$))
CHECK("float64 is read", TYPEOF(w), "OBJECT")
s = w{"samples"}
CHECKF("  0.5", s[0], 0.5)
CHECKF("  -1.0", s[1], -1.0)

PRINT "--- WAVE_FORMAT_EXTENSIBLE resolves to the real type"

w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMTEXT$(1, 16, 1, 48000)) + MKCHUNK$("data", body16$))
CHECK("EXTENSIBLE/PCM is read", TYPEOF(w), "OBJECT")
CHECK("  frames", STR$(w{"frames"}), "5")
s = w{"samples"}
CHECKF("  Sample 1", s[1], 0.5)

w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMTEXT$(3, 32, 1, 48000)) + MKCHUNK$("data", f32$))
CHECK("EXTENSIBLE/float is read", TYPEOF(w), "OBJECT")
s = w{"samples"}
CHECKF("  0.5", s[1], 0.5)

PRINT "--- chunks before fmt, odd length included"

DIM pre$ = MKCHUNK$("JUNK", CHR$(1) + CHR$(2) + CHR$(3))
w = READBACK(tmp$, pre$ + MKCHUNK$("fmt ", MKFMT$(1, 16, 1, 44100)) + MKCHUNK$("data", body16$))
CHECK("JUNK before fmt does not disturb it", TYPEOF(w), "OBJECT")
CHECK("  frames", STR$(w{"frames"}), "5")

PRINT "--- stereo is interleaved"

DIM st$ = LE16$(16384) + LE16$(-16384) + LE16$(32767) + LE16$(-32768)
w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(1, 16, 2, 48000)) + MKCHUNK$("data", st$))
CHECK("  channels", STR$(w{"channels"}), "2")
CHECK("  frames are half as many as samples", STR$(w{"frames"}), "2")
s = w{"samples"}
CHECKF("  frame 0 left", s[0], 0.5)
CHECKF("  frame 0 right", s[1], -0.5)
CHECKF("  frame 1 right", s[3], -1.0)

PRINT "--- WAV.INFO reads only the header"

BINWRITER tmp$, MKWAV$(pre$ + MKCHUNK$("fmt ", MKFMT$(1, 24, 2, 96000)) + MKCHUNK$("data", LE24$(0) + LE24$(0) + LE24$(0) + LE24$(0)))
DIM inf = WAV.INFO(tmp$)
CHECK("INFO answers a map", TYPEOF(inf), "OBJECT")
CHECK("  rate", STR$(inf{"rate"}), "96000")
CHECK("  channels", STR$(inf{"channels"}), "2")
CHECK("  Bits", STR$(inf{"bits"}), "24")
CHECK("  frames", STR$(inf{"frames"}), "2")

PRINT "--- unknown formats answer NONE"

w = READBACK(tmp$, MKCHUNK$("fmt ", MKFMT$(2, 4, 1, 8000)) + MKCHUNK$("data", body8$))
CHECK("ADPCM is refused", TYPEOF(w), "NONE")
CHECK("a missing file answers NONE", TYPEOF(WAV.READ("tests/does_not_exist.wav")), "NONE")

PRINT "--- WAV.WRITE and WAV.READ invert each other"

DIM src = [0.0, 0.25, -0.25, 0.75, -0.75]
WAV.WRITE tmp$, src, 48000, 1
w = WAV.READ(tmp$)
CHECK("round trip rate", STR$(w{"rate"}), "48000")
CHECK("round trip frames", STR$(w{"frames"}), "5")
s = w{"samples"}
FOR i = 0 TO 4
    CHECKF("  round trip sample " + STR$(i), s[i], src[i])
NEXT i

PRINT "--- capture"

' MON.DEVICES does not exist at all in a build without MINIAUDIO, so the
' feature is asked about before the call rather than the answer it gives.
DIM devs = NONE
IF OS.FEATURE("MINIAUDIO") THEN devs = MON.DEVICES()
IF TYPEOF(devs) = "NONE" THEN
    PRINT "  skipped: a build without MINIAUDIO"
ELSE
    DIM caps = devs{"capture"}
    IF LEN(caps) = 0 THEN
        PRINT "  skipped: no capture device"
    ELSE
        PRINT "  device: "; caps[0]
        DIM rec = WAV.RECORD(0.25, { "channels": 1, "rate": 48000 })
        CHECK("WAV.RECORD answers a map", TYPEOF(rec), "OBJECT")
        IF TYPEOF(rec) = "OBJECT" THEN
            CHECK("  rate", STR$(rec{"rate"}), "48000")
            CHECK("  channels", STR$(rec{"channels"}), "1")
            CHECK("  frames add up to 0.25 s", STR$(rec{"frames"} > 10000), "TRUE")
            ' the same map shape as WAV.READ, so it writes back out unchanged
            WAV.WRITE tmp$, rec{"samples"}, rec{"rate"}, rec{"channels"}
            DIM back = WAV.READ(tmp$)
            CHECK("  written and read back", STR$(back{"frames"} = rec{"frames"}), "TRUE")
        ENDIF
        DIM ok = WAV.RECSTART({ "seconds": 2, "rate": 48000 })
        CHECK("WAV.RECSTART starts", STR$(ok), "TRUE")
        SLEEP 300
        DIM secs = WAV.RECLEN()
        CHECK("  RECLEN keeps up", STR$(secs > 0.05), "TRUE")
        DIM rec2 = WAV.RECSTOP()
        CHECK("  RECSTOP answers a map", TYPEOF(rec2), "OBJECT")
        CHECK("  and less than the buffer", STR$(rec2{"frames"} < 96000), "TRUE")

        ' duplex: play and capture on one device so both stay in step. Whether
        ' the default devices combine is a property of the machine, so a refusal
        ' is reported rather than failed.
        DIM tone = []
        FOR i = 0 TO 4799
            tone = APPEND(tone, 0.2 * SIN(2 * MATH.PI * 440 * i / 48000))
        NEXT i
        DIM dup = WAV.RECORD(0.2, { "channels": 1, "rate": 48000, "play": tone })
        IF TYPEOF(dup) = "OBJECT" THEN
            CHECK("duplex answers frames", STR$(dup{"frames"} > 5000), "TRUE")
            CHECK("  channels", STR$(dup{"channels"}), "1")
        ELSE
            PRINT "  duplex skipped: the default devices do not combine"
        ENDIF
    ENDIF
ENDIF

PRINT ""
PRINT "wav_format_test: " + STR$(pass) + " passed, " + STR$(fail) + " failed"
IF fail = 0 THEN PRINT "ALL WAV FORMAT TESTS PASSED!"
