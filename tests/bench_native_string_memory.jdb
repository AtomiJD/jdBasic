' Measures how much memory a compiled program loses per string operation.
'
' Every mode must stay flat: a slot that owns its string releases the old
' buffer on overwrite, a FUNC releases its string locals on return, and the
' numeric loop allocates nothing. Run through bench_native_string_memory.sh,
' which compiles this and samples the resident size for several loop counts.
'
'   jdBasic bench_native_string_memory.jdb <mode> <iterations>
'
' mode: "concat" builds a fresh string each pass, "map" reads one out of a
' map, "func" builds one in a FUNC, "arg" hands fresh strings to calls and a
' map, "dyn" formats elements of a run-time kind, "field" reads fields of a
' map that came through a channel, "typeof" reads a shared word, "send"
' hands a map literal to a builtin and reads a VM object in a FOR pass,
' "number" does the same amount of arithmetic and touches no string.

OPTION "EXPLICIT"

' A compiled program sees its own path as the first argument, the interpreter
' does not, so the two arguments are read from the end.
DIM cli = OS.ARGS()
DIM mode$ AS STRING = "concat"
DIM rounds AS INTEGER = 2000000
IF LEN(cli) >= 2 THEN
    mode$ = cli[LEN(cli) - 2]
    rounds = CINT(VAL(cli[LEN(cli) - 1]))
ENDIF

DIM i AS INTEGER = 0
DIM sink$ AS STRING = ""
DIM total AS DOUBLE = 0.0
DIM started AS DOUBLE = TICK()

IF mode$ = "concat" THEN
    FOR i = 1 TO rounds
        sink$ = "row " + STR$(i)
    NEXT i
ELSEIF mode$ = "map" THEN
    DIM bag AS MAP
    bag{"k"} = "value"
    FOR i = 1 TO rounds
        sink$ = bag{"k"}
    NEXT i
ELSEIF mode$ = "func" THEN
    ' A string built inside a called function. The buffer belongs to a local
    ' slot that goes out of scope on return, so nothing else can be holding it.
    FOR i = 1 TO rounds
        sink$ = Decorate$(i)
    NEXT i
ELSEIF mode$ = "arg" THEN
    ' A fresh string handed to a builtin, to a bridge builtin and to a FUNC
    ' that only reads its parameter: each dies after the call.
    DIM bag2 AS MAP
    FOR i = 1 TO rounds
        total = total + LEN("row " + STR$(i)) + Measure("cell " + STR$(i))
        bag2{"k"} = "row " + STR$(i)
    NEXT i
ELSEIF mode$ = "dyn" THEN
    ' STR$ of an element whose kind is known only at run time formats it
    ' several ways and keeps one; the others are released.
    DIM cells = [1, 2, 3]
    FOR i = 1 TO rounds
        sink$ = Render$(cells)
    NEXT i
ELSEIF mode$ = "field" THEN
    ' Fields read out of a map that came through a channel (a VM object):
    ' each read copies, and the copy goes back once it has been used.
    DIM box = CHAN.OPEN(2)
    CHAN.SEND box, {"NAME": "song/clock", "WAVE": IOTA(256)}
    DIM msg = CHAN.RECV(box, 100)
    DIM names AS MAP
    i = 0
    DO WHILE i < rounds
        i = i + 1
        DIM label$ AS STRING = msg{"NAME"}
        names{"last"} = msg{"NAME"}
        total = total + LEN(msg{"WAVE"}) + Measure("at " + msg{"NAME"})
    LOOP
ELSEIF mode$ = "typeof" THEN
    ' TYPEOF answers with one of ten fixed words and hands out a shared
    ' buffer, so this column must stay flat. It used to allocate once per
    ' call, which is what made the 6502 emulator grow by 40 MB a second.
    DIM probe = 42
    FOR i = 1 TO rounds
        sink$ = TYPEOF(probe)
    NEXT i
ELSEIF mode$ = "send" THEN
    ' The literal is copied into the channel and freed after the call; the
    ' received object is a VM value the pass releases at its end.
    DIM box = CHAN.OPEN(2)
    DIM got = {}
    FOR i = 1 TO rounds
        CHAN.SEND box, {"TOPIC": "song/clock", "N": i, "DATA": {"T": i}}
        got = CHAN.RECV(box, 100)
        total = total + got{"N"}
    NEXT i
ELSE
    FOR i = 1 TO rounds
        total = total + i * 0.5
    NEXT i
ENDIF

PRINT mode$ + " " + STR$(rounds) + " rounds in " + STR$(TICK() - started) + " ms"
PRINT "sink " + sink$ + " total " + STR$(total)

FUNC Decorate$(n)
    DIM body$ = "row " + STR$(n)
    DIM framed$ = "[" + body$ + "]"
    RETURN framed$
ENDFUNC

FUNC Measure(s$)
    RETURN LEN(s$) + INSTR(s$, "1")
ENDFUNC

FUNC Render$(v)
    DIM out$ = ""
    DIM k AS INTEGER
    FOR k = 0 TO LEN(v) - 1
        out$ = out$ + STR$(v[k])
    NEXT k
    RETURN out$ + "."
ENDFUNC
