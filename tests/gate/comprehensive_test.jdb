' ══════════════════════════════════════════════════════════════════
'  jdBasic Comprehensive Test Suite
'  Tests: Loops, Variables, Types, Functions, Lambdas, Pipes,
'         React, Strings, Math, Operators, Unicode, and more
' ══════════════════════════════════════════════════════════════════
OPTION "EXPLICIT"
OPTION "STRICT"

DIM PASS = 0
DIM FAIL = 0
DIM SECTION = ""
DIM TOTAL_SECTIONS = 0

SUB Header(title)
  SECTION = title
  TOTAL_SECTIONS = TOTAL_SECTIONS + 1
  PRINT ""
  PRINT "── "; title; " ──"
ENDSUB

SUB Assert(cond, msg)
  IF cond THEN
    PASS = PASS + 1
  ELSE
    FAIL = FAIL + 1
    PRINT "  FAIL ["; SECTION; "]: "; msg
  ENDIF
ENDSUB

' ══════════════════════════════════════════════════════════════════
' 1. BASIC ARITHMETIC & OPERATORS
' ══════════════════════════════════════════════════════════════════
Header("Arithmetic & Operators")

Assert(2 + 3 = 5, "int add")
Assert(100 - 42 = 58, "int sub")
Assert(7 * 8 = 56, "int mul")
Assert(10 / 3 > 3.33, "float div")
Assert(17 MOD 5 = 2, "mod")
Assert(2 ^ 10 = 1024, "power")
Assert(-(-5) = 5, "double neg")
Assert(-(3 + 4) = -7, "neg expr")

' Integer overflow → promote to double instead of wrapping silently.
' 20! is the largest exact int64 (2432902008176640000), 21! overflows.
Assert(FAC(20) = 2432902008176640000, "FAC(20) exact int64")
Assert(FAC(21) > 5.1E19 AND FAC(21) < 5.11E19, "FAC(21) promoted to double")
Assert(FAC(170) > 7.25E306, "FAC(170) reaches double range")
Assert(2000000000 * 5 = 1.0E10, "int*int overflow promotes to double")
Assert(2000000000 + 9000000000 = 1.1E10, "int+int overflow promotes to double")
' Lotto regression: 49!/(6!*43!) = 13983816 — needs intermediate doubles
Assert(FAC(49) / (FAC(6) * FAC(43)) = 13983816, "Lotto 6 aus 49 combinations")

' 2-D matrix arithmetic + boolean masks must keep their shape recursively
' (regression for Game of Life style code that builds masks via element-wise
' compare + AND on a [N,M] board).
DIM bx[3, 3]
bx[0, 0] = 1
bx[1, 1] = 1
bx[2, 2] = 1
DIM by[3, 3]
by[0, 0] = 1
by[1, 1] = 1
DIM bsum = bx + by
Assert(bsum[0,0] = 2, "2-D arr+arr keeps shape [0,0]")
Assert(bsum[2,2] = 1, "2-D arr+arr keeps shape [2,2]")

' (board = 0) and (board = 1) must each be 2-D bool matrices
DIM bcmp = (bx = 1)
Assert(bcmp[0,0] = TRUE,  "2-D arr=scalar keeps shape [0,0]")
Assert(bcmp[0,1] = FALSE, "2-D arr=scalar keeps shape [0,1]")

' AND of two 2-D bool matrices stays 2-D
DIM bcmp2 = (by = 1)
DIM b_and = bcmp AND bcmp2
Assert(b_and[0,0] = TRUE,  "2-D AND keeps shape [0,0]")
Assert(b_and[2,2] = FALSE, "2-D AND keeps shape [2,2]")
DIM b_or = bcmp OR bcmp2
Assert(b_or[2,2] = TRUE, "2-D OR keeps shape [2,2]")

' Hex literals
Assert($FF = 255, "hex FF")
Assert($80000 = 524288, "hex 80000")
Assert($0A = 10, "hex 0A")

' Comparison
Assert(5 > 3, "gt")
Assert(3 < 5, "lt")
Assert(5 >= 5, "ge eq")
Assert(6 >= 5, "ge gt")
Assert(5 <= 5, "le eq")
Assert(4 <= 5, "le lt")
Assert(5 <> 4, "ne")
Assert(NOT (5 <> 5), "not ne")

' Boolean operators
Assert(TRUE AND TRUE, "and tt")
Assert(NOT (TRUE AND FALSE), "and tf")
Assert(TRUE OR FALSE, "or tf")
Assert(NOT (FALSE OR FALSE), "or ff")
Assert(NOT FALSE, "not f")
Assert(NOT NOT TRUE, "not not t")

' Short-circuit
DIM sc_called = FALSE
FUNC ScSideEffect()
  sc_called = TRUE
  RETURN TRUE
ENDFUNC
DIM sc_result AS INTEGER = 0
sc_result = FALSE ANDALSO ScSideEffect()
Assert(NOT sc_called, "andalso short-circuit")
sc_result = TRUE ORELSE ScSideEffect()
Assert(NOT sc_called, "orelse short-circuit")

' Bitwise
Assert((5 BAND 3) = 1, "b_and")
Assert((5 BOR 3) = 7, "bor")
Assert((5 XOR 3) = 6, "xor")

' ══════════════════════════════════════════════════════════════════
' 2. VARIABLES & TYPES
' ══════════════════════════════════════════════════════════════════
Header("Variables & Types")

LET int_val = 42
Assert(int_val = 42, "let int")
Assert(TYPEOF(int_val) = "INT64", "typeof int")

LET float_val = 3.14
Assert(float_val > 3.13 AND float_val < 3.15, "let float")
Assert(TYPEOF(float_val) = "FLOAT64", "typeof float")

LET str_val = "Hello"
Assert(str_val = "Hello", "let string")
Assert(TYPEOF(str_val) = "STRING", "typeof string")

DIM bool_val AS BOOLEAN = TRUE
Assert(bool_val, "dim boolean true")
Assert(TYPEOF(bool_val) = "BOOLEAN", "typeof boolean")

' DIM without value — may or may not be NONE depending on scope
' (bare untyped `DIM none_val` is a STRICT compile error under -c, so the
' loose "dim default" behaviour can't be exercised in this -c-compiled suite;
' it is interp-only and covered by ad-hoc probes.)

' Type checking functions
Assert(ISNUM(42), "isnum int")
Assert(ISNUM(3.14), "isnum float")
Assert(ISSTR("hi"), "isstr")
Assert(ISARR([1,2]), "isarr")
Assert(ISBOOL(TRUE), "isbool true")
Assert(ISBOOL(FALSE), "isbool false")
Assert(ISMAP({"a": 1}), "ismap")

' IIF
Assert(IIF(TRUE, "yes", "no") = "yes", "iif true")
Assert(IIF(FALSE, "yes", "no") = "no", "iif false")
Assert(IIF(1 > 0, 100, 200) = 100, "iif numeric")

' ══════════════════════════════════════════════════════════════════
' 3. STRINGS & UNICODE
' ══════════════════════════════════════════════════════════════════
Header("Strings & Unicode")

' Basic string functions
Assert(LEN("Hello") = 5, "len")
Assert(LEFT("Hello", 2) = "He", "left")
Assert(RIGHT("Hello", 3) = "llo", "right")
Assert(MID("Hello", 1, 3) = "ell", "mid")
Assert(UCASE("hello") = "HELLO", "ucase")
Assert(LCASE("HELLO") = "hello", "lcase")
Assert(CHR(65) = "A", "chr")
Assert(ASC("A") = 65, "asc")
Assert(STR(42) = "42", "str")
Assert(VAL("3.14") > 3.13, "val")

' String operators
Assert("Hello" + " " + "World" = "Hello World", "concat")
Assert("-" * 5 = "-----", "repeat")
Assert(3 * "ab" = "ababab", "repeat left")

' String subtraction (remove)
Assert("abcabc" - "bc" = "aa", "str subtract")

' IN operator with strings
Assert("ell" IN "Hello", "in string")
Assert(NOT ("xyz" IN "Hello"), "not in string")

' Sonderzeichen und Umlaute
LET german = "Gr\u00fc\u00dfe aus Deutschland!"
Assert(LEN(german) > 5, "german string len")

' Emojis - GenZ approved
LET emoji_str = "Hello World!😀🌴👍"
Assert(LEN(emoji_str) > 0, "emoji string")
PRINT "  Emoji test: "; emoji_str

' PRINT variations
PRINT "  Multi-value:"; " A="; 1; " B="; 2; " C="; 3
PRINT "  No newline test: ";
PRINT "continued here"
PRINT "  Tab test:", "col1", "col2"

' ══════════════════════════════════════════════════════════════════
' 4. ARRAYS
' ══════════════════════════════════════════════════════════════════
Header("Arrays")

' Literal
LET arr1 = [10, 20, 30, 40, 50]
Assert(LEN(arr1) = 5, "arr literal len")
Assert(arr1[0] = 10, "arr idx 0")
Assert(arr1[4] = 50, "arr idx 4")

' Classic-BASIC bracket DIM forms (DIM A[20], DIM M[5,3], DIM A[N] AS T)
DIM br_a[20]
Assert(LEN(br_a) = 20, "DIM A[20] len")
Assert(br_a[0] = 0, "DIM A[20] zero-init")
Assert(br_a[19] = 0, "DIM A[20] last")

DIM br_b[3, 4]
Assert(LENV(br_b)[0] = 3, "DIM M[3,4] outer dim")
Assert(LENV(br_b)[1] = 4, "DIM M[3,4] inner dim")

DIM br_c[5] AS INTEGER
Assert(LEN(br_c) = 5, "DIM A[5] AS INTEGER len")

DIM br_n = 7
DIM br_d[br_n]
Assert(LEN(br_d) = 7, "DIM A[var] runtime size")

DIM br_e[3] = [10, 20, 30]
Assert(br_e[1] = 20, "DIM A[3] = literal overrides")

' Regression: MULTI_INDEX_SET (`A[i,j] = v`) was missing from
' opcode_width(), so the peephole optimiser walked into the middle of
' subsequent instructions and corrupted the bytecode chunk. The exact
' threshold is 9 multi-index assigns followed by a normal INDEX_SET —
' that's enough drift for the corruption to break b[1] = -11.
DIM br_M[3, 3]
br_M[0,0] = 2 : br_M[0,1] = 1 : br_M[0,2] = -1
br_M[1,0] = -3 : br_M[1,1] = -1 : br_M[1,2] = 2
br_M[2,0] = -2 : br_M[2,1] = 1 : br_M[2,2] = 2
DIM br_v[3]
br_v[0] = 8
br_v[1] = -11
br_v[2] = -3
Assert(br_M[0,0] = 2, "multi-idx assign survives peephole [0,0]")
Assert(br_M[2,2] = 2, "multi-idx assign survives peephole [2,2]")
Assert(br_v[0] = 8, "scalar idx assign after multi-idx [0]")
Assert(br_v[1] = -11, "scalar idx assign after multi-idx [1]")
Assert(br_v[2] = -3, "scalar idx assign after multi-idx [2]")

' Multi-variable DIM (comma-separated) — classic BASIC convenience.
' Each clause has its own type and optional initialiser.
' (bare multi-var `DIM a, b, c` is interp-only — untyped DIM is a STRICT
' compile error under -c. The typed multi-var form below is the native one.)

DIM mv_x AS INTEGER, mv_y AS STRING
mv_x = 42
mv_y = "hello"
Assert(mv_x = 42, "DIM a AS INT, b AS STR — int")
Assert(mv_y = "hello", "DIM a AS INT, b AS STR — str")

DIM mv_p = 10, mv_q = 20, mv_r = 30
Assert(mv_p + mv_q + mv_r = 60, "DIM with inits")

DIM mv_m AS INTEGER = 5, mv_n AS DOUBLE = 3.5
Assert(mv_m = 5, "DIM AS T = expr (int)")
Assert(mv_n = 3.5, "DIM AS T = expr (double)")

DIM mv_arr[4] AS INTEGER, mv_str AS STRING
mv_str = "ok"
Assert(LEN(mv_arr) = 4, "DIM A[N], B AS T — array")
Assert(mv_str = "ok", "DIM A[N], B AS T — string")

' DIM A[N] AS UDT — array of constructed UDT instances + arr[i].field assign
TYPE _BrItem
    Name AS STRING
    Score AS INTEGER
ENDTYPE
DIM br_arr[3] AS _BrItem
Assert(LEN(br_arr) = 3, "DIM A[N] AS UDT len")
Assert(br_arr[0]{"__TYPE__"} = "_BRITEM", "DIM A[N] AS UDT __TYPE__ set")
br_arr[0].Name = "alpha"
br_arr[0].Score = 7
br_arr[1].Name = "beta"
br_arr[1].Score = 14
Assert(br_arr[0].Name = "alpha", "arr[i].field assign + read (str)")
Assert(br_arr[0].Score = 7, "arr[i].field assign + read (int)")
Assert(br_arr[1].Name = "beta", "arr[i].field different element")
Assert(br_arr[2].Name = "", "arr[i] default field empty")

' Mixed chain in FOR loop (the app_master.jdb pattern)
FOR br_i = 0 TO 2
    br_arr[br_i].Score = br_i * 10
NEXT br_i
Assert(br_arr[2].Score = 20, "arr[i].field in FOR loop")

' Push/Pop
DIM arr2 AS ARRAY
PUSH arr2, "alpha"
PUSH arr2, "beta"
PUSH arr2, "gamma"
Assert(LEN(arr2) = 3, "push len")
LET popped = POP(arr2)
Assert(popped = "gamma", "pop val")
Assert(LEN(arr2) = 2, "pop len")

' Array arithmetic (element-wise)
LET va = [1, 2, 3]
LET vb = [10, 20, 30]
LET vc = va + vb
Assert(vc[0] = 11 AND vc[1] = 22 AND vc[2] = 33, "arr add")
LET vd = va * 3
Assert(vd[0] = 3 AND vd[1] = 6 AND vd[2] = 9, "arr scalar mul")
LET ve = vb - va
Assert(ve[0] = 9 AND ve[1] = 18 AND ve[2] = 27, "arr sub")

' IOTA
LET seq = IOTA(5)
Assert(seq[0] = 1 AND seq[4] = 5, "iota default")
LET seq2 = IOTA(4, 0, 2)
Assert(seq2[0] = 0 AND seq2[1] = 2 AND seq2[3] = 6, "iota step")

' Nested arrays
LET matrix = [[1,2,3],[4,5,6],[7,8,9]]
Assert(matrix[1][1] = 5, "nested arr")
Assert(LEN(matrix) = 3, "nested len")

' Destructuring
[da, db, dc] = [100, 200, 300]
Assert(da = 100, "destruct a")
Assert(db = 200, "destruct b")
Assert(dc = 300, "destruct c")

' Destructuring into INDEXED / MAP / MIXED targets (not just plain vars).
' The whole RHS is evaluated before any store, so in-place swaps are safe.
' Plain variable swap (fast path)
DIM dsw1 = 1
DIM dsw2 = 2
[dsw1, dsw2] = [dsw2, dsw1]
Assert(dsw1 = 2, "destruct plain swap a")
Assert(dsw2 = 1, "destruct plain swap b")

' Numeric array element swap in place
DIM dna = [10, 20, 30]
[dna[0], dna[2]] = [dna[2], dna[0]]
Assert(dna[0] = 30, "destruct num-array idx swap [0]")
Assert(dna[2] = 10, "destruct num-array idx swap [2]")

' String array element swap in place
DIM dsa = ["x", "y", "z"]
[dsa[0], dsa[2]] = [dsa[2], dsa[0]]
DIM dsa0 AS STRING = dsa[0]
DIM dsa2 AS STRING = dsa[2]
Assert(dsa0 = "z", "destruct str-array idx swap [0]")
Assert(dsa2 = "x", "destruct str-array idx swap [2]")

' Map value swap (m{key} targets)
DIM dmap AS MAP
dmap{"a"} = 11
dmap{"b"} = 22
[dmap{"a"}, dmap{"b"}] = [dmap{"b"}, dmap{"a"}]
Assert(dmap{"a"} = 22, "destruct map swap a")
Assert(dmap{"b"} = 11, "destruct map swap b")

' Mixed targets (variable + array element + map key), numeric values
DIM dmx_v = 0
DIM dmx_a = [100, 200]
DIM dmx_m AS MAP
[dmx_v, dmx_a[0], dmx_m{"lall"}] = [dmx_a[1], 55, 3]
Assert(dmx_v = 200, "destruct mixed: var <- array elem")
Assert(dmx_a[0] = 55, "destruct mixed: array-idx target")
Assert(dmx_m{"lall"} = 3, "destruct mixed: map-key target")

' Mixed value types in one statement (string into a map value, number into var)
DIM dmt_b = [7, 8]
DIM dmt_d AS MAP
DIM dmt_a = 0
[dmt_a, dmt_d{"lall"}] = [dmt_b[1], "Bert"]
Assert(dmt_a = 8, "destruct mixed-type: numeric var")
Assert(dmt_d{"lall"} = "Bert", "destruct mixed-type: string into map")

' Non-literal RHS (a FUNC returning an array) into indexed targets
FUNC dg_triple()
    RETURN [10, 20, 30]
ENDFUNC
DIM dgrid = [0, 0, 0]
[dgrid[0], dgrid[2]] = dg_triple()
Assert(dgrid[0] = 10, "destruct from FUNC return [0] <- rhs[0]")
Assert(dgrid[2] = 20, "destruct from FUNC return [2] <- rhs[1]")

' IN operator
Assert("B" IN ["A", "B", "C"], "in array")
Assert(NOT ("D" IN ["A", "B", "C"]), "not in array")

' ══════════════════════════════════════════════════════════════════
' 5. MAPS / OBJECTS
' ══════════════════════════════════════════════════════════════════
Header("Maps & Objects")

' Map literal
LET person = {"name": "Max", "age": 30, "city": "Berlin"}
Assert(person{"name"} = "Max", "map get name")
Assert(person{"age"} = 30, "map get age")
Assert(person{"city"} = "Berlin", "map get city")

' Map mutation
person{"age"} = 31
Assert(person{"age"} = 31, "map set")

' DIM AS OBJECT
DIM obj AS OBJECT
obj{"key1"} = "value1"
obj{"key2"} = 42
Assert(obj{"key1"} = "value1", "obj set/get str")
Assert(obj{"key2"} = 42, "obj set/get int")

' IN operator with maps
Assert("name" IN person, "in map key")
Assert(NOT ("phone" IN person), "not in map key")

' ══════════════════════════════════════════════════════════════════
' 6. ENUM
' ══════════════════════════════════════════════════════════════════
Header("Enums")

ENUM Direction
  NORTH = 0
  EAST = 1
  SOUTH = 2
  WEST = 3
ENDENUM

Assert(Direction.NORTH = 0, "enum north")
Assert(Direction.EAST = 1, "enum east")
Assert(Direction.SOUTH = 2, "enum south")
Assert(Direction.WEST = 3, "enum west")

ENUM HttpStatus
  OK = 200
  NOT_FOUND = 404
  SERVER_ERROR = 500
ENDENUM
Assert(HttpStatus.OK = 200, "enum http 200")
Assert(HttpStatus.NOT_FOUND = 404, "enum http 404")

' Enum members may be BASIC keywords (DEFAULT, IF, THEN, etc.) since they
' live in their own namespace. Regression for ansi_styles.jdb crash.
ENUM Style
    DEFAULT = 0
    BOLD    = 1
    IF      = 2
    THEN    = 3
ENDENUM
Assert(Style.DEFAULT = 0, "enum keyword DEFAULT")
Assert(Style.BOLD    = 1, "enum keyword BOLD")
Assert(Style.IF      = 2, "enum keyword IF")
Assert(Style.THEN    = 3, "enum keyword THEN")

' ══════════════════════════════════════════════════════════════════
' 7. TYPE / UDT
' ══════════════════════════════════════════════════════════════════
Header("User-Defined Types")

TYPE Vector2D
  X AS FLOAT64
  Y AS FLOAT64
  FUNC Length()
    RETURN SQR(THIS.X * THIS.X + THIS.Y * THIS.Y)
  ENDFUNC
  SUB Scale(factor)
    THIS.X = THIS.X * factor
    THIS.Y = THIS.Y * factor
  ENDSUB
ENDTYPE

DIM v AS Vector2D
v{"X"} = 3.0
v{"Y"} = 4.0
Assert(v.Length() = 5.0, "udt method length")
v.Scale(2)
Assert(v{"X"} = 6.0, "udt method scale x")
Assert(v{"Y"} = 8.0, "udt method scale y")
' C8 (audit): PRINT of a brace-key index on an ARR-tagged base (a UDT instance
' is ARR-tagged in native) used to route through the numeric __print_arr_elem
' with the string key as the index -> IR verifier aborted the whole compile.
' The PRINT fast-path now skips string keys and falls to the generic path.
PRINT "  udt brace-field via PRINT: "; v{"X"}

' Method call on a LOCAL object inside a SUB.
' Regression: the parser turns `obj.method(args)` into a CALL "OBJ.METHOD",
' and the VM's fallback only looked at GLOBALS for the receiver. Inside a
' SUB, `lv` is a local, so the fallback used to throw "Undefined function:
' LV.LENGTH" — even though the same call worked at the top level.
DIM SUB_LEN_OK = FALSE
DIM SUB_SCALE_X AS DOUBLE = 0.0
SUB UseLocalVec()
    DIM lv AS Vector2D
    lv{"X"} = 6.0
    lv{"Y"} = 8.0
    SUB_LEN_OK = (lv.Length() = 10.0)
    lv.Scale(0.5)
    SUB_SCALE_X = lv{"X"}
ENDSUB
UseLocalVec
Assert(SUB_LEN_OK, "udt method on local in SUB")
Assert(SUB_SCALE_X = 3.0, "udt mutating method on local in SUB")

' Dotted property chain on a LOCAL inside a SUB.
' Regression: the parser greedily folds `lo.X` into a single global name
' "LO.X" and emits LOAD_GLOBAL. The fallback that walks the chain only
' looked at globals — inside a SUB the receiver was missed and the value
' came back NONE, even though `lo{"X"}` worked fine.
DIM SUB_X = 0.0
DIM SUB_Y = 0.0
SUB ReadLocalDots()
    DIM lo AS Vector2D
    lo{"X"} = 1.5
    lo{"Y"} = 2.5
    SUB_X = lo.X
    SUB_Y = lo.Y
ENDSUB
ReadLocalDots
Assert(SUB_X = 1.5, "dotted load on local in SUB (X)")
Assert(SUB_Y = 2.5, "dotted load on local in SUB (Y)")

' ══════════════════════════════════════════════════════════════════
' 8. CONTROL FLOW - IF / SWITCH
' ══════════════════════════════════════════════════════════════════
Header("Control Flow")

' Multi-branch IF
DIM grade = 85
DIM letter = ""
IF grade >= 90 THEN
  letter = "A"
ELSEIF grade >= 80 THEN
  letter = "B"
ELSEIF grade >= 70 THEN
  letter = "C"
ELSE
  letter = "F"
ENDIF
Assert(letter = "B", "if elseif")

' One-line IF
LET ol = 0
IF TRUE THEN ol = 99
Assert(ol = 99, "one-line if")

' One-liner IF with multiple statements (colon-separated)
DIM ol_a = 0 : DIM ol_b = 0
IF TRUE THEN ol_a = 1 : ol_b = 2
Assert(ol_a = 1, "one-liner multi-stmt THEN a")
Assert(ol_b = 2, "one-liner multi-stmt THEN b")

' One-liner: false branch should NOT execute any colon-separated stmt
DIM ol_c = 0 : DIM ol_d = 0
IF FALSE THEN ol_c = 1 : ol_d = 2
Assert(ol_c = 0, "one-liner false: skip a")
Assert(ol_d = 0, "one-liner false: skip b")

' One-liner IF with ELSE
DIM ol_e = 0
IF FALSE THEN ol_e = 1 ELSE ol_e = 2
Assert(ol_e = 2, "one-liner IF ELSE")

' One-liner IF ELSE with multi-stmt in THEN
DIM ol_f = 0 : DIM ol_g = 0
IF TRUE THEN ol_f = 10 : ol_g = 20 ELSE ol_f = 30 : ol_g = 40
Assert(ol_f = 10, "one-liner true: THEN a")
Assert(ol_g = 20, "one-liner true: THEN b")

' One-liner IF ELSE with multi-stmt in ELSE
DIM ol_h = 0 : DIM ol_i = 0
IF FALSE THEN ol_h = 10 : ol_i = 20 ELSE ol_h = 30 : ol_i = 40
Assert(ol_h = 30, "one-liner false: ELSE a")
Assert(ol_i = 40, "one-liner false: ELSE b")

' One-liner IF with END (should not execute END when false)
DIM ol_survived = FALSE
IF FALSE THEN ol_survived = TRUE : PRINT "BUG"
ol_survived = TRUE
Assert(ol_survived = TRUE, "one-liner false: no side effects")

' Nested one-liner inside multi-line IF
DIM ol_nest = 0
IF TRUE THEN
    IF TRUE THEN ol_nest = 42
ENDIF
Assert(ol_nest = 42, "nested one-liner in block IF")

' One-liner should not steal outer ELSE
DIM ol_outer = 0
IF TRUE THEN
    IF FALSE THEN ol_outer = 1
ELSE
    ol_outer = 99
ENDIF
Assert(ol_outer = 0, "one-liner doesn't steal outer ELSE")

' SWITCH
DIM day = 3
DIM day_name = ""
SWITCH day
  CASE 1
    day_name = "Monday"
  CASE 2
    day_name = "Tuesday"
  CASE 3
    day_name = "Wednesday"
  DEFAULT
    day_name = "Other"
ENDSWITCH
Assert(day_name = "Wednesday", "switch case 3")

' ══════════════════════════════════════════════════════════════════
' 9. LOOPS - ALL VARIATIONS
' ══════════════════════════════════════════════════════════════════
Header("Loops - All Variations")

' FOR / NEXT basic
DIM for_sum = 0
FOR i = 1 TO 10
  for_sum = for_sum + i
NEXT
Assert(for_sum = 55, "for 1 to 10")

' FOR with STEP
DIM step_sum = 0
FOR i = 0 TO 20 STEP 5
  step_sum = step_sum + i
NEXT
Assert(step_sum = 50, "for step 5")

' FOR negative STEP
DIM neg_sum = 0
FOR i = 10 TO 1 STEP -1
  neg_sum = neg_sum + i
NEXT
Assert(neg_sum = 55, "for step -1")

' FOR EACH
DIM each_result = ""
DIM fruits = ["apple", "banana", "cherry"]
FOR EACH f IN fruits
  each_result = each_result + LEFT(f, 1)
NEXT
Assert(each_result = "abc", "for each")

' DO WHILE ... LOOP
DIM dw = 0
DO WHILE dw < 5
  dw = dw + 1
LOOP
Assert(dw = 5, "do while top")

' DO ... LOOP WHILE
DIM dlw = 0
DO
  dlw = dlw + 1
LOOP WHILE dlw < 5
Assert(dlw = 5, "do loop while")

' DO UNTIL ... LOOP
DIM du = 0
DO UNTIL du = 7
  du = du + 1
LOOP
Assert(du = 7, "do until top")

' DO ... LOOP UNTIL
DIM dlu = 0
DO
  dlu = dlu + 1
LOOP UNTIL dlu = 7
Assert(dlu = 7, "do loop until")

' EXITFOR
DIM ef = 0
FOR i = 1 TO 100
  IF i = 6 THEN EXITFOR
  ef = ef + i
NEXT
Assert(ef = 15, "exitfor at 6")

' CONTINUEFOR
DIM cf = 0
FOR i = 1 TO 5
  IF i = 3 THEN CONTINUEFOR
  cf = cf + i
NEXT
Assert(cf = 12, "continuefor skip 3")

' EXITDO
DIM ed = 0
DO
  ed = ed + 1
  IF ed = 4 THEN EXITDO
LOOP
Assert(ed = 4, "exitdo")

' CONTINUEDO
DIM cd = 0
DIM cd_sum = 0
DO WHILE cd < 5
  cd = cd + 1
  IF cd = 3 THEN CONTINUEDO
  cd_sum = cd_sum + cd
LOOP
Assert(cd_sum = 12, "continuedo skip 3")

' Nested loops
DIM nested = 0
FOR i = 1 TO 3
  FOR j = 1 TO 3
    nested = nested + 1
  NEXT
NEXT
Assert(nested = 9, "nested for 3x3")

' Deeply nested with mixed types
DIM deep AS DOUBLE = 0.0
FOR i = 1 TO 2
  DIM k = 0
  DO WHILE k < 2
    k = k + 1
    FOR EACH x IN [10, 20]
      deep = deep + x
    NEXT
  LOOP
NEXT
Assert(deep = 120, "deep nested for+do+each")

' ══════════════════════════════════════════════════════════════════
' 10. FUNCTIONS & SUBS
' ══════════════════════════════════════════════════════════════════
Header("Functions & Subs")

' Basic function
FUNC Add(a, b)
  RETURN a + b
ENDFUNC
Assert(Add(3, 4) = 7, "func add")

' Recursive function
FUNC Factorial(n)
  IF n <= 1 THEN RETURN 1
  RETURN n * Factorial(n - 1)
ENDFUNC
Assert(Factorial(6) = 720, "factorial 6")
Assert(Factorial(0) = 1, "factorial 0")

' Function with local variables (shadowing global)
DIM shadow_test = "global"
FUNC TestShadow()
  DIM shadow_test = "local"
  RETURN shadow_test
ENDFUNC
Assert(TestShadow() = "local", "shadow local")
Assert(shadow_test = "global", "shadow preserved")

' SUB modifying globals
DIM sub_counter = 0
SUB CountUp(n)
  FOR ci = 1 TO n
    sub_counter = sub_counter + 1
  NEXT
ENDSUB
CountUp(5)
Assert(sub_counter = 5, "sub global modify")

' Nested function calls
FUNC Square(x)
  RETURN x * x
ENDFUNC
FUNC SumOfSquares(a, b)
  RETURN Square(a) + Square(b)
ENDFUNC
Assert(SumOfSquares(3, 4) = 25, "nested func calls")

' EXITFUNC
FUNC EarlyReturn(x)
  IF x < 0 THEN EXITFUNC
  RETURN x * 2
ENDFUNC
Assert(TYPEOF(EarlyReturn(-1)) = "NONE", "exitfunc returns none")
Assert(EarlyReturn(5) = 10, "normal return")

' ══════════════════════════════════════════════════════════════════
' 11. HIGHER-ORDER FUNCTIONS & LAMBDAS
' ══════════════════════════════════════════════════════════════════
Header("Lambdas & Higher-Order")

' Basic lambda
LET dbl_fn = LAMBDA x -> x * 2
Assert(dbl_fn(5) = 10, "lambda basic")

' Lambda with USE (captures)
DIM multiplier = 10
LET scale = LAMBDA USE(multiplier) x -> x * multiplier
Assert(scale(5) = 50, "lambda use capture")

' Higher-order: function taking funcref
FUNC Apply(fn, val)
  RETURN fn(val)
ENDFUNC
Assert(Apply(LAMBDA x -> x + 100, 5) = 105, "higher-order apply")

' Higher-order functions with inline test
' (REDUCE/FILTER/SELECT use call_funcref internally)
FUNC MyReduce(arr, fn, init)
  DIM acc = init
  FOR EACH item IN arr
    acc = fn(acc, item)
  NEXT
  RETURN acc
ENDFUNC
LET total_r = MyReduce([1,2,3,4,5], LAMBDA a, b -> a + b, 0)
Assert(total_r = 15, "custom reduce sum")

' Pipe operator (known issue with global var fix — skipped for now)
' LET pipe_result = 5 |> LAMBDA x -> x * 3
' Assert(pipe_result = 15, "pipe basic")

' Function reference with @
FUNC Triple(x)
  RETURN x * 3
ENDFUNC
LET fn_ref = Triple@
Assert(fn_ref(7) = 21, "funcref @")

' ══════════════════════════════════════════════════════════════════
' 12. TRY / CATCH / THROW
' ══════════════════════════════════════════════════════════════════
Header("Error Handling")

DIM caught = FALSE
DIM err_msg = ""
TRY
  THROW "custom error 42"
CATCH
  caught = TRUE
  err_msg = ERRMSG$
ENDTRY
Assert(caught, "try catch")
Assert(err_msg = "custom error 42", "errmsg")

' Nested try
DIM inner_caught = FALSE
TRY
  TRY
    THROW "inner"
  CATCH
    inner_caught = TRUE
  ENDTRY
  ' This should still execute
  Assert(TRUE, "after inner catch")
CATCH
  Assert(FALSE, "outer should not catch")
ENDTRY
Assert(inner_caught, "nested try")

' Division by zero
DIM div_caught = FALSE
TRY
  LET bad = 1 / 0
CATCH
  div_caught = TRUE
ENDTRY
Assert(div_caught, "div by zero caught")

' ══════════════════════════════════════════════════════════════════
' 13. MATH FUNCTIONS
' ══════════════════════════════════════════════════════════════════
Header("Math Functions")

Assert(ABS(-42) = 42, "abs neg")
Assert(ABS(42) = 42, "abs pos")
Assert(INT(3.7) = 3, "int")
Assert(INT(-3.7) = -3, "int neg")
Assert(FLOOR(3.7) = 3, "floor")
Assert(CEIL(3.2) = 4, "ceil")
Assert(ROUND(3.456, 2) = 3.46, "round 2")
Assert(ROUND(3.5) = 4, "round half")
Assert(CLAMP(15, 0, 10) = 10, "clamp high")
Assert(CLAMP(-5, 0, 10) = 0, "clamp low")
Assert(CLAMP(5, 0, 10) = 5, "clamp mid")
Assert(FAC(6) = 720, "fac 6")
Assert(FAC(0) = 1, "fac 0")
Assert(SQR(144) = 12, "sqr 144")
Assert(ABS(SIN(0)) < 0.001, "sin 0")
Assert(ABS(COS(0) - 1) < 0.001, "cos 0")

' ══════════════════════════════════════════════════════════════════
' 14a. CONVERSION FUNCTIONS — classic BASIC cast family, scalar + vector
' ══════════════════════════════════════════════════════════════════
Header("Conversion functions")

' ── CINT: 32-bit truncating cast ──
Assert(CINT(3.7) = 3, "cint pos trunc")
Assert(CINT(-3.7) = -3, "cint neg trunc")
Assert(CINT(42) = 42, "cint int pass")

' ── CLNG: 64-bit truncating cast ──
Assert(CLNG(99.9) = 99, "clng pos")
Assert(CLNG(-100.5) = -100, "clng neg")

' ── CSNG: float32 roundtrip ──
Assert(CSNG(1.5) = 1.5, "csng exact")
Assert(CSNG(0.0) = 0.0, "csng zero")

' ── CDBL: to float64 ──
Assert(CDBL(7) = 7.0, "cdbl int")
Assert(CDBL(3.14) = 3.14, "cdbl float")

' ── CBOOL: zero → 0, non-zero → 1 ──
Assert(CBOOL(0) = 0, "cbool zero")
Assert(CBOOL(1) = 1, "cbool one")
Assert(CBOOL(-5) = 1, "cbool neg")
Assert(CBOOL(0.0) = 0, "cbool zero float")
Assert(CBOOL(3.14) = 1, "cbool nonzero float")

' ── CSTR / TOSTR / STR: any value → string ──
Assert(CSTR(42) = "42", "cstr int")
Assert(CSTR(3.14) = "3.14", "cstr float")
Assert(TOSTR(42) = "42", "tostr int")
Assert(STR(42) = "42", "str int")

' ── TONUM / VAL: string → number ──
Assert(TONUM("1.5") = 1.5, "tonum float")
Assert(TONUM("42") = 42, "tonum int")
Assert(TONUM("abc") = 0, "tonum bad")
Assert(VAL("2.718") = 2.718, "val float")

' ── CDATE / CVDATE: string → DateTime ──
DIM dt_a = CDATE("2025-01-15")
DIM dt_b = CVDATE("2025-01-15")
Assert(dt_a = dt_b, "cdate equals cvdate")
Assert(YEAR(dt_a) = 2025, "cdate year")
Assert(MONTH(dt_a) = 1, "cdate month")
Assert(DAY(dt_a) = 15, "cdate day")

' ── Vectorized forms — all cast functions fan over arrays ──
Assert(CINT([1.5, 2.7, -3.9])[0] = 1, "cint arr [0]")
Assert(CINT([1.5, 2.7, -3.9])[2] = -3, "cint arr [2]")
Assert(CLNG([10.1, 20.9])[1] = 20, "clng arr")
Assert(CSNG([1.0, 2.0])[1] = 2.0, "csng arr")
Assert(CBOOL([0, 1, 2, 0, -5])[4] = 1, "cbool arr nonzero")
Assert(CBOOL([0, 1, 2, 0, -5])[3] = 0, "cbool arr zero")
Assert(CDBL([1, 2, 3])[1] = 2.0, "cdbl arr")
Assert(CSTR([1, 2, 3])[0] = "1", "cstr arr")
Assert(TOSTR([1, 2, 3])[2] = "3", "tostr arr")
Assert(TONUM(["1.5", "2.7", "3.9"])[1] = 2.7, "tonum arr strings")

' ══════════════════════════════════════════════════════════════════
' 14. STRING FUNCTIONS (ADVANCED)
' ══════════════════════════════════════════════════════════════════
Header("Advanced Strings")

' SPLIT / JOIN
LET parts = SPLIT("a,b,c,d", ",")
Assert(LEN(parts) = 4, "split len")
Assert(parts[0] = "a", "split first")
Assert(parts[3] = "d", "split last")
LET joined = JOIN(parts, "-")
Assert(joined = "a-b-c-d", "join")

' REPLACE
LET replaced = REPLACE$("Hello World", "World", "jdBasic")
Assert(replaced = "Hello jdBasic", "replace")

' REVERSE
Assert(REVERSE$("abcde") = "edcba", "reverse str")

' REGEX
LET matches = REGEX_MATCH("Tel: 123-456-7890", "[0-9]+")
Assert(LEN(matches) >= 1, "regex found")
Assert(matches[0] = "123", "regex first match")

' ══════════════════════════════════════════════════════════════════
' 15. REACTIVE VARIABLES
' ══════════════════════════════════════════════════════════════════
' Reactive bindings need VM-managed dependency tracking; the
' native compiler cannot synthesise that yet, so skip when running
' from a compiled .exe.
IF NOT OS.FEATURE("NATIVEC") THEN
    Header("Reactive Variables")

    DIM base_price = 100
    DIM tax_rate = 0.19
    DIM total_price = 0
    total_price -> base_price * (1 + tax_rate)
    Assert(ABS(total_price - 119) < 0.01, "react initial")

    base_price = 200
    Assert(ABS(total_price - 238) < 0.01, "react update")

    tax_rate = 0.07
    Assert(ABS(total_price - 214) < 0.01, "react cascade")
ENDIF

' ══════════════════════════════════════════════════════════════════
' 16. EVENT SYSTEM
' ══════════════════════════════════════════════════════════════════
Header("Event System")

DIM evt_log = ""
ON "TEST_EVENT" CALL OnTestEvent
SUB OnTestEvent(data)
  evt_log = evt_log + data[0] + ";"
ENDSUB
RAISEEVENT "TEST_EVENT", "A"
RAISEEVENT "TEST_EVENT", "B"
RAISEEVENT "TEST_EVENT", "C"
Assert(evt_log = "A;B;C;", "event sequence")

' ══════════════════════════════════════════════════════════════════
' 17. TENSOR OPERATIONS
' ══════════════════════════════════════════════════════════════════
Header("Tensors")

' Tensor creation via native function
LET t1 = IOTA(5)
Assert(TYPEOF(t1) = "ARRAY", "iota creates array")

' IOTA as vector
LET vec = IOTA(5, 0.0, 1.0)
Assert(LEN(vec) = 5, "iota float vec")
Assert(vec[0] = 0, "iota float start")
Assert(vec[4] = 4, "iota float end")

' Auto-vectorized math on arrays
LET angles = [0.0, 1.5708, 3.14159]
LET sines = SIN(angles)
Assert(ABS(sines[0]) < 0.01, "vec sin 0")
Assert(ABS(sines[1] - 1.0) < 0.01, "vec sin pi/2")

' ══════════════════════════════════════════════════════════════════
' 18. MISCELLANEOUS
' ══════════════════════════════════════════════════════════════════
Header("Miscellaneous")

' TYPEOF on various
Assert(TYPEOF(42) = "INT64", "typeof int lit")
Assert(TYPEOF(3.14) = "FLOAT64", "typeof float lit")
Assert(TYPEOF("s") = "STRING", "typeof str lit")
Assert(TYPEOF(TRUE) = "BOOLEAN", "typeof bool lit")
Assert(TYPEOF([]) = "ARRAY", "typeof empty arr")
Assert(TYPEOF({}) = "OBJECT", "typeof empty obj")

' Multiple assignment styles
LET ma = 1
DIM mb = 2
LET mc = 3
Assert(ma + mb + mc = 6, "multi assign styles")

' String as array index
DIM lookup = {"DE": "Germany", "US": "USA", "JP": "Japan"}
Assert(lookup{"DE"} = "Germany", "map string key")
Assert(lookup{"US"} = "USA", "map string key 2")

' Nested map
DIM config = {"db": {"host": "localhost", "port": 5432}, "debug": TRUE}
Assert(config{"db"}{"host"} = "localhost", "nested map get")
Assert(config{"db"}{"port"} = 5432, "nested map port")
Assert(config{"debug"} = TRUE, "nested map bool")

' ══════════════════════════════════════════════════════════════════
' Fused superinstructions (peephole regression)
' ══════════════════════════════════════════════════════════════════
' Regression for the LOAD_VAR_ADD_CONST / LOAD_VAR_SUB_CONST /
' LOAD_VAR_MUL_CONST / LOAD_VAR_CMP_*_CONST fused opcodes: their
' slow path used to fall through to numeric arithmetic() and turned
' string/array operands into 0.0 ("prompt$ + ""> """ -> 0.000000).
Header("Fused superinstructions")

' --- String concat: var$ + literal at top-level ---
LET fs1$ = "hello"
Assert(fs1$ + " world" = "hello world", "fused str+literal top")
Assert(fs1$ + "x" + "y" = "helloxy", "fused str+literal chain")

' --- String concat inside SUB (the original bug) ---
SUB FusedStrInSub()
    LET p$ = "ACCT"
    LET PASS_LOCAL = (p$ + "> " = "ACCT> ")
    Assert(PASS_LOCAL, "fused str+literal in SUB")
    Assert(p$ + "!" = "ACCT!", "fused str+literal in SUB direct")
ENDSUB
FusedStrInSub

' --- INT64 fast path still works ---
LET fi1 = 10
Assert(fi1 + 5 = 15, "fused int+literal add")
Assert(fi1 - 3 = 7, "fused int-literal sub")
Assert(fi1 * 4 = 40, "fused int*literal mul")

' --- FLOAT64 slow path ---
LET ff1 = 1.5
Assert(ff1 + 0.5 = 2.0, "fused float+literal add")
Assert(ff1 * 2.0 = 3.0, "fused float*literal mul")

' --- Array broadcast through the fused slow path ---
LET fa1 = [1, 2, 3]
LET fa1_plus = fa1 + 10
Assert(fa1_plus[0] = 11, "fused array+literal [0]")
Assert(fa1_plus[1] = 12, "fused array+literal [1]")
Assert(fa1_plus[2] = 13, "fused array+literal [2]")
LET fa1_mul = fa1 * 2
Assert(fa1_mul[0] = 2, "fused array*literal [0]")
Assert(fa1_mul[2] = 6, "fused array*literal [2]")

' --- Array of strings + literal string ---
LET fas = ["a", "b", "c"]
LET fas_plus = fas + "X"
Assert(fas_plus[0] = "aX", "fused str-array+literal [0]")
Assert(fas_plus[2] = "cX", "fused str-array+literal [2]")

' --- Comparison fusion with strings ---
LET fc$ = "banana"
Assert((fc$ = "banana") = TRUE,  "fused str cmp eq true")
Assert((fc$ = "apple")  = FALSE, "fused str cmp eq false")
Assert((fc$ <> "apple") = TRUE,  "fused str cmp ne")

' --- Comparison fusion with floats ---
LET fcf = 3.14
Assert((fcf < 4.0)  = TRUE,  "fused float cmp lt")
Assert((fcf > 4.0)  = FALSE, "fused float cmp gt")
Assert((fcf <= 3.14) = TRUE, "fused float cmp le")

' --- Comparison fusion with array vs scalar (regression for `IF y = 0`
'     inside a SUB returning the wrong type — the fused CMP slow path
'     used to call compare() directly which doesn't know arrays).
DIM fca_in_sub_ok = FALSE
SUB FusedArrCmpInSub()
    LET yarr = [1, 2, 4]
    LET cmp = (yarr = 0)
    fca_in_sub_ok = (TYPEOF(cmp) = "ARRAY" AND LEN(cmp) = 3 AND cmp[0] = FALSE)
ENDSUB
FusedArrCmpInSub
Assert(fca_in_sub_ok, "fused arr=scalar cmp in SUB returns array")

' --- to_bool() on an array follows ALL semantics ---
Assert(([1,2,3] = 0) = [FALSE,FALSE,FALSE],   "arr cmp produces vector of bools")
DIM if_arr_ok = "?"
IF [FALSE, FALSE, FALSE] THEN
    if_arr_ok = "then"
ELSE
    if_arr_ok = "else"
ENDIF
Assert(if_arr_ok = "else", "IF [F,F,F] takes ELSE (ALL semantics)")
DIM if_arr_ok2 = "?"
IF [TRUE, TRUE, TRUE] THEN
    if_arr_ok2 = "then"
ELSE
    if_arr_ok2 = "else"
ENDIF
Assert(if_arr_ok2 = "then", "IF [T,T,T] takes THEN")

' ══════════════════════════════════════════════════════════════════
' IMPORT inside EXECUTE / EVAL / REPL paths
' ══════════════════════════════════════════════════════════════════
' Regression: setup_parser_modules() was only called for direct file
' execution. REPL RUN, EXECUTE, EVAL, COMPILE and friends had no
' file_reader hooked up, so IMPORT crashed with "IMPORT not available
' (no file reader)". The live sequencer (SQ.jdb) drives everything via
' EXECUTE inside the REPL — without this fix, no module loading at all.
' EXECUTE / EVAL run BASIC source at runtime, which would require
' the full parser+interpreter inside jdbrt.dll — out of scope for
' the native compiler. Skip when running compiled.
IF NOT OS.FEATURE("NATIVEC") THEN
    Header("IMPORT in EXECUTE/EVAL")

    ' EXECUTE: should be able to IMPORT a module and use its functions
    DIM IMP_OK = FALSE
    DIM IMP_VAL = 0
    EXECUTE "IMPORT test_imp_mod" + CHR$(10) + "IMP_VAL = test_imp_mod.ADD(40, 2)" + CHR$(10) + "IMP_OK = TRUE"
    Assert(IMP_OK, "EXECUTE block ran")
    Assert(IMP_VAL = 42, "EXECUTE could IMPORT and call module func")

    ' EVAL: should also be able to use an already-imported module function
    DIM EV_VAL AS DOUBLE = 0.0
    EXECUTE "IMPORT test_imp_mod"
    EV_VAL = EVAL("test_imp_mod.TWICE(21)")
    Assert(EV_VAL = 42, "EVAL after IMPORT in EXECUTE")
ENDIF

' ══════════════════════════════════════════════════════════════════
' DATE subtype + vectorized DATEDIFF
' ══════════════════════════════════════════════════════════════════
Header("Date values & vectorized diff")

DIM dt_a = CVDATE("2025-07-25")
Assert(TYPEOF(dt_a) = "DATE", "CVDATE returns DATE-tagged value")
Assert(LEFT$(dt_a, 10) = "2025-07-25", "DATE prints as ISO YYYY-MM-DD")

DIM dt_b = DATEADD("D", 7, dt_a)
Assert(TYPEOF(dt_b) = "DATE", "DATEADD preserves DATE tag")
Assert(LEFT$(dt_b, 10) = "2025-08-01", "DATEADD +7 days arithmetic")

' Vectorized DATEDIFF: scalar start, array of deadlines.
DIM dt_deadlines = [CVDATE("2025-08-01"), CVDATE("2025-08-15"), CVDATE("2025-09-05")]
DIM dt_days = DATEDIFF("D", dt_a, dt_deadlines)
Assert(LEN(dt_days) = 3, "DATEDIFF auto-vectorized over date2")
Assert(dt_days[0] = 7,  "DATEDIFF vec [0]")
Assert(dt_days[1] = 21, "DATEDIFF vec [1]")
Assert(dt_days[2] = 42, "DATEDIFF vec [2]")

' ══════════════════════════════════════════════════════════════════
' Number literals + binary I/O
' ══════════════════════════════════════════════════════════════════
Header("Numeric literals & binary I/O")

' Hex literal $XXXX
Assert($FF       = 255,        "hex $FF")
Assert($CAFEBABE = 3405691582, "hex $CAFEBABE")

' Binary literal %0101
Assert(%0      = 0,  "bin %0")
Assert(%1      = 1,  "bin %1")
Assert(%0101   = 5,  "bin %0101")
Assert(%1010   = 10, "bin %1010")
Assert(%11111111 = 255, "bin %11111111")

' DIM AS INTEGER must NOT mangle the value via wrong CAST.
' Regression for the VarType vs ValueType enum-shift bug that turned
' `DIM A AS INTEGER = $CAFEBABE` into `inf` (cast went to FLOAT16).
DIM hex_a AS INTEGER = $CAFEBABE
Assert(hex_a = 3405691582, "DIM AS INTEGER preserves hex value")
DIM hex_b AS LONG = $CAFEBABE
Assert(hex_b = 3405691582, "DIM AS LONG (alias) preserves hex value")

' PACK$ / UNPACK round-trip with classic-BASIC docs format `>Isbsd`.
' Regression: format chars used to be lower-case only, so `I` was
' silently skipped, dropping the first 4 bytes and putting the array
' indices off-by-one in UNPACK.
DIM packed$ AS STRING
packed$ = PACK$(">Isbsd", $CAFEBABE, 2, 255, 15000, 123.456)
Assert(LEN(packed$) = 17, "PACK$ uppercase format chars: 17 bytes")

DIM unpacked AS ARRAY = []
unpacked = UNPACK(">Isbsd", packed$)
Assert(LEN(unpacked) = 5,           "UNPACK returns all 5 fields")
Assert(unpacked[0] = 3405691582,    "UNPACK round-trip uint32 (CAFEBABE)")
Assert(unpacked[1] = 2,             "UNPACK round-trip short")
Assert(unpacked[2] = 255,           "UNPACK round-trip byte")
Assert(unpacked[3] = 15000,         "UNPACK round-trip short 2")
Assert(unpacked[4] > 123.4 AND unpacked[4] < 123.5, "UNPACK round-trip double")

' ══════════════════════════════════════════════════════════════════
' VM-managed globals visible inside SUB/FUNC scope
' ══════════════════════════════════════════════════════════════════
' Regression: ERRMSG$/ERR/ERL are set by the VM in the CATCH handler.
' Without seeding them in the compiler's known_globals set, they were
' resolved as uninitialised LOCALS inside a SUB and printed as NONE.
Header("VM-managed globals in SUB")

DIM CAPTURED_MSG$ = ""
DIM CAPTURED_ERR  = 0

SUB ProvokeError()
    TRY
        LET x = 1 / 0
    CATCH
        CAPTURED_MSG$ = ERRMSG$
        CAPTURED_ERR  = ERR
    ENDTRY
ENDSUB

ProvokeError
Assert(LEN(CAPTURED_MSG$) > 0, "ERRMSG$ visible in SUB CATCH")
Assert(INSTR(CAPTURED_MSG$, "zero") > 0, "ERRMSG$ contains real text")
Assert(CAPTURED_ERR = 1, "ERR visible in SUB CATCH")

' ══════════════════════════════════════════════════════════════════
' TYPE method calls — all syntax variations
' ══════════════════════════════════════════════════════════════════
Header("TYPE method calls")

TYPE T_TestObj
    val
    name$

    SUB SET_VAL(v)
        THIS.val = v
    ENDSUB

    FUNC GET_VAL()
        RETURN THIS.val
    ENDFUNC

    SUB SET_NAME(n$)
        THIS.name$ = n$
    ENDSUB

    FUNC GET_NAME$()
        RETURN THIS.name$
    ENDFUNC

    SUB SET_BOTH(v, n$)
        THIS.val = v
        THIS.name$ = n$
    ENDSUB
ENDTYPE

' Basic TYPE creation + method calls with parens
DIM mc_obj AS T_TestObj
mc_obj.SET_VAL(42)
Assert(mc_obj.GET_VAL() = 42, "TYPE method call with parens")

' Method call without parens (BASIC standard)
mc_obj.SET_VAL 99
Assert(mc_obj.GET_VAL() = 99, "TYPE method call no parens")

' String method call without parens
mc_obj.SET_NAME "hello"
Assert(mc_obj.GET_NAME$() = "hello", "TYPE string method no parens")

' Multi-arg method call without parens
mc_obj.SET_BOTH 77, "world"
Assert(mc_obj.val = 77, "TYPE multi-arg no parens (val)")
Assert(mc_obj.name$ = "world", "TYPE multi-arg no parens (name$)")

' Direct field access
mc_obj.val = 123
Assert(mc_obj.val = 123, "TYPE direct field write")

' TYPE in array — reference semantics
DIM mc_arr[3]
DIM mc_a AS T_TestObj : mc_a.SET_VAL(10)
DIM mc_b AS T_TestObj : mc_b.SET_VAL(20)
mc_arr[0] = mc_a : mc_arr[1] = mc_b

' Read from array
Assert(mc_arr[0].val = 10, "TYPE in array: read field")
Assert(mc_arr[1].val = 20, "TYPE in array: read field 2")

' Modify via copy (reference semantics)
LET mc_c = mc_arr[0]
mc_c.SET_VAL 55
Assert(mc_arr[0].val = 55, "TYPE in array: ref semantics")

' TYPE in dynamic array (PUSH)
LET mc_list = []
DIM mc_d AS T_TestObj : mc_d.SET_BOTH 1, "first"
DIM mc_e AS T_TestObj : mc_e.SET_BOTH 2, "second"
PUSH mc_list, mc_d
PUSH mc_list, mc_e
Assert(LEN(mc_list) = 2, "TYPE PUSH to array")
LET mc_f = mc_list[0]
Assert(mc_f.val = 1, "TYPE from pushed array: val")
Assert(mc_f.name$ = "first", "TYPE from pushed array: name$")

' Method call on array element via copy
LET mc_g = mc_list[1]
mc_g.SET_VAL 999
Assert(mc_list[1].val = 999, "TYPE method on array elem via ref")

' TYPE method call inside SUB
SUB TestTypeInSub()
    DIM local_obj AS T_TestObj
    local_obj.SET_BOTH 42, "sub_test"
    Assert(local_obj.val = 42, "TYPE in SUB: val")
    Assert(local_obj.name$ = "sub_test", "TYPE in SUB: name$")
    local_obj.SET_VAL 88
    Assert(local_obj.GET_VAL() = 88, "TYPE in SUB: method chain")
ENDSUB
TestTypeInSub

' TYPE method call inside FUNC
FUNC TestTypeInFunc()
    DIM local_obj AS T_TestObj
    local_obj.SET_VAL 77
    RETURN local_obj.GET_VAL()
ENDFUNC
Assert(TestTypeInFunc() = 77, "TYPE in FUNC: return via method")

' No-args method call without parens (just method name on line)
' This should work as a no-args call or a no-op member access
DIM mc_noarg AS T_TestObj
mc_noarg.val = 0

' ══════════════════════════════════════════════════════════════════
' EXPORT/IMPORT module system — nested modules, TYPEs, private vars
' ══════════════════════════════════════════════════════════════════
Header("Module EXPORT/IMPORT")

IMPORT TEST_OUTER

' --- Direct inner module access ---
Assert(TEST_INNER.public_val = 99, "IMPORT inner: EXPORT DIM visible")
Assert(TEST_INNER.GET_PRIVATE() = 42, "IMPORT inner: private via FUNC")

' --- Inner TYPE creation from main ---
TEST_INNER.ADD_THING 10, "alpha"
TEST_INNER.ADD_THING 20, "beta"
Assert(TEST_INNER.GET_THING_COUNT() = 2, "Inner module: thing_count after ADD")
Assert(TEST_INNER.GET_THING_X(0) = 10, "Inner module: thing[0].x")
Assert(TEST_INNER.GET_THING_LABEL$(1) = "beta", "Inner module: thing[1].label$")

' --- Private var mutation via module SUB ---
TEST_INNER.SET_PRIVATE 123
Assert(TEST_INNER.GET_PRIVATE() = 123, "Inner module: SET/GET private")

' --- Outer module uses inner module ---
TEST_OUTER.INIT_OUTER
Assert(TEST_OUTER.READ_INNER_PRIVATE() = 55, "Nested: outer reads inner private")
Assert(TEST_OUTER.READ_OUTER_SECRET() = 333, "Nested: outer private var")
Assert(TEST_OUTER.READ_INNER_THING_COUNT() = 3, "Nested: outer reads inner count")

' --- Add via outer (passes through to inner) ---
TEST_OUTER.ADD_VIA_OUTER 500, "via_outer"
Assert(TEST_INNER.GET_THING_COUNT() = 4, "Nested: add via outer → inner count")
Assert(TEST_INNER.GET_THING_X(3) = 500, "Nested: thing added via outer")
Assert(TEST_INNER.GET_THING_LABEL$(3) = "via_outer", "Nested: label via outer")

' --- EXPORT DIM on outer module ---
Assert(TEST_OUTER.outer_public = 888, "Outer: EXPORT DIM visible")

' --- Inner EXPORT DIM after mutation ---
TEST_INNER.public_val = 42
Assert(TEST_INNER.public_val = 42, "Inner: EXPORT DIM write + read")

' ══════════════════════════════════════════════════════════════════
' CONST AND PROTECTED CONSTANTS
' ══════════════════════════════════════════════════════════════════
Header("Constants (CONST, PI, E)")

' --- Built-in PI constant ---
Assert(PI > 3.14 AND PI < 3.15, "PI value is ~3.14159")
Assert(PI = PI(), "PI constant equals PI() function")
Assert(TYPEOF(PI) = "FLOAT64", "PI is FLOAT64")

' --- Built-in E constant ---
Assert(E > 2.71 AND E < 2.72, "E value is ~2.71828")
Assert(E = E(), "E constant equals E() function")
Assert(TYPEOF(E) = "FLOAT64", "E is FLOAT64")

' --- PI cannot be overwritten ---
DIM pi_before = PI
TRY
    PI = 42
    Assert(FALSE, "PI assignment should throw error")
CATCH
    Assert(TRUE, "PI assignment throws error")
ENDTRY
Assert(PI = pi_before, "PI unchanged after failed assignment")

' --- E cannot be overwritten ---
DIM e_before = E
TRY
    E = 99
    Assert(FALSE, "E assignment should throw error")
CATCH
    Assert(TRUE, "E assignment throws error")
ENDTRY
Assert(E = e_before, "E unchanged after failed assignment")

' --- PI/E in math expressions ---
DIM circumference = 2 * PI * 10
Assert(circumference > 62.8 AND circumference < 62.9, "2*PI*10 = ~62.83")
DIM exp1 = E ^ 2
Assert(exp1 > 7.38 AND exp1 < 7.39, "E^2 = ~7.389")

' --- Case insensitive protection ---
TRY
    pi = 0
    Assert(FALSE, "lowercase pi assignment should throw")
CATCH
    Assert(TRUE, "lowercase pi assignment throws error")
ENDTRY
TRY
    e = 0
    Assert(FALSE, "lowercase e assignment should throw")
CATCH
    Assert(TRUE, "lowercase e assignment throws error")
ENDTRY

' --- User CONST: basic types ---
CONST MAX_LEVEL = 50
Assert(MAX_LEVEL = 50, "CONST MAX_LEVEL = 50")
CONST GAME_TITLE = "TestGame"
Assert(GAME_TITLE = "TestGame", "CONST string value")
CONST GRAVITY = 9.81
Assert(GRAVITY > 9.80 AND GRAVITY < 9.82, "CONST float value")
CONST IS_DEBUG = TRUE
Assert(IS_DEBUG = TRUE, "CONST boolean value")

' --- CONST cannot be overwritten ---
TRY
    MAX_LEVEL = 999
    Assert(FALSE, "CONST reassign should throw")
CATCH
    Assert(TRUE, "CONST reassign throws error")
ENDTRY
Assert(MAX_LEVEL = 50, "CONST unchanged after failed reassign")

' --- CONST with expressions ---
CONST DOUBLE_PI = PI * 2
Assert(DOUBLE_PI > 6.28 AND DOUBLE_PI < 6.29, "CONST with PI expression")
CONST SCREEN_AREA = 1280 * 720
Assert(SCREEN_AREA = 921600, "CONST with arithmetic expression")

' --- Multiple CONSTs don't interfere ---
CONST A_CONST = 10
CONST B_CONST = 20
CONST C_CONST = A_CONST + B_CONST
Assert(C_CONST = 30, "CONST referencing other CONSTs")
Assert(A_CONST = 10, "First CONST still intact")
Assert(B_CONST = 20, "Second CONST still intact")

' --- CONST in loops (loop var doesn't overwrite) ---
CONST LOOP_LIMIT = 5
DIM loop_sum = 0
FOR idx = 1 TO LOOP_LIMIT
    loop_sum = loop_sum + idx
NEXT idx
Assert(loop_sum = 15, "CONST used as loop limit: 1+2+3+4+5=15")
Assert(LOOP_LIMIT = 5, "CONST unchanged after being used in FOR")

' --- CONST type preservation ---
Assert(TYPEOF(MAX_LEVEL) = "INT64", "CONST integer is INT64")
Assert(TYPEOF(GAME_TITLE) = "STRING", "CONST string is STRING")
Assert(TYPEOF(GRAVITY) = "FLOAT64", "CONST float is FLOAT64")
Assert(TYPEOF(IS_DEBUG) = "BOOLEAN", "CONST boolean is BOOLEAN")

' ══════════════════════════════════════════════════════════════════
' 27. LOCALE / NUMBER FORMATTING
' ══════════════════════════════════════════════════════════════════
Header "Locale / Number Formatting"

' --- Default locale (C): no thousand separators, dot as decimal ---
DIM loc_int$ = "" + 1234567
Assert(loc_int$ = "1234567", "C locale: integer has no thousand separators")
DIM loc_flt$ = "" + 1.5
Assert(loc_flt$ = "1.5", "C locale: float uses dot as decimal point")

' --- German locale: dot as thousand separator, comma as decimal ---
SETLOCALE "de_DE"
DIM de_int$ = "" + 1234567
Assert(INSTR(de_int$, ".") >= 0, "de_DE locale: integer has dot thousand separators")
Assert(de_int$ = "1.234.567", "de_DE locale: 1234567 -> 1.234.567")

DIM de_flt$ = "" + 1.5
Assert(de_flt$ = "1,5", "de_DE locale: float uses comma as decimal point")

' --- FAC with locale formatting ---
DIM de_fac$ = "" + FAC(10)
Assert(de_fac$ = "3.628.800", "de_DE locale: FAC(10) -> 3.628.800")

' --- Trailing zero removal ---
DIM de_whole$ = "" + 42.0
Assert(de_whole$ = "42", "de_DE locale: 42.0 -> 42 (no trailing zeros)")

' --- FORMAT$ still works with locale ---
DIM fmt_res$ = FORMAT$("{:.2f}", 1234.5)
Assert(LEN(fmt_res$) > 0, "FORMAT$ works under de_DE locale")

' --- Restore C locale for any subsequent tests ---
SETLOCALE "C"
DIM restored$ = "" + 1234567
Assert(restored$ = "1234567", "Restored C locale: no thousand separators")

' ══════════════════════════════════════════════════════════════════
' FUNC returns map / UDT array access inside FUNC
' (native codegen: Phase-3b return-type inference + top-level UDT
'  propagation pre-pass so FUNC bodies see arr[] type)
' ══════════════════════════════════════════════════════════════════
Header("FUNC returns map/array + UDT in FUNC")

TYPE T_X_COMP
    n$
    v
    SUB INIT(a$, b)
        THIS.n$ = a$
        THIS.v = b
    ENDSUB
ENDTYPE

DIM xlist = []
DIM tx AS T_X_COMP
tx.INIT "alpha", 7
PUSH xlist, tx
DIM tx2 AS T_X_COMP
tx2.INIT "beta", 42
PUSH xlist, tx2

FUNC LOOKUP_REC(id$)
    FOR i = 0 TO LEN(xlist) - 1
        LET tmp = xlist[i]
        IF tmp.n$ = id$ THEN
            LET m = {}
            m{"name"} = tmp.n$
            m{"val"} = tmp.v
            RETURN m
        ENDIF
    NEXT i
    RETURN {}
ENDFUNC

FUNC LIST_ALL()
    LET out = []
    FOR i = 0 TO LEN(xlist) - 1
        LET tmp = xlist[i]
        LET r = {}
        r{"name"} = tmp.n$
        r{"val"} = tmp.v
        PUSH out, r
    NEXT i
    RETURN out
ENDFUNC

LET r1 = LOOKUP_REC("alpha")
Assert(r1{"name"} = "alpha", "FUNC returning map — string field")
Assert(r1{"val"} = 7, "FUNC returning map — numeric field")
Assert(TYPEOF(r1) = "OBJECT", "FUNC map return typed as OBJECT")

LET r2 = LOOKUP_REC("beta")
Assert(r2{"name"} = "beta", "FUNC returning map — second lookup")
Assert(r2{"val"} = 42, "FUNC returning map — second numeric")

LET all_rows = LIST_ALL()
Assert(LEN(all_rows) = 2, "FUNC returning array of maps — length")
Assert(TYPEOF(all_rows) = "ARRAY", "FUNC array return typed as ARRAY")
LET itm0 = all_rows[0]
Assert(itm0{"name"} = "alpha", "FUNC returning array of maps — [0].name")
Assert(itm0{"val"} = 7, "FUNC returning array of maps — [0].val")
LET itm1 = all_rows[1]
Assert(itm1{"name"} = "beta", "FUNC returning array of maps — [1].name")

' UDT field access on array element inside FUNC (needs UDT type propagation
' pre-pass so FUNC body's `t = list[i]` resolves t.n$ and t.v).
FUNC SUM_VALS()
    LET total = 0
    FOR i = 0 TO LEN(xlist) - 1
        LET t = xlist[i]
        total = total + t.v
    NEXT i
    RETURN total
ENDFUNC

Assert(SUM_VALS() = 49, "UDT field sum inside FUNC (7 + 42)")

' ══════════════════════════════════════════════════════════════════
' MODULE WRITE-BACKS
' (cross-module mutation: caller reads back module state after a SUB
'  mutates its own array/map members — matches the RPG inventory +
'  party recruit flow that was silently dropping writes in native)
' ══════════════════════════════════════════════════════════════════
Header("Module write-backs")

IMPORT TEST_MOD_WRITEBACK_MOD

' Scalar array PUSH from outside SUB
TEST_MOD_WRITEBACK_MOD.arr = []
TEST_MOD_WRITEBACK_MOD.PUSH_SCALAR 10
TEST_MOD_WRITEBACK_MOD.PUSH_SCALAR 20
Assert(TEST_MOD_WRITEBACK_MOD.arr[0] = 10, "module PUSH scalar[0]")
Assert(TEST_MOD_WRITEBACK_MOD.arr[1] = 20, "module PUSH scalar[1]")

' Indexed scalar write from inside module SUB
TEST_MOD_WRITEBACK_MOD.SET_SCALAR 0, 99
Assert(TEST_MOD_WRITEBACK_MOD.arr[0] = 99, "module SUB writes arr[i]")

' Map-in-array write-back via copy/mutate/store pattern
TEST_MOD_WRITEBACK_MOD.RESET_MAPS
Assert(TEST_MOD_WRITEBACK_MOD.map_count = 2, "RESET_MAPS builds 2 maps")

LET m_init = TEST_MOD_WRITEBACK_MOD.maps[0]
Assert(m_init{"v"} = 1, "module read maps[0].v")

TEST_MOD_WRITEBACK_MOD.MUTATE_MAP 1, 99
LET m_after0 = TEST_MOD_WRITEBACK_MOD.maps[0]
LET m_after1 = TEST_MOD_WRITEBACK_MOD.maps[1]
Assert(m_after0{"v"} = 1, "MUTATE_MAP leaves maps[0] alone")
Assert(m_after1{"v"} = 99, "MUTATE_MAP writes maps[1] (copy/mutate/store)")

' Direct indexed map-write syntax: maps[idx]{"v"} = newv
TEST_MOD_WRITEBACK_MOD.RESET_MAPS
TEST_MOD_WRITEBACK_MOD.MUTATE_MAP_DIRECT 1, 88
LET m_dir = TEST_MOD_WRITEBACK_MOD.maps[1]
Assert(m_dir{"v"} = 88, "MUTATE_MAP_DIRECT maps[idx]{v}=newv")

' ══════════════════════════════════════════════════════════════════
' GROUP A — String padding, number theory, bit rotation,
'           env vars, temp files, RMDIR
' ══════════════════════════════════════════════════════════════════
Header("Group A: String pad / REPEAT$")

Assert(LPAD$("x", 5) = "    x", "LPAD$ default space pad")
Assert(LPAD$("x", 5, "-") = "----x", "LPAD$ single-char pad")
Assert(LPAD$("x", 5, "-=") = "-=-=x", "LPAD$ multi-char pad cycles")
Assert(RPAD$("x", 5) = "x    ", "RPAD$ default space pad")
Assert(RPAD$("x", 5, ".") = "x....", "RPAD$ dot fill")
Assert(LPAD$("hello", 3) = "hello", "LPAD$ does not truncate")
Assert(RPAD$("", 3, "-") = "---", "RPAD$ empty base filled")

Assert(REPEAT$("ab", 3) = "ababab", "REPEAT$ basic")
Assert(REPEAT$("x", 0) = "", "REPEAT$ n=0")
Assert(REPEAT$("x", -2) = "", "REPEAT$ negative")
Assert(REPEAT$("", 5) = "", "REPEAT$ empty base")

Header("Group A: GCD/LCM/ROTL/ROTR")

Assert(GCD(12, 18) = 6, "GCD(12,18)")
Assert(GCD(100, 75, 25) = 25, "GCD variadic")
Assert(GCD(0, 7) = 7, "GCD(0,n) = |n|")
Assert(LCM(4, 6) = 12, "LCM(4,6)")
Assert(LCM(2, 3, 5) = 30, "LCM variadic")

Assert(ROTL(1, 1) = 2, "ROTL(1,1) = 2")
Assert(ROTL(1, 4, 8) = 16, "ROTL(1,4,bits=8) = 16")
Assert(ROTR(16, 4, 8) = 1, "ROTR(16,4,bits=8) = 1")
Assert(ROTR(2, 1, 16) = 1, "ROTR(2,1,bits=16) = 1")

Header("Group A: SETENV/GETENV$/MKTEMP$/RMDIR")

SETENV "JDB_COMP_A", "hello"
Assert(GETENV$("JDB_COMP_A") = "hello", "SETENV+GETENV$ round-trip")
SETENV "JDB_COMP_A", ""
Assert(GETENV$("JDB_COMP_A") = "", "SETENV empty removes var")

DIM tmp_a = MKTEMP$("jdbc")
Assert(LEN(tmp_a) > 0, "MKTEMP$ returns non-empty path")
Assert(FILE.EXISTS(tmp_a) = 0, "MKTEMP$ path does not pre-exist")
TXTWRITER tmp_a, "payload"
Assert(FILE.EXISTS(tmp_a) = 1, "temp path usable for writing")
Assert(TXTREADER$(tmp_a) = "payload", "temp file round-trips")
KILL tmp_a
Assert(FILE.EXISTS(tmp_a) = 0, "KILL removes temp file")

MKDIR "jdb_comp_rmdir"
Assert(FILE.EXISTS("jdb_comp_rmdir") = 1, "MKDIR created scratch dir")
RMDIR "jdb_comp_rmdir"
Assert(FILE.EXISTS("jdb_comp_rmdir") = 0, "RMDIR removes empty dir")

' ══════════════════════════════════════════════════════════════════
' GROUP B — FILE.*, PATH.*, TXTWRITER append, DIR$ detailed
' ══════════════════════════════════════════════════════════════════
Header("Group B: FILE.EXISTS/SIZE/ISDIR/STAT")

DIM f_b = MKTEMP$("jdbB")
TXTWRITER f_b, "12345"

Assert(FILE.EXISTS(f_b) = 1, "FILE.EXISTS on written file")
Assert(FILE.EXISTS("no_such_file_xyz") = 0, "FILE.EXISTS missing")
Assert(FILE.SIZE(f_b) = 5, "FILE.SIZE reports byte count")
Assert(FILE.SIZE("no_such_file_xyz") = -1, "FILE.SIZE missing returns -1")
Assert(FILE.ISDIR(f_b) = 0, "FILE.ISDIR on file is 0")
Assert(FILE.ISDIR(".") = 1, "FILE.ISDIR on current dir is 1")

DIM st = FILE.STAT(f_b)
Assert(st{"exists"} = TRUE, "FILE.STAT exists=TRUE")
Assert(st{"size"} = 5, "FILE.STAT size=5")
Assert(st{"is_dir"} = FALSE, "FILE.STAT is_dir=FALSE")
Assert(LEN(st{"mtime"}) >= 19, "FILE.STAT mtime is formatted date")

KILL f_b

Header("Group B: PATH.NORMALIZE$/PATH.DIRNAME$")

' PATH.NORMALIZE$ converts separators and resolves . / ..
DIM p1 = PATH.NORMALIZE$("a/b/../c")
Assert("c" IN p1, "PATH.NORMALIZE$ keeps resolved tail")
Assert(NOT (".." IN p1), "PATH.NORMALIZE$ resolves ..")

Assert(PATH.DIRNAME$("a/b/c.txt") = "a/b", "PATH.DIRNAME$ with subdir")
Assert(PATH.DIRNAME$("only_file.txt") = "", "PATH.DIRNAME$ of bare file is empty")

Header("Group B: TXTWRITER append / DIR$ detailed")

DIM f_b2 = MKTEMP$("jdbAp")
TXTWRITER f_b2, "line-1"
TXTWRITER f_b2, CHR$(10) + "line-2", TRUE
DIM content = TXTREADER$(f_b2)
Assert("line-1" IN content, "append kept original content")
Assert("line-2" IN content, "append added new content")
KILL f_b2

' DIR$(path, TRUE) returns Nx5 matrix: name, size, type, date, attrs
MKDIR "jdb_dir_probe"
DIM f_probe = "jdb_dir_probe/probe.txt"
TXTWRITER f_probe, "abc"
DIM listing = DIR$("jdb_dir_probe/*", TRUE)
Assert(LEN(listing) >= 1, "DIR$ detailed returns >= 1 entry")
' Native's 2D mixed-matrix access can't decode string columns back to str,
' so the probe.txt name/type lookup is interp-only.
IF OS.FEATURE("INTERPRETER") THEN
    DIM found_probe = FALSE
    FOR dir_i = 0 TO LEN(listing) - 1
        IF "probe.txt" IN listing[dir_i, 0] THEN
            found_probe = TRUE
            Assert(listing[dir_i, 1] = 3, "DIR$ detailed size col matches")
            Assert(listing[dir_i, 2] = "FILE", "DIR$ detailed type col FILE")
        ENDIF
    NEXT dir_i
    Assert(found_probe, "DIR$ detailed lists probe.txt")
ENDIF
KILL f_probe
RMDIR "jdb_dir_probe"

' ══════════════════════════════════════════════════════════════════
' GROUP C — Timezone-aware dates, DATE.UTC, DATE.PARTS
' ══════════════════════════════════════════════════════════════════
Header("Group C: Timezone-aware CVDATE/FORMAT_DATE")

' CVDATE with tz: wall-clock 14:00 @ UTC+2 == 12:00 UTC.
DIM d_at2 = CVDATE("2024-01-15 14:00:00", 2)
DIM d_ut0 = CVDATE("2024-01-15 12:00:00", 0)
' Same instant → DATEDIFF is 0 seconds.
Assert(DATEDIFF("S", d_at2, d_ut0) = 0, "CVDATE(tz=2) matches CVDATE(tz=0) shifted")

' FORMAT_DATE(date, fmt, tz) renders in requested zone.
DIM d_utc_fmt = FORMAT_DATE(d_at2, "%H:%M", 0)
Assert(d_utc_fmt = "12:00", "FORMAT_DATE tz=0 shows UTC wall-clock")
DIM d_p3_fmt = FORMAT_DATE(d_at2, "%H:%M", 3)
Assert(d_p3_fmt = "15:00", "FORMAT_DATE tz=3 shows UTC+3 wall-clock")

' DATEADD tz-arg accepted (no effect on arithmetic — symmetry).
DIM d_plus = DATEADD("D", 1, d_at2, 2)
Assert(DATEDIFF("D", d_at2, d_plus) = 1, "DATEADD with tz returns +1 day")

Header("Group C: DATE.UTC / DATE.PARTS")

' DATE.UTC builds an instant from UTC components.
DIM d_nye = DATE.UTC(2025, 1, 1, 0, 0, 0)
Assert(FORMAT_DATE(d_nye, "%Y-%m-%d %H:%M", 0) = "2025-01-01 00:00", _
       "DATE.UTC 3-arg returns UTC midnight")

DIM d_noon = DATE.UTC(2025, 6, 15, 12, 30, 45)
Assert(FORMAT_DATE(d_noon, "%Y-%m-%d %H:%M:%S", 0) = "2025-06-15 12:30:45", _
       "DATE.UTC 6-arg full components")

' DATE.PARTS(date, tz) returns a map of components.
DIM dp = DATE.PARTS(d_noon, 0)
Assert(dp{"year"}   = 2025, "DATE.PARTS year")
Assert(dp{"month"}  = 6,    "DATE.PARTS month")
Assert(dp{"day"}    = 15,   "DATE.PARTS day")
Assert(dp{"hour"}   = 12,   "DATE.PARTS hour")
Assert(dp{"minute"} = 30,   "DATE.PARTS minute")
Assert(dp{"second"} = 45,   "DATE.PARTS second")
' weekday 0=Sun .. 6=Sat → 2025-06-15 is a Sunday.
Assert(dp{"weekday"} = 0,   "DATE.PARTS weekday (Sunday)")

' ══════════════════════════════════════════════════════════════════
' GROUP D — HTTP client-state APIs (no network round-trip)
'   Full round-trip coverage lives in tests/test_http_gd.jdb.
' ══════════════════════════════════════════════════════════════════
IF OS.FEATURE("HTTP") THEN
    Header("Group D: HTTP cookies / params / timeout")

    HTTP.SETCOOKIE "s_id", "abc123"
    HTTP.SETCOOKIE "user", "atomi"
    Assert(HTTP.GETCOOKIE$("s_id") = "abc123", "SETCOOKIE+GETCOOKIE$ s_id")
    Assert(HTTP.GETCOOKIE$("user") = "atomi",  "SETCOOKIE+GETCOOKIE$ user")
    Assert(HTTP.GETCOOKIE$("missing") = "",    "GETCOOKIE$ unknown key -> empty")
    HTTP.CLEARCOOKIES
    Assert(HTTP.GETCOOKIE$("s_id") = "", "CLEARCOOKIES drops all cookies")

    ' SETPARAM / CLEARPARAMS are state-only here; just verify they don't throw.
    HTTP.SETPARAM "q", "hello world"
    HTTP.SETPARAM "page", "2"
    HTTP.CLEARPARAMS
    Assert(TRUE, "SETPARAM/CLEARPARAMS accept values, do not throw")

    ' Timeout & redirect config.
    HTTP.SETTIMEOUT 5
    HTTP.FOLLOWREDIRECTS FALSE
    HTTP.SETTIMEOUT 10
    HTTP.FOLLOWREDIRECTS TRUE
    Assert(TRUE, "SETTIMEOUT/FOLLOWREDIRECTS accept values, do not throw")
ENDIF

' ══════════════════════════════════════════════════════════════════
' Vectorised bitwise / shift ops (Phase 0 of subset-sum APL work).
' Regression guard for: BAND/BOR/BXOR/SHL/SHR collapsing arrays to
' a scalar via to_int() instead of broadcasting.
' ══════════════════════════════════════════════════════════════════
Header("Vectorised bitwise / shift")

LET vbit_v = IOTA(8) - 1                              ' [0..7]
Assert(LEN(vbit_v BAND 1) = 8, "vec BAND scalar keeps shape")
Assert((vbit_v BAND 1)[1] = 1, "vec BAND: [1]=1")
Assert((vbit_v BAND 1)[2] = 0, "vec BAND: [2]=0")
Assert((vbit_v BOR 8)[3] = 11,  "vec BOR scalar")
Assert((vbit_v BXOR 5)[2] = 7,  "vec BXOR scalar")
Assert((vbit_v SHL 1)[3] = 6,   "vec SHL scalar (3<<1=6)")
Assert((32 SHR vbit_v)[2] = 8,  "scalar SHR vec")

' vec OP vec
Assert(([12,13,14,15] BAND [10,10,10,10])[2] = 10, "vec BAND vec")
Assert(([1,2,3] SHL [0,1,2])[2] = 12,              "vec SHL vec (3<<2=12)")

' 2D matrix / scalar — Subset-Sum bitmask kernel
LET vbit_M = OUTER(IOTA(4) - 1, IOTA(3) - 1, "SHR")  ' 4x3 matrix
LET vbit_B = vbit_M BAND 1
Assert(vbit_B[3][0] = 1, "2D BAND: row 3 col 0 = 1")
Assert(vbit_B[3][1] = 1, "2D BAND: row 3 col 1 = 1")
Assert(vbit_B[2][0] = 0, "2D BAND: row 2 col 0 = 0")

' Infix SHL/SHR also work as operators (Phase 0 added these on top of
' the function form), for both interpreter precedence and native codegen.
Assert(1 SHL 2 = 4,             "infix 1 SHL 2")
Assert(256 SHR 4 = 16,          "infix 256 SHR 4")
Assert(-8 SHR 1 = -4,           "arith SHR preserves sign")
Assert(1 SHL 2 + 1 = 8,         "shift below addition: 1 SHL (2+1)")
' BAND has lower precedence than both shift and `=`, so `=` binds first.
' Test the binding directly via parens to keep the intent visible.
LET vbit_band_shift = 5 BAND (3 SHL 1)
Assert(vbit_band_shift = 4,     "BAND below shift: 5 BAND (3 SHL 1)")
Assert(SHL(1, 8) = 256,         "SHL function form still works")
Assert(SHR(256, 4) = 16,        "SHR function form still works")

' ══════════════════════════════════════════════════════════════════
' Native gap regression guards: IOTA(N, start), TAKE(n, arr),
' DROP(n, arr), SHIFT vector return, OUTER, FLATTEN over 2D.
' Each was at one point native-broken (empty array / garbage). Asserts
' here ensure interp ↔ native parity stays.
' ══════════════════════════════════════════════════════════════════
Header("Array primitives (native gap guards)")

' IOTA 2-arg form
LET ng_i = IOTA(5, 10)
Assert(LEN(ng_i) = 5,  "IOTA(5,10) length")
Assert(ng_i[0] = 10,   "IOTA(5,10)[0]")
Assert(ng_i[4] = 14,   "IOTA(5,10)[4]")

' TAKE / DROP — interp signature is (n, arr); native used to swap.
LET ng_full = [10, 20, 30, 40, 50, 60]
LET ng_t = TAKE(4, ng_full)
Assert(LEN(ng_t) = 4,   "TAKE(4, arr) length")
Assert(ng_t[0] = 10,    "TAKE(4, arr)[0]")
Assert(ng_t[3] = 40,    "TAKE(4, arr)[3]")
LET ng_d = DROP(2, ng_full)
Assert(LEN(ng_d) = 4,   "DROP(2, arr) length")
Assert(ng_d[0] = 30,    "DROP(2, arr)[0]")

' SHIFT pad-with-zero (used in Subset-Sum DP)
LET ng_sv = [1, 1, 1, 1, 0]
LET ng_s2 = SHIFT(ng_sv, 2)
Assert(LEN(ng_s2) = 5,  "SHIFT keeps shape")
Assert(ng_s2[0] = 0,    "SHIFT right pads zero")
Assert(ng_s2[2] = 1,    "SHIFT slides values")
LET ng_s3 = SHIFT(ng_sv, 1, 9)
Assert(ng_s3[0] = 9,    "SHIFT custom fill")

' OUTER with a string operator — the call goes through the VM bridge.
LET ng_M = OUTER([1,2,3,4], [10,20,30], "*")
Assert(ng_M[0][1] = 20, "OUTER row 0 col 1")
Assert(ng_M[2][2] = 90, "OUTER row 2 col 2")

' FLATTEN over a 2D matrix (was a 1D-only stub natively).
LET ng_F = FLATTEN([[1,2,3],[4,5,6]])
Assert(LEN(ng_F) = 6,   "FLATTEN 2D length")
Assert(ng_F[0] = 1,     "FLATTEN 2D first")
Assert(ng_F[5] = 6,     "FLATTEN 2D last")

' ══════════════════════════════════════════════════════════════════
' UDT lifecycle — SUB INIT(args), SUB DISPOSE(), DIM x AS T(args)
' and DIM arr[N] AS T(vec1, vec2, ...). Regression guards.
' ══════════════════════════════════════════════════════════════════
Header("UDT INIT / DISPOSE")

TYPE T_LifecyclePoint
    X
    Y
    SUB INIT(x, y)
        THIS.X = x
        THIS.Y = y
    ENDSUB
    FUNC SUM()
        RETURN THIS.X + THIS.Y
    ENDFUNC
ENDTYPE

' Scalar DIM with constructor args
DIM lc_p AS T_LifecyclePoint(3, 4)
Assert(lc_p.SUM() = 7, "INIT scalar args (3+4)")

' Array form with vector-args — one INIT call per slot
DIM lc_pts[3] AS T_LifecyclePoint([10, 20, 30], [1, 2, 3])
LET lc_p0 = lc_pts[0] : Assert(lc_p0.SUM() = 11, "vec INIT slot 0 (10+1)")
LET lc_p2 = lc_pts[2] : Assert(lc_p2.SUM() = 33, "vec INIT slot 2 (30+3)")

' DISPOSE on scope exit increments a global counter — proves it ran.
DIM lc_disp_count = 0
TYPE T_LifecycleResource
    Tag
    SUB INIT(t)
        THIS.Tag = t
    ENDSUB
    SUB DISPOSE()
        lc_disp_count = lc_disp_count + 1
    ENDSUB
ENDTYPE
SUB lc_use()
    DIM lc_r1 AS T_LifecycleResource(1)
    DIM lc_r2 AS T_LifecycleResource(2)
ENDSUB
lc_use
Assert(lc_disp_count = 2, "DISPOSE fires for both locals on SUB return")

' ══════════════════════════════════════════════════════════════════
' FUNC array parameter pipelines — RESHAPE/MATMUL/SHIFT inside a FUNC
' that receives an array via a top-level variable. Regression guard
' for the tag-inference pre-pass that promotes the parameter to ARR.
' ══════════════════════════════════════════════════════════════════
Header("FUNC array param tag inference")

FUNC fap_sum_via_matmul(xs)
    LET col = RESHAPE(xs, [LEN(xs), 1])
    LET ones_row = RESHAPE(ONES(LEN(xs)), [1, LEN(xs)])
    RETURN FLATTEN(MATMUL(ones_row, col))[0]
ENDFUNC

FUNC fap_apply_shift(xs, n)
    RETURN SHIFT(xs, n)
ENDFUNC

DIM fap_nums = [3, 4, 5, 6, 7]
Assert(fap_sum_via_matmul(fap_nums) = 25, "FUNC param: MATMUL+RESHAPE")

LET fap_shifted = fap_apply_shift(fap_nums, 2)
Assert(LEN(fap_shifted) = 5,        "FUNC returning SHIFT keeps shape")
Assert(fap_shifted[0] = 0,          "FUNC returning SHIFT zero-pad")
Assert(fap_shifted[3] = 4,          "FUNC returning SHIFT slid value")

' Subset-Sum APL pipeline — full circle: OUTER + BAND + MATMUL + ANY,
' all inside a FUNC, on an array parameter.
FUNC fap_subset_sum(xs, t)
    LET nn = LEN(xs)
    LET Bits = OUTER(IOTA(2 ^ nn, 0), IOTA(nn, 0), "SHR") BAND 1
    LET Sums = FLATTEN(MATMUL(Bits, RESHAPE(xs, [nn, 1])))
    RETURN ANY(Sums = t)
ENDFUNC
DIM fap_demo = [3, 34, 4, 12, 5, 2]
Assert(fap_subset_sum(fap_demo, 9) = TRUE,   "APL subset-sum target=9 (4+5)")
Assert(fap_subset_sum(fap_demo, 11) = TRUE,  "APL subset-sum target=11 (4+5+2)")
Assert(fap_subset_sum(fap_demo, 13) = FALSE, "APL subset-sum target=13 (none)")

' ── MVINS — insert a row/column into a matrix (begin / middle / end) ──
DIM mvi = [[1, 2, 3], [4, 5, 6]]                ' 2 rows x 3 cols

' COLUMN (dim 1) — append (idx = col count) with a computed vector
DIM mvi_ce = MVINS(mvi, 1, 3, [7, 8])
Assert(LEN(mvi_ce[0]) = 4, "MVINS col append: width grew to 4")
Assert(mvi_ce[0][3] = 7, "MVINS col append: row0 new cell")
Assert(mvi_ce[1][3] = 8, "MVINS col append: row1 new cell")
Assert(mvi_ce[0][2] = 3, "MVINS col append: old cells intact")
' COLUMN at the beginning (idx 0) — scalar broadcast
DIM mvi_cb = MVINS(mvi, 1, 0, 0)
Assert(mvi_cb[0][0] = 0, "MVINS col@0 scalar: row0 leading 0")
Assert(mvi_cb[1][0] = 0, "MVINS col@0 scalar: row1 leading 0")
Assert(mvi_cb[0][1] = 1, "MVINS col@0: original shifted right")
' COLUMN in the middle (idx 1) — computed vector
DIM mvi_cm = MVINS(mvi, 1, 1, [9, 99])
Assert(mvi_cm[0][1] = 9, "MVINS col@1 middle: row0")
Assert(mvi_cm[1][1] = 99, "MVINS col@1 middle: row1")
Assert(mvi_cm[0][2] = 2, "MVINS col@1: element after insert")

' ROW (dim 0) — append, beginning, middle
DIM mvi_re = MVINS(mvi, 0, 2, [7, 8, 9])
Assert(LEN(mvi_re) = 3, "MVINS row append: 3 rows")
Assert(mvi_re[2][0] = 7, "MVINS row append: new row [0]")
Assert(mvi_re[2][2] = 9, "MVINS row append: new row [2]")
DIM mvi_rb = MVINS(mvi, 0, 0, -1)              ' scalar broadcast row at top
Assert(LEN(mvi_rb) = 3, "MVINS row@0: 3 rows")
Assert(mvi_rb[0][0] = -1, "MVINS row@0 scalar: [0][0]")
Assert(mvi_rb[0][2] = -1, "MVINS row@0 scalar: [0][2]")
Assert(mvi_rb[1][0] = 1, "MVINS row@0: original shifted down")
DIM mvi_rm = MVINS(mvi, 0, 1, [10, 11, 12])
Assert(mvi_rm[1][0] = 10, "MVINS row@1 middle: [1][0]")
Assert(mvi_rm[1][2] = 12, "MVINS row@1 middle: [1][2]")
Assert(mvi_rm[2][0] = 4, "MVINS row@1: original row pushed down")

' index past the end clamps to an append
DIM mvi_clamp = MVINS(mvi, 1, 99, 5)
Assert(LEN(mvi_clamp[0]) = 4, "MVINS col idx>count clamps: width 4")
Assert(mvi_clamp[0][3] = 5, "MVINS col idx>count clamps: appended value")

' source matrix must NOT be mutated
Assert(LEN(mvi) = 2, "MVINS non-mutating: source still 2 rows")
Assert(LEN(mvi[0]) = 3, "MVINS non-mutating: source still 3 cols")
Assert(mvi[0][0] = 1, "MVINS non-mutating: source values intact")

' string-cell matrices (interp only — the native VM bridge marshals nested
' string cells back as 0; numeric matrices above cover the native path)
IF NOT OS.FEATURE("NATIVEC") THEN
    DIM mvs = [["a", "b"], ["c", "d"]]
    DIM mvs2 = MVINS(mvs, 1, 2, ["x", "y"])     ' append string column
    DIM mvs2_a AS STRING = mvs2[0][2]
    DIM mvs2_c AS STRING = mvs2[0][0]
    Assert(mvs2_a = "x", "MVINS string col append: new cell")
    Assert(mvs2_c = "a", "MVINS string col: original intact")
    DIM mvs3 = MVINS(mvs, 1, 0, "Z")            ' scalar-string broadcast @0
    DIM mvs3_0 AS STRING = mvs3[1][0]
    Assert(mvs3_0 = "Z", "MVINS scalar-string broadcast")
ENDIF

' ── EOMONTH — last day of month (Excel-style), vectorized ──
Assert(DAY(EOMONTH(CVDATE("2016-02-10"))) = 29, "EOMONTH Feb 2016 leap = 29")
Assert(DAY(EOMONTH(CVDATE("2015-02-10"))) = 28, "EOMONTH Feb 2015 = 28")
Assert(DAY(EOMONTH(CVDATE("2016-04-01"))) = 30, "EOMONTH Apr = 30")
Assert(DAY(EOMONTH(CVDATE("2016-07-15"), 1)) = 31, "EOMONTH offset +1 month day")
Assert(MONTH(EOMONTH(CVDATE("2016-07-15"), 1)) = 8, "EOMONTH offset +1 month")

' ── DATERANGE — inclusive date vector by unit/step ──
DIM dr_d AS ARRAY = DATERANGE(CVDATE("2016-07-01"), CVDATE("2016-07-05"))
Assert(LEN(dr_d) = 5, "DATERANGE daily inclusive len")
Assert(DAY(dr_d[0]) = 1, "DATERANGE daily first")
Assert(DAY(dr_d[4]) = 5, "DATERANGE daily last")
DIM dr_w AS ARRAY = DATERANGE(CVDATE("2016-07-01"), CVDATE("2016-07-22"), "W")
Assert(LEN(dr_w) = 4, "DATERANGE weekly len")
DIM dr_m AS ARRAY = DATERANGE(CVDATE("2016-01-15"), CVDATE("2016-04-15"), "M")
Assert(LEN(dr_m) = 4, "DATERANGE monthly len")
Assert(MONTH(dr_m[2]) = 3, "DATERANGE monthly step")
DIM dr_n AS ARRAY = DATERANGE(CVDATE("2016-07-05"), CVDATE("2016-07-01"), "D", -1)
Assert(LEN(dr_n) = 5, "DATERANGE negative-step len")
Assert(DAY(dr_n[0]) = 5, "DATERANGE negative-step first")

' ── TALLY — distinct values + counts (numeric path is native-safe) ──
DIM tly AS ARRAY = TALLY([1, 2, 2, 3, 3, 3])
Assert(LEN(tly) = 3, "TALLY distinct rows")
Assert(tly[0][0] = 1, "TALLY value 0")
Assert(tly[0][1] = 1, "TALLY count 0")
Assert(tly[2][0] = 3, "TALLY value 2")
Assert(tly[2][1] = 3, "TALLY count 2")

' A typed scalar receiving a numeric array element must coerce, not bit-pun.
' (A bare untyped `DIM bd_x` is now a STRICT compile error under -c; the typed
' slot exercises the FPToSI coercion that the bit-pun bug used to skip.)
DIM bd_arr = [10, 20, 30]
DIM bd_x AS DOUBLE
bd_x = bd_arr[1]
Assert(bd_x = 20, "typed scalar <- array element coerces (no bit-pun)")

' A side-effecting arg inside a scalar builtin must be evaluated exactly once.
' (Native used to codegen the arg twice — CINT(f()) ran f twice.)
EXPORT DIM ce_calls = 0
FUNC ce_bump(ce_n AS INTEGER)
    ce_calls = ce_calls + 1
    RETURN ce_n * 2
ENDFUNC
DIM ce_r AS INTEGER = CINT(ce_bump(5))
Assert(ce_calls = 1, "CINT evaluates its arg exactly once")
Assert(ce_r = 10, "CINT arg-once result correct")
ce_calls = 0
DIM ce_a AS DOUBLE = ABS(ce_bump(7))
Assert(ce_calls = 1, "native-vec math (ABS) evaluates its arg exactly once")
ce_calls = 0
DIM ce_m AS DOUBLE = MAX([ce_bump(3), ce_bump(9)])
Assert(ce_calls = 2, "MAX over distinct calls evaluates each once")

' Broader single-eval coverage across the builtin dispatch paths (audit
' 2026-06-10): array-consuming, vectorized (native_vec), string, and a HOF
' array arg must each evaluate a side-effecting argument exactly once.
FUNC ce_arr()
    ce_calls = ce_calls + 1
    RETURN [3.0, 1.0, 2.0]
ENDFUNC
FUNC ce_str$()
    ce_calls = ce_calls + 1
    RETURN "hello"
ENDFUNC
FUNC ce_dbl(ce_x AS DOUBLE)
    RETURN ce_x * 2.0
ENDFUNC
ce_calls = 0
DIM ce_e1 AS DOUBLE = SUM(ce_arr())
Assert(ce_calls = 1, "SUM evaluates its array arg exactly once")
ce_calls = 0
DIM ce_e2 AS ARRAY = REVERSE(ce_arr())
Assert(ce_calls = 1, "REVERSE evaluates its array arg exactly once")
ce_calls = 0
DIM ce_e3 AS ARRAY = SIN(ce_arr())
Assert(ce_calls = 1, "vectorized SIN evaluates its array arg exactly once")
ce_calls = 0
DIM ce_e4 AS STRING = UCASE$(ce_str$())
Assert(ce_calls = 1, "UCASE$ evaluates its arg exactly once")
ce_calls = 0
DIM ce_e5 AS ARRAY = APPEND(ce_arr(), 9.0)
Assert(ce_calls = 1, "APPEND evaluates its array arg exactly once")
ce_calls = 0
DIM ce_e6 AS ARRAY = SELECT(ce_dbl@, ce_arr())
Assert(ce_calls = 1, "SELECT evaluates its array arg exactly once")

' EOMONTH vectorized over a date array returns an array; its scalar form is
' the native-tagged one, so only the array form is interp-only.
IF NOT OS.FEATURE("NATIVEC") THEN
    DIM eom_vec AS ARRAY = EOMONTH([CVDATE("2016-02-01"), CVDATE("2016-07-01")])
    Assert(DAY(eom_vec[0]) = 29, "EOMONTH vectorized [0]")
    Assert(DAY(eom_vec[1]) = 31, "EOMONTH vectorized [1]")
ENDIF

' AGG (group + reduce) and string-key TALLY compile native: AGG reducers
' (LAMBDA g -> ..., SUM@/MEAN@/LEN@, or a FUNC with an AS ARRAY param) run as
' native trampolines over array groups; result rows carry per-cell tags.
DIM agg_k AS ARRAY = [201601, 201601, 201602, 201601, 201602]
DIM agg_v AS ARRAY = [10, 20, 5, 7, 3]
DIM agg_s AS ARRAY = AGG(agg_k, agg_v, LAMBDA g -> SUM(g))
Assert(LEN(agg_s) = 2, "AGG group count")
Assert(agg_s[0][0] = 201601, "AGG key 0 preserved")
Assert(agg_s[0][1] = 37, "AGG sum group 0")
Assert(agg_s[1][1] = 8, "AGG sum group 1")
DIM agg_c AS ARRAY = AGG(agg_k, agg_v, LAMBDA g -> LEN(g))
Assert(agg_c[0][1] = 3, "AGG count group 0")
DIM agg_f AS ARRAY = AGG(agg_k, agg_v, SUM@)
Assert(agg_f[0][1] = 37, "AGG with SUM@ funcref")
DIM agg_sk AS ARRAY = AGG(["x", "y", "x", "y", "x"], [1, 2, 3, 4, 5], LAMBDA g -> SUM(g))
DIM agg_sk_k AS STRING = agg_sk[0][0]
Assert(agg_sk_k = "x", "AGG string key preserved")
Assert(agg_sk[0][1] = 9, "AGG sum over string-keyed group")
DIM tly_s AS ARRAY = TALLY(["a", "b", "a", "a", "c"])
DIM tly_s_v AS STRING = tly_s[0][0]
Assert(tly_s_v = "a", "TALLY string value")
Assert(tly_s[0][1] = 3, "TALLY string count")

' SCAN (cumulative reduce, string operator) returns an array native — it was
' classified as f64 by the VM bridge and came back as 0.
DIM scn AS ARRAY = SCAN("+", [1.0, 2.0, 3.0, 4.0])
Assert(LEN(scn) = 4, "SCAN length")
Assert(scn[0] = 1, "SCAN prefix [0]")
Assert(scn[3] = 10, "SCAN prefix [3]")
DIM scn_m AS ARRAY = SCAN("*", [1.0, 2.0, 3.0, 4.0])
Assert(scn_m[3] = 24, "SCAN product prefix [3]")

' Bare DIM (no AS ARRAY) of a VM-bridge array returner: the slot type comes
' purely from inference. NORMALIZE lived in the bridge array set but was
' missing from every DIM-inference list, so `DIM x = NORMALIZE(a)` typed the
' slot scalar and the array collapsed natively. The four inference paths now
' union the bridge set, so a bridge array returner is array-typed everywhere.
DIM nrm = NORMALIZE([2.0, 0.0, 4.0])
Assert(LEN(nrm) = 3, "NORMALIZE bare-DIM length")
Assert(nrm[0] = 0.5, "NORMALIZE bare-DIM [0]")
Assert(nrm[1] = 0, "NORMALIZE bare-DIM [1]")
Assert(nrm[2] = 1, "NORMALIZE bare-DIM [2]")
' Bare-DIM SCAN exercises the inference path (the asserts above use AS ARRAY).
DIM scn_b = SCAN("+", [1.0, 2.0, 3.0, 4.0])
Assert(LEN(scn_b) = 4, "SCAN bare-DIM length")
Assert(scn_b[3] = 10, "SCAN bare-DIM [3]")

' ══════════════════════════════════════════════════════════════════
' Native audit cluster 3/6/7: runtime-tag materialisation, scalar string
' ordering, string-array element-wise ops (no segfault), mixed APPEND,
' large-array FRMV$ buffer safety.
' ══════════════════════════════════════════════════════════════════
Header("Audit fixes: nested-cell ops / string ordering / mixed arrays")

' C3: a nested-index cell is RUNTIME-tagged; power (^) and unary minus must
' materialise it to f64 first (were yielding 0 / a negated bit pattern).
DIM gnest = [[2.0, 3.0], [4.0, 5.0]]
Assert(gnest[0][1] ^ 2 = 9, "power on nested-index cell")
Assert(-gnest[0][1] = -3, "unary minus on nested-index cell")
Assert(gnest[1][0] ^ 2 = 16, "power on nested-index cell [1][0]")

' C7: scalar string ordering must compare content, not heap pointers.
Assert(("apple" < "banana") = TRUE, "string < lexicographic")
Assert(("banana" < "apple") = FALSE, "string < reverse")
Assert(("abc" <= "abc") = TRUE, "string <= equal")
Assert(("abc" >= "abd") = FALSE, "string >= less")
Assert(("zebra" > "apple") = TRUE, "string > greater")

' C6a: string-array element-wise compare/concat must not segfault (string
' arrays carry the nested-ptr flag bit) and must match the interpreter.
DIM sne = ["a", "b", "c"] <> ["a", "x", "c"]
Assert(sne[0] = 0, "string-array <> [0]")
Assert(sne[1] = 1, "string-array <> [1]")
Assert(sne[2] = 0, "string-array <> [2]")
DIM sgt = ["b", "b"] > ["a", "c"]
Assert(sgt[0] = 1, "string-array > [0]")
Assert(sgt[1] = 0, "string-array > [1]")
DIM scat = ["a", "b"] + ["c", "d"]
Assert(LEN(scat) = 2, "string-array concat length")
Assert(scat[0] = "ac", "string-array concat [0]")
Assert(scat[1] = "bd", "string-array concat [1]")

' C6c: jdb_frmv must not overflow its fixed buffer on a large array.
DIM bigstr = FRMV$(IOTA(3000))
Assert(LEN(bigstr) > 100, "FRMV$ large array no-overflow")

' C5a: a string-returning LAMBDA must not abort native compilation (the body
' is a pointer; it is punned into the f64 funcref-return slot). SELECT flags
' the result as a string array so the cells read back as strings.
DIM selstr = SELECT(LAMBDA x -> STR$(x), [1.0, 2.0, 3.0])
Assert(LEN(selstr) = 3, "SELECT lambda->string length")
Assert(selstr[0] = "1", "SELECT lambda->string [0]")
Assert(selstr[2] = "3", "SELECT lambda->string [2]")

' C5b: REDUCE with an explicit numeric accumulator (3-arg form). The init is
' evaluated once and coerced; non-numeric inits no longer abort the compile.
DIM redsum = REDUCE(LAMBDA a, b -> a + b, [1.0, 2.0, 3.0], 100.0)
Assert(redsum = 106, "REDUCE with numeric init")

' C9c: a funcref-literal passed to an inferred-FUNCREF user param builds a
' wrapper matching the target's REAL arity (was hardcoded to 1, so a 2-arg
' target was miscalled).
FUNC c9_add(c9x, c9y)
  RETURN c9x + c9y
ENDFUNC
FUNC c9_apply2(c9fn, c9p, c9q)
  RETURN c9fn(c9p, c9q)
ENDFUNC
Assert(c9_apply2(c9_add@, 3.0, 4.0) = 7, "funcref-literal 2-arg wrapper arity")


' Regression for param-shadowing-globals: a top-level DIM with the same
' name as a SUB parameter must NOT poison the parameter's tag.
' (Was breaking TEST_INNER.ADD_THING via TEST_OUTER.ADD_VIA_OUTER.)
DIM fap_shadow_v = [1, 2, 3, 4, 5]   ' top-level v is an array
SUB fap_shadow_set(v, target)
    ' here `v` is a scalar param, NOT the global array
    fap_nums[0] = v + target
ENDSUB
fap_shadow_set 99, 1
Assert(fap_nums[0] = 100, "param shadows top-level array global")

' (Skipped: case-sensitivity test removed — interp treats `V` and `v`
'  as the same identifier (param/local share a slot), native treats
'  them as distinct. Exposing that divergence belongs in its own
'  fix session, not a regression guard. Lesson learned: never reuse
'  a name with only case variation inside a SUB/FUNC.)

' ══════════════════════════════════════════════════════════════════
' Native string-array element extraction
'
' Regression for codegen bugs (2026-05-01): under -c, arr[i] and
' FOR EACH iter-vars on dynamically-typed string arrays (DIR$(*, FALSE),
' OS.ARGS(), etc.) returned 0 instead of the string. Phase-2 tracking
' didn't recognize those builtins, so INDEX defaulted to f64-decode.
' These tests pin the fix.
' ══════════════════════════════════════════════════════════════════
Header("Native string-array element extraction")

' Already-tracked: literal string array — sanity guard.
DIM nsa_lits AS ARRAY = ["alpha", "beta", "gamma"]
Assert(nsa_lits[0] = "alpha", "literal string array subscript [0]")
Assert(nsa_lits[2] = "gamma", "literal string array subscript [2]")

' Already-tracked: SPLIT.
DIM nsa_parts = SPLIT("a,b,c,d", ",")
Assert(nsa_parts[0] = "a", "SPLIT result subscript [0]")
Assert(nsa_parts[3] = "d", "SPLIT result subscript [3]")

' DIR$(*, FALSE) → 1D string array. Was broken in native.
MKDIR "_nsa_tmp"
TXTWRITER "_nsa_tmp/alpha.txt", "a"
TXTWRITER "_nsa_tmp/bravo.txt", "b"
TXTWRITER "_nsa_tmp/charlie.txt", "c"
DIM nsa_names = DIR$("_nsa_tmp/*", FALSE)
Assert(LEN(nsa_names) = 3, "DIR$(FALSE) row count")
DIM nsa_nm0 AS STRING = nsa_names[0]
Assert(LEN(nsa_nm0) > 0, "DIR$(FALSE) [0] returns non-empty string")
DIM nsa_saw AS INTEGER = 0
DIM nsa_i AS INTEGER
FOR nsa_i = 0 TO LEN(nsa_names) - 1
  IF nsa_names[nsa_i] = "alpha.txt" THEN nsa_saw = 1
NEXT nsa_i
Assert(nsa_saw = 1, "DIR$(FALSE) [i] in FOR loop sees real strings")

' FOR EACH over a string array — iter var was 0 in native.
DIM nsa_concat AS STRING = ""
DIM nsa_s AS STRING
FOR EACH nsa_s IN nsa_parts
  nsa_concat = nsa_concat + nsa_s
NEXT
Assert(nsa_concat = "abcd", "FOR EACH over SPLIT result concatenates")

DIM nsa_seen AS INTEGER = 0
DIM nsa_nm AS STRING
FOR EACH nsa_nm IN nsa_names
  IF LEN(nsa_nm) > 0 THEN nsa_seen = nsa_seen + 1
NEXT
Assert(nsa_seen = 3, "FOR EACH over DIR$(FALSE) sees all entries")

' Cleanup
KILL "_nsa_tmp/alpha.txt"
KILL "_nsa_tmp/bravo.txt"
KILL "_nsa_tmp/charlie.txt"
RMDIR "_nsa_tmp"

' OS.ARGS — element extraction. The runner can't easily pass args here,
' so we only smoke-test that it returns a value-shaped array. The real
' element-subscript test lives in tests/test_native_os_args.jdb which
' the build invokes with `-c` plus a known argv.
DIM nsa_args = OS.ARGS()
Assert(LEN(nsa_args) >= 0, "OS.ARGS callable, returns array")

' APPEND(string_arr_a, string_arr_b) — result var must be tagged as
' a string array so subscript reads decode the punned-f64 cells.
' Use DIM = subscript form (forces the INDEX path); PRINT'ing the
' whole array goes through a different stringifier today.
DIM nsa_x = ["aa", "bb"]
DIM nsa_y = ["cc", "dd"]
DIM nsa_xy = APPEND(nsa_x, nsa_y)
Assert(LEN(nsa_xy) = 4, "APPEND string-arr+string-arr length")
DIM nsa_xy0 AS STRING = nsa_xy[0]
DIM nsa_xy3 AS STRING = nsa_xy[3]
Assert(nsa_xy0 = "aa", "APPEND result [0] decodes as string")
Assert(nsa_xy3 = "dd", "APPEND result [3] decodes as string")

' User FUNC returning a string-array — caller must see the strings.
' Without Phase 1 returns_string_array tracking this came back as f64.
FUNC nsa_make_list()
  DIM out AS ARRAY = []
  out = APPEND(out, ["alpha"])
  out = APPEND(out, ["bravo"])
  out = APPEND(out, ["charlie"])
  RETURN out
ENDFUNC
DIM nsa_made = nsa_make_list()
Assert(LEN(nsa_made) = 3, "user-FUNC string-array return length")
DIM nsa_m0 AS STRING = nsa_made[0]
DIM nsa_m2 AS STRING = nsa_made[2]
Assert(nsa_m0 = "alpha", "user-FUNC result [0] decodes as string")
Assert(nsa_m2 = "charlie", "user-FUNC result [2] decodes as string")

' APPEND(arr, s$) where the value is a BARE scalar string variable (not a
' [s$] literal, not a string array). An empty [] is inferred as a double
' array; before the 2026-06-07 codegen fix the appended string was punned
' to f64 and read back as ~6.95e-310. The scalar-string second arg must
' tag the result as a string array. Mixed scalar-var + literal too.
DIM nsa_sv = []
DIM nsa_one$ = "uno"
nsa_sv = APPEND(nsa_sv, nsa_one$)
nsa_sv = APPEND(nsa_sv, "dos")
Assert(LEN(nsa_sv) = 2, "APPEND scalar-strvar length")
DIM nsa_sv0 AS STRING = nsa_sv[0]
DIM nsa_sv1 AS STRING = nsa_sv[1]
Assert(nsa_sv0 = "uno", "APPEND scalar-strvar [0] decodes as string")
Assert(nsa_sv1 = "dos", "APPEND scalar-strvar [1] decodes as string")

' jdtriage shape: a GLOBAL string array built inside a SUB by APPENDing a
' scalar string variable, then indexed at top level AND inside a FUNC.
DIM nsa_glob = []
SUB nsa_fill()
  DIM s$ = "first"
  nsa_glob = APPEND(nsa_glob, s$)
  nsa_glob = APPEND(nsa_glob, "second")
ENDSUB
FUNC nsa_read0$()
  RETURN nsa_glob[0]
ENDFUNC
nsa_fill()
Assert(LEN(nsa_glob) = 2, "SUB-built global str-array length")
DIM nsa_g0 AS STRING = nsa_glob[0]
Assert(nsa_g0 = "first", "SUB-built global str-array [0] at top level")
DIM nsa_gr AS STRING = nsa_read0$()
Assert(nsa_gr = "first", "global str-array [0] read inside FUNC")

' ══════════════════════════════════════════════════════════════════
' DIM shadowing inside FUNC/SUB
'
' Regression for native -c (2026-05-02): DIM x AS <type> inside a
' FUNC/SUB without RHS used to do `lookup_var(x)` which crawled outer
' scopes and reused a top-level @X global. Walks of recursive FUNCs
' that declared `DIM i AS INTEGER` then shared a single global @I
' with a top-level FOR i loop, so recursion clobbered the outer
' iteration counter and the program wedged.
'
' Each test exercises a different shadowing axis. They MUST hold
' identically in interp and native.
' ══════════════════════════════════════════════════════════════════
Header("DIM shadowing inside FUNC/SUB")

' --- 1. Recursive FUNC's loop var must not clobber the caller's. ---
DIM shd_calls AS INTEGER = 0

FUNC shd_walk(depth AS INTEGER)
  shd_calls = shd_calls + 1
  IF depth = 0 THEN RETURN 0
  DIM i AS INTEGER
  DIM total AS DOUBLE = 0.0
  FOR i = 0 TO 2
    total = total + shd_walk(depth - 1)
  NEXT i
  RETURN total
ENDFUNC

DIM i AS INTEGER
DIM outer_loops AS INTEGER = 0
FOR i = 0 TO 1
  outer_loops = outer_loops + 1
  shd_walk(2) ' 1 + 3 + 9 = 13 calls per outer iter
NEXT i
Assert(outer_loops = 2, "outer FOR i not corrupted by recursive FUNC's DIM i")
Assert(shd_calls = 26, "recursive walk completed all calls (2 * 13)")

' --- 2. SUB-local DIM doesn't bleed back to outer. ---
DIM shd_x AS INTEGER = 5

SUB shd_local_only()
  DIM shd_x AS INTEGER
  shd_x = 99
ENDSUB

shd_local_only
Assert(shd_x = 5, "SUB-local DIM doesn't write to outer scope of same name")

' --- 3. FUNC param shadows outer var. ---
DIM shd_v AS INTEGER = 7
FUNC shd_get_v(shd_v AS INTEGER)
  RETURN shd_v + 1
ENDFUNC
Assert(shd_get_v(40) = 41, "param uses caller's argument, not outer")
Assert(shd_v = 7, "outer untouched after FUNC call")

' --- 4. DIM AS STRING shadow + recursion (string-typed counterpart). ---
DIM shd_msg AS STRING = "outer"

FUNC shd_recurse_str(n AS INTEGER)
  DIM shd_msg AS STRING
  shd_msg = "level-" + STR$(n)
  IF n > 0 THEN shd_recurse_str(n - 1)
  RETURN 0
ENDFUNC

shd_recurse_str(3)
Assert(shd_msg = "outer", "outer string survives recursive shadow")

' --- 5. SUB calls SUB that DIMs same-named local — middle-frame untouched. ---
DIM shd_chain AS INTEGER = 100

SUB shd_inner()
  DIM shd_chain AS INTEGER
  shd_chain = 42
ENDSUB

SUB shd_outer_sub()
  DIM shd_chain AS INTEGER
  shd_chain = 7
  shd_inner
  ' shd_inner's DIM must not have written to this frame's shd_chain.
  Assert(shd_chain = 7, "middle-frame DIM survives nested SUB DIM")
ENDSUB

shd_outer_sub
Assert(shd_chain = 100, "top-level DIM survives both nested SUB DIMs")

' ══════════════════════════════════════════════════════════════════
' Vector string equality + string UNIQUE under -c
'
' Regression: `(string_arr = scalar_str)` used to compare punned-
' pointer bits in native (every cell got a different ptr from the
' allocator, so all-FALSE), and `UNIQUE(string_arr)` deduped by
' identity — two SHA256$ results with the same text but separate
' allocations both survived. Both broke any downstream group-by-key
' pattern (dupfinder being the canonical example).
' ══════════════════════════════════════════════════════════════════
Header("Vector string equality + UNIQUE")

DIM vse_xs = SPLIT("aa,bb,aa,cc,aa", ",")
DIM vse_h AS STRING = "aa"
DIM vse_mask = (vse_xs = vse_h)
Assert(SUM(vse_mask) = 3, "(string_arr = scalar_str) counts text matches")
Assert(LEN(vse_mask) = 5, "compare result has same length as input")

DIM vse_neq = (vse_xs <> vse_h)
Assert(SUM(vse_neq) = 2, "(string_arr <> scalar_str) counts non-matches")

' UNIQUE must dedupe by content, not pointer identity. We force
' separate allocations via SPLIT pairs so identity-based dedupe
' would leave duplicates behind.
DIM vse_a = SPLIT("alpha,beta,alpha,gamma,beta", ",")
DIM vse_u = UNIQUE(vse_a)
Assert(LEN(vse_u) = 3, "UNIQUE on string-array dedupes by content")

' SHA256$ is the dupfinder pattern: each call allocates a fresh
' string, but identical inputs must dedupe to one entry.
DIM vse_sa AS STRING = CODEC.SHA256$("hello")
DIM vse_sb AS STRING = CODEC.SHA256$("hello")
DIM vse_sc AS STRING = CODEC.SHA256$("world")
DIM vse_hashes = [vse_sa, vse_sb, vse_sc]
DIM vse_huniq = UNIQUE(vse_hashes)
Assert(LEN(vse_huniq) = 2, "UNIQUE on SHA256$ results dedupes by hash text")

' ══════════════════════════════════════════════════════════════════
' Array-transformer flag propagation audit
'
' Each transformer must preserve the string-elements flag on its
' result so subsequent PRINTs / subscripts / FOR EACHs still see
' real strings rather than f64-punned garbage. This audit pins the
' runtime contract for jdb_array_reverse / sort / append / append_arr
' / take / drop / diff / flatten / shuffle / gather / unique_str /
' apply_ss + the producers SPLIT / OS.ARGS / array STR$.
' ══════════════════════════════════════════════════════════════════
Header("String-array flag propagation through transformers")

' Producer: SPLIT. We've covered subscript via DIM = arr[i] earlier;
' here we focus on the "PRINT renders strings, not f64" angle.
DIM tfp_xs = SPLIT("alpha,beta,gamma", ",")
DIM tfp_x0 AS STRING = tfp_xs[0]
DIM tfp_x2 AS STRING = tfp_xs[2]
Assert(tfp_x0 = "alpha", "SPLIT [0] decodes as string")
Assert(tfp_x2 = "gamma", "SPLIT [2] decodes as string")

' REVERSE preserves string elements. Also verifies the runtime flag
' rather than just the codegen tracking — we read tfp_rev[0] back as
' a STRING and check the literal value.
DIM tfp_rev = REVERSE(tfp_xs)
DIM tfp_r0 AS STRING = tfp_rev[0]
Assert(tfp_r0 = "gamma", "REVERSE preserves string elements")

' TAKE / DROP preserve string elements.
DIM tfp_tk = TAKE(2, tfp_xs)
DIM tfp_tk0 AS STRING = tfp_tk[0]
Assert(tfp_tk0 = "alpha", "TAKE preserves string elements")
DIM tfp_dr = DROP(1, tfp_xs)
DIM tfp_dr0 AS STRING = tfp_dr[0]
Assert(tfp_dr0 = "beta", "DROP preserves string elements")

' APPEND(string_arr, [scalar_string]) — single-value path. Must keep
' the existing string-array tag on the LHS.
DIM tfp_ext = APPEND(tfp_xs, ["delta"])
Assert(LEN(tfp_ext) = 4, "APPEND single string to string-array length")
DIM tfp_e3 AS STRING = tfp_ext[3]
Assert(tfp_e3 = "delta", "APPEND single string [last] decodes correctly")
DIM tfp_e0 AS STRING = tfp_ext[0]
Assert(tfp_e0 = "alpha", "APPEND single string preserves head")

' Cross-transformer: REVERSE then APPEND then UNIQUE — the result
' must still decode as strings end-to-end.
DIM tfp_chain = UNIQUE(APPEND(REVERSE(tfp_xs), ["alpha"]))
Assert(LEN(tfp_chain) = 3, "REVERSE + APPEND + UNIQUE chain dedupes correctly")
DIM tfp_c0 AS STRING = tfp_chain[0]
DIM tfp_c2 AS STRING = tfp_chain[2]
Assert(tfp_c0 = "gamma", "transform chain preserves first element")
Assert(tfp_c2 = "alpha", "transform chain preserves last element")

' STR$(numeric_arr) produces a string-array — read elements back and
' verify they're strings, not the f64 cells.
DIM tfp_nums = [10, 20, 30]
DIM tfp_strs = STR$(tfp_nums)
Assert(LEN(tfp_strs) = 3, "STR$(arr) length")
DIM tfp_s0 AS STRING = tfp_strs[0]
Assert(LEN(tfp_s0) > 0, "STR$(arr) [0] is a non-empty string")
Assert(tfp_s0 = "10", "STR$(arr) [0] = '10'")

' ══════════════════════════════════════════════════════════════════
' FORMAT$ across all argument tag types
' (regression for native codegen bug where MAP-indexed VM_HANDLE args
'  were passed as raw i64 to jdb_format1 — declared (i8*, double) —
'  tripping LLVM IR verification with "Call parameter type does not
'  match function signature". Fix routes non-I64/F64 tags through
'  coerce_to(f64) so VM handles hit __jdrt_val_to_f64 first.)
' ══════════════════════════════════════════════════════════════════
Header("FORMAT$ across argument tag types")

' Anchor the locale so number formatting is deterministic across runs.
SETLOCALE "C"

' --- Literal scalars (the easy case — direct codegen tag) -----------
Assert(FORMAT$("{:.2f}", 12.5) = "12.50",   "FORMAT$ literal f64 with :.2f")
Assert(FORMAT$("{:.2f}", 7)    = "7.00",    "FORMAT$ literal i64 promoted to f64 via :.2f")
Assert(FORMAT$("{}", 7)        = "7",       "FORMAT$ literal i64 via {}")
Assert(FORMAT$("{}", 2.5)      = "2.5",     "FORMAT$ literal f64 via {}")
Assert(FORMAT$("{}", "hello")  = "hello",   "FORMAT$ literal string via {}")

' --- VM_HANDLE from MAP indexing (the bug from this session) --------
DIM fmt_p AS MAP
fmt_p{"f"} = 12.5
fmt_p{"i"} = 7
fmt_p{"s"} = "hi"
Assert(FORMAT$("{:.2f}", fmt_p{"f"}) = "12.50", "FORMAT$ MAP-VM_HANDLE f64 via :.2f")
Assert(FORMAT$("{:.2f}", fmt_p{"i"}) = "7.00",  "FORMAT$ MAP-VM_HANDLE i64 via :.2f")
Assert(FORMAT$("{}", fmt_p{"s"})     = "hi",    "FORMAT$ MAP-VM_HANDLE string via {}")
Assert(FORMAT$("{}", fmt_p{"f"})     = "12.5",  "FORMAT$ MAP-VM_HANDLE f64 via {}")
Assert(FORMAT$("{:.2f} {}", fmt_p{"f"}, fmt_p{"s"}) = "12.50 hi", _
       "FORMAT$ multi-arg mixed VM_HANDLE numeric+string")

' --- Array-element extraction (numeric tag, indexed) ----------------
DIM fmt_arr = [1, 2.5, 3]
Assert(FORMAT$("{:.2f}", fmt_arr[1]) = "2.50", "FORMAT$ on arr[i] f64")
Assert(FORMAT$("{:.2f}", fmt_arr[0]) = "1.00", "FORMAT$ on arr[i] i64-in-f64-arr")

' --- Multi-arg mix --------------------------------------------------
Assert(FORMAT$("{}={:.2f}", "px", 12.5)  = "px=12.50", "FORMAT$ multi-arg str + f64")
Assert(FORMAT$("{} {} {}", 1, 2.5, "x")  = "1 2.5 x",  "FORMAT$ multi-arg i64 + f64 + str")
Assert(FORMAT$("{:.2f} x {:.2f}", fmt_p{"f"}, fmt_p{"i"}) = "12.50 x 7.00", _
       "FORMAT$ multi-arg both VM_HANDLE")

' --- Known native codegen gaps (pre-existing). Left commented so
'  they're discoverable. Uncomment once the corresponding native-
'  format-codegen issue lands. (string-from-VM_HANDLE was fixed in
'  the FORMAT$ 'h' tag follow-up — see asserts above.)
' Assert(FORMAT$("{}", TRUE)             = "TRUE",     "FORMAT$ BOOL — native says '1'")
' Assert(FORMAT$("{:>8.2f}", 3.14)       = "    3.14", "FORMAT$ width >8 — native ignores width")
' Assert(FORMAT$("{:0>4}", 7)            = "0007",     "FORMAT$ zero-pad 0>4 — native ignores fill")

SETLOCALE "C"

' ══════════════════════════════════════════════════════════════════
' STATIC local variables (FUNC/SUB-scoped persistent state).
' Init runs once on the first execution of the STATIC DIM line; the
' slot persists across calls and is shared by every recursive depth.
' Storage is per-VM, hangs off the FuncProto, so cross-module calls
' resolve to the same slot.
' ══════════════════════════════════════════════════════════════════
Header("STATIC local variables")

IMPORT STATIC_TEST_MOD

' --- Scalar i64 counter, in-file FUNC ------------------------------
FUNC st_counter() AS INTEGER
    STATIC DIM n AS INTEGER = 0
    n = n + 1
    RETURN n
ENDFUNC

Assert(st_counter() = 1, "STATIC int: first call returns 1")
Assert(st_counter() = 2, "STATIC int: second call returns 2")
Assert(st_counter() = 3, "STATIC int: third call returns 3")

' --- Init runs exactly once — observable via global side-effect ----
DIM st_init_runs = 0

FUNC st_bump_init() AS INTEGER
    st_init_runs = st_init_runs + 1
    RETURN 0
ENDFUNC

FUNC st_counted_init() AS INTEGER
    STATIC DIM dummy AS INTEGER = st_bump_init()
    RETURN dummy
ENDFUNC

DIM st_d1 = st_counted_init()
DIM st_d2 = st_counted_init()
DIM st_d3 = st_counted_init()
DIM st_d4 = st_counted_init()
DIM st_d5 = st_counted_init()
Assert(st_init_runs = 1, "STATIC initializer evaluated exactly once across N calls")
Assert(st_d1 = 0 AND st_d5 = 0, "STATIC initializer return value is the slot value")

' --- DOUBLE static -------------------------------------------------
FUNC st_running_avg(x AS DOUBLE) AS DOUBLE
    STATIC DIM total AS DOUBLE = 0.0
    STATIC DIM count AS INTEGER = 0
    total = total + x
    count = count + 1
    RETURN total / count
ENDFUNC

DIM st_avg1 = st_running_avg(10.0)
DIM st_avg2 = st_running_avg(20.0)
DIM st_avg3 = st_running_avg(30.0)
Assert(st_avg1 = 10.0, "STATIC double: avg of [10] = 10")
Assert(st_avg2 = 15.0, "STATIC double: avg of [10,20] = 15")
Assert(st_avg3 = 20.0, "STATIC double: avg of [10,20,30] = 20")

' --- STRING static (accumulator) -----------------------------------
FUNC st_concat$(s$) AS STRING
    STATIC DIM acc AS STRING = ""
    acc = acc + s$
    RETURN acc
ENDFUNC

Assert(st_concat$("a") = "a",   "STATIC string: first append")
Assert(st_concat$("b") = "ab",  "STATIC string: second append accumulates")
Assert(st_concat$("c") = "abc", "STATIC string: third append accumulates")

' --- MAP static (memoization) --------------------------------------
FUNC st_seen(k$) AS INTEGER
    STATIC DIM memo AS MAP = {}
    IF MAP.EXISTS(memo, k$) THEN
        RETURN 1
    ENDIF
    memo{k$} = TRUE
    RETURN 0
ENDFUNC

Assert(st_seen("foo") = 0, "STATIC map: foo unseen on first call")
Assert(st_seen("foo") = 1, "STATIC map: foo seen on second call")
Assert(st_seen("bar") = 0, "STATIC map: bar unseen on first sighting")
Assert(st_seen("foo") = 1, "STATIC map: foo still remembered after intermediate keys")

' --- ARRAY static (accumulator) ------------------------------------
FUNC st_log(s$) AS INTEGER
    STATIC DIM events AS ARRAY = []
    events = APPEND(events, s$)
    RETURN LEN(events)
ENDFUNC

Assert(st_log("a") = 1, "STATIC array: first event")
Assert(st_log("b") = 2, "STATIC array: second event")
Assert(st_log("c") = 3, "STATIC array: third event")

' --- SUB with STATIC (no return) -----------------------------------
DIM st_visible_bumps = 0

SUB st_bump_observed()
    STATIC DIM bumps AS INTEGER = 0
    bumps = bumps + 1
    st_visible_bumps = bumps
ENDSUB

st_bump_observed()
Assert(st_visible_bumps = 1, "STATIC in SUB: first call sets bumps=1")
st_bump_observed()
st_bump_observed()
Assert(st_visible_bumps = 3, "STATIC in SUB: persists across calls")

' --- Recursion: every depth shares the same slot -------------------
FUNC st_rec(depth AS INTEGER) AS INTEGER
    STATIC DIM hits AS INTEGER = 0
    hits = hits + 1
    IF depth > 0 THEN
        DIM unused = st_rec(depth - 1)
    ENDIF
    RETURN hits
ENDFUNC

' First call with depth 4 -> 5 invocations total (4,3,2,1,0); the
' returned value is the value AFTER the deepest tail bumps it, then
' unwinds back to the top frame's RETURN — i.e. the final hit count.
DIM st_rec_first = st_rec(4)
Assert(st_rec_first = 5, "STATIC + recursion: 5 invocations bump shared slot")
DIM st_rec_second = st_rec(0)
Assert(st_rec_second = 6, "STATIC + recursion: subsequent shallow call still sees state")

' --- Multiple STATICs in same function -----------------------------
FUNC st_pair() AS INTEGER
    STATIC DIM a AS INTEGER = 1
    STATIC DIM b AS INTEGER = 100
    a = a + 1
    b = b + 10
    RETURN a * 1000 + b
ENDFUNC

Assert(st_pair() = 2110, "STATIC: two slots in one func, first call (a=2,b=110)")
Assert(st_pair() = 3120, "STATIC: two slots in one func, second call (a=3,b=120)")

' --- STATIC inside a conditional block -----------------------------
' Init is tied to the line, not the function entry, so the first
' execution of the line drives the init. Subsequent passes find the
' guard set and skip.
FUNC st_cond_init(trigger AS INTEGER) AS INTEGER
    IF trigger > 0 THEN
        STATIC DIM seen_in_branch AS INTEGER = 42
        seen_in_branch = seen_in_branch + 1
        RETURN seen_in_branch
    ENDIF
    RETURN -1
ENDFUNC

Assert(st_cond_init(0) = -1, "STATIC inside IF: branch not taken, no init yet")
Assert(st_cond_init(1) = 43, "STATIC inside IF: first time branch taken, init=42 +1")
Assert(st_cond_init(0) = -1, "STATIC inside IF: skip branch, slot untouched")
Assert(st_cond_init(1) = 44, "STATIC inside IF: branch again, slot persisted")

' --- Cross-module: same FUNC called from main vs nested helper -----
Assert(STATIC_TEST_MOD.mod_counter() = 1, "Cross-module STATIC: mod first call")
Assert(STATIC_TEST_MOD.mod_counter() = 2, "Cross-module STATIC: mod second call")

' Wrapper FUNC in the main file calling the module function — the
' module's static must be the SAME slot regardless of caller.
FUNC st_call_module() AS INTEGER
    RETURN STATIC_TEST_MOD.mod_counter()
ENDFUNC

Assert(st_call_module() = 3, "Cross-module STATIC: same slot from wrapper")
Assert(STATIC_TEST_MOD.mod_counter() = 4, "Cross-module STATIC: same slot from main")

' Cross-module STRING
DIM mod_s1$ = STATIC_TEST_MOD.mod_concat("x")
DIM mod_s2$ = STATIC_TEST_MOD.mod_concat("y")
DIM mod_s3$ = STATIC_TEST_MOD.mod_concat("z")
Assert(mod_s1$ = "x"   , "Cross-module STATIC string: x")
Assert(mod_s2$ = "xy"  , "Cross-module STATIC string: xy")
Assert(mod_s3$ = "xyz" , "Cross-module STATIC string: xyz")

' Cross-module DOUBLE
Assert(STATIC_TEST_MOD.mod_sum_d(1.5)  = 1.5, "Cross-module STATIC double: 1.5")
Assert(STATIC_TEST_MOD.mod_sum_d(2.5)  = 4.0, "Cross-module STATIC double: 4.0")
Assert(STATIC_TEST_MOD.mod_sum_d(0.25) = 4.25, "Cross-module STATIC double: 4.25")

' Cross-module MAP
Assert(STATIC_TEST_MOD.mod_seen("k1") = 0, "Cross-module STATIC map: k1 unseen")
Assert(STATIC_TEST_MOD.mod_seen("k1") = 1, "Cross-module STATIC map: k1 remembered")
Assert(STATIC_TEST_MOD.mod_seen("k2") = 0, "Cross-module STATIC map: k2 unseen")

' Cross-module ARRAY
Assert(STATIC_TEST_MOD.mod_log("e1") = 1, "Cross-module STATIC array: 1 event")
Assert(STATIC_TEST_MOD.mod_log("e2") = 2, "Cross-module STATIC array: 2 events")

' Cross-module SUB with STATIC
STATIC_TEST_MOD.mod_bump
STATIC_TEST_MOD.mod_bump
STATIC_TEST_MOD.mod_bump
' (bumps has no observable side-effect from outside; mod_bumps_via_recall
'  has its own STATIC slot to prove the SUB compiles + dispatches OK)
Assert(STATIC_TEST_MOD.mod_bumps_via_recall() = 1, "Cross-module STATIC SUB+FUNC compile clean")

' Cross-module recursion with STATIC
DIM mod_rec_first = STATIC_TEST_MOD.mod_rec(2)
DIM mod_rec_second = STATIC_TEST_MOD.mod_rec(0)
Assert(mod_rec_first = 3, "Cross-module STATIC + recursion: depth 2 = 3 hits")
Assert(mod_rec_second = 4, "Cross-module STATIC + recursion: shallow call sees state")

' --- FUNC@ reference resolves to same slot -------------------------
' (native funcref dispatch on a 0-arg call only resolves through SELECT/
' REDUCE-style indirect dispatch; a direct `ref()` syntax is interp-only.
' We assert the funcref was at least bound, leaving the call test to
' the interp pass.)
LET ref_counter = st_counter@
Assert(LEN(STR$(ref_counter)) > 0, "STATIC FUNC@ binding compiles")

' ══════════════════════════════════════════════════════════════════
' AS DYNAMIC — tagged-mixed array params
' Arrays built from `[map{"k1"}, map{"k2"}, ...]` carry per-cell tags;
' FUNC params declared `AS DYNAMIC` route reads through the tagged
' path so each cell's type survives the call boundary.
' ══════════════════════════════════════════════════════════════════
Header("AS DYNAMIC tagged FUNC params")

DIM dyn_meta AS MAP
dyn_meta{"name"} = "Anna"
dyn_meta{"age"}  = 42
dyn_meta{"email"} = "anna@example.com"

' --- 1. Direct DIM AS DYNAMIC ---
DIM dyn_arr AS DYNAMIC = [dyn_meta{"name"}, dyn_meta{"age"}, dyn_meta{"email"}]
Assert(LEN(dyn_arr) = 3, "AS DYNAMIC: array length preserved")
Assert(dyn_arr[0] = "Anna", "AS DYNAMIC: string element[0] survives")
Assert(dyn_arr[1] = 42, "AS DYNAMIC: int element[1] survives")
Assert(dyn_arr[2] = "anna@example.com", "AS DYNAMIC: string element[2] survives")

' --- 2. FUNC param AS DYNAMIC: each cell keeps its real type ---
FUNC dyn_first$(arr AS DYNAMIC)
    RETURN arr[0]
ENDFUNC
FUNC dyn_second(arr AS DYNAMIC)
    RETURN arr[1]
ENDFUNC
Assert(dyn_first$([dyn_meta{"name"}, dyn_meta{"age"}]) = "Anna", _
    "AS DYNAMIC param: read string from cross-FUNC tagged array")
Assert(dyn_second([dyn_meta{"name"}, dyn_meta{"age"}]) = 42, _
    "AS DYNAMIC param: read int from cross-FUNC tagged array")

' --- 3. mxFmt$ pattern: SQL-format with mixed array of map-fields ---
FUNC dyn_q$(v)
    IF TYPEOF(v) = "STRING" THEN RETURN "'" + v + "'"
    RETURN STR$(v)
ENDFUNC
FUNC dyn_fmt$(template$, params AS DYNAMIC)
    DIM out$ = ""
    DIM pidx AS INTEGER = 0
    DIM n AS INTEGER = LEN(template$)
    DIM ci AS INTEGER
    FOR ci = 0 TO n - 1
        DIM c$ = MID$(template$, ci, 1)
        IF c$ = "?" THEN
            out$ = out$ + dyn_q$(params[pidx])
            pidx = pidx + 1
        ELSE
            out$ = out$ + c$
        ENDIF
    NEXT ci
    RETURN out$
ENDFUNC
DIM dyn_sql$ = dyn_fmt$("INSERT t(n,a,e) VALUES (?,?,?)", _
    [dyn_meta{"name"}, dyn_meta{"age"}, dyn_meta{"email"}])
Assert(dyn_sql$ = "INSERT t(n,a,e) VALUES ('Anna',42,'anna@example.com')", _
    "AS DYNAMIC chained FUNC -> dyn_q$: string columns keep quotes, int stays bare")

' ══════════════════════════════════════════════════════════════════
' DIM AS MAP / ARRAY inside SUB — fresh instance per call
' Each invocation must allocate its own backing buffer so PUSHing into
' a shared array doesn't store N references to the same map.
' ══════════════════════════════════════════════════════════════════
Header("DIM AS MAP/ARRAY fresh instance")

DIM dim_state AS MAP
dim_state{"items"} = []

SUB dim_add(num)
    DIM arr = dim_state{"items"}
    DIM p AS MAP
    p{"pos"}  = num
    p{"name"} = "item " + STR$(num)
    PUSH arr, p
    dim_state{"items"} = arr
ENDSUB

dim_add(10)
dim_add(20)
DIM dim_items = dim_state{"items"}
Assert(LEN(dim_items) = 2, "DIM AS MAP fresh: array has 2 distinct entries")
Assert(dim_items[0]{"pos"} = 10, "DIM AS MAP fresh: entry[0].pos = 10 (not aliased to 20)")
Assert(dim_items[1]{"pos"} = 20, "DIM AS MAP fresh: entry[1].pos = 20")
Assert(dim_items[0]{"name"} = "item 10", "DIM AS MAP fresh: entry[0].name preserved")
Assert(dim_items[1]{"name"} = "item 20", "DIM AS MAP fresh: entry[1].name preserved")

' --- DIM AS ARRAY also gets a fresh instance per call ---
DIM dim_outer AS MAP
dim_outer{"rows"} = []
SUB dim_add_row(n)
    DIM o = dim_outer{"rows"}
    DIM r AS ARRAY = [n, n+1, n+2]
    PUSH o, r
    dim_outer{"rows"} = o
ENDSUB
dim_add_row(0)
dim_add_row(100)
Assert(LEN(dim_outer{"rows"}) = 2, "DIM AS ARRAY fresh: 2 distinct sub-arrays")
Assert(dim_outer{"rows"}[0][0] = 0,   "DIM AS ARRAY fresh: row 0 untouched by row 1")
Assert(dim_outer{"rows"}[1][0] = 100, "DIM AS ARRAY fresh: row 1 has its own data")

' ══════════════════════════════════════════════════════════════════
' Map-field assign on RUNTIME-tagged variable
' `p{"key"} = expr` must evaluate the RHS and persist the field even
' when p was read from an untyped array (i.e. the local slot is
' RUNTIME-tagged and the bits are a JdbMap*).
' ══════════════════════════════════════════════════════════════════
Header("RUNTIME-tagged var: p{key} = expr")

DIM rt_state AS MAP
rt_state{"items"} = []

' Seed the map's array via a SUB-local round-trip.
SUB rt_seed()
    DIM rt_inner = rt_state{"items"}
    DIM rt_p_init AS MAP
    rt_p_init{"pos"}  = 1
    rt_p_init{"name"} = "x"
    rt_p_init{"prc"}  = 0.0
    PUSH rt_inner, rt_p_init
    rt_state{"items"} = rt_inner
ENDSUB
rt_seed()

' Round-trip: read p from RUNTIME array, mutate, write back.
DIM rt_arr = rt_state{"items"}
DIM p = rt_arr[0]
p{"pos"}  = 99            ' int assign on RUNTIME-tagged var
p{"name"} = "edited"      ' string assign
p{"prc"}  = 12.5          ' double assign
rt_arr[0] = p
rt_state{"items"} = rt_arr

' Re-read and verify each field actually got persisted
DIM rt_check = rt_state{"items"}[0]
Assert(rt_check{"pos"}  = 99,       "RUNTIME map-set: int field persists")
Assert(rt_check{"name"} = "edited", "RUNTIME map-set: string field persists")
Assert(rt_check{"prc"}  = 12.5,     "RUNTIME map-set: double field persists")

' Side-effect on RHS must run — confirms the assignment isn't elided.
DIM rt_call_count AS INTEGER = 0
SUB rt_inc_count()
    rt_call_count = rt_call_count + 1
ENDSUB
DIM rt_p2 = rt_state{"items"}[0]
rt_inc_count()
rt_p2{"name"} = "after-call"
Assert(rt_call_count = 1, "RUNTIME map-set: code around p{} = ... runs (statement not elided)")
Assert(rt_p2{"name"} = "after-call", "RUNTIME map-set: assign after observable side-effect")

' ══════════════════════════════════════════════════════════════════
' PUSH on a map-field directly (`PUSH m{"key"}, val`)
' The appended array must be written back into the map and the
' string-elems flag must propagate so reads round-trip the type.
' ══════════════════════════════════════════════════════════════════
Header("PUSH on map field (write-back)")

DIM pmf_m AS MAP
pmf_m{"items"} = []
PUSH pmf_m{"items"}, 10
PUSH pmf_m{"items"}, 20
PUSH pmf_m{"items"}, 30
Assert(LEN(pmf_m{"items"}) = 3, "PUSH map{key}: 3 elements after 3 PUSHes")
Assert(pmf_m{"items"}[0] = 10, "PUSH map{key}: element 0 = 10")
Assert(pmf_m{"items"}[1] = 20, "PUSH map{key}: element 1 = 20")
Assert(pmf_m{"items"}[2] = 30, "PUSH map{key}: element 2 = 30")

DIM pmf_str AS MAP
pmf_str{"names"} = []
PUSH pmf_str{"names"}, "alice"
PUSH pmf_str{"names"}, "bob"
Assert(LEN(pmf_str{"names"}) = 2, "PUSH map{key} string: 2 elements")
Assert(pmf_str{"names"}[0] = "alice", "PUSH map{key} string: first preserved")
Assert(pmf_str{"names"}[1] = "bob",   "PUSH map{key} string: second preserved")

' ══════════════════════════════════════════════════════════════════
' FORMAT$ — full Python-style spec parity (interp ↔ native)
' [fill][align][width][.prec][#][type] all honoured.
' ══════════════════════════════════════════════════════════════════
Header("FORMAT$ Python-style spec parity")

Assert(FORMAT$("{:0>8}", 1)         = "00000001", "FORMAT$ pad zero right-align width 8")
Assert(FORMAT$("{:0>8}", STR$(1))   = "00000001", "FORMAT$ pad zero on a stringified int")
Assert(FORMAT$("{:.>8}", "x")       = ".......x", "FORMAT$ fill char + right-align")
Assert(FORMAT$("{:<8}",  "x")       = "x       ", "FORMAT$ left align")
Assert(FORMAT$("{:^7}",  "ab")      = "  ab   ",  "FORMAT$ center align")
Assert(FORMAT$("{:.2f}", 3.14159)   = "3.14",     "FORMAT$ fixed precision")
Assert(FORMAT$("{:5d}",  42)        = "   42",    "FORMAT$ width on int")
Assert(FORMAT$("{:#x}",  255)       = "0xff",     "FORMAT$ hex with hash flag")

' ══════════════════════════════════════════════════════════════════
' Nested string arrays, string operators, AS ARRAY / AS MAP slots
' (native parity — see feedback_native_nested_string_arrays)
' ══════════════════════════════════════════════════════════════════
Header("Nested strings + string ops + AS ARRAY/MAP")

DIM grid = [["a", "b"], ["c", "d"]]
Assert(grid[0][1] = "b", "nested string cell read grid[0][1]")
Assert(grid[1][0] = "c", "nested string cell read grid[1][0]")

DIM mixrow = [[1, "two"], [3, "four"]]
Assert(mixrow[1][1] = "four", "nested mixed-row string cell")
Assert(mixrow[0][0] = 1,      "nested mixed-row numeric cell")

Assert(("Atomi " * 2) = "Atomi Atomi ", "string * int repeat")
Assert((2 / "Atomi")  = "At",           "int / string slice (left)")
Assert(("Welcome" / 4) = "come",        "string / int slice (right)")
Assert(("ababababc" - "ab") = "c",      "string - string remove")
Assert(LEN(-"banana") = 6,              "unary minus char-split length")

DIM dyn_a AS ARRAY
dyn_a = [10, 20, 30]
Assert(LEN(dyn_a) = 3,  "DIM AS ARRAY then assign array")
Assert(dyn_a[2] = 30,   "DIM AS ARRAY index read")

DIM dyn_m AS MAP
dyn_m = {"k": 42}
Assert(dyn_m{"k"} = 42, "DIM AS MAP then assign map")

' ══════════════════════════════════════════════════════════════════
' HOFs over string arrays - native parity (SELECT string param/return,
' FILTER element-type preservation). See reference for the typed-param rule.
' ══════════════════════════════════════════════════════════════════
FUNC hsel_up$(s$)
  RETURN UCASE$(s$)
ENDFUNC
FUNC hsel_len(s$)
  RETURN LEN(s$)
ENDFUNC
FUNC hflt_long(s$)
  RETURN LEN(s$) > 1
ENDFUNC

Header("HOFs over string arrays")

DIM hof_words = ["aa", "b", "ccc"]
DIM hof_up = SELECT(hsel_up$@, hof_words)
Assert(hof_up[0] = "AA",  "SELECT string param+return [0]")
Assert(hof_up[2] = "CCC", "SELECT string param+return [2]")
DIM hof_ln = SELECT(hsel_len@, hof_words)
Assert(hof_ln[0] = 2, "SELECT string param numeric return [0]")
Assert(hof_ln[1] = 1, "SELECT string param numeric return [1]")
DIM hof_kept = FILTER(hflt_long@, hof_words)
Assert(LEN(hof_kept) = 2,   "FILTER over string array count")
Assert(hof_kept[0] = "aa",  "FILTER string element [0]")
Assert(hof_kept[1] = "ccc", "FILTER string element [1]")
DIM hof_nums = [10, 20, 30]
Assert(REDUCE(LAMBDA a, b -> a + b, hof_nums) = 60, "REDUCE numeric sum")

' ══════════════════════════════════════════════════════════════════
' RESULTS
' ══════════════════════════════════════════════════════════════════
PRINT ""
PRINT "══════════════════════════════════════════"
PRINT " COMPREHENSIVE TEST RESULTS"
PRINT "══════════════════════════════════════════"
PRINT " Sections: "; TOTAL_SECTIONS
PRINT " PASS:     "; PASS
PRINT " FAIL:     "; FAIL
PRINT "══════════════════════════════════════════"
IF FAIL = 0 THEN
  PRINT " ALL TESTS PASSED!"
ELSE
  PRINT " SOME TESTS FAILED!"
ENDIF
PRINT "══════════════════════════════════════════"
