EXPORT MODULE TEST_OUTER

IMPORT TEST_INNER

EXPORT DIM outer_secret = 777
EXPORT DIM outer_public = 888

EXPORT SUB INIT_OUTER()
    ' Use inner module from within outer
    TEST_INNER.ADD_THING 100, "from_outer"
    TEST_INNER.SET_PRIVATE 55
    outer_secret = 333
ENDSUB

EXPORT FUNC READ_INNER_PRIVATE()
    RETURN TEST_INNER.GET_PRIVATE()
ENDFUNC

EXPORT FUNC READ_OUTER_SECRET()
    RETURN outer_secret
ENDFUNC

EXPORT FUNC READ_INNER_THING_COUNT()
    RETURN TEST_INNER.GET_THING_COUNT()
ENDFUNC

EXPORT SUB ADD_VIA_OUTER(v, l$)
    TEST_INNER.ADD_THING v, l$
ENDSUB
