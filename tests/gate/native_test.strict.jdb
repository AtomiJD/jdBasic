OPTION "EXPLICIT"
OPTION "STRICT"

' ══════════════════════════════════════════════════════════════════
'  jdBasic Native Compiler Test Suite
'  Tests the features supported by the LLVM native compiler
' ══════════════════════════════════════════════════════════════════

DIM PASS = 0
DIM FAIL = 0

DIM test_num = 0
SUB Assert(N,cond)
    test_num = test_num + 1
    IF cond THEN
        PASS = PASS + 1
    ELSE
        PRINT "FAIL Test #";N
        FAIL = FAIL + 1
    ENDIF
ENDSUB

' ── 1. ARITHMETIC ────────────────────────────────────────────
PRINT "── Arithmetic ──"
Assert(2,2 + 3 = 5)
Assert(3,10 - 4 = 6)
Assert(4,3 * 7 = 21)
Assert(5,15 / 3 = 5)
Assert(6,17 MOD 5 = 2)
Assert(7,2 ^ 10 = 1024)
Assert(8,-5 + 10 = 5)

' ── 2. COMPARISONS ───────────────────────────────────────────
PRINT "── Comparisons ──"
Assert(9,5 > 3)
Assert(10,3 < 5)
Assert(11,5 >= 5)
Assert(12,5 <= 5)
Assert(13,5 = 5)
Assert(14,5 <> 3)

' ── 3. LOGIC ─────────────────────────────────────────────────
PRINT "── Logic ──"
Assert(15,1 AND 1)
Assert(16,1 OR 0)
Assert(17,NOT 0)
Assert(18,NOT (1 AND 0))

' ── 4. VARIABLES ─────────────────────────────────────────────
PRINT "── Variables ──"
DIM x = 42
Assert(19,x = 42)
x = x + 1
Assert(20,x = 43)
DIM y = 3.14
Assert(21,y > 3)

' ── 5. IF/ELSEIF/ELSE ────────────────────────────────────────
PRINT "── IF/ELSE ──"
DIM a = 10
IF a > 5 THEN
    Assert(22,1)
ELSE
    Assert(23,0)
ENDIF

IF a > 100 THEN
    Assert(24,0)
ELSEIF a > 5 THEN
    Assert(25,1)
ELSE
    Assert(26,0)
ENDIF

' ── 6. FOR LOOP ──────────────────────────────────────────────
PRINT "── FOR Loop ──"
DIM s = 0
FOR i = 1 TO 10
    s = s + i
NEXT i
Assert(27,s = 55)

DIM s2 = 0
FOR i = 0 TO 10 STEP 2
    s2 = s2 + i
NEXT i
Assert(28,s2 = 30)

' ── 7. DO LOOP ───────────────────────────────────────────────
PRINT "── DO Loop ──"
DIM c = 0
DO WHILE c < 5
    c = c + 1
LOOP
Assert(29,c = 5)

DIM d = 10
DO
    d = d - 1
LOOP UNTIL d = 5
Assert(30,d = 5)

' ── 8. FUNC/SUB ──────────────────────────────────────────────
PRINT "── FUNC/SUB ──"

FUNC Add(a, b)
    RETURN a + b
ENDFUNC

FUNC Factorial(n)
    IF n <= 1 THEN RETURN 1
    RETURN n * Factorial(n - 1)
ENDFUNC

Assert(31,Add(3, 7) = 10)
Assert(32,Factorial(5) = 120)
Assert(33,Factorial(10) = 3628800)

' ── 9. GLOBAL VARS IN FUNC ──────────────────────────────────
PRINT "── Globals in FUNC ──"
DIM counter = 0
SUB Increment()
    counter = counter + 1
ENDSUB
Increment
Increment
Increment
Assert(34,counter = 3)

' ── 10. ARRAYS ───────────────────────────────────────────────
PRINT "── Arrays ──"
DIM arr[5]
FOR i = 0 TO 4
    arr[i] = (i + 1) * 10
NEXT i
Assert(35,arr[0] = 10)
Assert(36,arr[4] = 50)
Assert(37,LEN(arr) = 5)

DIM b = IOTA(5)
Assert(38,b[0] = 1)
Assert(39,b[4] = 5)
Assert(40,SUM(b) = 15)

' ── 11. MATH BUILTINS ────────────────────────────────────────
PRINT "── Math ──"
Assert(41,ABS(-42) = 42)
Assert(42,SQR(144) = 12)
Assert(43,SIN(0) = 0)
Assert(44,COS(0) = 1)
Assert(45,INT(3.7) = 3)
Assert(46,ROUND(3.5) = 4)
Assert(47,FAC(7) = 5040)
Assert(48,SIGN(-5) = -1)

' ── 12. STRING OPS ───────────────────────────────────────────
PRINT "── Strings ──"
Assert(49,UPPER$("hello") = "HELLO")
Assert(50,LOWER$("WORLD") = "world")
Assert(51,LEFT$("Hello", 3) = "Hel")
Assert(52,RIGHT$("Hello", 3) = "llo")
Assert(53,MID$("Hello World", 6, 5) = "World")
Assert(54,LEN("test") = 4)
Assert(55,CHR$(65) = "A")
Assert(56,ASC("A") = 65)
Assert(57,INSTR("Hello World", "World") = 6)

' ── 13. STRING CONCAT ────────────────────────────────────────
PRINT "── String Concat ──"
Assert(58,"Hello" + " " + "World" = "Hello World")
Assert(59,"x=" + "42" = "x=42")

' ── 14. DATE/TIME ────────────────────────────────────────────
PRINT "── Date/Time ──"
DIM n = NOW()
Assert(60,YEAR(n) >= 2025)
Assert(61,MONTH(n) >= 1 AND MONTH(n) <= 12)

' ── 15. ARRAY OPS ────────────────────────────────────────────
PRINT "── Array Ops ──"
DIM v = IOTA(5)
Assert(62,MIN(v) = 1)
Assert(63,MAX(v) = 5)
Assert(64,MEAN(v) = 3)
