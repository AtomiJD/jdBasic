' ── 34. REGEX ────────────────────────────────────────────────
PRINT "── Regex ──"
' REGEX.MATCH(pattern$, text$) — entire-text match. Patterns must
' anchor or cover the whole string; the legacy underscore form
' REGEX_MATCH(text$, pattern$) does substring search instead.
Assert(130,REGEX.MATCH("[a-z0-9]+", "abc123"))
Assert(131,NOT REGEX.MATCH("^[0-9]+$", "abcdef"))
Assert(132,REGEX.REPLACE("[0-9]+", "Hello 2026", "XXXX") = "Hello XXXX")

