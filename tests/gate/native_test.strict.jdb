PRINT "── Codec ──"
DIM enc$ = CODEC.BASE64_ENCODE$("Hello")
Assert(68,enc$ = "SGVsbG8=")
DIM dec$ = CODEC.BASE64_DECODE$(enc$)
Assert(69,dec$ = "Hello")

