NEXT i
Assert(80,nested = 9)

' ── 26. FUNCTIONS ADVANCED ───────────────────────────────────
PRINT "── Functions Advanced ──"

FUNC Square(x)
    RETURN x * x
ENDFUNC

FUNC SumOfSquares(a, b)
    RETURN Square(a) + Square(b)
ENDFUNC

Assert(81,SumOfSquares(3, 4) = 25)

' SUB modifying globals
DIM sub_counter = 0
SUB CountUp(n)
    FOR ci = 1 TO n
        sub_counter = sub_counter + 1
    NEXT ci
ENDSUB
CountUp 5
Assert(82,sub_counter = 5)

