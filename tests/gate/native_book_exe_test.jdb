' Programs that print the same compiled and interpreted: an array element
' as a map literal value, an element of SORT over DIR$ inside an
' expression, a map function that answers a field of a JSON tree or a new
' map, an untaken IF that assigns a module result, and a cell of an array a
' function built, added to a string.

IMPORT NATIVE_BOOK_EXE_MOD

DIM passed = 0
DIM failed = 0

SUB Check(label$, actual$, expected$)
    IF actual$ = expected$ THEN
        passed = passed + 1
    ELSE
        failed = failed + 1
        PRINT "FAIL " + label$
        PRINT "  expected " + expected$
        PRINT "  got      " + actual$
    ENDIF
ENDSUB

FUNC Rows()
    RETURN [["a", "b"], ["c", "d"]]
ENDFUNC

' Map literal values read out of arrays
DIM r = Rows()
DIM h = r[0]
Check("a row of a function result", JOIN(h, ","), "a,b")
DIM m1 = {"h": r[0], "n": 5, "s": "x"}
Check("an element in a map literal", JOIN(m1{"h"}, ","), "a,b")
Check("the number beside it", STR$(m1{"n"} + 1), "6")
Check("the text beside it", m1{"s"}, "x")
DIM m2 = {"h": h}
Check("a variable holding the row", JOIN(m2{"h"}, ","), "a,b")
DIM grid = [["p", 1], ["q", 2]]
DIM m3 = {"row": grid[1], "num": grid[0][1], "txt": grid[1][0]}
Check("a row of a literal", JOIN(m3{"row"}, ","), "q,2")
Check("a number cell", STR$(m3{"num"} + 1), "2")
Check("a text cell", m3{"txt"}, "q")
DIM nums = [10, 20, 30]
DIM m4 = {"v": nums[2]}
Check("a plain number element", STR$(m4{"v"} + 1), "31")

' Elements of SORT(DIR$(...)) in expressions
DIM folder$ = PATH.JOIN$(GETENV$("TEMP"), "jdb_bookexe_" + STR$(TICK()))
MKDIR folder$
TXTWRITER PATH.JOIN$(folder$, "b.log"), "b"
TXTWRITER PATH.JOIN$(folder$, "a.log"), "a"
DIM files = SORT(DIR$(PATH.JOIN$(folder$, "*.log")))
Check("an element in PATH.JOIN$", PATH.BASENAME$(PATH.JOIN$(folder$, files[0])), "a.log")
Check("an element in a concatenation", RIGHT$(folder$ + "/" + files[1], 6), "/b.log")
DIM back = REVERSE(DIR$(PATH.JOIN$(folder$, "*.log")))
Check("REVERSE of DIR$", "x" + back[0], "x" + DIR$(PATH.JOIN$(folder$, "*.log"))[1])
KILL PATH.JOIN$(folder$, "a.log")
KILL PATH.JOIN$(folder$, "b.log")
RMDIR folder$

' A map function with two answers: a field of its parameter or a new map
FUNC Entry(state, name$)
    IF MAP.EXISTS(state, name$) THEN RETURN state{name$}
    DIM rec AS MAP
    rec{"runs"} = 0
    RETURN rec
ENDFUNC

FUNC Due$(state, at)
    DIM rec = Entry(state, "ok")
    IF NOT MAP.EXISTS(rec, "last_due") THEN RETURN "new"
    IF at <= rec{"last_due"} THEN RETURN "not due"
    RETURN "due"
ENDFUNC

DIM q$ = CHR$(34)
DIM state = JSON.PARSE$("{" + q$ + "ok" + q$ + ":{" + q$ + "last_due" + q$ + ":1000.5," + q$ + "runs" + q$ + ":1}}")
Check("a field of a JSON tree, earlier", Due$(state, 900), "not due")
Check("a field of a JSON tree, later", Due$(state, 1100), "due")
DIM fresh = JSON.PARSE$("{}")
Check("a new map", Due$(fresh, 1100), "new")
DIM got = Entry(state, "ok")
Check("its fields", STR$(got{"runs"}), "1")

' APPEND adds the maps of another array one by one: the function answers
' an array of maps, not rows
FUNC Groups(n)
    DIM out = []
    DIM k = 0
    FOR k = 1 TO n
        DIM part = []
        PUSH(part, {"size": k * 100, "name": "g" + STR$(k)})
        out = APPEND(out, part)
    NEXT k
    RETURN out
ENDFUNC
DIM groups = Groups(2)
DIM first_group = groups[0]
Check("APPEND keeps the maps flat", STR$(LEN(groups)), "2")
Check("a map read out of the result", STR$(first_group{"size"}), "100")
Check("its text field", groups[1]{"name"}, "g2")

' An untaken IF that would assign a module result
DIM cfg AS MAP
DIM rules = NATIVE_BOOK_EXE_MOD.DEFAULT_RULES("C:/x", "{name}")
DIM own = NATIVE_BOOK_EXE_MOD.VALUE(cfg, "rule", [])
IF LEN(own) > 0 THEN rules = own
Check("rules kept", STR$(LEN(rules)), "2")
Check("the first rule", rules[0]{"match"}, "*.csv")


' A cell of an array a function built, added to a string
FUNC Pushed()
    DIM o = []
    PUSH(o, "w")
    PUSH(o, 7)
    PUSH(o, TRUE)
    RETURN o
ENDFUNC

FUNC Labelled$(cells)
    DIM out$ = ""
    DIM p = 0
    FOR p = 0 TO LEN(cells) - 1
        out$ = out$ + "[" + cells[p] + "]"
    NEXT p
    RETURN out$
ENDFUNC

DIM cells = Pushed()
Check("a string cell before a string", cells[0] + " <a>", "w <a>")
Check("a string cell after a string", "<a> " + cells[0], "<a> w")
Check("a number cell before a string", cells[1] + "x", "7x")
Check("cells of a parameter", Labelled$(cells), "[w][7][TRUE]")
Check("a truth cell before a string", cells[2] + "!", "TRUE!")
DIM words = NATIVE_BOOK_EXE_MOD.WORDS(2)
Check("a cell of a module result", words[1] + " <b>", "w2 <b>")
Check("number cells still add", STR$(cells[1] + 1), "8")

FUNC ParsedCells()
    DIM q$ = CHR$(34)
    RETURN JSON.PARSE("[" + q$ + "a" + q$ + ", 2, {" + q$ + "k" + q$ + ": 1}]")
ENDFUNC

FUNC JoinedCells$()
    DIM c = ParsedCells()
    RETURN c[0] + "|" + c[1] + "|" + c[2]
ENDFUNC

Check("cells of a parsed JSON array", JoinedCells$(), "a|2|{" + CHR$(34) + "k" + CHR$(34) + ": 1}")

' A text cell handed to a parameter the callee only reads as a number.
FUNC AsWhole(n)
    RETURN CINT(n)
ENDFUNC

FUNC CellsToNumbers$(date$)
    DIM dotted = REGEX.FINDALL("^([0-9]+)\.([0-9]+)$", date$)
    DIM d = dotted[0]
    DIM nest = [["3", "5"]]
    DIM g = nest[0]
    DIM k = 1
    RETURN STR$(AsWhole(d[1])) + " " + STR$(AsWhole(g[1])) + " " + STR$(AsWhole(g[k]) * 2) + " " + STR$(AsWhole(nest[0][0]) + 1)
ENDFUNC

Check("a text cell into a number parameter", CellsToNumbers$("3.5"), "5 5 10 4")

' An array a function fills with PUSH from texts and numbers alike.
FUNC MixedRow(cells)
    DIM row = []
    DIM k = 0
    FOR k = 0 TO LEN(cells) - 1
        DIM cur$ = cells[k]
        IF cur$ = "1.5" THEN
            PUSH(row, VAL(cur$))
        ELSE
            PUSH(row, cur$)
        ENDIF
    NEXT k
    RETURN row
ENDFUNC

FUNC MixedText$(cells)
    DIM row = []
    DIM k = 0
    FOR k = 0 TO LEN(cells) - 1
        DIM cur$ = cells[k]
        IF cur$ = "1.5" THEN
            PUSH(row, VAL(cur$))
        ELSE
            PUSH(row, cur$)
        ENDIF
    NEXT k
    DIM first$ = row[0]
    RETURN first$ + "|" + STR$(row[0]) + "|" + row[1] + "|" + ("" + row[0])
ENDFUNC

Check("a number cell of a mixed local array read as text", MixedText$(["1.5", "b"]), "1.5|1.5|b|1.5")
Check("the text cell first", MixedText$(["b", "1.5"]), "b|b|1.5|b")
DIM mixed = MixedRow(["1.5", "b"])
Check("a mixed row handed back", STR$(mixed[0] + 1) + mixed[1], "2.5b")

' The truth of an array and of a match with a group.
DIM truths$ = ""
DIM probes = [[1], [0], [1, 0], ["a"], [""], [], ["15"]]
DIM p = 0
FOR p = 0 TO LEN(probes) - 1
    DIM probe = probes[p]
    IF probe THEN truths$ = truths$ + "T" ELSE truths$ = truths$ + "F"
NEXT p
Check("arrays in IF: every cell true, an empty one false", truths$, "TFFTFFT")
DIM matched$ = ""
IF REGEX.MATCH("^-?(0|[1-9][0-9]*)$", "15") THEN matched$ = "yes" ELSE matched$ = "no"
IF REGEX.MATCH("^-?(0|[1-9][0-9]*)$", "x") THEN matched$ = matched$ + " yes" ELSE matched$ = matched$ + " no"
Check("REGEX.MATCH with a group in IF, a hit and a miss", matched$, "yes no")

' A builtin that fails is named in the error text.
DIM csv_error$ = ""
TRY
    DIM nothing = CSVREADER("does_not_exist_book_test.csv", ",", TRUE)
CATCH
    csv_error$ = ERRMSG$
ENDTRY
Check("the failing builtin is named", csv_error$, "CSVREADER: Cannot open file: does_not_exist_book_test.csv")

PRINT ""
PRINT "NATIVE BOOK EXE TEST RESULTS"
PRINT "RESULTS: " + STR$(passed) + " passed, " + STR$(failed) + " failed"
IF failed = 0 THEN PRINT "ALL TESTS PASSED!"
