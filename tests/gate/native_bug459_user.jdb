' Import helper for native_bug459_test.jdb: a module that reaches
' NATIVE_BUG459_TABLES only through its own IMPORT.

EXPORT MODULE NATIVE_BUG459_USER
IMPORT NATIVE_BUG459_TABLES

DIM gGreeting$ = "hello"

EXPORT FUNC SPELL$(key$)
    RETURN gGreeting$ + " " + NATIVE_BUG459_TABLES.NAME$(key$)
ENDFUNC

EXPORT FUNC CODE_OF(key$)
    RETURN NATIVE_BUG459_TABLES.CODE(key$)
ENDFUNC

EXPORT FUNC FILLED_COUNT()
    RETURN NATIVE_BUG459_TABLES.FILLED()
ENDFUNC
