' CODEC.INFLATE$ on streams Python's zlib and gzip wrote, CODEC.DEFLATE$ round
' trips in every format and at every level, binary data with NUL bytes, the
' numeric CODEC.CRC32, and ZIP.WRITE compressing its entries.

OPTION "EXPLICIT"

DIM passed AS INTEGER = 0
DIM failed AS INTEGER = 0

SUB Check(label$, actual$, expected$)
    IF actual$ = expected$ THEN
        passed = passed + 1
    ELSE
        failed = failed + 1
        PRINT "FAIL " + label$
        IF LEN(expected$) < 200 THEN
            PRINT "  expected " + expected$
            PRINT "  got      " + actual$
        ENDIF
    ENDIF
ENDSUB

SUB Ok(label$, cond)
    IF cond THEN
        passed = passed + 1
    ELSE
        failed = failed + 1
        PRINT "FAIL " + label$
    ENDIF
ENDSUB

FUNC InflateDamaged$(data$)
    RETURN CODEC.INFLATE$(data$, "zlib")
ENDFUNC

FUNC InflateGzip$(data$)
    RETURN CODEC.INFLATE$(data$, "gzip")
ENDFUNC

' Nearly incompressible bytes: noise with a few short repeats mixed in, the
' mix a photograph has once it is already packed. A Lehmer generator drives
' it, whose modulus and products stay inside what a double holds exactly, so
' the bytes are the same on every machine.
FUNC Noise$(sd, size, run_every, run_len)
    DIM s = sd MOD 65537
    IF s = 0 THEN s = 1
    DIM out$ = ""
    DO WHILE LEN(out$) < size
        s = (s * 75 + 74) MOD 65537
        IF (s MOD run_every) = 0 ANDALSO LEN(out$) > 300 THEN
            s = (s * 75 + 74) MOD 65537
            DIM at = s MOD (LEN(out$) - 260)
            s = (s * 75 + 74) MOD 65537
            DIM n = 3 + (s MOD run_len)
            DIM i = 0
            FOR i = 0 TO n - 1
                IF LEN(out$) >= size THEN EXITFOR
                out$ = out$ + MID$(out$, at + i, 1)
            NEXT i
        ELSE
            s = (s * 75 + 74) MOD 65537
            out$ = out$ + CHR$(s MOD 256)
        ENDIF
    LOOP
    RETURN out$
ENDFUNC

' One round trip, 1 when the bytes come back whole. A stream no decoder
' accepts makes CODEC.INFLATE$ raise, which counts as a failed trip rather
' than ending the run.
FUNC Trip(d$ AS STRING, level AS INTEGER, fmt$ AS STRING) AS INTEGER
    DIM ok AS INTEGER = 0
    TRY
        IF CODEC.INFLATE$(CODEC.DEFLATE$(d$, level, fmt$), fmt$) = d$ THEN ok = 1
    CATCH
        ok = 0
    ENDTRY
    RETURN ok
ENDFUNC

DIM text$ = REPEAT$("hello hello hello hello, jdBasic compresses this line ", 20)
Check("the sample text", STR$(LEN(text$)), "1080")

DIM from_zlib$ = CODEC.BASE64_DECODE$("eNrLSM3JyVfIQCd1FLJSnBKLM5MVkvNzC4pSi4tTixVKMjKLFXIy81Ix1Y/qGtU1qmsE6QIACt+MUA==")
Check("zlib written by Python", CODEC.INFLATE$(from_zlib$, "zlib"), text$)
Check("zlib recognised by its header", CODEC.INFLATE$(from_zlib$), text$)
DIM from_raw$ = CODEC.BASE64_DECODE$("K0osV0hJTctJLElVKC4pSk3M1VHIy1fISE1MSS0CAA==")
Check("raw deflate written by Python", CODEC.INFLATE$(from_raw$, "raw"), "raw deflate stream, no header")
DIM from_gzip$ = CODEC.BASE64_DECODE$("H4sIAAAAAAAC/0uvyixQyE3NTUotUijPLMlQSFTIS8xN1U0rSk1VyEhNTEktAgDExwq0IwAAAA==")
Check("gzip written by Python", CODEC.INFLATE$(from_gzip$, "gzip"), "gzip member with a name-free header")
Check("gzip recognised by its magic", CODEC.INFLATE$(from_gzip$), "gzip member with a name-free header")

DIM formats = ["zlib", "gzip", "raw"]
DIM levels = [0, 1, 6, 9]
DIM trips AS INTEGER = 0
DIM f AS INTEGER = 0
DIM l AS INTEGER = 0
FOR f = 0 TO 2
    DIM fmt$ = formats[f]
    FOR l = 0 TO 3
        DIM level = levels[l]
        DIM packed$ = CODEC.DEFLATE$(text$, level, fmt$)
        IF CODEC.INFLATE$(packed$, fmt$) = text$ THEN trips = trips + 1
    NEXT l
NEXT f
Check("twelve round trips, three formats at four levels", STR$(trips), "12")
DIM best$ = CODEC.DEFLATE$(text$, 9)
Ok("level 9 shrinks repeated text below a fifth", LEN(best$) < 216)
Ok("the default format is zlib", BYTEAT(best$, 0) = 120)
Check("level 0 stores the bytes", STR$(LEN(CODEC.DEFLATE$(text$, 0, "raw"))), "1085")
Check("an empty string", CODEC.INFLATE$(CODEC.DEFLATE$("")), "")

DIM noise$ = CODEC.RANDOMBYTES$(50000)
DIM noise_packed$ = CODEC.DEFLATE$(noise$, 6, "gzip")
Ok("random bytes come back whole", CODEC.INFLATE$(noise_packed$) = noise$)
Ok("with NUL bytes inside", INSTR(noise$, CHR$(0)) >= 0)
Ok("and hardly grow", LEN(noise_packed$) < 50100)

DIM good$ = CODEC.DEFLATE$(text$, 6, "zlib")
DIM last_byte AS INTEGER = BYTEAT(good$, LEN(good$) - 1)
DIM damaged$ = LEFT$(good$, LEN(good$) - 1) + CHR$((last_byte + 1) MOD 256)
DIM refused AS INTEGER = 0
TRY
    DIM bad$ = InflateDamaged$(damaged$)
CATCH
    refused = refused + 1
ENDTRY
Check("a wrong checksum is refused", STR$(refused), "1")

DIM hello_gz$ = CODEC.DEFLATE$("hello", 6, "gzip")
DIM two_members$ = hello_gz$ + CODEC.DEFLATE$(" world", 6, "gzip")
Check("two gzip members read as one", CODEC.INFLATE$(two_members$, "gzip"), "hello world")
Check("two members found by the magic", CODEC.INFLATE$(two_members$), "hello world")
Check("zero padding after the last member", CODEC.INFLATE$(hello_gz$ + CHR$(0) + CHR$(0) + CHR$(0), "gzip"), "hello")
Check("zlib followed by more bytes", CODEC.INFLATE$(CODEC.DEFLATE$("hello", 6, "zlib") + "tail", "zlib"), "hello")
DIM tail_msg$ = ""
TRY
    DIM tail_out$ = InflateGzip$(hello_gz$ + "xyz")
CATCH
    tail_msg$ = ERRMSG$
ENDTRY
Ok("other trailing data is refused", INSTR(tail_msg$, "trailing data") >= 0)
Ok("the message names the function once", INSTR(tail_msg$, "INFLATE$: CODEC.INFLATE$") < 0)

' Such a block drives the code length alphabet past its seven bit cap, and
' the repair that brings the lengths back under it decides whether the
' stream can be read at all. Both sizes below made an encoder that repaired
' too little write a stream no decoder accepts, at every level.
DIM rough_a$ = Noise$(4, 2000, 10, 16)
DIM rough_b$ = Noise$(39, 2000, 6, 8)
DIM rough_want$ = "e58b3cecf6ff8fdb8fa6805cba552978d763db920852024a74922ac8e0a064f1 " + _
                  "18186968f9de73f74967a92aea6aab7236d3266571439b91f1b14c914185ccb7"
Check("the generator makes the same bytes on every machine", _
      CODEC.SHA256$(rough_a$) + " " + CODEC.SHA256$(rough_b$), rough_want$)
DIM rough_trips AS INTEGER = 0
DIM rough_fmt AS INTEGER = 0
DIM rough_level AS INTEGER = 0
FOR rough_fmt = 0 TO 2
    DIM rough_name$ = formats[rough_fmt]
    FOR rough_level = 0 TO 9
        rough_trips = rough_trips + Trip(rough_a$, rough_level, rough_name$)
        rough_trips = rough_trips + Trip(rough_b$, rough_level, rough_name$)
    NEXT rough_level
NEXT rough_fmt
Check("sixty round trips of near incompressible data", STR$(rough_trips), "60")

' Around that size too, so a change that moves the block boundaries is
' caught as well.
DIM rough_sizes AS INTEGER = 0
DIM rough_n AS INTEGER = 0
FOR rough_n = 1800 TO 2200 STEP 100
    DIM part$ = Noise$(4, rough_n, 10, 16)
    rough_sizes = rough_sizes + Trip(part$, 6, "raw")
NEXT rough_n
Check("five sizes around it", STR$(rough_sizes), "5")

Check("CRC32 as a number", STR$(CLNG(CODEC.CRC32("123456789"))), "3421780262")
Check("CRC32 over two pieces", STR$(CLNG(CODEC.CRC32("6789", CODEC.CRC32("12345")))), "3421780262")

DIM zip_path$ = MKTEMP$("jdbzip") + ".zip"
DIM entries = {"text.txt": text$, "noise.bin": noise$, "rough.bin": rough_a$}
DIM written = ZIP.WRITE(zip_path$, entries)
DIM back = ZIP.READ(zip_path$)
DIM back_text$ = back{"text.txt"}
DIM back_noise$ = back{"noise.bin"}
DIM back_rough$ = back{"rough.bin"}
Ok("ZIP.READ gets every entry back", back_text$ = text$ ANDALSO back_noise$ = noise$ ANDALSO back_rough$ = rough_a$)
Ok("the text entry was compressed", FILE.SIZE(zip_path$) < 53100)
KILL zip_path$

PRINT ""
PRINT "CODEC DEFLATE TEST RESULTS"
PRINT "RESULTS: " + STR$(passed) + " passed, " + STR$(failed) + " failed"
IF failed = 0 THEN PRINT "ALL TESTS PASSED!"
