' Phase 4: STRICT should accept these well-typed programs.
OPTION "EXPLICIT"
OPTION "STRICT"

DIM a AS INTEGER = 10
DIM b AS INTEGER = 20
DIM s AS STRING = "hello"
DIM f AS DOUBLE = 3.14

a = b + 5
s = s + " world"
f = f * 2

' Numeric widening: INTEGER into DOUBLE is fine.
f = a

PRINT "a="; a
PRINT "s="; s
PRINT "f="; f
