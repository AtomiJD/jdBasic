text$ = "Spiel wird beendet. Ungespeicherter Fortschritt geht verloren!"

box_w = 600
margin = 16
FS = 16
char_w = INT(FS * 0.65)
max_w = box_w - margin * 2
chars_per_line = INT(max_w / char_w)
IF chars_per_line < 10 THEN chars_per_line = 40

PRINT "chars_per_line="; chars_per_line

line_start = 0

PRINT "sum="; line_start + chars_per_line

iter = 0
FOR j = line_start + chars_per_line TO line_start STEP -1
    iter = iter + 1
    IF iter <= 5 THEN PRINT "j="; j
    IF iter > 200 THEN
        PRINT "INFINITE at j="; j
        END
    ENDIF
    c$ = MID$(text$, j, 1)
    IF c$ = " " THEN
        PRINT "space at j="; j
        EXITFOR
    ENDIF
NEXT j

PRINT "DONE iter="; iter
