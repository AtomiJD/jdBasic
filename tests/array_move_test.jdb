' ROTATE, SHIFT and index-gather, checked against a scalar reference.
'
'   jdbasic tests/array_move_test.jdb
'
' Nothing here compares against a hand-typed expectation. Every case builds
' what the answer has to be one element at a time, with plain loops and no
' array builtin involved, and holds the builtin to it. The contract being
' checked is:
'
'   ROTATE(a, s)[i] = a[(i + s) mod n]        cyclic, every axis
'   SHIFT(a, s, f)[i] = a[i - s] in range, f outside
'
' The two differ in sign on purpose and always have: ROTATE pulls from ahead
' the way APL rotates, SHIFT pushes along the way a shift register does. Both
' conventions are load-bearing for existing programs, so the reference keeps
' them apart instead of unifying them.

DIM pass = 0
DIM fail = 0
DIM report$ = []

SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$
        PRINT "      ist  "; got$
        PRINT "      soll "; want$
        report$ = APPEND(report$, [what$])
    ENDIF
ENDSUB

' A matrix as one comparable string, so a mismatch shows the whole shape.
FUNC FLAT$(m, rows, cols)
    DIM s$ = ""
    DIM r
    DIM c
    FOR r = 0 TO rows - 1
        FOR c = 0 TO cols - 1
            s$ = s$ + STR$(m[r][c]) + " "
        NEXT c
        IF r < rows - 1 THEN s$ = s$ + "| "
    NEXT r
    RETURN s$
ENDFUNC

FUNC FLATV$(v, n)
    DIM s$ = ""
    DIM i
    FOR i = 0 TO n - 1
        s$ = s$ + STR$(v[i]) + " "
    NEXT i
    RETURN s$
ENDFUNC

FUNC GRID(rows, cols)
    RETURN RESHAPE(IOTA(rows * cols), [rows, cols])
ENDFUNC

' The reference, element by element. No array operation appears in here.
FUNC REFROT(m, rows, cols, dr, dc)
    DIM out = RESHAPE([0], [rows, cols])
    DIM r
    DIM c
    FOR r = 0 TO rows - 1
        FOR c = 0 TO cols - 1
            DIM sr = (r + dr) MOD rows
            DIM sc = (c + dc) MOD cols
            IF sr < 0 THEN sr = sr + rows
            IF sc < 0 THEN sc = sc + cols
            out[r][c] = m[sr][sc]
        NEXT c
    NEXT r
    RETURN out
ENDFUNC

FUNC REFSHIFT(m, rows, cols, dr, dc, fillv)
    DIM out = RESHAPE([0], [rows, cols])
    DIM r
    DIM c
    FOR r = 0 TO rows - 1
        FOR c = 0 TO cols - 1
            DIM sr = r - dr
            DIM sc = c - dc
            IF sr >= 0 ANDALSO sr < rows ANDALSO sc >= 0 ANDALSO sc < cols THEN
                out[r][c] = m[sr][sc]
            ELSE
                out[r][c] = fillv
            ENDIF
        NEXT c
    NEXT r
    RETURN out
ENDFUNC

' Whether a result holds the same multiset of values as the input. A mover
' that invents or duplicates an element fails here even when the layout looks
' plausible.
FUNC SAMEBAG(a, b, rows, cols)
    DIM na = 0
    DIM nb = 0
    DIM r
    DIM c
    DIM v
    FOR v = 1 TO rows * cols
        na = 0
        nb = 0
        FOR r = 0 TO rows - 1
            FOR c = 0 TO cols - 1
                IF a[r][c] = v THEN na = na + 1
                IF b[r][c] = v THEN nb = nb + 1
            NEXT c
        NEXT r
        IF na <> nb THEN RETURN 0
    NEXT v
    RETURN 1
ENDFUNC

SUB ROTCASE(rows, cols, dr, dc)
    DIM m = GRID(rows, cols)
    DIM want = REFROT(m, rows, cols, dr, dc)
    DIM got = ROTATE(m, [dr, dc])
    DIM label$ = "ROTATE " + STR$(rows) + "x" + STR$(cols) + " um [" _
        + STR$(dr) + "," + STR$(dc) + "]"
    CHECK(label$, FLAT$(got, rows, cols), FLAT$(want, rows, cols))
ENDSUB

' A result that is not the shape it went in as cannot even be compared, so it
' is reported as that rather than taking the run down with it.
SUB SHIFTCASE(rows, cols, dr, dc, fillv)
    DIM m = GRID(rows, cols)
    DIM want = REFSHIFT(m, rows, cols, dr, dc, fillv)
    DIM label$ = "SHIFT " + STR$(rows) + "x" + STR$(cols) + " um [" _
        + STR$(dr) + "," + STR$(dc) + "] fuellt " + STR$(fillv)
    DIM got$ = "?"
    TRY
        DIM got = SHIFT(m, [dr, dc], fillv)
        got$ = FLAT$(got, rows, cols)
    CATCH
        got$ = "kein " + STR$(rows) + "x" + STR$(cols) + " Ergebnis"
    ENDTRY
    CHECK(label$, got$, FLAT$(want, rows, cols))
ENDSUB

PRINT ""
PRINT "=== ROTATE: zyklisch, jede Achse ==="
PRINT ""

' the row axis, which has always worked - if these fail the reference is wrong
ROTCASE(3, 3, 1, 0)
ROTCASE(3, 3, -1, 0)
ROTCASE(3, 3, 0, 0)
ROTCASE(3, 3, 2, 0)
ROTCASE(3, 3, 3, 0)
ROTCASE(3, 3, 4, 0)

' the column axis
ROTCASE(3, 3, 0, 1)
ROTCASE(3, 3, 0, -1)
ROTCASE(3, 3, 0, 2)
ROTCASE(3, 3, 0, 3)
ROTCASE(3, 3, 0, 4)

' both at once
ROTCASE(3, 3, 1, 1)
ROTCASE(3, 3, -1, 1)
ROTCASE(3, 3, 2, -2)

' not square, in both orientations, because a flat-buffer bug hides on squares
ROTCASE(2, 5, 1, 0)
ROTCASE(2, 5, 0, 1)
ROTCASE(2, 5, 0, 2)
ROTCASE(2, 5, 1, 3)
ROTCASE(5, 2, 0, 1)
ROTCASE(5, 2, 2, 0)
ROTCASE(5, 2, 3, 1)

' bigger, in case a small case is special-cased somewhere
ROTCASE(6, 7, 0, 3)
ROTCASE(6, 7, 4, 0)
ROTCASE(6, 7, 2, 5)

PRINT ""
PRINT "=== ROTATE erhaelt den Inhalt ==="
PRINT ""

DIM bagm = GRID(4, 6)
CHECK("nichts geht verloren, nichts kommt dazu", _
    STR$(SAMEBAG(ROTATE(bagm, [1, 2]), bagm, 4, 6)), "1")

PRINT ""
PRINT "=== ROTATE auf einem Vektor ==="
PRINT ""

DIM v5 = IOTA(5)
DIM wantv$ = "2 3 4 5 1 "
DIM gotv$ = "?"
TRY
    gotv$ = FLATV$(ROTATE(v5, [1]), 5)
CATCH
    gotv$ = "wirft"
ENDTRY
CHECK("ROTATE Vektor um [1]", gotv$, wantv$)

PRINT ""
PRINT "=== SHIFT: was ueberhaupt zurueckkommt ==="
PRINT ""

' Before any value can be judged, the shape has to survive. This one reports
' rather than asserts, because it is the thing that has to be understood first.
DIM probe = GRID(3, 3)
DIM sp = SHIFT(probe, [1, 0], 0)
DIM outer = LEN(sp)
DIM inner$ = "kein Untergitter"
TRY
    inner$ = STR$(LEN(sp[0]))
CATCH
    inner$ = "kein Untergitter"
ENDTRY
PRINT "SHIFT(3x3, [1,0], 0) hat "; outer; " Zeilen, Zeile 0 hat "; inner$
CHECK("SHIFT liefert wieder ein 3x3", inner$, "3")

PRINT ""
PRINT "=== SHIFT: nicht zyklisch, mit Fuellwert ==="
PRINT ""

SHIFTCASE(3, 3, 1, 0, 0)
SHIFTCASE(3, 3, -1, 0, 0)
SHIFTCASE(3, 3, 0, 0, 0)
SHIFTCASE(3, 3, 0, 1, 0)
SHIFTCASE(3, 3, 0, -1, 0)
SHIFTCASE(3, 3, 1, 1, 0)
SHIFTCASE(3, 3, -1, -1, 0)

' a shift past the edge has to leave nothing but fill
SHIFTCASE(3, 3, 3, 0, 0)
SHIFTCASE(3, 3, 0, 3, 0)
SHIFTCASE(3, 3, 9, 0, -1)
SHIFTCASE(3, 3, 0, -9, -1)

' a fill value that is not zero, so a lazily zeroed buffer shows up
SHIFTCASE(3, 3, 1, 0, 99)
SHIFTCASE(3, 3, 0, 1, 99)
SHIFTCASE(4, 4, -2, 1, 7)

' not square
SHIFTCASE(2, 5, 1, 0, 0)
SHIFTCASE(2, 5, 0, 1, 0)
SHIFTCASE(5, 2, 0, 1, 0)
SHIFTCASE(5, 2, 2, 0, 0)
SHIFTCASE(6, 7, 2, 3, 0)

PRINT ""
PRINT "=== SHIFT erfindet nichts ==="
PRINT ""

' Every value in the result is either a fill or came from the input at most as
' often as it appears there. The observed 2D behaviour repeats input elements,
' which is what this catches.
DIM sm = GRID(3, 3)
DIM sg = SHIFT(sm, [1, 0], 0)
DIM dupes = 0
DIM vv
FOR vv = 1 TO 9
    DIM nseen = 0
    DIM rr
    FOR rr = 0 TO LEN(sg) - 1
        TRY
            DIM cc
            FOR cc = 0 TO LEN(sg[rr]) - 1
                IF sg[rr][cc] = vv THEN nseen = nseen + 1
            NEXT cc
        CATCH
            IF sg[rr] = vv THEN nseen = nseen + 1
        ENDTRY
    NEXT rr
    IF nseen > 1 THEN dupes = dupes + 1
NEXT vv
CHECK("kein Element kommt doppelt zurueck", STR$(dupes), "0")

PRINT ""
PRINT "=== SHIFT auf einem Vektor, mit seinem eigenen Vorzeichen ==="
PRINT ""

CHECK("SHIFT Vektor um [1]", FLATV$(SHIFT([1, 2, 3, 4, 5], [1], 0), 5), "0 1 2 3 4 ")
CHECK("SHIFT Vektor um [-1]", FLATV$(SHIFT([1, 2, 3, 4, 5], [-1], 0), 5), "2 3 4 5 0 ")
CHECK("SHIFT Vektor um [0]", FLATV$(SHIFT([1, 2, 3, 4, 5], [0], 0), 5), "1 2 3 4 5 ")
CHECK("SHIFT Vektor ueber den Rand", FLATV$(SHIFT([1, 2, 3], [5], -1), 3), "-1 -1 -1 ")
CHECK("SHIFT Vektor als Skalar statt Vektor", FLATV$(SHIFT([1, 2, 3, 4, 5], 1, 0), 5), "0 1 2 3 4 ")
CHECK("und ROTATE zieht in die andere Richtung", _
    FLATV$(ROTATE([1, 2, 3, 4, 5], [1]), 5), "2 3 4 5 1 ")

PRINT ""
PRINT "=== zu viele Achsen werden abgelehnt ==="
PRINT ""

DIM toomany$ = "kein Fehler"
TRY
    DIM bad = ROTATE([1, 2, 3], [1, 1])
CATCH
    toomany$ = "wirft"
ENDTRY
CHECK("ROTATE mit 2 Achsen auf einem Vektor", toomany$, "wirft")

DIM toomany2$ = "kein Fehler"
TRY
    DIM bad2 = SHIFT(GRID(3, 3), [1, 1, 1], 0)
CATCH
    toomany2$ = "wirft"
ENDTRY
CHECK("SHIFT mit 3 Achsen auf einer Matrix", toomany2$, "wirft")

PRINT ""
PRINT "=== Indizieren mit einer Index-Menge ==="
PRINT ""

DIM pal = [100, 200, 300, 400]
DIM idxm = RESHAPE([0, 1, 2, 3, 3, 2, 1, 0, 1], [3, 3])
DIM wantg$ = "100 200 300 | 400 400 300 | 200 100 200 "
DIM gotg$ = "?"
TRY
    gotg$ = FLAT$(pal[idxm], 3, 3)
CATCH
    gotg$ = "wirft"
ENDTRY
' Either answer is defensible; the one thing that must not happen is a matrix
' of the first element, which is what a silent scalar coercion produces.
CHECK("Vektor mit Index-Matrix: sammelt oder wirft", gotg$, wantg$)

DIM idxv = [3, 1, 0]
DIM wantgv$ = "400 200 100 "
DIM gotgv$ = "?"
TRY
    gotgv$ = FLATV$(pal[idxv], 3)
CATCH
    gotgv$ = "wirft"
ENDTRY
CHECK("Vektor mit Index-Vektor: sammelt oder wirft", gotgv$, wantgv$)

' A gather out of range has to say so rather than fold to something plausible.
DIM oob$ = "kein Fehler"
TRY
    DIM bad3 = pal[RESHAPE([0, 1, 9, 2], [2, 2])]
CATCH
    oob$ = "wirft"
ENDTRY
CHECK("Index ausserhalb des Bereichs wirft", oob$, "wirft")

' Gathering whole rows out of a matrix: the elements collected are arrays, so
' this is the case where a shape-preserving gather could go wrong the other way.
DIM rowsrc = GRID(4, 3)
CHECK("Zeilen aus einer Matrix sammeln", FLAT$(rowsrc[[3, 0]], 2, 3), _
    "10 11 12 | 1 2 3 ")

PRINT ""
PRINT "=== TRANSPOSE, weil der Umweg darauf steht ==="
PRINT ""

DIM tm = GRID(2, 5)
DIM tt = TRANSPOSE(tm)
DIM tok = 1
DIM tr
DIM tc
FOR tr = 0 TO 1
    FOR tc = 0 TO 4
        IF tt[tc][tr] <> tm[tr][tc] THEN tok = 0
    NEXT tc
NEXT tr
CHECK("TRANSPOSE stimmt auf 2x5", STR$(tok), "1")
CHECK("  und der Spalten-Umweg liefert das Richtige", _
    FLAT$(TRANSPOSE(ROTATE(TRANSPOSE(tm), [1, 0])), 2, 5), _
    FLAT$(REFROT(tm, 2, 5, 0, 1), 2, 5))

PRINT ""
PRINT "array_move_test: bestanden "; pass; ", gefallen "; fail
IF fail > 0 THEN
    PRINT ""
    PRINT "Gefallen:"
    DIM fi
    FOR fi = 0 TO LEN(report$) - 1
        PRINT "  "; report$[fi]
    NEXT fi
ENDIF
