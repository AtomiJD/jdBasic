' Verify EVAL inside a function doesn't clobber locals
FUNC Calc(expression)
  PRINT "Expression: "; expression
  DIM r AS STRING = EVAL(expression)
  PRINT "Result: "; r
  PRINT "Expression after EVAL: "; expression
  RETURN STR$(r)
ENDFUNC

PRINT "--- Test EVAL preserves caller locals ---"
LET out = Calc("42 * 17")
PRINT "Returned: "; out

PRINT ""
PRINT "--- Test nested EVAL with concat ---"
FUNC Plus100(x)
  DIM y AS STRING = EVAL("100 + " + STR$(x))
  PRINT "Plus100 x="; x; " y="; y
  RETURN y
ENDFUNC
PRINT Plus100(5)

PRINT ""
PRINT "--- Test EVAL via funcref ---"
LET fr = Calc@
LET v = fr("3 + 4")
PRINT "fr returned: "; v


DIM failed AS INTEGER = 0
IF out <> "714" THEN
    PRINT "FAIL Calc returned "; out
    failed = failed + 1
ENDIF
IF Plus100(5) <> "105" THEN
    PRINT "FAIL Plus100"
    failed = failed + 1
ENDIF
IF v <> "7" THEN
    PRINT "FAIL funcref returned "; v
    failed = failed + 1
ENDIF
IF failed > 0 THEN END 1

PRINT ""
PRINT "All EVAL nesting tests OK"
