FUNC Calc(expression)
  DIM r AS STRING = EVAL(expression)
  RETURN STR(r)
ENDFUNC

FUNC OuterEval(x)
  PRINT "OuterEval entered, x="; x
  DIM y AS STRING = EVAL("100 + " + STR(x))
  PRINT "OuterEval y="; y
  RETURN y
ENDFUNC

PRINT "first call:"
PRINT Calc("42 * 17")

PRINT "second call:"
PRINT OuterEval(5)
