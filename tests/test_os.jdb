' ── OS.GETOS ───────────────────────────────────────
PRINT "=== OS ==="
PRINT "OS: "; OS.GETOS()

' ── OS.ARGS ───────────────────────────────────────
DIM cmdargs = OS.ARGS()
PRINT "Args ("; LEN(cmdargs); "): "; cmdargs

' ── OS.HOSTNAME$ ──────────────────────────────────
PRINT "Hostname: "; OS.HOSTNAME$()

' ── OS.EXEC ───────────────────────────────────────
PRINT ""
PRINT "=== OS.EXEC ==="
DIM result = OS.EXEC("echo Hello from shell")
PRINT "Exit code: "; result{"EXIT_CODE"}
PRINT "Output: "; TRIM$(result{"OUTPUT"})

' Dir listing (first 3 lines)
DIM dir_result = OS.EXEC("dir /b *.jdb")
DIM lines = SPLIT(TRIM$(dir_result{"OUTPUT"}), "\n")
PRINT "JDB files found: "; LEN(lines)

PRINT ""
PRINT "=== ALL TESTS PASSED ==="
