' The same properties, this time written in a .jdform instead of in code.
'
'   jdbasic tests/forms_jdform_test.jdb        (needs a FORMS build)
'
' A designer only ever writes the file, so what the file can carry is what a
' designer can offer. Everything below is read back through FORM.GET and
' photographed to tmp/forms_jdform.png.

DIM pass = 0
DIM fail = 0

SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  got ["; got$; "] want ["; want$; "]"
    ENDIF
ENDSUB

DIM frm = FORM.LOAD("tests/forms_jdform.jdform")
DIM got AS MAP = {}
DIM shot = 0

SUB JF_LOAD(e)
    shot = 1
ENDSUB

DIM tmr = FORM.TIMER(frm, "TT", 400)

SUB TT_TICK(e)
    IF shot = 1 THEN
        shot = 2
        DIM r = OS.SCREENSHOT("tmp/forms_jdform.png", "window", "jdform properties")
        PRINT "Screenshot: "; r; " (0 = written)"
        got{"formback"} = FORM.GET(frm, "BACKCOLOR")
        got{"fore"} = FORM.GET(FORM.FIND(frm, "L1"), "FORECOLOR")
        got{"maxlen"} = FORM.GET(FORM.FIND(frm, "PW"), "MAXLENGTH")
        got{"locked"} = FORM.GET(FORM.FIND(frm, "RO"), "LOCKED")
        got{"roback"} = FORM.GET(FORM.FIND(frm, "RO"), "BACKCOLOR")
        got{"tip"} = FORM.GET(FORM.FIND(frm, "B1"), "TOOLTIP")
        got{"tag"} = FORM.GET(FORM.FIND(frm, "B1"), "TAG")
        FORM.CLOSE(frm)
    ENDIF
ENDSUB

FORM.RUN(frm)

PRINT ""
CHECK("the form carries its colour from the file", STR$(got{"formback"}), "16775906")
CHECK("FORECOLOR from the file", STR$(got{"fore"}), "13369344")
CHECK("MAXLENGTH from the file", STR$(got{"maxlen"}), "8")
CHECK("LOCKED from the file", STR$(got{"locked"}), "TRUE")
CHECK("BACKCOLOR on the same field", STR$(got{"roback"}), "15132390")
CHECK("TOOLTIP from the file", "" + got{"tip"}, "Also from the file")
CHECK("TAG carries the map from the file", STR$(got{"tag"}{"n"}), "7")
CHECK("  and its text", "" + got{"tag"}{"kind"}, "from-file")

PRINT ""
PRINT "forms_jdform_test: " + STR$(pass) + " passed, " + STR$(fail) + " failed"
IF fail = 0 THEN PRINT "ALL FORMS JDFORM TESTS PASSED!"
