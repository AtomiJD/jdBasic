IMPORT TEST_FOLLOW_MOD

TEST_FOLLOW_MOD.INIT
PRINT "after INIT: hero="; TEST_FOLLOW_MOD.hero; " count="; TEST_FOLLOW_MOD.follow_count

TEST_FOLLOW_MOD.ADD_FOLLOWER 101
TEST_FOLLOW_MOD.UPDATE_POSITIONS

TEST_FOLLOW_MOD.ADD_FOLLOWER -1
TEST_FOLLOW_MOD.UPDATE_POSITIONS

TEST_FOLLOW_MOD.ADD_FOLLOWER 202
TEST_FOLLOW_MOD.UPDATE_POSITIONS

PRINT "DONE"
