EXTENDS Node2D

' Pure-jdBasic mini-game showcasing GODOT.INPUT.*.
'
' No GDScript wrapper. This .jdb IS the script. _ready / _process /
' _input / _draw are engine callbacks (Tier 3); GODOT.* + GODOT.INPUT.*
' do everything else (Tier 4 natives).
'
' Game rules:
'   WASD / arrows : move
'   Shift         : sprint (1.7x)
'   Space         : 80px dash in current direction (0.6s cooldown)
'   R             : reset world
'   E             : spawn an extra dot
'   LMB           : plant a flag at the cursor
'   Esc           : pause toggle

INSPECTOR DIM dot_target_init = 3   AS RANGE(1, 12, 1)
INSPECTOR DIM speed_base      = 220.0 AS RANGE(50.0, 500.0, 10.0)
INSPECTOR DIM sprint_mul      = 1.7   AS RANGE(1.0, 4.0, 0.1)

DIM self_h = 0
DIM hud_h  = 0
DIM hint_h = 0
DIM bg_h   = 0

' Game state.
DIM field_w = 1024.0
DIM field_h = 720.0
DIM player_x = 400.0
DIM player_y = 300.0
DIM player_vx = 0.0
DIM player_vy = 0.0
DIM player_radius = 20.0

DIM dots AS ARRAY = []
DIM dot_radius = 14.0
DIM dot_target = 3

DIM score = 0
DIM paused = FALSE
DIM dash_cooldown = 0.0
DIM dash_until = 0.0

DIM flag_x = -1.0
DIM flag_y = -1.0

DIM last_event = ""
DIM draw_tick = 0

DIM dash_speed = 720.0
DIM dash_dur   = 0.12
DIM dash_cool  = 0.6

' Godot key constants we actually use (Tier-3 jdBasic has no auto-import
' of Godot's Key enum, so spell them out here).
DIM KEY_ESCAPE = 4194305
DIM KEY_E      = 69
DIM KEY_R      = 82

SUB spawn_one_dot()
	DIM d AS MAP = {}
	d{"x"} = 40.0 + RND(1) * (field_w - 80.0)
	d{"y"} = 40.0 + RND(1) * (field_h - 80.0)
	dots = APPEND(dots, d)
ENDSUB

SUB reset_world()
	dots = []
	score = 0
	player_x = field_w / 2.0
	player_y = field_h / 2.0
	player_vx = 0.0
	player_vy = 0.0
	dash_cooldown = 0.0
	dash_until = 0.0
	paused = FALSE
	flag_x = -1.0
	flag_y = -1.0
	FOR i = 1 TO dot_target
		spawn_one_dot()
	NEXT
	last_event = "world reset"
ENDSUB

SUB _ready()
	self_h = GODOT.SELF()
	' Background lives on a CanvasLayer below Node2D so it doesn't
	' cover the _draw output; HUD lives on a CanvasLayer above it.
	hud_h  = GODOT.CALL(self_h, "get_node", "UILayer/HUD")
	hint_h = GODOT.CALL(self_h, "get_node", "UILayer/Hint")
	bg_h   = GODOT.CALL(self_h, "get_node", "BackgroundLayer/Background")

	field_w = 1024.0
	field_h = 720.0

	dot_target = dot_target_init
	GODOT.SET(hint_h, "text", "WASD: move    Shift: sprint    Space: dash    R: reset    E: spawn    LMB: flag    Esc: pause")
	reset_world()
ENDSUB

SUB tick_player(dt)
	IF dash_cooldown > 0.0 THEN dash_cooldown = dash_cooldown - dt
	IF dash_until > 0.0 THEN dash_until = dash_until - dt

	DIM mv = GODOT.INPUT.GET_VECTOR("move_left", "move_right", "move_up", "move_down")
	DIM mx = mv[0]
	DIM my = mv[1]

	DIM speed = speed_base
	IF GODOT.INPUT.IS_ACTION_PRESSED("sprint") THEN speed = speed * sprint_mul
	IF dash_until > 0.0 THEN speed = dash_speed

	IF GODOT.INPUT.IS_ACTION_JUST_PRESSED("dash") ANDALSO dash_cooldown <= 0.0 THEN
		IF mx <> 0.0 ORELSE my <> 0.0 THEN
			dash_until = dash_dur
			dash_cooldown = dash_cool
			last_event = "dash!"
		ENDIF
	ENDIF

	IF GODOT.INPUT.IS_ACTION_JUST_PRESSED("reset") THEN
		reset_world()
		RETURN
	ENDIF

	player_vx = mx * speed
	player_vy = my * speed
	player_x = player_x + player_vx * dt
	player_y = player_y + player_vy * dt

	IF player_x < player_radius THEN player_x = player_radius
	IF player_x > field_w - player_radius THEN player_x = field_w - player_radius
	IF player_y < player_radius THEN player_y = player_radius
	IF player_y > field_h - player_radius THEN player_y = field_h - player_radius
ENDSUB

SUB tick_pickups()
	DIM kept = []
	DIM picked = 0
	DIM hit_r = player_radius + dot_radius
	FOR i = 0 TO LEN(dots) - 1
		DIM d = dots[i]
		DIM dx = d{"x"} - player_x
		DIM dy = d{"y"} - player_y
		IF dx * dx + dy * dy <= hit_r * hit_r THEN
			picked = picked + 1
		ELSE
			kept = APPEND(kept, d)
		ENDIF
	NEXT
	dots = kept
	IF picked > 0 THEN
		score = score + picked
		last_event = "+" + STR$(picked) + " (score " + STR$(score) + ")"
	ENDIF
	DO WHILE LEN(dots) < dot_target
		spawn_one_dot()
	LOOP
ENDSUB

SUB update_hud()
	DIM mp = GODOT.INPUT.MOUSE_POSITION()
	DIM mx_i = INT(mp[0])
	DIM my_i = INT(mp[1])
	DIM flags = ""
	IF GODOT.INPUT.IS_ACTION_PRESSED("sprint") THEN flags = flags + "SPRINT "
	IF paused THEN flags = flags + "PAUSED "
	DIM txt = "Score: " + STR$(score) + "    " + flags + "   dash CD: " + STR$(dash_cooldown)
	txt = txt + CHR$(10) + "mouse: (" + STR$(mx_i) + ", " + STR$(my_i) + ")    last: " + last_event
	GODOT.SET(hud_h, "text", txt)
ENDSUB

SUB _process(delta)
	IF NOT paused THEN
		tick_player(delta)
		tick_pickups()
	ENDIF
	update_hud()
	GODOT.CALL(self_h, "queue_redraw")
ENDSUB

' Discrete-action handling. _input gets one InputEvent per fired event.
' We only react to the ones not covered by the polling actions above
' (Esc pause, E spawn, LMB plant flag). The event handle marshals as a
' Godot Object so GODOT.GET reads its fields.
SUB _input(event)
	DIM gdcls = GODOT.CALL(event, "get_class")
	IF gdcls = "InputEventKey" THEN
		DIM pressed = GODOT.GET(event, "pressed")
		DIM echo    = GODOT.GET(event, "echo")
		IF pressed ANDALSO NOT echo THEN
			DIM kc = GODOT.GET(event, "keycode")
			IF kc = KEY_ESCAPE THEN
				paused = NOT paused
				IF paused THEN
					last_event = "PAUSED (Esc to resume)"
				ELSE
					last_event = "resumed"
				ENDIF
			ELSEIF kc = KEY_E THEN
				spawn_one_dot()
				last_event = "extra dot spawned (now " + STR$(LEN(dots)) + ")"
			ENDIF
		ENDIF
	ELSEIF gdcls = "InputEventMouseButton" THEN
		IF GODOT.GET(event, "pressed") THEN
			DIM btn = GODOT.GET(event, "button_index")
			' MOUSE_BUTTON_LEFT == 1
			IF btn = 1 THEN
				DIM mp = GODOT.INPUT.MOUSE_POSITION()
				flag_x = mp[0]
				flag_y = mp[1]
				last_event = "flag planted at " + STR$(INT(flag_x)) + "," + STR$(INT(flag_y))
			ENDIF
		ENDIF
	ENDIF
ENDSUB

SUB _draw()
	' Use the explicit VEC2/COLOR builders. Plain `[x, y]` literals are
	' not always tagged as numeric arrays by the marshaller, so they
	' fall through to a generic Array and Godot's draw_* signatures
	' reject the typeless arg.

	' Dots first, so the player covers them when standing on top.
	DIM yellow      = GODOT.COLOR(1.0, 0.85, 0.3, 1.0)
	DIM yellow_core = GODOT.COLOR(1.0, 1.0, 0.6, 1.0)
	FOR i = 0 TO LEN(dots) - 1
		DIM d = dots[i]
		DIM c = GODOT.VEC2(d{"x"}, d{"y"})
		GODOT.CALL(self_h, "draw_circle", c, dot_radius, yellow)
		GODOT.CALL(self_h, "draw_circle", c, dot_radius * 0.45, yellow_core)
	NEXT

	' Player colour cycles by state.
	DIM player_col = GODOT.COLOR(0.45, 0.78, 1.0, 1.0)
	IF dash_until > 0.0 THEN
		player_col = GODOT.COLOR(1.0, 0.55, 0.3, 1.0)
	ELSEIF GODOT.INPUT.IS_ACTION_PRESSED("sprint") THEN
		player_col = GODOT.COLOR(0.55, 1.0, 0.55, 1.0)
	ENDIF
	DIM ppos = GODOT.VEC2(player_x, player_y)
	GODOT.CALL(self_h, "draw_circle", ppos, player_radius, player_col)

	' Direction indicator - a short line pointing in the way the
	' player is moving. Length tracks speed.
	IF player_vx <> 0.0 ORELSE player_vy <> 0.0 THEN
		DIM nose_x = player_x + player_vx * 0.08
		DIM nose_y = player_y + player_vy * 0.08
		DIM nose   = GODOT.VEC2(nose_x, nose_y)
		DIM dark   = GODOT.COLOR(0.0, 0.0, 0.0, 0.55)
		GODOT.CALL(self_h, "draw_line", ppos, nose, dark, 3.0)
	ENDIF

	' Mouse cursor + aim line.
	DIM mp = GODOT.INPUT.MOUSE_POSITION()
	DIM gdcursor = GODOT.VEC2(mp[0], mp[1])
	DIM faint  = GODOT.COLOR(0.7, 0.7, 0.9, 0.25)
	DIM cur_c  = GODOT.COLOR(0.9, 0.9, 1.0, 0.7)
	GODOT.CALL(self_h, "draw_line", ppos, gdcursor, faint, 1.0)
	GODOT.CALL(self_h, "draw_circle", gdcursor, 4.0, cur_c)

	' Planted flag (if any).
	IF flag_x >= 0.0 ANDALSO flag_y >= 0.0 THEN
		DIM pole_top = GODOT.VEC2(flag_x, flag_y - 18.0)
		DIM pole_bot = GODOT.VEC2(flag_x, flag_y + 4.0)
		DIM white    = GODOT.COLOR(1.0, 1.0, 1.0, 1.0)
		GODOT.CALL(self_h, "draw_line", pole_top, pole_bot, white, 2.0)
		' A small red triangle as the flag itself (3 line segments).
		DIM red = GODOT.COLOR(0.95, 0.25, 0.3, 1.0)
		DIM p1  = GODOT.VEC2(flag_x, flag_y - 18.0)
		DIM p2  = GODOT.VEC2(flag_x + 14.0, flag_y - 12.0)
		DIM p3  = GODOT.VEC2(flag_x, flag_y - 6.0)
		GODOT.CALL(self_h, "draw_line", p1, p2, red, 2.0)
		GODOT.CALL(self_h, "draw_line", p2, p3, red, 2.0)
		GODOT.CALL(self_h, "draw_line", p3, p1, red, 2.0)
	ENDIF
ENDSUB
