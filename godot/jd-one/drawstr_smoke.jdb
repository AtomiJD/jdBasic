EXTENDS Node2D

' Verifies the input-processing fix (is_processing_input must be TRUE once a
' script defines _input) plus GDX.DRAW_STRING / GDX.TEXT_SIZE.

DIM self_h = 0
DIM f = 0

SUB _ready()
	self_h = GDX.SELF()
	PRINT "processing_input=" + STR$(GDX.CALL(self_h, "is_processing_input"))
	DIM sz = GDX.TEXT_SIZE("Hello", 24)
	PRINT "text_size w=" + STR$(sz[0]) + " h=" + STR$(sz[1])
ENDSUB

SUB _input(event)
	PRINT "input " + GDX.CALL(event, "get_class")
ENDSUB

SUB _draw()
	DIM rc = GDX.DRAW_STRING(self_h, GDX.VEC2(0.0, 40.0), "centered", 1, 400.0, 24, GDX.COLOR(1.0, 1.0, 1.0, 1.0))
	IF f = 0 THEN PRINT "draw_string rc=" + STR$(rc)
ENDSUB

SUB _process(delta)
	GDX.CALL(self_h, "queue_redraw")
	f = f + 1
	IF f >= 3 THEN
		DIM tree = GDX.CALL(self_h, "get_tree")
		GDX.CALL(tree, "quit")
	ENDIF
ENDSUB
