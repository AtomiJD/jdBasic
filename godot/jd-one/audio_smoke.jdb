EXTENDS Node

' Headless check for GDX.AUDIO.*. The dummy audio driver won't make
' sound, but this confirms the stream loads, the player is created and
' parented, and PLAY/MUSIC/STOP return sane values without erroring.

DIM self_h = 0

SUB _ready()
	self_h = GDX.SELF()

	DIM sfx = GDX.AUDIO.PLAY("res://beep.wav", -6.0, 1.0)
	PRINT "SFX   handle=" + STR$(sfx) + " class=" + GDX.CALL(sfx, "get_class")

	DIM mus = GDX.AUDIO.MUSIC("res://beep.wav", -12.0)
	PRINT "MUSIC handle=" + STR$(mus) + " class=" + GDX.CALL(mus, "get_class")

	' A second MUSIC call must reuse the same player (swap track), not make
	' a new one - so the handle resolves to the same node.
	DIM mus2 = GDX.AUDIO.MUSIC("res://beep.wav")
	PRINT "MUSIC2 same=" + STR$(mus2 = mus)

	GDX.AUDIO.STOP_MUSIC()
	PRINT "stopped music"

	DIM tree_h = GDX.CALL(self_h, "get_tree")
	GDX.CALL(tree_h, "quit")
ENDSUB
