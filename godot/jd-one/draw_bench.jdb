EXTENDS Node2D

' Benchmark: GDX.CALL("draw_circle") vs the dedicated GDX.DRAW_CIRCLE.
' Both paths marshal the same args, so the delta is pure dispatch overhead
' (StringName interning + name-based method lookup) that the native skips.

DIM self_h = 0
DIM done = 0
DIM N = 60000

SUB _ready()
	self_h = GDX.SELF()
ENDSUB

SUB _draw()
	IF done = 1 THEN RETURN
	done = 1
	DIM c   = GDX.VEC2(100.0, 100.0)
	DIM col = GDX.COLOR(1.0, 0.5, 0.2, 1.0)

	DIM t0 = GDX.TIME_MS()
	FOR i = 1 TO N
		GDX.CALL(self_h, "draw_circle", c, 5.0, col)
	NEXT
	DIM t1 = GDX.TIME_MS()
	FOR i = 1 TO N
		GDX.DRAW_CIRCLE(self_h, c, 5.0, col)
	NEXT
	DIM t2 = GDX.TIME_MS()

	PRINT "N=" + STR$(N)
	PRINT "GDX.CALL draw_circle : " + STR$(t1 - t0) + " ms"
	PRINT "GDX.DRAW_CIRCLE      : " + STR$(t2 - t1) + " ms"

	DIM tree = GDX.CALL(self_h, "get_tree")
	GDX.CALL(tree, "quit")
ENDSUB

SUB _process(delta)
	GDX.CALL(self_h, "queue_redraw")
ENDSUB
