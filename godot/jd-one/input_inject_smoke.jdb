EXTENDS Node2D

' End-to-end headless proof of the mouse-click fix: build a synthetic left
' button press, push it through the viewport (passing the event object by
' GDX.REF), and confirm _input fires AND receives the event as a usable
' handle. Pushed via call_deferred so delivery happens outside the _process
' eval (no nested VM call - mirrors how Godot phases real input vs process).

DIM self_h = 0
DIM f = 0
DIM got = 0

SUB _ready()
	self_h = GDX.SELF()
	PRINT "processing_input=" + STR$(GDX.CALL(self_h, "is_processing_input"))
ENDSUB

SUB _input(event)
	DIM kind = GDX.CALL(event, "get_class")
	IF kind = "InputEventMouseButton" THEN
		got = got + 1
		PRINT "INPUT mouse pressed=" + STR$(GDX.GET(event, "pressed")) + " button=" + STR$(GDX.GET(event, "button_index"))
	ENDIF
ENDSUB

SUB _process(delta)
	f = f + 1
	IF f = 3 THEN
		DIM ev = GDX.NEW("InputEventMouseButton")
		GDX.SET(ev, "button_index", 1)
		GDX.SET(ev, "pressed", TRUE)
		DIM vp = GDX.CALL(self_h, "get_viewport")
		GDX.CALL(vp, "call_deferred", "push_input", GDX.REF(ev))
	ENDIF
	IF f >= 8 THEN
		PRINT "got_clicks=" + STR$(got)
		DIM tree = GDX.CALL(self_h, "get_tree")
		GDX.CALL(tree, "quit")
	ENDIF
ENDSUB
