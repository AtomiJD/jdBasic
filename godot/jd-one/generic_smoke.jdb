EXTENDS Node

' Headless check for GODOT.SINGLETON / GODOT.STATIC / GODOT.ENUM.

DIM self_h = 0

SUB _ready()
	self_h = GODOT.SELF()

	PRINT "ENUM Tween.TRANS_BACK = " + STR$(GODOT.ENUM("Tween", "TRANS_BACK"))

	DIM time_h = GODOT.SINGLETON("Time")
	PRINT "SINGLETON Time ticks = " + STR$(GODOT.CALL(time_h, "get_ticks_msec"))

	DIM src = GODOT.STATIC("FileAccess", "get_file_as_string", "res://breakout.jdb")
	PRINT "STATIC read breakout.jdb len=" + STR$(LEN(src)) + " head=" + LEFT$(src, 13)

	DIM tree = GODOT.CALL(self_h, "get_tree")
	GODOT.CALL(tree, "quit")
ENDSUB
