EXTENDS Node

' jdBasic live-coding music sequencer in Godot, powered by the SQ module.
' A CodeEdit holds SQ/SOUND commands; F5 EXECUTEs them in the running VM so the
' sequence changes live. SQ (drum kits, instruments, scales, euclidean rhythms)
' is imported from disk; sq_data.json and the Roland TR-808 sample set live next
' to this script and resolve against the project directory. The jdBasic SOUND
' engine renders (SOUND_DSP pull mode) into a Godot AudioStreamGenerator each
' frame - no audio device needed.

IMPORT SQ

' SQ keeps its sequencer state in these caller-side globals.
DIM CONFIG AS MAP
DIM SFX_CACHE AS MAP
DIM NEXT_SFX_ID AS INTEGER = 100

DIM self_h   = 0
DIM code_h   = 0
DIM status_h = 0
DIM mplayer  = 0
DIM playback = 0
DIM started  = FALSE
DIM rate     = 44100.0
DIM KEY_F5   = 4194336

DIM Q$  = CHR$(34)
DIM NL$ = CHR$(10)
DIM DEFAULT_CODE$ = ""

SUB build_default()
	DEFAULT_CODE$ = "' jdBasic Live Coder - edit, then press F5 to (re)run." + NL$
	DEFAULT_CODE$ = DEFAULT_CODE$ + "SOUND.BPM 120" + NL$
	DEFAULT_CODE$ = DEFAULT_CODE$ + "SQ.D(8, 8)" + NL$
	DEFAULT_CODE$ = DEFAULT_CODE$ + "SQ.V(4, " + Q$ + "TP" + Q$ + ")" + NL$
	DEFAULT_CODE$ = DEFAULT_CODE$ + "SQ.S(4, " + Q$ + "[c4 e4 g4] ~ [d4 f4 a4] ~ [e4 g4 b4] ~ [d4 f4 a4] ~" + Q$ + ")" + NL$
	DEFAULT_CODE$ = DEFAULT_CODE$ + "SQ.V(5, " + Q$ + "RB" + Q$ + ")" + NL$
	DEFAULT_CODE$ = DEFAULT_CODE$ + "SQ.S(5, " + Q$ + "c2 ~ c2 ~ g1 ~ a1 ~" + Q$ + ")"
ENDSUB

SUB setup_audio()
	DIM gen = GDX.NEW("AudioStreamGenerator")
	GDX.SET(gen, "mix_rate", rate)
	GDX.SET(gen, "buffer_length", 0.3)
	mplayer = GDX.NEW("AudioStreamPlayer")
	GDX.SET(mplayer, "stream", GDX.REF(gen))
	GDX.SET(mplayer, "bus", "Master")
	GDX.ADD_CHILD(self_h, mplayer)
ENDSUB

SUB setup_ui()
	DIM lay = GDX.NEW("CanvasLayer")
	GDX.ADD_CHILD(self_h, lay)

	status_h = GDX.NEW("Label")
	GDX.SET(status_h, "position", GDX.VEC2(16.0, 10.0))
	GDX.SET(status_h, "text", "jdBasic Live Coder   -   F5 = run   (SQ.D/V/S/SC/P + SOUND.*)")
	GDX.ADD_CHILD(lay, status_h)

	code_h = GDX.NEW("CodeEdit")
	GDX.SET(code_h, "position", GDX.VEC2(16.0, 44.0))
	GDX.SET(code_h, "size", GDX.VEC2(1000.0, 700.0))
	GDX.SET(code_h, "text", DEFAULT_CODE$)
	GDX.ADD_CHILD(lay, code_h)
	GDX.CALL(code_h, "grab_focus")
ENDSUB

SUB run_code()
	DIM src$ = GDX.GET(code_h, "text")
	TRY
		EXECUTE(src$)
		GDX.SET(status_h, "text", "Running   -   F5 to re-run")
	CATCH
		GDX.SET(status_h, "text", "Error - check the console output")
	ENDTRY
ENDSUB

SUB _ready()
	self_h = GDX.SELF()
	SQ.START()
	build_default()
	setup_audio()
	setup_ui()
	run_code()
	GDX.PRINT("livecoder ready")
ENDSUB

SUB _process(delta)
	IF NOT started THEN
		GDX.CALL(mplayer, "play")
		playback = GDX.CALL(mplayer, "get_stream_playback")
		started = TRUE
	ENDIF
	IF playback = 0 THEN RETURN
	DIM avail = GDX.CALL(playback, "get_frames_available")
	IF avail <= 0 THEN RETURN
	DIM buf = SOUND.RENDER(avail)
	GDX.CALL(playback, "push_buffer", GDX.PACKED_VEC2(buf))
ENDSUB

SUB _unhandled_input(event)
	IF GDX.CALL(event, "get_class") = "InputEventKey" THEN
		IF GDX.GET(event, "pressed") ANDALSO GDX.GET(event, "keycode") = KEY_F5 THEN
			run_code()
		ENDIF
	ENDIF
ENDSUB
