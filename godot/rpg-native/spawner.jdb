EXTENDS Node3D

' Data-driven world populator: reads npcs.json and chests.json, instantiates
' the npc.tscn / chest.tscn templates, sets each instance's properties, and
' adds it to the tree.

DIM self_h = 0

SUB spawn_npcs()
	DIM src = GDX.STATIC("FileAccess", "get_file_as_string", data_dir$() + "/npcs.json")
	DIM arr = JSON.PARSE$(src)
	DIM cnt = LEN(arr)
	FOR i = 0 TO cnt - 1
		DIM e = arr[i]
		DIM npc = GDX.INSTANTIATE("res://npc.tscn")
		GDX.SET(npc, "npc_id", e{"id"})
		GDX.SET(npc, "character_type", e{"character"})
		GDX.SET(npc, "display_name", e{"name"})
		' Drop in above the spawn point; gravity settles it onto the terrain.
		DIM sp = e{"spawn"}
		GDX.SET(npc, "position", GDX.VEC3(sp[0], 6.0, sp[2]))
		GDX.ADD_CHILD(self_h, npc)
	NEXT
	PRINT "spawned " + STR$(cnt) + " npcs"
ENDSUB

SUB spawn_chests()
	DIM src = GDX.STATIC("FileAccess", "get_file_as_string", data_dir$() + "/chests.json")
	DIM arr = JSON.PARSE$(src)
	FOR i = 0 TO LEN(arr) - 1
		DIM e = arr[i]
		DIM ch = GDX.INSTANTIATE("res://chest.tscn")
		GDX.SET(ch, "model", e{"model"})
		GDX.SET(ch, "label", e{"label"})
		DIM p = e{"pos"}
		GDX.SET(ch, "position", GDX.VEC3(p[0], 0.0, p[2]))
		GDX.ADD_CHILD(self_h, ch)
	NEXT
	PRINT "spawned " + STR$(LEN(arr)) + " chests"
ENDSUB

SUB _ready()
	self_h = GDX.SELF()
	spawn_npcs()
	spawn_chests()
ENDSUB

' Content-pack root (Project Settings -> Game -> data_dir). Flip to
' res://assets/data_ger for the German pirate theme.
FUNC data_dir$()
	RETURN GDX.CALL(GDX.SINGLETON("ProjectSettings"), "get_setting", "game/data_dir", "res://assets/data")
ENDFUNC
