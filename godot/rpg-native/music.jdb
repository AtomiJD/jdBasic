EXTENDS Node3D

' Runtime music: programs the jdBasic SOUND sequencer (voices, filters, reverb,
' mini-notation patterns) from music.json and pulls its rendered samples each
' frame into a Godot AudioStreamGenerator on a "Music" bus. The active theme
' follows the game state - dungeon interior, dialogue (tree paused), or open world.

DIM self_h   = 0
DIM player_h = 0
DIM dialog_h = 0
DIM mplayer  = 0
DIM playback = 0
DIM started  = FALSE
DIM rate     = 44100.0

DIM cur_theme = ""
DIM themes AS MAP = {}

DIM dun_x0 = 1.0
DIM dun_x1 = -1.0
DIM dun_z0 = 1.0
DIM dun_z1 = -1.0

SUB load_themes()
	DIM src = GODOT.STATIC("FileAccess", "get_file_as_string", "res://assets/data/music.json")
	DIM data = JSON.PARSE$(src)
	themes = data{"themes"}
ENDSUB

SUB set_theme(name)
	IF name = cur_theme THEN RETURN
	IF NOT MAP.EXISTS(themes, name) THEN RETURN
	cur_theme = name
	DIM t = themes{name}

	SOUND.RESET
	SOUND.INIT
	SOUND.BPM t{"bpm"}

	DIM mv = t{"melody_voice"}
	SOUND.VOICE 0, mv[0], mv[1], mv[2], mv[3], mv[4]
	SOUND.FILTER 0, t{"melody_filter"}
	SOUND.GAIN 0, t{"melody_gain"}

	DIM bv = t{"bass_voice"}
	SOUND.VOICE 1, bv[0], bv[1], bv[2], bv[3], bv[4]
	SOUND.FILTER 1, t{"bass_filter"}
	SOUND.GAIN 1, t{"bass_gain"}

	DIM rv = t{"reverb"}
	SOUND.REVERB rv[0], rv[1], rv[2], rv[3]
	SOUND.REVERBSEND 0, t{"reverb_send"}

	DIM melody = t{"melody"}
	DIM bass = t{"bass"}
	SOUND.NOTE "< " + melody + " , " + bass + " >", TRUE
ENDSUB

SUB load_dungeon_rect()
	DIM src = GODOT.STATIC("FileAccess", "get_file_as_string", "res://assets/data/dungeons.json")
	DIM all = JSON.PARSE$(src)
	IF LEN(all) = 0 THEN RETURN
	DIM spec = all[0]
	DIM org = spec{"origin"}
	DIM rooms = spec{"rooms"}
	DIM gw = 0
	DIM gh = 0
	FOR i = 0 TO LEN(rooms) - 1
		DIM rm = rooms[i]
		DIM re = INT(rm{"col"}) + INT(rm{"w"})
		DIM be = INT(rm{"row"}) + INT(rm{"h"})
		IF re > gw THEN gw = re
		IF be > gh THEN gh = be
	NEXT
	dun_x0 = org[0]
	dun_x1 = org[0] + (gw + 1) * 4.0
	dun_z0 = org[2]
	dun_z1 = org[2] + (gh + 1) * 4.0
ENDSUB

SUB setup_bus()
	DIM asrv = GODOT.SINGLETON("AudioServer")
	IF GODOT.CALL(asrv, "get_bus_index", "Music") < 0 THEN
		GODOT.CALL(asrv, "add_bus", -1)
		DIM idx = GODOT.CALL(asrv, "get_bus_count") - 1
		GODOT.CALL(asrv, "set_bus_name", idx, "Music")
	ENDIF
ENDSUB

FUNC want_theme()
	DIM tree = GODOT.CALL(self_h, "get_tree")
	IF GODOT.CALL(tree, "is_paused") THEN RETURN "dialog"
	IF player_h <> 0 ANDALSO dun_x1 > dun_x0 THEN
		DIM pp = GODOT.GET(player_h, "global_position")
		IF pp[0] > dun_x0 ANDALSO pp[0] < dun_x1 ANDALSO pp[2] > dun_z0 ANDALSO pp[2] < dun_z1 THEN RETURN "dungeon"
	ENDIF
	RETURN "explore"
ENDFUNC

SUB _ready()
	self_h = GODOT.SELF()
	GODOT.SET(self_h, "process_mode", 3)
	player_h = GODOT.CALL(self_h, "get_node", "../Player")
	dialog_h = GODOT.CALL(self_h, "get_node", "../DialogManager")

	SOUND.INIT
	load_themes()
	load_dungeon_rect()
	setup_bus()

	DIM gen = GODOT.NEW("AudioStreamGenerator")
	GODOT.SET(gen, "mix_rate", rate)
	GODOT.SET(gen, "buffer_length", 0.3)
	mplayer = GODOT.NEW("AudioStreamPlayer")
	GODOT.SET(mplayer, "stream", GODOT.REF(gen))
	GODOT.SET(mplayer, "bus", "Music")
	GODOT.ADD_CHILD(self_h, mplayer)
ENDSUB

SUB _process(delta)
	' Hold until the dialogue model has finished its blocking load.
	IF NOT started THEN
		IF dialog_h = 0 THEN RETURN
		IF NOT GODOT.CALL(dialog_h, "get_meta", "llm_ready", FALSE) THEN RETURN
		set_theme(want_theme())
		GODOT.CALL(mplayer, "play")
		playback = GODOT.CALL(mplayer, "get_stream_playback")
		started = TRUE
		PRINT "music: playback=" + STR$(playback)
	ENDIF
	IF playback = 0 THEN RETURN

	set_theme(want_theme())
	DIM avail = GODOT.CALL(playback, "get_frames_available")
	IF avail <= 0 THEN RETURN
	DIM buf = SOUND.RENDER(avail)
	GODOT.CALL(playback, "push_buffer", GODOT.PACKED_VEC2(buf))
ENDSUB
