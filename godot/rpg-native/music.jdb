EXTENDS Node3D

' Runtime music: programs the jdBasic SOUND sequencer (voices, filters, reverb,
' mini-notation patterns) from music.json and pulls its rendered samples each
' frame into a Godot AudioStreamGenerator on a "Music" bus. The active theme
' follows the game state - dungeon interior, dialogue (tree paused), or open world.

DIM self_h   = 0
DIM player_h = 0
DIM dialog_h = 0
DIM mplayer  = 0
DIM playback = 0
DIM started  = FALSE
DIM rate     = 44100.0

DIM cur_theme = ""
DIM themes AS MAP = {}

DIM dun_x0 = 1.0
DIM dun_x1 = -1.0
DIM dun_z0 = 1.0
DIM dun_z1 = -1.0

SUB load_themes()
	DIM src = GDX.STATIC("FileAccess", "get_file_as_string", "res://assets/data/music.json")
	DIM data = JSON.PARSE$(src)
	themes = data{"themes"}
ENDSUB

' Apply every optional per-track design field present in the theme, keyed
' "<prefix>_<field>". Arrays carry the multi-arg commands (e.g. fm:[amount,
' ratio], unison:[voices,detune,spread]).
SUB apply_fx(track, t, prefix)
	DIM a AS ARRAY = []
	IF MAP.EXISTS(t, prefix + "_filter") THEN SOUND.FILTER track, t{prefix + "_filter"}
	IF MAP.EXISTS(t, prefix + "_gain") THEN SOUND.GAIN track, t{prefix + "_gain"}
	IF MAP.EXISTS(t, prefix + "_pan") THEN SOUND.PAN track, t{prefix + "_pan"}
	IF MAP.EXISTS(t, prefix + "_reverb_send") THEN SOUND.REVERBSEND track, t{prefix + "_reverb_send"}
	IF MAP.EXISTS(t, prefix + "_delay_send") THEN SOUND.DELAYSEND track, t{prefix + "_delay_send"}
	IF MAP.EXISTS(t, prefix + "_lfo") THEN
		a = t{prefix + "_lfo"}
		SOUND.LFO track, a[0], a[1]
	ENDIF
	IF MAP.EXISTS(t, prefix + "_fm") THEN
		a = t{prefix + "_fm"}
		SOUND.FM track, a[0], a[1]
	ENDIF
	IF MAP.EXISTS(t, prefix + "_unison") THEN
		a = t{prefix + "_unison"}
		SOUND.UNISON track, a[0], a[1], a[2]
	ENDIF
	IF MAP.EXISTS(t, prefix + "_eq") THEN
		a = t{prefix + "_eq"}
		SOUND.EQ track, a[0], a[1], a[2]
	ENDIF
	IF MAP.EXISTS(t, prefix + "_bitcrush") THEN
		a = t{prefix + "_bitcrush"}
		SOUND.BITCRUSH track, a[0], a[1]
	ENDIF
	IF MAP.EXISTS(t, prefix + "_ringmod") THEN
		a = t{prefix + "_ringmod"}
		SOUND.RINGMOD track, a[0], a[1]
	ENDIF
	IF MAP.EXISTS(t, prefix + "_scale") THEN
		a = t{prefix + "_scale"}
		SOUND.SCALE track, a[0], a[1]
	ENDIF
ENDSUB

' Apply optional master-bus effects present in the theme.
SUB apply_master(t)
	DIM a AS ARRAY = []
	IF MAP.EXISTS(t, "reverb") THEN
		a = t{"reverb"}
		SOUND.REVERB a[0], a[1], a[2], a[3]
	ENDIF
	IF MAP.EXISTS(t, "delay") THEN
		a = t{"delay"}
		SOUND.DELAY a[0], a[1], a[2], a[3]
	ENDIF
	IF MAP.EXISTS(t, "compressor") THEN
		a = t{"compressor"}
		SOUND.COMPRESSOR a[0], a[1], a[2], a[3], a[4]
	ENDIF
	IF MAP.EXISTS(t, "distortion") THEN SOUND.DISTORTION t{"distortion"}
	IF MAP.EXISTS(t, "sidechain") THEN
		a = t{"sidechain"}
		SOUND.SIDECHAIN a[0], a[1], a[2]
	ENDIF
ENDSUB

SUB set_theme(name)
	IF name = cur_theme THEN RETURN
	IF NOT MAP.EXISTS(themes, name) THEN RETURN
	cur_theme = name
	DIM t = themes{name}

	SOUND.RESET
	SOUND.INIT
	SOUND.BPM t{"bpm"}

	DIM mv = t{"melody_voice"}
	SOUND.VOICE 0, mv[0], mv[1], mv[2], mv[3], mv[4]
	apply_fx(0, t, "melody")

	DIM bv = t{"bass_voice"}
	SOUND.VOICE 1, bv[0], bv[1], bv[2], bv[3], bv[4]
	apply_fx(1, t, "bass")

	apply_master(t)

	DIM melody = t{"melody"}
	DIM bass = t{"bass"}
	SOUND.NOTE "< " + melody + " , " + bass + " >", TRUE
ENDSUB

SUB load_dungeon_rect()
	DIM src = GDX.STATIC("FileAccess", "get_file_as_string", "res://assets/data/dungeons.json")
	DIM all = JSON.PARSE$(src)
	IF LEN(all) = 0 THEN RETURN
	DIM spec = all[0]
	DIM org = spec{"origin"}
	DIM rooms = spec{"rooms"}
	DIM gw = 0
	DIM gh = 0
	FOR i = 0 TO LEN(rooms) - 1
		DIM rm = rooms[i]
		DIM re = INT(rm{"col"}) + INT(rm{"w"})
		DIM be = INT(rm{"row"}) + INT(rm{"h"})
		IF re > gw THEN gw = re
		IF be > gh THEN gh = be
	NEXT
	dun_x0 = org[0]
	dun_x1 = org[0] + (gw + 1) * 4.0
	dun_z0 = org[2]
	dun_z1 = org[2] + (gh + 1) * 4.0
ENDSUB

FUNC want_theme()
	DIM tree = GDX.CALL(self_h, "get_tree")
	IF GDX.CALL(tree, "is_paused") THEN RETURN "dialog"
	IF player_h <> 0 ANDALSO dun_x1 > dun_x0 THEN
		DIM pp = GDX.GET(player_h, "global_position")
		IF pp[0] > dun_x0 ANDALSO pp[0] < dun_x1 ANDALSO pp[2] > dun_z0 ANDALSO pp[2] < dun_z1 THEN RETURN "dungeon"
	ENDIF
	RETURN "explore"
ENDFUNC

SUB _ready()
	self_h = GDX.SELF()
	GDX.SET(self_h, "process_mode", 3)
	player_h = GDX.CALL(self_h, "get_node", "../Player")
	dialog_h = GDX.CALL(self_h, "get_node", "../DialogManager")

	SOUND.INIT
	load_themes()
	load_dungeon_rect()

	' The Master/Music/SFX buses come from res://default_bus_layout.tres
	' (Project Settings -> Audio), so they exist at edit time and you can add
	' effects / set volume on them live in the editor's Audio panel.
	DIM gen = GDX.NEW("AudioStreamGenerator")
	GDX.SET(gen, "mix_rate", rate)
	GDX.SET(gen, "buffer_length", 0.3)
	mplayer = GDX.NEW("AudioStreamPlayer")
	GDX.SET(mplayer, "stream", GDX.REF(gen))
	GDX.SET(mplayer, "bus", "Music")
	GDX.ADD_CHILD(self_h, mplayer)
ENDSUB

SUB _process(delta)
	' Hold until the dialogue model has finished its blocking load.
	IF NOT started THEN
		IF dialog_h = 0 THEN RETURN
		IF NOT GDX.CALL(dialog_h, "get_meta", "llm_ready", FALSE) THEN RETURN
		set_theme(want_theme())
		GDX.CALL(mplayer, "play")
		playback = GDX.CALL(mplayer, "get_stream_playback")
		started = TRUE
		PRINT "music: playback=" + STR$(playback)
	ENDIF
	IF playback = 0 THEN RETURN

	set_theme(want_theme())
	DIM avail = GDX.CALL(playback, "get_frames_available")
	IF avail <= 0 THEN RETURN
	DIM buf = SOUND.RENDER(avail)
	GDX.CALL(playback, "push_buffer", GDX.PACKED_VEC2(buf))
ENDSUB
