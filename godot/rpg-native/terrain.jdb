EXTENDS StaticBody3D

' Walkable procedural terrain.
'
' One precomputed height grid drives two things:
'   - the visual mesh  (SurfaceTool, per-tile colour from world_map.txt)
'   - the collider     (HeightMapShape3D - the player walks on this)
'
' The grid is flattened under every dungeon (dungeons.json) so the dungeon
' floor sits flush on level ground.
'
' Scene children (world.tscn):
'   Mesh       MeshInstance3D    - receives the ArrayMesh
'   Collision  CollisionShape3D  - receives the HeightMapShape3D

INSPECTOR DIM grid_n    = 96    AS RANGE(8, 192, 1)
INSPECTOR DIM cell_size = 1.0   AS RANGE(0.25, 2.0, 0.05)
INSPECTOR DIM freq      = 14.0  AS RANGE(2.0, 40.0, 0.5)
INSPECTOR DIM amp       = 2.0   AS RANGE(0.1, 8.0, 0.1)
INSPECTOR DIM seed      = 7

DIM self_h = 0
DIM mesh_h = 0
DIM col_h  = 0

' Content-pack root (Project Settings -> game/data_dir): assets/data, or
' assets/data_ger for the German pirate theme.
FUNC data_dir$()
	RETURN GDX.CALL(GDX.SINGLETON("ProjectSettings"), "get_setting", "game/data_dir", "res://assets/data")
ENDFUNC

' Terrain height at a world (x, z).
FUNC height_at(wx, wz)
	DIM cx = wx / freq
	DIM cy = wz / freq
	DIM a1 = SIN(cx + seed * 0.10) * COS(cy + seed * 0.13)
	DIM a2 = SIN(cx * 2.1 + seed * 0.7) * COS(cy * 2.3 + seed * 1.9) * 0.5
	DIM a3 = SIN(cx * 4.7 + seed * 2.1) * COS(cy * 4.1 + seed * 0.4) * 0.25
	RETURN (a1 + a2 + a3) * amp
ENDFUNC

SUB _ready()
	self_h = GDX.SELF()
	mesh_h = GDX.CALL(self_h, "get_node", "Mesh")
	col_h  = GDX.CALL(self_h, "get_node", "Collision")

	DIM n     = grid_n
	DIM total = n * n
	DIM half  = n / 2.0

	' Height grid: gx is the column (X), gy the row (Z), each 0..n-1.
	DIM idx = IOTA(total,0)
	DIM gx  = idx MOD n
	DIM gy  = (idx - gx) / n
	DIM cx  = (gx - half) * cell_size / freq
	DIM cy  = (gy - half) * cell_size / freq
	DIM h1  = SIN(cx + seed * 0.10) * COS(cy + seed * 0.13)
	DIM h2  = SIN(cx * 2.1 + seed * 0.7) * COS(cy * 2.3 + seed * 1.9) * 0.5
	DIM h3  = SIN(cx * 4.7 + seed * 2.1) * COS(cy * 4.1 + seed * 0.4) * 0.25
	DIM hh  = (h1 + h2 + h3) * amp

	' Flatten the grid under each dungeon (dungeons.json) to its floor level.
	DIM dsrc = GDX.STATIC("FileAccess", "get_file_as_string", data_dir$() + "/dungeons.json")
	DIM dall = JSON.PARSE$(dsrc)
	FOR di = 0 TO LEN(dall) - 1
		DIM dspec  = dall[di]
		DIM dorg   = dspec{"origin"}
		DIM dox    = dorg[0]
		DIM doz    = dorg[2]
		DIM drooms = dspec{"rooms"}
		DIM dgw = 0
		DIM dgh = 0
		FOR ri = 0 TO LEN(drooms) - 1
			DIM rm = drooms[ri]
			DIM re = INT(rm{"col"}) + INT(rm{"w"})
			DIM be = INT(rm{"row"}) + INT(rm{"h"})
			IF re > dgw THEN dgw = re
			IF be > dgh THEN dgh = be
		NEXT
		DIM dfw = (dgw + 1) * 4.0
		DIM dfh = (dgh + 1) * 4.0

		DIM dmax = -1000.0
		DIM dss AS ARRAY = [0.1, 0.5, 0.9]
		FOR sa = 0 TO 2
			FOR sb = 0 TO 2
				DIM dth = height_at(dox + dss[sa] * dfw, doz + dss[sb] * dfh)
				IF dth > dmax THEN dmax = dth
			NEXT
		NEXT
		DIM carve_y = dmax - 0.35

		DIM cgx0 = INT(dox / cell_size + half)
		DIM cgx1 = INT((dox + dfw) / cell_size + half)
		DIM cgz0 = INT(doz / cell_size + half)
		DIM cgz1 = INT((doz + dfh) / cell_size + half)
		IF cgx0 < 0 THEN cgx0 = 0
		IF cgz0 < 0 THEN cgz0 = 0
		IF cgx1 > n - 1 THEN cgx1 = n - 1
		IF cgz1 > n - 1 THEN cgz1 = n - 1
		FOR cz = cgz0 TO cgz1
			FOR cxx = cgx0 TO cgx1
				hh[cz * n + cxx] = carve_y
			NEXT
		NEXT
	NEXT

	' Per-vertex tile type from world_map.txt (grass / path / clearing / tree).
	DIM map_src  = GDX.STATIC("FileAccess", "get_file_as_string", data_dir$() + "/world_map.txt")
	DIM map_rows = SPLIT(map_src, CHR$(10))
	DIM map_rn   = LEN(map_rows)
	DIM map_cols = LEN(map_rows[0])

	DIM verts = ZEROS(total * 3)
	DIM tt    = ZEROS(total)
	FOR k = 0 TO total - 1
		verts[k * 3]     = (gx[k] - half) * cell_size
		verts[k * 3 + 1] = hh[k]
		verts[k * 3 + 2] = (gy[k] - half) * cell_size
		DIM my = INT(gy[k] * map_rn / n)
		DIM mx = INT(gx[k] * map_cols / n)
		IF my >= 0 ANDALSO my < map_rn THEN
			DIM mrow = map_rows[my]
			IF mx >= 0 ANDALSO mx < LEN(mrow) THEN
				DIM mch = MID$(mrow, mx, 1)
				IF mch = "#" THEN tt[k] = 1
				IF mch = "o" THEN tt[k] = 2
				IF mch = "T" THEN tt[k] = 3
			ENDIF
		ENDIF
	NEXT

	' Visual mesh: SurfaceTool builds 6 verts per quad with their tile colour,
	' generate_normals, then commit into the ArrayMesh. Two-sided material with
	' per-vertex colour as albedo.
	DIM palette AS ARRAY = [ GDX.COLOR(0.45, 0.60, 0.30, 1.0), GDX.COLOR(0.50, 0.40, 0.28, 1.0), GDX.COLOR(0.55, 0.65, 0.40, 1.0), GDX.COLOR(0.18, 0.36, 0.22, 1.0) ]
	DIM st = GDX.NEW("SurfaceTool")
	GDX.CALL(st, "begin", GDX.ENUM("Mesh", "PRIMITIVE_TRIANGLES"))
	FOR gyq = 0 TO n - 2
		FOR gxq = 0 TO n - 2
			DIM i00 = gyq * n + gxq
			DIM i10 = i00 + 1
			DIM i01 = (gyq + 1) * n + gxq
			DIM i11 = i01 + 1
			emit_v(st, palette, tt, verts, i00)
			emit_v(st, palette, tt, verts, i11)
			emit_v(st, palette, tt, verts, i10)
			emit_v(st, palette, tt, verts, i00)
			emit_v(st, palette, tt, verts, i01)
			emit_v(st, palette, tt, verts, i11)
		NEXT
	NEXT
	GDX.CALL(st, "generate_normals")

	DIM mesh = GDX.NEW("ArrayMesh")
	GDX.CALL(st, "commit", GDX.REF(mesh))
	DIM mat = GDX.NEW("StandardMaterial3D")
	GDX.SET(mat, "vertex_color_use_as_albedo", TRUE)
	GDX.SET(mat, "cull_mode", GDX.ENUM("BaseMaterial3D", "CULL_DISABLED"))
	GDX.CALL(mesh, "surface_set_material", 0, GDX.REF(mat))
	GDX.SET(mesh_h, "mesh", GDX.REF(mesh))

	' Walkable collider: HeightMapShape3D on the same grid, scaled by cell_size.
	DIM shape = GDX.NEW("HeightMapShape3D")
	GDX.SET(shape, "map_width", n)
	GDX.SET(shape, "map_depth", n)
	GDX.SET(shape, "map_data", GDX.PACKED_FLOAT32(hh))
	GDX.SET(col_h, "shape", GDX.REF(shape))
	GDX.SET(col_h, "scale", GDX.VEC3(cell_size, 1.0, cell_size))

	PRINT "terrain: " + STR$(total) + " verts, walkable HeightMapShape " + STR$(n) + "x" + STR$(n)
ENDSUB

' Emit one SurfaceTool vertex k: its flat tile colour, then its position.
SUB emit_v(st, palette, tt, verts, k)
	GDX.CALL(st, "set_color", palette[tt[k]])
	GDX.CALL(st, "add_vertex", GDX.VEC3(verts[k * 3], verts[k * 3 + 1], verts[k * 3 + 2]))
ENDSUB
