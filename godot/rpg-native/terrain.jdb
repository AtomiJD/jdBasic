EXTENDS StaticBody3D

' Walkable procedural terrain. One vectorised height grid drives both the
' visual ArrayMesh (per-vertex colour) and a HeightMapShape3D collider.
'
'   Mesh       child: MeshInstance3D - gets the ArrayMesh
'   Collision  child: CollisionShape3D - gets the HeightMapShape3D

INSPECTOR DIM grid_n    = 96    AS RANGE(8, 192, 1)
INSPECTOR DIM cell_size = 1.0   AS RANGE(0.25, 2.0, 0.05)
INSPECTOR DIM freq      = 14.0  AS RANGE(2.0, 40.0, 0.5)
INSPECTOR DIM amp       = 2.0   AS RANGE(0.1, 8.0, 0.1)
INSPECTOR DIM seed      = 7

DIM self_h = 0
DIM mesh_h = 0
DIM col_h  = 0

' Same height formula the dungeon builder uses, so a dungeon's computed
' ground-y matches the terrain we flatten under it.
FUNC terrain_height(wx, wz)
	DIM cx = wx / 14.0
	DIM cy = wz / 14.0
	DIM a1 = SIN(cx + 0.70) * COS(cy + 0.91)
	DIM a2 = SIN(cx * 2.1 + 4.90) * COS(cy * 2.3 + 13.30) * 0.5
	DIM a3 = SIN(cx * 4.7 + 14.70) * COS(cy * 4.1 + 2.80) * 0.25
	RETURN (a1 + a2 + a3) * 2.0
ENDFUNC

SUB _ready()
	self_h = GDX.SELF()
	mesh_h = GDX.CALL(self_h, "get_node", "Mesh")
	col_h  = GDX.CALL(self_h, "get_node", "Collision")

	DIM n = grid_n
	DIM total = n * n
	DIM half = n / 2.0

	' Heights - one vectorised pass.
	DIM idx = IOTA(total)
	DIM gx = idx MOD n
	DIM gy = (idx - gx) / n
	DIM cx = (gx - half) / freq
	DIM cy = (gy - half) / freq
	DIM h1 = SIN(cx + seed * 0.10) * COS(cy + seed * 0.13)
	DIM h2 = SIN(cx * 2.1 + seed * 0.7) * COS(cy * 2.3 + seed * 1.9) * 0.5
	DIM h3 = SIN(cx * 4.7 + seed * 2.1) * COS(cy * 4.1 + seed * 0.4) * 0.25
	DIM hh = (h1 + h2 + h3) * amp

	' Flatten the heightmap under every dungeon (read dungeons.json) so the
	' dungeon floors sit on level ground - both the visual mesh and the
	' collider, since the player walks on the terrain collider in there.
	DIM dsrc = GDX.STATIC("FileAccess", "get_file_as_string", "res://assets/data/dungeons.json")
	DIM dall = JSON.PARSE$(dsrc)
	FOR di = 0 TO LEN(dall) - 1
		DIM dspec = dall[di]
		DIM dorg  = dspec{"origin"}
		DIM dox = dorg[0]
		DIM doz = dorg[2]
		DIM drooms = dspec{"rooms"}
		DIM dgw = 0
		DIM dgh = 0
		FOR ri = 0 TO LEN(drooms) - 1
			DIM rm = drooms[ri]
			DIM re = INT(rm{"col"}) + INT(rm{"w"})
			DIM be = INT(rm{"row"}) + INT(rm{"h"})
			IF re > dgw THEN dgw = re
			IF be > dgh THEN dgh = be
		NEXT
		DIM dfw = (dgw + 1) * 4.0
		DIM dfh = (dgh + 1) * 4.0

		' max-of-9 terrain height across the footprint, sunk to max-0.3.
		DIM dmax = -1000.0
		DIM dss AS ARRAY = [0.1, 0.5, 0.9]
		FOR sa = 0 TO 2
			FOR sb = 0 TO 2
				DIM dth = terrain_height(dox + dss[sa] * dfw, doz + dss[sb] * dfh)
				IF dth > dmax THEN dmax = dth
			NEXT
		NEXT
		DIM carve_y = dmax - 0.35

		' Grid cells overlapping [dox, dox+dfw] x [doz, doz+dfh].
		DIM cgx0 = INT(dox / cell_size + half)
		DIM cgx1 = INT((dox + dfw) / cell_size + half)
		DIM cgz0 = INT(doz / cell_size + half)
		DIM cgz1 = INT((doz + dfh) / cell_size + half)
		IF cgx0 < 0 THEN cgx0 = 0
		IF cgz0 < 0 THEN cgz0 = 0
		IF cgx1 > n - 1 THEN cgx1 = n - 1
		IF cgz1 > n - 1 THEN cgz1 = n - 1
		FOR cz = cgz0 TO cgz1
			FOR cx = cgx0 TO cgx1
				hh[cz * n + cx] = carve_y
			NEXT
		NEXT
	NEXT

	' Tile map -> per-vertex colour (paths / clearings / trees). Read the
	' raw .txt via the real Godot API (FileAccess.get_file_as_string).
	DIM map_src  = GDX.STATIC("FileAccess", "get_file_as_string", "res://assets/data/world_map.txt")
	DIM map_rows = SPLIT(map_src, CHR$(10))
	DIM map_rn   = LEN(map_rows)
	DIM map_cols = LEN(map_rows[0])

	' Vertices (flat x,y,z), per-vertex colour (r,g,b,a) and normals (x,y,z).
	DIM verts = ZEROS(total * 3)
	DIM cols  = ZEROS(total * 4)
	DIM nrm   = ZEROS(total * 3)
	FOR k = 0 TO total - 1
		DIM y = hh[k]
		verts[k * 3]     = (gx[k] - half) * cell_size
		verts[k * 3 + 1] = y
		verts[k * 3 + 2] = (gy[k] - half) * cell_size
		' Grass base, shaded by height; overridden by the tile under it.
		DIM t = (y / amp + 1.0) * 0.5
		DIM rr = 0.26 + 0.20 * t
		DIM gg = 0.50 + 0.22 * t
		DIM bb = 0.28
		DIM my = INT(gy[k] * map_rn / n)
		DIM mx = INT(gx[k] * map_cols / n)
		IF my >= 0 ANDALSO my < map_rn THEN
			DIM row = map_rows[my]
			IF mx >= 0 ANDALSO mx < LEN(row) THEN
				DIM ch = MID$(row, mx, 1)
				IF ch = "#" THEN
					rr = 0.50
					gg = 0.40
					bb = 0.28
				ELSEIF ch = "o" THEN
					rr = 0.56
					gg = 0.62
					bb = 0.40
				ELSEIF ch = "T" THEN
					rr = 0.16
					gg = 0.34
					bb = 0.20
				ENDIF
			ENDIF
		ENDIF
		cols[k * 4]     = rr
		cols[k * 4 + 1] = gg
		cols[k * 4 + 2] = bb
		cols[k * 4 + 3] = 1.0

		' Normal from the height gradient (clamped neighbours) - needed for
		' lighting AND so Godot culls the underside (no normals = double-sided).
		' Derive grid coords from k (0-based) to index hh safely.
		DIM gyk = INT(k / n)
		DIM gxk = k - gyk * n
		DIM xl = gxk - 1
		IF xl < 0 THEN xl = 0
		DIM xr = gxk + 1
		IF xr > n - 1 THEN xr = n - 1
		DIM zd = gyk - 1
		IF zd < 0 THEN zd = 0
		DIM zu = gyk + 1
		IF zu > n - 1 THEN zu = n - 1
		DIM nx = hh[gyk * n + xl] - hh[gyk * n + xr]
		DIM nz = hh[zd * n + gxk] - hh[zu * n + gxk]
		DIM ny = 2.0 * cell_size
		DIM nl = SQR(nx * nx + ny * ny + nz * nz)
		nrm[k * 3]     = nx / nl
		nrm[k * 3 + 1] = ny / nl
		nrm[k * 3 + 2] = nz / nl
	NEXT

	' Two triangles per grid quad.
	DIM quads = (n - 1) * (n - 1)
	DIM inds = ZEROS(quads * 6)
	DIM w = 0
	FOR gyq = 0 TO n - 2
		FOR gxq = 0 TO n - 2
			DIM i00 = gyq * n + gxq
			DIM i10 = i00 + 1
			DIM i01 = (gyq + 1) * n + gxq
			DIM i11 = i01 + 1
			inds[w]     = i00
			inds[w + 1] = i10
			inds[w + 2] = i11
			inds[w + 3] = i00
			inds[w + 4] = i11
			inds[w + 5] = i01
			w = w + 6
		NEXT
	NEXT

	' Visual mesh via ArrayMesh.add_surface_from_arrays. Empty slots NONE.
	DIM sa AS ARRAY = []
	FOR i = 0 TO 12
		sa = APPEND(sa, NULL)
	NEXT
	sa[0]  = GDX.PACKED_VEC3(verts)
	sa[1]  = GDX.PACKED_VEC3(nrm)
	sa[3]  = GDX.PACKED_COLOR(cols)
	sa[12] = GDX.PACKED_INT32(inds)

	DIM mesh = GDX.NEW("ArrayMesh")
	GDX.CALL(mesh, "add_surface_from_arrays", GDX.ENUM("Mesh", "PRIMITIVE_TRIANGLES"), sa)
	DIM mat = GDX.NEW("StandardMaterial3D")
	GDX.SET(mat, "vertex_color_use_as_albedo", TRUE)
	GDX.CALL(mesh, "surface_set_material", 0, GDX.REF(mat))
	GDX.SET(mesh_h, "mesh", GDX.REF(mesh))

	' Collision: a HeightMapShape3D fed the same row-major height grid.
	' The shape samples at 1-unit spacing, so scale the collider by
	' cell_size in X/Z to line up with the visual mesh.
	DIM shape = GDX.NEW("HeightMapShape3D")
	GDX.SET(shape, "map_width", n)
	GDX.SET(shape, "map_depth", n)
	GDX.SET(shape, "map_data", GDX.PACKED_FLOAT32(hh))
	GDX.SET(col_h, "shape", GDX.REF(shape))
	GDX.SET(col_h, "scale", GDX.VEC3(cell_size, 1.0, cell_size))

	PRINT "terrain: " + STR$(total) + " verts, walkable HeightMapShape " + STR$(n) + "x" + STR$(n)
ENDSUB
