EXTENDS StaticBody3D

' Walkable procedural terrain, pure jdBasic. Heights are computed APL-style
' (vectorised SIN/COS over IOTA, no loops). The same height grid drives both
' the visual ArrayMesh (per-vertex colour) and a HeightMapShape3D collider,
' so the player and NPCs walk on the generated ground.
'
'   Mesh       child: MeshInstance3D - gets the ArrayMesh
'   Collision  child: CollisionShape3D - gets the HeightMapShape3D

INSPECTOR DIM grid_n    = 96    AS RANGE(8, 192, 1)
INSPECTOR DIM cell_size = 1.0   AS RANGE(0.25, 2.0, 0.05)
INSPECTOR DIM freq      = 14.0  AS RANGE(2.0, 40.0, 0.5)
INSPECTOR DIM amp       = 2.0   AS RANGE(0.1, 8.0, 0.1)
INSPECTOR DIM seed      = 7

DIM self_h = 0
DIM mesh_h = 0
DIM col_h  = 0

SUB _ready()
	self_h = GODOT.SELF()
	mesh_h = GODOT.CALL(self_h, "get_node", "Mesh")
	col_h  = GODOT.CALL(self_h, "get_node", "Collision")

	DIM n = grid_n
	DIM total = n * n
	DIM half = n / 2.0

	' Heights - one vectorised pass.
	DIM idx = IOTA(total)
	DIM gx = idx MOD n
	DIM gy = (idx - gx) / n
	DIM cx = (gx - half) / freq
	DIM cy = (gy - half) / freq
	DIM h1 = SIN(cx + seed * 0.10) * COS(cy + seed * 0.13)
	DIM h2 = SIN(cx * 2.1 + seed * 0.7) * COS(cy * 2.3 + seed * 1.9) * 0.5
	DIM h3 = SIN(cx * 4.7 + seed * 2.1) * COS(cy * 4.1 + seed * 0.4) * 0.25
	DIM hh = (h1 + h2 + h3) * amp

	' Tile map -> per-vertex colour (paths / clearings / trees). Read the
	' raw .txt via the real Godot API (FileAccess.get_file_as_string).
	DIM map_src  = GODOT.STATIC("FileAccess", "get_file_as_string", "res://assets/data/world_map.txt")
	DIM map_rows = SPLIT(map_src, CHR$(10))
	DIM map_rn   = LEN(map_rows)
	DIM map_cols = LEN(map_rows[0])

	' Vertices (flat x,y,z), per-vertex colour (r,g,b,a) and normals (x,y,z).
	DIM verts = ZEROS(total * 3)
	DIM cols  = ZEROS(total * 4)
	DIM nrm   = ZEROS(total * 3)
	FOR k = 0 TO total - 1
		DIM y = hh[k]
		verts[k * 3]     = (gx[k] - half) * cell_size
		verts[k * 3 + 1] = y
		verts[k * 3 + 2] = (gy[k] - half) * cell_size
		' Grass base, shaded by height; overridden by the tile under it.
		DIM t = (y / amp + 1.0) * 0.5
		DIM rr = 0.26 + 0.20 * t
		DIM gg = 0.50 + 0.22 * t
		DIM bb = 0.28
		DIM my = INT(gy[k] * map_rn / n)
		DIM mx = INT(gx[k] * map_cols / n)
		IF my >= 0 ANDALSO my < map_rn THEN
			DIM row = map_rows[my]
			IF mx >= 0 ANDALSO mx < LEN(row) THEN
				DIM ch = MID$(row, mx, 1)
				IF ch = "#" THEN
					rr = 0.50
					gg = 0.40
					bb = 0.28
				ELSEIF ch = "o" THEN
					rr = 0.56
					gg = 0.62
					bb = 0.40
				ELSEIF ch = "T" THEN
					rr = 0.16
					gg = 0.34
					bb = 0.20
				ENDIF
			ENDIF
		ENDIF
		cols[k * 4]     = rr
		cols[k * 4 + 1] = gg
		cols[k * 4 + 2] = bb
		cols[k * 4 + 3] = 1.0

		' Normal from the height gradient (clamped neighbours) - needed for
		' lighting AND so Godot culls the underside (no normals = double-sided).
		' Derive grid coords from k (0-based) to index hh safely.
		DIM gyk = INT(k / n)
		DIM gxk = k - gyk * n
		DIM xl = gxk - 1
		IF xl < 0 THEN xl = 0
		DIM xr = gxk + 1
		IF xr > n - 1 THEN xr = n - 1
		DIM zd = gyk - 1
		IF zd < 0 THEN zd = 0
		DIM zu = gyk + 1
		IF zu > n - 1 THEN zu = n - 1
		DIM nx = hh[gyk * n + xl] - hh[gyk * n + xr]
		DIM nz = hh[zd * n + gxk] - hh[zu * n + gxk]
		DIM ny = 2.0 * cell_size
		DIM nl = SQR(nx * nx + ny * ny + nz * nz)
		nrm[k * 3]     = nx / nl
		nrm[k * 3 + 1] = ny / nl
		nrm[k * 3 + 2] = nz / nl
	NEXT

	' Two triangles per grid quad.
	DIM quads = (n - 1) * (n - 1)
	DIM inds = ZEROS(quads * 6)
	DIM w = 0
	FOR gyq = 0 TO n - 2
		FOR gxq = 0 TO n - 2
			DIM i00 = gyq * n + gxq
			DIM i10 = i00 + 1
			DIM i01 = (gyq + 1) * n + gxq
			DIM i11 = i01 + 1
			inds[w]     = i00
			inds[w + 1] = i10
			inds[w + 2] = i11
			inds[w + 3] = i00
			inds[w + 4] = i11
			inds[w + 5] = i01
			w = w + 6
		NEXT
	NEXT

	' Visual mesh via ArrayMesh.add_surface_from_arrays. Empty slots NONE.
	DIM sa AS ARRAY = []
	FOR i = 0 TO 12
		sa = APPEND(sa, NULL)
	NEXT
	sa[0]  = GODOT.PACKED_VEC3(verts)
	sa[1]  = GODOT.PACKED_VEC3(nrm)
	sa[3]  = GODOT.PACKED_COLOR(cols)
	sa[12] = GODOT.PACKED_INT32(inds)

	DIM mesh = GODOT.NEW("ArrayMesh")
	GODOT.CALL(mesh, "add_surface_from_arrays", GODOT.ENUM("Mesh", "PRIMITIVE_TRIANGLES"), sa)
	DIM mat = GODOT.NEW("StandardMaterial3D")
	GODOT.SET(mat, "vertex_color_use_as_albedo", TRUE)
	GODOT.CALL(mesh, "surface_set_material", 0, GODOT.REF(mat))
	GODOT.SET(mesh_h, "mesh", GODOT.REF(mesh))

	' Collision: a HeightMapShape3D fed the same row-major height grid.
	' The shape samples at 1-unit spacing, so scale the collider by
	' cell_size in X/Z to line up with the visual mesh.
	DIM shape = GODOT.NEW("HeightMapShape3D")
	GODOT.SET(shape, "map_width", n)
	GODOT.SET(shape, "map_depth", n)
	GODOT.SET(shape, "map_data", GODOT.PACKED_FLOAT32(hh))
	GODOT.SET(col_h, "shape", GODOT.REF(shape))
	GODOT.SET(col_h, "scale", GODOT.VEC3(cell_size, 1.0, cell_size))

	PRINT "terrain: " + STR$(total) + " verts, walkable HeightMapShape " + STR$(n) + "x" + STR$(n)
ENDSUB
