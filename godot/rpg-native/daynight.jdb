EXTENDS DirectionalLight3D

' Sky and day/night cycle: builds a procedural-sky WorldEnvironment and arcs
' the sun across it over `day_length` seconds.

INSPECTOR DIM day_length = 90.0 AS RANGE(10.0, 600.0, 5.0)

DIM self_h = 0
DIM tod = 0.25   ' time of day, 0..1 (start mid-morning)

SUB _ready()
	self_h = GDX.SELF()

	' Procedural sky -> Environment -> WorldEnvironment (added to the world).
	DIM skymat = GDX.NEW("ProceduralSkyMaterial")
	DIM sky = GDX.NEW("Sky")
	GDX.SET(sky, "sky_material", GDX.REF(skymat))

	DIM env = GDX.NEW("Environment")
	GDX.SET(env, "background_mode", GDX.ENUM("Environment", "BG_SKY"))
	GDX.SET(env, "sky", GDX.REF(sky))
	GDX.SET(env, "ambient_light_source", GDX.ENUM("Environment", "AMBIENT_SOURCE_SKY"))

	GDX.SET(env, "fog_enabled", FALSE)

	DIM we = GDX.NEW("WorldEnvironment")
	GDX.SET(we, "environment", GDX.REF(env))
	' Defer: the parent is still building its children during _ready.
	DIM parent = GDX.CALL(self_h, "get_parent")
	GDX.CALL(parent, "call_deferred", "add_child", GDX.REF(we))
ENDSUB

SUB _process(delta)
	tod = tod + delta / day_length
	IF tod > 1.0 THEN tod = tod - 1.0

	' Arc the sun across the sky: a full -2*PI rotation about X over a day.
	GDX.SET(self_h, "rotation:x", -tod * 2.0 * PI)

	' Dim and warm the light through dusk/dawn; near-dark at night.
	DIM up = SIN(tod * 2.0 * PI)          ' >0 daytime, <0 night
	DIM e = up
	IF e < 0.05 THEN e = 0.05
	GDX.SET(self_h, "light_energy", e * 1.3)
ENDSUB
