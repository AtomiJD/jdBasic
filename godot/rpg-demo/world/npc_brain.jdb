' NPC behaviour brain - pure jdBasic logic, zero Godot coupling.
'
' Architecture: GDScript spawns NPC bodies and ticks them every frame.
' Per tick it calls npc_tick(id, dt, ground_y) and gets back the new
' (x, y, z, yaw). All state lives in the EXPORT'd npcs MAP keyed by id.
'
' This file is testable via the MCP without Godot - load it, call
' npc_init / npc_tick with synthetic data, inspect npc_state$.

EXPORT DIM npcs AS MAP = {}

' Player-side state: quests in flight, completed, plus inventory. The
' jdBasic side is the single source of truth; GDScript queries it
' through small expression-eval calls when the Q/I panels open.
EXPORT DIM player_state AS MAP = {}
player_state{"active"}    = []
player_state{"completed"} = []
player_state{"inventory"} = []

' Initialise an NPC from a JSON record. Returns the state map for
' callers that want to peek at it.
EXPORT FUNC npc_init(id, data)
    DIM s AS MAP = {}
    s{"state"} = "Idle"
    s{"timer"} = 0.0
    s{"patrol_idx"} = 0
    s{"patrol"} = data{"patrol"}
    s{"spawn"} = data{"spawn"}
    s{"pos_x"} = data{"spawn"}[0]
    s{"pos_y"} = data{"spawn"}[1]
    s{"pos_z"} = data{"spawn"}[2]
    s{"yaw"} = 0.0
    s{"idle_dwell"} = 2.0
    s{"speed"} = 1.8
    s{"reach"} = 0.6
    s{"name"} = data{"name"}
    s{"persona"} = data{"persona"}
    s{"legend"} = data{"legend"}
    s{"knowledge"} = data{"knowledge"}
    s{"quests"} = data{"quests"}
    IF MAP.EXISTS(data, "lore_tags") = TRUE THEN
        s{"lore_tags"} = data{"lore_tags"}
    ELSE
        s{"lore_tags"} = []
    ENDIF
    s{"dialog_cache"} = ""
    s{"dialog_actions"} = []
    s{"dialog_ready"} = FALSE
    ' recent_turns is the rolling per-NPC buffer (max ~10 entries).
    ' long_term is the LLM-summarised history of older turns - kept
    ' as a single string so the prompt template can splice it in.
    s{"recent_turns"} = []
    s{"long_term"} = ""
    s{"history"} = ""
    s{"color"} = data{"color"}
    s{"quest_offered"} = FALSE
    s{"quest_completed"} = FALSE
    ' Affinity: -100 (hates you) .. 0 (neutral) .. +100 (trusts you).
    ' Optional starting_affinity in npcs.json lets a character begin
    ' biased - default neutral 0.
    IF MAP.EXISTS(data, "starting_affinity") = TRUE THEN
        s{"affinity"} = data{"starting_affinity"}
    ELSE
        s{"affinity"} = 0
    ENDIF
    npcs{id} = s
    RETURN s
ENDFUNC

' Affinity API. Clamps to [-100, +100]. Returns the new value, or
' -9999 if id is unknown (impossible during normal play but guards
' against typos from the LLM/UI dispatch path).
EXPORT FUNC shift_npc_affinity(id, delta)
    IF MAP.EXISTS(npcs, id) <> TRUE THEN RETURN -9999
    DIM cur = npcs{id}{"affinity"}
    DIM new_val = cur + delta
    IF new_val < -100 THEN new_val = -100
    IF new_val > 100 THEN new_val = 100
    npcs{id}{"affinity"} = new_val
    RETURN new_val
ENDFUNC

EXPORT FUNC get_npc_affinity(id)
    IF MAP.EXISTS(npcs, id) <> TRUE THEN RETURN 0
    RETURN npcs{id}{"affinity"}
ENDFUNC

' ── Quest / inventory API (called from GDScript) ───────────────────

EXPORT FUNC has_offerable_quest(id)
    DIM s = npcs{id}
    IF LEN(s{"quests"}) = 0 THEN RETURN FALSE
    IF s{"quest_offered"} = TRUE THEN RETURN FALSE
    RETURN TRUE
ENDFUNC

' Player accepted a quest from this NPC. Marks it offered, pushes it
' onto active list, hands over item_given if the NPC's quest has one.
' Returns a short status string GDScript can show in the dialog log.
EXPORT FUNC accept_quest(id)
    DIM s = npcs{id}
    IF LEN(s{"quests"}) = 0 THEN RETURN "no quest"
    IF s{"quest_offered"} = TRUE THEN RETURN "already offered"
    DIM q = s{"quests"}[0]
    DIM entry AS MAP = {}
    entry{"id"} = q{"id"}
    entry{"giver"} = id
    entry{"giver_name"} = s{"name"}
    entry{"description"} = q{"description"}
    entry{"reward"} = q{"reward"}
    player_state{"active"} = APPEND(player_state{"active"}, entry)
    npcs{id}{"quest_offered"} = TRUE
    ' Seed the LLM history so the NPC's next reply knows the player
    ' said yes - otherwise Phi-3 will keep re-offering or get confused.
    npcs{id}{"history"} = s{"history"} + CHR$(10) + "Player: I accept your quest."
    DIM item = ""
    DIM has_item = MAP.EXISTS(q, "item_given")
    IF has_item = TRUE THEN
        item = q{"item_given"}
        IF LEN(item) > 0 THEN
            DIM inv AS MAP = {}
            inv{"name"} = item
            inv{"source"} = s{"name"}
            player_state{"inventory"} = APPEND(player_state{"inventory"}, inv)
            npcs{id}{"history"} = npcs{id}{"history"} + " (You hand over the " + item + ".)"
        ENDIF
    ENDIF
    RETURN "accepted"
ENDFUNC

' Mark a quest as completed (called from the quest panel's "Complete"
' button - in a full RPG this would be auto-detected). Moves the
' entry from active to completed.
EXPORT FUNC complete_quest_by_idx(idx)
    DIM act = player_state{"active"}
    IF idx < 0 ORELSE idx >= LEN(act) THEN RETURN "bad idx"
    DIM entry = act[idx]
    player_state{"completed"} = APPEND(player_state{"completed"}, entry)
    DIM new_active = []
    FOR i = 0 TO LEN(act) - 1
        IF i <> idx THEN new_active = APPEND(new_active, act[i])
    NEXT
    player_state{"active"} = new_active
    DIM gid = entry{"giver"}
    npcs{gid}{"quest_completed"} = TRUE
    RETURN "completed"
ENDFUNC

EXPORT FUNC quest_count_active()
    RETURN LEN(player_state{"active"})
ENDFUNC

EXPORT FUNC quest_count_completed()
    RETURN LEN(player_state{"completed"})
ENDFUNC

EXPORT FUNC inventory_count()
    RETURN LEN(player_state{"inventory"})
ENDFUNC

' GDScript-friendly accessors: return one entry's display fields by
' index. Keeps marshalling simple - no nested-MAP roundtrips.
EXPORT FUNC active_quest_field(idx, key)
    RETURN player_state{"active"}[idx]{key}
ENDFUNC

EXPORT FUNC completed_quest_field(idx, key)
    RETURN player_state{"completed"}[idx]{key}
ENDFUNC

EXPORT FUNC inventory_field(idx, key)
    RETURN player_state{"inventory"}[idx]{key}
ENDFUNC

' Called from GDScript when a chest is opened - drops every loot
' entry into the inventory tagged with the chest's label as source.
EXPORT FUNC add_inventory_item(item_name, source)
    DIM inv AS MAP = {}
    inv{"name"} = item_name
    inv{"source"} = source
    player_state{"inventory"} = APPEND(player_state{"inventory"}, inv)
    RETURN LEN(player_state{"inventory"})
ENDFUNC

' Tool-call helpers: LLM-emitted give_item / accept_item / complete_quest

EXPORT FUNC remove_player_inventory(item_name)
    DIM inv = player_state{"inventory"}
    DIM found_idx = -1
    FOR i = 0 TO LEN(inv) - 1
        IF inv[i]{"name"} = item_name THEN
            found_idx = i
            EXITFOR
        ENDIF
    NEXT
    IF found_idx < 0 THEN RETURN "not found"
    DIM new_inv = []
    FOR i = 0 TO LEN(inv) - 1
        IF i <> found_idx THEN new_inv = APPEND(new_inv, inv[i])
    NEXT
    player_state{"inventory"} = new_inv
    RETURN "removed"
ENDFUNC

EXPORT FUNC complete_quest_by_id(quest_id)
    DIM act = player_state{"active"}
    DIM idx = -1
    FOR i = 0 TO LEN(act) - 1
        IF act[i]{"id"} = quest_id THEN
            idx = i
            EXITFOR
        ENDIF
    NEXT
    IF idx < 0 THEN RETURN "not found"
    DIM entry = act[idx]
    DIM new_active = []
    FOR i = 0 TO LEN(act) - 1
        IF i <> idx THEN new_active = APPEND(new_active, act[i])
    NEXT
    player_state{"active"} = new_active
    player_state{"completed"} = APPEND(player_state{"completed"}, entry)
    DIM gid = entry{"giver"}
    IF MAP.EXISTS(npcs, gid) = TRUE THEN
        npcs{gid}{"quest_completed"} = TRUE
    ENDIF
    RETURN "completed"
ENDFUNC

' Advance an NPC by dt seconds. ground_y is the terrain height at the
' NPC's current xz - GDScript reads that from terrain.sample_height
' and passes it in so the brain doesn't need to know about the world.
'
' Returns [x, y, z, yaw_radians].
EXPORT FUNC npc_tick(id, dt, ground_y)
    DIM s = npcs{id}
    s{"timer"} = s{"timer"} + dt
    s{"pos_y"} = ground_y

    IF s{"state"} = "Idle" THEN
        IF s{"timer"} >= s{"idle_dwell"} THEN
            s{"state"} = "Patrol"
            s{"timer"} = 0.0
        ENDIF
    ELSE
        IF s{"state"} = "Patrol" THEN
            DIM target = s{"patrol"}{s{"patrol_idx"}}
            DIM dx = target[0] - s{"pos_x"}
            DIM dz = target[2] - s{"pos_z"}
            DIM dist = SQR(dx * dx + dz * dz)
            IF dist < s{"reach"} THEN
                s{"patrol_idx"} = (s{"patrol_idx"} + 1) MOD LEN(s{"patrol"})
                s{"state"} = "Idle"
                s{"timer"} = 0.0
            ELSE
                DIM nx = dx / dist
                DIM nz = dz / dist
                s{"pos_x"} = s{"pos_x"} + nx * s{"speed"} * dt
                s{"pos_z"} = s{"pos_z"} + nz * s{"speed"} * dt
                s{"yaw"} = ATAN2(nx, nz)
            ENDIF
        ENDIF
    ENDIF

    npcs{id} = s
    RETURN [s{"pos_x"}, s{"pos_y"}, s{"pos_z"}, s{"yaw"}]
ENDFUNC

EXPORT FUNC npc_state(id)
    RETURN npcs{id}{"state"}
ENDFUNC

' Load a list of NPC definitions from an OS-path JSON file and init
' each one. Returns the number of NPCs loaded. Called from world.gd
' after the file path has been globalised through ProjectSettings.
EXPORT FUNC load_npcs(path)
    DIM raw$ = TXTREADER$(path)
    DIM data = JSON.PARSE$(raw$)
    FOR i = 0 TO LEN(data) - 1
        npc_init(data[i]{"id"}, data[i])
    NEXT
    RETURN LEN(data)
ENDFUNC

' Walk every loaded NPC by dt seconds. Returns a flat array of
' (id_count * 5) values per NPC: [id_str_placeholder, x, y, z, yaw].
' GDScript reads the ids separately via list_ids() then ticks each
' one with npc_tick() so we keep the marshalling simple.
EXPORT FUNC list_ids()
    RETURN MAP.KEYS(npcs)
ENDFUNC
