' jdBasic terrain heightmap generator.
'
' 4 octaves of layered sin/cos give us hills + ridges + bumps in one
' vectorised pass. IOTA(n*n) + MOD/integer-divide derives (gx, gy) per
' cell; broadcasting arithmetic over the array does the transform.
'
' The whole grid is computed with zero FOR loops - APL-style.

FUNC build_heightmap(n, freq, amp, seed)
    DIM total = n * n
    DIM idx = IOTA(total)
    DIM gx = idx MOD n
    DIM gy = (idx - gx) / n
    DIM cx = (gx - n / 2.0) / freq
    DIM cy = (gy - n / 2.0) / freq

    DIM h1 = SIN(cx + seed * 0.10) * COS(cy + seed * 0.13)
    DIM h2 = SIN(cx * 2.1 + seed * 0.7) * COS(cy * 2.3 + seed * 1.9) * 0.50
    DIM h3 = SIN(cx * 4.7 + seed * 2.1) * COS(cy * 4.1 + seed * 0.4) * 0.25
    DIM h4 = SIN(cx * 9.3 + seed * 3.5) * COS(cy * 8.7 + seed * 2.8) * 0.125

    RETURN (h1 + h2 + h3 + h4) * amp
ENDFUNC

' Sample a single height at world (x, z) - used by spawners that need
' to drop NPCs / items onto the surface. Linear interpolation across
' the 4 nearest grid cells.
FUNC sample_height(heights, n, world_x, world_z, cell_size)
	DIM half = n / 2.0
	DIM gx = world_x / cell_size + half
	DIM gz = world_z / cell_size + half
	DIM ix = INT(gx)
	DIM iz = INT(gz)
	IF ix < 0 ORELSE iz < 0 ORELSE ix >= n - 1 ORELSE iz >= n - 1 THEN RETURN 0.0
	DIM fx = gx - ix
	DIM fz = gz - iz
	DIM h00 = heights[iz * n + ix]
	DIM h10 = heights[iz * n + (ix + 1)]
	DIM h01 = heights[(iz + 1) * n + ix]
	DIM h11 = heights[(iz + 1) * n + (ix + 1)]
	DIM h0 = h00 * (1.0 - fx) + h10 * fx
	DIM h1 = h01 * (1.0 - fx) + h11 * fx
	RETURN h0 * (1.0 - fz) + h1 * fz
ENDFUNC
