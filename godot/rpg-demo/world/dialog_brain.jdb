' Dialog brain - LLM-driven NPC greetings + conversations.
'
' Architecture: one Phi-3-mini loaded on the GPU, one ASYNC FUNC
' generates dialog off the main thread, one task slot at a time so
' llama.cpp isn't hit concurrently per model.
'
' GDScript drives this from world.gd:
'   dialog_init(model_path)      ' once at boot
'   prefetch_tick(px, pz, r)     ' every physics frame
'   is_dialog_ready(id) / get_dialog$(id)  ' when player presses E
'
' All state lives in npc_brain.jdb's `npcs` MAP - see npc_init for the
' per-NPC fields (dialog_cache, dialog_ready, plus the persona/legend
' loaded from npcs.json).

EXPORT DIM g_llm = 0
EXPORT DIM g_task = 0
EXPORT DIM g_task_npc = ""
EXPORT DIM world_lore AS MAP = {}
EXPORT DIM dialog_rules AS MAP = {}
EXPORT DIM world_state AS MAP = {}
EXPORT DIM g_world_log_max = 8        ' keep this many recent events in events_log
EXPORT DIM g_last_raw = "(none)"     ' last raw LLM output for diagnostics
EXPORT DIM g_last_who = ""

' Conversation memory tuning.
EXPORT DIM g_buffer_max = 10        ' keep last N turns verbatim
EXPORT DIM g_summary_min = 4        ' when buffer >= this many, summarise oldest pair

' Summary task slot - separate from g_task so dialog generation
' and history compression don't fight for the single LLM.
EXPORT DIM g_summary_task = 0
EXPORT DIM g_summary_npc = ""
EXPORT DIM g_summary_pair = ""
EXPORT DIM g_last_summary = ""        ' last summary line (for GDScript diag)
EXPORT DIM g_last_summary_npc = ""

' RAG state - knowledge base of world lore files. Built once at boot
' from assets/lore/*.md; each chunk carries its source filename
' (without extension) so we can filter per NPC via lore_tags.
EXPORT DIM g_embed_llm = 0
EXPORT DIM g_rag = 0
EXPORT DIM g_rag_top_k = 10           ' retrieve this many candidates per query
EXPORT DIM g_rag_per_npc = 3          ' keep this many after NPC-tag filter

' ── Memory helpers ────────────────────────────────────────────────

FUNC push_turn(id, who, msg)
    DIM entry AS MAP = {}
    entry{"who"} = who
    entry{"text"} = msg
    npcs{id}{"recent_turns"} = APPEND(npcs{id}{"recent_turns"}, entry)
ENDFUNC

EXPORT FUNC push_player_turn(id, msg)
    push_turn(id, "Player", msg)
ENDFUNC

EXPORT FUNC push_npc_turn(id, msg)
    push_turn(id, npcs{id}{"name"}, msg)
ENDFUNC

' Returns the recent_turns buffer formatted as a single string
' suitable for prompt injection. Pre-fixed with "Player:" / "<name>:"
' so the model reads it as a script.
FUNC format_recent_turns(id)
    DIM turns = npcs{id}{"recent_turns"}
    IF LEN(turns) = 0 THEN RETURN ""
    DIM out = ""
    FOR i = 0 TO LEN(turns) - 1
        out = out + turns[i]{"who"} + ": " + turns[i]{"text"}
        IF i < LEN(turns) - 1 THEN out = out + CHR$(10)
    NEXT
    RETURN out
ENDFUNC

' Pulls the OLDEST player+npc pair off the buffer and returns them
' as a single block of text suitable for summarising. The buffer
' is shrunk by 2 entries (or 1 if only one remains).
FUNC pop_oldest_pair(id)
    DIM turns = npcs{id}{"recent_turns"}
    IF LEN(turns) = 0 THEN RETURN ""
    DIM pair = ""
    DIM take = 2
    IF LEN(turns) < 2 THEN take = LEN(turns)
    FOR i = 0 TO take - 1
        pair = pair + turns[i]{"who"} + ": " + turns[i]{"text"}
        IF i < take - 1 THEN pair = pair + CHR$(10)
    NEXT
    DIM rest = []
    FOR i = take TO LEN(turns) - 1
        rest = APPEND(rest, turns[i])
    NEXT
    npcs{id}{"recent_turns"} = rest
    RETURN pair
ENDFUNC

' Summariser worker. Returns one short sentence describing what
' happened in this oldest exchange, from the NPC's POV.
' True if the summary is dominated by ASCII printable / common Latin
' chars. Used to drop language-drift garbage before it pollutes the
' long-term memory buffer. Threshold: <20% non-ASCII bytes pass.
FUNC is_summary_clean(s)
    DIM n = LEN(s)
    IF n = 0 THEN RETURN FALSE
    DIM bad = 0
    FOR i = 1 TO n
        DIM c = ASC(MID$(s, i - 1, 1))
        IF c > 127 THEN bad = bad + 1
    NEXT
    IF (bad * 100) / n > 20 THEN RETURN FALSE
    RETURN TRUE
ENDFUNC

ASYNC FUNC gen_summary(llm, npc_name, pair_text, sys_prompt)
    AI.SET(llm, "system", sys_prompt)
    AI.CLEAR_HISTORY(llm)
    ' Qwen3 expects /no_think on the user side, not in system.
    RETURN AI.CHAT(llm, pair_text + CHR$(10) + "/no_think")
ENDFUNC

' Called every prefetch_tick AFTER drain. If the buffer has grown
' past the limit AND no summary task is in flight, kick one off.
' On completion we append the summary to long_term and drop the
' just-summarised pair. We only run when dialog isn't busy so
' summarisation never blocks the player.
' Strip a leading "<think>...</think>" block (Qwen3 still emits one
' even with /no_think in user msg) plus any leading whitespace. Used
' on summary output before it lands in long_term_memory.
FUNC strip_think_block(s)
    DIM tend = INSTR(s, "</think>")
    IF tend >= 0 THEN
        s = MID$(s, tend + 8)
    ENDIF
    DO WHILE LEN(s) > 0 ANDALSO (LEFT$(s, 1) = " " ORELSE LEFT$(s, 1) = CHR$(10) ORELSE LEFT$(s, 1) = CHR$(13))
        s = MID$(s, 2)
    LOOP
    RETURN s
ENDFUNC

FUNC maybe_compact_buffer()
    IF g_summary_task <> 0 THEN
        IF THREAD.ISDONE(g_summary_task) THEN
            DIM summary = AWAIT g_summary_task
            summary = strip_think_block(summary)
            ' Reject Qwen's mid-sentence language drift (Chinese,
            ' Cyrillic, Japanese...). If more than 20% of chars are
            ' non-ASCII printable, the summary is poison - dropping it
            ' keeps long_term_memory clean.
            IF is_summary_clean(summary) THEN
                DIM cur = npcs{g_summary_npc}{"long_term"}
                IF LEN(cur) > 0 THEN
                    npcs{g_summary_npc}{"long_term"} = cur + CHR$(10) + summary
                ELSE
                    npcs{g_summary_npc}{"long_term"} = summary
                ENDIF
                g_last_summary = summary
                g_last_summary_npc = g_summary_npc
            ELSE
                PRINT "[summary REJECTED non-ASCII drift] "; g_summary_npc; ": "; summary
            ENDIF
            g_summary_task = 0
            g_summary_npc = ""
            g_summary_pair = ""
        ENDIF
        RETURN ""
    ENDIF
    IF g_task <> 0 THEN RETURN ""   ' don't fight dialog generation
    DIM ids = MAP.KEYS(npcs)
    FOR i = 0 TO LEN(ids) - 1
        DIM id = ids[i]
        IF LEN(npcs{id}{"recent_turns"}) >= g_buffer_max THEN
            DIM pair = pop_oldest_pair(id)
            IF LEN(pair) > 0 THEN
                g_summary_pair = pair
                g_summary_npc = id
                DIM sv AS MAP = {}
                sv{"name"} = npcs{id}{"name"}
                DIM sysp = rule("task_prompts", "summary_system", sv)
                g_summary_task = gen_summary(g_llm, npcs{id}{"name"}, pair, sysp)
                RETURN id
            ENDIF
        ENDIF
    NEXT
    RETURN ""
ENDFUNC

' Load the world-lore JSON once at boot. The contents (setting,
' geography, current_state, rules, npc_roster) are injected into
' every NPC's system prompt so everyone shares the same world model.
EXPORT FUNC load_world_lore(path)
    DIM raw$ = TXTREADER$(path)
    world_lore = JSON.PARSE$(raw$)
    RETURN MAP.SIZE(world_lore)
ENDFUNC

EXPORT FUNC load_dialog_rules(path)
    DIM raw$ = TXTREADER$(path)
    dialog_rules = JSON.PARSE$(raw$)
    RETURN MAP.SIZE(dialog_rules)
ENDFUNC

EXPORT DIM story AS MAP = {}
EXPORT DIM g_act_events AS ARRAY = []

' Load story.json - defines the act roster and triggers. Initialises
' act_status in world_state: every act starts as "pending", except
' those with active_when_no_other = true which seed as "active".
EXPORT FUNC load_story(path)
    DIM raw$ = TXTREADER$(path)
    story = JSON.PARSE$(raw$)
    IF MAP.SIZE(world_state) = 0 THEN RETURN MAP.SIZE(story)
    IF MAP.EXISTS(world_state, "act_status") <> TRUE THEN
        world_state{"act_status"} = {}
    ENDIF
    DIM acts = story{"acts"}
    FOR i = 0 TO LEN(acts) - 1
        DIM a = acts[i]
        DIM aid = a{"id"}
        IF MAP.EXISTS(world_state{"act_status"}, aid) <> TRUE THEN
            IF MAP.EXISTS(a, "active_when_no_other") = TRUE ANDALSO a{"active_when_no_other"} = TRUE THEN
                world_state{"act_status"}{aid} = "active"
            ELSE
                world_state{"act_status"}{aid} = "pending"
            ENDIF
        ENDIF
    NEXT
    RETURN MAP.SIZE(story)
ENDFUNC

' Test whether every flag in `keys` is currently TRUE in
' world_state.flags. Empty keys list returns TRUE (vacuously
' satisfied) - used for the seeding act_when_no_other path.
FUNC all_flags_true(keys)
    IF LEN(keys) = 0 THEN RETURN TRUE
    FOR i = 0 TO LEN(keys) - 1
        IF MAP.EXISTS(world_state{"flags"}, keys[i]) <> TRUE THEN RETURN FALSE
        IF world_state{"flags"}{keys[i]} <> TRUE THEN RETURN FALSE
    NEXT
    RETURN TRUE
ENDFUNC

' Re-evaluate every act: pending -> active when its triggers fire,
' active -> completed when its completes_when_all_true list lights
' up. Emits log events for every state change so the UI can surface
' "A new chapter begins...". Idempotent - safe to call every flag flip.
EXPORT FUNC check_story_progression()
    IF MAP.SIZE(story) = 0 THEN RETURN 0
    IF MAP.EXISTS(world_state, "act_status") <> TRUE THEN RETURN 0
    DIM acts = story{"acts"}
    DIM changed = 0
    FOR i = 0 TO LEN(acts) - 1
        DIM a = acts[i]
        DIM aid = a{"id"}
        DIM st = world_state{"act_status"}{aid}
        IF st = "pending" THEN
            DIM trigs = a{"triggers"}
            IF LEN(trigs) > 0 ANDALSO all_flags_true(trigs) THEN
                world_state{"act_status"}{aid} = "active"
                DIM ev1 AS MAP = {}
                ev1{"kind"} = "act_started"
                ev1{"id"} = aid
                ev1{"title"} = a{"title"}
                g_act_events = APPEND(g_act_events, ev1)
                log_event("Day " + STR$(world_state{"day"}) + ": act started -> " + aid)
                changed = changed + 1
            ENDIF
        ELSEIF st = "active" THEN
            DIM cmps = a{"completes_when_all_true"}
            IF LEN(cmps) > 0 ANDALSO all_flags_true(cmps) THEN
                world_state{"act_status"}{aid} = "completed"
                DIM ev2 AS MAP = {}
                ev2{"kind"} = "act_completed"
                ev2{"id"} = aid
                ev2{"title"} = a{"title"}
                g_act_events = APPEND(g_act_events, ev2)
                log_event("Day " + STR$(world_state{"day"}) + ": act completed -> " + aid)
                changed = changed + 1
            ENDIF
        ENDIF
    NEXT
    RETURN changed
ENDFUNC

' Drain accumulated act-state-change events so GDScript can announce
' them once and clear the queue. Returns the array and resets.
EXPORT FUNC drain_act_events()
    DIM events = g_act_events
    g_act_events = []
    RETURN events
ENDFUNC

' Renders the active-acts section of the system prompt. Lists
' every currently-active act with its narrative line so the LLM
' colours its responses toward the current story beat.
FUNC build_active_acts_block(id)
    IF MAP.SIZE(story) = 0 THEN RETURN ""
    IF MAP.EXISTS(world_state, "act_status") <> TRUE THEN RETURN ""
    DIM acts = story{"acts"}
    DIM count = 0
    DIM out = ""
    FOR i = 0 TO LEN(acts) - 1
        DIM a = acts[i]
        DIM st = world_state{"act_status"}{a{"id"}}
        IF st = "active" THEN
            DIM ln_vars AS MAP = {}
            ln_vars{"title"} = a{"title"}
            ln_vars{"narrative"} = a{"narrative"}
            IF count = 0 THEN
                out = rule("story_block", "header", {})
            ENDIF
            out = out + CHR$(10) + rule("story_block", "act_line", ln_vars)
            count = count + 1
        ENDIF
    NEXT
    RETURN out
ENDFUNC

EXPORT FUNC load_world_state(path)
    DIM raw$ = TXTREADER$(path)
    world_state = JSON.PARSE$(raw$)
    RETURN MAP.SIZE(world_state)
ENDFUNC

' ── World-state tick + mutators ────────────────────────────────────

' Called from GDScript whenever the Day/Night cycle crosses midnight.
' Increments day + days_since_arrival, logs a sunrise marker, and
' optionally shifts the mood once specific flags have flipped.
EXPORT FUNC advance_world_day()
    world_state{"day"} = world_state{"day"} + 1
    world_state{"counters"}{"days_since_arrival"} = world_state{"counters"}{"days_since_arrival"} + 1
    log_event("Dawn of day " + STR$(world_state{"day"}))
    recompute_mood()
    RETURN world_state{"day"}
ENDFUNC

' Mood shifts based on accumulated flags. Cheap rules - the LLM
' picks up the new descriptor on the next prompt and tone shifts
' naturally.
FUNC recompute_mood()
    DIM flags = world_state{"flags"}
    DIM new_mood = "peaceful"
    IF flags{"saw_tracks"} = TRUE THEN new_mood = "uneasy"
    IF flags{"scouted_north"} = TRUE ANDALSO flags{"saw_tracks"} = TRUE THEN new_mood = "tense"
    IF flags{"keep_investigated"} = TRUE THEN new_mood = "foreboding"
    DIM counters = world_state{"counters"}
    IF counters{"wolves_killed"} >= 3 THEN
        world_state{"flags"}{"wolves_thinned"} = TRUE
    ENDIF
    world_state{"mood"} = new_mood
ENDFUNC

' Called by the LLM's set_flag tool. Returns "set" if the flag
' was actually flipped (so GDScript can log it), "noop" if the value
' was already the same, "unknown" if the flag doesn't exist.
' Scan free-form player text for flag triggers using the keyword
' + ctx tables in world_state.flag_triggers. Returns an array of
' matched flag keys (lowercased input, case-insensitive contains).
' Only matches flags that are still false - already-true flags
' won't fire again. Match rule: (any keyword in text) AND
' (any ctx in text) AND (flag still false).
EXPORT FUNC check_flag_triggers(player_msg)
    IF MAP.SIZE(world_state) = 0 THEN RETURN []
    DIM triggers = world_state{"flag_triggers"}
    DIM lc = LCASE$(player_msg)
    DIM keys = MAP.KEYS(triggers)
    DIM hits = []
    FOR i = 0 TO LEN(keys) - 1
        DIM k = keys[i]
        IF world_state{"flags"}{k} <> TRUE THEN
            DIM def = triggers{k}
            DIM kw_arr = def{"keywords"}
            DIM ctx_arr = def{"ctx"}
            DIM kw_hit = FALSE
            FOR j = 0 TO LEN(kw_arr) - 1
                IF INSTR(lc, LCASE$(kw_arr[j])) >= 0 THEN
                    kw_hit = TRUE
                    EXITFOR
                ENDIF
            NEXT
            DIM ctx_hit = FALSE
            IF kw_hit THEN
                FOR j = 0 TO LEN(ctx_arr) - 1
                    IF INSTR(lc, LCASE$(ctx_arr[j])) >= 0 THEN
                        ctx_hit = TRUE
                        EXITFOR
                    ENDIF
                NEXT
            ENDIF
            IF kw_hit ANDALSO ctx_hit THEN
                hits = APPEND(hits, k)
            ENDIF
        ENDIF
    NEXT
    RETURN hits
ENDFUNC

' Scan player text for affinity-shifting cues. Returns the summed
' delta across all matching signal categories (so "danke, mach ich"
' counts as compliment+promise = +8). Caps the absolute return at
' +/-10 so a single turn can't whiplash the relationship.
EXPORT FUNC check_affinity_triggers(player_msg)
    IF MAP.EXISTS(dialog_rules, "affinity_signals") <> TRUE THEN RETURN 0
    DIM signals = dialog_rules{"affinity_signals"}
    DIM cats = MAP.KEYS(signals)
    DIM lc = LCASE$(player_msg)
    DIM total = 0
    FOR ci = 0 TO LEN(cats) - 1
        DIM cat = cats[ci]
        DIM def = signals{cat}
        DIM kws = def{"keywords"}
        DIM hit = FALSE
        FOR ki = 0 TO LEN(kws) - 1
            IF INSTR(lc, LCASE$(kws[ki])) >= 0 THEN
                hit = TRUE
                EXITFOR
            ENDIF
        NEXT
        IF hit THEN total = total + def{"delta"}
    NEXT
    IF total > 10 THEN total = 10
    IF total < -10 THEN total = -10
    RETURN total
ENDFUNC

' Push a rumor onto world_state.rumors with the current day stamp.
' Drops the oldest entry once the buffer exceeds dialog_rules.rumor_max
' (default 6). source_id is the NPC who first heard the news from the
' player, so the rumor block can hide it from that same NPC's prompt.
EXPORT FUNC push_rumor(source_id, body)
    IF MAP.SIZE(world_state) = 0 THEN RETURN 0
    DIM entry AS MAP = {}
    entry{"day"} = world_state{"day"}
    entry{"source"} = source_id
    DIM src_name = source_id
    IF MAP.EXISTS(npcs, source_id) = TRUE THEN
        src_name = npcs{source_id}{"name"}
    ENDIF
    entry{"source_name"} = src_name
    entry{"text"} = body
    world_state{"rumors"} = APPEND(world_state{"rumors"}, entry)
    DIM cap = 6
    IF MAP.EXISTS(dialog_rules, "rumor_max") = TRUE THEN cap = dialog_rules{"rumor_max"}
    DIM rs = world_state{"rumors"}
    IF LEN(rs) > cap THEN
        DIM trimmed = []
        DIM start = LEN(rs) - cap
        FOR i = start TO LEN(rs) - 1
            trimmed = APPEND(trimmed, rs[i])
        NEXT
        world_state{"rumors"} = trimmed
    ENDIF
    RETURN LEN(world_state{"rumors"})
ENDFUNC

' Look up the rumor template for a flag key, splice the NPC's name
' in for {npc}. Returns "" if no template is defined for the flag.
FUNC rumor_text_for_flag(flag_key, npc_name)
    IF MAP.EXISTS(dialog_rules, "rumor_templates") <> TRUE THEN RETURN ""
    DIM tmpls = dialog_rules{"rumor_templates"}
    IF MAP.EXISTS(tmpls, flag_key) <> TRUE THEN RETURN ""
    RETURN REPLACE$(tmpls{flag_key}, "{npc}", npc_name)
ENDFUNC

EXPORT FUNC set_world_flag(flag_key, value)
    IF MAP.EXISTS(world_state{"flags"}, flag_key) <> TRUE THEN RETURN "unknown"
    DIM cur = world_state{"flags"}{flag_key}
    DIM new_val = FALSE
    IF value = "true" ORELSE value = "TRUE" ORELSE value = 1 ORELSE value = TRUE THEN new_val = TRUE
    IF cur = new_val THEN RETURN "noop"
    world_state{"flags"}{flag_key} = new_val
    log_event("Day " + STR$(world_state{"day"}) + ": " + flag_key + " = " + STR$(new_val))
    recompute_mood()
    check_story_progression()
    IF new_val = TRUE THEN auto_complete_quests_for_flag(flag_key)
    RETURN "set"
ENDFUNC

' Walk every NPC's quest list and complete any whose completes_on_flag
' matches the just-flipped flag. Idempotent: complete_quest_by_id is
' already a no-op when the quest is already in player_state.completed.
FUNC auto_complete_quests_for_flag(flag_key)
    DIM ids = MAP.KEYS(npcs)
    FOR i = 0 TO LEN(ids) - 1
        DIM gid = ids[i]
        DIM gq = npcs{gid}{"quests"}
        IF LEN(gq) > 0 THEN
            DIM q = gq[0]
            IF MAP.EXISTS(q, "completes_on_flag") = TRUE ANDALSO q{"completes_on_flag"} = flag_key THEN
                complete_quest_by_id(q{"id"})
            ENDIF
        ENDIF
    NEXT
ENDFUNC

EXPORT FUNC inc_world_counter(key, delta)
    IF MAP.EXISTS(world_state{"counters"}, key) <> TRUE THEN RETURN -1
    world_state{"counters"}{key} = world_state{"counters"}{key} + delta
    RETURN world_state{"counters"}{key}
ENDFUNC

FUNC log_event(msg)
    world_state{"events_log"} = APPEND(world_state{"events_log"}, msg)
    DIM log = world_state{"events_log"}
    DIM excess = LEN(log) - g_world_log_max
    IF excess > 0 THEN
        DIM trimmed = []
        FOR i = excess TO LEN(log) - 1
            trimmed = APPEND(trimmed, log[i])
        NEXT
        world_state{"events_log"} = trimmed
    ENDIF
ENDFUNC

' Compact summary that goes into every NPC's system prompt. Two
' lines: a header with day/mood, and any active flags + recent
' events the NPCs should be aware of.
FUNC build_world_state_summary()
    IF MAP.SIZE(world_state) = 0 THEN RETURN ""
    DIM day = world_state{"day"}
    DIM mood = world_state{"mood"}
    DIM mood_text = ""
    IF MAP.EXISTS(world_state, "moods") = TRUE THEN
        DIM moods = world_state{"moods"}
        IF MAP.EXISTS(moods, mood) = TRUE THEN mood_text = " - " + moods{mood}
    ENDIF
    DIM out = "Day " + STR$(day) + ". World mood: " + mood + mood_text
    DIM active_flags = ""
    DIM fkeys = MAP.KEYS(world_state{"flags"})
    FOR i = 0 TO LEN(fkeys) - 1
        IF world_state{"flags"}{fkeys[i]} = TRUE THEN
            IF LEN(active_flags) > 0 THEN active_flags = active_flags + ", "
            active_flags = active_flags + fkeys[i]
        ENDIF
    NEXT
    IF LEN(active_flags) > 0 THEN
        out = out + CHR$(10) + "Established facts in this world: " + active_flags
    ENDIF
    DIM log = world_state{"events_log"}
    IF LEN(log) > 0 THEN
        out = out + CHR$(10) + "Recent events:"
        DIM start = LEN(log) - 4
        IF start < 0 THEN start = 0
        FOR i = start TO LEN(log) - 1
            out = out + CHR$(10) + "  - " + log[i]
        NEXT
    ENDIF
    RETURN out
ENDFUNC

' Boot the LLM. model_path is an OS path to a GGUF file. Returns the
' llama.cpp model id.
' n_gpu_layers default 99 = "everything on GPU". Override via dialog_init
' to test whether CUDA loading is the failure source.
EXPORT FUNC dialog_init(model_path)
    RETURN dialog_init_with(model_path, 99)
ENDFUNC

EXPORT FUNC dialog_init_with(model_path, n_gpu)
    g_llm = AI.LOAD_LLM(model_path, 8192, n_gpu)
    AI.SET(g_llm, "max_tokens", 400)
    AI.SET(g_llm, "temperature", 0.7)
    ' Qwen2.5-7B-Instruct is reliable at following "output only JSON"
    ' from the prompt; the GBNF grammar path caused empty completions
    ' on the 2nd / 3rd generation. parse_actions defensively wraps
    ' any non-JSON output as a plain say so the player still sees it.
    RETURN g_llm
ENDFUNC

' ── RAG initialisation ────────────────────────────────────────────
' Loads the embedding model + creates a dense-mode RAG store, then
' adds every .md in lore_dir. Each file's chunks carry its basename
' (e.g. "forest_and_wildlife") as source - used later for filtering
' a search result down to the chunks an NPC would plausibly know.

EXPORT FUNC rag_init(embed_path, lore_dir)
    g_embed_llm = AI.LOAD_EMBEDDINGS(embed_path, 512, 99)
    g_rag = AI.RAG_CREATE(g_llm, 500, 50, g_embed_llm)
    DIM stats = AI.RAG_ADD_DIR(g_rag, lore_dir, "*.md", 1)
    RETURN stats
ENDFUNC

' Extracts the basename (no extension) from a source path so we can
' compare against an NPC's lore_tags list.
FUNC source_basename(source_str)
    DIM s = source_str
    ' Strip directory. INSTR is 0-based; MID$ uses the same offset
    ' so MID$(s, n+1) returns the substring AFTER position n.
    DIM slash = INSTR(s, "/")
    DO WHILE slash >= 0
        s = MID$(s, slash + 1)
        slash = INSTR(s, "/")
    LOOP
    DIM bslash = INSTR(s, CHR$(92))
    DO WHILE bslash >= 0
        s = MID$(s, bslash + 1)
        bslash = INSTR(s, CHR$(92))
    LOOP
    ' Strip extension
    DIM dot = INSTR(s, ".")
    IF dot >= 0 THEN s = LEFT$(s, dot)
    RETURN s
ENDFUNC

' Returns true if an NPC's lore_tags list contains the given source
' file's basename.
FUNC npc_knows_source(id, source_str)
    DIM tags = npcs{id}{"lore_tags"}
    IF LEN(tags) = 0 THEN RETURN FALSE
    DIM base = source_basename(source_str)
    FOR i = 0 TO LEN(tags) - 1
        IF tags[i] = base THEN RETURN TRUE
    NEXT
    RETURN FALSE
ENDFUNC

' Public: given a query string + NPC id, return up to g_rag_per_npc
' relevant lore chunks formatted as bullet lines. Empty if RAG isn't
' initialised or no chunk matches the NPC's expertise.
EXPORT FUNC retrieve_context(id, query)
    IF g_rag = 0 THEN RETURN ""
    DIM hits = AI.RAG_SEARCH(g_rag, query, g_rag_top_k)
    IF LEN(hits) = 0 THEN RETURN ""
    DIM out = ""
    DIM kept = 0
    FOR i = 0 TO LEN(hits) - 1
        IF kept >= g_rag_per_npc THEN EXITFOR
        DIM h = hits[i]
        DIM src = h{"source"}
        IF npc_knows_source(id, src) = TRUE THEN
            DIM base = source_basename(src)
            out = out + "- [" + base + "] " + h{"text"} + CHR$(10)
            kept = kept + 1
        ENDIF
    NEXT
    IF LEN(out) = 0 THEN RETURN ""
    RETURN rule("prompt_labels", "relevant_context_label", {}) + CHR$(10) + out
ENDFUNC

' ── Template renderer ─────────────────────────────────────────────
' Reads a .tmpl file, substitutes {{key}} placeholders from the vars
' map. Used to compose the per-NPC system prompt from a shared
' template + dynamic facts pulled from npcs / player_state / world.

EXPORT DIM g_template_path = "godot/rpg-demo/prompts/dialog_system.tmpl"

EXPORT FUNC render_template(path, vars)
    DIM tmpl = TXTREADER$(path)
    DIM keys = MAP.KEYS(vars)
    FOR i = 0 TO LEN(keys) - 1
        DIM key = keys[i]
        DIM placeholder = "{{" + key + "}}"
        tmpl = REPLACE$(tmpl, placeholder, vars{key})
    NEXT
    RETURN tmpl
ENDFUNC

' Render a single-line template string from dialog_rules with
' {placeholder} substitution. Used for every prompt fragment, system
' line, and synthetic reply that previously lived as a string literal
' in jdBasic. Returns empty if the rule path doesn't resolve.
EXPORT FUNC rule(category, key, vars)
    IF MAP.EXISTS(dialog_rules, category) <> TRUE THEN RETURN ""
    DIM cat = dialog_rules{category}
    IF MAP.EXISTS(cat, key) <> TRUE THEN RETURN ""
    DIM tmpl = cat{key}
    DIM keys = MAP.KEYS(vars)
    FOR i = 0 TO LEN(keys) - 1
        DIM k = keys[i]
        tmpl = REPLACE$(tmpl, "{" + k + "}", vars{k})
    NEXT
    RETURN tmpl
ENDFUNC

' Section builders - each returns a string fragment that the template
' splices into the system prompt. Keeping them as small functions
' makes it cheap to iterate on individual sections.

FUNC build_quest_block(id)
    DIM s = npcs{id}
    IF LEN(s{"quests"}) = 0 THEN RETURN ""
    DIM q = s{"quests"}[0]
    IF s{"quest_completed"} = TRUE THEN
        RETURN rule("prompt_labels", "quest_completed", {})
    ENDIF
    DIM vars AS MAP = {}
    vars{"id"} = q{"id"}
    IF s{"quest_offered"} = TRUE THEN
        RETURN rule("prompt_labels", "quest_already_offered", vars)
    ENDIF
    vars{"desc"} = q{"description"}
    DIM out = rule("prompt_labels", "quest_offer_intro", vars)
    DIM has_item = FALSE
    DIM item_name = ""
    IF MAP.EXISTS(q, "item_given") = TRUE THEN
        item_name = q{"item_given"}
        IF LEN(item_name) > 0 THEN has_item = TRUE
    ENDIF
    ' Acceptance signals and quest-offer rule live in dialog_rules.json
    ' so they can be tuned / translated without touching code.
    DIM signals_csv = ""
    IF MAP.EXISTS(dialog_rules, "acceptance_signals") = TRUE THEN
        DIM sigs = dialog_rules{"acceptance_signals"}
        FOR i = 0 TO LEN(sigs) - 1
            IF i > 0 THEN signals_csv = signals_csv + ", "
            signals_csv = signals_csv + "'" + sigs[i] + "'"
        NEXT
    ENDIF
    IF LEN(signals_csv) > 0 THEN
        out = out + CHR$(10) + "Acceptance signals (any language, case-insensitive): " + signals_csv
    ENDIF
    DIM rule = ""
    IF MAP.EXISTS(dialog_rules, "quest_offer_instruction") = TRUE THEN
        rule = dialog_rules{"quest_offer_instruction"}
    ENDIF
    IF LEN(rule) > 0 THEN
        DIM with_item = " in the same offer_quest response"
        IF has_item = TRUE THEN
            with_item = " in the SAME response (also include give_item with name '" + item_name + "')"
        ENDIF
        out = out + CHR$(10) + rule + with_item
    ENDIF
    RETURN out
ENDFUNC

' Whitelist of items this NPC may emit via give_item. Derived from
' the quest's item_given for now; later we can attach an explicit
' "inventory" field per NPC. Used both for prompt scoping and the
' GDScript-side validation pass.
EXPORT FUNC available_items(id)
    DIM out = []
    DIM s = npcs{id}
    ' Once the quest has been offered the item has been handed over -
    ' don't list it as available any more so the LLM can't re-gift it.
    IF s{"quest_offered"} = TRUE THEN RETURN out
    IF LEN(s{"quests"}) > 0 THEN
        DIM q = s{"quests"}[0]
        IF MAP.EXISTS(q, "item_given") = TRUE THEN
            IF LEN(q{"item_given"}) > 0 THEN
                out = APPEND(out, q{"item_given"})
            ENDIF
        ENDIF
    ENDIF
    RETURN out
ENDFUNC

' Tell the LLM which world flags are valid for the set_flag tool.
' Anything not on this list gets silently dropped by dispatch, so
' inlining the list lets the model pick the right key.
FUNC build_flag_constraints()
    IF MAP.SIZE(world_state) = 0 THEN RETURN ""
    DIM keys = MAP.KEYS(world_state{"flags"})
    IF LEN(keys) = 0 THEN RETURN ""
    ' Only advertise flags that aren't already TRUE (no point asking
    ' the LLM to re-set them). Two-pass: build the comma list + count,
    ' then iterate the same keys array a second time for the cheatsheet
    ' so we don't need a runtime-typed intermediate array.
    DIM available = ""
    DIM count = 0
    FOR i = 0 TO LEN(keys) - 1
        IF world_state{"flags"}{keys[i]} <> TRUE THEN
            IF count > 0 THEN available = available + ", "
            available = available + "'" + keys[i] + "'"
            count = count + 1
        ENDIF
    NEXT
    IF count = 0 THEN RETURN ""
    DIM sub_vars AS MAP = {}
    sub_vars{"list"} = available
    DIM out = ""
    DIM ln_text = rule("flag_constraints", "header", {})
    IF LEN(ln_text) > 0 THEN out = out + ln_text
    ln_text = rule("flag_constraints", "subheader", sub_vars)
    IF LEN(ln_text) > 0 THEN out = out + CHR$(10) + ln_text
    ln_text = rule("flag_constraints", "cheatsheet_header", {})
    IF LEN(ln_text) > 0 THEN out = out + CHR$(10) + ln_text
    DIM triggers = world_state{"flag_triggers"}
    FOR i = 0 TO LEN(keys) - 1
        IF world_state{"flags"}{keys[i]} <> TRUE THEN
            DIM k = keys[i]
            IF MAP.EXISTS(triggers, k) THEN
                DIM ln_vars AS MAP = {}
                ln_vars{"key"} = k
                ln_vars{"hint"} = triggers{k}{"hint"}
                out = out + CHR$(10) + rule("flag_constraints", "cheatsheet_line", ln_vars)
            ENDIF
        ENDIF
    NEXT
    ln_text = rule("flag_constraints", "example_header", {})
    IF LEN(ln_text) > 0 THEN out = out + CHR$(10) + ln_text
    ln_text = rule("flag_constraints", "example_line", {})
    IF LEN(ln_text) > 0 THEN out = out + CHR$(10) + ln_text
    ln_text = rule("flag_constraints", "directive", {})
    IF LEN(ln_text) > 0 THEN out = out + CHR$(10) + ln_text
    RETURN out
ENDFUNC

FUNC build_item_constraints(id)
    DIM items = available_items(id)
    IF LEN(items) = 0 THEN
        RETURN rule("prompt_labels", "items_none", {})
    ENDIF
    DIM list = ""
    FOR i = 0 TO LEN(items) - 1
        IF i > 0 THEN list = list + ", "
        list = list + "'" + items[i] + "'"
    NEXT
    DIM vars AS MAP = {}
    vars{"list"} = list
    RETURN rule("prompt_labels", "items_allowed", vars)
ENDFUNC

FUNC build_world_context()
    IF MAP.SIZE(world_lore) = 0 THEN RETURN ""
    DIM out = ""
    IF MAP.EXISTS(world_lore, "setting") = TRUE THEN out = out + "World setting: " + world_lore{"setting"} + CHR$(10)
    IF MAP.EXISTS(world_lore, "geography") = TRUE THEN out = out + "Geography: " + world_lore{"geography"} + CHR$(10)
    IF MAP.EXISTS(world_lore, "current_state") = TRUE THEN out = out + "Current state: " + world_lore{"current_state"}
    RETURN out
ENDFUNC

FUNC build_cross_facts(id)
    DIM out = ""
    DIM others = MAP.KEYS(npcs)
    DIM expected = ""
    DIM already_received = ""
    FOR i = 0 TO LEN(others) - 1
        DIM oid = others[i]
        IF oid <> id THEN
            DIM oq = npcs{oid}{"quests"}
            IF LEN(oq) > 0 THEN
                IF MAP.EXISTS(oq[0], "target_npc") = TRUE THEN
                    IF oq[0]{"target_npc"} = id THEN
                        IF MAP.EXISTS(oq[0], "item_given") = TRUE THEN
                            IF LEN(oq[0]{"item_given"}) > 0 THEN
                                DIM item = oq[0]{"item_given"}
                                DIM giver = npcs{oid}{"name"}
                                IF npcs{oid}{"quest_completed"} = TRUE THEN
                                    already_received = already_received + " '" + item + "' from " + giver + ";"
                                ELSE
                                    expected = expected + " '" + item + "' from " + giver + ";"
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT
    IF LEN(expected) > 0 THEN
        DIM v1 AS MAP = {}
        v1{"list"} = expected
        out = out + rule("prompt_labels", "expecting_deliveries_intro", v1) + CHR$(10)
        out = out + rule("prompt_labels", "expecting_deliveries_action", {}) + CHR$(10)
    ENDIF
    IF LEN(already_received) > 0 THEN
        DIM v2 AS MAP = {}
        v2{"list"} = already_received
        out = out + rule("prompt_labels", "already_received_intro", v2) + CHR$(10)
        out = out + rule("prompt_labels", "already_received_action", {})
    ENDIF
    RETURN out
ENDFUNC

FUNC build_player_state()
    DIM out = ""
    IF LEN(player_state{"inventory"}) > 0 THEN
        out = out + rule("prompt_labels", "player_inventory_label", {})
        DIM inv = player_state{"inventory"}
        FOR i = 0 TO LEN(inv) - 1
            out = out + " " + inv[i]{"name"}
            IF i < LEN(inv) - 1 THEN out = out + ","
        NEXT
        out = out + CHR$(10)
    ELSE
        out = out + rule("prompt_labels", "player_inventory_empty", {}) + CHR$(10)
    ENDIF
    IF LEN(player_state{"active"}) > 0 THEN
        out = out + rule("prompt_labels", "active_quests_label", {})
        DIM act = player_state{"active"}
        FOR i = 0 TO LEN(act) - 1
            DIM v AS MAP = {}
            v{"id"} = act[i]{"id"}
            v{"desc"} = act[i]{"description"}
            v{"giver"} = act[i]{"giver_name"}
            out = out + CHR$(10) + rule("prompt_labels", "active_quest_entry", v)
        NEXT
    ENDIF
    RETURN out
ENDFUNC

' Build the per-NPC system prompt via the .tmpl file. Section
' builders above produce small string fragments; render_template
' splices them into the placeholders.
EXPORT FUNC build_sys(id)
    DIM s = npcs{id}
    DIM vars AS MAP = {}
    vars{"npc_name"} = s{"name"}
    vars{"persona"} = s{"persona"}
    vars{"legend"} = s{"legend"}
    vars{"knowledge"} = s{"knowledge"}
    vars{"quest_block"} = build_quest_block(id)
    vars{"item_constraints"} = build_item_constraints(id)
    vars{"flag_constraints"} = build_flag_constraints()
    vars{"world_context"} = build_world_context()
    vars{"cross_npc_facts"} = build_cross_facts(id)
    vars{"player_state"} = build_player_state()
    vars{"long_term_memory"} = build_long_term(id)
    vars{"recent_history"} = build_recent(id)
    vars{"relevant_context"} = build_relevant_context(id)
    vars{"world_state_summary"} = build_world_state_summary()
    vars{"affinity_block"} = build_affinity_block(id)
    vars{"rumor_block"} = build_rumor_block(id)
    vars{"active_acts"} = build_active_acts_block(id)
    RETURN render_template(g_template_path, vars)
ENDFUNC

' Look up which descriptor row matches the given score. Returns a
' MAP with "label" and "phrase" keys (phrase still has {npc} unresolved
' so callers can splice the actual NPC name in).
FUNC affinity_descriptor(score)
    IF MAP.EXISTS(dialog_rules, "affinity_descriptors") <> TRUE THEN
        DIM fallback AS MAP = {}
        fallback{"label"} = "neutral"
        fallback{"phrase"} = ""
        RETURN fallback
    ENDIF
    DIM rows = dialog_rules{"affinity_descriptors"}
    FOR i = 0 TO LEN(rows) - 1
        DIM r = rows[i]
        IF score >= r{"min"} ANDALSO score <= r{"max"} THEN RETURN r
    NEXT
    DIM none AS MAP = {}
    none{"label"} = "neutral"
    none{"phrase"} = ""
    RETURN none
ENDFUNC

' Public helper for Godot's journal panel: just the descriptor label
' (e.g. "trusts" / "friendly" / "neutral"). Empty string if dialog_rules
' isn't loaded yet.
EXPORT FUNC affinity_label_for(id)
    IF MAP.EXISTS(npcs, id) <> TRUE THEN RETURN ""
    DIM score = npcs{id}{"affinity"}
    DIM desc = affinity_descriptor(score)
    RETURN desc{"label"}
ENDFUNC

EXPORT FUNC npc_display_name(id)
    IF MAP.EXISTS(npcs, id) <> TRUE THEN RETURN id
    RETURN npcs{id}{"name"}
ENDFUNC

' Render the rumors block for an NPC's system prompt. Filters out
' rumors the NPC itself was the source of (otherwise Tylen would
' read "Tylen says Atomi found tracks" - silly).
FUNC build_rumor_block(id)
    IF MAP.SIZE(world_state) = 0 THEN RETURN ""
    IF MAP.EXISTS(world_state, "rumors") <> TRUE THEN RETURN ""
    DIM rs = world_state{"rumors"}
    IF LEN(rs) = 0 THEN RETURN ""
    DIM count = 0
    DIM out = ""
    FOR i = 0 TO LEN(rs) - 1
        DIM r = rs[i]
        IF r{"source"} <> id THEN
            DIM src_name = r{"source"}
            IF MAP.EXISTS(r, "source_name") = TRUE THEN
                src_name = r{"source_name"}
            ENDIF
            DIM ln_vars AS MAP = {}
            ln_vars{"day"} = STR$(r{"day"})
            ln_vars{"source"} = src_name
            ln_vars{"text"} = r{"text"}
            IF count = 0 THEN
                out = rule("rumor_block", "header", {})
            ENDIF
            out = out + CHR$(10) + rule("rumor_block", "line", ln_vars)
            count = count + 1
        ENDIF
    NEXT
    RETURN out
ENDFUNC

FUNC build_affinity_block(id)
    IF MAP.EXISTS(npcs{id}, "affinity") <> TRUE THEN RETURN ""
    DIM score = npcs{id}{"affinity"}
    DIM desc = affinity_descriptor(score)
    DIM hdr_vars AS MAP = {}
    hdr_vars{"score"} = STR$(score)
    hdr_vars{"label"} = desc{"label"}
    DIM phrase_vars AS MAP = {}
    phrase_vars{"phrase"} = REPLACE$(desc{"phrase"}, "{npc}", npcs{id}{"name"})
    DIM out = rule("affinity_block", "header", hdr_vars)
    IF LEN(desc{"phrase"}) > 0 THEN
        out = out + CHR$(10) + rule("affinity_block", "phrase_line", phrase_vars)
    ENDIF
    RETURN out
ENDFUNC

FUNC build_relevant_context(id)
    DIM s = npcs{id}
    IF MAP.EXISTS(s, "last_query") <> TRUE THEN RETURN ""
    DIM q = s{"last_query"}
    IF LEN(q) = 0 THEN RETURN ""
    RETURN retrieve_context(id, q)
ENDFUNC

FUNC build_long_term(id)
    DIM lt = npcs{id}{"long_term"}
    IF LEN(lt) = 0 THEN RETURN ""
    RETURN rule("prompt_labels", "long_term_label", {}) + CHR$(10) + lt
ENDFUNC

FUNC build_recent(id)
    DIM recent = format_recent_turns(id)
    IF LEN(recent) = 0 THEN RETURN ""
    RETURN rule("prompt_labels", "recent_history_label", {}) + CHR$(10) + recent
ENDFUNC

' Legacy section-based prompt (kept as reference, unused).
FUNC build_sys_old(id)
    DIM s = npcs{id}
    DIM sys = "You are " + s{"name"} + ". Stay in character at all times."
    sys = sys + CHR$(10) + "Persona: " + s{"persona"}

    ' --- Critical now-context (top of prompt for max attention) ---

    ' Cross-NPC awareness: deliveries this NPC is expecting.
    DIM expected = ""
    DIM other_ids = MAP.KEYS(npcs)
    FOR i = 0 TO LEN(other_ids) - 1
        DIM oid = other_ids[i]
        IF oid <> id THEN
            DIM oq = npcs{oid}{"quests"}
            IF LEN(oq) > 0 THEN
                IF MAP.EXISTS(oq[0], "target_npc") = TRUE THEN
                    IF oq[0]{"target_npc"} = id THEN
                        IF MAP.EXISTS(oq[0], "item_given") = TRUE ANDALSO LEN(oq[0]{"item_given"}) > 0 THEN
                            expected = expected + " '" + oq[0]{"item_given"} + "' from " + npcs{oid}{"name"} + ";"
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT

    sys = sys + CHR$(10) + CHR$(10) + "=== CHECK THIS BEFORE REPLYING ==="
    IF LEN(player_state{"inventory"}) > 0 THEN
        sys = sys + CHR$(10) + "Player inventory:"
        DIM inv = player_state{"inventory"}
        FOR i = 0 TO LEN(inv) - 1
            sys = sys + " " + inv[i]{"name"}
            IF i < LEN(inv) - 1 THEN sys = sys + ","
        NEXT
    ELSE
        sys = sys + CHR$(10) + "Player inventory: empty."
    ENDIF
    IF LEN(expected) > 0 THEN
        sys = sys + CHR$(10) + "YOU ARE EXPECTING:" + expected
        sys = sys + CHR$(10) + "If ANY expected item is in the player inventory, your FIRST sentence must acknowledge it gladly and accept the handover. Do not bring up your own quests until after you accept the delivery."
    ENDIF
    IF LEN(player_state{"active"}) > 0 THEN
        sys = sys + CHR$(10) + "Active quests the player already holds:"
        DIM act = player_state{"active"}
        FOR i = 0 TO LEN(act) - 1
            sys = sys + CHR$(10) + "  - '" + act[i]{"description"} + "' (from " + act[i]{"giver_name"} + ")"
        NEXT
        sys = sys + CHR$(10) + "Do not re-offer a quest the player has already accepted."
    ENDIF

    sys = sys + CHR$(10) + "Role boundary: YOU are " + s{"name"} + " (a stationary NPC). The PLAYER is the traveling adventurer. Never offer to fetch, deliver, gather, or scout - those are the player's actions, not yours."

    ' --- Flavour ---

    sys = sys + CHR$(10) + CHR$(10) + "Background: " + s{"legend"}
    sys = sys + CHR$(10) + "What you personally know: " + s{"knowledge"}
    IF LEN(s{"quests"}) > 0 THEN
        DIM mine = s{"quests"}[0]
        sys = sys + CHR$(10) + "Quest you can offer (only if not already accepted): " + mine{"description"}
    ENDIF

    ' --- World lore (setting context, less critical per turn) ---

    IF MAP.EXISTS(world_lore, "setting") = TRUE THEN
        sys = sys + CHR$(10) + CHR$(10) + "World setting: " + world_lore{"setting"}
    ENDIF
    IF MAP.EXISTS(world_lore, "geography") = TRUE THEN
        sys = sys + CHR$(10) + "Geography: " + world_lore{"geography"}
    ENDIF
    IF MAP.EXISTS(world_lore, "current_state") = TRUE THEN
        sys = sys + CHR$(10) + "Current state: " + world_lore{"current_state"}
    ENDIF
    IF MAP.EXISTS(world_lore, "npc_roster") = TRUE THEN
        sys = sys + CHR$(10) + "Other people in the area:"
        DIM roster = world_lore{"npc_roster"}
        FOR i = 0 TO LEN(roster) - 1
            sys = sys + CHR$(10) + "- " + roster[i]{"name"} + " (" + roster[i]{"role"} + ")"
        NEXT
    ENDIF

    ' --- Rules last so they're freshest in working memory ---

    IF MAP.EXISTS(world_lore, "rules") = TRUE THEN
        sys = sys + CHR$(10) + CHR$(10) + "Rules:"
        DIM rules = world_lore{"rules"}
        FOR i = 0 TO LEN(rules) - 1
            sys = sys + CHR$(10) + "- " + rules[i]
        NEXT
    ENDIF

    RETURN sys
ENDFUNC

' Strip hallucinated continuation past the NPC's own turn. Phi-3
' occasionally writes "Maelyn: ...\nPlayer: ...\nMaelyn: ..." or
' tacks on "(Note: This response ...)" meta-commentary at the end.
' We cut at every known leak pattern and trim the result.
FUNC clean_reply(id, raw)
    DIM r = raw
    DIM nl_player = CHR$(10) + "Player:"
    DIM idx = INSTR(r, nl_player)
    IF idx >= 0 THEN r = LEFT$(r, idx)
    DIM nl_self = CHR$(10) + npcs{id}{"name"} + ":"
    idx = INSTR(r, nl_self)
    IF idx >= 0 THEN r = LEFT$(r, idx)
    ' Meta-commentary leak: cut at ANY double-newline. In-character
    ' replies should be 1-3 sentences in a single paragraph, so any
    ' "\n\n" almost always precedes "In this response..." style
    ' disclaimers or fake follow-up turns.
    idx = INSTR(r, CHR$(10) + CHR$(10))
    IF idx >= 0 THEN r = LEFT$(r, idx)
    ' Disclaimer one-liner: "(Note:" / "(NB:" / "(P.S." anywhere.
    idx = INSTR(r, "(Note")
    IF idx >= 0 THEN r = LEFT$(r, idx)
    idx = INSTR(r, "(NB")
    IF idx >= 0 THEN r = LEFT$(r, idx)
    idx = INSTR(r, "(P.S")
    IF idx >= 0 THEN r = LEFT$(r, idx)
    ' Bullet/headed meta-leak after a newline.
    DIM meta_prefixes = ["- Solution", "Solution:", "Explanation:", "Reasoning:", "Clarification:", "Reply:", "Response:", "reply:", "In this response", "In this scenario", "Improved response", "=== ", "===", "Author:", "Note:", "Remark:", "Comment:", "Continuation:", "Action:"]
    FOR i = 0 TO LEN(meta_prefixes) - 1
        idx = INSTR(r, CHR$(10) + meta_prefixes[i])
        IF idx >= 0 THEN r = LEFT$(r, idx)
    NEXT
    ' Inline meta that doesn't start on a fresh line - Phi-3 sometimes
    ' writes "...this little box has Maelyn' Author: This scenario..."
    ' i.e. tacks on the disclaimer mid-paragraph after a space.
    DIM inline_meta = [" Author:", " Note:", " Solution:", " Explanation:", " Reply:", " reply:"]
    FOR i = 0 TO LEN(inline_meta) - 1
        idx = INSTR(r, inline_meta[i])
        IF idx >= 0 THEN r = LEFT$(r, idx)
    NEXT
    ' If the reply STARTS with a meta-label (no leading newline),
    ' strip the label off the front and keep the rest. e.g.
    ' "reply: Deine Suche..." becomes "Deine Suche...".
    DIM start_strips = ["reply:", "Reply:", "Response:", "Action:"]
    FOR i = 0 TO LEN(start_strips) - 1
        DIM lbl = start_strips[i]
        IF LEN(r) >= LEN(lbl) ANDALSO LEFT$(r, LEN(lbl)) = lbl THEN
            r = MID$(r, LEN(lbl) + 1)
            IF LEN(r) > 0 ANDALSO LEFT$(r, 1) = " " THEN r = MID$(r, 2)
        ENDIF
    NEXT
    ' Trim trailing whitespace / newlines / chat-template artefacts.
    ' Qwen's "<|im_end|>" template sometimes bleeds through as "_|" or
    ' "|" trailing junk; strip that before the whitespace pass.
    IF LEN(r) >= 2 ANDALSO RIGHT$(r, 2) = "_|" THEN r = LEFT$(r, LEN(r) - 2)
    DO WHILE LEN(r) > 0 ANDALSO (RIGHT$(r, 1) = CHR$(10) ORELSE RIGHT$(r, 1) = " " ORELSE RIGHT$(r, 1) = "|")
        r = LEFT$(r, LEN(r) - 1)
    LOOP
    ' If Phi-3 prefixed its line with "Maelyn:" itself, strip that.
    DIM self_prefix = npcs{id}{"name"} + ":"
    IF LEN(r) > LEN(self_prefix) THEN
        IF LEFT$(r, LEN(self_prefix)) = self_prefix THEN
            r = MID$(r, LEN(self_prefix) + 1)
            ' Eat one optional leading space
            IF LEN(r) > 0 ANDALSO LEFT$(r, 1) = " " THEN r = MID$(r, 2)
        ENDIF
    ENDIF
    RETURN r
ENDFUNC

' The actual LLM call. Runs in an isolated worker VM - all inputs are
' explicit args because globals don't carry across. JSON grammar is
' enforced model-side (set in dialog_init), so AI.CHAT returns a
' valid JSON string we can JSON.PARSE$ in the main VM.
ASYNC FUNC gen_dialog(llm, sys_prompt, user_prompt)
    AI.SET(llm, "system", sys_prompt)
    AI.CLEAR_HISTORY(llm)
    ' JSON grammar is set once in dialog_init (main VM); the model's
    ' sampler state is shared via the global id-keyed g_llms map, so
    ' the worker's AI.CHAT picks it up automatically.
    RETURN AI.CHAT(llm, user_prompt)
ENDFUNC

' Called every physics frame from GDScript. Drains any finished task
' first, then if idle and an NPC within radius lacks a cached greeting,
' kicks off the next generation.
'
' Returns the id of an NPC that just got a fresh greeting (so GDScript
' can flip its UI marker), or "" otherwise.
' Parse raw text into an actions array. Defensive: if it doesn't
' look like JSON (starts with non-'{' character, ASYNC ERROR
' string, plain prose) we wrap it as a single say so the player
' still gets to see something readable.
' Qwen3 sometimes emits Latin-1 codepoints as Python-style \xHH
' escapes inside JSON strings ("Sch\xf6lerin" instead of UTF-8 or
' "Schölerin"). JSON.PARSE$ then keeps the raw "xf6" bytes
' verbatim. Rewriting \xHH → \u00HH before parsing makes them
' valid JSON unicode escapes (U+00f6 = ö, U+00fc = ü, etc.).
FUNC fix_qwen_hex_escapes(s)
    DIM out = ""
    DIM i = 0
    DIM n = LEN(s)
    DO WHILE i < n
        DIM ch = MID$(s, i, 1)
        IF ch = "\" ANDALSO i + 3 < n ANDALSO MID$(s, i + 1, 1) = "x" THEN
            DIM h1 = MID$(s, i + 2, 1)
            DIM h2 = MID$(s, i + 3, 1)
            IF is_hex_digit(h1) ANDALSO is_hex_digit(h2) THEN
                out = out + "\u00" + h1 + h2
                i = i + 4
            ELSE
                out = out + ch
                i = i + 1
            ENDIF
        ELSE
            out = out + ch
            i = i + 1
        ENDIF
    LOOP
    RETURN out
ENDFUNC

FUNC is_hex_digit(c)
    IF LEN(c) <> 1 THEN RETURN FALSE
    DIM code = ASC(c)
    IF code >= 48 ANDALSO code <= 57 THEN RETURN TRUE   ' 0-9
    IF code >= 65 ANDALSO code <= 70 THEN RETURN TRUE   ' A-F
    IF code >= 97 ANDALSO code <= 102 THEN RETURN TRUE  ' a-f
    RETURN FALSE
ENDFUNC

FUNC parse_actions(raw)
    DIM trimmed = raw
    ' Qwen3 leaks <think>...</think> CoT blocks even with /no_think.
    ' Strip everything up to (and including) a </think> close tag.
    DIM tend = INSTR(trimmed, "</think>")
    IF tend >= 0 THEN
        trimmed = MID$(trimmed, tend + 8)
    ENDIF
    ' Drop everything before the first '{' - some models add a stray
    ' preamble line ("Sure, here:") or a code-fence marker.
    DIM brace = INSTR(trimmed, "{")
    IF brace >= 0 THEN
        trimmed = MID$(trimmed, brace)
    ENDIF
    DO WHILE LEN(trimmed) > 0 ANDALSO (LEFT$(trimmed, 1) = " " ORELSE LEFT$(trimmed, 1) = CHR$(10) ORELSE LEFT$(trimmed, 1) = CHR$(13))
        trimmed = MID$(trimmed, 2)
    LOOP
    IF LEN(trimmed) = 0 ORELSE LEFT$(trimmed, 1) <> "{" THEN
        RETURN [{"tool": "say", "args": {"text": raw}}]
    ENDIF
    trimmed = fix_qwen_hex_escapes(trimmed)
    DIM parsed = JSON.PARSE$(trimmed)
    IF MAP.EXISTS(parsed, "actions") = TRUE THEN RETURN parsed{"actions"}
    RETURN [{"tool": "say", "args": {"text": raw}}]
ENDFUNC

' Legacy adapter (callers further down use this)
FUNC extract_actions(parsed, raw_fallback)
    IF MAP.EXISTS(parsed, "actions") = TRUE THEN RETURN parsed{"actions"}
    RETURN [{"tool": "say", "args": {"text": raw_fallback}}]
ENDFUNC

FUNC extract_say_from_actions(acts)
    IF LEN(acts) = 0 THEN RETURN "..."
    FOR i = 0 TO LEN(acts) - 1
        IF acts[i]{"tool"} = "say" THEN
            DIM args = acts[i]{"args"}
            IF MAP.EXISTS(args, "text") = TRUE THEN RETURN args{"text"}
        ENDIF
    NEXT
    RETURN "..."
ENDFUNC

' Backward-compat for older callers.
FUNC extract_say_text(actions_obj)
    IF MAP.EXISTS(actions_obj, "actions") <> TRUE THEN RETURN "..."
    RETURN extract_say_from_actions(actions_obj{"actions"})
ENDFUNC

EXPORT FUNC prefetch_tick(player_x, player_z, radius)
    DIM finished = ""

    IF g_task <> 0 THEN
        IF THREAD.ISDONE(g_task) THEN
            DIM raw = AWAIT g_task
            g_last_raw = raw
            g_last_who = g_task_npc
            DIM acts = parse_actions(raw)
            DIM say_text = extract_say_from_actions(acts)
            npcs{g_task_npc}{"dialog_cache"} = say_text
            npcs{g_task_npc}{"dialog_actions"} = acts
            npcs{g_task_npc}{"dialog_ready"} = TRUE
            finished = g_task_npc
            g_task = 0
            g_task_npc = ""
        ELSE
            RETURN ""
        ENDIF
    ENDIF

    DIM ids = MAP.KEYS(npcs)
    DIM best_id = ""
    DIM best_d2 = radius * radius
    FOR i = 0 TO LEN(ids) - 1
        DIM id = ids[i]
        DIM s = npcs{id}
        IF s{"dialog_ready"} <> TRUE THEN
            DIM dx = s{"pos_x"} - player_x
            DIM dz = s{"pos_z"} - player_z
            DIM d2 = dx * dx + dz * dz
            IF d2 < best_d2 THEN
                best_d2 = d2
                best_id = id
            ENDIF
        ENDIF
    NEXT

    IF best_id <> "" THEN
        DIM sys = build_sys(best_id)
        DIM user = rule("user_prompts", "greeting_cue", {})
        g_task = gen_dialog(g_llm, sys, user)
        g_task_npc = best_id
    ELSE
        ' No prefetch pending - use the idle time to compact memory.
        maybe_compact_buffer()
    ENDIF

    RETURN finished
ENDFUNC

EXPORT FUNC is_dialog_ready(id)
    RETURN npcs{id}{"dialog_ready"} = TRUE
ENDFUNC

EXPORT FUNC get_dialog(id)
    DIM s = npcs{id}
    IF s{"dialog_ready"} = TRUE THEN RETURN s{"dialog_cache"}
    RETURN ""
ENDFUNC

EXPORT FUNC busy_for()
    RETURN g_task_npc
ENDFUNC

' ── Deterministic delivery handler ────────────────────────────────
' Instead of trusting the LLM to recognise a delivery, jdBasic checks
' the player's inventory against this NPC's expected_items list
' (derived from other NPCs' quests with target_npc = this id).
'
' On a match the function:
'   1. Removes the item from player inventory
'   2. Moves the source quest from active -> completed
'   3. Flags the giver's quest_completed
'   4. Returns a canned thanks line for GDScript to show
'
' Returns "" if there's nothing to deliver here.
EXPORT FUNC check_pending_delivery(id)
    DIM s = npcs{id}
    DIM other_ids = MAP.KEYS(npcs)
    FOR i = 0 TO LEN(other_ids) - 1
        DIM oid = other_ids[i]
        DIM skip = FALSE
        IF oid = id THEN skip = TRUE
        DIM oq AS ARRAY = []
        IF skip = FALSE THEN
            oq = npcs{oid}{"quests"}
            IF LEN(oq) = 0 THEN skip = TRUE
        ENDIF
        IF skip = FALSE THEN
            IF MAP.EXISTS(oq[0], "target_npc") <> TRUE THEN skip = TRUE
        ENDIF
        IF skip = FALSE THEN
            IF oq[0]{"target_npc"} <> id THEN skip = TRUE
        ENDIF
        IF skip = FALSE THEN
            IF MAP.EXISTS(oq[0], "item_given") <> TRUE THEN skip = TRUE
        ENDIF
        DIM expected_item = ""
        IF skip = FALSE THEN
            expected_item = oq[0]{"item_given"}
            IF LEN(expected_item) = 0 THEN skip = TRUE
        ENDIF
        IF skip = FALSE THEN
            DIM inv = player_state{"inventory"}
            DIM found_idx = -1
            FOR j = 0 TO LEN(inv) - 1
                IF inv[j]{"name"} = expected_item THEN
                    found_idx = j
                    EXITFOR
                ENDIF
            NEXT
            IF found_idx >= 0 THEN
                ' Strip the item out of inventory
                DIM new_inv = []
                FOR j = 0 TO LEN(inv) - 1
                    IF j <> found_idx THEN new_inv = APPEND(new_inv, inv[j])
                NEXT
                player_state{"inventory"} = new_inv

                ' Move source quest from active to completed
                DIM quest_id = oq[0]{"id"}
                DIM act = player_state{"active"}
                DIM new_active = []
                DIM completed_entry AS MAP = {}
                DIM had_active = FALSE
                FOR j = 0 TO LEN(act) - 1
                    IF act[j]{"id"} = quest_id THEN
                        completed_entry = act[j]
                        had_active = TRUE
                    ELSE
                        new_active = APPEND(new_active, act[j])
                    ENDIF
                NEXT
                IF had_active = TRUE THEN
                    player_state{"active"} = new_active
                    player_state{"completed"} = APPEND(player_state{"completed"}, completed_entry)
                ENDIF

                npcs{oid}{"quest_completed"} = TRUE
                DIM thanks_vars AS MAP = {}
                thanks_vars{"npc"} = s{"name"}
                thanks_vars{"item"} = expected_item
                thanks_vars{"giver"} = npcs{oid}{"name"}
                RETURN rule("synthetic_replies", "delivery_thanks", thanks_vars)
            ENDIF
        ENDIF
    NEXT
    RETURN ""
ENDFUNC

' ── Conversation API ──────────────────────────────────────────────
' GDScript calls these once the player presses E near an NPC. The
' conversation reuses the same single-LLM single-task slot as the
' prefetch loop - so if a prefetch is in flight, the player has to
' wait until it lands before their reply gets generated.

' Open a conversation. Returns the cached greeting if ready, "" if
' the prefetch hasn't landed yet (UI shows a spinner in that case).
' Also seeds the per-NPC history string with the greeting so
' continue_dialog has context for turn 2.
EXPORT FUNC start_dialog(id)
    DIM s = npcs{id}
    ' Code-driven delivery takes priority over any cached LLM greeting.
    DIM thanks = check_pending_delivery(id)
    IF LEN(thanks) > 0 THEN
        DIM acts = [{"tool": "say", "args": {"text": thanks}}]
        npcs{id}{"dialog_cache"} = thanks
        npcs{id}{"dialog_actions"} = acts
        npcs{id}{"dialog_ready"} = TRUE
        push_npc_turn(id, thanks)
        RETURN acts
    ENDIF
    IF s{"dialog_ready"} <> TRUE THEN RETURN []
    ' Seed the buffer with the cached greeting the first time the
    ' player opens this dialog.
    IF LEN(s{"recent_turns"}) = 0 THEN
        push_npc_turn(id, s{"dialog_cache"})
    ENDIF
    RETURN s{"dialog_actions"}
ENDFUNC

' Send a player message. Spawns an ASYNC task that generates the next
' NPC reply with the full conversation history as context. Returns
' the task_id - GDScript polls via dialog_reply_ready / dialog_reply.
EXPORT FUNC continue_dialog(id, player_msg)
    IF g_task <> 0 THEN
        ' Wait for any in-flight prefetch to land first - cheap because
        ' single-task slot guarantees the model isn't being hammered.
        DIM stale_reply = AWAIT g_task
        IF g_task_npc <> "" THEN
            npcs{g_task_npc}{"dialog_cache"} = stale_reply
            npcs{g_task_npc}{"dialog_ready"} = TRUE
        ENDIF
        g_task = 0
        g_task_npc = ""
    ENDIF
    DIM s = npcs{id}
    push_player_turn(id, player_msg)
    npcs{id}{"last_query"} = player_msg

    ' Deterministic flag-trigger detection. Keyword-matching catches
    ' the obvious cases the LLM keeps missing - we stage matched
    ' set_flag actions here and prepend them to the LLM's reply in
    ' poll_reply, so the UI dispatches them through its normal path
    ' (validation + system_line + console).
    DIM hits = check_flag_triggers(player_msg)
    DIM pending = []
    FOR hi = 0 TO LEN(hits) - 1
        DIM hk = hits[hi]
        DIM act AS MAP = {}
        act{"tool"} = "set_flag"
        DIM act_args AS MAP = {}
        act_args{"key"} = hk
        act_args{"value"} = TRUE
        act{"args"} = act_args
        pending = APPEND(pending, act)
        ' Mirror the player's revelation as a world-wide rumor so the
        ' next NPC the player approaches already knows about it.
        DIM rt = rumor_text_for_flag(hk, npcs{id}{"name"})
        IF LEN(rt) > 0 THEN
            push_rumor(id, rt)
        ENDIF
    NEXT
    DIM aff_delta = check_affinity_triggers(player_msg)
    IF aff_delta <> 0 THEN
        DIM aa AS MAP = {}
        aa{"tool"} = "shift_affinity"
        DIM aa_args AS MAP = {}
        aa_args{"delta"} = aff_delta
        aa{"args"} = aa_args
        pending = APPEND(pending, aa)
    ENDIF
    npcs{id}{"pending_actions"} = pending

    ' Code-driven delivery: if the player just handed something we
    ' were expecting, skip the LLM and queue a synthetic actions
    ' array with just a thanks say. g_task = -1 is the sentinel.
    DIM thanks = check_pending_delivery(id)
    IF LEN(thanks) > 0 THEN
        npcs{id}{"synthetic_reply"} = [{"tool": "say", "args": {"text": thanks}}]
        g_task = -1
        g_task_npc = id
        RETURN g_task
    ENDIF

    DIM sys = build_sys(id)
    ' build_sys already inlines the recent buffer + long_term summary,
    ' so the user prompt is just the cue for the next turn.
    DIM tvars AS MAP = {}
    tvars{"name"} = s{"name"}
    DIM user_prompt = rule("user_prompts", "turn_cue", tvars)
    g_task = gen_dialog(g_llm, sys, user_prompt)
    g_task_npc = id
    RETURN g_task
ENDFUNC

' Poll for the active conversation reply. Returns the text and clears
' the task slot when ready; returns "" if still generating.
EXPORT FUNC poll_reply(id)
    IF g_task = 0 THEN RETURN []
    IF g_task_npc <> id THEN RETURN []
    IF g_task = -1 THEN
        DIM s_acts = npcs{id}{"synthetic_reply"}
        DIM s_text = extract_say_text({"actions": s_acts})
        push_npc_turn(id, s_text)
        npcs{id}{"synthetic_reply"} = []
        g_task = 0
        g_task_npc = ""
        RETURN s_acts
    ENDIF
    IF THREAD.ISDONE(g_task) THEN
        DIM raw = AWAIT g_task
        g_last_raw = raw
        g_last_who = id
        DIM acts = parse_actions(raw)
        IF LEN(acts) = 0 THEN
            acts = [{"tool": "say", "args": {"text": "..."}}]
        ENDIF
        DIM say_text = extract_say_from_actions(acts)
        push_npc_turn(id, say_text)
        ' Prepend deterministic set_flag actions detected from the
        ' player's last message before handing back to the UI.
        DIM pa = npcs{id}{"pending_actions"}
        IF LEN(pa) > 0 THEN
            DIM merged = pa
            FOR pi = 0 TO LEN(acts) - 1
                merged = APPEND(merged, acts[pi])
            NEXT
            acts = merged
            npcs{id}{"pending_actions"} = []
        ENDIF
        g_task = 0
        g_task_npc = ""
        RETURN acts
    ENDIF
    RETURN []
ENDFUNC
