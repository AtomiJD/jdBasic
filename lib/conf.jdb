' conf.jdb - dotenv, INI and a TOML subset, one map shape for all three.
'
'   IMPORT CONF
'   DIM env = CONF.ENV(".env")              ' {"DB_URL": "...", ...}
'   CONF.ENV(".env", TRUE)                  ' and pushed into the process environment
'   DIM ini = CONF.INI("app.ini")           ' {"section": {"key": "value"}}
'   DIM toml = CONF.TOML("app.toml")        ' {"server": {"port": 8080, "hosts": [...]}}
'   PRINT CONF.GET(toml, "server.port", 80)
'
' The text parsers behind the file loaders are exported too: ENV_TEXT,
' INI_TEXT and TOML_TEXT take the content as a string.
'
' dotenv: KEY=value per line, an optional "export " prefix, # comments,
' single quotes literal, double quotes with \n \t \r \" \\ escapes,
' unquoted values trimmed with a trailing # comment removed. INI:
' [section] headers, key=value or key: value, ; and # comments, values
' kept as strings; keys before the first section land in the "" section;
' a duplicate key keeps the last value, or the first, or raises,
' according to the policy argument ("last", "first", "error"). TOML: the
' subset that configuration files use - [table] and [a.b] headers,
' [[array.of.tables]], basic and literal strings, integers, floats,
' booleans, arrays, inline tables, and date or time values kept as
' text. Basic strings know the TOML escapes, \u and
' \U included; any other backslash is an error. Multi-line strings are
' not supported. A mistake is an error that names the line.

EXPORT MODULE CONF

CONST WHITESPACE = " " + CHR$(9) + CHR$(13)

EXPORT FUNC ENV(path$, apply = FALSE)
    RETURN ENV_TEXT(TXTREADER$(path$), apply)
ENDFUNC

EXPORT FUNC INI(path$, policy$ = "last")
    RETURN INI_TEXT(TXTREADER$(path$), policy$)
ENDFUNC

' A mistake in the file is an error that names the file and its line.
EXPORT FUNC TOML(path$)
    DIM text$ = TXTREADER$(path$)
    DIM cfg = {}
    TRY
        cfg = TOML_TEXT(text$)
    CATCH
        DIM why$ = ERRMSG$
        IF STARTSWITH(why$, "CONF.TOML ") THEN why$ = MID$(why$, 10, LEN(why$) - 10)
        THROW "CONF.TOML " + path$ + " " + why$
    ENDTRY
    RETURN cfg
ENDFUNC

' A nested read with a dotted path and a fallback for a missing key.
EXPORT FUNC GET(cfg, path$, fallback = 0)
    DIM here = cfg
    DIM parts = SPLIT(path$, ".")
    DIM i = 0
    FOR i = 0 TO LEN(parts) - 1
        IF TYPEOF(here) <> "OBJECT" THEN RETURN fallback
        IF NOT MAP.EXISTS(here, parts[i]) THEN RETURN fallback
        here = here{parts[i]}
    NEXT i
    RETURN here
ENDFUNC

FUNC Lines(text$)
    RETURN SPLIT(REPLACE$(text$, CHR$(13), ""), CHR$(10))
ENDFUNC

FUNC Strip$(text$)
    DIM a = 0
    DIM b = LEN(text$)
    DO WHILE a < b ANDALSO INSTR(WHITESPACE, MID$(text$, a, 1)) >= 0
        a = a + 1
    LOOP
    DO WHILE b > a ANDALSO INSTR(WHITESPACE, MID$(text$, b - 1, 1)) >= 0
        b = b - 1
    LOOP
    RETURN MID$(text$, a, b - a)
ENDFUNC

' ── dotenv ─────────────────────────────────────────────────────

EXPORT FUNC ENV_TEXT(text$, apply = FALSE)
    DIM out AS MAP
    DIM rows = Lines(text$)
    DIM i = 0
    FOR i = 0 TO LEN(rows) - 1
        DIM row$ = Strip$(rows[i])
        IF LEN(row$) = 0 ORELSE STARTSWITH(row$, "#") THEN CONTINUEFOR
        IF STARTSWITH(row$, "export ") THEN row$ = Strip$(MID$(row$, 7, LEN(row$) - 7))
        DIM eq = INSTR(row$, "=")
        IF eq < 0 THEN CONTINUEFOR
        DIM key$ = Strip$(LEFT$(row$, eq))
        DIM raw$ = Strip$(MID$(row$, eq + 1, LEN(row$) - eq - 1))
        out{key$} = EnvValue$(raw$)
        IF apply THEN SETENV key$, out{key$}
    NEXT i
    RETURN out
ENDFUNC

FUNC EnvValue$(raw$)
    IF LEN(raw$) = 0 THEN RETURN ""
    DIM first$ = LEFT$(raw$, 1)
    IF first$ = CHR$(34) THEN
        DIM close = INSTR(1, raw$, CHR$(34))
        DO WHILE close > 0 ANDALSO MID$(raw$, close - 1, 1) = CHR$(92)
            close = INSTR(close + 1, raw$, CHR$(34))
        LOOP
        IF close < 0 THEN close = LEN(raw$)
        RETURN Unescape$(MID$(raw$, 1, close - 1))
    ENDIF
    IF first$ = "'" THEN
        DIM close2 = INSTR(1, raw$, "'")
        IF close2 < 0 THEN close2 = LEN(raw$)
        RETURN MID$(raw$, 1, close2 - 1)
    ENDIF
    DIM hash = INSTR(raw$, " #")
    IF hash >= 0 THEN raw$ = Strip$(LEFT$(raw$, hash))
    RETURN raw$
ENDFUNC

' The escapes a double quoted value may carry.
FUNC Unescape$(text$)
    DIM out$ = ""
    DIM i = 0
    DIM bs$ = CHR$(92)
    DO WHILE i < LEN(text$)
        DIM ch$ = MID$(text$, i, 1)
        IF ch$ = bs$ ANDALSO i + 1 < LEN(text$) THEN
            DIM nx$ = MID$(text$, i + 1, 1)
            IF nx$ = "n" THEN
                out$ = out$ + CHR$(10)
            ELSEIF nx$ = "t" THEN
                out$ = out$ + CHR$(9)
            ELSEIF nx$ = "r" THEN
                out$ = out$ + CHR$(13)
            ELSE
                out$ = out$ + nx$
            ENDIF
            i = i + 2
        ELSE
            out$ = out$ + ch$
            i = i + 1
        ENDIF
    LOOP
    RETURN out$
ENDFUNC

' ── INI ────────────────────────────────────────────────────────

EXPORT FUNC INI_TEXT(text$, policy$ = "last")
    DIM out AS MAP
    DIM section$ = ""
    out{""} = {}
    DIM rows = Lines(text$)
    DIM i = 0
    FOR i = 0 TO LEN(rows) - 1
        DIM row$ = Strip$(rows[i])
        IF LEN(row$) = 0 ORELSE STARTSWITH(row$, ";") ORELSE STARTSWITH(row$, "#") THEN CONTINUEFOR
        IF STARTSWITH(row$, "[") ANDALSO ENDSWITH(row$, "]") THEN
            section$ = Strip$(MID$(row$, 1, LEN(row$) - 2))
            IF NOT MAP.EXISTS(out, section$) THEN out{section$} = {}
            CONTINUEFOR
        ENDIF
        DIM eq = INSTR(row$, "=")
        DIM colon = INSTR(row$, ":")
        IF eq < 0 ORELSE (colon >= 0 ANDALSO colon < eq) THEN eq = colon
        IF eq < 0 THEN CONTINUEFOR
        DIM key$ = Strip$(LEFT$(row$, eq))
        DIM value$ = Strip$(MID$(row$, eq + 1, LEN(row$) - eq - 1))
        DIM sec = out{section$}
        IF MAP.EXISTS(sec, key$) THEN
            IF policy$ = "error" THEN THROW "CONF.INI: duplicate key " + key$ + " in [" + section$ + "]"
            IF policy$ = "first" THEN CONTINUEFOR
        ENDIF
        sec{key$} = value$
        out{section$} = sec
    NEXT i
    IF LEN(MAP.KEYS(out{""})) = 0 THEN MAP.DELETE(out, "")
    RETURN out
ENDFUNC

' ── TOML subset ────────────────────────────────────────────────

' The text of a TOML line up to a # outside quotes.
FUNC NoComment$(row$)
    DIM i = 0
    DIM quote$ = ""
    DO WHILE i < LEN(row$)
        DIM ch$ = MID$(row$, i, 1)
        IF quote$ = "" THEN
            IF ch$ = "#" THEN RETURN LEFT$(row$, i)
            IF ch$ = CHR$(34) ORELSE ch$ = "'" THEN quote$ = ch$
        ELSEIF quote$ = CHR$(34) ANDALSO ch$ = CHR$(92) THEN
            i = i + 1
        ELSEIF ch$ = quote$ THEN
            quote$ = ""
        ENDIF
        i = i + 1
    LOOP
    RETURN row$
ENDFUNC

' Brackets opened minus brackets closed on a line, outside quotes and comments.
FUNC Depth(row$)
    DIM t$ = NoComment$(row$)
    DIM d = 0
    DIM i = 0
    DIM quote$ = ""
    DO WHILE i < LEN(t$)
        DIM ch$ = MID$(t$, i, 1)
        IF quote$ = "" THEN
            IF ch$ = "[" THEN d = d + 1
            IF ch$ = "]" THEN d = d - 1
            IF ch$ = CHR$(34) ORELSE ch$ = "'" THEN quote$ = ch$
        ELSEIF quote$ = CHR$(34) ANDALSO ch$ = CHR$(92) THEN
            i = i + 1
        ELSEIF ch$ = quote$ THEN
            quote$ = ""
        ENDIF
        i = i + 1
    LOOP
    RETURN d
ENDFUNC

' The lines with an array that spans several lines joined into one. The
' joined row stays at the index of its first line and the lines it took
' in are left empty, so row k is still line k + 1 of the file.
FUNC JoinedRows(rows)
    DIM out = []
    DIM k = 0
    DO WHILE k < LEN(rows)
        DIM row$ = rows[k]
        k = k + 1
        DIM taken = 0
        DIM depth = 0
        IF NOT STARTSWITH(Strip$(row$), "[") THEN depth = Depth(row$)
        IF depth > 0 THEN
            row$ = NoComment$(row$)
            DO WHILE depth > 0 ANDALSO k < LEN(rows)
                DIM more$ = NoComment$(rows[k])
                k = k + 1
                taken = taken + 1
                row$ = row$ + " " + more$
                depth = depth + Depth(more$)
            LOOP
        ENDIF
        PUSH(out, row$)
        DIM t = 0
        FOR t = 1 TO taken
            PUSH(out, "")
        NEXT t
    LOOP
    RETURN out
ENDFUNC

EXPORT FUNC TOML_TEXT(text$)
    DIM root AS MAP
    DIM current = root
    DIM rows = JoinedRows(Lines(text$))
    DIM i = 0
    FOR i = 0 TO LEN(rows) - 1
        DIM row$ = Strip$(rows[i])
        IF LEN(row$) = 0 ORELSE STARTSWITH(row$, "#") THEN CONTINUEFOR
        DIM where$ = "CONF.TOML line " + STR$(i + 1) + ": "
        IF STARTSWITH(row$, "[") THEN
            DIM head$ = Strip$(NoComment$(row$))
            IF STARTSWITH(head$, "[[") ANDALSO ENDSWITH(head$, "]]") THEN
                DIM list_path$ = Strip$(MID$(head$, 2, LEN(head$) - 4))
                current = NewTableEntry(root, list_path$)
            ELSEIF ENDSWITH(head$, "]") ANDALSO NOT STARTSWITH(head$, "[[") THEN
                DIM table_path$ = Strip$(MID$(head$, 1, LEN(head$) - 2))
                current = Table(root, table_path$)
            ELSE
                THROW where$ + "a section heading needs its closing bracket: " + row$
            ENDIF
            CONTINUEFOR
        ENDIF
        DIM eq = KeyEnd(row$)
        IF eq < 0 THEN THROW where$ + "a setting needs the form name = value: " + row$
        DIM key$ = BareKey$(Strip$(LEFT$(row$, eq)))
        DIM rest$ = Strip$(MID$(row$, eq + 1, LEN(row$) - eq - 1))
        DIM parsed = {}
        TRY
            parsed = ReadValue(rest$, 0)
        CATCH
            DIM why$ = ERRMSG$
            IF STARTSWITH(why$, "CONF.TOML: ") THEN why$ = MID$(why$, 11, LEN(why$) - 11)
            THROW where$ + why$
        ENDTRY
        current{key$} = parsed{"value"}
    NEXT i
    RETURN root
ENDFUNC

' The position of the = that separates key and value, outside quotes.
FUNC KeyEnd(row$)
    DIM i = 0
    DIM quote$ = ""
    FOR i = 0 TO LEN(row$) - 1
        DIM ch$ = MID$(row$, i, 1)
        IF LEN(quote$) > 0 THEN
            IF ch$ = quote$ THEN quote$ = ""
        ELSEIF ch$ = CHR$(34) OR ch$ = "'" THEN
            quote$ = ch$
        ELSEIF ch$ = "=" THEN
            RETURN i
        ENDIF
    NEXT i
    RETURN -1
ENDFUNC

FUNC BareKey$(key$)
    IF LEN(key$) >= 2 THEN
        DIM q$ = LEFT$(key$, 1)
        IF (q$ = CHR$(34) OR q$ = "'") ANDALSO ENDSWITH(key$, q$) THEN RETURN MID$(key$, 1, LEN(key$) - 2)
    ENDIF
    RETURN key$
ENDFUNC

' Walks or creates the nested tables of a dotted path and returns the last.
FUNC Table(root, path$)
    DIM here = root
    DIM parts = SPLIT(path$, ".")
    DIM i = 0
    FOR i = 0 TO LEN(parts) - 1
        DIM name$ = BareKey$(Strip$(parts[i]))
        IF NOT MAP.EXISTS(here, name$) THEN here{name$} = {}
        DIM nxt = here{name$}
        IF TYPEOF(nxt) = "ARRAY" THEN
            nxt = nxt[LEN(nxt) - 1]
        ENDIF
        here = nxt
    NEXT i
    RETURN here
ENDFUNC

' [[path]]: appends a fresh table to the array at path and returns it.
FUNC NewTableEntry(root, path$)
    DIM parts = SPLIT(path$, ".")
    DIM parent = root
    DIM i = 0
    FOR i = 0 TO LEN(parts) - 2
        DIM name$ = BareKey$(Strip$(parts[i]))
        IF NOT MAP.EXISTS(parent, name$) THEN parent{name$} = {}
        DIM nxt = parent{name$}
        IF TYPEOF(nxt) = "ARRAY" THEN nxt = nxt[LEN(nxt) - 1]
        parent = nxt
    NEXT i
    DIM last$ = BareKey$(Strip$(parts[LEN(parts) - 1]))
    IF NOT MAP.EXISTS(parent, last$) THEN parent{last$} = []
    DIM entries = parent{last$}
    DIM fresh AS MAP
    PUSH(entries, fresh)
    parent{last$} = entries
    RETURN fresh
ENDFUNC

' Reads one value starting at pos; answers {"value", "end"} where end is
' the position after the value.
FUNC ReadValue(text$, pos)
    DIM i = SkipSpace(text$, pos)
    IF i >= LEN(text$) THEN THROW "CONF.TOML: a value is missing"
    DIM ch$ = MID$(text$, i, 1)
    IF ch$ = CHR$(34) THEN RETURN ReadBasicString(text$, i)
    IF ch$ = "'" THEN
        DIM close = INSTR(i + 1, text$, "'")
        IF close < 0 THEN THROW "CONF.TOML: unterminated string"
        RETURN {"value": MID$(text$, i + 1, close - i - 1), "end": close + 1}
    ENDIF
    IF ch$ = "[" THEN RETURN ReadArray(text$, i)
    IF ch$ = "{" THEN RETURN ReadInline(text$, i)
    DIM tail = i
    DO WHILE tail < LEN(text$)
        DIM c$ = MID$(text$, tail, 1)
        IF c$ = "," OR c$ = "]" OR c$ = "}" OR c$ = "#" THEN EXITDO
        tail = tail + 1
    LOOP
    DIM token$ = Strip$(MID$(text$, i, tail - i))
    RETURN {"value": Scalar(token$), "end": tail}
ENDFUNC

FUNC SkipSpace(text$, pos)
    DIM i = pos
    DO WHILE i < LEN(text$) ANDALSO INSTR(WHITESPACE, MID$(text$, i, 1)) >= 0
        i = i + 1
    LOOP
    RETURN i
ENDFUNC

FUNC ReadBasicString(text$, pos)
    DIM i = pos + 1
    DIM raw$ = ""
    DIM bs$ = CHR$(92)
    DO WHILE i < LEN(text$)
        DIM ch$ = MID$(text$, i, 1)
        IF ch$ = bs$ ANDALSO i + 1 < LEN(text$) THEN
            raw$ = raw$ + ch$ + MID$(text$, i + 1, 1)
            i = i + 2
        ELSEIF ch$ = CHR$(34) THEN
            RETURN {"value": TomlUnescape$(raw$), "end": i + 1}
        ELSE
            raw$ = raw$ + ch$
            i = i + 1
        ENDIF
    LOOP
    THROW "CONF.TOML: the text has no closing quote"
ENDFUNC

' The escapes of a TOML basic string: \b \t \n \f \r \" \\ \uXXXX and
' \UXXXXXXXX. A Windows path written with single backslashes is an error
' that shows the two ways to write it.
FUNC TomlUnescape$(raw$)
    DIM bs$ = CHR$(92)
    DIM hint$ = "write the path with forward slashes, " + CHR$(34) + "C:/Users/mia" + CHR$(34) + ", or in single quotes, 'C:" + bs$ + "Users" + bs$ + "mia'"
    IF LEN(raw$) > 3 ANDALSO MID$(raw$, 1, 1) = ":" ANDALSO MID$(raw$, 2, 1) = bs$ ANDALSO MID$(raw$, 3, 1) <> bs$ THEN
        THROW "CONF.TOML: " + CHR$(34) + raw$ + CHR$(34) + " is a Windows path in double quotes, where a backslash starts an escape; " + hint$
    ENDIF
    DIM out$ = ""
    DIM i = 0
    DO WHILE i < LEN(raw$)
        DIM ch$ = MID$(raw$, i, 1)
        IF ch$ <> bs$ THEN
            out$ = out$ + ch$
            i = i + 1
            CONTINUEDO
        ENDIF
        DIM nx$ = MID$(raw$, i + 1, 1)
        DIM at = INSTR("btnfr" + CHR$(34) + bs$, nx$)
        IF nx$ <> "" ANDALSO at >= 0 THEN
            out$ = out$ + MID$(CHR$(8) + CHR$(9) + CHR$(10) + CHR$(12) + CHR$(13) + CHR$(34) + bs$, at, 1)
            i = i + 2
        ELSEIF nx$ = "u" ORELSE nx$ = "U" THEN
            DIM width = 4
            IF nx$ = "U" THEN width = 8
            DIM digits$ = MID$(raw$, i + 2, width)
            IF LEN(digits$) < width ORELSE NOT REGEX.MATCH("[0-9A-Fa-f]+", digits$) THEN
                THROW "CONF.TOML: " + bs$ + nx$ + " needs " + STR$(width) + " hex digits; to write a path, " + hint$
            ENDIF
            DIM code = VAL("0x" + digits$)
            IF code >= 128 ANDALSO code <= 255 THEN
                out$ = out$ + CHR$(192 + INT(code / 64)) + CHR$(128 + code MOD 64)
            ELSE
                out$ = out$ + CHR$(code)
            ENDIF
            i = i + 2 + width
        ELSE
            THROW "CONF.TOML: " + bs$ + nx$ + " is not an escape TOML knows; to write a path, " + hint$
        ENDIF
    LOOP
    RETURN out$
ENDFUNC

FUNC ReadArray(text$, pos)
    DIM items = []
    DIM i = pos + 1
    DO
        i = SkipSpace(text$, i)
        IF i >= LEN(text$) THEN THROW "CONF.TOML: unterminated array"
        IF MID$(text$, i, 1) = "]" THEN RETURN {"value": items, "end": i + 1}
        DIM item = ReadValue(text$, i)
        PUSH(items, item{"value"})
        i = SkipSpace(text$, item{"end"})
        IF i < LEN(text$) ANDALSO MID$(text$, i, 1) = "," THEN i = i + 1
    LOOP
ENDFUNC

FUNC ReadInline(text$, pos)
    DIM table AS MAP
    DIM i = pos + 1
    DO
        i = SkipSpace(text$, i)
        IF i >= LEN(text$) THEN THROW "CONF.TOML: unterminated inline table"
        IF MID$(text$, i, 1) = "}" THEN RETURN {"value": table, "end": i + 1}
        DIM eq = INSTR(i, text$, "=")
        IF eq < 0 THEN THROW "CONF.TOML: inline table without ="
        DIM key$ = BareKey$(Strip$(MID$(text$, i, eq - i)))
        DIM item = ReadValue(text$, eq + 1)
        table{key$} = item{"value"}
        i = SkipSpace(text$, item{"end"})
        IF i < LEN(text$) ANDALSO MID$(text$, i, 1) = "," THEN i = i + 1
    LOOP
ENDFUNC

' A bare token: boolean, integer, float, or a date or time kept as text.
' Any other bare word is an error.
FUNC Scalar(token$)
    IF token$ = "true" THEN RETURN TRUE
    IF token$ = "false" THEN RETURN FALSE
    DIM plain$ = REPLACE$(token$, "_", "")
    IF REGEX.MATCH("^[+-]?[0-9]+$", plain$) THEN RETURN CINT(VAL(plain$))
    IF REGEX.MATCH("^[+-]?[0-9]+(?:[.][0-9]+)?(?:[eE][+-]?[0-9]+)?$", plain$) THEN RETURN VAL(plain$)
    IF REGEX.MATCH("[0-9]{4}-[0-9]{2}-[0-9]{2}.*|[0-9]{2}:[0-9]{2}.*|[+-]?(?:inf|nan)", token$) THEN RETURN token$
    THROW "CONF.TOML: text needs quotes, " + CHR$(34) + token$ + CHR$(34)
ENDFUNC
