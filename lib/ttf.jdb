' ttf.jdb: TrueType fonts read for layout and embedding. The metrics a PDF
' needs (units per em, ascent, descent, cap height, bounding box, italic
' angle, PostScript name), the advance width of every glyph, and the
' character map from Unicode code points to glyphs.
'
'   IMPORT TTF
'   DIM serif = TTF.LOAD("fonts/SourceSerif4-Regular.ttf")
'   PRINT TTF.WIDTH(serif, "Hello") * 11 / TTF.UPEM(serif); " points at 11 pt"
'   PRINT TTF.GLYPHS(serif, "Hi")
'
' Glyph outlines are read on demand (OUTLINE) as flattened contours, the
' way RASTER draws text; PDFGEN embeds the file whole.
' version: 1.0.0

EXPORT MODULE TTF

FUNC U16(data$, at)
    RETURN UNPACK(">s", data$, at)[0]
ENDFUNC

FUNC S16(data$, at)
    RETURN UNPACK(">h", data$, at)[0]
ENDFUNC

FUNC U32(data$, at)
    RETURN UNPACK(">i", data$, at)[0]
ENDFUNC

' The offsets of the font's tables by their four-letter tag.
FUNC Tables(data$)
    DIM n = U16(data$, 4)
    DIM out AS MAP
    DIM k = 0
    FOR k = 0 TO n - 1
        DIM rec = UNPACK(">4aiii", data$, 12 + 16 * k)
        out{rec[0]} = rec[2]
    NEXT k
    RETURN out
ENDFUNC

FUNC Need(tables, tag$)
    IF NOT MAP.EXISTS(tables, tag$) THEN THROW "TTF: the font has no " + tag$ + " table"
    RETURN tables{tag$}
ENDFUNC

' The PostScript name from the name table, spaces left out.
FUNC PsName$(data$, tables)
    IF NOT MAP.EXISTS(tables, "name") THEN RETURN "Font"
    DIM base = tables{"name"}
    DIM n = U16(data$, base + 2)
    DIM strings = base + U16(data$, base + 4)
    DIM k = 0
    FOR k = 0 TO n - 1
        DIM rec = UNPACK(">6s", data$, base + 6 + 12 * k)
        IF rec[3] = 6 THEN
            DIM raw$ = MID$(data$, strings + rec[5], rec[4])
            IF rec[0] = 3 ORELSE rec[0] = 0 THEN
                DIM units = UNPACK(">" + STR$(rec[4] \ 2) + "s", raw$, 0)
                raw$ = JOIN(SELECT(LAMBDA u -> CHR$(u), units), "")
            ENDIF
            RETURN REPLACE$(raw$, " ", "")
        ENDIF
    NEXT k
    RETURN "Font"
ENDFUNC

' The glyph of every code point the font maps: an array over the Basic
' Multilingual Plane and a map for the code points above it.
SUB ReadCmap(font, data$, tables)
    DIM base = Need(tables, "cmap")
    DIM n = U16(data$, base + 2)
    DIM best12 = -1
    DIM best4 = -1
    DIM k = 0
    FOR k = 0 TO n - 1
        DIM rec = UNPACK(">ssi", data$, base + 4 + 8 * k)
        DIM sub_at = base + rec[2]
        DIM fmt = U16(data$, sub_at)
        IF fmt = 12 ANDALSO (rec[0] = 3 ORELSE rec[0] = 0) THEN best12 = sub_at
        IF fmt = 4 ANDALSO (rec[0] = 3 ORELSE rec[0] = 0) ANDALSO best4 < 0 THEN best4 = sub_at
    NEXT k
    DIM bmp = ZEROS(65536)
    DIM high AS MAP
    DIM c = 0
    IF best12 >= 0 THEN
        DIM groups = U32(data$, best12 + 12)
        DIM g = 0
        FOR g = 0 TO groups - 1
            DIM grp = UNPACK(">3i", data$, best12 + 16 + 12 * g)
            FOR c = grp[0] TO grp[1]
                IF c < 65536 THEN
                    bmp[c] = grp[2] + c - grp[0]
                ELSE
                    high{STR$(c)} = grp[2] + c - grp[0]
                ENDIF
            NEXT c
        NEXT g
    ELSEIF best4 >= 0 THEN
        DIM seg2 = U16(data$, best4 + 6)
        DIM segs = seg2 \ 2
        DIM ends = UNPACK(">" + STR$(segs) + "s", data$, best4 + 14)
        DIM starts = UNPACK(">" + STR$(segs) + "s", data$, best4 + 16 + seg2)
        DIM deltas = UNPACK(">" + STR$(segs) + "h", data$, best4 + 16 + 2 * seg2)
        DIM range_at = best4 + 16 + 3 * seg2
        DIM ranges = UNPACK(">" + STR$(segs) + "s", data$, range_at)
        DIM s = 0
        FOR s = 0 TO segs - 1
            FOR c = starts[s] TO ends[s]
                IF c < 65535 THEN
                    DIM gid = 0
                    IF ranges[s] = 0 THEN
                        gid = (c + deltas[s]) MOD 65536
                    ELSE
                        gid = U16(data$, range_at + 2 * s + ranges[s] + 2 * (c - starts[s]))
                        IF gid <> 0 THEN gid = (gid + deltas[s]) MOD 65536
                    ENDIF
                    IF gid < 0 THEN gid = gid + 65536
                    bmp[c] = gid
                ENDIF
            NEXT c
        NEXT s
    ELSE
        THROW "TTF: no Unicode character map (format 4 or 12)"
    ENDIF
    font{"bmp"} = bmp
    font{"high"} = high
ENDSUB

' A font from a TrueType file. The map holds "data" (the file), "name",
' "upem", "ascent", "descent", "cap", "bbox" [x0, y0, x1, y1], "italic"
' (degrees), "monospace" (TRUE for a fixed pitch), "glyphs" and "widths"
' (one per glyph, in font units).
EXPORT FUNC LOAD(path$)
    IF NOT FILE.EXISTS(path$) THEN THROW "TTF: no such file " + path$
    DIM data$ = BINREADER$(path$)
    IF LEN(data$) < 12 THEN THROW "TTF: not a font file: " + path$
    DIM tag = U32(data$, 0)
    IF tag <> 65536 ANDALSO LEFT$(data$, 4) <> "true" THEN THROW "TTF: not a TrueType font (OpenType with CFF outlines is not supported): " + path$
    DIM tables = Tables(data$)
    DIM head = Need(tables, "head")
    DIM hhea = Need(tables, "hhea")
    DIM maxp = Need(tables, "maxp")
    DIM hmtx = Need(tables, "hmtx")
    DIM glyf = Need(tables, "glyf")
    DIM loca = Need(tables, "loca")
    DIM font AS MAP
    font{"data"} = data$
    font{"path"} = path$
    font{"name"} = PsName$(data$, tables)
    font{"upem"} = U16(data$, head + 18)
    font{"bbox"} = UNPACK(">4h", data$, head + 36)
    font{"ascent"} = S16(data$, hhea + 4)
    font{"descent"} = S16(data$, hhea + 6)
    font{"cap"} = font{"ascent"}
    IF MAP.EXISTS(tables, "OS/2") THEN
        DIM os2 = tables{"OS/2"}
        IF U16(data$, os2) >= 2 THEN font{"cap"} = S16(data$, os2 + 88)
    ENDIF
    font{"italic"} = 0
    font{"monospace"} = FALSE
    IF MAP.EXISTS(tables, "post") THEN
        font{"italic"} = UNPACK(">n", data$, tables{"post"} + 4)[0] / 65536
        font{"monospace"} = U32(data$, tables{"post"} + 12) <> 0
    ENDIF
    DIM n_glyphs = U16(data$, maxp + 4)
    DIM n_metrics = U16(data$, hhea + 34)
    DIM pairs = UNPACK(">" + STR$(2 * n_metrics) + "s", data$, hmtx)
    DIM widths = ZEROS(n_glyphs)
    DIM k = 0
    FOR k = 0 TO n_glyphs - 1
        IF k < n_metrics THEN
            widths[k] = pairs[2 * k]
        ELSE
            widths[k] = pairs[2 * (n_metrics - 1)]
        ENDIF
    NEXT k
    font{"glyphs"} = n_glyphs
    font{"glyf"} = glyf
    font{"loca"} = loca
    font{"loca_long"} = S16(data$, head + 50) <> 0
    font{"outlines"} = {}
    font{"widths"} = widths
    ReadCmap(font, data$, tables)
    RETURN font
ENDFUNC

' The Unicode code points of a UTF-8 text.
EXPORT FUNC CODEPOINTS(text$)
    DIM out = []
    DIM n = LEN(text$)
    IF n = 0 THEN RETURN out
    DIM b = UNPACK(STR$(n) + "b", text$, 0)
    DIM i = 0
    DO WHILE i < n
        DIM lead = b[i]
        DIM code = lead
        DIM more = 0
        IF lead >= 240 THEN
            code = lead - 240
            more = 3
        ELSEIF lead >= 224 THEN
            code = lead - 224
            more = 2
        ELSEIF lead >= 192 THEN
            code = lead - 192
            more = 1
        ELSEIF lead >= 128 THEN
            code = 65533
        ENDIF
        DIM k = 0
        FOR k = 1 TO more
            IF i + k < n THEN code = code * 64 + (b[i + k] - 128)
        NEXT k
        PUSH(out, code)
        i = i + 1 + more
    LOOP
    RETURN out
ENDFUNC

' The glyph for a code point, 0 (the font's .notdef) when it has none.
EXPORT FUNC GLYPH(font, code)
    IF code >= 0 ANDALSO code < 65536 THEN RETURN font{"bmp"}[code]
    DIM high = font{"high"}
    IF MAP.EXISTS(high, STR$(code)) THEN RETURN high{STR$(code)}
    RETURN 0
ENDFUNC

' The glyphs of a text, one per character.
EXPORT FUNC GLYPHS(font, text$)
    DIM codes = CODEPOINTS(text$)
    DIM out = ZEROS(LEN(codes))
    DIM k = 0
    FOR k = 0 TO LEN(codes) - 1
        out[k] = GLYPH(font, codes[k])
    NEXT k
    RETURN out
ENDFUNC

' The advance width of a text in font units.
EXPORT FUNC WIDTH(font, text$)
    DIM glyphs = GLYPHS(font, text$)
    DIM widths = font{"widths"}
    DIM total = 0
    DIM k = 0
    FOR k = 0 TO LEN(glyphs) - 1
        total = total + widths[glyphs[k]]
    NEXT k
    RETURN total
ENDFUNC

EXPORT FUNC UPEM(font)
    RETURN font{"upem"}
ENDFUNC

' The code points of a text the font has no glyph for.
EXPORT FUNC MISSING(font, text$)
    DIM codes = CODEPOINTS(text$)
    DIM out = []
    DIM k = 0
    FOR k = 0 TO LEN(codes) - 1
        IF codes[k] > 32 ANDALSO GLYPH(font, codes[k]) = 0 THEN PUSH(out, codes[k])
    NEXT k
    RETURN out
ENDFUNC

' ── outlines ───────────────────────────────────────────────────

FUNC S8(data$, at)
    DIM v = BYTEAT(data$, at)
    IF v >= 128 THEN RETURN v - 256
    RETURN v
ENDFUNC

' Where glyph gid starts in the glyf table and where the next one starts;
' a glyph with no outline (a space) has the same number twice.
FUNC GlyphSpan(font, gid)
    DIM data$ = font{"data"}
    DIM loca = font{"loca"}
    IF font{"loca_long"} THEN RETURN [U32(data$, loca + 4 * gid), U32(data$, loca + 4 * gid + 4)]
    RETURN [2 * U16(data$, loca + 2 * gid), 2 * U16(data$, loca + 2 * gid + 2)]
ENDFUNC

' Appends the points of a quadratic curve from (x0, y0) over the control
' point (cx, cy) to (x1, y1), flattened into six straight pieces.
SUB AppendCurve(poly, x0, y0, cx, cy, x1, y1)
    DIM segs = 6
    DIM k = 0
    FOR k = 1 TO segs
        DIM t = k / segs
        DIM u = 1 - t
        PUSH(poly, u * u * x0 + 2 * u * t * cx + t * t * x1)
        PUSH(poly, u * u * y0 + 2 * u * t * cy + t * t * y1)
    NEXT k
ENDSUB

' One contour of on and off curve points as a closed polygon, flat
' [x0, y0, x1, y1, ...]. Two off points in a row imply an on point halfway
' between them; a contour that starts off the curve starts at the last
' point, or halfway when that one is off the curve too.
FUNC ContourPolygon(xs, ys, ons)
    DIM n = LEN(xs)
    DIM poly = []
    IF n = 0 THEN RETURN poly
    DIM sx = xs[0]
    DIM sy = ys[0]
    DIM first = 1
    IF ons[0] = 0 THEN
        first = 0
        IF ons[n - 1] = 1 THEN
            sx = xs[n - 1]
            sy = ys[n - 1]
        ELSE
            sx = (xs[0] + xs[n - 1]) / 2
            sy = (ys[0] + ys[n - 1]) / 2
        ENDIF
    ENDIF
    PUSH(poly, sx)
    PUSH(poly, sy)
    DIM px = sx
    DIM py = sy
    DIM have_ctrl = 0
    DIM cx = 0
    DIM cy = 0
    DIM k = 0
    FOR k = first TO n
        DIM x = sx
        DIM y = sy
        DIM on_curve = 1
        IF k < n THEN
            x = xs[k]
            y = ys[k]
            on_curve = ons[k]
        ENDIF
        IF on_curve = 1 THEN
            IF have_ctrl = 1 THEN
                AppendCurve(poly, px, py, cx, cy, x, y)
                have_ctrl = 0
            ELSE
                PUSH(poly, x)
                PUSH(poly, y)
            ENDIF
            px = x
            py = y
        ELSE
            IF have_ctrl = 1 THEN
                DIM mx = (cx + x) / 2
                DIM my = (cy + y) / 2
                AppendCurve(poly, px, py, cx, cy, mx, my)
                px = mx
                py = my
            ENDIF
            cx = x
            cy = y
            have_ctrl = 1
        ENDIF
    NEXT k
    RETURN poly
ENDFUNC

' The contours of a simple glyph at offset at, each a closed polygon in
' font units, transformed by [a b c d dx dy].
FUNC SimpleContours(data$, at, n_contours, m)
    DIM out = []
    DIM ends = UNPACK(">" + STR$(n_contours) + "s", data$, at + 10)
    DIM n_points = ends[n_contours - 1] + 1
    DIM instr_len = U16(data$, at + 10 + 2 * n_contours)
    DIM p = at + 12 + 2 * n_contours + instr_len
    DIM flags = ZEROS(n_points)
    DIM k = 0
    DO WHILE k < n_points
        DIM f = BYTEAT(data$, p)
        p = p + 1
        flags[k] = f
        k = k + 1
        IF (f BAND 8) <> 0 THEN
            DIM rep = BYTEAT(data$, p)
            p = p + 1
            DIM r = 0
            FOR r = 1 TO rep
                IF k < n_points THEN flags[k] = f
                k = k + 1
            NEXT r
        ENDIF
    LOOP
    DIM xs = ZEROS(n_points)
    DIM ys = ZEROS(n_points)
    DIM v = 0
    FOR k = 0 TO n_points - 1
        DIM fx = flags[k]
        IF (fx BAND 2) <> 0 THEN
            DIM dx = BYTEAT(data$, p)
            p = p + 1
            IF (fx BAND 16) = 0 THEN dx = -dx
            v = v + dx
        ELSEIF (fx BAND 16) = 0 THEN
            v = v + S16(data$, p)
            p = p + 2
        ENDIF
        xs[k] = v
    NEXT k
    v = 0
    FOR k = 0 TO n_points - 1
        DIM fy = flags[k]
        IF (fy BAND 4) <> 0 THEN
            DIM dy = BYTEAT(data$, p)
            p = p + 1
            IF (fy BAND 32) = 0 THEN dy = -dy
            v = v + dy
        ELSEIF (fy BAND 32) = 0 THEN
            v = v + S16(data$, p)
            p = p + 2
        ENDIF
        ys[k] = v
    NEXT k
    DIM start = 0
    DIM c = 0
    FOR c = 0 TO n_contours - 1
        DIM last = ends[c]
        DIM cxs = []
        DIM cys = []
        DIM ons = []
        FOR k = start TO last
            DIM x = xs[k]
            DIM y = ys[k]
            PUSH(cxs, m[0] * x + m[2] * y + m[4])
            PUSH(cys, m[1] * x + m[3] * y + m[5])
            PUSH(ons, IIF((flags[k] BAND 1) <> 0, 1, 0))
        NEXT k
        DIM poly = ContourPolygon(cxs, cys, ons)
        IF LEN(poly) >= 6 THEN PUSH(out, poly)
        start = last + 1
    NEXT c
    RETURN out
ENDFUNC

FUNC F2Dot14(data$, at)
    RETURN S16(data$, at) / 16384
ENDFUNC

' The contours of glyph gid under the transform m, composite glyphs
' resolved through their parts.
FUNC GlyphContours(font, gid, m, depth)
    DIM out = []
    IF depth > 8 ORELSE gid < 0 ORELSE gid >= font{"glyphs"} THEN RETURN out
    DIM span = GlyphSpan(font, gid)
    IF span[1] <= span[0] THEN RETURN out
    DIM data$ = font{"data"}
    DIM at = font{"glyf"} + span[0]
    DIM n_contours = S16(data$, at)
    IF n_contours >= 0 THEN
        IF n_contours = 0 THEN RETURN out
        RETURN SimpleContours(data$, at, n_contours, m)
    ENDIF
    DIM p = at + 10
    DIM more = 1
    DO WHILE more = 1
        DIM flags = U16(data$, p)
        DIM part = U16(data$, p + 2)
        p = p + 4
        DIM dx = 0
        DIM dy = 0
        IF (flags BAND 1) <> 0 THEN
            dx = S16(data$, p)
            dy = S16(data$, p + 2)
            p = p + 4
        ELSE
            dx = S8(data$, p)
            dy = S8(data$, p + 1)
            p = p + 2
        ENDIF
        IF (flags BAND 2) = 0 THEN
            dx = 0
            dy = 0
        ENDIF
        DIM a = 1
        DIM b = 0
        DIM c = 0
        DIM d = 1
        IF (flags BAND 8) <> 0 THEN
            a = F2Dot14(data$, p)
            d = a
            p = p + 2
        ELSEIF (flags BAND 64) <> 0 THEN
            a = F2Dot14(data$, p)
            d = F2Dot14(data$, p + 2)
            p = p + 4
        ELSEIF (flags BAND 128) <> 0 THEN
            a = F2Dot14(data$, p)
            b = F2Dot14(data$, p + 2)
            c = F2Dot14(data$, p + 4)
            d = F2Dot14(data$, p + 6)
            p = p + 8
        ENDIF
        ' the part's own transform first, then the caller's
        DIM part_m = [m[0] * a + m[2] * b, m[1] * a + m[3] * b, m[0] * c + m[2] * d, m[1] * c + m[3] * d, m[0] * dx + m[2] * dy + m[4], m[1] * dx + m[3] * dy + m[5]]
        DIM parts = GlyphContours(font, part, part_m, depth + 1)
        DIM k = 0
        FOR k = 0 TO LEN(parts) - 1
            PUSH(out, parts[k])
        NEXT k
        more = IIF((flags BAND 32) <> 0, 1, 0)
    LOOP
    RETURN out
ENDFUNC

' The outline of a glyph: an array of closed contours, each a flat
' [x0, y0, x1, y1, ...] polygon in font units with y up, the quadratic
' curves flattened. A space answers an empty array. Read once per glyph.
EXPORT FUNC OUTLINE(font, gid)
    DIM cache = font{"outlines"}
    DIM key$ = STR$(gid)
    IF MAP.EXISTS(cache, key$) THEN RETURN cache{key$}
    DIM contours = GlyphContours(font, gid, [1, 0, 0, 1, 0, 0], 0)
    cache{key$} = contours
    RETURN contours
ENDFUNC
