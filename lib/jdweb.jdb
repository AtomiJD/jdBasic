' jdweb - the jdBasic web framework: routes with path parameters, method
' dispatch, middleware before and after, sessions with expiry, rotation, a
' database store, CSRF protection and flash messages, a cookie builder,
' static files, JSON and error responses, a test client for the running
' app, and the page chrome and cookie-login stack of the terminal "Hot
' Phosphor" theme.
'
'   IMPORT JDWEB
'   FUNC ShowUser(request)
'       RETURN {"id": JDWEB.PARAM$(request, "id")}
'   ENDFUNC
'   JDWEB.GET("/users/:id", ShowUser@)
'   JDWEB.SERVE(8080)
'
' Routes answer through HTTP.SERVER.ON_NOTFOUND, so apps that register their
' paths with HTTP.SERVER.ON_GET and ON_POST keep working beside them.
'
' Pages render through TMPL (lib/tmpl.jdb) and session ids come from SECRET
' (lib/secret.jdb); both have to sit where IMPORT finds them: next to this
' file on a server, or on JDBASIC_PATH. The page templates (layout, theme)
' are read from jdweb_tpl/ next to the app script unless TEMPLATES names
' another folder.
EXPORT MODULE JDWEB

IMPORT TMPL, SECRET

DIM gConf AS MAP
DIM gArgs = OS.ARGS()
DIM gAppScript$ = gArgs[0]
gConf{"tpl"} = PATH.JOIN$(PATH.DIRNAME$(gAppScript$), "jdweb_tpl")
gConf{"theme"} = ""
DIM gEmptyModel AS MAP

DIM gRouteMethods = []
DIM gRoutePatterns = []
DIM gRouteFns AS MAP
DIM gBeforeIds = []
DIM gBeforeFns AS MAP
DIM gAfterIds = []
DIM gAfterFns AS MAP
DIM gHooks AS MAP
DIM gStaticPrefixes = []
DIM gStaticDirs = []

' Sessions by id: the map a handler writes, and when it was made and last
' used, in seconds since 1970.
DIM gSessions AS MAP
DIM gSessionCreated AS MAP
DIM gSessionSeen AS MAP
DIM gSessionConf AS MAP
gSessionConf{"ttl"} = 86400
gSessionConf{"lifetime"} = 0
gSessionConf{"cookie"} = "jdwsid"
gSessionConf{"secure"} = FALSE
gSessionConf{"samesite"} = "Lax"
gSessionConf{"domain"} = ""
gSessionConf{"path"} = "/"
gSessionConf{"db"} = 0
gSessionConf{"auth_ttl"} = 2592000
gSessionConf{"clock_shift"} = 0
gSessionConf{"last_cleanup"} = 0
gSessionConf{"csrf"} = FALSE
DIM gCsrfExempt = []

' The route parameters and session changes of the request being answered;
' the server hands one request at a time to the VM.
DIM gCurrent AS MAP

' ---- small internal helpers ----

FUNC ESC$(s$)
    RETURN REPLACE$(s$, "'", "''")
ENDFUNC

FUNC FIELD$(obj, key$)
    DIM v = obj{key$}
    IF TYPEOF(v) = "NONE" THEN RETURN ""
    RETURN TRIM$("" + v)
ENDFUNC

FUNC TplDir$()
    DIM dir$ = gConf{"tpl"}
    RETURN dir$
ENDFUNC

' The folder the page templates are read from.
EXPORT SUB TEMPLATES(dir$)
    gConf{"tpl"} = dir$
    gConf{"theme"} = ""
ENDSUB

' ---- theme (all design tokens live in :root) ----

EXPORT FUNC THEME$()
    DIM cached$ = gConf{"theme"}
    IF LEN(cached$) = 0 THEN
        cached$ = TXTREADER$(PATH.JOIN$(TplDir$(), "theme.html"))
        gConf{"theme"} = cached$
    ENDIF
    RETURN cached$
ENDFUNC

' ---- template rendering ----

EXPORT FUNC RENDER$(tpl$, vars)
    DIM out$ = REPLACE$(tpl$, "##theme##", THEME$())
    DIM keys = MAP.KEYS(vars)
    DIM k = 0
    FOR k = 0 TO LEN(keys) - 1
        DIM key$ = keys[k]
        DIM v = vars{key$}
        out$ = REPLACE$(out$, "##" + key$ + "##", "" + v)
    NEXT k
    RETURN out$
ENDFUNC

EXPORT FUNC COOKIE_BANNER$()
    RETURN TMPL.RENDER$(PATH.JOIN$(TplDir$(), "cookiebar.html"), gEmptyModel)
ENDFUNC

EXPORT FUNC NAV_HTML$(cfg, active$)
    DIM model AS MAP
    DIM app = cfg{"app"}
    DIM sub_title = cfg{"sub"}
    model{"app"} = "" + app
    model{"sub"} = "" + sub_title
    model{"nav"} = cfg{"nav"}
    model{"active"} = active$
    RETURN TMPL.RENDER$(PATH.JOIN$(TplDir$(), "nav.html"), model)
ENDFUNC

' Full HTML document. navHtml$ may be "" (e.g. the login page). The EU cookie
' banner is appended only when the app config has "cookies": true.
EXPORT FUNC PAGE$(cfg, title$, navHtml$, content$)
    DIM bar$ = ""
    DIM ck = cfg{"cookies"}
    IF TYPEOF(ck) <> "NONE" ANDALSO ck = TRUE THEN bar$ = COOKIE_BANNER$()
    DIM model AS MAP
    model{"title"} = title$
    model{"theme"} = THEME$()
    model{"nav"} = navHtml$
    model{"content"} = content$
    model{"cookiebar"} = bar$
    DIM desc = cfg{"meta_desc"}
    IF TYPEOF(desc) <> "NONE" THEN model{"meta_desc"} = "" + desc
    DIM app = cfg{"app"}
    model{"site_name"} = "" + app
    RETURN TMPL.RENDER$(PATH.JOIN$(TplDir$(), "layout.html"), model)
ENDFUNC

' Themed 404. Returns a rich-response map so the server sends status 404.
' Wire it with ON_MISSING, or with HTTP.SERVER.ON_NOTFOUND and a thin wrapper
' that returns JDWEB.NOT_FOUND$(cfg).
EXPORT FUNC NOT_FOUND$(cfg)
    DIM app = cfg{"app"}
    DIM app$ = "" + app
    DIM c$ = TMPL.RENDER$(PATH.JOIN$(TplDir$(), "notfound.html"), gEmptyModel)
    DIM html$ = PAGE$(cfg, app$ + " - 404", "", c$)
    RETURN { "__http_status": 404, "__http_content_type": "text/html", "__http_body": html$ }
ENDFUNC

EXPORT FUNC LOGIN_PAGE$(cfg)
    DIM app = cfg{"app"}
    DIM app$ = "" + app
    DIM lm AS MAP
    lm{"app"} = app$
    DIM c$ = TMPL.RENDER$(PATH.JOIN$(TplDir$(), "login.html"), lm)
    RETURN PAGE$(cfg, app$ + " - Sign in", "", c$)
ENDFUNC

' ---- cookies ----

' A cookie value with every byte a cookie cannot carry written as %XX: the
' controls, space, double quote, comma, semicolon, backslash, percent and
' everything beyond ASCII.
FUNC CookieEncode$(text$)
    DIM out$ = ""
    DIM i = 0
    FOR i = 0 TO LEN(text$) - 1
        DIM b = BYTEAT(text$, i)
        IF b <= 32 ORELSE b >= 127 ORELSE b = 34 ORELSE b = 44 ORELSE b = 59 ORELSE b = 92 ORELSE b = 37 THEN
            out$ = out$ + "%" + RIGHT$("0" + HEX$(b), 2)
        ELSE
            out$ = out$ + CHR$(b)
        ENDIF
    NEXT i
    RETURN out$
ENDFUNC

' A Set-Cookie value: name=value, the value percent-encoded where a cookie
' cannot carry a byte, then the attributes opts names: "max_age" (seconds;
' 0 deletes the cookie), "path" (/), "domain", "secure" (FALSE), "httponly"
' (TRUE) and "samesite" (Lax; "" leaves it out). SameSite None always gets
' Secure, as browsers require.
EXPORT FUNC COOKIE$(name$, value$, opts = 0)
    DIM out$ = name$ + "=" + CookieEncode$(value$)
    DIM path$ = "/"
    DIM domain$ = ""
    DIM samesite$ = "Lax"
    DIM secure = FALSE
    DIM httponly = TRUE
    DIM age$ = ""
    IF TYPEOF(opts) = "OBJECT" THEN
        IF MAP.EXISTS(opts, "path") THEN
            DIM pv = opts{"path"}
            path$ = "" + pv
        ENDIF
        IF MAP.EXISTS(opts, "domain") THEN
            DIM dv = opts{"domain"}
            domain$ = "" + dv
        ENDIF
        IF MAP.EXISTS(opts, "samesite") THEN
            DIM sv = opts{"samesite"}
            samesite$ = "" + sv
        ENDIF
        IF MAP.EXISTS(opts, "secure") THEN
            DIM secure_v = opts{"secure"}
            IF secure_v THEN
                secure = TRUE
            ELSE
                secure = FALSE
            ENDIF
        ENDIF
        IF MAP.EXISTS(opts, "httponly") THEN
            DIM http_v = opts{"httponly"}
            IF http_v THEN
                httponly = TRUE
            ELSE
                httponly = FALSE
            ENDIF
        ENDIF
        IF MAP.EXISTS(opts, "max_age") THEN
            DIM age_v = opts{"max_age"}
            age$ = STR$(CLNG(age_v))
        ENDIF
    ENDIF
    IF age$ <> "" THEN out$ = out$ + "; Max-Age=" + age$
    IF path$ <> "" THEN out$ = out$ + "; Path=" + path$
    IF domain$ <> "" THEN out$ = out$ + "; Domain=" + domain$
    IF LCASE$(samesite$) = "none" THEN secure = TRUE
    IF secure THEN out$ = out$ + "; Secure"
    IF httponly THEN out$ = out$ + "; HttpOnly"
    IF samesite$ <> "" THEN out$ = out$ + "; SameSite=" + samesite$
    RETURN out$
ENDFUNC

' A copy of the response that sets a cookie, built by COOKIE$.
EXPORT FUNC SET_COOKIE(response, name$, value$, opts = 0)
    RETURN HEADER(response, "Set-Cookie", COOKIE$(name$, value$, opts))
ENDFUNC

' A cookie the request carries, percent-decoded, or "".
EXPORT FUNC COOKIE_VAL$(request, name$)
    DIM reqHdrs = request{"HEADERS"}
    IF TYPEOF(reqHdrs) = "NONE" THEN RETURN ""
    DIM raw = reqHdrs{"cookie"}
    IF TYPEOF(raw) = "NONE" THEN RETURN ""
    DIM s$ = "; " + ("" + raw)
    DIM key$ = "; " + name$ + "="
    DIM p = CINT(INSTR(s$, key$))
    IF p < 0 THEN RETURN ""
    DIM rest$ = MID$(s$, p + LEN(key$), LEN(s$))
    DIM cut = CINT(INSTR(rest$, ";"))
    IF cut >= 0 THEN rest$ = LEFT$(rest$, cut)
    RETURN PercentDecode$(rest$)
ENDFUNC

' ---- cookie-session auth (cookie name: jdwsession) ----

' The salted SHA-256 of the older password scheme; AUTH_LOGIN only reads it
' to move such a row to SECRET.HASH$.
EXPORT FUNC HASH_PW$(salt$, pw$)
    RETURN CODEC.SHA256$(salt$ + ":" + pw$)
ENDFUNC

FUNC PasswordMatches(pw$, salt$, stored$)
    IF LEFT$(stored$, 14) = "pbkdf2-sha256$" ORELSE LEFT$(stored$, 14) = "pbkdf2_sha256$" THEN RETURN SECRET.VERIFY(pw$, stored$)
    RETURN SECRET.EQUAL(HASH_PW$(salt$, pw$), stored$)
ENDFUNC

FUNC AuthRounds()
    IF NOT MAP.EXISTS(gSessionConf, "auth_rounds") THEN RETURN 600000
    DIM rounds = gSessionConf{"auth_rounds"}
    RETURN rounds
ENDFUNC

' The signed-in user's name, or "". A sign-in unused for longer than the
' "auth_ttl" setting is removed; each use keeps it alive.
EXPORT FUNC AUTH_USER$(db, request)
    DIM token$ = COOKIE_VAL$(request, "jdwsession")
    IF LEN(token$) = 0 THEN RETURN ""
    DIM now = SessionNow()
    DIM now$ = STR$(CLNG(now))
    DIM rows = SQL.TABLE(db, "SELECT username, COALESCE(last_seen, " + now$ + "), last_seen IS NULL FROM sessions WHERE token = '" + ESC$(token$) + "'")
    IF LEN(rows) = 0 THEN RETURN ""
    DIM who$ = rows[0, 0]
    DIM seen = rows[0, 1]
    DIM never = rows[0, 2]
    DIM ttl = gSessionConf{"auth_ttl"}
    IF ttl > 0 ANDALSO now - seen > ttl THEN
        SQL.EXEC(db, "DELETE FROM sessions WHERE token = '" + ESC$(token$) + "'")
        RETURN ""
    ENDIF
    IF never <> 0 ORELSE now - seen >= 60 THEN
        SQL.EXEC(db, "UPDATE sessions SET last_seen = " + now$ + " WHERE token = '" + ESC$(token$) + "'")
    ENDIF
    RETURN who$
ENDFUNC

EXPORT FUNC UNAUTH()
    RETURN { "__http_status": 401, "__http_content_type": "application/json", _
        "__http_body": JSON.STRINGIFY$({ "error": "unauthorized" }) }
ENDFUNC

EXPORT FUNC REDIRECT_TO(loc$)
    RETURN { "__http_status": 302, "__http_headers": { "Location": loc$ }, "__http_body": "" }
ENDFUNC

EXPORT SUB AUTH_INIT(db)
    SQL.EXEC(db, "CREATE TABLE IF NOT EXISTS users (" + _
        "id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE, " + _
        "salt TEXT, pass_hash TEXT, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
    SQL.EXEC(db, "CREATE TABLE IF NOT EXISTS sessions (" + _
        "token TEXT PRIMARY KEY, username TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
    SQL.EXEC(db, "ALTER TABLE users ADD COLUMN salt TEXT")
    SQL.EXEC(db, "ALTER TABLE users ADD COLUMN pass_hash TEXT")
    SQL.EXEC(db, "ALTER TABLE sessions ADD COLUMN last_seen INTEGER")
    SQL.EXEC(db, "UPDATE sessions SET last_seen = " + STR$(CLNG(SessionNow())) + " WHERE last_seen IS NULL")
ENDSUB

EXPORT FUNC AUTH_LOGIN(db, request, secure)
    DIM raw_body = request{"BODY"}
    DIM body = JSON.PARSE$(raw_body)
    DIM name$ = FIELD$(body, "name")
    DIM pw$ = FIELD$(body, "password")
    IF LEN(name$) = 0 ORELSE LEN(pw$) = 0 THEN RETURN { "error": "name and password required" }

    ' A password not set yet is NULL; the query reports it as a flag, so the
    ' cells read the same in both backends.
    DIM pick$ = "SELECT id, name, COALESCE(salt, ''), COALESCE(pass_hash, ''), pass_hash IS NULL FROM users WHERE name = '" + ESC$(name$) + "'"
    DIM known = SQL.TABLE(db, pick$)
    IF LEN(known) = 0 THEN
        DIM cnt = SQL.TABLE(db, "SELECT COUNT(*) FROM users")
        DIM n_users = cnt[0, 0]
        IF n_users > 0 THEN RETURN { "error": "unknown user" }
        SQL.EXEC(db, "INSERT INTO users (name) VALUES ('" + ESC$(name$) + "')")
    ENDIF
    DIM rows = SQL.TABLE(db, pick$)
    DIM uid = rows[0, 0]
    DIM name2$ = rows[0, 1]
    DIM stored_salt$ = rows[0, 2]
    DIM stored_hash$ = rows[0, 3]
    DIM no_hash = rows[0, 4]

    ' A password is kept as SECRET.HASH$. A row from the older salted SHA-256
    ' scheme, or one hashed with fewer rounds than auth_rounds, is hashed
    ' again with the password that just matched.
    DIM renew = (no_hash <> 0)
    IF no_hash = 0 THEN
        IF NOT PasswordMatches(pw$, stored_salt$, stored_hash$) THEN RETURN { "error": "wrong password" }
        IF LEN(stored_salt$) > 0 ORELSE SECRET.NEEDS_REHASH(stored_hash$, AuthRounds()) THEN renew = TRUE
    ENDIF
    IF renew THEN
        SQL.EXEC(db, "UPDATE users SET salt = '', pass_hash = '" + ESC$(SECRET.HASH$(pw$, AuthRounds())) + _
            "' WHERE id = " + STR$(INT(uid)))
    ENDIF

    DIM token$ = SECRET.TOKEN$()
    SQL.EXEC(db, "INSERT INTO sessions (token, username, last_seen) VALUES ('" + token$ + "', '" + ESC$(name2$) + "', " + STR$(CLNG(SessionNow())) + ")")

    DIM copts AS MAP
    IF secure = TRUE THEN copts{"secure"} = TRUE
    DIM cookie$ = COOKIE$("jdwsession", token$, copts)
    RETURN { "__http_status": 200, "__http_headers": { "Set-Cookie": cookie$ }, _
        "__http_content_type": "application/json", _
        "__http_body": JSON.STRINGIFY$({ "ok": TRUE, "name": name2$ }) }
ENDFUNC

EXPORT FUNC AUTH_LOGOUT(db, request)
    DIM token$ = COOKIE_VAL$(request, "jdwsession")
    IF LEN(token$) > 0 THEN SQL.EXEC(db, "DELETE FROM sessions WHERE token = '" + ESC$(token$) + "'")
    DIM gone AS MAP
    gone{"max_age"} = 0
    DIM cookie$ = COOKIE$("jdwsession", "", gone)
    RETURN { "__http_status": 200, "__http_headers": { "Set-Cookie": cookie$ }, _
        "__http_content_type": "application/json", "__http_body": "{}" }
ENDFUNC

EXPORT FUNC AUTH_ME(db, request)
    DIM u$ = AUTH_USER$(db, request)
    IF LEN(u$) = 0 THEN RETURN UNAUTH()
    RETURN { "name": u$ }
ENDFUNC

' The sign-ins unused for longer than the "auth_ttl" setting removed; the
' number removed.
EXPORT FUNC AUTH_CLEANUP(db)
    DIM ttl = gSessionConf{"auth_ttl"}
    IF ttl <= 0 THEN RETURN 0
    DIM limit$ = STR$(CLNG(SessionNow() - ttl))
    DIM counted = SQL.TABLE(db, "SELECT COUNT(*) FROM sessions WHERE last_seen < " + limit$)
    DIM removed = counted[0, 0]
    SQL.EXEC(db, "DELETE FROM sessions WHERE last_seen < " + limit$)
    RETURN CLNG(removed)
ENDFUNC

' ---- responses ----

' A response with a body, a status (200) and a content type (HTML).
EXPORT FUNC REPLY(body$, status = 200, content_type$ = "text/html; charset=utf-8")
    DIM hs AS MAP
    RETURN {"__http_status": status, "__http_content_type": content_type$, "__http_body": body$, "__http_headers": hs}
ENDFUNC

' A value sent as JSON with a status (200).
EXPORT FUNC REPLY_JSON(value, status = 200)
    RETURN REPLY(JSON.STRINGIFY$(value), status, "application/json; charset=utf-8")
ENDFUNC

' A copy of the response with one more header. Another Set-Cookie is added
' beside the ones already there (the header value becomes an array); any
' other name replaces its value.
EXPORT FUNC HEADER(response, name$, value$)
    DIM out AS MAP
    DIM fresh AS MAP
    DIM keys = MAP.KEYS(response)
    DIM k = 0
    DIM j = 0
    DIM c = 0
    DIM adding_cookie = (LCASE$(name$) = "set-cookie")
    DIM cookie_key$ = name$
    DIM cookies = []
    FOR k = 0 TO LEN(keys) - 1
        DIM key$ = keys[k]
        IF key$ = "__http_headers" THEN
            DIM old = response{key$}
            DIM names = MAP.KEYS(old)
            FOR j = 0 TO LEN(names) - 1
                DIM hn$ = names[j]
                DIM hv = old{hn$}
                IF adding_cookie ANDALSO LCASE$(hn$) = "set-cookie" THEN
                    cookie_key$ = hn$
                    IF TYPEOF(hv) = "ARRAY" THEN
                        FOR c = 0 TO LEN(hv) - 1
                            DIM kept$ = hv[c]
                            PUSH(cookies, kept$)
                        NEXT c
                    ELSE
                        DIM single$ = hv
                        PUSH(cookies, single$)
                    ENDIF
                ELSE
                    fresh{hn$} = hv
                ENDIF
            NEXT j
        ELSE
            DIM kv = response{key$}
            out{key$} = kv
        ENDIF
    NEXT k
    IF adding_cookie ANDALSO LEN(cookies) > 0 THEN
        PUSH(cookies, value$)
        fresh{cookie_key$} = cookies
    ELSE
        fresh{name$} = value$
    ENDIF
    out{"__http_headers"} = fresh
    RETURN out
ENDFUNC

' What a before middleware returns to let the request go on.
EXPORT FUNC PASS()
    RETURN {"__jdweb_pass": 1}
ENDFUNC

FUNC IsPass(value)
    IF TYPEOF(value) <> "OBJECT" THEN RETURN FALSE
    RETURN MAP.EXISTS(value, "__jdweb_pass")
ENDFUNC

' Any handler answer as a rich response: a string is HTML, a map or an array
' without __http_status is JSON, both with the given status.
FUNC Normalize(value, status)
    DIM kind$ = TYPEOF(value)
    IF kind$ = "OBJECT" THEN
        IF MAP.EXISTS(value, "__http_status") THEN RETURN value
        RETURN REPLY_JSON(value, status)
    ENDIF
    IF kind$ = "ARRAY" THEN RETURN REPLY_JSON(value, status)
    IF kind$ = "NONE" THEN RETURN REPLY("", status, "text/plain; charset=utf-8")
    RETURN REPLY("" + value, status, "text/html; charset=utf-8")
ENDFUNC

' ---- requests ----

FUNC HexNibble(c$)
    DIM code_n = ASC(UCASE$(c$))
    IF code_n >= 48 ANDALSO code_n <= 57 THEN RETURN code_n - 48
    IF code_n >= 65 ANDALSO code_n <= 70 THEN RETURN code_n - 55
    RETURN -1
ENDFUNC

FUNC PercentDecode$(s$)
    IF INSTR(s$, "%") < 0 THEN RETURN s$
    DIM out$ = ""
    DIM k = 0
    DIM n = LEN(s$)
    DO WHILE k < n
        DIM c$ = MID$(s$, k, 1)
        IF c$ = "%" ANDALSO k + 2 < n ANDALSO HexNibble(MID$(s$, k + 1, 1)) >= 0 ANDALSO HexNibble(MID$(s$, k + 2, 1)) >= 0 THEN
            out$ = out$ + CHR$(HexNibble(MID$(s$, k + 1, 1)) * 16 + HexNibble(MID$(s$, k + 2, 1)))
            k = k + 3
        ELSE
            out$ = out$ + c$
            k = k + 1
        ENDIF
    LOOP
    RETURN out$
ENDFUNC

' A route parameter (":id" in the pattern) or, when there is none of that
' name, a query parameter; "" when neither is there.
EXPORT FUNC PARAM$(request, name$)
    IF MAP.EXISTS(gCurrent, "route") THEN
        DIM route = gCurrent{"route"}
        IF MAP.EXISTS(route, name$) THEN
            DIM rv$ = route{name$}
            RETURN rv$
        ENDIF
    ENDIF
    IF MAP.EXISTS(request, "PARAMS") THEN
        DIM query = request{"PARAMS"}
        IF TYPEOF(query) = "OBJECT" THEN
            IF MAP.EXISTS(query, name$) THEN
                DIM qv = query{name$}
                RETURN "" + qv
            ENDIF
        ENDIF
    ENDIF
    RETURN ""
ENDFUNC

' ---- routing ----

' A handler for method$ and a path pattern: "/users/:id" takes one segment
' as the parameter id, "/files/*path" the rest of the path as path.
EXPORT SUB ROUTE(method$, pattern$, handler)
    DIM key$ = "r" + STR$(LEN(gRoutePatterns))
    gRouteFns{key$} = handler
    PUSH(gRouteMethods, UCASE$(method$))
    PUSH(gRoutePatterns, pattern$)
ENDSUB

EXPORT SUB GET(pattern$, handler)
    ROUTE("GET", pattern$, handler)
ENDSUB

EXPORT SUB POST(pattern$, handler)
    ROUTE("POST", pattern$, handler)
ENDSUB

EXPORT SUB PUT(pattern$, handler)
    ROUTE("PUT", pattern$, handler)
ENDSUB

EXPORT SUB DELETE(pattern$, handler)
    ROUTE("DELETE", pattern$, handler)
ENDSUB

EXPORT SUB PATCH(pattern$, handler)
    ROUTE("PATCH", pattern$, handler)
ENDSUB

' A handler for every method.
EXPORT SUB ANY(pattern$, handler)
    ROUTE("*", pattern$, handler)
ENDSUB

' A function run before every route: it returns PASS() to go on or a
' response to answer at once.
EXPORT SUB BEFORE(handler)
    DIM key$ = "b" + STR$(LEN(gBeforeIds))
    gBeforeFns{key$} = handler
    PUSH(gBeforeIds, key$)
ENDSUB

' A function run on every response: it gets the request and returns a map
' of headers to add, or a response with __http_status to send instead.
' CURRENT_STATUS() tells the status of the response so far.
EXPORT SUB AFTER(handler)
    DIM key$ = "a" + STR$(LEN(gAfterIds))
    gAfterFns{key$} = handler
    PUSH(gAfterIds, key$)
ENDSUB

' The handler for paths no route and no static folder answers (status 404).
EXPORT SUB ON_MISSING(handler)
    gHooks{"missing"} = handler
ENDSUB

' The handler for a route that throws: it gets the request and reads the
' error message with ERROR_MESSAGE$() (status 500).
EXPORT SUB ON_ERROR(handler)
    gHooks{"error"} = handler
ENDSUB

' The status of the response an AFTER function is called for.
EXPORT FUNC CURRENT_STATUS()
    DIM st = gCurrent{"status"}
    RETURN st
ENDFUNC

' The message of the error an ON_ERROR handler answers.
EXPORT FUNC ERROR_MESSAGE$()
    DIM m$ = gCurrent{"error"}
    RETURN m$
ENDFUNC

FUNC Segments(path$)
    DIM parts = SPLIT(path$, "/")
    DIM out = []
    DIM k = 0
    FOR k = 0 TO LEN(parts) - 1
        DIM p$ = parts[k]
        IF p$ <> "" THEN PUSH(out, p$)
    NEXT k
    RETURN out
ENDFUNC

' The parameters of a path matched against a pattern, with the key
' __matched when it matches.
FUNC MatchRoute(pattern$, path$)
    DIM got AS MAP
    DIM ps = Segments(pattern$)
    DIM xs = Segments(path$)
    DIM k = 0
    DIM j = 0
    FOR k = 0 TO LEN(ps) - 1
        DIM seg$ = ps[k]
        IF LEFT$(seg$, 1) = "*" THEN
            DIM rest$ = ""
            FOR j = k TO LEN(xs) - 1
                DIM part_r$ = xs[j]
                IF rest$ <> "" THEN rest$ = rest$ + "/"
                rest$ = rest$ + part_r$
            NEXT j
            DIM star$ = MID$(seg$, 1, LEN(seg$))
            IF star$ = "" THEN star$ = "rest"
            got{star$} = PercentDecode$(rest$)
            got{"__matched"} = 1
            RETURN got
        ENDIF
        IF k >= LEN(xs) THEN RETURN got
        DIM part$ = xs[k]
        IF LEFT$(seg$, 1) = ":" THEN
            got{MID$(seg$, 1, LEN(seg$))} = PercentDecode$(part$)
        ELSEIF seg$ <> part$ THEN
            RETURN got
        ENDIF
    NEXT k
    IF LEN(xs) <> LEN(ps) THEN RETURN got
    got{"__matched"} = 1
    RETURN got
ENDFUNC

FUNC CallHandler(handler, request)
    DIM result = REPLY("", 500, "text/plain; charset=utf-8")
    DIM failed = FALSE
    DIM msg$ = ""
    TRY
        DIM answer = handler(request)
        result = Normalize(answer, 200)
    CATCH
        failed = TRUE
        msg$ = ERRMSG$
    ENDTRY
    IF NOT failed THEN RETURN result
    IF MAP.EXISTS(gHooks, "error") THEN
        DIM efn = gHooks{"error"}
        gCurrent{"error"} = msg$
        DIM error_value = efn(request)
        RETURN Normalize(error_value, 500)
    ENDIF
    RETURN REPLY("Internal Server Error", 500, "text/plain; charset=utf-8")
ENDFUNC

FUNC MimeOf$(name$)
    DIM dot = -1
    DIM k = 0
    FOR k = 0 TO LEN(name$) - 1
        IF MID$(name$, k, 1) = "." THEN dot = k
    NEXT k
    IF dot < 0 THEN RETURN "application/octet-stream"
    DIM ext$ = LCASE$(MID$(name$, dot + 1, LEN(name$)))
    IF ext$ = "html" ORELSE ext$ = "htm" THEN RETURN "text/html; charset=utf-8"
    IF ext$ = "css" THEN RETURN "text/css; charset=utf-8"
    IF ext$ = "js" ORELSE ext$ = "mjs" THEN RETURN "application/javascript; charset=utf-8"
    IF ext$ = "json" THEN RETURN "application/json; charset=utf-8"
    IF ext$ = "txt" THEN RETURN "text/plain; charset=utf-8"
    IF ext$ = "md" THEN RETURN "text/markdown; charset=utf-8"
    IF ext$ = "xml" THEN RETURN "application/xml"
    IF ext$ = "svg" THEN RETURN "image/svg+xml"
    IF ext$ = "png" THEN RETURN "image/png"
    IF ext$ = "jpg" ORELSE ext$ = "jpeg" THEN RETURN "image/jpeg"
    IF ext$ = "gif" THEN RETURN "image/gif"
    IF ext$ = "webp" THEN RETURN "image/webp"
    IF ext$ = "ico" THEN RETURN "image/x-icon"
    IF ext$ = "pdf" THEN RETURN "application/pdf"
    IF ext$ = "woff2" THEN RETURN "font/woff2"
    RETURN "application/octet-stream"
ENDFUNC

' Files of a folder served under a path prefix: "/static/app.css" from
' dir$ + "/app.css", a folder by its index.html.
EXPORT SUB ASSETS(prefix$, dir$)
    DIM pre$ = prefix$
    DO WHILE LEN(pre$) > 1 ANDALSO RIGHT$(pre$, 1) = "/"
        pre$ = LEFT$(pre$, LEN(pre$) - 1)
    LOOP
    PUSH(gStaticPrefixes, pre$)
    PUSH(gStaticDirs, dir$)
ENDSUB

FUNC StaticFile(path$)
    DIM none AS MAP
    DIM k = 0
    FOR k = 0 TO LEN(gStaticPrefixes) - 1
        DIM pre$ = gStaticPrefixes[k]
        DIM dir$ = gStaticDirs[k]
        DIM rel$ = ""
        DIM hit = FALSE
        IF pre$ = "/" ORELSE pre$ = "" THEN
            rel$ = MID$(path$, 1, LEN(path$))
            hit = TRUE
        ELSEIF path$ = pre$ THEN
            hit = TRUE
        ELSEIF LEFT$(path$, LEN(pre$) + 1) = pre$ + "/" THEN
            rel$ = MID$(path$, LEN(pre$) + 1, LEN(path$))
            hit = TRUE
        ENDIF
        IF hit THEN
            rel$ = PercentDecode$(rel$)
            IF INSTR(rel$, "..") >= 0 ORELSE INSTR(rel$, "\") >= 0 ORELSE INSTR(rel$, ":") >= 0 THEN RETURN REPLY("Forbidden", 403, "text/plain; charset=utf-8")
            IF rel$ = "" ORELSE RIGHT$(rel$, 1) = "/" THEN rel$ = rel$ + "index.html"
            DIM file$ = PATH.JOIN$(dir$, rel$)
            IF FILE.EXISTS(file$) THEN RETURN REPLY(BINREADER$(file$), 200, MimeOf$(rel$))
        ENDIF
    NEXT k
    RETURN none
ENDFUNC

' ---- sessions ----

FUNC SessionNow()
    DIM shift = gSessionConf{"clock_shift"}
    RETURN INT(NOW_EPOCH()) + shift
ENDFUNC

FUNC SessionCookie$()
    DIM name$ = gSessionConf{"cookie"}
    RETURN name$
ENDFUNC

' Settings for the sessions, as a map with any of: "ttl" (seconds a session
' lives after its last use, 86400; 0 for no limit), "lifetime" (seconds
' since it was made, 0 for no limit), "cookie" (jdwsid), "secure" (FALSE),
' "samesite" (Lax), "domain", "path" (/), "db" (a SQLite handle that keeps
' the sessions across restarts; 0 keeps them in memory), "auth_ttl"
' (seconds a sign-in of AUTH_LOGIN lives after its last use, 2592000) and
' "auth_rounds" (PBKDF2 rounds of a stored password, 600000). Setting "db"
' drops the sessions held in memory, so they are read from the database.
EXPORT SUB SESSION_CONFIG(opts)
    DIM known$ = ",ttl,lifetime,cookie,secure,samesite,domain,path,db,auth_ttl,auth_rounds,"
    DIM keys = MAP.KEYS(opts)
    DIM k = 0
    FOR k = 0 TO LEN(keys) - 1
        DIM key$ = keys[k]
        IF INSTR(known$, "," + key$ + ",") < 0 THEN THROW "JDWEB.SESSION_CONFIG: unknown setting " + key$
    NEXT k
    FOR k = 0 TO LEN(keys) - 1
        DIM set_key$ = keys[k]
        DIM v = opts{set_key$}
        gSessionConf{set_key$} = v
    NEXT k
    IF MAP.EXISTS(opts, "db") THEN
        DIM held = MAP.KEYS(gSessions)
        FOR k = 0 TO LEN(held) - 1
            DIM held_sid$ = held[k]
            DropHeld(held_sid$)
        NEXT k
        DIM db = gSessionConf{"db"}
        IF db <> 0 THEN
            SQL.EXEC(db, "CREATE TABLE IF NOT EXISTS jdweb_sessions (id TEXT PRIMARY KEY, " + _
                "data TEXT NOT NULL, created INTEGER NOT NULL, seen INTEGER NOT NULL)")
        ENDIF
    ENDIF
ENDSUB

' Moves the session clock by shift_seconds, for tests of expiry.
EXPORT SUB SESSION_CLOCK(shift_seconds)
    gSessionConf{"clock_shift"} = shift_seconds
ENDSUB

SUB DropHeld(sid$)
    IF MAP.EXISTS(gSessions, sid$) THEN MAP.DELETE(gSessions, sid$)
    IF MAP.EXISTS(gSessionCreated, sid$) THEN MAP.DELETE(gSessionCreated, sid$)
    IF MAP.EXISTS(gSessionSeen, sid$) THEN MAP.DELETE(gSessionSeen, sid$)
ENDSUB

SUB ForgetSession(sid$)
    DropHeld(sid$)
    DIM db = gSessionConf{"db"}
    IF db <> 0 THEN SQL.EXEC(db, "DELETE FROM jdweb_sessions WHERE id = '" + ESC$(sid$) + "'")
ENDSUB

' Whether the session sid$ is held in memory, reading it from the database
' store when it is kept there.
FUNC HeldOrLoaded(sid$)
    IF MAP.EXISTS(gSessions, sid$) THEN RETURN TRUE
    DIM db = gSessionConf{"db"}
    IF db = 0 THEN RETURN FALSE
    DIM rows = SQL.TABLE(db, "SELECT data, created, seen FROM jdweb_sessions WHERE id = '" + ESC$(sid$) + "'")
    IF LEN(rows) = 0 THEN RETURN FALSE
    DIM data$ = rows[0, 0]
    DIM created = rows[0, 1]
    DIM seen = rows[0, 2]
    DIM loaded = JSON.PARSE$(data$)
    IF TYPEOF(loaded) <> "OBJECT" THEN RETURN FALSE
    gSessions{sid$} = loaded
    gSessionCreated{sid$} = created
    gSessionSeen{sid$} = seen
    RETURN TRUE
ENDFUNC

SUB SaveSession(sid$)
    DIM db = gSessionConf{"db"}
    IF db <> 0 ANDALSO MAP.EXISTS(gSessions, sid$) THEN
        DIM data = gSessions{sid$}
        DIM created = gSessionCreated{sid$}
        DIM seen = gSessionSeen{sid$}
        SQL.EXEC(db, "INSERT OR REPLACE INTO jdweb_sessions (id, data, created, seen) VALUES ('" + _
            ESC$(sid$) + "', '" + ESC$(JSON.STRINGIFY$(data)) + "', " + STR$(CLNG(created)) + ", " + STR$(CLNG(seen)) + ")")
    ENDIF
ENDSUB

FUNC IsExpired(sid$, now)
    DIM ttl = gSessionConf{"ttl"}
    DIM lifetime = gSessionConf{"lifetime"}
    DIM seen = gSessionSeen{sid$}
    DIM created = gSessionCreated{sid$}
    IF ttl > 0 ANDALSO now - seen > ttl THEN RETURN TRUE
    IF lifetime > 0 ANDALSO now - created > lifetime THEN RETURN TRUE
    RETURN FALSE
ENDFUNC

' The id of the live session of this request: one made while answering it,
' or the one its cookie names when that has not expired. An expired session
' is forgotten. "" when there is none.
FUNC LiveSid$(request)
    DIM made$ = ""
    IF MAP.EXISTS(gCurrent, "sid_new") THEN made$ = gCurrent{"sid_new"}
    IF made$ <> "" ANDALSO MAP.EXISTS(gSessions, made$) THEN RETURN made$
    DIM sid$ = COOKIE_VAL$(request, SessionCookie$())
    IF sid$ = "" THEN RETURN ""
    IF NOT HeldOrLoaded(sid$) THEN RETURN ""
    DIM now = SessionNow()
    IF IsExpired(sid$, now) THEN
        ForgetSession(sid$)
        RETURN ""
    ENDIF
    gSessionSeen{sid$} = now
    gCurrent{"sid_used"} = sid$
    RETURN sid$
ENDFUNC

' The session map of the visitor. A new visitor, or one whose session
' expired, gets an empty one and the response sets its cookie; what is
' stored in the map stays for the next request.
EXPORT FUNC SESSION(request)
    DIM sid$ = LiveSid$(request)
    IF sid$ = "" THEN
        sid$ = SECRET.TOKEN$()
        DIM fresh AS MAP
        DIM now = SessionNow()
        gSessions{sid$} = fresh
        gSessionCreated{sid$} = now
        gSessionSeen{sid$} = now
        gCurrent{"sid_new"} = sid$
    ENDIF
    DIM stored = gSessions{sid$}
    RETURN stored
ENDFUNC

' The visitor's session moved to a new id with what it holds, and the old id
' forgotten. Call it when a visitor signs in, so an id known before the
' sign-in is worth nothing after it. The lifetime counts from here.
EXPORT FUNC SESSION_ROTATE(request)
    DIM old$ = LiveSid$(request)
    DIM moved AS MAP
    IF old$ <> "" THEN
        DIM kept = gSessions{old$}
        DIM names = MAP.KEYS(kept)
        DIM k = 0
        FOR k = 0 TO LEN(names) - 1
            DIM key$ = names[k]
            DIM v = kept{key$}
            moved{key$} = v
        NEXT k
        ForgetSession(old$)
    ENDIF
    DIM sid$ = SECRET.TOKEN$()
    DIM now = SessionNow()
    gSessions{sid$} = moved
    gSessionCreated{sid$} = now
    gSessionSeen{sid$} = now
    gCurrent{"sid_new"} = sid$
    gCurrent{"sid_used"} = ""
    DIM stored = gSessions{sid$}
    RETURN stored
ENDFUNC

' The visitor's session forgotten and its cookie cleared.
EXPORT SUB SESSION_END(request)
    DIM sid$ = COOKIE_VAL$(request, SessionCookie$())
    IF sid$ <> "" THEN ForgetSession(sid$)
    DIM made$ = ""
    IF MAP.EXISTS(gCurrent, "sid_new") THEN made$ = gCurrent{"sid_new"}
    IF made$ <> "" THEN ForgetSession(made$)
    gCurrent{"sid_new"} = ""
    gCurrent{"sid_used"} = ""
    gCurrent{"sid_end"} = 1
ENDSUB

' The expired sessions removed from memory and from the database store; the
' number removed.
EXPORT FUNC SESSION_CLEANUP()
    DIM now = SessionNow()
    DIM ttl = gSessionConf{"ttl"}
    DIM lifetime = gSessionConf{"lifetime"}
    DIM removed = 0
    DIM ids = MAP.KEYS(gSessionSeen)
    DIM k = 0
    FOR k = 0 TO LEN(ids) - 1
        DIM sid$ = ids[k]
        IF IsExpired(sid$, now) THEN
            DropHeld(sid$)
            removed = removed + 1
        ENDIF
    NEXT k
    DIM db = gSessionConf{"db"}
    IF db <> 0 ANDALSO (ttl > 0 ORELSE lifetime > 0) THEN
        DIM where$ = "0"
        IF ttl > 0 THEN where$ = where$ + " OR seen < " + STR$(CLNG(now - ttl))
        IF lifetime > 0 THEN where$ = where$ + " OR created < " + STR$(CLNG(now - lifetime))
        DIM counted = SQL.TABLE(db, "SELECT COUNT(*) FROM jdweb_sessions WHERE " + where$)
        DIM in_db = counted[0, 0]
        SQL.EXEC(db, "DELETE FROM jdweb_sessions WHERE " + where$)
        IF in_db > removed THEN removed = in_db
    ENDIF
    gSessionConf{"last_cleanup"} = now
    RETURN CLNG(removed)
ENDFUNC

' ---- flash messages ----

' A message kept in the visitor's session until FLASHES reads it, usually on
' the page a redirect leads to. kind$ is free text such as info or error.
EXPORT SUB FLASH(request, message$, kind$ = "info")
    DIM sess = SESSION(request)
    DIM item$ = JSON.STRINGIFY$({"kind": kind$, "text": message$})
    DIM list$ = "[" + item$ + "]"
    IF MAP.EXISTS(sess, "__flash") THEN
        DIM kept$ = sess{"__flash"}
        list$ = LEFT$(kept$, LEN(kept$) - 1) + "," + item$ + "]"
    ENDIF
    sess{"__flash"} = list$
ENDSUB

' The flash messages of the visitor as an array of maps with "kind" and
' "text", oldest first; reading them removes them.
EXPORT FUNC FLASHES(request)
    DIM sid$ = LiveSid$(request)
    DIM kept$ = "[]"
    IF sid$ <> "" THEN
        DIM sess = gSessions{sid$}
        IF MAP.EXISTS(sess, "__flash") THEN
            kept$ = sess{"__flash"}
            MAP.DELETE(sess, "__flash")
        ENDIF
    ENDIF
    DIM parsed = JSON.PARSE$(kept$)
    RETURN parsed
ENDFUNC

' ---- CSRF ----

' The CSRF token of the visitor's session, made on first use. A form sends
' it in a field named csrf_token, a script in an X-CSRF-Token header.
EXPORT FUNC CSRF_TOKEN$(request)
    DIM sess = SESSION(request)
    IF MAP.EXISTS(sess, "__csrf") THEN
        DIM have$ = sess{"__csrf"}
        RETURN have$
    ENDIF
    DIM made$ = SECRET.TOKEN$()
    sess{"__csrf"} = made$
    RETURN made$
ENDFUNC

' From here on POST, PUT, PATCH and DELETE need the session's CSRF token,
' except under the path prefixes CSRF_EXEMPT names; a request without the
' right token is answered with 403. CSRF_PROTECT(FALSE) turns it off.
EXPORT SUB CSRF_PROTECT(enabled = TRUE)
    IF enabled THEN
        gSessionConf{"csrf"} = TRUE
    ELSE
        gSessionConf{"csrf"} = FALSE
    ENDIF
ENDSUB

' A path prefix whose requests need no CSRF token, such as an API that
' checks a key in a header instead of a cookie.
EXPORT SUB CSRF_EXEMPT(prefix$)
    PUSH(gCsrfExempt, prefix$)
ENDSUB

' The CSRF token a request carries: the X-CSRF-Token header, or the
' csrf_token field of a form body.
FUNC SentCsrf$(request)
    DIM hs = request{"HEADERS"}
    DIM form = FALSE
    IF TYPEOF(hs) = "OBJECT" THEN
        IF MAP.EXISTS(hs, "x-csrf-token") THEN
            DIM hv = hs{"x-csrf-token"}
            RETURN TRIM$("" + hv)
        ENDIF
        IF MAP.EXISTS(hs, "content-type") THEN
            DIM ct = hs{"content-type"}
            IF INSTR(LCASE$("" + ct), "application/x-www-form-urlencoded") >= 0 THEN form = TRUE
        ENDIF
    ENDIF
    IF NOT form THEN RETURN ""
    DIM body = request{"BODY"}
    IF TYPEOF(body) <> "STRING" THEN RETURN ""
    DIM body$ = body
    DIM pairs = SPLIT(body$, "&")
    DIM k = 0
    FOR k = 0 TO LEN(pairs) - 1
        DIM pair$ = pairs[k]
        IF LEFT$(pair$, 11) = "csrf_token=" THEN RETURN PercentDecode$(REPLACE$(MID$(pair$, 11, LEN(pair$)), "+", " "))
    NEXT k
    RETURN ""
ENDFUNC

FUNC CsrfRefused(request, method$, path$)
    DIM active = gSessionConf{"csrf"}
    IF NOT active THEN RETURN FALSE
    IF method$ = "GET" ORELSE method$ = "HEAD" ORELSE method$ = "OPTIONS" THEN RETURN FALSE
    DIM k = 0
    FOR k = 0 TO LEN(gCsrfExempt) - 1
        DIM pre$ = gCsrfExempt[k]
        IF LEFT$(path$, LEN(pre$)) = pre$ THEN RETURN FALSE
    NEXT k
    DIM sent$ = SentCsrf$(request)
    IF sent$ = "" THEN RETURN TRUE
    DIM sid$ = LiveSid$(request)
    IF sid$ = "" THEN RETURN TRUE
    DIM sess = gSessions{sid$}
    IF NOT MAP.EXISTS(sess, "__csrf") THEN RETURN TRUE
    DIM want$ = sess{"__csrf"}
    RETURN NOT SECRET.EQUAL(sent$, want$)
ENDFUNC

' ---- dispatch ----

FUNC Finish(request, response)
    DIM out = response
    DIM k = 0
    FOR k = 0 TO LEN(gAfterIds) - 1
        DIM akey$ = gAfterIds[k]
        DIM afn = gAfterFns{akey$}
        DIM status_now = out{"__http_status"}
        gCurrent{"status"} = status_now
        DIM after_value = afn(request)
        IF TYPEOF(after_value) = "OBJECT" THEN
            IF MAP.EXISTS(after_value, "__http_status") THEN
                out = after_value
            ELSE
                DIM extra = MAP.KEYS(after_value)
                DIM j = 0
                FOR j = 0 TO LEN(extra) - 1
                    DIM en$ = extra[j]
                    DIM ev = after_value{en$}
                    out = HEADER(out, en$, "" + ev)
                NEXT j
            ENDIF
        ENDIF
    NEXT k
    DIM ended = 0
    IF MAP.EXISTS(gCurrent, "sid_end") THEN ended = gCurrent{"sid_end"}
    DIM sid$ = ""
    IF MAP.EXISTS(gCurrent, "sid_new") THEN sid$ = gCurrent{"sid_new"}
    DIM used$ = ""
    IF MAP.EXISTS(gCurrent, "sid_used") THEN used$ = gCurrent{"sid_used"}
    DIM copts AS MAP
    DIM c_path = gSessionConf{"path"}
    DIM c_domain = gSessionConf{"domain"}
    DIM c_secure = gSessionConf{"secure"}
    DIM c_samesite = gSessionConf{"samesite"}
    copts{"path"} = c_path
    copts{"domain"} = c_domain
    copts{"secure"} = c_secure
    copts{"samesite"} = c_samesite
    IF sid$ <> "" THEN
        out = HEADER(out, "Set-Cookie", COOKIE$(SessionCookie$(), sid$, copts))
        SaveSession(sid$)
    ELSEIF ended <> 0 THEN
        copts{"max_age"} = 0
        out = HEADER(out, "Set-Cookie", COOKIE$(SessionCookie$(), "", copts))
    ENDIF
    IF used$ <> "" ANDALSO used$ <> sid$ THEN SaveSession(used$)
    RETURN out
ENDFUNC

' The answer to one request: before middleware, the CSRF check, the first
' route whose pattern and method match, the static folders, the missing
' handler, then the after middleware. MOUNT wires it to the server.
EXPORT FUNC DISPATCH(request)
    DIM m = request{"METHOD"}
    DIM method$ = UCASE$("" + m)
    DIM pth = request{"PATH"}
    DIM path$ = "" + pth
    DIM no_route AS MAP
    gCurrent{"route"} = no_route
    gCurrent{"sid_new"} = ""
    gCurrent{"sid_used"} = ""
    gCurrent{"sid_end"} = 0
    DIM last_sweep = gSessionConf{"last_cleanup"}
    IF SessionNow() - last_sweep >= 300 THEN
        DIM swept = SESSION_CLEANUP()
    ENDIF
    DIM k = 0
    FOR k = 0 TO LEN(gBeforeIds) - 1
        DIM bkey$ = gBeforeIds[k]
        DIM bfn = gBeforeFns{bkey$}
        DIM early = bfn(request)
        IF NOT IsPass(early) THEN RETURN Finish(request, Normalize(early, 200))
    NEXT k
    IF CsrfRefused(request, method$, path$) THEN RETURN Finish(request, REPLY("CSRF token missing or wrong", 403, "text/plain; charset=utf-8"))
    DIM allowed$ = ""
    FOR k = 0 TO LEN(gRoutePatterns) - 1
        DIM pat$ = gRoutePatterns[k]
        DIM got = MatchRoute(pat$, path$)
        IF MAP.EXISTS(got, "__matched") THEN
            DIM rmethod$ = gRouteMethods[k]
            IF rmethod$ = method$ ORELSE rmethod$ = "*" ORELSE (method$ = "HEAD" ANDALSO rmethod$ = "GET") THEN
                gCurrent{"route"} = got
                DIM rkey$ = "r" + STR$(k)
                DIM handler = gRouteFns{rkey$}
                RETURN Finish(request, CallHandler(handler, request))
            ENDIF
            IF INSTR(", " + allowed$ + ",", ", " + rmethod$ + ",") < 0 THEN
                IF allowed$ <> "" THEN allowed$ = allowed$ + ", "
                allowed$ = allowed$ + rmethod$
            ENDIF
        ENDIF
    NEXT k
    IF allowed$ <> "" THEN
        DIM refused = REPLY("Method Not Allowed", 405, "text/plain; charset=utf-8")
        RETURN Finish(request, HEADER(refused, "Allow", allowed$))
    ENDIF
    IF method$ = "GET" ORELSE method$ = "HEAD" THEN
        DIM served = StaticFile(path$)
        IF MAP.EXISTS(served, "__http_status") THEN RETURN Finish(request, served)
    ENDIF
    IF MAP.EXISTS(gHooks, "missing") THEN
        DIM mfn = gHooks{"missing"}
        DIM missing_value = mfn(request)
        RETURN Finish(request, Normalize(missing_value, 404))
    ENDIF
    RETURN Finish(request, REPLY("Not Found", 404, "text/plain; charset=utf-8"))
ENDFUNC

' ---- serving ----

' The routes put on the server; call before HTTP.SERVER.START.
EXPORT SUB MOUNT()
    HTTP.SERVER.ON_NOTFOUND("JDWEB.DISPATCH")
ENDSUB

' The server started on port with the routes mounted; TRUE when it runs.
EXPORT FUNC LISTEN(port, host$ = "127.0.0.1")
    MOUNT()
    RETURN HTTP.SERVER.START(port, host$)
ENDFUNC

' The app served until a handler stops the server.
EXPORT SUB SERVE(port, host$ = "127.0.0.1")
    IF LISTEN(port, host$) THEN HTTP.SERVER.WAIT
    HTTP.SERVER.STOP
ENDSUB

' ---- testing ----

FUNC LowerKeys(headers)
    DIM out AS MAP
    IF TYPEOF(headers) <> "OBJECT" THEN RETURN out
    DIM names = MAP.KEYS(headers)
    DIM k = 0
    FOR k = 0 TO LEN(names) - 1
        DIM hn$ = names[k]
        DIM low$ = LCASE$(hn$)
        DIM hv = headers{hn$}
        IF MAP.EXISTS(out, low$) THEN
            DIM merged = BothValues(out{low$}, hv)
            out{low$} = merged
        ELSE
            out{low$} = hv
        ENDIF
    NEXT k
    RETURN out
ENDFUNC

' The values of one header name that arrived in two spellings (Set-Cookie
' and set-cookie), as one array in arrival order.
FUNC BothValues(have, more)
    DIM values_out = []
    DIM i = 0
    IF TYPEOF(have) = "ARRAY" THEN
        FOR i = 0 TO LEN(have) - 1
            DIM a$ = have[i]
            PUSH(values_out, a$)
        NEXT i
    ELSE
        DIM one$ = have
        PUSH(values_out, one$)
    ENDIF
    IF TYPEOF(more) = "ARRAY" THEN
        FOR i = 0 TO LEN(more) - 1
            DIM b$ = more[i]
            PUSH(values_out, b$)
        NEXT i
    ELSE
        DIM two$ = more
        PUSH(values_out, two$)
    ENDIF
    RETURN values_out
ENDFUNC

' A request to the app running in this process on port, as a map with
' "status", "body" and "headers" (lower-case names). headers is a map of
' request headers; a Content-Type among them sets the body's type.
EXPORT FUNC FETCH(port, method$, path$, body$ = "", headers = 0)
    HTTP.CLEARHEADERS()
    HTTP.CLEARCOOKIES()
    DIM ct$ = "application/json"
    IF TYPEOF(headers) = "OBJECT" THEN
        DIM names = MAP.KEYS(headers)
        DIM k = 0
        FOR k = 0 TO LEN(names) - 1
            DIM hn$ = names[k]
            DIM hv = headers{hn$}
            IF LCASE$(hn$) = "content-type" THEN
                ct$ = "" + hv
            ELSE
                HTTP.SETHEADER(hn$, "" + hv)
            ENDIF
        NEXT k
    ENDIF
    DIM raw = HTTP.REQUEST(UCASE$(method$), "http://127.0.0.1:" + STR$(port) + path$, body$, ct$)
    HTTP.CLEARHEADERS()
    DIM out AS MAP
    out{"status"} = raw{"status"}
    out{"body"} = raw{"body"}
    out{"headers"} = LowerKeys(raw{"headers"})
    RETURN out
ENDFUNC

' The value a response from FETCH sets for a cookie, or "". A response that
' sets several cookies carries them as an array.
EXPORT FUNC COOKIE_OF$(response, name$)
    DIM hs = response{"headers"}
    IF NOT MAP.EXISTS(hs, "set-cookie") THEN RETURN ""
    DIM raw = hs{"set-cookie"}
    IF TYPEOF(raw) = "ARRAY" THEN
        DIM i = 0
        FOR i = 0 TO LEN(raw) - 1
            DIM each$ = raw[i]
            IF LEFT$(each$, LEN(name$) + 1) = name$ + "=" THEN RETURN CookieValue$(each$, name$)
        NEXT i
        RETURN ""
    ENDIF
    DIM header$ = "" + raw
    RETURN CookieValue$(header$, name$)
ENDFUNC

FUNC CookieValue$(header$, name$)
    IF LEFT$(header$, LEN(name$) + 1) <> name$ + "=" THEN RETURN ""
    DIM rest$ = MID$(header$, LEN(name$) + 1, LEN(header$))
    DIM semi = CINT(INSTR(rest$, ";"))
    IF semi >= 0 THEN rest$ = LEFT$(rest$, semi)
    RETURN PercentDecode$(rest$)
ENDFUNC
