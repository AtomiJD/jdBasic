' SECRET: password hashes with PBKDF2-HMAC-SHA256, comparison in constant
' time, random tokens, and API keys kept as hashes.
'
'   IMPORT SECRET
'   DIM stored$ = SECRET.HASH$(password$)
'   IF SECRET.VERIFY(attempt$, stored$) THEN PRINT "welcome"
'   IF SECRET.NEEDS_REHASH(stored$) THEN stored$ = SECRET.HASH$(attempt$)
'
' A hash reads pbkdf2-sha256$iterations$salt$key: the salt is 32 hex digits
' from 16 random bytes and is used as that text, the key is 32 bytes in 64
' hex digits. VERIFY also reads Django's pbkdf2_sha256$iterations$salt$key
' with the key in base64.
EXPORT MODULE SECRET

DIM gCompareKey$ = CODEC.SHA256$(CODEC.RANDOMBYTES$(32))

FUNC HexOf$(bytes$)
    DIM out$ = ""
    DIM i = 0
    FOR i = 0 TO LEN(bytes$) - 1
        out$ = out$ + LCASE$(RIGHT$("0" + HEX$(BYTEAT(bytes$, i)), 2))
    NEXT i
    RETURN out$
ENDFUNC

' Whether a text is one to nine decimal digits.
FUNC IsDigits(text$)
    IF LEN(text$) < 1 ORELSE LEN(text$) > 9 THEN RETURN FALSE
    DIM i = 0
    FOR i = 0 TO LEN(text$) - 1
        DIM ch$ = MID$(text$, i, 1)
        IF ch$ < "0" ORELSE ch$ > "9" THEN RETURN FALSE
    NEXT i
    RETURN TRUE
ENDFUNC

' ── passwords ──────────────────────────────────────────────────

' A hash of password$ with a fresh salt and iterations rounds (600000, the
' OWASP figure for PBKDF2-HMAC-SHA256).
EXPORT FUNC HASH$(password$, iterations = 600000)
    IF iterations < 1 THEN THROW "SECRET.HASH$: iterations must be at least 1"
    DIM salt$ = HexOf$(CODEC.RANDOMBYTES$(16))
    DIM rounds = CLNG(iterations)
    RETURN "pbkdf2-sha256$" + STR$(rounds) + "$" + salt$ + "$" + CODEC.PBKDF2$(password$, salt$, rounds, 32)
ENDFUNC

' Whether password$ is the one stored$ was made from. A hash in neither
' format, or a damaged one, answers FALSE.
EXPORT FUNC VERIFY(password$, stored$)
    DIM parts = SPLIT(stored$, "$")
    IF LEN(parts) <> 4 THEN RETURN FALSE
    DIM scheme$ = parts[0]
    DIM rounds$ = parts[1]
    DIM salt$ = parts[2]
    DIM key$ = parts[3]
    IF NOT IsDigits(rounds$) THEN RETURN FALSE
    DIM rounds = CLNG(VAL(rounds$))
    IF rounds < 1 ORELSE LEN(salt$) = 0 THEN RETURN FALSE
    IF scheme$ = "pbkdf2-sha256" THEN
        IF LEN(key$) <> 64 THEN RETURN FALSE
        RETURN SameText(CODEC.PBKDF2$(password$, salt$, rounds, 32), LCASE$(key$))
    ENDIF
    IF scheme$ = "pbkdf2_sha256" THEN
        DIM raw$ = CODEC.BASE64_DECODE$(key$)
        IF LEN(raw$) < 16 THEN RETURN FALSE
        RETURN SameText(CODEC.PBKDF2$(password$, salt$, rounds, LEN(raw$)), HexOf$(raw$))
    ENDIF
    RETURN FALSE
ENDFUNC

' Whether stored$ should be made again at the next sign-in: another format,
' fewer rounds than iterations, a short salt or a damaged hash.
EXPORT FUNC NEEDS_REHASH(stored$, iterations = 600000)
    DIM parts = SPLIT(stored$, "$")
    IF LEN(parts) <> 4 THEN RETURN TRUE
    DIM scheme$ = parts[0]
    DIM rounds$ = parts[1]
    DIM salt$ = parts[2]
    DIM key$ = parts[3]
    IF scheme$ <> "pbkdf2-sha256" ORELSE NOT IsDigits(rounds$) THEN RETURN TRUE
    IF VAL(rounds$) < iterations THEN RETURN TRUE
    RETURN LEN(salt$) < 32 ORELSE LEN(key$) <> 64
ENDFUNC

' ── comparison ─────────────────────────────────────────────────

' Whether two texts are equal, in a time that does not tell where they
' differ: both are keyed with a per-process secret before the compare.
EXPORT FUNC EQUAL(a$, b$)
    RETURN SameText(a$, b$)
ENDFUNC

FUNC SameText(a$, b$)
    RETURN CODEC.HMAC$(gCompareKey$, a$) = CODEC.HMAC$(gCompareKey$, b$)
ENDFUNC

' ── tokens and API keys ────────────────────────────────────────

' n_bytes random bytes (32) as text: "base64url" (no padding, safe in URLs
' and cookies), "base64" or "hex".
EXPORT FUNC TOKEN$(n_bytes = 32, format$ = "base64url")
    IF n_bytes < 1 THEN THROW "SECRET.TOKEN$: at least one byte"
    DIM raw$ = CODEC.RANDOMBYTES$(CLNG(n_bytes))
    DIM kind$ = LCASE$(format$)
    IF kind$ = "hex" THEN RETURN HexOf$(raw$)
    DIM b64$ = CODEC.BASE64_ENCODE$(raw$)
    IF kind$ = "base64" THEN RETURN b64$
    IF kind$ <> "base64url" THEN THROW "SECRET.TOKEN$: unknown format " + format$
    RETURN REPLACE$(REPLACE$(REPLACE$(b64$, "+", "-"), "/", "_"), "=", "")
ENDFUNC

' A new API key: prefix$ and an underscore, then 32 random bytes in
' base64url. Show it once and keep only KEYHASH$ of it.
EXPORT FUNC APIKEY$(prefix$ = "")
    DIM body$ = TOKEN$(32, "base64url")
    IF LEN(prefix$) = 0 THEN RETURN body$
    RETURN prefix$ + "_" + body$
ENDFUNC

' The SHA-256 of an API key in hex, the value a database keeps. A key is
' random enough that no slow hash is needed.
EXPORT FUNC KEYHASH$(key$)
    RETURN CODEC.SHA256$(key$)
ENDFUNC

' Whether key$ is the key a KEYHASH$ value was made from, in constant time.
EXPORT FUNC KEYMATCH(key$, stored_hash$)
    RETURN SameText(CODEC.SHA256$(key$), LCASE$(TRIM$(stored_hash$)))
ENDFUNC
