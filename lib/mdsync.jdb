' mdsync.jdb - a Markdown source and its rendered view in a FORM.RICHTEXT,
' kept in step both ways. An edit in the view rewrites only the blocks it
' reached and answers the span of the source that changed, so an editor
' showing the source can replace just that span; an edit of the source
' redraws only the blocks that changed. Every other byte stays as it was.
'
'   IMPORT MDSYNC
'   DIM doc = MDSYNC.OPEN(rt, md$)
'   SUB RTVIEW_CHANGE(e)
'       DIM d = MDSYNC.VIEWCHANGED(doc)
'       IF d{"changed"} THEN ...replace d{"old_len"} bytes at d{"start"} with d{"text"}
'   ENDSUB
'
' Needs a FORMS build (Windows). Built on MDRICH.
'
' version: 1.3.0
' requires: MDRICH ^1

EXPORT MODULE MDSYNC

IMPORT MDRICH

DIM CRLF_CH AS STRING = CHR$(13) + CHR$(10)
DIM TAB_SYNC AS STRING = CHR$(9)
DIM VT_SYNC AS STRING = CHR$(11)
DIM ROW_ON_SYNC AS STRING = CHR$(65529)
DIM ROW_OFF_SYNC AS STRING = CHR$(65531)

' The view's paragraphs: their texts and the byte offset each starts at.
' A table is one paragraph: its rows, each a row-start line and a line of
' cells ending in the row end, with the breaks between them; at the end of
' the document the empty line after it belongs to it too.
FUNC ViewParas(rt AS DOUBLE)
    DIM t$ = FORM.GET(rt, "TEXT")
    DIM lines = SPLIT(t$, CRLF_CH)
    DIM texts = []
    DIM i = 0
    DO WHILE i < LEN(lines)
        DIM one$ = lines[i]
        i = i + 1
        IF one$ = ROW_ON_SYNC THEN
            DO WHILE i < LEN(lines)
                one$ = one$ + CRLF_CH + lines[i]
                i = i + 1
                IF RIGHT$(lines[i - 1], LEN(ROW_OFF_SYNC)) <> ROW_OFF_SYNC THEN CONTINUEDO
                IF i < LEN(lines) ANDALSO lines[i] = ROW_ON_SYNC THEN
                    one$ = one$ + CRLF_CH + lines[i]
                    i = i + 1
                    CONTINUEDO
                ENDIF
                EXITDO
            LOOP
            IF i = LEN(lines) - 1 ANDALSO lines[i] = "" THEN
                one$ = one$ + CRLF_CH
                i = i + 1
            ELSEIF i + 1 < LEN(lines) ANDALSO lines[i] = "" ANDALSO lines[i + 1] = ROW_ON_SYNC THEN
                ' the empty paragraph that keeps two tables apart
                one$ = one$ + CRLF_CH
                i = i + 1
            ENDIF
        ENDIF
        texts = APPEND(texts, one$)
    LOOP
    IF LEN(texts) = 0 THEN texts = [""]
    DIM starts = []
    DIM at_pos AS INTEGER = 0
    DIM k = 0
    FOR k = 0 TO LEN(texts) - 1
        starts = APPEND(starts, at_pos)
        at_pos = at_pos + LEN(texts[k]) + 2
    NEXT k
    DIM vp AS MAP
    vp{"texts"} = texts
    vp{"starts"} = starts
    vp{"length"} = LEN(t$)
    RETURN vp
ENDFUNC

' TRUE when a table paragraph has a break inside a cell: every line but the
' last is a row start or ends a row.
FUNC StrayBreak(text$)
    DIM lines = SPLIT(text$, CRLF_CH)
    DIM k = 0
    FOR k = 0 TO LEN(lines) - 2
        IF lines[k] <> ROW_ON_SYNC ANDALSO RIGHT$(lines[k], LEN(ROW_OFF_SYNC)) <> ROW_OFF_SYNC THEN RETURN TRUE
    NEXT k
    RETURN FALSE
ENDFUNC

' The paragraph a view byte offset falls in.
FUNC ParaAt(vp, at_pos AS INTEGER) AS INTEGER
    DIM target AS INTEGER = at_pos
    DIM starts AS ARRAY = vp{"starts"}
    DIM k AS INTEGER = LEN(starts) - 1
    DIM here AS INTEGER = 0
    DO WHILE k > 0
        here = starts[k]
        IF here <= target THEN EXITDO
        k = k - 1
    LOOP
    RETURN k
ENDFUNC

FUNC ParaStart(vp, k AS INTEGER) AS INTEGER
    DIM starts AS ARRAY = vp{"starts"}
    DIM at AS INTEGER = starts[k]
    RETURN at
ENDFUNC

' The byte offset where paragraph k's text ends (before its break).
FUNC ParaEnd(vp, k AS INTEGER) AS INTEGER
    DIM texts AS ARRAY = vp{"texts"}
    DIM one$ = texts[k]
    RETURN ParaStart(vp, k) + LEN(one$)
ENDFUNC

' RUNS of paragraphs [a, b), one array per paragraph. Selection and scroll
' are left as they were.
FUNC RunsOf(rt AS DOUBLE, vp, a, b)
    DIM out = []
    IF b <= a THEN RETURN out
    DIM texts = vp{"texts"}
    DIM starts = vp{"starts"}
    DIM from = starts[a]
    DIM upto = starts[b - 1] + LEN(texts[b - 1])
    DIM whole = []
    IF upto > from THEN
        DIM keep_start AS INTEGER = FORM.GET(rt, "SELSTART")
        DIM keep_len AS INTEGER = FORM.GET(rt, "SELLENGTH")
        FORM.SET(rt, "SELSTART", from)
        FORM.SET(rt, "SELLENGTH", upto - from)
        whole = FORM.GET(rt, "RUNS")
        FORM.SET(rt, "SELSTART", keep_start)
        FORM.SET(rt, "SELLENGTH", keep_len)
    ENDIF
    ' each run goes to the paragraph it starts in; the break that ends a
    ' paragraph is no run of it, a break inside a table is
    DIM cur = []
    DIM cur_p = a
    DIM k = 0
    FOR k = 0 TO LEN(whole) - 1
        DIM run_at AS INTEGER = whole[k]{"start"}
        DIM pk = ParaAt(vp, run_at)
        IF pk < a ORELSE pk >= b THEN CONTINUEFOR
        IF whole[k]{"text"} = CRLF_CH ANDALSO run_at >= ParaEnd(vp, pk) THEN CONTINUEFOR
        DO WHILE cur_p < pk
            out = APPEND(out, [cur])
            cur = []
            cur_p = cur_p + 1
        LOOP
        cur = APPEND(cur, whole[k])
    NEXT k
    DO WHILE cur_p < b
        out = APPEND(out, [cur])
        cur = []
        cur_p = cur_p + 1
    LOOP
    RETURN out
ENDFUNC

FUNC RtfOf$(doc, blocks)
    DIM parts = []
    DIM kinds = []
    DIM k = 0
    FOR k = 0 TO LEN(blocks) - 1
        parts = APPEND(parts, MDRICH.RTF$(blocks[k], doc{"opts"}))
        kinds = APPEND(kinds, blocks[k]{"kind"})
    NEXT k
    RETURN MDRICH.HEAD$(doc{"opts"}) + MDRICH.JOINRTF$(parts, kinds) + "}"
ENDFUNC

' Replaces view paragraphs [a, b) with the drawing of blocks. The caller
' keeps the selection.
SUB ReplaceParas(doc, a, b, blocks)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM vp = ViewParas(rt)
    DIM n = LEN(vp{"texts"})
    ' RichEdit widens a selection that reaches a table past the table's end,
    ' so a range with a table in it, before or after, is drawn by drawing
    ' the whole document again
    DIM k = 0
    DIM with_table = FALSE
    FOR k = 0 TO LEN(blocks) - 1
        IF blocks[k]{"kind"} = "table" THEN with_table = TRUE
    NEXT k
    FOR k = a TO MIN([b, n]) - 1
        IF LEFT$(vp{"texts"}[k], LEN(ROW_ON_SYNC)) = ROW_ON_SYNC THEN with_table = TRUE
    NEXT k
    IF with_table THEN
        FORM.SET(rt, "TEXTRTF", MDRICH.DOC$(doc{"blocks"}, doc{"opts"}))
        RETURN
    ENDIF
    DIM starts = vp{"starts"}
    DIM from = 0
    IF a < n THEN from = starts[a] ELSE from = vp{"length"}
    DIM upto = vp{"length"}
    IF b < n THEN upto = starts[b]
    IF LEN(blocks) = 0 ANDALSO b >= n ANDALSO a > 0 THEN
        ' dropping the last paragraphs takes the break in front of them
        from = starts[a] - 2
    ENDIF
    IF a >= n ANDALSO n > 0 ANDALSO LEN(blocks) > 0 THEN
        ' appending: a new break after the current last paragraph
        FORM.SET(rt, "SELSTART", vp{"length"})
        FORM.SET(rt, "SELLENGTH", 0)
        FORM.SET(rt, "SELTEXT", CRLF_CH)
        from = vp{"length"} + 2
        upto = from
    ENDIF
    FORM.SET(rt, "SELSTART", from)
    FORM.SET(rt, "SELLENGTH", upto - from)
    IF LEN(blocks) = 0 THEN
        FORM.SET(rt, "SELTEXT", "")
    ELSE
        FORM.SET(rt, "SELRTF", RtfOf$(doc, blocks))
        ' at the end of the document the closing \par of the drawing is a
        ' paragraph too many; dropping it keeps the last one's format
        IF b >= n THEN
            DIM after = ViewParas(rt)
            IF LEN(after{"texts"}) > a + LEN(blocks) THEN
                FORM.SET(rt, "SELSTART", after{"length"} - 2)
                FORM.SET(rt, "SELLENGTH", 2)
                FORM.SET(rt, "SELTEXT", "")
            ENDIF
        ENDIF
    ENDIF
ENDSUB

FUNC Offsets(blocks)
    DIM offset = 0
    DIM k = 0
    FOR k = 0 TO LEN(blocks) - 1
        DIM b = blocks[k]
        b{"src"} = b{"lead"} + b{"body"} + b{"tail"}
        b{"start"} = offset
        offset = offset + LEN(b{"src"})
        b{"end"} = offset
    NEXT k
    RETURN blocks
ENDFUNC

FUNC JoinSrc$(blocks, a, b)
    DIM out$ = ""
    DIM k = 0
    FOR k = a TO b - 1
        out$ = out$ + blocks[k]{"src"}
    NEXT k
    RETURN out$
ENDFUNC

' Binds a RICHTEXT to a Markdown source and draws it. opts{"base"} is the
' folder image paths are relative to.
EXPORT FUNC OPEN(rt AS DOUBLE, md$, opts = 0)
    DIM doc AS MAP
    doc{"rt"} = rt
    DIM o AS MAP
    IF TYPEOF(opts) = "OBJECT" THEN o = opts
    doc{"opts"} = o
    doc{"blocks"} = MDRICH.BLOCKS(md$)
    doc{"src"} = md$
    FORM.SET(rt, "PLAINTEXT", FALSE)
    FORM.SET(rt, "TEXTRTF", MDRICH.DOC$(doc{"blocks"}, o))
    FORM.SET(rt, "SELSTART", 0)
    FORM.SET(rt, "MODIFIED", FALSE)
    doc{"vtexts"} = ViewParas(rt){"texts"}
    RETURN doc
ENDFUNC

' Changes drawing options (base, dark) and draws the view again, the
' selection kept. Answers TRUE when an option changed.
EXPORT FUNC SETOPTS(doc, opts)
    DIM o = doc{"opts"}
    DIM changed = FALSE
    DIM keys = MAP.KEYS(opts)
    DIM k = 0
    FOR k = 0 TO LEN(keys) - 1
        DIM same = FALSE
        IF MAP.EXISTS(o, keys[k]) THEN same = o{keys[k]} = opts{keys[k]}
        IF NOT same THEN
            o{keys[k]} = opts{keys[k]}
            changed = TRUE
        ENDIF
    NEXT k
    IF NOT changed THEN RETURN FALSE
    doc{"opts"} = o
    DIM rt AS DOUBLE = doc{"rt"}
    DIM sel_start AS INTEGER = FORM.GET(rt, "SELSTART")
    DIM sel_len AS INTEGER = FORM.GET(rt, "SELLENGTH")
    DIM was_modified = FORM.GET(rt, "MODIFIED")
    FORM.SET(rt, "TEXTRTF", MDRICH.DOC$(doc{"blocks"}, o))
    FORM.SET(rt, "SELSTART", sel_start)
    FORM.SET(rt, "SELLENGTH", sel_len)
    FORM.SET(rt, "MODIFIED", was_modified)
    doc{"vtexts"} = ViewParas(rt){"texts"}
    RETURN TRUE
ENDFUNC

EXPORT FUNC SOURCE$(doc)
    RETURN doc{"src"}
ENDFUNC

EXPORT FUNC BLOCKS(doc)
    RETURN doc{"blocks"}
ENDFUNC

' The RUNS of every view paragraph, one array per paragraph, a table as
' one; what MDRICH.SAME and MDRICH.MD$ read for a block.
EXPORT FUNC VIEWRUNS(doc)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM vp = ViewParas(rt)
    RETURN RunsOf(rt, vp, 0, LEN(vp{"texts"}))
ENDFUNC

' The block whose paragraph holds a view byte offset.
EXPORT FUNC BLOCKAT(doc, at_pos AS INTEGER)
    DIM rt AS DOUBLE = doc{"rt"}
    RETURN ParaAt(ViewParas(rt), at_pos)
ENDFUNC

' The view byte offset where block k's paragraph starts.
EXPORT FUNC VIEWPOS(doc, k AS INTEGER)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM vp = ViewParas(rt)
    IF k >= LEN(vp{"starts"}) THEN RETURN ParaStart(vp, LEN(vp{"starts"}) - 1)
    RETURN ParaStart(vp, k)
ENDFUNC

' The source byte offset where block k's own lines start.
EXPORT FUNC SOURCEPOS(doc, k)
    DIM blocks = doc{"blocks"}
    IF k >= LEN(blocks) THEN RETURN LEN(doc{"src"})
    RETURN blocks[k]{"start"} + LEN(blocks[k]{"lead"})
ENDFUNC

' The block a source byte offset falls in.
EXPORT FUNC BLOCKOFSOURCE(doc, at_pos AS INTEGER)
    DIM target AS INTEGER = at_pos
    DIM blocks = doc{"blocks"}
    DIM k = 0
    FOR k = 0 TO LEN(blocks) - 1
        IF target < blocks[k]{"end"} THEN RETURN k
    NEXT k
    RETURN MAX([0, LEN(blocks) - 1])
ENDFUNC

' The kind a paragraph made by Enter after a block of this kind gets.
FUNC NextKind$(kind$)
    IF kind$ = "item" ORELSE kind$ = "quote" THEN RETURN kind$
    RETURN "para"
ENDFUNC

' Whether a blank line has to stand between two blocks so the source reads
' back as two: anything followed by a paragraph, a paragraph followed by a
' rule (it would turn the paragraph into a heading).
FUNC NeedsGap(prev, nxt)
    IF nxt{"kind"} = "para" ANDALSO nxt{"body"} <> "" THEN RETURN TRUE
    IF prev{"kind"} = "para" ANDALSO nxt{"kind"} = "rule" THEN RETURN TRUE
    IF prev{"kind"} = "item" ANDALSO nxt{"kind"} <> "item" THEN RETURN TRUE
    RETURN FALSE
ENDFUNC

FUNC Gap(prev, nxt)
    IF prev{"tail"} = "" ANDALSO NeedsGap(prev, nxt) THEN prev{"tail"} = prev{"eol"}
    RETURN prev
ENDFUNC

' A block for a paragraph that shows runs, modelled on model, drawn as the
' paragraph currently looks (drawn$).
FUNC Rebuild(model, runs, drawn$)
    DIM body$ = MDRICH.BODY$(model, runs, drawn$)
    DIM nb = 0
    IF body$ = "" ANDALSO model{"kind"} = "para" THEN
        nb = MDRICH.NEWBLOCK("para", model)
        nb{"body"} = ""
    ELSEIF body$ = model{"body"} THEN
        nb = model
    ELSE
        DIM parsed = MDRICH.BLOCKS(body$)
        IF LEN(parsed) = 0 THEN
            nb = MDRICH.NEWBLOCK("para", model)
            nb{"body"} = ""
            RETURN nb
        ENDIF
        nb = parsed[0]
        IF nb{"kind"} = model{"kind"} THEN
            IF MAP.EXISTS(model, "level") THEN nb{"level"} = model{"level"}
            IF MAP.EXISTS(model, "list_start") THEN nb{"list_start"} = model{"list_start"}
        ENDIF
        nb{"lead"} = ""
        nb{"tail"} = ""
        nb{"body"} = body$
    ENDIF
    RETURN nb
ENDFUNC

' TRUE when byte i of t$ continues a UTF-8 character.
FUNC IsCont(t$, i)
    IF i < 0 ORELSE i >= LEN(t$) THEN RETURN FALSE
    DIM c = BYTEAT(t$, i)
    RETURN c >= 128 ANDALSO c < 192
ENDFUNC

' The source span between old and new text, trimmed to what differs. Both
' ends fall on character boundaries, so a changed character is replaced
' whole even where its first bytes agree (ä and ü share C3).
FUNC Span(old$, new$, base)
    DIM p = 0
    DIM lim = MIN([LEN(old$), LEN(new$)])
    DO WHILE p < lim ANDALSO MID$(old$, p, 1) = MID$(new$, p, 1)
        p = p + 1
    LOOP
    DO WHILE p > 0 ANDALSO (IsCont(old$, p) ORELSE IsCont(new$, p))
        p = p - 1
    LOOP
    DIM s = 0
    DO WHILE s < lim - p ANDALSO MID$(old$, LEN(old$) - 1 - s, 1) = MID$(new$, LEN(new$) - 1 - s, 1)
        s = s + 1
    LOOP
    DO WHILE s > 0 ANDALSO (IsCont(old$, LEN(old$) - s) ORELSE IsCont(new$, LEN(new$) - s))
        s = s - 1
    LOOP
    DIM d AS MAP
    d{"changed"} = old$ <> new$
    d{"start"} = base + p
    d{"old_len"} = LEN(old$) - p - s
    d{"text"} = MID$(new$, p, LEN(new$) - p - s)
    RETURN d
ENDFUNC

FUNC NoChange()
    DIM d AS MAP
    d{"changed"} = FALSE
    d{"start"} = 0
    d{"old_len"} = 0
    d{"text"} = ""
    RETURN d
ENDFUNC

' Enter inside a code or raw block splits its paragraph in the view; the
' break is turned back into a line break of the block. Enter on the empty
' last line of the block leaves it: that line goes and the new paragraph,
' with whatever was typed into it since, stays. Answers the view's
' paragraphs as they are afterwards.
FUNC KeepInBlock(doc, vp)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM newt = vp{"texts"}
    DIM oldt = doc{"vtexts"}
    DIM blocks = doc{"blocks"}
    IF LEN(blocks) = 0 ORELSE LEN(oldt) <> LEN(blocks) ORELSE LEN(newt) <> LEN(oldt) + 1 THEN RETURN vp
    IF FORM.GET(rt, "SELLENGTH") <> 0 THEN RETURN vp
    DIM caret AS INTEGER = FORM.GET(rt, "SELSTART")
    ' after Enter the caret is in the paragraph split off, at its start
    ' unless more was typed before this sync
    DIM p = ParaAt(vp, caret) - 1
    IF p < 0 ORELSE p >= LEN(blocks) THEN RETURN vp
    DIM kind$ = blocks[p]{"kind"}
    IF kind$ <> "code" ANDALSO kind$ <> "raw" THEN RETURN vp
    DIM k = 0
    FOR k = 0 TO p - 1
        IF newt[k] <> oldt[k] THEN RETURN vp
    NEXT k
    FOR k = p + 2 TO LEN(newt) - 1
        IF newt[k] <> oldt[k - 1] THEN RETURN vp
    NEXT k
    DIM brk AS INTEGER = vp{"starts"}[p + 1] - 2
    ' split on the block's last line, and that line was empty
    IF RIGHT$(newt[p], 1) = VT_SYNC ANDALSO INSTR(newt[p + 1], VT_SYNC) < 0 THEN
        FORM.SET(rt, "SELSTART", brk - 1)
        FORM.SET(rt, "SELLENGTH", 1)
        FORM.SET(rt, "SELTEXT", "")
        caret = caret - 1
    ELSE
        FORM.SET(rt, "SELSTART", brk)
        FORM.SET(rt, "SELLENGTH", 2)
        ' SELTEXT would make a VT a paragraph break again
        FORM.SET(rt, "SELRTF", "{\rtf1\ansi\line}")
        IF caret >= brk + 2 THEN caret = caret - 1
    ENDIF
    FORM.SET(rt, "SELSTART", caret)
    FORM.SET(rt, "SELLENGTH", 0)
    RETURN ViewParas(rt)
ENDFUNC

' Reconciles the source with the view after an edit there. Answers a map:
' changed, and the source span start / old_len / text that replaces it.
EXPORT FUNC VIEWCHANGED(doc)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM vp = KeepInBlock(doc, ViewParas(rt))
    DIM newt = vp{"texts"}
    DIM oldt = doc{"vtexts"}
    DIM blocks = doc{"blocks"}
    ' an empty document still shows one empty paragraph, which is no block
    IF LEN(blocks) = 0 THEN oldt = []
    DIM n_old = LEN(oldt)
    DIM n_new = LEN(newt)
    DIM p = 0
    DO WHILE p < n_old ANDALSO p < n_new ANDALSO oldt[p] = newt[p]
        p = p + 1
    LOOP
    DIM s = 0
    DO WHILE s < n_old - p ANDALSO s < n_new - p ANDALSO oldt[n_old - 1 - s] = newt[n_new - 1 - s]
        s = s + 1
    LOOP
    ' the paragraphs under the selection count as touched: a format change
    ' leaves the text alone
    DIM sel_start AS INTEGER = FORM.GET(rt, "SELSTART")
    DIM sel_len AS INTEGER = FORM.GET(rt, "SELLENGTH")
    DIM sel_a = ParaAt(vp, sel_start)
    DIM sel_end AS INTEGER = sel_start + sel_len
    DIM sel_b = ParaAt(vp, sel_end)
    DIM na = p
    DIM nb = n_new - s
    IF nb <= na ANDALSO n_new = n_old THEN
        na = sel_a
        nb = sel_b + 1
    ELSE
        IF sel_a < na THEN na = sel_a
        IF sel_b + 1 > nb THEN nb = sel_b + 1
    ENDIF
    DIM oa = na
    DIM ob = nb - n_new + n_old
    IF nb > n_new THEN nb = n_new
    IF oa > LEN(blocks) THEN oa = LEN(blocks)
    IF ob > LEN(blocks) THEN ob = LEN(blocks)
    IF ob < oa THEN ob = oa

    DIM runs = RunsOf(rt, vp, na, nb)
    DIM q = ob - oa
    DIM m = nb - na
    IF m = 0 ANDALSO q = 0 THEN RETURN NoChange()

    ' Which new paragraph is which old block: in order, except that new
    ' empty paragraphs in front of an unchanged run of old ones are new
    ' blocks (Enter at the start of a paragraph).
    DIM lead_new = 0
    DIM k = 0
    IF m > q ANDALSO q > 0 THEN
        DIM aligned = TRUE
        FOR k = 0 TO q - 1
            IF newt[na + m - q + k] <> oldt[oa + k] THEN aligned = FALSE
        NEXT k
        FOR k = 0 TO m - q - 1
            IF newt[na + k] <> "" THEN aligned = FALSE
        NEXT k
        IF aligned THEN lead_new = m - q
    ENDIF

    DIM end_tail$ = ""
    IF q > 0 THEN end_tail$ = blocks[ob - 1]{"tail"}
    DIM first_lead$ = ""
    IF LEN(blocks) > 0 THEN first_lead$ = blocks[0]{"lead"}
    DIM fresh = []
    DIM redraw = []
    DIM identity = []
    DIM j = 0
    FOR j = 0 TO m - 1
        DIM model = 0
        DIM drawn$ = "para"
        DIM idx = j - lead_new
        DIM is_old = idx >= 0 ANDALSO idx < q
        IF is_old THEN
            model = blocks[oa + idx]
            drawn$ = model{"kind"}
        ELSE
            DIM prev = 0
            IF j < lead_new THEN
                prev = blocks[oa]
            ELSEIF LEN(fresh) > 0 THEN
                prev = fresh[LEN(fresh) - 1]
            ELSEIF oa > 0 THEN
                prev = blocks[oa - 1]
            ENDIF
            IF TYPEOF(prev) = "OBJECT" THEN
                model = MDRICH.NEWBLOCK(NextKind$(prev{"kind"}), prev)
                drawn$ = prev{"kind"}
            ELSE
                model = MDRICH.NEWBLOCK("para")
            ENDIF
        ENDIF
        DIM keep_lead$ = model{"lead"}
        DIM keep_tail$ = model{"tail"}
        DIM nbk = Rebuild(model, runs[j], drawn$)
        nbk{"lead"} = ""
        nbk{"tail"} = ""
        IF is_old THEN
            nbk{"lead"} = keep_lead$
            IF idx < q - 1 THEN nbk{"tail"} = keep_tail$
        ENDIF
        fresh = APPEND(fresh, nbk)
        identity = APPEND(identity, is_old)
        DIM again = NOT is_old ORELSE drawn$ <> nbk{"kind"} ORELSE NOT MDRICH.SAME(nbk, runs[j])
        IF nbk{"kind"} = "item" ANDALSO nbk{"ordered"} THEN
            IF LEFT$(newt[na + j], LEN(nbk{"marker"}) + 1) <> nbk{"marker"} + TAB_SYNC THEN again = TRUE
        ENDIF
        ' a Markdown table cell holds one line: a break typed in one is undone
        IF nbk{"kind"} = "table" ANDALSO StrayBreak(newt[na + j]) THEN again = TRUE
        redraw = APPEND(redraw, again)
    NEXT j

    DIM before = []
    IF oa > 0 THEN before = TAKE(oa, blocks)
    DIM after = []
    IF ob < LEN(blocks) THEN after = DROP(ob, blocks)
    DIM old_from = 0
    IF oa > 0 THEN old_from = blocks[oa - 1]{"start"}
    DIM old_to = LEN(doc{"src"})
    IF ob < LEN(blocks) THEN old_to = blocks[ob]{"end"}
    DIM old_span$ = MID$(doc{"src"}, old_from, old_to - old_from)

    ' The blank lines after the range stay at its end: those of the last
    ' old block, or, for paragraphs only inserted, those of the block in
    ' front, which moves them on.
    IF LEN(fresh) > 0 THEN
        IF q > 0 THEN
            fresh[LEN(fresh) - 1]{"tail"} = end_tail$
        ELSEIF LEN(before) > 0 THEN
            fresh[LEN(fresh) - 1]{"tail"} = before[LEN(before) - 1]{"tail"}
            before[LEN(before) - 1]{"tail"} = ""
        ENDIF
        IF oa = 0 ANDALSO q > 0 THEN fresh[0]{"lead"} = first_lead$
    ENDIF
    DIM g = 0
    FOR g = 0 TO LEN(fresh) - 2
        fresh[g] = Gap(fresh[g], fresh[g + 1])
    NEXT g
    IF LEN(before) > 0 ANDALSO LEN(fresh) > 0 THEN before[LEN(before) - 1] = Gap(before[LEN(before) - 1], fresh[0])
    IF LEN(fresh) > 0 ANDALSO LEN(after) > 0 THEN fresh[LEN(fresh) - 1] = Gap(fresh[LEN(fresh) - 1], after[0])
    IF LEN(fresh) = 0 ANDALSO LEN(before) > 0 ANDALSO LEN(after) > 0 THEN before[LEN(before) - 1] = Gap(before[LEN(before) - 1], after[0])

    DIM whole = []
    FOR k = 0 TO LEN(before) - 1
        whole = APPEND(whole, before[k])
    NEXT k
    FOR k = 0 TO LEN(fresh) - 1
        whole = APPEND(whole, fresh[k])
    NEXT k
    FOR k = 0 TO LEN(after) - 1
        whole = APPEND(whole, after[k])
    NEXT k
    ' the old blocks share their maps with whole: their ends are read now
    DIM old_ends = []
    FOR k = 0 TO LEN(blocks) - 1
        old_ends = APPEND(old_ends, blocks[k]{"end"})
    NEXT k
    DIM rn = Renumber(whole, oa, oa + LEN(fresh))
    whole = Offsets(rn{"blocks"})
    DIM renumbered = rn{"changed"}
    DIM grown = LEN(fresh) - q
    DIM last_ren = -1
    IF LEN(renumbered) > 0 THEN last_ren = renumbered[LEN(renumbered) - 1]
    DIM new_from = 0
    IF oa > 0 THEN new_from = whole[oa - 1]{"start"}
    DIM new_to = LEN(JoinSrc$(whole, 0, LEN(whole)))
    IF ob < LEN(blocks) THEN new_to = whole[oa + LEN(fresh)]{"end"}
    ' items renumbered past the edit belong to the span too
    IF last_ren >= oa + LEN(fresh) THEN
        IF whole[last_ren]{"end"} > new_to THEN new_to = whole[last_ren]{"end"}
        IF old_ends[last_ren - grown] > old_to THEN
            old_to = old_ends[last_ren - grown]
            old_span$ = MID$(doc{"src"}, old_from, old_to - old_from)
        ENDIF
    ENDIF
    FOR k = 0 TO LEN(renumbered) - 1
        IF renumbered[k] >= oa ANDALSO renumbered[k] < oa + m THEN redraw[renumbered[k] - oa] = TRUE
    NEXT k
    DIM new_src$ = JoinSrc$(whole, 0, LEN(whole))
    DIM d = Span(old_span$, MID$(new_src$, new_from, new_to - new_from), old_from)
    doc{"blocks"} = whole
    doc{"src"} = new_src$

    ' redraw the paragraphs whose look no longer fits their block, keeping
    ' the caret the same distance from its paragraph's end
    DIM caret AS INTEGER = FORM.GET(rt, "SELSTART")
    DIM caret_para = ParaAt(vp, caret)
    DIM from_end AS INTEGER = ParaEnd(vp, caret_para) - caret
    DIM touched = FALSE
    j = 0
    DO WHILE j < m
        IF NOT redraw[j] THEN
            j = j + 1
            CONTINUEDO
        ENDIF
        DIM run_end = j
        DO WHILE run_end < m ANDALSO redraw[run_end]
            run_end = run_end + 1
        LOOP
        ReplaceParas(doc, na + j, na + run_end, TAKE(run_end - j, DROP(oa + j, whole)))
        touched = TRUE
        j = run_end
    LOOP
    ' the numbers are drawn as text: an item renumbered past the edit is
    ' drawn again too
    FOR k = 0 TO LEN(renumbered) - 1
        DIM ri = renumbered[k]
        IF ri >= oa + m THEN
            ReplaceParas(doc, na + ri - oa, na + ri - oa + 1, [whole[ri]])
            touched = TRUE
        ENDIF
    NEXT k
    IF touched THEN
        DIM vp2 = ViewParas(rt)
        DIM cp = MIN([caret_para, LEN(vp2{"texts"}) - 1])
        DIM at_pos AS INTEGER = ParaEnd(vp2, cp) - from_end
        IF at_pos < ParaStart(vp2, cp) THEN at_pos = ParaStart(vp2, cp)
        FORM.SET(rt, "SELSTART", at_pos)
        FORM.SET(rt, "SELLENGTH", 0)
    ENDIF
    doc{"vtexts"} = ViewParas(rt){"texts"}
    RETURN d
ENDFUNC

' Takes a new source (an edit in the source editor) and redraws the blocks
' that changed. Answers TRUE when the view changed.
EXPORT FUNC SOURCECHANGED(doc, md$)
    IF md$ = doc{"src"} THEN RETURN FALSE
    DIM rt AS DOUBLE = doc{"rt"}
    DIM old = doc{"blocks"}
    DIM fresh = MDRICH.BLOCKS(md$)
    DIM n_old = LEN(old)
    DIM n_new = LEN(fresh)
    DIM p = 0
    DO WHILE p < n_old ANDALSO p < n_new ANDALSO SameBlock(old[p], fresh[p])
        p = p + 1
    LOOP
    DIM s = 0
    DO WHILE s < n_old - p ANDALSO s < n_new - p ANDALSO SameBlock(old[n_old - 1 - s], fresh[n_new - 1 - s])
        s = s + 1
    LOOP
    doc{"blocks"} = fresh
    doc{"src"} = md$
    IF n_old - s - p = 0 ANDALSO n_new - s - p = 0 THEN RETURN FALSE
    DIM keep AS INTEGER = FORM.GET(rt, "SELSTART")
    ReplaceParas(doc, p, n_old - s, TAKE(n_new - s - p, DROP(p, fresh)))
    FORM.SET(rt, "SELSTART", MIN([keep, LEN(FORM.GET(rt, "TEXT"))]))
    doc{"vtexts"} = ViewParas(rt){"texts"}
    RETURN TRUE
ENDFUNC

' Two blocks draw the same paragraph.
FUNC SameBlock(a, b)
    IF a{"body"} <> b{"body"} ORELSE a{"kind"} <> b{"kind"} THEN RETURN FALSE
    IF a{"kind"} = "item" THEN RETURN a{"level"} = b{"level"}
    RETURN TRUE
ENDFUNC

' Block b as ordered item number n, its marker's delimiter kept.
FUNC WithNumber(b, n)
    DIM old_m$ = b{"marker"}
    DIM new_m$ = STR$(n) + RIGHT$(old_m$, 1)
    DIM ind$ = b{"indent"}
    b{"body"} = ind$ + new_m$ + MID$(b{"body"}, LEN(ind$) + LEN(old_m$), LEN(b{"body"}))
    b{"marker"} = new_m$
    b{"number"} = n
    RETURN b
ENDFUNC

' Ordered items count on from the item in front of them after an edit of
' blocks [a, b): each ordered item of the run at that level gets the number
' after the one before it. Past b the first item that already has its
' number ends the walk, so a list nobody touched keeps its bytes. Nested
' items are passed over. Answers {blocks, changed: indices renumbered}.
FUNC Renumber(blocks, a, b)
    DIM changed = []
    DIM expect = -1
    DIM lvl = -1
    DIM delim$ = ""
    DIM k = 0
    IF a > 0 ANDALSO a <= LEN(blocks) THEN
        DIM pb = blocks[a - 1]
        IF pb{"kind"} = "item" ANDALSO pb{"ordered"} THEN
            expect = pb{"number"} + 1
            lvl = pb{"level"}
            delim$ = RIGHT$(pb{"marker"}, 1)
        ENDIF
    ENDIF
    FOR k = MAX([0, a]) TO LEN(blocks) - 1
        DIM bk = blocks[k]
        IF bk{"kind"} <> "item" THEN EXITFOR
        IF lvl >= 0 ANDALSO bk{"level"} > lvl THEN CONTINUEFOR
        IF lvl >= 0 ANDALSO bk{"level"} < lvl THEN EXITFOR
        IF NOT bk{"ordered"} THEN
            IF lvl >= 0 ORELSE k >= b THEN EXITFOR
            CONTINUEFOR
        ENDIF
        IF lvl < 0 ORELSE RIGHT$(bk{"marker"}, 1) <> delim$ THEN
            ' the first ordered item of a run keeps its number
            IF lvl >= 0 ANDALSO k >= b THEN EXITFOR
            lvl = bk{"level"}
            delim$ = RIGHT$(bk{"marker"}, 1)
            expect = bk{"number"} + 1
            CONTINUEFOR
        ENDIF
        IF bk{"number"} = expect THEN
            IF k >= b THEN EXITFOR
        ELSE
            blocks[k] = WithNumber(bk, expect)
            changed = APPEND(changed, k)
        ENDIF
        expect = expect + 1
    NEXT k
    DIM r AS MAP
    r{"blocks"} = blocks
    r{"changed"} = changed
    RETURN r
ENDFUNC

' Inserts Markdown after block k (k = -1: at the top) as blocks of their
' own, with the blank lines that keep them apart, and puts the view caret
' at the first of them. Answers the source span as VIEWCHANGED does.
EXPORT FUNC INSERT(doc, k, md$)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM blocks = doc{"blocks"}
    DIM src$ = doc{"src"}
    DIM eol$ = CHR$(10)
    IF LEN(blocks) > 0 THEN eol$ = blocks[0]{"eol"}
    DIM piece$ = REPLACE$(REPLACE$(md$, CHR$(13) + CHR$(10), CHR$(10)), CHR$(10), eol$)
    IF RIGHT$(piece$, LEN(eol$)) <> eol$ THEN piece$ = piece$ + eol$
    DIM at_pos AS INTEGER = 0
    IF k >= 0 ANDALSO LEN(blocks) > 0 THEN at_pos = blocks[MIN([k, LEN(blocks) - 1])]{"end"}
    DIM head$ = LEFT$(src$, at_pos)
    DIM rest$ = MID$(src$, at_pos, LEN(src$))
    DIM lead$ = ""
    IF head$ <> "" THEN
        IF RIGHT$(head$, LEN(eol$)) <> eol$ THEN lead$ = eol$
        IF RIGHT$(head$, 2 * LEN(eol$)) <> eol$ + eol$ THEN lead$ = lead$ + eol$
    ENDIF
    IF rest$ <> "" ANDALSO LEFT$(rest$, LEN(eol$)) <> eol$ THEN piece$ = piece$ + eol$
    DIM d AS MAP
    d{"changed"} = TRUE
    d{"start"} = at_pos
    d{"old_len"} = 0
    d{"text"} = lead$ + piece$
    DIM redrawn = SOURCECHANGED(doc, head$ + lead$ + piece$ + rest$)
    DIM first AS INTEGER = CINT(BLOCKOFSOURCE(doc, at_pos + LEN(lead$)))
    FORM.SET(rt, "SELSTART", CINT(VIEWPOS(doc, first)))
    FORM.SET(rt, "SELLENGTH", 0)
    RETURN d
ENDFUNC

' Turns block k into another kind (para, heading with a level, item,
' ordered item, quote, code), keeping its text. Answers the source span as
' VIEWCHANGED does.
EXPORT FUNC SETKIND(doc, k, kind$, level = 1)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM blocks = doc{"blocks"}
    IF k < 0 ORELSE k >= LEN(blocks) THEN RETURN NoChange()
    DIM old = blocks[k]
    DIM old_ends = []
    DIM bi = 0
    FOR bi = 0 TO LEN(blocks) - 1
        old_ends = APPEND(old_ends, blocks[bi]{"end"})
    NEXT bi
    DIM vp = ViewParas(rt)
    DIM runs = RunsOf(rt, vp, k, k + 1)
    DIM want$ = kind$
    IF kind$ = "ordered" THEN want$ = "item"
    DIM model = MDRICH.NEWBLOCK(want$, old)
    IF want$ = "heading" THEN model{"level"} = level
    IF kind$ = "ordered" THEN
        model{"ordered"} = TRUE
        model{"number"} = 1
        model{"list_start"} = 1
        IF k > 0 ANDALSO blocks[k - 1]{"kind"} = "item" ANDALSO blocks[k - 1]{"ordered"} THEN
            model{"number"} = blocks[k - 1]{"number"} + 1
            model{"list_start"} = blocks[k - 1]{"list_start"}
        ENDIF
        model{"marker"} = STR$(model{"number"}) + "."
        model{"cont"} = SPACE$(LEN(model{"marker"}) + 1)
    ELSEIF kind$ = "item" THEN
        model{"marker"} = "-"
        model{"ordered"} = FALSE
        model{"cont"} = "  "
    ENDIF
    DIM nb = Rebuild(model, runs[0], old{"kind"})
    nb{"lead"} = old{"lead"}
    nb{"tail"} = old{"tail"}
    DIM old_from = old{"start"}
    DIM old_span$ = old{"src"}
    blocks[k] = nb
    IF k > 0 THEN blocks[k - 1] = Gap(blocks[k - 1], nb)
    IF k + 1 < LEN(blocks) THEN blocks[k] = Gap(nb, blocks[k + 1])
    IF k > 0 THEN
        old_from = blocks[k - 1]{"start"}
        old_span$ = MID$(doc{"src"}, old_from, old{"end"} - old_from)
    ENDIF
    DIM rn = Renumber(Offsets(blocks), k, k + 1)
    blocks = Offsets(rn{"blocks"})
    DIM renumbered = rn{"changed"}
    doc{"blocks"} = blocks
    DIM new_src$ = JoinSrc$(blocks, 0, LEN(blocks))
    DIM span_to = k
    IF LEN(renumbered) > 0 THEN span_to = MAX([k, renumbered[LEN(renumbered) - 1]])
    IF span_to > k THEN old_span$ = MID$(doc{"src"}, old_from, old_ends[span_to] - old_from)
    DIM d = Span(old_span$, MID$(new_src$, old_from, blocks[span_to]{"end"} - old_from), old_from)
    doc{"src"} = new_src$
    DIM caret AS INTEGER = FORM.GET(rt, "SELSTART")
    DIM from_end AS INTEGER = ParaEnd(vp, k) - caret
    ReplaceParas(doc, k, k + 1, [blocks[k]])
    FOR bi = 0 TO LEN(renumbered) - 1
        IF renumbered[bi] <> k THEN ReplaceParas(doc, renumbered[bi], renumbered[bi] + 1, [blocks[renumbered[bi]]])
    NEXT bi
    DIM vp2 = ViewParas(rt)
    FORM.SET(rt, "SELSTART", MAX([ParaStart(vp2, k), ParaEnd(vp2, k) - from_end]))
    doc{"vtexts"} = vp2{"texts"}
    RETURN d
ENDFUNC

' Where the view caret is in a table: {block, row, col} with row 0 the
' header, or block -1 outside a table.
EXPORT FUNC TABLEPOS(doc)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM vp = ViewParas(rt)
    DIM caret AS INTEGER = FORM.GET(rt, "SELSTART")
    DIM k = ParaAt(vp, caret)
    DIM r AS MAP
    r{"block"} = -1
    r{"row"} = 0
    r{"col"} = 0
    DIM blocks = doc{"blocks"}
    IF k >= LEN(blocks) THEN RETURN r
    IF blocks[k]{"kind"} <> "table" THEN RETURN r
    DIM before$ = LEFT$(vp{"texts"}[k], caret - ParaStart(vp, k))
    r{"block"} = k
    r{"row"} = MAX([0, LEN(SPLIT(before$, ROW_ON_SYNC)) - 2])
    DIM in_row$ = before$
    DIM row_at = INSTR(before$, ROW_ON_SYNC)
    DO WHILE row_at >= 0
        in_row$ = MID$(before$, row_at + LEN(ROW_ON_SYNC), LEN(before$))
        row_at = INSTR(row_at + 1, before$, ROW_ON_SYNC)
    LOOP
    r{"col"} = LEN(SPLIT(in_row$, CHR$(7))) - 1
    RETURN r
ENDFUNC

' The same for a source byte offset: the line of the table it is on (the
' delimiter row counts as the header) and the cells left of it.
EXPORT FUNC SOURCETABLEPOS(doc, at_pos AS INTEGER)
    DIM r AS MAP
    r{"block"} = -1
    r{"row"} = 0
    r{"col"} = 0
    DIM blocks = doc{"blocks"}
    IF LEN(blocks) = 0 THEN RETURN r
    DIM k = BLOCKOFSOURCE(doc, at_pos)
    DIM b = blocks[k]
    IF b{"kind"} <> "table" THEN RETURN r
    DIM body_at = b{"start"} + LEN(b{"lead"})
    DIM before$ = MID$(doc{"src"}, body_at, MAX([0, MIN([at_pos - body_at, LEN(b{"body"})])]))
    DIM lines = SPLIT(before$, b{"eol"})
    DIM line_no = LEN(lines) - 1
    r{"block"} = k
    r{"row"} = MAX([0, line_no - 1])
    DIM cols = LEN(MDRICH.CELLS(lines[line_no] + "x")) - 1
    r{"col"} = MAX([0, cols])
    RETURN r
ENDFUNC

' The source lines of table block k, and a row of empty cells for it.
FUNC TableLines(doc, k)
    DIM b = doc{"blocks"}[k]
    DIM body$ = b{"body"}
    IF RIGHT$(body$, LEN(b{"eol"})) = b{"eol"} THEN body$ = LEFT$(body$, LEN(body$) - LEN(b{"eol"}))
    RETURN SPLIT(body$, b{"eol"})
ENDFUNC

FUNC TableLine$(cells, pipes)
    DIM row_text$ = JOIN(cells, " | ")
    IF pipes THEN row_text$ = "| " + row_text$ + " |"
    RETURN row_text$
ENDFUNC

' Replaces table block k's lines and redraws; answers the span.
FUNC SetTableLines(doc, k, lines)
    DIM b = doc{"blocks"}[k]
    DIM old$ = doc{"src"}
    DIM at_pos = b{"start"} + LEN(b{"lead"})
    DIM new_body$ = JOIN(lines, b{"eol"})
    IF RIGHT$(b{"body"}, LEN(b{"eol"})) = b{"eol"} THEN new_body$ = new_body$ + b{"eol"}
    DIM new$ = LEFT$(old$, at_pos) + new_body$ + MID$(old$, at_pos + LEN(b{"body"}), LEN(old$))
    DIM d AS MAP
    d{"changed"} = TRUE
    d{"start"} = at_pos
    d{"old_len"} = LEN(b{"body"})
    d{"text"} = new_body$
    DIM redrawn = SOURCECHANGED(doc, new$)
    RETURN d
ENDFUNC

' Puts the view caret into cell (row, col) of table block k.
SUB CaretToCell(doc, k, row, col)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM vp = ViewParas(rt)
    IF k >= LEN(vp{"texts"}) THEN RETURN
    DIM t$ = vp{"texts"}[k]
    DIM p = 0
    DIM n = 0
    FOR n = 0 TO row
        p = INSTR(p, t$, ROW_ON_SYNC) + LEN(ROW_ON_SYNC) + 2
    NEXT n
    FOR n = 1 TO col
        p = INSTR(p, t$, CHR$(7)) + 1
    NEXT n
    FORM.SET(rt, "SELSTART", ParaStart(vp, k) + p)
    FORM.SET(rt, "SELLENGTH", 0)
ENDSUB

' Adds an empty row below the row the view caret is in (below the header
' for the header row), or with from_source the row at source offset src_pos.
' Answers the span, unchanged outside a table.
EXPORT FUNC ADDROW(doc, from_source = FALSE, src_pos = 0)
    DIM pos = TABLEPOS(doc)
    IF from_source THEN pos = SOURCETABLEPOS(doc, src_pos)
    IF pos{"block"} < 0 THEN RETURN NoChange()
    DIM k = pos{"block"}
    DIM b = doc{"blocks"}[k]
    DIM lines = TableLines(doc, k)
    DIM empties = []
    DIM c = 0
    FOR c = 1 TO LEN(MDRICH.CELLS(lines[1]))
        empties = APPEND(empties, " ")
    NEXT c
    DIM at_line = pos{"row"} + 2
    IF pos{"row"} = 0 THEN at_line = 2
    DIM out = []
    DIM i = 0
    FOR i = 0 TO LEN(lines) - 1
        IF i = at_line THEN out = APPEND(out, TableLine$(empties, b{"pipes"}))
        out = APPEND(out, lines[i])
    NEXT i
    IF at_line >= LEN(lines) THEN out = APPEND(out, TableLine$(empties, b{"pipes"}))
    DIM d = SetTableLines(doc, k, out)
    CaretToCell(doc, k, at_line - 1, 0)
    RETURN d
ENDFUNC

' Adds an empty column right of the cell the view caret is in, or with
' from_source the cell at source offset src_pos.
EXPORT FUNC ADDCOL(doc, from_source = FALSE, src_pos = 0)
    DIM pos = TABLEPOS(doc)
    IF from_source THEN pos = SOURCETABLEPOS(doc, src_pos)
    IF pos{"block"} < 0 THEN RETURN NoChange()
    DIM k = pos{"block"}
    DIM b = doc{"blocks"}[k]
    DIM lines = TableLines(doc, k)
    DIM after = pos{"col"}
    DIM out = []
    DIM i = 0
    FOR i = 0 TO LEN(lines) - 1
        DIM cells = MDRICH.CELLS(lines[i])
        DIM fresh = []
        DIM c = 0
        FOR c = 0 TO LEN(cells) - 1
            fresh = APPEND(fresh, cells[c])
            IF c = after THEN fresh = APPEND(fresh, IIF(i = 1, "---", " "))
        NEXT c
        IF after >= LEN(cells) THEN fresh = APPEND(fresh, IIF(i = 1, "---", " "))
        out = APPEND(out, TableLine$(fresh, b{"pipes"}))
    NEXT i
    DIM d = SetTableLines(doc, k, out)
    CaretToCell(doc, k, pos{"row"}, after + 1)
    RETURN d
ENDFUNC

' Makes the selection in the view a link to url$ and reconciles.
EXPORT FUNC SETLINK(doc, url$)
    DIM rt AS DOUBLE = doc{"rt"}
    DIM text$ = FORM.GET(rt, "SELTEXT")
    IF text$ = "" THEN RETURN NoChange()
    DIM before$ = doc{"src"}
    DIM sel_at AS INTEGER = FORM.GET(rt, "SELSTART")
    DIM sel_len AS INTEGER = FORM.GET(rt, "SELLENGTH")
    ' text typed but not yet reconciled has no block to hold the URL; a
    ' redraw while reconciling leaves the text but drops the selection
    DIM pending = VIEWCHANGED(doc)
    FORM.SET(rt, "SELSTART", sel_at)
    FORM.SET(rt, "SELLENGTH", sel_len)
    DIM k = BLOCKAT(doc, sel_at)
    IF k < LEN(doc{"blocks"}) THEN
        DIM b = doc{"blocks"}[k]
        DIM ln AS MAP
        ln{"text"} = text$
        ln{"inner"} = text$
        ln{"dest"} = "(" + url$ + ")"
        b{"links"} = APPEND([ln], b{"links"})
    ENDIF
    FORM.SET(rt, "SELLINK", TRUE)
    FORM.SET(rt, "SELCOLOR", 26316)
    FORM.SET(rt, "SELUNDERLINE", TRUE)
    DIM after = VIEWCHANGED(doc)
    RETURN Span(before$, doc{"src"}, 0)
ENDFUNC
