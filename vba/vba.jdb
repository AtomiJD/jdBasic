' vba.jdb — VBA source file helper for jdBasic.
'
' Wraps TXTREADER$ / TXTWRITER with CP1252 (VBA's native export encoding for
' western Windows systems) so .bas / .cls / .frm files round-trip cleanly
' without losing umlauts to UTF-8 mojibake.
'
' Usage:
'     IMPORT VBA
'     DIM src$ = VBA.LOAD$("modAuftragFachlich.bas")
'     src$ = REPLACE$(src$, "Datensätze", "Datensätze (geprüft)")
'     VBA.SAVE "modAuftragFachlich.bas", src$
'
' All string operations between LOAD$ and SAVE work on the UTF-8 form, so
' literals with umlauts in the script source ("ä", "Datensätze", "Größe")
' just work. The disk file stays CP1252 — VBA, Access, and Excel re-import
' it unchanged.

EXPORT MODULE VBA

' Read a VBA source file (CP1252 on disk) into a UTF-8 jdBasic string.
EXPORT FUNC LOAD$(path$) AS STRING
    RETURN TXTREADER$(path$, "cp1252")
ENDFUNC

' Write a UTF-8 jdBasic string to a VBA source file as CP1252 bytes.
' Overwrites the file (no append).
EXPORT SUB SAVE(path$, content$)
    TXTWRITER path$, content$, FALSE, "cp1252"
ENDSUB

' Append a UTF-8 string to a VBA source file as CP1252 bytes.
EXPORT SUB APPEND_TO(path$, content$)
    TXTWRITER path$, content$, TRUE, "cp1252"
ENDSUB
