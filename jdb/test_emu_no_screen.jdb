' Smoke-test the CPU + Apple II IO dispatch without opening a SCREEN.
' Validates that the new funcref-based ENABLE_IO_HOOKS wiring actually
' fires APPLE2.IO_READ_DISPATCH / IO_WRITE_DISPATCH from inside cpu6502.

IMPORT APPLE2

APPLE2.INIT()
APPLE2.PUSH_KEY(ASC("A"))

' Direct read of the keyboard latch via CPU READ — should hit the
' funcref → APPLE2.IO_READ_DISPATCH → returns kbd_byte ($C1 = "A" + bit-7).
DIM b = CPU6502.READ($C000)
PRINT "kbd byte at $C000 = $"; HEX$(b); " (expected $C1)"

' Push another key (kbd_byte gets re-set to $C1 again before LDA test).
APPLE2.PUSH_KEY(ASC("A"))

' Tiny program: LDA $C000  (A9 00 .. — wait actually LDA $C000 = AD 00 C0)
' We'll write 'AD 00 C0  4C 03 03' at $0300 — load $C000, JMP self.
DIM prog = [ $AD, $00, $C0, $4C, $03, $03 ]
CPU6502.LOAD($0300, prog)
CPU6502.SET_PC($0300)
CPU6502.STEP_ONE()
PRINT "after LDA $C000: A = $"; HEX$(CPU6502.GET_A())

' Write to soft-switch $C010 (clear strobe) — exercises bus_write path.
CPU6502.WRITE($C010, 0)
DIM b2 = CPU6502.READ($C000)
PRINT "after $C010 clear, $C000 = $"; HEX$(b2); " (expected $41 — strobe cleared)"
