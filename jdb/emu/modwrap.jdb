EXPORT MODULE MODWRAP

IMPORT MODGLOB

' Wraps MODGLOB.BULK_WRITE the way apple2 wraps CPU6502.WRITE:
' apple2.LOAD_APPLE2_ROMS calls LOAD_ROM which loops calling
' CPU6502.WRITE($D000+i, byte). Mirror that pattern.

EXPORT FUNC LOAD_BYTES(filename$, start_addr)
    DIM data$
    TRY
        data$ = BINREADER$(filename$)
    CATCH
        RETURN -1
    ENDTRY
    DIM n = LEN(data$)
    DIM i
    FOR i = 0 TO n - 1
        MODGLOB.SET_ELEM(start_addr + i, BYTEAT(data$, i))
    NEXT i
    RETURN n
ENDFUNC

EXPORT SUB BOOTLIKE()
    MODGLOB.FILL_ZERO()
    LOAD_BYTES("thingsforyou/Apple II ROM Pages F8-FF - 341-0004 - Original Monitor.bin", $F800)
ENDSUB

' Same shape as LOAD_BYTES but no file I/O — pure FOR-loop with
' cross-module write. Isolates whether the bug is in BINREADER$/BYTEAT
' or the loop+SET_ELEM combination.
EXPORT SUB FILL_PATTERN(start_addr, n)
    DIM i
    FOR i = 0 TO n - 1
        MODGLOB.SET_ELEM(start_addr + i, (i BAND $FF))
    NEXT i
ENDSUB
