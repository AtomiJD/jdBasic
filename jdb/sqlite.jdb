' sqlite.jdb — jdBasic FFI wrapper around bridges/sqlitebridge/sqlitebridge.dll.
'
' Usage from a calling program:
'   IMPORT SQLITE
'   db = SQLITE.OPEN("test.db")
'   SQLITE.EXEC(db, "CREATE TABLE t(id INTEGER, name TEXT)")
'   rows = SQLITE.QUERY(db, "SELECT * FROM t")
'   SQLITE.CLOSE(db)
'
' The bridge DLL must be reachable by LoadLibrary — the simplest path
' is to run bridges/sqlitebridge/build.bat which deploys it next to
' jdBasic.exe.

EXPORT MODULE SQLITE

' ── Raw FFI declarations ─────────────────────────────────────────
DECLARE FUNC sqlb_open       LIB "sqlitebridge" ALIAS "sqlb_open"       (path AS STRING) AS INTEGER
DECLARE FUNC sqlb_close      LIB "sqlitebridge" ALIAS "sqlb_close"      (db AS INTEGER) AS INTEGER
DECLARE FUNC sqlb_exec       LIB "sqlitebridge" ALIAS "sqlb_exec"       (db AS INTEGER, sql AS STRING) AS INTEGER
DECLARE FUNC sqlb_query_json LIB "sqlitebridge" ALIAS "sqlb_query_json" (db AS INTEGER, sql AS STRING, outBuf AS RETURN, outLen AS INTEGER) AS ARRAY
DECLARE FUNC sqlb_errmsg     LIB "sqlitebridge" ALIAS "sqlb_errmsg"     (db AS INTEGER, outBuf AS RETURN, outLen AS INTEGER) AS ARRAY

' Default query buffer: 1 MB. For very large result sets, call
' SQLITE.QUERY_BUFSIZE(bytes) before SQLITE.QUERY.
DIM SQ_BUFSIZE = 1024 * 1024

EXPORT SUB QUERY_BUFSIZE(bytes)
    SQ_BUFSIZE = bytes
ENDSUB

' ── Public API ───────────────────────────────────────────────────

EXPORT FUNC OPEN(path$)
    h = sqlb_open(path$)
    IF h = 0 THEN
        THROW "SQLITE.OPEN failed for: " + path$
    ENDIF
    RETURN h
ENDFUNC

EXPORT SUB CLOSE(db)
    dummy = sqlb_close(db)
ENDSUB

EXPORT FUNC EXEC(db, sql$)
    rc = sqlb_exec(db, sql$)
    IF rc < 0 THEN
        THROW "SQLITE.EXEC failed: " + ERROR$(db) + " — SQL: " + sql$
    ENDIF
    RETURN rc
ENDFUNC

EXPORT FUNC QUERY(db, sql$)
    [bytes_written, json$] = sqlb_query_json(db, sql$, SQ_BUFSIZE, SQ_BUFSIZE)
    IF bytes_written = -2 THEN
        THROW "SQLITE.QUERY: result exceeds buffer (" + STR$(SQ_BUFSIZE) + " bytes). Use SQLITE.QUERY_BUFSIZE to increase."
    ENDIF
    IF bytes_written < 0 THEN
        THROW "SQLITE.QUERY failed: " + ERROR$(db) + " — SQL: " + sql$
    ENDIF
    IF bytes_written = 0 THEN
        RETURN []
    ENDIF
    RETURN JSON.PARSE$(json$)
ENDFUNC

EXPORT FUNC ERROR$(db)
    [n, msg$] = sqlb_errmsg(db, 4096, 4096)
    RETURN msg$
ENDFUNC
