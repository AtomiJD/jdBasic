' Test the I/O hook system + soft switches end-to-end.
'
' The CPU dispatches $C000-$C0FF reads/writes by NAME to IO_READ /
' IO_WRITE (host-defined), which we point at APPLE2.IO_*_DISPATCH.

IMPORT APPLE2

FUNC IO_READ(addr)
    RETURN APPLE2.IO_READ_DISPATCH(addr)
ENDFUNC

SUB IO_WRITE(addr, val)
    APPLE2.IO_WRITE_DISPATCH(addr, val)
ENDSUB

DIM tests_pass = 0
DIM tests_fail = 0

SUB ASSERT(cond, label$)
    IF cond THEN
        tests_pass = tests_pass + 1
        PRINT "  PASS  " + label$
    ELSE
        tests_fail = tests_fail + 1
        PRINT "  FAIL  " + label$
    ENDIF
ENDSUB

APPLE2.INIT()

' ─── Soft-switch reads via CPU6502.READ ────────────────────────
PRINT
PRINT "── Keyboard soft-switch ──"

' No key pending: $C000 returns 0 (strobe clear).
ASSERT(CPU6502.READ($C000) = 0, "No key → $C000 returns 0")

APPLE2.PUSH_KEY(ASC("A"))
ASSERT(CPU6502.READ($C000) = ($C1), "After PUSH_KEY('A') $C000 = $C1 (with strobe)")
ASSERT((CPU6502.READ($C000) BAND $80) <> 0, "Bit 7 (strobe) is set")

' Reading $C010 clears the strobe; $C000 then returns the data without strobe.
DIM ack = CPU6502.READ($C010)
ASSERT(ack = 0, "$C010 (strobe-clear) returns 0")
ASSERT(CPU6502.READ($C000) = $41, "$C000 after strobe-clear = $41 (no bit 7)")

' Push another key — strobe re-asserts.
APPLE2.PUSH_KEY(ASC("Z"))
ASSERT(CPU6502.READ($C000) = $DA, "After PUSH_KEY('Z') $C000 = $DA")

' ─── 6502 program polls $C000 then reads strobe-clear ──────────
PRINT
PRINT "── 6502 keyboard polling routine ──"

' Program at $0200:
'   :poll  LDA $C000     AD 00 C0
'          BPL :poll      10 FB        (loop while bit 7 = 0)
'          STA $20        85 20        (save the key)
'          LDA $C010      AD 10 C0     (clear strobe)
'   :hang  JMP :hang      4C 0B 02
DIM prog = [ $AD, $00, $C0, $10, $FB, $85, $20, $AD, $10, $C0, $4C, $0B, $02 ]

APPLE2.INIT()
CPU6502.LOAD($0200, prog)
CPU6502.SET_PC($0200)

' Push 'X' before running — the routine should pick it up immediately.
APPLE2.PUSH_KEY(ASC("X"))
DIM steps = CPU6502.RUN_UNTIL($020B, 100)
ASSERT(steps < 100,                       "Routine reached :hang in <100 steps")
ASSERT(CPU6502.READ($20) = $D8,           "mem[$20] = $D8 ('X' with bit 7)")
ASSERT((CPU6502.READ($C000) BAND $80) = 0, "Strobe cleared after $C010 read")

PRINT
PRINT "════════════════════════════════════"
PRINT "  Apple II I/O hooks: PASS = " + STR$(tests_pass) + ", FAIL = " + STR$(tests_fail)
PRINT "════════════════════════════════════"
