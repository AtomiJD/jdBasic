' ==========================================================
' == jdBasic Markdown to Word Converter 
' ==========================================================

' --- 1. Constants ---
wdStyleNormal = -1
wdStyleHeading1 = -2
wdStyleHeading2 = -3
wdStyleHeading3 = -4
wdBorderBottom = -3
wdAutoFitContent = 1
wdLineStyleSingle = 1
wdStory = 6

' --- 1a. Parameters
useHeaderNewline = FLASE

' You need to change your document path. In the "." case, it reads from your 
' actual folder but word will write to your documents folder
' ex. CurrentDir$ = "c:\temp" will read AND write to c:\temp
CurrentDir$ = "."
INPUT_FILE$ = "README.md"
OUTPUT_FILE$ = "README.docx"

args = OS.ARGS()

IF LEN(args) >= 1 THEN CurrentDir$  = args[0]
IF LEN(args) >= 2 THEN INPUT_FILE$ =  args[1]
IF LEN(args) = 3 THEN OUTPUT_FILE$ = args[2]

' --- 2. Setup ---
TRY
    CD CurrentDir$
CATCH
    PRINT "Warning: Could not change to directory."
ENDTRY

' --- 3. Initialize Word ---
PRINT "Launching Microsoft Word..."
TRY
    wordApp = CREATEOBJECT("Word.Application")
    wordApp.Visible = TRUE
    doc = wordApp.Documents.Add()
    sel = wordApp.Selection
    sel.Font.Name = "Segoe UI"
    sel.Font.Size = 11
CATCH
    PRINT "CRITICAL ERROR: Could not launch Word."
    PRINT "Message: "; ERRMSG$
    END
ENDTRY

' --- 4. Read File  ---
PRINT "Reading " + INPUT_FILE$ + "..."
raw_content$ = TXTREADER$(INPUT_FILE$)

' Normalize Line Endings (CRLF -> LF)
content$ = REPLACE$(raw_content$, CHR$(13) + CHR$(10), CHR$(10))
content$ = REPLACE$(content$, CHR$(13), CHR$(10)) 
lines = SPLIT(content$, CHR$(10))

' --- 5. Main Loop ---
PRINT "Converting..."

TableBuffer = []
InTable = FALSE

FOR i = 0 TO LEN(lines) - 1
    line$ = lines[i]
    tline$ = TRIM$(line$)

    ' --- TABLE DETECTION ---
    IF LEFT$(tline$, 1) = "|" THEN
        ' Skip separator lines like |---|
        IF INSTR(tline$, "---") < 0 THEN
            TableBuffer = APPEND(TableBuffer, tline$)
        ENDIF
        InTable = TRUE
        GOTO NextIteration
    ELSE
        ' End of table detected? Process it.
        IF InTable THEN
            ProcessTable sel, TableBuffer
            TableBuffer = []
            InTable = FALSE
        ENDIF
    ENDIF
    
    ' 1. Calculate Indentation
    LeadingSpaces = 0
    FOR s = 0 TO LEN(line$) - 1
        IF MID$(line$, s, 1) = " " THEN 
            LeadingSpaces = LeadingSpaces + 1 
        ELSE 
            EXITFOR 
        ENDIF
    NEXT s
    sel.ParagraphFormat.LeftIndent = INT(LeadingSpaces / 2) * 18
    
    ' 2. Headers
    IF LEFT$(tline$, 2) = "# " THEN
        sel.Style = wdStyleHeading1
        ProcessTextStyles sel, MID$(tline$, 2)
        IF useHeaderNewline THEN sel.TypeParagraph()
        
    ELSEIF LEFT$(tline$, 3) = "## " THEN
        sel.Style = wdStyleHeading2
        ProcessTextStyles sel, MID$(tline$, 3)
        IF useHeaderNewline THEN sel.TypeParagraph()
        
    ELSEIF LEFT$(tline$, 4) = "### " THEN
        sel.Style = wdStyleHeading3
        ProcessTextStyles sel, MID$(tline$, 4)
        IF useHeaderNewline THEN sel.TypeParagraph()

    ' 3. Lists
    ELSEIF LEFT$(tline$, 2) = "- " OR LEFT$(tline$, 2) = "* " THEN
        sel.Style = wdStyleNormal
        sel.TypeText "- " 
        sel.ParagraphFormat.LeftIndent = sel.ParagraphFormat.LeftIndent + 10
        ProcessTextStyles sel, MID$(tline$, 2)
        sel.TypeParagraph()

    ' 4. Horizontal Rule
    ELSEIF LEFT$(tline$, 3) = "---" THEN
        sel.TypeParagraph()
        TRY
            sel.ParagraphFormat.Borders.Item(wdBorderBottom).LineStyle = wdLineStyleSingle
        CATCH
            sel.TypeText "____________________"
        ENDTRY
        IF useHeaderNewline THEN sel.TypeParagraph()
        TRY
            sel.ParagraphFormat.Borders.Item(wdBorderBottom).LineStyle = 0
        CATCH
        ENDTRY
    ' 5. Qoutes
    ELSEIF LEFT$(tline$, 1) = ">" THEN
        quoteText$ = TRIM$(MID$(tline$, 2))
        TRY
            sel.Style = "Intensives Zitat" 'For US Word:  sel.Style = "Intense Quote"
        CATCH
            sel.Style = wdStyleNormal
        ENDTRY
        ProcessTextStyles sel, quoteText$
        sel.TypeParagraph()
    ELSE
        IF tline$ = "" THEN
            sel.TypeParagraph()
        ELSE
            sel.Style = wdStyleNormal
            sel.Font.Name = "Segoe UI"
            sel.Font.Size = 11            
            ProcessTextStyles sel, tline$
            sel.TypeParagraph()
        ENDIF
    ENDIF
    
    ' Reset Indent
    sel.ParagraphFormat.LeftIndent = 0

NextIteration:
NEXT i

' Flush table if file ends with one
IF InTable THEN
    ProcessTable sel, TableBuffer
ENDIF

' --- 6. Save ---
PRINT "Saving..."
FullPath$ = CurrentDir$ + "\" + OUTPUT_FILE$

TRY
    doc.SaveAs2 FullPath$
    PRINT "Saved to: " + FullPath$
CATCH
    PRINT "Save Error: "; ERRMSG$
FINALLY
    doc.Close()
    wordApp.Quit()
    wordApp = NULL
ENDTRY

PRINT "Done."

' ==========================================================
' == Helper: Process Inline Styles (Bold & Code)
' ==========================================================
SUB ProcessTextStyles(selObj, text$)
    buffer$ = ""
    inBold = FALSE
    inCode = FALSE
    
    textLen = LEN(text$)
    DIM i AS INTEGER = 0
    
    DO WHILE i < textLen
        char$ = MID$(text$, i, 1)
        nextChar$ = ""
        IF i < textLen - 1 THEN nextChar$ = MID$(text$, i+1, 1)
        
        ' --- Handle Code (`) ---
        IF char$ = "`" AND inBold = FALSE THEN
            IF buffer$ <> "" THEN selObj.TypeText buffer$ : buffer$ = ""
            inCode = NOT inCode
            IF inCode THEN
                selObj.Font.Name = "Consolas"
                selObj.Font.Color = 12615680
                selObj.Font.Bold = 0
            ELSE
                selObj.Font.Name = "Segoe UI"
                selObj.Font.Color = 0
                selObj.Font.Bold = 0
            ENDIF
            i = i + 1
        ELSEIF char$ = "`" AND inBold = TRUE THEN
            IF buffer$ <> "" THEN selObj.TypeText buffer$ : buffer$ = ""
            inCode = NOT inCode
            IF inCode THEN
                selObj.Font.Name = "Consolas"
                selObj.Font.Color = 12615680
            ELSE
                selObj.Font.Name = "Segoe UI"
                selObj.Font.Color = 0
            ENDIF
            IF inBold THEN 
                selObj.Font.Bold = 1 
            ELSE 
                selObj.Font.Bold = 0
            ENDIF            
            i = i + 1
        ELSEIF char$ = "*" AND nextChar$ = "*" AND inCode = FALSE THEN
            IF buffer$ <> "" THEN selObj.TypeText buffer$ : buffer$ = ""
            inBold = NOT inBold
            IF inBold THEN 
                selObj.Font.Bold = 1 
            ELSE 
                selObj.Font.Bold = 0
            ENDIF
            i = i + 2
        ELSEIF char$ = "\" AND nextChar$ IN [".", "_", ">", "<"]  THEN    
            buffer$ = buffer$ + nextChar$
            i = i + 2        
        ELSE
            buffer$ = buffer$ + char$
            i = i + 1
        ENDIF
    LOOP
    
    IF buffer$ <> "" THEN selObj.TypeText buffer$
    
    selObj.Font.Bold = 0
    selObj.Font.Name = "Segoe UI"
    selObj.Font.Color = 0
ENDSUB

' ==========================================================
' == Helper: Render Table
' ==========================================================
SUB ProcessTable(selObj, tableLines)
    rowCount = LEN(tableLines)
    IF rowCount = 0 THEN RETURN
    
    PRINT "Creating Table (" + rowCount + " rows)..."
    
    bulkText$ = ""
    
    FOR i = 0 TO rowCount - 1
        rawLine$ = tableLines[i]
        
        IF LEFT$(rawLine$, 1) = "|" THEN rawLine$ = MID$(rawLine$, 1)
        IF RIGHT$(rawLine$, 1) = "|" THEN rawLine$ = LEFT$(rawLine$, LEN(rawLine$)-1)
        
        tabLine$ = REPLACE$(rawLine$, "|", CHR$(9))
        bulkText$ = bulkText$ + tabLine$ + CHR$(13)
    NEXT i
    
    startRange = selObj.Range.End
    ProcessTextStyles selObj, bulkText$
    endRange = selObj.Range.End
    selObj.Start = startRange
    selObj.End = endRange
    
    TRY
        wordApp.DefaultTableSeparator = chr$(9)
        tbl = selObj.ConvertToTable()
        tbl.AutoFitBehavior(wdAutoFitContent)
        tbl.Borders.Enable = TRUE
    CATCH
        PRINT "Table Warning: "; ERRMSG$
    ENDTRY
    
    selObj.EndKey wdStory
    selObj.TypeParagraph()
ENDSUB