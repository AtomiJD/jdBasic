WS1> list
SOUND.INIT
' Test 1: Simple sine beep
PRINT "Playing sine beep..."
SOUND.VOICE 0, "SINE", 0.01, 0.1, 0.5, 0.3
SOUND.PLAY 0, "C4"
SLEEP 500
SOUND.RELEASE 0
SLEEP 400
' Test 2: Square wave
PRINT "Playing square wave..."
SOUND.VOICE 1, "SQUARE", 0.01, 0.1, 0.7, 0.2
SOUND.PLAY 1, "E4"
SLEEP 500
SOUND.RELEASE 1
SLEEP 300
' Test 3: Saw wave with filter
PRINT "Playing filtered saw..."
SOUND.VOICE 2, "SAW", 0.01, 0.2, 0.6, 0.3
SOUND.FILTER 2, 800
SOUND.PLAY 2, "G3"
SLEEP 600
SOUND.RELEASE 2
SLEEP 400
' Test 4: Sequencer - simple beat
PRINT "Playing sequencer pattern..."
SOUND.BPM 120
SOUND.VOICE 3, "SQUARE", 0.001, 0.05, 0.0, 0.05
SOUND.SEQ 3, "c2 ~ c2 ~", "VOICE"
SLEEP 3000
' Test 5: Melody over beat
SOUND.VOICE 4, "SAW", 0.01, 0.2, 0.0, 0.2
SOUND.FILTER 4, 1200
SOUND.SEQ 4, "c3 [e3 g3] ~ b3", "VOICE"
SOUND.REVERBSEND 4, 0.4
SOUND.REVERB 0.7, 0.5, 1.0, 0.4
SLEEP 4000
SOUND.RESET
PRINT "Sound test complete!"
SOUND.SHUTDOWN
