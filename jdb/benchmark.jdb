' ==========================================================
' Benchmark: calc_partial_result / calc_partial_conditional
' Translated from C with jdBasic array optimizations
' ==========================================================

' --- Custom PRNG (matches the C version) ---
random_seed = 1

FUNC random_int()
    random_seed = (random_seed * 1664525 + 1013904223) MOD 4294967296
    ' Simulate C signed int: values >= 2^31 become negative
    IF random_seed >= 2147483648 THEN
        RETURN random_seed - 4294967296
    ENDIF
    RETURN random_seed
ENDFUNC

' --- calc_partial_result ---
' For each i: sum values[i] * (j-1) for j = 0..i
' Inner sum = values[i] * SUM(IOTA(i+1, 0) - 1) = values[i] * (SUM(0..i) - (i+1))
FUNC calc_partial_result(values, n)
    result = 0
    FOR i = 0 TO n - 1
        ' j runs 0..i, so (j-1) runs -1..i-1, sum = i*(i+1)/2 - (i+1)
        inner_sum = i * (i + 1) / 2 - (i + 1)
        result = result + values[i] * inner_sum
    NEXT i
    RETURN result
ENDFUNC

' --- calc_partial_conditional_result ---
FUNC calc_partial_conditional_result(values, values_cond, n, min_cond)
    result = 0
    FOR i = 0 TO n - 1
        FOR j = 0 TO i
            IF values_cond[j] >= min_cond THEN
                result = result + values[i] * (j - 1)
            ENDIF
        NEXT j
    NEXT i
    RETURN result
ENDFUNC

' --- Main ---
args = OS.ARGS()
IF LEN(args) < 2 THEN
    PRINT "Usage: jdBasic benchmark.jdb <num_of_values>"
    END
ENDIF

num_of_values = VAL(args[1])
num_of_executions = 10
num_of_values_to_process = num_of_values / 2
min_conditional_value = 10

' Generate data arrays
values = IOTA(num_of_values)
DIM values_cond[num_of_values]
FOR i = 0 TO num_of_values - 1
    values_cond[i] = random_int()
NEXT i

' --- Benchmark: calc_partial_result ---
DIM exec_times[num_of_executions]
FOR i = 0 TO num_of_executions - 1
    t0 = TICK()
    result = calc_partial_result(values, num_of_values_to_process)
    exec_times[i] = (TICK() - t0) / 1000
NEXT i

PRINT "calc_partial_result:"
PRINT FORMAT$("num_of_values_to_process: = {}", num_of_values_to_process)
PRINT FORMAT$("{:.6f} s +/- {:.6f} s per loop (mean +/- std. dev. of {} runs, 1 loop each)", MEAN(exec_times), STDEV(exec_times), num_of_executions)
PRINT FORMAT$("result = {:.6f}", result)
PRINT ""

' --- Benchmark: calc_partial_conditional_result ---
FOR i = 0 TO num_of_executions - 1
    t0 = TICK()
    result = calc_partial_conditional_result(values, values_cond, num_of_values_to_process, min_conditional_value)
    exec_times[i] = (TICK() - t0) / 1000
NEXT i

PRINT "calc_partial_conditional_result:"
PRINT FORMAT$("num_of_values_to_process: = {}", num_of_values_to_process)
PRINT FORMAT$("{:.6f} s +/- {:.6f} s per loop (mean +/- std. dev. of {} runs, 1 loop each)", MEAN(exec_times), STDEV(exec_times), num_of_executions)
PRINT FORMAT$("result = {:.6f}", result)
