' musicvideo.jdb - turns the songs in jdb/demos/sound into music videos
' for the series "When Kaiku Dreams Techno".
'
'   jdBasic musicvideo.jdb                      every song in SONGS below
'   jdBasic musicvideo.jdb <base>               one, e.g. kaiku_01_neon_highway
'   jdBasic musicvideo.jdb <base> purple        the same in another look
'
' The look is the show (stage.jdb --look): classic, purple, neon or
' rainbow, for both dancers. A look other than classic is part of the
' file name.
'
' Per song: the song renders itself offline (--render, see stage.jdb)
' into raw/<base>_frames - an intro with 3-2-1, then every frame as JPEG
' at 30 fps and the sound as a WAV; ffmpeg muxes final/<base>.mp4 with
' the audio laid in after the intro; the frames are deleted again. The
' YouTube description is scripts/<base>.md.

OPTION "EXPLICIT"

DIM JDB$ AS STRING = "..\..\build\jdBasic.exe"
DIM SONG_DIR$ AS STRING = "..\demos\sound\"
DIM FPS AS INTEGER = 30
DIM INTRO_MS AS INTEGER = 6000

' base, song file, look
DIM SONGS$ = ["kaiku_01_neon_highway", "synthwave_highway", "classic", "kaiku_02_glitter_ball", "disco_glitter", "rainbow", "kaiku_03_rooftop_sunday", "house_rooftop", "classic", "kaiku_04_copper_wire", "acid_copper", "neon", "kaiku_05_kaiku_in_a_minor", "trance_live", "purple", "kaiku_06_night_bus", "dnb_nightbus", "neon"]

' Deletes the frames and the WAV of a render, then the directory
SUB CLEAN_FRAMES(dir$)
    IF FILE.EXISTS(dir$) THEN
        DIM names = FILE.LIST(dir$)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(names) - 1
            DIM nm$ AS STRING = names[i]
            IF ENDSWITH(nm$, ".jpg") ORELSE nm$ = "audio.wav" THEN KILL dir$ + "\" + nm$
        NEXT i
        RMDIR dir$
    ENDIF
ENDSUB

FUNC MAKE_VIDEO(name$, song$, look$) AS INTEGER
    DIM base$ AS STRING = name$
    IF look$ <> "classic" THEN base$ = base$ + "_" + look$
    DIM frames$ AS STRING = "raw\" + base$ + "_frames"
    DIM out$ AS STRING = "final\" + base$ + ".mp4"
    PRINT "== "; base$; "  ("; song$; ".jdb, "; look$; ")"
    CLEAN_FRAMES frames$
    MKDIR frames$

    DIM t0 AS DOUBLE = TICK()
    DIM r = OS.EXEC(JDB$, [SONG_DIR$ + song$ + ".jdb", "--render", frames$, "--look", look$])
    DIM run_log$ AS STRING = r{"output"}
    DIM p AS INTEGER = INSTR(run_log$, "rendered ")
    IF p < 0 THEN
        PRINT "   render failed:"
        PRINT run_log$
        RETURN FALSE
    ENDIF
    DIM n_frames AS INTEGER = VAL(MID$(run_log$, p + 9, 8))
    DIM secs AS DOUBLE = n_frames / FPS
    PRINT "   "; n_frames; " frames ("; INT(secs); " s) in "; INT((TICK() - t0) / 1000); " s"

    DIM vfilter$ AS STRING = "[0:v]fade=t=in:st=0:d=0.7,fade=t=out:st=" + STR$(secs - 1.5) + ":d=1.5[v]"
    DIM afilter$ AS STRING = "[1:a]adelay=" + STR$(INTRO_MS) + "|" + STR$(INTRO_MS) + ",apad,afade=t=out:st=" + STR$(secs - 2) + ":d=2[a]"
    DIM ff = OS.EXEC("ffmpeg", ["-y", "-loglevel", "error", "-framerate", STR$(FPS), "-i", frames$ + "\f%05d.jpg", "-i", frames$ + "\audio.wav", "-filter_complex", vfilter$ + ";" + afilter$, "-map", "[v]", "-map", "[a]", "-c:v", "libx264", "-preset", "medium", "-crf", "18", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "256k", "-t", STR$(secs), "-movflags", "+faststart", out$])
    IF ff{"exit_code"} <> 0 ORELSE NOT FILE.EXISTS(out$) THEN
        PRINT "   ffmpeg failed:"
        PRINT ff{"output"}
        RETURN FALSE
    ENDIF
    CLEAN_FRAMES frames$
    PRINT "   -> "; out$; "  ("; INT((TICK() - t0) / 1000); " s total)"
    RETURN TRUE
ENDFUNC

DIM cli = OS.ARGS()
DIM only$ AS STRING = ""
IF LEN(cli) > 1 THEN only$ = cli[1]
DIM one_look$ AS STRING = ""
IF LEN(cli) > 2 THEN one_look$ = LCASE$(cli[2])
DIM look$ AS STRING = ""
DIM made AS INTEGER = 0
DIM si AS INTEGER
FOR si = 0 TO LEN(SONGS$) - 1 STEP 3
    IF only$ = "" ORELSE only$ = SONGS$[si] THEN
        look$ = SONGS$[si + 2]
        IF one_look$ <> "" THEN look$ = one_look$
        IF MAKE_VIDEO(SONGS$[si], SONGS$[si + 1], look$) THEN made = made + 1
    ENDIF
NEXT si
PRINT made; " video(s) made"
