' tiktok.jdb - TikTok clips for the series "When Kaiku Dreams Techno":
' songgen writes a track from a genre and a seed, and the show renders it
' in portrait (stage.jdb --tiktok) with the girl dancing a new move every
' two bars, from a bar before the first drop for at most 30 seconds.
'
'   jdBasic tiktok.jdb                    every clip in CLIPS below
'   jdBasic tiktok.jdb house 7            one, from a genre and a seed
'   jdBasic tiktok.jdb house 7 neon       the same in another look
'
' The look is the show (stage.jdb --look): classic, purple, neon or
' rainbow. A look other than classic is part of the file name.
'
' Per clip: the frames and the WAV go into raw/<base>_frames, ffmpeg
' muxes final/tiktok/<base>.mp4 (1080x1920, 30 fps), the frames are
' deleted again, final/tiktok/<base>.cover.png is the cover and
' final/tiktok/<base>.txt holds a caption to paste.

OPTION "EXPLICIT"

DIM JDB$ AS STRING = "..\..\build\jdBasic.exe"
DIM SONGGEN$ AS STRING = "..\demos\sound\songgen.jdb"
DIM FPS AS INTEGER = 30
DIM OUT_DIR$ AS STRING = "final\tiktok"
DIM TAGS$ AS STRING = "#techno #electronicmusic #generativemusic #aimusic #creativecoding #dance #neon #synthwave #kaiku #jdbasic"

' genre, seed, look
DIM CLIPS$ = ["trance", "42", "purple", "house", "7", "neon", "synthwave", "3", "classic", "deep", "11", "rainbow", "acid", "5", "neon", "trance", "17", "rainbow", "house", "23", "purple"]

' The cover title's colour per look
FUNC LOOK_COLOR$(look$) AS STRING
    IF look$ = "purple" THEN RETURN "0xD296FF"
    IF look$ = "neon" THEN RETURN "0x78FF8C"
    IF look$ = "rainbow" THEN RETURN "0xFFD75A"
    RETURN "0xFF6EC7"
ENDFUNC

SUB CLEAN_FRAMES(dir$)
    IF FILE.EXISTS(dir$) THEN
        DIM names = FILE.LIST(dir$)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(names) - 1
            DIM nm$ AS STRING = names[i]
            IF ENDSWITH(nm$, ".jpg") ORELSE ENDSWITH(nm$, ".png") ORELSE ENDSWITH(nm$, ".txt") ORELSE nm$ = "audio.wav" THEN KILL dir$ + "\" + nm$
        NEXT i
        RMDIR dir$
    ENDIF
ENDSUB

' The text between the first pair of quotes in s$, "" when there is none
FUNC QUOTED$(s$) AS STRING
    DIM q$ AS STRING = CHR$(34)
    DIM a AS INTEGER = INSTR(s$, q$)
    IF a < 0 THEN RETURN ""
    DIM rest$ AS STRING = MID$(s$, a + 1, LEN(s$))
    DIM b AS INTEGER = INSTR(rest$, q$)
    IF b < 0 THEN RETURN ""
    RETURN LEFT$(rest$, b)
ENDFUNC

' The still of the first move in PREFER$ the render saved, else of any
FUNC COVER_STILL$(frames$) AS STRING
    DIM PREFER$ = ["heart", "clap", "woah", "dab", "wave"]
    DIM names = FILE.LIST(frames$)
    DIM pi_k AS INTEGER
    DIM i AS INTEGER
    FOR pi_k = 0 TO LEN(PREFER$) - 1
        FOR i = 0 TO LEN(names) - 1
            DIM nm$ AS STRING = names[i]
            IF STARTSWITH(nm$, "cover_") ANDALSO ENDSWITH(nm$, "_" + PREFER$[pi_k] + ".png") THEN RETURN frames$ + "\" + nm$
        NEXT i
    NEXT pi_k
    FOR i = 0 TO LEN(names) - 1
        DIM cand$ AS STRING = names[i]
        IF STARTSWITH(cand$, "cover_") THEN RETURN frames$ + "\" + cand$
    NEXT i
    RETURN ""
ENDFUNC

' The cover: the still, whose own line names the series, under a dark band
' with the song and the key, in the upper third, where TikTok's profile
' grid still shows it
FUNC MAKE_COVER(still$, out_png$, song$, info$, work$, color$) AS INTEGER
    DIM song_txt$ AS STRING = work$ + "\cover_song.txt"
    DIM info_txt$ AS STRING = work$ + "\cover_info.txt"
    TXTWRITER song_txt$, song$
    TXTWRITER info_txt$, info$
    DIM size AS INTEGER = INT(880 / (MAX([LEN(song$), 6]) * 0.6))
    IF size > 150 THEN size = 150
    DIM font$ AS STRING = "fontfile=../../build/jdbasic_default.ttf"
    DIM ft$ AS STRING = REPLACE$(song_txt$, "\", "/")
    DIM fi$ AS STRING = REPLACE$(info_txt$, "\", "/")
    DIM vf$ AS STRING = "drawbox=x=0:y=318:w=iw:h=340:color=0x05020F@0.62:t=fill"
    vf$ = vf$ + ",drawtext=" + font$ + ":textfile=" + ft$ + ":fontsize=" + STR$(size) + ":fontcolor=" + color$ + ":borderw=5:bordercolor=0x1A0020:x=(w-text_w)/2:y=" + STR$(INT(440 - size / 2))
    vf$ = vf$ + ",drawtext=" + font$ + ":textfile=" + fi$ + ":fontsize=46:fontcolor=0xF0F0FF:x=(w-text_w)/2:y=560"
    DIM ff = OS.EXEC("ffmpeg", ["-y", "-loglevel", "error", "-i", still$, "-vf", vf$, "-frames:v", "1", out_png$])
    IF ff{"exit_code"} <> 0 THEN PRINT ff{"output"}
    RETURN ff{"exit_code"} = 0 ANDALSO FILE.EXISTS(out_png$)
ENDFUNC

' "Eb major, 123 BPM" from the recipe line "  key Eb major, 123 BPM, ..."
FUNC KEY_INFO$(run_log$) AS STRING
    DIM k AS INTEGER = INSTR(run_log$, "  key ")
    IF k < 0 THEN RETURN ""
    DIM rest$ AS STRING = MID$(run_log$, k + 6, 60)
    DIM b AS INTEGER = INSTR(rest$, " BPM")
    IF b < 0 THEN RETURN ""
    RETURN LEFT$(rest$, b + 4)
ENDFUNC

FUNC MAKE_CLIP(genre$, seed$, look$) AS INTEGER
    DIM base$ AS STRING = "kaiku_tt_" + genre$ + "_" + seed$
    IF look$ <> "classic" THEN base$ = base$ + "_" + look$
    DIM frames$ AS STRING = "raw\" + base$ + "_frames"
    DIM out$ AS STRING = OUT_DIR$ + "\" + base$ + ".mp4"
    PRINT "== "; base$
    CLEAN_FRAMES frames$
    MKDIR frames$
    MKDIR OUT_DIR$

    DIM t0 AS DOUBLE = TICK()
    DIM r = OS.EXEC(JDB$, [SONGGEN$, "--genre", genre$, "--seed", seed$, "--render", frames$, "--tiktok", "--look", look$])
    DIM run_log$ AS STRING = r{"output"}
    DIM p AS INTEGER = INSTR(run_log$, "rendered ")
    IF p < 0 THEN
        PRINT "   render failed:"
        PRINT run_log$
        RETURN FALSE
    ENDIF
    DIM song$ AS STRING = QUOTED$(run_log$)
    DIM n_frames AS INTEGER = VAL(MID$(run_log$, p + 9, 8))
    DIM secs AS DOUBLE = n_frames / FPS
    PRINT "   "; song$; ": "; n_frames; " frames ("; INT(secs * 10) / 10; " s) in "; INT((TICK() - t0) / 1000); " s"

    DIM vfilter$ AS STRING = "[0:v]fade=t=in:st=0:d=0.3,fade=t=out:st=" + STR$(secs - 0.8) + ":d=0.8[v]"
    DIM afilter$ AS STRING = "[1:a]afade=t=in:st=0:d=0.05,afade=t=out:st=" + STR$(secs - 1.2) + ":d=1.2[a]"
    DIM ff = OS.EXEC("ffmpeg", ["-y", "-loglevel", "error", "-framerate", STR$(FPS), "-i", frames$ + "\f%05d.jpg", "-i", frames$ + "\audio.wav", "-filter_complex", vfilter$ + ";" + afilter$, "-map", "[v]", "-map", "[a]", "-c:v", "libx264", "-preset", "medium", "-crf", "18", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "192k", "-t", STR$(secs), "-movflags", "+faststart", out$])
    IF ff{"exit_code"} <> 0 ORELSE NOT FILE.EXISTS(out$) THEN
        PRINT "   ffmpeg failed:"
        PRINT ff{"output"}
        RETURN FALSE
    ENDIF
    DIM genre_name$ AS STRING = UCASE$(LEFT$(genre$, 1)) + MID$(genre$, 1, LEN(genre$))
    DIM still$ AS STRING = COVER_STILL$(frames$)
    DIM cover$ AS STRING = OUT_DIR$ + "\" + base$ + ".cover.png"
    IF still$ = "" ORELSE NOT MAKE_COVER(still$, cover$, song$, genre_name$ + "  -  " + KEY_INFO$(run_log$), frames$, LOOK_COLOR$(look$)) THEN
        PRINT "   cover failed"
    ELSE
        PRINT "   -> "; cover$
    ENDIF
    CLEAN_FRAMES frames$

    DIM caption$ AS STRING = song$ + " - " + genre_name$ + " | When Kaiku Dreams Techno" + CHR$(10)
    caption$ = caption$ + "Every sound and every move is code: an AI writes the track, she dances to it." + CHR$(10)
    caption$ = caption$ + TAGS$ + " #" + genre$ + CHR$(10)
    TXTWRITER OUT_DIR$ + "\" + base$ + ".txt", caption$
    PRINT "   -> "; out$; "  ("; INT((TICK() - t0) / 1000); " s total)"
    RETURN TRUE
ENDFUNC

DIM cli = OS.ARGS()
DIM made AS INTEGER = 0
IF LEN(cli) > 2 THEN
    DIM one_look$ AS STRING = "classic"
    IF LEN(cli) > 3 THEN one_look$ = LCASE$(cli[3])
    IF MAKE_CLIP(LCASE$(cli[1]), cli[2], one_look$) THEN made = 1
ELSE
    DIM ci AS INTEGER
    FOR ci = 0 TO LEN(CLIPS$) - 1 STEP 3
        IF MAKE_CLIP(CLIPS$[ci], CLIPS$[ci + 1], CLIPS$[ci + 2]) THEN made = made + 1
    NEXT ci
ENDIF
PRINT made; " clip(s) made"
