' ══════════════════════════════════════════════════════════════════
'  FFMPEG.jdb — post-production composition.
'  Reads a director manifest, layers TTS voice clips + title cards
'  onto the raw recording, and renders a final MP4 with clean audio
'  and branded overlays.
'
'  Manifest data rows (tab-separated, leading-tagged):
'      VOICE\t<offset_ms>\t<dur_ms>\t<wav_path>
'      CARD \t<offset_ms>\t<dur_ms>\t<png_path>
'  Header lines (RAW: / SCRIPT: / # ...) are skipped.
' ══════════════════════════════════════════════════════════════════

EXPORT MODULE FFMPEG

EXPORT FUNC ComposeFromManifest$(manifest_path$, out_path$)
    DIM text$ = TXTREADER$(manifest_path$)
    DIM lines = SPLIT(text$, CHR$(10))

    DIM raw_path$ = ""
    ' Parallel arrays per kind so we know each entry's exact index
    ' in the final ffmpeg input list.
    DIM voice_offs = []
    DIM voice_paths = []
    DIM card_offs = []
    DIM card_durs = []
    DIM card_paths = []
    DIM avatar_path$ = ""
    DIM avatar_x$ = "0"
    DIM avatar_y$ = "0"

    DIM i AS INTEGER
    FOR i = 0 TO LEN(lines) - 1
        DIM ln$ = TRIM$(lines[i])
        IF LEN(ln$) = 0 THEN CONTINUEFOR
        IF STARTSWITH(ln$, "#") THEN CONTINUEFOR
        IF STARTSWITH(ln$, "RAW:") THEN
            raw_path$ = TRIM$(MID$(ln$, 5))
            CONTINUEFOR
        ENDIF
        IF STARTSWITH(ln$, "SCRIPT:") THEN CONTINUEFOR

        DIM parts = SPLIT(ln$, CHR$(9))
        IF LEN(parts) < 4 THEN CONTINUEFOR
        DIM kind$ = TRIM$(parts[0])
        IF kind$ = "VOICE" THEN
            PUSH voice_offs,  VAL(parts[1])
            PUSH voice_paths, TRIM$(parts[3])
        ELSEIF kind$ = "CARD" THEN
            PUSH card_offs,  VAL(parts[1])
            PUSH card_durs,  VAL(parts[2])
            PUSH card_paths, TRIM$(parts[3])
        ELSEIF kind$ = "AVATAR" THEN
            ' AVATAR <x> <y> <path>: a transparent clip over the picture
            avatar_x$ = TRIM$(parts[1])
            avatar_y$ = TRIM$(parts[2])
            avatar_path$ = TRIM$(parts[3])
        ENDIF
    NEXT i

    IF LEN(raw_path$) = 0 THEN
        PRINT "[FFMPEG] manifest is missing the RAW: line"
        RETURN ""
    ENDIF

    DIM nv AS INTEGER = LEN(voice_offs)
    DIM nc AS INTEGER = LEN(card_offs)
    PRINT "[FFMPEG] composing "; nv; " voice + "; nc; " card(s) onto "; raw_path$

    ' ── Build the input list ─────────────────────────────────────
    ' Index 0           : raw video
    ' Index 1..nc       : card PNGs
    ' Index nc+1..nc+nv : voice WAVs
    ' The arguments go to OS.EXEC as an array, so no shell sees the
    ' filter graph's | and ; characters.
    DIM ff_args$ = ["-y", "-loglevel", "warning", "-i", raw_path$]
    DIM k AS INTEGER
    FOR k = 0 TO nc - 1
        ' -loop 1 isn't needed here; a single image input is auto-extended
        ' to the [0:v] duration by ffmpeg when used through overlay.
        ff_args$ = APPEND(ff_args$, ["-i", card_paths[k]])
    NEXT k
    FOR k = 0 TO nv - 1
        ff_args$ = APPEND(ff_args$, ["-i", voice_paths[k]])
    NEXT k
    ' A VP9 alpha .webm needs the libvpx decoder to keep its alpha.
    IF LEN(avatar_path$) > 0 THEN
        ff_args$ = APPEND(ff_args$, ["-c:v", "libvpx-vp9", "-i", avatar_path$])
    ENDIF

    ' ── Build the complex filter graph ───────────────────────────
    DIM filter$ = ""
    DIM last_v$ = "[0:v]"   ' walks down the overlay chain

    ' The avatar goes on the picture first, so the cards cover it.
    IF LEN(avatar_path$) > 0 THEN
        filter$ = filter$ + last_v$ + "[" + STR$(nc + nv + 1) + ":v]overlay=x=" + avatar_x$ + ":y=" + avatar_y$ + ":eof_action=pass[vav];"
        last_v$ = "[vav]"
    ENDIF

    ' Card overlays — chain each on top of the previous video stage.
    FOR k = 0 TO nc - 1
        DIM idx$ = STR$(k + 1)
        DIM offs$ = STR$(card_offs[k] / 1000.0)
        DIM end$  = STR$((card_offs[k] + card_durs[k]) / 1000.0)
        ' between() takes seconds, fractional; rgba conversion so the
        ' card stays opaque on dark video without ghosting.
        filter$ = filter$ + "[" + idx$ + ":v]format=rgba[c" + STR$(k) + "];"
        DIM next_v$ = "[v" + STR$(k) + "]"
        filter$ = filter$ + last_v$ + "[c" + STR$(k) + "]overlay=x=0:y=0:enable='between(t," + offs$ + "," + end$ + ")'" + next_v$ + ";"
        last_v$ = next_v$
    NEXT k

    ' Voice mix — adelay each clip to its recorded offset, then amix.
    DIM voice_outs$ = ""
    FOR k = 0 TO nv - 1
        DIM v_in$ = "[" + STR$(nc + k + 1) + ":a]"
        DIM v_off$ = STR$(CINT(voice_offs[k]))
        filter$ = filter$ + v_in$ + "adelay=" + v_off$ + "|" + v_off$ + "[a" + STR$(k) + "];"
        voice_outs$ = voice_outs$ + "[a" + STR$(k) + "]"
    NEXT k

    DIM has_audio AS INTEGER = 0
    IF nv = 1 THEN
        filter$ = filter$ + "[a0]anull[aout]"
        has_audio = 1
    ELSEIF nv > 1 THEN
        filter$ = filter$ + voice_outs$ + "amix=inputs=" + STR$(nv) + ":normalize=0[aout]"
        has_audio = 1
    ENDIF

    ' ── Map + encode ─────────────────────────────────────────────
    ' If we added any overlay or filter, we have to re-encode video
    ' (no -c:v copy). Without filters we can stream-copy.
    DIM use_video_filter AS INTEGER = nc
    IF LEN(avatar_path$) > 0 THEN use_video_filter = 1
    IF LEN(filter$) > 0 THEN
        ' Trim trailing semicolon.
        IF RIGHT$(filter$, 1) = ";" THEN filter$ = LEFT$(filter$, LEN(filter$) - 1)
        ff_args$ = APPEND(ff_args$, ["-filter_complex", filter$])
    ENDIF

    IF use_video_filter > 0 THEN
        ff_args$ = APPEND(ff_args$, ["-map", last_v$, "-c:v", "libx264", "-preset", "veryfast", "-crf", "18"])
    ELSE
        ff_args$ = APPEND(ff_args$, ["-map", "0:v", "-c:v", "copy"])
    ENDIF

    IF has_audio = 1 THEN
        ff_args$ = APPEND(ff_args$, ["-map", "[aout]", "-c:a", "aac", "-b:a", "192k"])
    ELSE
        ff_args$ = APPEND(ff_args$, "-an")
    ENDIF

    ff_args$ = APPEND(ff_args$, out_path$)

    PRINT "[FFMPEG] ffmpeg " + JOIN(ff_args$, " ")
    DIM r = OS.EXEC("ffmpeg", ff_args$)
    IF r{"EXIT_CODE"} <> 0 THEN
        PRINT "[FFMPEG] FAIL ("; r{"EXIT_CODE"}; "):"
        PRINT r{"OUTPUT"}
        RETURN ""
    ENDIF
    PRINT "[FFMPEG] composed → " + out_path$
    RETURN out_path$
ENDFUNC
