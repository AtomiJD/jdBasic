' ══════════════════════════════════════════════════════════════════
'  compose.jdb — post-production runner.
'  Edit MANIFEST$ + OUT$ below (or call FFMPEG.ComposeFromManifest$()
'  from the REPL) to layer the TTS voice clips onto the raw OBS
'  recording.
' ══════════════════════════════════════════════════════════════════

IMPORT FFMPEG

CD "\usr\dev\cc\jdb\tv"

DIM MANIFEST$ = "raw\script_01_hello.manifest.txt"
DIM OUT$      = "final\script_01_hello.mp4"

DIM result$ = FFMPEG.ComposeFromManifest$(MANIFEST$, OUT$)
IF LEN(result$) > 0 THEN
    PRINT "Done: " + result$
ELSE
    PRINT "Compose failed — check messages above."
ENDIF
