' Phase 3 — Image-Convolution: native vs ONNX.
'
' 3x3 Box-Blur und 3x3 Edge-Detection auf einem H x W Grayscale-Bild.
' Native: dreifach geschachtelte Loop in jdBasic, O(H*W*9).
' ONNX:   Eine Conv-Op (oneDNN/AVX intern) ueber das gleiche Bild.
'
' Kernel kommt als Input ins ONNX-Modell, also ein Modell fuer
' beliebige 3x3 Filter. Bild-Groesse ist dynamic (H, W symbolisch).
'
' Setup: python3 jdb/bench/gen_conv_onnx.py

OPTION "EXPLICIT"

CONST H = 256
CONST W = 256

' Generate a test image — radial gradient so we can see the filter
' actually doing something visible if printed.
FUNC MAKE_IMAGE(h, w)
    LET img = []
    DIM i AS INTEGER
    DIM j AS INTEGER
    FOR i = 0 TO h - 1
        DIM row = []
        FOR j = 0 TO w - 1
            LET dx = j - w / 2
            LET dy = i - h / 2
            PUSH row, SQR(dx * dx + dy * dy)
        NEXT j
        PUSH img, row
    NEXT i
    RETURN img
ENDFUNC

' Native 3x3 conv with same-padding (zero outside).
FUNC NATIVE_CONV3(img, kernel)
    LET h = LEN(img)
    LET w = LEN(img[0])
    LET out = []
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM ki AS INTEGER
    DIM kj AS INTEGER
    FOR i = 0 TO h - 1
        DIM row = []
        FOR j = 0 TO w - 1
            DIM acc AS DOUBLE = 0
            FOR ki = -1 TO 1
                FOR kj = -1 TO 1
                    LET ii = i + ki
                    LET jj = j + kj
                    IF ii >= 0 AND ii < h AND jj >= 0 AND jj < w THEN
                        acc = acc + img[ii][jj] * kernel[ki + 1][kj + 1]
                    ENDIF
                NEXT kj
            NEXT ki
            PUSH row, acc
        NEXT j
        PUSH out, row
    NEXT i
    RETURN out
ENDFUNC

' ── Setup ───────────────────────────────────────────────────────
PRINT "Building "; H; "x"; W; " test image..."
LET img = MAKE_IMAGE(H, W)
PRINT "image[H/2][W/2] = "; img[H/2][W/2]   ' should be 0 (centre of gradient)
PRINT "image[0][0]     = "; img[0][0]

' Filters
LET box = [[1.0/9.0, 1.0/9.0, 1.0/9.0], _
           [1.0/9.0, 1.0/9.0, 1.0/9.0], _
           [1.0/9.0, 1.0/9.0, 1.0/9.0]]
LET edge = [[-1.0, -1.0, -1.0], _
            [-1.0,  8.0, -1.0], _
            [-1.0, -1.0, -1.0]]

' ── Sanity: tiny native + ONNX, compare values ────────────────
DIM mid = AI.LOAD("jdb/bench/conv3x3.onnx")
PRINT "model id="; mid

' ONNX expects [1, 1, H, W] — wrap the image in two extra dims, same for kernel.
LET x_in = [[img]]
LET w_in = [[box]]
LET y_onnx = AI.RUN(mid, [x_in, w_in])
PRINT "ONNX output rank: outer="; LEN(y_onnx); " inner="; LEN(y_onnx[0])
LET ny_onnx = y_onnx[0][0]
PRINT "ONNX [H/2][W/2] = "; ny_onnx[H/2][W/2]

LET y_nat = NATIVE_CONV3(img, box)
PRINT "native [H/2][W/2] = "; y_nat[H/2][W/2]

' ── Bench ──────────────────────────────────────────────────────
PRINT
PRINT "── Bench (single 3x3 conv on "; H; "x"; W; " image) ──"
PRINT "  filter         native[ms]      ONNX[ms]      speedup"

LET t0 = TICK() : LET nb = NATIVE_CONV3(img, box) : LET tnb = TICK() - t0
LET t1 = TICK() : LET ob = AI.RUN(mid, [x_in, [[box]]]) : LET tob = TICK() - t1
PRINT "  box-blur     ", tnb, tob, tnb / tob

LET t2 = TICK() : LET ne = NATIVE_CONV3(img, edge) : LET tne = TICK() - t2
LET t3 = TICK() : LET oe = AI.RUN(mid, [x_in, [[edge]]]) : LET toe = TICK() - t3
PRINT "  edge-detect  ", tne, toe, tne / toe

PRINT
PRINT "── Bigger image: 512x512 ──"
LET img2 = MAKE_IMAGE(512, 512)
LET x2 = [[img2]]
LET t4 = TICK() : LET nb2 = NATIVE_CONV3(img2, box) : LET tnb2 = TICK() - t4
LET t5 = TICK() : LET ob2 = AI.RUN(mid, [x2, [[box]]]) : LET tob2 = TICK() - t5
PRINT "  box-blur 512 ", tnb2, tob2, tnb2 / tob2
