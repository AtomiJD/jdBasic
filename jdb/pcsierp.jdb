' Sierpinski triangle - FIR Filter Convolution
XMAX = 640 : YMAX = 350 : BORDER = 10 : N = 60000

SCREEN XMAX, YMAX, "Sierpinski triangle", 1
CLS
PRINT "Sierpinski triangle"

INDICES = INT(RND(IOTA(N)) * 3)
IDX_SQ = INDICES * INDICES

CX_TARGETS = -465 * IDX_SQ + 775 * INDICES + 320
CY_TARGETS = -165 * IDX_SQ + 495 * INDICES + 10

KERNEL_1D = 0.5 ^ IOTA(55, 55, -1)

KERNEL = RESHAPE(KERNEL_1D, [55, 1])
CX_2D = RESHAPE(CX_TARGETS, [N, 1])
CY_2D = RESHAPE(CY_TARGETS, [N, 1])

PX_RAW = CONVOLVE(CX_2D, KERNEL, FALSE)
PY_RAW = CONVOLVE(CY_2D, KERNEL, FALSE)

PX_ALL = SHIFT(PX_RAW, [27, 0], 0)
PY_ALL = SHIFT(PY_RAW, [27, 0], 0)

PX_TRIM = DROP(55, RESHAPE(PX_ALL, [N]))
PY_TRIM = DROP(55, RESHAPE(PY_ALL, [N]))

PTS = STACK(1, PX_TRIM, PY_TRIM)

DELAY_IDX = SHIFT(INDICES + 1, [3], 0)
D_SQ = DELAY_IDX * DELAY_IDX
D_CB = D_SQ * DELAY_IDX

R_ALL = CLAMP(DELAY_IDX * 255, 0, 255)
G_ALL = -42.5 * D_CB + 170 * D_SQ - 42.5 * DELAY_IDX
B_ALL = 127.5 * D_CB - 595 * D_SQ + 722.5 * DELAY_IDX

R_TRIM = DROP(55, R_ALL)
G_TRIM = DROP(55, G_ALL)
B_TRIM = DROP(55, B_ALL)

COLRS = STACK(1, R_TRIM, G_TRIM, B_TRIM)

PSET PTS, COLRS
SCREENFLIP

PRINT "Drawing completed"
WAITKEY$