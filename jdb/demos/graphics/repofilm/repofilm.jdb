' repofilm - the history of a git repository as an animated galaxy.
'
' Every file is a body orbiting its directory, placed by phyllotaxis so the
' layout is stable across runs. A commit lights up the files it touched.
'
'   jdBasic repofilm.jdb [repo_path] [--frames dir] [--speed days_per_sec]
'                        [--size WxH] [--4k] [--fullscreen] [--wav file]
'
' With --frames the clock is fixed at 30 fps and every frame is written as a
' PNG, ready for ffmpeg. Without it the film plays in real time.
'
' --wav writes the soundtrack instead of drawing anything: one plucked note
' per commit, on the same clock the film runs on.

DIM SCR_W = 1280
DIM SCR_H = 720
DIM CX = 640
DIM CY = 352
DIM SC = 1.0
CONST GOLDEN = 2.39996323
CONST FRAME_DT = 0.0333333
CONST HOLD_TITLE = 2.5
CONST HOLD_END = 6.0
CONST FINALE_RAMP = 2.5
CONST SPARK_LIFE = 0.55
CONST HEAT_HALF = 1.3
CONST N_SPARK = 800

'=============================================================================
' helpers
'=============================================================================

FUNC PAD2$(v)
    IF v < 10 THEN RETURN "0" + STR$(INT(v))
    RETURN STR$(INT(v))
ENDFUNC

FUNC PAD5$(v)
    DIM s$ = STR$(INT(v))
    DO WHILE LEN(s$) < 5
        s$ = "0" + s$
    LOOP
    RETURN s$
ENDFUNC

' Civil date from a unix timestamp, days-from-epoch algorithm.
FUNC DATESTR$(t)
    DIM z = INT(t / 86400) + 719468
    DIM era = INT(z / 146097)
    DIM doe = z - era * 146097
    DIM yoe = INT((doe - INT(doe / 1460) + INT(doe / 36524) - INT(doe / 146096)) / 365)
    DIM yy = yoe + era * 400
    DIM doy = doe - (365 * yoe + INT(yoe / 4) - INT(yoe / 100))
    DIM mp = INT((5 * doy + 2) / 153)
    DIM dd = doy - INT((153 * mp + 2) / 5) + 1
    DIM mm = mp + 3
    IF mm > 12 THEN
        mm = mm - 12
        yy = yy + 1
    ENDIF
    RETURN STR$(INT(yy)) + "-" + PAD2$(mm) + "-" + PAD2$(dd)
ENDFUNC

FUNC EXTOF$(p$)
    DIM cut = -1
    DIM i = LEN(p$) - 1
    DO WHILE i >= 0
        DIM ch$ = MID$(p$, i, 1)
        IF ch$ = "/" THEN
            i = -1
        ELSE
            IF ch$ = "." ANDALSO cut < 0 THEN
                cut = i
                i = -1
            ELSE
                i = i - 1
            ENDIF
        ENDIF
    LOOP
    IF cut < 0 THEN RETURN ""
    RETURN LCASE$(MID$(p$, cut + 1))
ENDFUNC

' Colour families: the language, the runtime, the docs, the data, the web.
FUNC EXTCOL(e$)
    IF e$ = "jdb" THEN RETURN [90, 245, 130]
    IF e$ = "cpp" ORELSE e$ = "h" ORELSE e$ = "hpp" ORELSE e$ = "c" THEN RETURN [95, 165, 255]
    IF e$ = "md" ORELSE e$ = "txt" THEN RETURN [155, 155, 170]
    IF e$ = "json" ORELSE e$ = "xml" ORELSE e$ = "yml" ORELSE e$ = "cfg" THEN RETURN [255, 175, 65]
    IF e$ = "html" ORELSE e$ = "css" ORELSE e$ = "js" THEN RETURN [200, 115, 255]
    IF e$ = "png" ORELSE e$ = "jpg" ORELSE e$ = "wav" ORELSE e$ = "ttf" ORELSE e$ = "ico" THEN RETURN [255, 95, 145]
    IF e$ = "bat" ORELSE e$ = "sh" ORELSE e$ = "ps1" THEN RETURN [230, 220, 120]
    RETURN [110, 115, 130]
ENDFUNC

' The HUD font is monospace, so a character is worth a fixed nine pixels.
SUB CENTERTEXT(y, s$, r, g, b)
    TEXT CX - INT(LEN(s$) * 4.5 * SC), y, s$, r, g, b
ENDSUB

FUNC CLUSTER(dep)
    IF dep = 0 THEN RETURN 305 * SC
    IF dep = 1 THEN RETURN 108 * SC
    IF dep = 2 THEN RETURN 52 * SC
    IF dep = 3 THEN RETURN 28 * SC
    RETURN 16 * SC
ENDFUNC

FUNC LE16$(v)
    RETURN CHR$(v MOD 256) + CHR$(INT(v / 256) MOD 256)
ENDFUNC

FUNC LE32$(v)
    RETURN LE16$(v MOD 65536) + LE16$(INT(v / 65536) MOD 65536)
ENDFUNC

FUNC CUT$(s$, n)
    IF LEN(s$) <= n THEN RETURN s$
    RETURN LEFT$(s$, n - 1) + "~"
ENDFUNC

' Rename entries arrive as "old => new" or "dir/{old => new}/file".
FUNC UNRENAME$(p$)
    DIM pos = INSTR(p$, " => ")
    IF pos < 0 THEN RETURN p$
    DIM head$ = LEFT$(p$, pos)
    DIM tail$ = MID$(p$, pos + 4)
    DIM brace = INSTR(tail$, "}")
    IF brace >= 0 THEN
        tail$ = LEFT$(tail$, brace) + MID$(tail$, brace + 1)
    ENDIF
    DIM opn = INSTR(head$, "{")
    IF opn >= 0 THEN RETURN LEFT$(head$, opn) + tail$
    RETURN tail$
ENDFUNC

'=============================================================================
' arguments
'=============================================================================

DIM argv$ = OS.ARGS()
DIM repo$ = "."
DIM framedir$ = ""
DIM frames_on = 0
DIM speed = 1.35
DIM ai = 1
DIM arg$ = ""
DIM wav$ = ""
DIM want_fs = 0
DIM xpos = 0

DO WHILE ai < LEN(argv$)
    arg$ = argv$[ai]
    IF arg$ = "--4k" THEN
        SCR_W = 3840
        SCR_H = 2160
    ELSEIF arg$ = "--fullscreen" THEN
        want_fs = 1
    ELSEIF arg$ = "--size" THEN
        ai = ai + 1
        xpos = INSTR(argv$[ai], "x")
        SCR_W = VAL(LEFT$(argv$[ai], xpos))
        SCR_H = VAL(MID$(argv$[ai], xpos + 1))
    ELSEIF arg$ = "--wav" THEN
        ai = ai + 1
        wav$ = argv$[ai]
    ELSEIF arg$ = "--speed" THEN
        ai = ai + 1
        speed = VAL(argv$[ai])
    ELSEIF arg$ = "--frames" THEN
        frames_on = 1
        framedir$ = "tmp/frames"
        IF ai + 1 < LEN(argv$) THEN
            IF LEFT$(argv$[ai + 1], 2) <> "--" THEN
                ai = ai + 1
                framedir$ = argv$[ai]
            ENDIF
        ENDIF
    ELSE
        repo$ = arg$
    ENDIF
    ai = ai + 1
LOOP

SC = SCR_W / 1280.0
CX = INT(SCR_W / 2)
CY = INT(SCR_H * 0.489)

'=============================================================================
' history
'=============================================================================

PRINT "reading history of "; repo$
DIM git$ = "git -C " + CHR$(34) + repo$ + CHR$(34) + " log --reverse --pretty=format:%x01%at%x09%s --numstat"
DIM res = OS.EXEC(git$)
IF res{"EXIT_CODE"} <> 0 THEN
    PRINT "git failed: "; res{"OUTPUT"}
    END
ENDIF

DIM rows$ = SPLIT(res{"OUTPUT"}, CHR$(10))
DIM n_rows = LEN(rows$)
DIM TAB$ = CHR$(9)
DIM MARK$ = CHR$(1)

DIM row$ = ""
DIM cells$ = [""]
DIM i = 0
DIM n_com = 0
DIM n_ev = 0

FOR i = 0 TO n_rows - 1
    row$ = rows$[i]
    IF LEN(row$) > 1 THEN
        IF LEFT$(row$, 1) = MARK$ THEN
            n_com = n_com + 1
        ELSE
            cells$ = SPLIT(row$, TAB$)
            IF LEN(cells$) = 3 THEN n_ev = n_ev + 1
        ENDIF
    ENDIF
NEXT i

IF n_com = 0 THEN
    PRINT "no commits found"
    END
ENDIF

PRINT "commits: "; n_com; "  file touches: "; n_ev

DIM ctime[n_com]
DIM csubj$[n_com]
DIM cev0[n_com]
DIM cevn[n_com]
DIM evf[n_ev]
DIM evl[n_ev]
DIM pname$[n_ev]
DIM pidx AS MAP

DIM ci = -1
DIM ei = 0
DIM n_path = 0
DIM pth$ = ""
DIM slot = 0

FOR i = 0 TO n_rows - 1
    row$ = rows$[i]
    IF LEN(row$) > 1 THEN
        IF RIGHT$(row$, 1) = CHR$(13) THEN row$ = LEFT$(row$, LEN(row$) - 1)
    ENDIF
    IF LEN(row$) > 1 THEN
        IF LEFT$(row$, 1) = MARK$ THEN
            cells$ = SPLIT(MID$(row$, 1), TAB$)
            ci = ci + 1
            ctime[ci] = VAL(cells$[0])
            IF LEN(cells$) > 1 THEN
                csubj$[ci] = cells$[1]
            ELSE
                csubj$[ci] = ""
            ENDIF
            cev0[ci] = ei
            cevn[ci] = 0
        ELSE
            cells$ = SPLIT(row$, TAB$)
            IF LEN(cells$) = 3 ANDALSO ci >= 0 THEN
                pth$ = UNRENAME$(cells$[2])
                IF MAP.EXISTS(pidx, pth$) THEN
                    slot = pidx{pth$}
                ELSE
                    slot = n_path
                    pidx{pth$} = slot
                    pname$[slot] = pth$
                    n_path = n_path + 1
                ENDIF
                evf[ei] = slot
                IF cells$[0] = "-" THEN
                    evl[ei] = 12
                ELSE
                    evl[ei] = VAL(cells$[0])
                ENDIF
                cevn[ci] = cevn[ci] + 1
                ei = ei + 1
            ENDIF
        ENDIF
    ENDIF
NEXT i

PRINT "files ever touched: "; n_path

'=============================================================================
' the tree, and a fixed place for every body in it
'=============================================================================

DIM dpar[n_path + 1]
DIM ddep[n_path + 1]
DIM dnch[n_path + 1]
DIM dfill[n_path + 1]
DIM dsprd[n_path + 1]
DIM dx[n_path + 1]
DIM dy[n_path + 1]
DIM dalive[n_path + 1]
DIM didx AS MAP
DIM n_dir = 0

DIM pdir[n_path]
DIM px[n_path]
DIM py[n_path]
DIM pcr[n_path]
DIM pcg[n_path]
DIM pcb[n_path]
DIM prad[n_path]
DIM pheat[n_path]
DIM psize[n_path]
DIM pborn[n_path]
DIM blist[n_path]

DIM comps$ = [""]
DIM prefix$ = ""
DIM cur = 0
DIM k = 0
DIM c = 0
DIM col = [0, 0, 0]

FOR k = 0 TO n_path - 1
    comps$ = SPLIT(pname$[k], "/")
    cur = 0
    prefix$ = ""
    FOR c = 0 TO LEN(comps$) - 2
        prefix$ = prefix$ + comps$[c] + "/"
        IF MAP.EXISTS(didx, prefix$) THEN
            cur = didx{prefix$}
        ELSE
            n_dir = n_dir + 1
            didx{prefix$} = n_dir
            dpar[n_dir] = cur
            ddep[n_dir] = ddep[cur] + 1
            cur = n_dir
        ENDIF
    NEXT c
    pdir[k] = cur
    col = EXTCOL(EXTOF$(pname$[k]))
    pcr[k] = col[0]
    pcg[k] = col[1]
    pcb[k] = col[2]
    pborn[k] = -1
    prad[k] = 1.2
NEXT k

PRINT "directories: "; n_dir

DIM d = 0
FOR d = 1 TO n_dir
    dnch[dpar[d]] = dnch[dpar[d]] + 1
NEXT d
FOR k = 0 TO n_path - 1
    dnch[pdir[k]] = dnch[pdir[k]] + 1
NEXT k
FOR d = 0 TO n_dir
    dsprd[d] = CLUSTER(ddep[d]) / SQR(dnch[d] + 1)
NEXT d

DIM ang = 0.0
DIM rad = 0.0
DIM par = 0

FOR d = 1 TO n_dir
    par = dpar[d]
    slot = dfill[par]
    dfill[par] = slot + 1
    ang = slot * GOLDEN
    rad = dsprd[par] * SQR(slot + 1)
    dx[d] = dx[par] + rad * COS(ang)
    dy[d] = dy[par] + rad * SIN(ang)
NEXT d

FOR k = 0 TO n_path - 1
    d = pdir[k]
    slot = dfill[d]
    dfill[d] = slot + 1
    ang = slot * GOLDEN
    rad = dsprd[d] * SQR(slot + 1)
    px[k] = CX + dx[d] + rad * COS(ang)
    py[k] = CY + dy[d] + rad * SIN(ang)
NEXT k

' A tree hangs where its big directories happen to fall, which is rarely the
' middle of the canvas. Measure what was built and move it into frame.
DIM minx = px[0]
DIM maxx = px[0]
DIM miny = py[0]
DIM maxy = py[0]
FOR k = 1 TO n_path - 1
    IF px[k] < minx THEN minx = px[k]
    IF px[k] > maxx THEN maxx = px[k]
    IF py[k] < miny THEN miny = py[k]
    IF py[k] > maxy THEN maxy = py[k]
NEXT k

DIM ccx = (minx + maxx) / 2
DIM ccy = (miny + maxy) / 2
DIM halfw = (maxx - minx) / 2
DIM halfh = (maxy - miny) / 2
DIM fit = 1.0
IF halfw > 1 ANDALSO halfh > 1 THEN
    fit = SCR_W * 0.40 / halfw
    IF SCR_H * 0.40 / halfh < fit THEN fit = SCR_H * 0.40 / halfh
ENDIF

FOR k = 0 TO n_path - 1
    px[k] = CX + (px[k] - ccx) * fit
    py[k] = CY + (py[k] - ccy) * fit
NEXT k
FOR d = 0 TO n_dir
    dx[d] = (CX + dx[d] - ccx) * fit
    dy[d] = (CY + dy[d] - ccy) * fit
NEXT d

'=============================================================================
' the soundtrack
'
' A commit is one plucked note. The directory it touched picks the degree of a
' minor pentatonic, so a stretch of work in one corner of the tree becomes a
' recognisable pitch, and the size of the commit picks the octave: the big ones
' land low. Notes are mixed on a grid of BLK samples, one matrix row per step,
' because a row is a single vector add where a sample loop would be a million.
'=============================================================================

CONST RATE = 44100
CONST BLK = 2756
CONST NOTE_BLK = 12
CONST N_PITCH = 15

DIM t_first = ctime[0]
DIM t_last = ctime[n_com - 1]
DIM t_zero = t_first - 3600

IF wav$ <> "" THEN
    PRINT "writing soundtrack to "; wav$

    DIM dtop[n_path + 1]
    FOR d = 1 TO n_dir
        IF ddep[d] = 1 THEN
            dtop[d] = d
        ELSE
            dtop[d] = dtop[dpar[d]]
        ENDIF
    NEXT d

    DIM total_s = HOLD_TITLE + (t_last - t_zero) / (speed * 86400.0) + HOLD_END
    DIM n_blk = INT(total_s * RATE / BLK) + NOTE_BLK + 2
    DIM mix = ZEROS([n_blk, BLK])
    PRINT "length: "; INT(total_s); " s"

    DIM PENTA = [0, 3, 5, 7, 10]
    DIM tt = IOTA(BLK * NOTE_BLK, 0) / RATE
    DIM tmax = BLK * NOTE_BLK / RATE
    DIM notes[N_PITCH, NOTE_BLK, BLK]
    DIM wv = tt
    DIM semi = 0
    DIM freq = 0.0
    DIM p = 0

    FOR p = 0 TO N_PITCH - 1
        semi = PENTA[p MOD 5] + 12 * INT(p / 5)
        freq = 110.0 * 2 ^ (semi / 12.0)
        wv = SIN(tt * (2 * PI * freq)) + 0.34 * SIN(tt * (4 * PI * freq)) + 0.11 * SIN(tt * (6 * PI * freq))
        ' The tail has to reach exactly zero: a note that is merely quiet when
        ' the block runs out ends in a step, and a step is a click.
        wv = wv * EXP(0 - tt * 5.0) * (1 - EXP(0 - tt * 320)) * (1 - tt / tmax)
        notes[p] = RESHAPE(wv, [NOTE_BLK, BLK])
    NEXT p

    DIM dfreq = 3 * RATE / BLK
    DIM dtt = IOTA(BLK, 0) / RATE
    DIM drone = SIN(dtt * (2 * PI * dfreq)) * 0.6 + SIN(dtt * (4 * PI * dfreq)) * 0.22

    DIM ftime = 0.0
    DIM blkpos = 0
    DIM sz = 0
    DIM amp = 0.0
    DIM oct = 0
    DIM topd = 0
    DIM j = 0

    FOR ci = 0 TO n_com - 1
        IF cevn[ci] > 0 THEN
            ftime = HOLD_TITLE + (ctime[ci] - t_zero) / (speed * 86400.0)
            blkpos = INT(ftime * RATE / BLK)
            sz = 0
            FOR ev = cev0[ci] TO cev0[ci] + cevn[ci] - 1
                sz = sz + evl[ev]
            NEXT ev
            topd = dtop[pdir[evf[cev0[ci]]]]
            IF sz < 25 THEN
                oct = 2
            ELSEIF sz < 250 THEN
                oct = 1
            ELSE
                oct = 0
            ENDIF
            p = (topd MOD 5) + 5 * oct
            amp = 0.05 + 0.20 * LOG(1 + sz) / LOG(3000)
            IF amp > 0.26 THEN amp = 0.26
            FOR j = 0 TO NOTE_BLK - 1
                IF blkpos + j < n_blk THEN
                    mix[blkpos + j] = mix[blkpos + j] + notes[p][j] * amp
                ENDIF
            NEXT j
        ENDIF
    NEXT ci

    DIM peak = 0.0
    DIM rowpeak = 0.0
    FOR c = 0 TO n_blk - 1
        mix[c] = mix[c] + drone * (0.012 + 0.045 * c / n_blk)
        rowpeak = MAX(ABS(mix[c]))
        IF rowpeak > peak THEN peak = rowpeak
    NEXT c
    DIM gain = 0.92 / peak

    ' WAV.WRITE needs the FX build flag. Where it is missing the file is
    ' written by hand, which is the same bytes for four seconds more work.
    DIM native_wav = 0
    TRY
        native_wav = WAV.WRITE(wav$, RESHAPE(mix, [n_blk * BLK]) * gain, RATE, 1)
    CATCH
        native_wav = 0
    ENDTRY

    IF native_wav <> 0 THEN
        PRINT "wrote "; wav$; " via WAV.WRITE"
        END
    ENDIF

    DIM tbl$[256]
    FOR i = 0 TO 255
        tbl$[i] = CHR$(i)
    NEXT i

    DIM parts$[n_blk]
    DIM chunk$ = ""
    DIM smp = drone
    DIM iv = 0
    FOR c = 0 TO n_blk - 1
        smp = mix[c] * gain
        chunk$ = ""
        FOR j = 0 TO BLK - 1
            iv = INT(smp[j] * 32000)
            IF iv < 0 THEN iv = iv + 65536
            chunk$ = chunk$ + tbl$[iv MOD 256] + tbl$[INT(iv / 256) MOD 256]
        NEXT j
        parts$[c] = chunk$
        IF c MOD 300 = 0 THEN PRINT "block "; c; " / "; n_blk
    NEXT c

    DIM datalen = n_blk * BLK * 2
    DIM hdr$ = "RIFF" + LE32$(36 + datalen) + "WAVEfmt " + LE32$(16) + LE16$(1) + LE16$(1)
    hdr$ = hdr$ + LE32$(RATE) + LE32$(RATE * 2) + LE16$(2) + LE16$(16) + "data" + LE32$(datalen)
    BINWRITER wav$, hdr$ + JOIN(parts$, "")
    PRINT "wrote "; wav$; "  "; INT(datalen / 1024); " KB of audio"
    END
ENDIF

'=============================================================================
' the film
'=============================================================================

DIM toproot = OS.EXEC("git -C " + CHR$(34) + repo$ + CHR$(34) + " rev-parse --show-toplevel")
DIM reponame$ = SPLIT(toproot{"OUTPUT"}, CHR$(10))[0]
DIM cutpos = 0
DO WHILE INSTR(reponame$, "/") >= 0
    cutpos = INSTR(reponame$, "/")
    reponame$ = MID$(reponame$, cutpos + 1)
LOOP
IF RIGHT$(reponame$, 1) = CHR$(13) THEN reponame$ = LEFT$(reponame$, LEN(reponame$) - 1)
IF reponame$ = "" THEN reponame$ = "repository"

SCREEN SCR_W, SCR_H, "repofilm - " + reponame$
SETFONT "fonts/JetBrainsMono-Regular.ttf", INT(15 * SC)
IF want_fs = 1 THEN TOGGLE_FULLSCREEN

DIM now_t = t_zero
DIM ci_next = 0
DIM n_born = 0
DIM total_add = 0
DIM subj$ = ""
DIM film_t = 0.0
DIM dt = 0.0
DIM last_ms = TICK()
DIM ms = 0
DIM n_frame = 0
DIM running = 1
DIM key$ = ""

DIM sp_f[N_SPARK]
DIM sp_t[N_SPARK]
DIM sp_i = 0
DIM s = 0
DIM b = 0
DIM w = 0
DIM heatk = 0.0
DIM shade = 0.0
DIM heat = 0.0
DIM lum = 0.0
DIM finale = 0.0
DIM age = 0.0
DIM fade = 0.0
DIM ev = 0
DIM anc = 0
DIM done_t = 0.0
DIM barw = 0
DIM legend$ = ["jdb", "cpp/h", "json", "web", "docs", "assets"]
DIM legcol = [0, 0, 0]
DIM lx = 0

PRINT "rolling..."

DO WHILE running = 1
    IF frames_on = 1 THEN
        dt = FRAME_DT
    ELSE
        ms = TICK()
        dt = (ms - last_ms) / 1000.0
        last_ms = ms
        IF dt > 0.25 THEN dt = 0.25
    ENDIF
    film_t = film_t + dt

    CLS

    IF film_t < HOLD_TITLE THEN
        CENTERTEXT CY - INT(46 * SC), "a repository, from the first commit", 120, 200, 255
        CENTERTEXT CY - INT(12 * SC), reponame$, 255, 255, 255
        CENTERTEXT CY + INT(26 * SC), DATESTR$(t_first) + "  to  " + DATESTR$(t_last), 150, 150, 165
        CENTERTEXT CY + INT(50 * SC), STR$(n_com) + " commits, " + STR$(n_path) + " files", 150, 150, 165
    ELSE
        IF ci_next < n_com THEN now_t = now_t + dt * speed * 86400.0

        DO WHILE ci_next < n_com ANDALSO ctime[ci_next] <= now_t
            subj$ = csubj$[ci_next]
            FOR ev = cev0[ci_next] TO cev0[ci_next] + cevn[ci_next] - 1
                k = evf[ev]
                IF pborn[k] < 0 THEN
                    pborn[k] = film_t
                    blist[n_born] = k
                    n_born = n_born + 1
                    anc = pdir[k]
                    DO WHILE anc > 0 ANDALSO dalive[anc] = 0
                        dalive[anc] = 1
                        anc = dpar[anc]
                    LOOP
                ENDIF
                psize[k] = psize[k] + evl[ev]
                total_add = total_add + evl[ev]
                prad[k] = (1.2 + 1.35 * LOG(1 + psize[k] / 55.0)) * SC
                IF prad[k] > 6.5 * SC THEN prad[k] = 6.5 * SC
                pheat[k] = 1.0
                sp_f[sp_i] = k
                sp_t[sp_i] = film_t
                sp_i = (sp_i + 1) MOD N_SPARK
            NEXT ev
            ci_next = ci_next + 1
        LOOP

        heatk = 0.5 ^ (dt / HEAT_HALF)
        pheat = pheat * heatk

        IF ci_next >= n_com THEN
            IF done_t = 0 THEN done_t = film_t
            finale = (film_t - done_t) / FINALE_RAMP
            IF finale > 1.0 THEN finale = 1.0
        ENDIF

        FOR d = 1 TO n_dir
            IF dalive[d] = 1 THEN
                par = dpar[d]
                DRAWCOLOR 24, 30, 42
                LINE INT(CX + dx[d]), INT(CY + dy[d]), INT(CX + dx[par]), INT(CY + dy[par])
            ENDIF
        NEXT d

        FOR s = 0 TO N_SPARK - 1
            IF sp_t[s] > 0 THEN
                age = film_t - sp_t[s]
                IF age < SPARK_LIFE THEN
                    k = sp_f[s]
                    d = pdir[k]
                    fade = 1.0 - age / SPARK_LIFE
                    fade = fade * fade
                    DRAWCOLOR INT(40 + 190 * fade), INT(50 + 175 * fade), INT(70 + 150 * fade)
                    ' A beam is one pixel wide whatever the canvas, so on a big
                    ' one it is redrawn a few times side by side to stay visible.
                    FOR w = 0 TO INT(SC) - 1
                        LINE INT(CX + dx[d]) + w, INT(CY + dy[d]), INT(px[k]) + w, INT(py[k])
                    NEXT w
                ELSE
                    sp_t[s] = 0
                ENDIF
            ENDIF
        NEXT s

        FOR b = 0 TO n_born - 1
            k = blist[b]
            heat = pheat[k]
            lum = heat
            IF finale > lum THEN lum = finale
            shade = 0.32 + 0.68 * lum
            CIRCLE INT(px[k]), INT(py[k]), prad[k] + heat * 2.4 * SC, 1, INT(pcr[k] * shade), INT(pcg[k] * shade), INT(pcb[k] * shade)
            IF heat > 0.62 THEN
                CIRCLE INT(px[k]), INT(py[k]), prad[k] + (3.5 + heat * 2.5) * SC, 0, INT(pcr[k] * 0.62 * heat), INT(pcg[k] * 0.62 * heat), INT(pcb[k] * 0.62 * heat)
            ENDIF
        NEXT b

        TEXT INT(24 * SC), INT(24 * SC), DATESTR$(now_t), 255, 255, 255
        TEXT INT(24 * SC), INT(46 * SC), "commit " + STR$(ci_next) + " / " + STR$(n_com), 120, 200, 255
        IF finale > 0.35 THEN
            CENTERTEXT SCR_H - INT(58 * SC), reponame$ + "   " + STR$(n_com) + " commits   " + STR$(n_born) + " files   " + STR$(INT(total_add / 1000)) + "k lines", 190, 195, 210
        ELSE
            TEXT INT(24 * SC), SCR_H - INT(58 * SC), CUT$(subj$, 92), 190, 195, 210
        ENDIF
        TEXT SCR_W - INT(300 * SC), INT(24 * SC), "files  " + STR$(n_born), 150, 155, 170
        TEXT SCR_W - INT(300 * SC), INT(46 * SC), "lines  " + STR$(INT(total_add / 1000)) + "k added", 150, 155, 170

        FOR lx = 0 TO 5
            IF lx = 0 THEN legcol = EXTCOL("jdb")
            IF lx = 1 THEN legcol = EXTCOL("cpp")
            IF lx = 2 THEN legcol = EXTCOL("json")
            IF lx = 3 THEN legcol = EXTCOL("html")
            IF lx = 4 THEN legcol = EXTCOL("md")
            IF lx = 5 THEN legcol = EXTCOL("png")
            CIRCLE SCR_W - INT(292 * SC), SCR_H - INT((150 - lx * 20) * SC), 4 * SC, 1, legcol[0], legcol[1], legcol[2]
            TEXT SCR_W - INT(278 * SC), SCR_H - INT((157 - lx * 20) * SC), legend$[lx], 130, 135, 150
        NEXT lx

        barw = INT(SCR_W * ci_next / n_com)
        RECT 0, SCR_H - INT(4 * SC), SCR_W, INT(4 * SC), 1, 22, 26, 36
        RECT 0, SCR_H - INT(4 * SC), barw, INT(4 * SC), 1, 80, 200, 255

        IF ci_next >= n_com THEN
            IF done_t = 0 THEN done_t = film_t
            IF film_t - done_t > HOLD_END THEN running = 0
        ENDIF
    ENDIF

    IF frames_on = 1 THEN
        GFX.SAVE_SCREENSHOT(framedir$ + "/f" + PAD5$(n_frame) + ".png")
        n_frame = n_frame + 1
        IF n_frame MOD 60 = 0 THEN PRINT "frame "; n_frame; "  "; DATESTR$(now_t)
    ENDIF

    SCREENFLIP

    key$ = INKEY$()
    IF key$ = CHR$(27) ORELSE key$ = "q" THEN running = 0
LOOP

PRINT "done. frames written: "; n_frame
