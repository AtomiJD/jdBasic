' ============================================================
' One-line array art - each visual below is ONE line of jdBasic.
' They lean on whole-array ops: IOTA, RESHAPE, vectorised SIN,
' scatter-assignment into a char canvas (C[Yvec, Xvec] = "*"),
' SHIFT, and the |> pipeline with the ? placeholder.
' ============================================================

PRINT "--- map 1..10 with a lambda ---"
PRINT SELECT(LAMBDA i -> i + 1, IOTA(10))

PRINT "--- chained pipeline: map -> filter -> map ---"
PRINT SELECT(LAMBDA i -> i + 1, IOTA(10)) |> FILTER(LAMBDA val -> val > 5, ?) |> SELECT(LAMBDA v -> v * 10, ?)

PRINT "--- sine wave plotted into a character matrix ---"
W=40:H=20:F=6:C=RESHAPE([" "],[H,W]):X=IOTA(W)-1:Y=INT((SIN(X/F)+1)*((H-1)/2)):C[Y,X]="*":C[H/2,IOTA(W)-1]="-":PRINT FRMV$(C)

PRINT "--- biorhythm: three sine curves scattered into one grid ---"
BD="1990-01-01":W=41:H=21:D=DATEDIFF("D",CVDATE(BD),NOW()):X=D-W/2+IOTA(W):C=RESHAPE([" "],[H,W]):PY=INT((SIN(2*PI*X/23)+1)*((H-1)/2)):EY=INT((SIN(2*PI*X/28)+1)*((H-1)/2)):IY=INT((SIN(2*PI*X/33)+1)*((H-1)/2)):C[H/2,IOTA(W)-1]="-":C[IOTA(H)-1,INT(W/2)]="|":C[PY,IOTA(W)-1]="P":C[EY,IOTA(W)-1]="E":C[IY,IOTA(W)-1]="I":PRINT "P=Physical(23) E=Emotional(28) I=Intellectual(33)":PRINT FRMV$(C)

PRINT "--- ASCII table built from IOTA + CHR$, reshaped to a grid ---"
i=224:j=32:PRINT FRMV$(RESHAPE(STR$(IOTA(i)-1+j) + CHR$(IOTA(i)*0+58) + CHR$(IOTA(i)+j),[i^0.5,i^0.5]))

PRINT ""
PRINT "Done."

' ------------------------------------------------------------
' BONUS - a whole side-scrolling racing game in ONE line.
' Interactive (1 = left, 9 = right); uncomment to play.
' SHIFT scrolls the road, CLAMP keeps the car on the track,
' an array literal picks the WIN/DIED message.
' ------------------------------------------------------------
' L=VBNEWLINE: B=RESHAPE([" "*40+L],[19]): P=20: R=2: CLS: CURSOR FALSE: DO: B=SHIFT(B,[-1],LEFT$(" "*FLOOR(RND(0)*39)+"*"+" "*40,40)+L): LOCATE 1,1: PRINT FRMV$(B): K$=INKEY$(): P=CLAMP(P-(K$="1")+(K$="9"),0,39): R=R+((P+40)\40)-1: P=P MOD 40: C$=MID$(B[R],P,1): B[R]=LEFT$(B[R],P)+"V"+MID$(B[R],P+1): SWITCH C$="*" OR R=14: CASE 1: PRINT ["WIN!","DIED"][C$="*"]: CURSOR TRUE: END: ENDSWITCH: SLEEP 50: LOOP
