' pdf_preview.jdb: pages of a PDF as PNG pictures for a look without a PDF
' viewer. Run from the book folder.
'
'   jdbasic tools/pdf_preview.jdb out/book_print.pdf 1,3-5 [out/preview] [zoom] [WxH]
'
' zoom is pdf.js's (1.8 for a book page in 870 by 1230 pixels), WxH the
' window and so the size of the picture.

IMPORT PREVIEW

' The page numbers of a list such as "1,3-5".
FUNC PageList(spec$)
    DIM out = []
    DIM parts = SPLIT(spec$, ",")
    DIM k = 0
    DIM p = 0
    FOR k = 0 TO LEN(parts) - 1
        DIM one$ = TRIM$(parts[k])
        IF INSTR(one$, "-") > 0 THEN
            DIM ends = SPLIT(one$, "-")
            FOR p = CINT(ends[0]) TO CINT(ends[1])
                PUSH(out, p)
            NEXT p
        ELSEIF one$ <> "" THEN
            PUSH(out, CINT(one$))
        ENDIF
    NEXT k
    RETURN out
ENDFUNC

DIM argv = OS.ARGS()
IF LEN(argv) < 3 THEN THROW "usage: pdf_preview.jdb file.pdf pages [out_dir] [zoom] [WxH]"
DIM pages = PageList(argv[2])
DIM out_dir$ = "out/preview"
IF LEN(argv) > 3 THEN out_dir$ = argv[3]
DIM zoom = 1.8
IF LEN(argv) > 4 THEN zoom = VAL(argv[4])
DIM size$ = "870x1230"
IF LEN(argv) > 5 THEN size$ = argv[5]
DIM k = 0
FOR k = 0 TO LEN(pages) - 1
    DIM png$ = PATH.JOIN$(out_dir$, "page" + STR$(pages[k]) + ".png")
    IF PREVIEW.RENDER(argv[1], pages[k], png$, zoom, size$) THEN
        PRINT "wrote "; png$
    ELSE
        PRINT "page "; pages[k]; ": no picture"
    ENDIF
NEXT k
