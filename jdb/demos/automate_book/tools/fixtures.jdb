' fixtures.jdb: what check_mains puts into its temporary home so
' that a main program's dry run gets past its first missing file: the
' settings a recipe has no default for, and per recipe the input files
' its chapter asks for under "Before you start". The data follow the
' recipe tests and the sample files of the recipe folders.
'
'   IMPORT FIXTURES
'   FIXTURES.SETTINGS(values, home$)        before the wizard installs
'   DIM extra = FIXTURES.PREPARE(id$, home$, book$, folder$, jdbasic$, "")
'   FIXTURES.FILES(dir$)                    the files check_wrong copies

EXPORT MODULE FIXTURES

IMPORT XLSX, MAIL, DOCX

DIM gLF$ = CHR$(10)
' The encoding of the text files PREPARE writes: "" for plain UTF-8,
' "utf-8-bom" or "cp1252" for the edge cases of check_edges.
DIM gEnc$ = ""

SUB WriteText(path$, text$)
    IF gEnc$ = "" THEN
        TXTWRITER path$, text$
    ELSE
        TXTWRITER path$, text$, FALSE, gEnc$
    ENDIF
ENDSUB

FUNC Work$(home$)
    RETURN PATH.JOIN$(home$, "Documents", "AutomateWork")
ENDFUNC

SUB Folder(path$)
    IF NOT FILE.ISDIR(path$) THEN MKDIR path$
ENDSUB

SUB Copy(from$, to$)
    Folder(PATH.DIRNAME$(to$))
    WriteText(to$, TXTREADER$(from$))
ENDSUB

SUB Sheet(path$, name$, rows)
    Folder(PATH.DIRNAME$(path$))
    DIM wb = XLSX.NEW()
    XLSX.SHEET(wb, name$, rows)
    XLSX.WRITE(path$, wb)
ENDSUB

' The settings the wizard leaves empty and a dry run needs.
EXPORT SUB SETTINGS(values, home$)
    values{"guest_wifi"}{"ssid"} = "Guests"
    values{"guest_wifi"}{"password"} = "guest-wifi-2026"
    values{"invoice_generator"}{"company"} = "Example Ltd"
    values{"invoice_generator"}{"address"} = "1 Example Road, 12345 Example"
    values{"friday_status"}{"to"} = ["team@example.com"]
    values{"log_detective"}{"folder"} = PATH.JOIN$(home$, "logs")
    values{"meeting_briefing"}{"use_model"} = FALSE
ENDSUB

' The months whose report folders M02 may look for: this one and the
' one before.
FUNC Months(t)
    DIM this$ = FORMAT_DATE$(t, "%Y-%m")
    DIM before$ = FORMAT_DATE$(t - 32 * 86400, "%Y-%m")
    RETURN [this$, before$]
ENDFUNC

SUB Reports(work$)
    DIM head = ["Project", "Hours", "Costs", "Note"]
    DIM months = Months(NOW())
    DIM k = 0
    FOR k = 0 TO LEN(months) - 1
        DIM dir$ = PATH.JOIN$(work$, "reports", months[k])
        Sheet(PATH.JOIN$(dir$, "anna.xlsx"), "Report", _
            [head, ["Alpha", 10, 250.5, "on track"], ["Beta", 4, 80, ""]])
        Sheet(PATH.JOIN$(dir$, "ben.xlsx"), "Report", _
            [head, ["Beta", 6, 120, "late"], ["Gamma", 2.5, 40, ""]])
    NEXT k
ENDSUB

SUB SavedMail(work$)
    DIM inbox$ = PATH.JOIN$(work$, "saved mail")
    Folder(inbox$)
    DIM a = MAIL.MESSAGE("Anna Miller <anna@miller.example>", _
        "mia@example.com", "Invoice October")
    MAIL.PLAIN(a, "Please find the invoice attached.")
    MAIL.SETDATE(a, "Fri, 23 Oct 2026 12:00:00 +0000")
    MAIL.ATTACHDATA(a, "invoice.pdf", "%PDF-1.4 example")
    MAIL.WRITEEML(a, PATH.JOIN$(inbox$, "1.eml"))
ENDSUB

' Creates the input files of one recipe and answers the arguments its
' program needs beyond --dry-run and --config.
EXPORT FUNC PREPARE(id$, home$, book$, folder$, jdbasic$, encoding$)
    gEnc$ = encoding$
    DIM work$ = Work$(home$)
    DIM extra = []
    IF id$ = "E09" ORELSE id$ = "M12" ORELSE id$ = "X17" THEN
        DIM ics$ = PATH.JOIN$(book$, "recipes", "easy", _
            "E09_meeting_notes", "calendar.ics")
        Copy(ics$, PATH.JOIN$(work$, "calendar.ics"))
    ENDIF
    IF id$ = "E12" THEN
        DIM csv$ = PATH.JOIN$(book$, "recipes", "easy", _
            "E12_birthday_reminder", "contacts.csv")
        Copy(csv$, PATH.JOIN$(work$, "contacts.csv"))
    ENDIF
    IF id$ = "E13" ORELSE id$ = "X17" THEN
        DIM todo = ["Mon: Call Müller about the offer", _
            "Tue: ! Send invoice RE-0413", "Plan the team day"]
        WriteText(PATH.JOIN$(work$, "todo.txt"), JOIN(todo, gLF$) + gLF$)
    ENDIF
    IF id$ = "M01" THEN
        Sheet(PATH.JOIN$(work$, "invoices.xlsx"), "Orders", _
            [["Customer", "Email", "Item", "Quantity", "Price"], _
            ["Miller Ltd", "buy@miller.example", "Copy paper", 10, 4.5], _
            ["Stone & Co", "office@stone.example", "Toner", 2, 61.9]])
    ENDIF
    IF id$ = "M02" THEN Reports(work$)
    IF id$ = "M04" THEN
        DIM inbox$ = PATH.JOIN$(work$, "receipts", "inbox")
        Folder(PATH.JOIN$(work$, "receipts"))
        Folder(inbox$)
        TXTWRITER PATH.JOIN$(inbox$, "fuel 2026-10-02.pdf"), "x"
        TXTWRITER PATH.JOIN$(inbox$, "lunch 2026-10-05.pdf"), "x"
    ENDIF
    IF id$ = "M05" THEN
        Folder(PATH.JOIN$(home$, "Documents", "Team"))
        Sheet(PATH.JOIN$(home$, "Documents", "Team", "plan.xlsx"), "Plan", _
            [["Name", "Kind", "From", "To", "Note"], _
            ["Ann", "Vacation", "2026-10-19", "2026-10-23", "Lisbon"], _
            ["Cem", "Sick", "21.10.2026", "", ""]])
    ENDIF
    IF id$ = "M06" THEN
        DIM notes$ = PATH.JOIN$(home$, "Documents", "Team", "status")
        Folder(PATH.JOIN$(home$, "Documents", "Team"))
        Folder(notes$)
        WriteText(PATH.JOIN$(notes$, "Ann.txt"), "- [x] Offer sent to Müller" + gLF$)
        WriteText(PATH.JOIN$(notes$, "Ben.txt"), "- [ ] Budget 2027" + gLF$)
    ENDIF
    IF id$ = "M07" ORELSE id$ = "X17" THEN SavedMail(work$)
    IF id$ = "M09" THEN
        DIM log$ = PATH.JOIN$(book$, "recipes", "medium", _
            "M09_log_detective", "example.log")
        Copy(log$, PATH.JOIN$(home$, "logs", "app.log"))
    ENDIF
    IF id$ = "M11" THEN
        DIM orders$ = PATH.JOIN$(book$, "recipes", "medium", _
            "M11_data_cleaner", "orders.csv")
        Copy(orders$, PATH.JOIN$(work$, "export.csv"))
    ENDIF
    IF id$ = "M15" THEN
        DIM lines = ["time,event,project", _
            "2026-10-01 09:00:00,start,Müller offer", _
            "2026-10-01 12:30:00,start,Admin", _
            "2026-10-01 13:00:00,stop,"]
        Folder(PATH.JOIN$(work$, "time"))
        WriteText(PATH.JOIN$(work$, "time", "log.csv"), JOIN(lines, gLF$) + gLF$)
    ENDIF
    IF id$ = "X09" THEN
        DIM db$ = PATH.JOIN$(work$, "reports", "bookings.db")
        Folder(PATH.JOIN$(work$, "reports"))
        DIM maker$ = PATH.JOIN$(folder$, "make_sample.jdb")
        DIM last_day$ = FORMAT_DATE$(NOW(), "%Y-%m-%d")
        DIM q$ = CHR$(34)
        TXTWRITER maker$, "IMPORT PIPELINE" + gLF$ + "PIPELINE.SAMPLE(" + _
            q$ + db$ + q$ + ", " + q$ + last_day$ + q$ + ")" + gLF$
        DIM made = OS.EXEC(jdbasic$, [maker$])
        KILL maker$
    ENDIF
    IF id$ = "M17" THEN
        DIM md$ = PATH.JOIN$(work$, "review.md")
        WriteText(md$, "# Review" + gLF$ + gLF$ + "- Größe" + gLF$ + "- two" + gLF$)
        PUSH(extra, md$)
    ENDIF
    RETURN extra
ENDFUNC

SUB Doc(path$, paras, table)
    DIM d = DOCX.NEW()
    DIM k = 0
    FOR k = 0 TO LEN(paras) - 1
        DOCX.PARAGRAPH(d, paras[k])
    NEXT k
    IF LEN(table) > 0 THEN DOCX.TABLE(d, table)
    DIM written = DOCX.WRITE(d, path$)
ENDSUB

' The workbooks and documents the cases of check_wrong copy into their
' home: a sheet without a price column, a price with a decimal comma,
' reports that disagree, a plan with broken rows, letters and contract
' versions for the comparison.
EXPORT SUB FILES(dir$)
    DIM head = ["Customer", "Email", "Item", "Quantity", "Price"]
    Sheet(PATH.JOIN$(dir$, "m01_noprice.xlsx"), "Orders", _
        [["Customer", "Email", "Item", "Quantity", "Cost"], _
        ["Miller Ltd", "buy@miller.example", "Copy paper", 10, 4.5]])
    Sheet(PATH.JOIN$(dir$, "m01_twonames.xlsx"), "Orders", [head, _
        ["Miller Ltd", "buy@miller.example", "Copy paper", 10, 4.5], _
        ["Miller Ltd.", "buy@miller.example", "Toner", 1, 61.9]])
    DIM comma = [head]
    DIM k = 0
    FOR k = 1 TO 7
        PUSH(comma, ["Miller Ltd", "buy@miller.example", "Copy paper", 1, 4.5])
    NEXT k
    PUSH(comma, ["Miller Ltd", "buy@miller.example", "Pens", 2, "4,50"])
    Sheet(PATH.JOIN$(dir$, "m01_comma.xlsx"), "Orders", comma)
    Sheet(PATH.JOIN$(dir$, "m01_october.xlsx"), "October", _
        [head, ["Miller Ltd", "buy@miller.example", "Copy paper", 10, 4.5]])

    DIM rhead = ["Project", "Hours", "Costs", "Note"]
    Sheet(PATH.JOIN$(dir$, "m02_anna.xlsx"), "Report", _
        [rhead, ["Alpha", 10, 250.5, "on track"]])
    Sheet(PATH.JOIN$(dir$, "m02_alpha_a.xlsx"), "Report", [rhead, ["Alpha", 10, 250.5, ""]])
    Sheet(PATH.JOIN$(dir$, "m02_alpha_b.xlsx"), "Report", [rhead, ["Alpha ", 4, 80, ""]])
    Sheet(PATH.JOIN$(dir$, "m02_alpha_c.xlsx"), "Report", [rhead, ["Alpha.", 2, 40, ""]])
    Sheet(PATH.JOIN$(dir$, "m02_empty.xlsx"), "Report", [])
    Sheet(PATH.JOIN$(dir$, "m02_cleo.xlsx"), "Report", _
        [["Project", "Hours", "Costs", "Note", "Travel"], ["Alpha", 3, 60, "", 20]])

    Doc(PATH.JOIN$(dir$, "m03_letter.docx"), ["{{name}}", "{{company}}", _
        "{{city}}", "Dear {{salutation}},", "Our customer day is on {{date}}."], [])
    DIM chead = ["Name", "Company", "City", "Salutation", "Email", "Postcode"]
    DIM anna = ["Anna Berg", "Berg Ltd", "Dresden", "Ms Berg", "anna@berg.example", 1067]
    Sheet(PATH.JOIN$(dir$, "m03_contacts_nodate.xlsx"), "Contacts", [chead, anna])
    Sheet(PATH.JOIN$(dir$, "m03_contacts.xlsx"), "Contacts", _
        [APPEND(chead, ["Date"]), APPEND(anna, ["2026-11-20"])])

    DIM phead = ["Name", "Kind", "From", "To", "Note"]
    Sheet(PATH.JOIN$(dir$, "m05_othersheet.xlsx"), "Sheet1", _
        [phead, ["Ann", "Vacation", "2026-10-19", "2026-10-23", ""]])
    DIM plan = [phead]
    FOR k = 2 TO 11
        PUSH(plan, ["P" + STR$(k), "Shift", "2026-10-" + STR$(k + 10), "", ""])
    NEXT k
    PUSH(plan, ["Jan", "Vacation", "Oct 19", "", ""])
    PUSH(plan, ["Kai", "Vacation", "2026-10-30", "2026-10-28", ""])
    PUSH(plan, ["", "Vacation", "2026-10-26", "2026-10-27", ""])
    Sheet(PATH.JOIN$(dir$, "m05_plan.xlsx"), "Plan", plan)

    DIM terms = ["The supplier delivers the goods within ten days.", _
        "Payment is due thirty days after the invoice.", _
        "The contract runs for two years."]
    Doc(PATH.JOIN$(dir$, "m14_v1.docx"), terms, [])
    Doc(PATH.JOIN$(dir$, "m14_pasted.docx"), [JOIN(terms, " ")], [])
    Doc(PATH.JOIN$(dir$, "m14_table1.docx"), terms, [["Item", "Price"], ["Service", "100"]])
    Doc(PATH.JOIN$(dir$, "m14_table2.docx"), terms, [["Item", "Price"], ["Service", "120"]])
    Doc(PATH.JOIN$(dir$, "m14_long1.docx"), ["The supplier delivers the goods " + _
        "within ten days of the order to the address of the buyer, and the " + _
        "buyer checks them within three days and reports any damage in " + _
        "writing to the supplier."], [])
    Doc(PATH.JOIN$(dir$, "m14_long2.docx"), ["The seller delivers the goods " + _
        "within fourteen days of the order to the warehouse of the buyer, and " + _
        "the buyer checks them within five days and reports any defect by " + _
        "mail to the seller."], [])

    Sheet(PATH.JOIN$(dir$, "m17_notitle.xlsx"), "Slides", _
        [["Heading", "Points"], ["Review", "one; two"]])
ENDSUB
