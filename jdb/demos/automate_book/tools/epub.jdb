' epub.jdb: the book as an EPUB 3 e-book. One XHTML file per chapter from
' lib/md.jdb, the headings anchored for the navigation document, a title
' page, the cover picture, the figures and a style sheet, packed with the
' mimetype entry first and stored, as the format asks.
'
'   IMPORT EPUB
'   PRINT EPUB.WRITE(cfg, chapters, ".", "out/book.epub", "out/cover.png")

EXPORT MODULE EPUB

IMPORT CONF, MD, MDBOOK

DIM gLF$ = CHR$(10)
DIM gQ$ = CHR$(34)
DIM gLang$ = "en"
DIM gContents$ = "Contents"

FUNC Esc$(s$)
    RETURN REPLACE$(MD.ESCAPE$(s$), "'", "&#39;")
ENDFUNC

FUNC Page$(title$, body$)
    DIM head$ = "<?xml version=" + gQ$ + "1.0" + gQ$ + " encoding=" + gQ$ + "UTF-8" + gQ$ + "?>" + gLF$
    head$ = head$ + "<!DOCTYPE html>" + gLF$
    head$ = head$ + "<html xmlns=" + gQ$ + "http://www.w3.org/1999/xhtml" + gQ$ + " xmlns:epub=" + gQ$ + "http://www.idpf.org/2007/ops" + gQ$ + " xml:lang=" + gQ$ + gLang$ + gQ$ + " lang=" + gQ$ + gLang$ + gQ$ + ">" + gLF$
    head$ = head$ + "<head><meta charset=" + gQ$ + "utf-8" + gQ$ + "/><title>" + Esc$(title$) + "</title>"
    head$ = head$ + "<link rel=" + gQ$ + "stylesheet" + gQ$ + " type=" + gQ$ + "text/css" + gQ$ + " href=" + gQ$ + "style.css" + gQ$ + "/></head>" + gLF$
    RETURN head$ + "<body>" + gLF$ + body$ + gLF$ + "</body></html>" + gLF$
ENDFUNC

FUNC Css$()
    DIM c = []
    PUSH(c, "body { font-family: serif; line-height: 1.5; margin: 0 4%; }")
    PUSH(c, "h1, h2, h3 { color: #1f3864; line-height: 1.25; }")
    PUSH(c, "h1 { margin-top: 2em; }")
    PUSH(c, "code, pre { font-family: monospace; }")
    PUSH(c, "pre { background: #f3f4f6; padding: 0.6em; font-size: 0.8em; white-space: pre-wrap; }")
    PUSH(c, "blockquote { margin: 1em 0; padding: 0.5em 1em; background: #eaf1fb; border-left: 4px solid #2e74b5; }")
    PUSH(c, "table { border-collapse: collapse; font-size: 0.9em; }")
    PUSH(c, "th, td { border: 1px solid #bbb; padding: 0.2em 0.5em; vertical-align: top; }")
    PUSH(c, "img { max-width: 100%; }")
    PUSH(c, ".title { text-align: center; margin-top: 30%; }")
    PUSH(c, ".cover { text-align: center; margin: 0; padding: 0; }")
    PUSH(c, ".cover img { max-height: 100%; }")
    RETURN JOIN(c, gLF$) + gLF$
ENDFUNC

' The rendered chapter with an id on every heading, numbered from first;
' the headings are added to found as [level, text, file, id].
FUNC AnchorHeadings$(html$, file$, first, found, blocks)
    DIM titles = []
    DIM k = 0
    FOR k = 0 TO LEN(blocks) - 1
        DIM b = blocks[k]
        IF b{"kind"} = "heading" THEN PUSH(titles, b)
    NEXT k
    DIM out$ = ""
    DIM rest$ = html$
    DIM n = 0
    DO
        DIM best = -1
        DIM tag$ = ""
        DIM lv = 1
        FOR lv = 1 TO 6
            DIM at = CINT(INSTR(rest$, "<h" + STR$(lv) + ">"))
            IF at >= 0 ANDALSO (best < 0 ORELSE at < best) THEN
                best = at
                tag$ = "<h" + STR$(lv) + ">"
            ENDIF
        NEXT lv
        IF best < 0 THEN EXITDO
        DIM id$ = "h" + STR$(first + n)
        out$ = out$ + LEFT$(rest$, best) + LEFT$(tag$, 3) + " id=" + gQ$ + id$ + gQ$ + ">"
        rest$ = MID$(rest$, best + LEN(tag$), LEN(rest$))
        IF n < LEN(titles) THEN
            DIM t = titles[n]
            PUSH(found, [t{"level"}, PlainText$(t{"text"}), file$, id$])
        ENDIF
        n = n + 1
    LOOP
    RETURN out$ + rest$
ENDFUNC

FUNC PlainText$(txt$)
    DIM t$ = REPLACE$(REPLACE$(txt$, "**", ""), "`", "")
    t$ = REPLACE$(t$, "*", "")
    RETURN REGEX.REPLACE("\[([^\]]*)\]\([^)]*\)", t$, "$1")
ENDFUNC

FUNC WithoutComments$(text$)
    DIM src = SPLIT(text$, gLF$)
    RETURN JOIN(FILTER(LAMBDA s$ -> NOT STARTSWITH(TRIM$(s$), "<!--"), src), gLF$)
ENDFUNC

' The navigation document: the headings of level 1 and 2 as nested lists.
FUNC Nav$(found)
    DIM out = ["<nav epub:type=" + gQ$ + "toc" + gQ$ + " id=" + gQ$ + "toc" + gQ$ + "><h1>" + gContents$ + "</h1>", "<ol>"]
    DIM open_sub = FALSE
    DIM open_top = FALSE
    DIM k = 0
    FOR k = 0 TO LEN(found) - 1
        DIM h = found[k]
        DIM link$ = "<a href=" + gQ$ + h[2] + "#" + h[3] + gQ$ + ">" + Esc$(h[1]) + "</a>"
        IF h[0] = 1 ORELSE NOT open_top THEN
            IF open_sub THEN PUSH(out, "</ol>")
            IF open_top THEN PUSH(out, "</li>")
            open_sub = FALSE
            PUSH(out, "<li>" + link$)
            open_top = TRUE
        ELSEIF h[0] = 2 THEN
            IF NOT open_sub THEN PUSH(out, "<ol>")
            open_sub = TRUE
            PUSH(out, "<li>" + link$ + "</li>")
        ENDIF
    NEXT k
    IF open_sub THEN PUSH(out, "</ol>")
    IF open_top THEN PUSH(out, "</li>")
    PUSH(out, "</ol></nav>")
    RETURN JOIN(out, gLF$)
ENDFUNC

' A UUID made from the book's title, the same for every build.
FUNC BookId$(title$)
    DIM h$ = LCASE$(CODEC.SHA256$(title$))
    RETURN "urn:uuid:" + MID$(h$, 0, 8) + "-" + MID$(h$, 8, 4) + "-5" + MID$(h$, 13, 3) + "-a" + MID$(h$, 17, 3) + "-" + MID$(h$, 20, 12)
ENDFUNC

FUNC Item$(id$, href$, media$, props$)
    DIM out$ = "<item id=" + gQ$ + id$ + gQ$ + " href=" + gQ$ + href$ + gQ$ + " media-type=" + gQ$ + media$ + gQ$
    IF props$ <> "" THEN out$ = out$ + " properties=" + gQ$ + props$ + gQ$
    RETURN out$ + "/>"
ENDFUNC

FUNC MediaType$(path$)
    DIM ext$ = LCASE$(PATH.EXT$(path$))
    IF ext$ = ".png" THEN RETURN "image/png"
    IF ext$ = ".jpg" ORELSE ext$ = ".jpeg" THEN RETURN "image/jpeg"
    IF ext$ = ".svg" THEN RETURN "image/svg+xml"
    THROW "EPUB: no media type for " + path$
    RETURN ""
ENDFUNC

' A PNG or JPEG without the metadata that photo and AI tools leave in it
' (EXIF, XMP, IPTC, C2PA, text chunks, comments); KDP has refused an
' e-book over such a cover. Colour data (ICC profile, Adobe marker) stays.
FUNC CleanImage$(data$)
    DIM at = 0
    DIM n = 0
    DIM out$ = ""
    IF LEFT$(data$, 4) = CHR$(137) + "PNG" THEN
        out$ = LEFT$(data$, 8)
        at = 8
        DO WHILE at + 12 <= LEN(data$)
            n = ((BYTEAT(data$, at) * 256 + BYTEAT(data$, at + 1)) * 256 + BYTEAT(data$, at + 2)) * 256 + BYTEAT(data$, at + 3)
            DIM kind$ = MID$(data$, at + 4, 4)
            IF INSTR("tEXt zTXt iTXt eXIf caBX", kind$) < 0 THEN out$ = out$ + MID$(data$, at, n + 12)
            at = at + n + 12
        LOOP
        RETURN out$
    ENDIF
    IF LEN(data$) < 4 ORELSE BYTEAT(data$, 0) <> 255 ORELSE BYTEAT(data$, 1) <> 216 THEN RETURN data$
    out$ = LEFT$(data$, 2)
    at = 2
    DO WHILE at + 4 <= LEN(data$)
        DIM marker = BYTEAT(data$, at + 1)
        ' From the start of the scan on, the rest is picture data.
        IF marker = 218 THEN RETURN out$ + MID$(data$, at)
        n = BYTEAT(data$, at + 2) * 256 + BYTEAT(data$, at + 3)
        ' APP1 (EXIF, XMP), APP11 (C2PA), APP13 (IPTC) and COM go.
        IF marker <> 225 ANDALSO marker <> 235 ANDALSO marker <> 237 ANDALSO marker <> 254 THEN out$ = out$ + MID$(data$, at, n + 2)
        at = at + 2 + n
    LOOP
    RETURN data$
ENDFUNC

' Little-endian integers for the ZIP headers.
FUNC LE16$(n)
    RETURN CHR$(n MOD 256) + CHR$((n \ 256) MOD 256)
ENDFUNC

FUNC LE32$(n)
    RETURN LE16$(n MOD 65536) + LE16$((n \ 65536) MOD 65536)
ENDFUNC

' A ZIP archive with every entry stored, none compressed, in the order of
' the map; answers the number of entries. ZIP.WRITE deflates, and its
' deflate damaged a JPEG cover (KDP refused that e-book), so the EPUB
' does not use it. Stored is the safe form for EPUB: the mimetype entry
' must be stored anyway, and pictures barely shrink.
' The bytes of an entry and the method to record them under: deflated when
' that is smaller and unpacks back to the same bytes, stored otherwise.
' ZIP.WRITE deflates without asking, and its deflate damaged a JPEG cover
' (KDP refused that e-book), so the EPUB packs its entries here and reads
' each one back before trusting it. The mimetype entry stays stored, as the
' format demands, and so does anything that does not shrink.
FUNC Packed(name$, data$)
    IF name$ = "mimetype" ORELSE LEN(data$) < 64 THEN RETURN [0, data$]
    TRY
        DIM small$ = CODEC.DEFLATE$(data$, 6, "raw")
        IF LEN(small$) < LEN(data$) ANDALSO CODEC.INFLATE$(small$, "raw") = data$ THEN RETURN [8, small$]
    CATCH
        RETURN [0, data$]
    ENDTRY
    RETURN [0, data$]
ENDFUNC

' A ZIP archive in the order of the map; answers the number of entries.
FUNC StoredZip(path$, files)
    DIM body$ = ""
    DIM central$ = ""
    DIM names = MAP.KEYS(files)
    FOR EACH name$ IN names
        DIM data$ = files{name$}
        DIM how = Packed(name$, data$)
        DIM method = how[0]
        DIM raw$ = how[1]
        DIM crc = CODEC.CRC32(data$)
        ' version 2.0, no flags, 1980-01-01 00:00
        DIM common$ = LE16$(0) + LE16$(method) + LE16$(0) + LE16$(33) + LE32$(crc) + LE32$(LEN(raw$)) + LE32$(LEN(data$)) + LE16$(LEN(name$)) + LE16$(0)
        central$ = central$ + LE32$(33639248) + LE16$(20) + LE16$(20) + common$ + LE16$(0) + LE16$(0) + LE16$(0) + LE32$(0) + LE32$(LEN(body$)) + name$
        body$ = body$ + LE32$(67324752) + LE16$(20) + common$ + name$ + raw$
    NEXT name$
    DIM tail$ = LE32$(101010256) + LE16$(0) + LE16$(0) + LE16$(LEN(names)) + LE16$(LEN(names)) + LE32$(LEN(central$)) + LE32$(LEN(body$)) + LE16$(0)
    BINWRITER path$, body$ + central$ + tail$
    RETURN LEN(names)
ENDFUNC

' Writes the e-book; answers the number of files in it. cover_png$ may be
' "" for a book without a cover picture.
EXPORT FUNC WRITE(cfg, chapters, base$, out_path$, cover_png$)
    DIM title$ = CONF.GET(cfg, "book.title", "Untitled")
    DIM subtitle$ = CONF.GET(cfg, "book.subtitle", "")
    DIM authors = CONF.GET(cfg, "book.authors", [])
    DIM lang$ = LEFT$(CONF.GET(cfg, "book.language", "en-US"), 2)
    gLang$ = lang$
    gContents$ = CONF.GET(cfg, "labels.contents", "Contents")
    DIM publisher$ = CONF.GET(cfg, "book.publisher", "")
    DIM rights$ = CONF.GET(cfg, "book.rights", "")
    DIM files AS MAP
    files{"mimetype"} = "application/epub+zip"
    files{"META-INF/container.xml"} = "<?xml version=" + gQ$ + "1.0" + gQ$ + "?>" + gLF$ + "<container version=" + gQ$ + "1.0" + gQ$ + " xmlns=" + gQ$ + "urn:oasis:names:tc:opendocument:xmlns:container" + gQ$ + "><rootfiles><rootfile full-path=" + gQ$ + "OEBPS/content.opf" + gQ$ + " media-type=" + gQ$ + "application/oebps-package+xml" + gQ$ + "/></rootfiles></container>" + gLF$
    files{"OEBPS/style.css"} = Css$()
    DIM manifest = []
    DIM spine = []
    PUSH(manifest, Item$("nav", "nav.xhtml", "application/xhtml+xml", "nav"))
    PUSH(manifest, Item$("css", "style.css", "text/css", ""))
    IF cover_png$ <> "" ANDALSO FILE.EXISTS(cover_png$) THEN
        DIM cover_href$ = "img/cover" + LCASE$(PATH.EXT$(cover_png$))
        files{"OEBPS/" + cover_href$} = CleanImage$(BINREADER$(cover_png$))
        PUSH(manifest, Item$("cover-image", cover_href$, MediaType$(cover_png$), "cover-image"))
        files{"OEBPS/cover.xhtml"} = Page$(title$, "<div class=" + gQ$ + "cover" + gQ$ + "><img src=" + gQ$ + cover_href$ + gQ$ + " alt=" + gQ$ + Esc$(title$) + gQ$ + "/></div>")
        PUSH(manifest, Item$("cover", "cover.xhtml", "application/xhtml+xml", ""))
        PUSH(spine, "cover")
    ENDIF
    DIM title_body$ = "<div class=" + gQ$ + "title" + gQ$ + "><h1>" + Esc$(title$) + "</h1><p><em>" + Esc$(subtitle$) + "</em></p><p>" + Esc$(JOIN(authors, CONF.GET(cfg, "labels.and", " and "))) + "</p></div>"
    files{"OEBPS/title.xhtml"} = Page$(title$, title_body$)
    PUSH(manifest, Item$("title", "title.xhtml", "application/xhtml+xml", ""))
    PUSH(spine, "title")
    DIM found = []
    DIM images AS MAP
    DIM k = 0
    DIM j = 0
    FOR k = 0 TO LEN(chapters) - 1
        DIM ch = chapters[k]
        DIM file$ = "ch" + RIGHT$("0" + STR$(k + 1), 2) + ".xhtml"
        DIM html$ = MD.RENDER$(WithoutComments$(ch{"text"}))
        html$ = AnchorHeadings$(html$, file$, LEN(found), found, ch{"blocks"})
        DIM ch_title$ = title$
        DIM blocks = ch{"blocks"}
        FOR j = 0 TO LEN(blocks) - 1
            DIM b = blocks[j]
            IF b{"kind"} = "heading" ANDALSO ch_title$ = title$ THEN ch_title$ = PlainText$(b{"text"})
            IF b{"kind"} = "image" THEN images{b{"path"}} = PATH.JOIN$(ch{"dir"}, b{"path"})
        NEXT j
        files{"OEBPS/" + file$} = Page$(ch_title$, html$)
        DIM item_id$ = "c" + STR$(k + 1)
        PUSH(manifest, Item$(item_id$, file$, "application/xhtml+xml", ""))
        PUSH(spine, item_id$)
    NEXT k
    DIM img_paths = MAP.KEYS(images)
    FOR k = 0 TO LEN(img_paths) - 1
        DIM rel$ = img_paths[k]
        files{"OEBPS/" + rel$} = CleanImage$(BINREADER$(images{rel$}))
        PUSH(manifest, Item$("i" + STR$(k + 1), rel$, MediaType$(rel$), ""))
    NEXT k
    files{"OEBPS/nav.xhtml"} = Page$(CONF.GET(cfg, "labels.contents", "Contents"), Nav$(found))
    DIM opf = []
    PUSH(opf, "<?xml version=" + gQ$ + "1.0" + gQ$ + " encoding=" + gQ$ + "UTF-8" + gQ$ + "?>")
    PUSH(opf, "<package xmlns=" + gQ$ + "http://www.idpf.org/2007/opf" + gQ$ + " version=" + gQ$ + "3.0" + gQ$ + " unique-identifier=" + gQ$ + "bookid" + gQ$ + " xml:lang=" + gQ$ + lang$ + gQ$ + ">")
    PUSH(opf, "<metadata xmlns:dc=" + gQ$ + "http://purl.org/dc/elements/1.1/" + gQ$ + ">")
    PUSH(opf, "<dc:identifier id=" + gQ$ + "bookid" + gQ$ + ">" + BookId$(title$) + "</dc:identifier>")
    PUSH(opf, "<dc:title>" + Esc$(title$) + "</dc:title>")
    PUSH(opf, "<dc:language>" + lang$ + "</dc:language>")
    FOR k = 0 TO LEN(authors) - 1
        PUSH(opf, "<dc:creator>" + Esc$(authors[k]) + "</dc:creator>")
    NEXT k
    IF publisher$ <> "" THEN PUSH(opf, "<dc:publisher>" + Esc$(publisher$) + "</dc:publisher>")
    IF rights$ <> "" THEN PUSH(opf, "<dc:rights>" + Esc$(rights$) + "</dc:rights>")
    PUSH(opf, "<meta property=" + gQ$ + "dcterms:modified" + gQ$ + ">" + FORMAT_DATE(NOW(), "%Y-%m-%dT%H:%M:%SZ", 0) + "</meta>")
    IF cover_png$ <> "" ANDALSO FILE.EXISTS(cover_png$) THEN PUSH(opf, "<meta name=" + gQ$ + "cover" + gQ$ + " content=" + gQ$ + "cover-image" + gQ$ + "/>")
    PUSH(opf, "</metadata>")
    PUSH(opf, "<manifest>")
    opf = APPEND(opf, manifest)
    PUSH(opf, "</manifest>")
    PUSH(opf, "<spine>")
    FOR k = 0 TO LEN(spine) - 1
        PUSH(opf, "<itemref idref=" + gQ$ + spine[k] + gQ$ + "/>")
    NEXT k
    PUSH(opf, "</spine>")
    PUSH(opf, "</package>")
    files{"OEBPS/content.opf"} = JOIN(opf, gLF$) + gLF$
    RETURN StoredZip(out_path$, files)
ENDFUNC
