' build_book.jdb: the book from its manuscript. book.toml names the
' chapters; the build checks the writing rules (tools/prose.jdb), writes
' out/book.docx, out/book_print.pdf, out/book_screen.pdf, the covers,
' out/book.epub and a browser preview in
' out/html/, and reports words, code lines and estimated pages per chapter.
' Appendix D and E are written from the recipe folders first.
'
'   jdbasic tools/build_book.jdb [book.toml] [--only docx|html|pdf|print|screen|cover|epub]
'
' Run from the book folder; the modules come from lib/ through JDBASIC_PATH.

IMPORT CONF, DOCX, MD, MDBOOK, PROSE, LAYOUT, TTF, COVER, EPUB, PREVIEW, EXAMPLES, APPENDIX

DIM gLF$ = CHR$(10)
DIM gCodeColumns = 70

' ── the chapters ──────────────────────────────────────────────

' Every chapter as a map: path, dir, resolved text, blocks and stats.
FUNC LoadChapters(cfg, base$)
    DIM files = CONF.GET(cfg, "chapters.files", [])
    IF LEN(files) = 0 THEN THROW "book.toml lists no chapters under [chapters] files"
    DIM out = []
    DIM k = 0
    FOR k = 0 TO LEN(files) - 1
        DIM rel$ = files[k]
        DIM path$ = PATH.JOIN$(base$, rel$)
        IF NOT FILE.EXISTS(path$) THEN THROW "chapter not found: " + path$
        DIM text$ = MDBOOK.RESOLVE$(TXTREADER$(path$), base$)
        DIM blocks = MDBOOK.BLOCKS(text$)
        PUSH(out, {"path": rel$, "dir": PATH.DIRNAME$(path$), "text": text$, "blocks": blocks, "stats": MDBOOK.STATS(blocks)})
    NEXT k
    RETURN out
ENDFUNC

' The text without its {{page:Heading}} references, which only the PDF
' can fill in.
FUNC NoPageRefs$(txt$)
    DIM out$ = txt$
    DIM at = INSTR(out$, "{{page:")
    DO WHILE at >= 0
        DIM close_at = INSTR(at, out$, "}}")
        IF close_at < 0 THEN EXITDO
        out$ = LEFT$(out$, at) + MID$(out$, close_at + 2)
        at = INSTR(out$, "{{page:")
    LOOP
    RETURN out$
ENDFUNC

' The chapters for Word, HTML and the e-book: page references removed
' from the text and from the paragraphs and tables.
FUNC WithoutPageRefs(chapters)
    DIM out = []
    DIM k = 0
    DIM j = 0
    FOR k = 0 TO LEN(chapters) - 1
        DIM ch = chapters[k]
        DIM text$ = ch{"text"}
        IF INSTR(text$, "{{page:") < 0 THEN
            PUSH(out, ch)
        ELSE
            DIM blocks = MDBOOK.BLOCKS(NoPageRefs$(text$))
            PUSH(out, {"path": ch{"path"}, "dir": ch{"dir"}, "text": NoPageRefs$(text$), "blocks": blocks, "stats": ch{"stats"}})
        ENDIF
    NEXT k
    RETURN out
ENDFUNC

' ── Word ──────────────────────────────────────────────────────

SUB DocxBlocks(doc, blocks, dir$, image_cm)
    DIM k = 0
    FOR k = 0 TO LEN(blocks) - 1
        DIM b = blocks[k]
        DIM kind$ = b{"kind"}
        IF kind$ = "heading" THEN
            DOCX.HEADING(doc, b{"text"}, b{"level"})
        ELSEIF kind$ = "para" THEN
            DOCX.PARAGRAPH(doc, b{"text"})
        ELSEIF kind$ = "bullets" THEN
            DOCX.BULLETS(doc, b{"items"})
        ELSEIF kind$ = "numbered" THEN
            DOCX.NUMBERED(doc, b{"items"})
        ELSEIF kind$ = "code" THEN
            DOCX.CODE(doc, b{"text"})
        ELSEIF kind$ = "table" THEN
            DOCX.TABLE(doc, b{"rows"}, TRUE)
        ELSEIF kind$ = "note" THEN
            DOCX.NOTE(doc, b{"title"}, b{"text"})
        ELSEIF kind$ = "image" THEN
            DOCX.IMAGE(doc, PATH.JOIN$(dir$, b{"path"}), image_cm)
            IF b{"alt"} <> "" THEN DOCX.PARAGRAPH(doc, "*" + b{"alt"} + "*", "center")
        ELSEIF kind$ = "pagebreak" THEN
            DOCX.PAGEBREAK(doc)
        ELSEIF kind$ = "toc" THEN
            DOCX.TOC(doc, 2)
        ENDIF
    NEXT k
ENDSUB

FUNC WriteDocx(cfg, chapters, out_path$)
    DIM title$ = CONF.GET(cfg, "book.title", "Untitled")
    DIM subtitle$ = CONF.GET(cfg, "book.subtitle", "")
    DIM authors = CONF.GET(cfg, "book.authors", [])
    DIM doc = DOCX.NEW()
    DOCX.LANGUAGE(doc, CONF.GET(cfg, "book.language", "en-US"))
    DOCX.PAGESETUP(doc, CONF.GET(cfg, "page.width_mm", 170), CONF.GET(cfg, "page.height_mm", 240), CONF.GET(cfg, "page.margin_mm", 20))
    DOCX.TITLE(doc, title$)
    DOCX.HEADER(doc, title$)
    DOCX.FOOTER(doc, "{page}")
    DOCX.PARAGRAPH(doc, "**" + title$ + "**", "center")
    IF subtitle$ <> "" THEN DOCX.PARAGRAPH(doc, "*" + subtitle$ + "*", "center")
    IF LEN(authors) > 0 THEN DOCX.PARAGRAPH(doc, JOIN(authors, " and "), "center")
    DOCX.PARAGRAPH(doc, "Version " + CONF.GET(cfg, "book.version", "0"), "center")
    DOCX.PAGEBREAK(doc)
    DIM image_cm = CONF.GET(cfg, "images.width_cm", 12)
    DIM k = 0
    FOR k = 0 TO LEN(chapters) - 1
        DIM ch = chapters[k]
        IF k > 0 THEN DOCX.PAGEBREAK(doc)
        DocxBlocks(doc, ch{"blocks"}, ch{"dir"}, image_cm)
    NEXT k
    RETURN DOCX.WRITE(doc, out_path$)
ENDFUNC

' ── HTML preview ──────────────────────────────────────────────

FUNC HtmlPage$(title$, body$, nav$)
    DIM css$ = "body{max-width:46rem;margin:2rem auto;padding:0 1rem;font:17px/1.6 Georgia,serif;color:#222}"
    css$ = css$ + "pre{background:#f2f2f2;padding:.8rem;overflow-x:auto;font:14px/1.4 Consolas,monospace}"
    css$ = css$ + "code{font-family:Consolas,monospace}blockquote{margin:1rem 0;padding:.6rem 1rem;background:#eaf1fb;border-left:6px solid #2e74b5}"
    css$ = css$ + "table{border-collapse:collapse}td,th{border:1px solid #bbb;padding:.3rem .6rem}img{max-width:100%}nav{font-size:14px}"
    RETURN "<!doctype html>" + gLF$ + "<html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>" + MD.ESCAPE$(title$) + "</title><style>" + css$ + "</style></head><body><nav>" + nav$ + "</nav>" + gLF$ + body$ + gLF$ + "<nav>" + nav$ + "</nav></body></html>" + gLF$
ENDFUNC

' The text without the comment lines the HTML renderer would show as text.
FUNC WithoutComments$(text$)
    DIM src = SPLIT(text$, gLF$)
    RETURN JOIN(FILTER(LAMBDA s$ -> NOT STARTSWITH(TRIM$(s$), "<!--"), src), gLF$)
ENDFUNC

SUB CopyImages(blocks, dir$, html_dir$)
    DIM k = 0
    FOR k = 0 TO LEN(blocks) - 1
        DIM b = blocks[k]
        IF b{"kind"} = "image" THEN
            DIM rel$ = b{"path"}
            DIM dst$ = PATH.JOIN$(html_dir$, rel$)
            MKDIR PATH.DIRNAME$(dst$)
            BINWRITER dst$, BINREADER$(PATH.JOIN$(dir$, rel$))
        ENDIF
    NEXT k
ENDSUB

FUNC WriteHtml(cfg, chapters, html_dir$)
    DIM title$ = CONF.GET(cfg, "book.title", "Untitled")
    MKDIR html_dir$
    DIM links = []
    DIM k = 0
    FOR k = 0 TO LEN(chapters) - 1
        DIM ch = chapters[k]
        PUSH(links, "<a href='ch" + STR$(k + 1) + ".html'>" + STR$(k + 1) + "</a>")
    NEXT k
    DIM nav$ = "<a href='index.html'>Contents</a> | " + JOIN(links, " ")
    DIM toc = []
    FOR k = 0 TO LEN(chapters) - 1
        DIM chap = chapters[k]
        DIM blocks = chap{"blocks"}
        DIM head$ = chap{"path"}
        IF LEN(blocks) > 0 ANDALSO blocks[0]{"kind"} = "heading" THEN head$ = blocks[0]{"text"}
        PUSH(toc, "<li><a href='ch" + STR$(k + 1) + ".html'>" + MD.INLINE$(head$) + "</a></li>")
        TXTWRITER PATH.JOIN$(html_dir$, "ch" + STR$(k + 1) + ".html"), HtmlPage$(title$, MD.RENDER$(WithoutComments$(chap{"text"})), nav$)
        CopyImages(blocks, chap{"dir"}, html_dir$)
    NEXT k
    TXTWRITER PATH.JOIN$(html_dir$, "index.html"), HtmlPage$(title$, "<h1>" + MD.ESCAPE$(title$) + "</h1><ol>" + JOIN(toc, "") + "</ol>", nav$)
    RETURN LEN(chapters) + 1
ENDFUNC

' ── report ────────────────────────────────────────────────────

SUB Report(chapters)
    DIM words = 0
    DIM code_lines = 0
    DIM pages = 0
    DIM k = 0
    PRINT FORMAT$("{:<34} {:>7} {:>6} {:>6}", "chapter", "words", "code", "pages")
    FOR k = 0 TO LEN(chapters) - 1
        DIM ch = chapters[k]
        DIM st = ch{"stats"}
        DIM p = MDBOOK.PAGES(st)
        words = words + st{"words"}
        code_lines = code_lines + st{"code_lines"}
        pages = pages + p
        PRINT FORMAT$("{:<34} {:>7} {:>6} {:>6.1f}", ch{"path"}, st{"words"}, st{"code_lines"}, p)
    NEXT k
    PRINT FORMAT$("{:<34} {:>7} {:>6} {:>6.1f}", "total", words, code_lines, pages)
ENDSUB

' ── writing rules ─────────────────────────────────────────────

' The prose findings in the chapters, in the comments of every listing
' they print (only the part an include names), and in the extra files
' book.toml names under [prose].
FUNC ProseFindings(cfg, base$)
    DIM out = []
    DIM files = CONF.GET(cfg, "chapters.files", [])
    DIM extra = CONF.GET(cfg, "prose.extra", [])
    DIM docs = APPEND(files, extra)
    DIM k = 0
    DIM j = 0
    FOR k = 0 TO LEN(docs) - 1
        DIM rel$ = docs[k]
        DIM text$ = TXTREADER$(PATH.JOIN$(base$, rel$))
        out = APPEND(out, PROSE.MARKDOWN(text$, rel$))
        DIM src = SPLIT(REPLACE$(text$, CHR$(13), ""), gLF$)
        FOR j = 0 TO LEN(src) - 1
            DIM t$ = TRIM$(src[j])
            IF STARTSWITH(t$, "<!-- include ") THEN
                DIM inc$ = SPLIT(TRIM$(MID$(t$, 13, LEN(t$) - 16)), " ")[0]
                DIM printed$ = MDBOOK.RESOLVE$(t$, base$)
                DIM label$ = inc$
                IF INSTR(t$, " lines=") >= 0 ORELSE INSTR(t$, " from=") >= 0 THEN label$ = inc$ + " (the part included)"
                out = APPEND(out, PROSE.COMMENTS(printed$, label$))
                out = APPEND(out, WideLines(printed$, label$, TRUE))
            ENDIF
        NEXT j
        IF k < LEN(files) THEN out = APPEND(out, WideLines(text$, rel$, TRUE))
    NEXT k
    RETURN out
ENDFUNC

' Lines of a listing wider than the book's code column; in a Markdown
' text only the lines inside code fences count.
FUNC WideLines(text$, file$, fenced_only)
    DIM out = []
    DIM src = SPLIT(REPLACE$(text$, CHR$(13), ""), gLF$)
    DIM in_fence = FALSE
    DIM k = 0
    FOR k = 0 TO LEN(src) - 1
        DIM one$ = src[k]
        IF STARTSWITH(TRIM$(one$), "```") THEN
            in_fence = NOT in_fence
        ELSEIF in_fence ORELSE NOT fenced_only THEN
            DIM n = LEN(TTF.CODEPOINTS(REPLACE$(one$, CHR$(9), "    ")))
            IF n > gCodeColumns THEN PUSH(out, file$ + ":" + STR$(k + 1) + " [code line of " + STR$(n) + " characters, the page takes " + STR$(gCodeColumns) + "]")
        ENDIF
    NEXT k
    RETURN out
ENDFUNC

' The page count of a PDF written by PDFGEN, from its page tree.
FUNC PdfPages(path$)
    DIM pdf$ = BINREADER$(path$)
    DIM at = INSTR(pdf$, "<< /Type /Pages /Kids [")
    IF at < 0 THEN RETURN 0
    DIM count_at = INSTR(at, pdf$, "/Count ")
    RETURN CINT(VAL(MID$(pdf$, count_at + 7, 8)))
ENDFUNC

' ── main ──────────────────────────────────────────────────────

DIM cfg_path$ = "book.toml"
DIM only$ = ""
DIM argv = OS.ARGS()
DIM a = 1
DO WHILE a < LEN(argv)
    DIM arg$ = argv[a]
    IF arg$ = "--only" ANDALSO a + 1 < LEN(argv) THEN
        only$ = argv[a + 1]
        a = a + 2
    ELSE
        cfg_path$ = arg$
        a = a + 1
    ENDIF
LOOP

DIM base$ = PATH.DIRNAME$(cfg_path$)
IF base$ = "" THEN base$ = "."
DIM cfg = CONF.TOML(cfg_path$)
DIM out_dir$ = PATH.JOIN$(base$, CONF.GET(cfg, "build.out", "out"))
MKDIR out_dir$
DIM gen_recipes = APPENDIX.RECIPES(PATH.JOIN$(base$, "recipes"))
TXTWRITER PATH.JOIN$(base$, "manuscript", "07_appendix_d.md"), APPENDIX.SETTINGS_MD$(gen_recipes, PATH.JOIN$(base$, "recipes", "lib"))
DIM gen_heads = APPENDIX.HEADINGS(PATH.JOIN$(base$, "manuscript"))
TXTWRITER PATH.JOIN$(base$, "manuscript", "07_appendix_e.md"), APPENDIX.RECIPES_MD$(gen_recipes, gen_heads)
PRINT "appendix D and E: "; LEN(gen_recipes); " recipes"
DIM chapters = LoadChapters(cfg, base$)
DIM flat_chapters = WithoutPageRefs(chapters)
DIM findings = ProseFindings(cfg, base$)
IF LEN(findings) > 0 THEN
    PRINT "The writing rules are broken in "; LEN(findings); " places:"
    DIM f = 0
    FOR f = 0 TO LEN(findings) - 1
        PRINT "  "; findings[f]
    NEXT f
    THROW "fix the prose before building"
ENDIF
PRINT "writing rules: clean"
DIM jdbasic$ = PATH.NORMALIZE$("../../../build/jdBasic.exe")
DIM ja = 1
FOR ja = 1 TO LEN(argv) - 2
    IF argv[ja] = "--jdbasic" THEN jdbasic$ = argv[ja + 1]
NEXT ja
DIM saved_path$ = GETENV$("JDBASIC_PATH")
SETENV "JDBASIC_PATH", saved_path$ + ";" + PATH.NORMALIZE$(PATH.JOIN$(base$, "recipes", "lib"))
DIM n_examples = 0
DIM bad_examples = []
DIM cf = 0
DIM chapter_files = CONF.GET(cfg, "chapters.files", [])
FOR cf = 0 TO LEN(chapter_files) - 1
    DIM ex_rel$ = chapter_files[cf]
    DIM ex_report = EXAMPLES.CHECK(TXTREADER$(PATH.JOIN$(base$, ex_rel$)), ex_rel$, jdbasic$, PATH.JOIN$(out_dir$, "examples"))
    n_examples = n_examples + ex_report{"run"}
    bad_examples = APPEND(bad_examples, ex_report{"problems"})
NEXT cf
SETENV "JDBASIC_PATH", saved_path$
IF LEN(bad_examples) > 0 THEN
    PRINT LEN(bad_examples); " examples print something other than the text says:"
    FOR cf = 0 TO LEN(bad_examples) - 1
        PRINT "  "; bad_examples[cf]
    NEXT cf
    THROW "fix the examples before building"
ENDIF
PRINT "examples: "; n_examples; " run, all as printed"

IF only$ = "" ORELSE only$ = "docx" THEN
    DIM docx_path$ = PATH.JOIN$(out_dir$, "book.docx")
    DIM parts = WriteDocx(cfg, flat_chapters, docx_path$)
    PRINT "wrote "; docx_path$; " ("; parts; " parts)"
ENDIF
IF only$ = "" ORELSE only$ = "html" THEN
    DIM html_dir$ = PATH.JOIN$(out_dir$, "html")
    DIM pages_written = WriteHtml(cfg, flat_chapters, html_dir$)
    PRINT "wrote "; html_dir$; " ("; pages_written; " pages)"
ENDIF
DIM modes = ["print", "screen"]
DIM mi = 0
FOR mi = 0 TO LEN(modes) - 1
    DIM pdf_mode$ = modes[mi]
    IF only$ = "" ORELSE only$ = "pdf" ORELSE only$ = pdf_mode$ THEN
        DIM pdf_path$ = PATH.JOIN$(out_dir$, "book_" + pdf_mode$ + ".pdf")
        DIM t0 = TICK()
        DIM n_pages = LAYOUT.BOOK(cfg, chapters, base$, pdf_path$, pdf_mode$)
        PRINT "wrote "; pdf_path$; " ("; n_pages; " pages, "; FORMAT$("{:.1f}", (TICK() - t0) / 1000); " s)"
    ENDIF
NEXT mi
DIM print_pages = 0
IF FILE.EXISTS(PATH.JOIN$(out_dir$, "book_print.pdf")) THEN print_pages = PdfPages(PATH.JOIN$(out_dir$, "book_print.pdf"))
IF only$ = "" ORELSE only$ = "cover" ORELSE only$ = "epub" THEN
    DIM front_pdf$ = PATH.JOIN$(out_dir$, "cover_front.pdf")
    COVER.FRONT(cfg, base$, front_pdf$)
    PRINT "wrote "; front_pdf$
    IF print_pages > 0 THEN
        DIM wrap_pdf$ = PATH.JOIN$(out_dir$, "cover_print.pdf")
        DIM sheet = COVER.WRAP(cfg, base$, print_pages, wrap_pdf$)
        PRINT "wrote "; wrap_pdf$; " ("; FORMAT$("{:.1f} x {:.1f} mm, spine {:.1f} mm", sheet[0], sheet[1], COVER.SPINE_MM(cfg, print_pages)); ")"
    ENDIF
ENDIF
IF only$ = "" ORELSE only$ = "epub" THEN
    DIM cover_png$ = PATH.JOIN$(out_dir$, "cover.png")
    IF PREVIEW.READY() THEN
        IF NOT PREVIEW.RENDER(PATH.JOIN$(out_dir$, "cover_front.pdf"), 1, cover_png$, 3.32, "1600x2260") THEN cover_png$ = ""
    ELSE
        PRINT "no Chrome: the e-book gets no cover picture"
        cover_png$ = ""
    ENDIF
    DIM epub_path$ = PATH.JOIN$(out_dir$, "book.epub")
    DIM n_files = EPUB.WRITE(cfg, flat_chapters, base$, epub_path$, cover_png$)
    PRINT "wrote "; epub_path$; " ("; n_files; " files)"
ENDIF
Report(chapters)
