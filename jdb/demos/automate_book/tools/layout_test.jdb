' LAYOUT: a small manuscript set as print and screen PDF: the contents
' find their page numbers, a chapter starts on a right hand page in print,
' a long listing breaks over pages, and the screen PDF has its bookmarks
' and links. Run from the book folder; the fonts come from fonts/.

IMPORT TESTKIT, LAYOUT, MDBOOK, CONF

DIM LF$ = CHR$(10)
DIM folder$ = MKTEMP$("layouttest")
MKDIR folder$

DIM code = []
DIM i = 0
FOR i = 1 TO 90
    PUSH(code, "PRINT " + STR$(i) + "   ' line " + STR$(i))
NEXT i
DIM md$ = "<!-- toc -->" + LF$ + LF$ + "# First Chapter" + LF$ + LF$ + "Some **bold** and *italic* text with `code` and [a link](https://example.com)." + LF$ + LF$
md$ = md$ + "## A Section" + LF$ + LF$ + "```basic" + LF$ + JOIN(code, LF$) + LF$ + "```" + LF$ + LF$
md$ = md$ + "> **Balance dividend**" + LF$ + "> Ten minutes." + LF$ + LF$
md$ = md$ + "| A | B |" + LF$ + "|---|---|" + LF$ + "| one | two |" + LF$ + LF$
md$ = md$ + "# Second Chapter" + LF$ + LF$ + "- an item" + LF$ + "- another" + LF$
DIM blocks = MDBOOK.BLOCKS(md$)
DIM chapters = [{"path": "test.md", "dir": folder$, "text": md$, "blocks": blocks}]
DIM cfg = CONF.TOML_TEXT("[book]" + LF$ + "title = " + CHR$(34) + "Test Book" + CHR$(34) + LF$ + "authors = [" + CHR$(34) + "A" + CHR$(34) + "]" + LF$)

TESTKIT.SUITE("print")
DIM print$ = folder$ + "/print.pdf"
DIM n_print = LAYOUT.BOOK(cfg, chapters, ".", print$, "print")
TESTKIT.ISTRUE(n_print >= 7, "title, back of title, contents, two chapters and a listing over two pages")
TESTKIT.EQ(n_print MOD 2, 1, "the second chapter started on a right hand page, so the count is odd")
DIM pdf$ = BINREADER$(print$)
TESTKIT.ISTRUE(INSTR(pdf$, "/FontFile2 ") >= 0, "the fonts are embedded")
TESTKIT.EQ(Occurrences(pdf$, "/Subtype /Link"), 0, "a print PDF has no link areas")

TESTKIT.SUITE("screen")
DIM screen$ = folder$ + "/screen.pdf"
DIM n_screen = LAYOUT.BOOK(cfg, chapters, ".", screen$, "screen")
TESTKIT.ISTRUE(n_screen < n_print, "no blank pages on the screen")
DIM spdf$ = BINREADER$(screen$)
TESTKIT.ISTRUE(INSTR(spdf$, "/Type /Outlines") >= 0, "bookmarks")
TESTKIT.ISTRUE(Occurrences(spdf$, "/Subtype /Link") >= 4, "the URL and the three contents entries are links")
TESTKIT.ISTRUE(INSTR(spdf$, "/URI (https://example.com)") >= 0, "the URL")

TESTKIT.SUITE("index and page references")
DIM terms$ = folder$ + "/terms.txt"
TXTWRITER terms$, "# terms" + LF$ + "outbox" + LF$ + "WORKCONF.VALUE" + LF$ + "Task Scheduler" + LF$ + "never used" + LF$ + "=Word" + LF$
DIM md2$ = "# Alpha" + LF$ + LF$ + "The outbox holds mail, every word of it. Read it with `WORKCONF.VALUE`." + LF$ + LF$
md2$ = md2$ + "| What | Page |" + LF$ + "|---|---|" + LF$ + "| Beta | {{page:Beta}} |" + LF$ + LF$
md2$ = md2$ + "# Beta" + LF$ + LF$ + "The Task Scheduler starts it; the Outbox again. Open it in Word." + LF$ + LF$
md2$ = md2$ + "# Index" + LF$ + LF$ + "<!-- index -->" + LF$
DIM chapters2 = [{"path": "ix.md", "dir": folder$, "text": md2$, "blocks": MDBOOK.BLOCKS(md2$)}]
DIM cfg2 = CONF.TOML_TEXT("[book]" + LF$ + "title = " + CHR$(34) + "Index Book" + CHR$(34) + LF$ + "[index]" + LF$ + "terms = " + CHR$(34) + REPLACE$(terms$, "\", "/") + CHR$(34) + LF$)
DIM ix_pdf$ = folder$ + "/index.pdf"
DIM n_ix = LAYOUT.BOOK(cfg2, chapters2, ".", ix_pdf$, "print")
DIM ix = LAYOUT.LAST_INDEX()
TESTKIT.EQ(LEN(MAP.KEYS(ix)), 4, "four of the five terms are in the text")
TESTKIT.ISFALSE(MAP.EXISTS(ix, "never used"), "a term the text lacks is left out")
DIM outbox_pages = ix{"outbox"}
TESTKIT.EQ(LEN(outbox_pages), 2, "a term on two pages has both, whatever its case")
TESTKIT.ISTRUE(outbox_pages[1] > outbox_pages[0], "in order")
DIM wc_pages = ix{"WORKCONF.VALUE"}
TESTKIT.EQ(wc_pages[0], outbox_pages[0], "a term with a dot, read from inline code")
DIM ts_pages = ix{"Task Scheduler"}
TESTKIT.EQ(ts_pages[0], outbox_pages[1], "a term of two words")
DIM word_pages = ix{"Word"}
TESTKIT.EQ(LEN(word_pages), 1, "a term marked = matches only its own case")
TESTKIT.EQ(word_pages[0], outbox_pages[1], "on the page that names Word")
TESTKIT.ISTRUE(n_ix > outbox_pages[1], "the index has a page of its own")

KILL print$
KILL screen$
KILL ix_pdf$
KILL terms$
RMDIR folder$
TESTKIT.REPORT()

FUNC Occurrences(hay$, needle$)
    DIM n = 0
    DIM at = INSTR(hay$, needle$)
    DO WHILE at >= 0
        n = n + 1
        at = CINT(INSTR(at + LEN(needle$), hay$, needle$))
    LOOP
    RETURN n
ENDFUNC
