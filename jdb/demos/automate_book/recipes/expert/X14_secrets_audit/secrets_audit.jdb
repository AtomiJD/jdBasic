' Secrets and Audit Trail: keeps the passwords of your automations in
' the Windows Credential Manager instead of in files, finds passwords
' that are still written into scripts, and checks the signed audit
' trail the job server (X01) keeps of every run. The settings are the
' [secrets_audit] part of work.conf.
'
'   jdbasic secrets_audit.jdb                 which secrets are stored
'   jdbasic secrets_audit.jdb --set mail      store a secret (asks)
'   jdbasic secrets_audit.jdb --delete mail   remove a secret
'   jdbasic secrets_audit.jdb --init-audit    make the signing key
'   jdbasic secrets_audit.jdb --verify        check the audit trail
'   jdbasic secrets_audit.jdb --scan          passwords in your files

IMPORT WORKCONF, JOBSTATE, VAULT, AUDIT, TRAIL

DIM cfg = WORKCONF.SETTINGS(WORKCONF.CONFIG_PATH$())
DIM key$ = "secrets_audit."
DIM extra = WORKCONF.VALUE(cfg, key$ + "names", [])
DIM days = WORKCONF.VALUE(cfg, key$ + "summary_days", 7)
DIM home$ = "~/Documents/AutomateWork"
DIM work$ = WORKCONF.FOLDER$(cfg, "paths.work", home$)
DIM audit$ = PATH.JOIN$(JOBSTATE.FOLDER$(cfg), "audit.log")
DIM audit_target$ = TRAIL.TARGET$("audit-key")
DIM dry_run = WORKCONF.FLAG("dry-run")

DIM to_set$ = WORKCONF.ARG$("set")
IF to_set$ <> "" THEN
    DIM user$ = WORKCONF.ARG$("user")
    IF user$ = "" ANDALSO to_set$ = "mail" THEN
        user$ = WORKCONF.VALUE(cfg, "mail.user", "")
    ENDIF
    DIM first$ = VAULT.ASK$("Secret for " + to_set$ + ": ")
    DIM again$ = VAULT.ASK$("The same once more: ")
    IF first$ = "" ORELSE first$ <> again$ THEN
        PRINT "The two did not match; nothing was stored."
    ELSEIF dry_run THEN
        PRINT "would store "; TRAIL.TARGET$(to_set$)
    ELSE
        VAULT.PUT(TRAIL.TARGET$(to_set$), user$, first$)
        PRINT "Stored as "; TRAIL.TARGET$(to_set$)
    ENDIF
    END
ENDIF

DIM to_delete$ = WORKCONF.ARG$("delete")
IF to_delete$ <> "" THEN
    IF dry_run THEN
        PRINT "would remove "; TRAIL.TARGET$(to_delete$)
    ELSEIF VAULT.DELETE(TRAIL.TARGET$(to_delete$)) THEN
        PRINT "Removed "; TRAIL.TARGET$(to_delete$)
    ELSE
        PRINT "There is no secret "; TRAIL.TARGET$(to_delete$)
    ENDIF
    END
ENDIF

IF WORKCONF.FLAG("init-audit") THEN
    IF VAULT.HAS(audit_target$) THEN
        PRINT "The signing key exists already."
    ELSEIF dry_run THEN
        PRINT "would make a signing key in "; audit_target$
    ELSE
        VAULT.PUT(audit_target$, "audit", TRAIL.NEW_KEY$())
        PRINT "Made a signing key; the job server signs from now on."
    ENDIF
    END
ENDIF

IF WORKCONF.FLAG("verify") THEN
    DIM signing$ = VAULT.GET$(audit_target$)
    IF signing$ = "" THEN
        PRINT "No signing key yet. Run with --init-audit first."
        END
    ENDIF
    DIM check = AUDIT.VERIFY(audit$, signing$)
    DIM since_day = DATEADD("d", -days, NOW())
    DIM from_day$ = FORMAT_DATE(since_day, "%Y-%m-%d")
    DIM summary = TRAIL.SUMMARY(AUDIT.ENTRIES(audit$), from_day$)
    DIM lines = TRAIL.REPORT_LINES(check, summary)
    DIM i = 0
    FOR i = 0 TO LEN(lines) - 1
        PRINT lines[i]
    NEXT i
    IF NOT check{"ok"} THEN
        THROW "The audit trail does not check out."
    ENDIF
    END
ENDIF

IF WORKCONF.FLAG("scan") THEN
    DIM where$ = WORKCONF.ARG$("folder")
    IF where$ = "" THEN where$ = work$
    DIM hits = TRAIL.SCAN(WORKCONF.EXPAND$(where$))
    DIM found$ = STR$(LEN(hits)) + " lines look"
    IF LEN(hits) = 1 THEN found$ = "1 line looks"
    PRINT found$; " like a written down secret"
    DIM h = 0
    FOR h = 0 TO LEN(hits) - 1
        DIM hit = hits[h]
        PRINT "  "; hit{"file"}; " line "; hit{"line"}
        PRINT "    "; hit{"text"}
    NEXT h
    END
ENDIF

DIM names = TRAIL.KNOWN(extra)
DIM n = 0
FOR n = 0 TO LEN(names) - 1
    DIM target$ = TRAIL.TARGET$(names[n])
    IF VAULT.HAS(target$) THEN
        PRINT "  stored   "; target$; " ("; VAULT.USER$(target$); ")"
    ELSE
        PRINT "  missing  "; target$
    ENDIF
NEXT n
