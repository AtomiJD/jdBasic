' VAULT, TRAIL and AUDIT: a secret goes into the Credential Manager and
' comes back, a written down password is found and masked, the audit
' trail notices a changed and a removed line, and the summary counts
' the runs. The test's secrets have names of their own and are removed
' at the end.

IMPORT TESTKIT, VAULT, TRAIL, AUDIT, SECRET

DIM LF$ = CHR$(10)
DIM Q$ = CHR$(34)
DIM folder$ = MKTEMP$("trailtest")
MKDIR folder$
DIM target$ = "AutomateWorkTest/" + SECRET.TOKEN$(8, "hex")

TESTKIT.SUITE("the Credential Manager")
TESTKIT.ISFALSE(VAULT.HAS(target$), "a new name is not there yet")
TESTKIT.EQ(VAULT.GET$(target$), "", "and reads as nothing")
VAULT.PUT(target$, "lena", "first")
TESTKIT.EQ(VAULT.GET$(target$), "first", "a stored secret comes back")
VAULT.PUT(target$, "lena", "grün €")
TESTKIT.EQ(VAULT.GET$(target$), "grün €", "a new one replaces it, umlauts and all")
TESTKIT.EQ(VAULT.USER$(target$), "lena", "with its user name")
TESTKIT.EQ(VAULT.FIND$(target$, "", ""), "grün €", "FIND$ looks in the store first")
TESTKIT.ISTRUE(VAULT.DELETE(target$), "it can be removed")
TESTKIT.ISFALSE(VAULT.HAS(target$), "and is gone")
TESTKIT.ISFALSE(VAULT.DELETE(target$), "removing it twice answers FALSE")
SETENV "AUTOMATEWORK_TEST_SECRET", "from the environment"
TESTKIT.EQ(VAULT.FIND$(target$, "AUTOMATEWORK_TEST_SECRET", ""), "from the environment", "then in the environment")
TESTKIT.EQ(VAULT.FIND$(target$, "AUTOMATEWORK_NOT_SET", ""), "", "and without a prompt answers nothing")

TESTKIT.SUITE("written down secrets")
TESTKIT.EQ(TRAIL.TARGET$("mail"), "AutomateWork/mail", "every secret has the AutomateWork prefix")
DIM known = TRAIL.KNOWN(["vpn", "mail"])
TESTKIT.EQ(LEN(known), 3, "the book's two secrets and one extra")
TESTKIT.ISTRUE(TRAIL.LEAKY("password = " + Q$ + "hunter2" + Q$), "a password in a settings file")
TESTKIT.ISTRUE(TRAIL.LEAKY("DIM API_KEY$ = " + Q$ + "abc" + Q$), "an API key in a script")
TESTKIT.ISFALSE(TRAIL.LEAKY("DIM pw$ = VAULT.GET$(" + Q$ + "AutomateWork/mail" + Q$ + ")"), "a read from the vault is fine")
TESTKIT.ISFALSE(TRAIL.LEAKY("token = " + Q$ + Q$), "an empty value is fine")
TESTKIT.EQ(TRAIL.MASK$("pass = " + Q$ + "x1" + Q$), "pass = " + Q$ + "****" + Q$, "the value is masked")
DIM conf$ = "[mail]" + LF$ + "server = " + Q$ + "smtp://mail" + Q$ + LF$
conf$ = conf$ + "password = " + Q$ + "Summer2026" + Q$ + LF$
TXTWRITER PATH.JOIN$(folder$, "old.conf"), conf$
TXTWRITER PATH.JOIN$(folder$, "clean.jdb"), "PRINT 1" + LF$
MKDIR PATH.JOIN$(folder$, "sub")
TXTWRITER PATH.JOIN$(folder$, "sub", "deploy.bat"), "set TOKEN=" + Q$ + "abc123" + Q$ + LF$
TXTWRITER PATH.JOIN$(folder$, "photo.png"), "password = " + Q$ + "no" + Q$
DIM hits = TRAIL.SCAN(folder$)
TESTKIT.EQ(LEN(hits), 2, "the scan finds both, in sub folders too, and skips pictures")
DIM hit = hits[0]
TESTKIT.EQ(hit{"line"}, 3, "with the line number")
TESTKIT.ISTRUE(INSTR(hit{"text"}, "Summer2026") < 0, "and never prints the secret")

TESTKIT.SUITE("the audit trail")
DIM trail$ = PATH.JOIN$(folder$, "audit.log")
DIM key$ = TRAIL.NEW_KEY$()
TESTKIT.ISTRUE(LEN(key$) >= 40, "a long random key")
DIM s1 = AUDIT.APPEND(trail$, key$, {"job": "backup", "ok": TRUE})
DIM s2 = AUDIT.APPEND(trail$, key$, {"job": "backup", "ok": FALSE})
DIM s3 = AUDIT.APPEND(trail$, key$, {"job": "report", "ok": TRUE})
TESTKIT.EQ(s3, 3, "entries are numbered")
DIM whole = AUDIT.VERIFY(trail$, key$)
TESTKIT.ISTRUE(whole{"ok"}, "an untouched trail is whole")
DIM other = AUDIT.VERIFY(trail$, "another key")
TESTKIT.ISFALSE(other{"ok"}, "another key does not fit")
DIM summary = TRAIL.SUMMARY(AUDIT.ENTRIES(trail$), "2000-01-01")
TESTKIT.EQ(summary{"backup"}{"runs"}, 2, "the summary counts the runs")
TESTKIT.EQ(summary{"backup"}{"fails"}, 1, "and the failures")
DIM report = TRAIL.REPORT_LINES(whole, summary)
DIM report_head$ = report[0]
TESTKIT.EQ(report_head$, "The audit trail is whole: 3 entries.", "the report starts with the verdict")
DIM lines = AUDIT.LINES(trail$)
DIM one$ = lines[0]
DIM two$ = lines[1]
DIM three$ = lines[2]
DIM dot = INSTR(two$, ".")
DIM forged$ = LEFT$(two$, dot + 5) + "x" + MID$(two$, dot + 6, LEN(two$))
TXTWRITER trail$, one$ + LF$ + forged$ + LF$ + three$ + LF$
DIM changed = AUDIT.VERIFY(trail$, key$)
TESTKIT.ISFALSE(changed{"ok"}, "a changed line is found")
TXTWRITER trail$, one$ + LF$ + three$ + LF$
DIM removed = AUDIT.VERIFY(trail$, key$)
TESTKIT.ISFALSE(removed{"ok"}, "so is a removed line")
DIM gaps = TRAIL.REPORT_LINES(removed, summary)
DIM gap_head$ = gaps[0]
TESTKIT.EQ(gap_head$, "The audit trail was changed:", "and the report says so")

OS.EXEC("cmd", ["/c", "rmdir", "/s", "/q", folder$])
TESTKIT.REPORT()
