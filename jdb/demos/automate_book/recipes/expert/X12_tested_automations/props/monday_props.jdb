' Properties of Monday's reports: the week of the Report Pipeline
' (X09) and the weeks of the Timesheet for the Boss (M15), checked
' against hundreds of drawn days, amounts and logs. The test runner
' puts both recipe folders on the module search path.

IMPORT TESTKIT, PROPTEST, PIPELINE, TIMESHEET, DF

DIM gStart = CDATE("2026-01-01 12:00:00")
DIM gCenters = ["Sales", "Marketing", "IT", "Travel"]
DIM gSeed = {"seed": 20261005, "runs": 200}

FUNC Day$(offset)
    RETURN FORMAT_DATE(DATEADD("D", offset, gStart), "%Y-%m-%d")
ENDFUNC

FUNC Noon(day$)
    RETURN CDATE(day$ + " 12:00:00")
ENDFUNC

FUNC DayOfWeek(day$)
    RETURN VAL(FORMAT_DATE(Noon(day$), "%w"))
ENDFUNC

FUNC WeekIsBefore(offset)
    DIM day$ = Day$(offset)
    DIM week = PIPELINE.LAST_WEEK(day$)
    IF DayOfWeek(week{"from"}) <> 1 THEN RETURN FALSE
    DIM span = DATEDIFF("D", Noon(week{"from"}), Noon(week{"to"}))
    DIM gap = DATEDIFF("D", Noon(week{"to"}), Noon(day$))
    RETURN span = 6 ANDALSO gap >= 1 ANDALSO gap <= 7
ENDFUNC

FUNC RecipesAgree(offset)
    DIM day$ = Day$(offset)
    DIM week = PIPELINE.LAST_WEEK(day$)
    DIM next_monday = DATEADD("D", 7, Noon(week{"from"}))
    DIM m15$ = TIMESHEET.MONDAY$(day$)
    RETURN FORMAT_DATE(next_monday, "%Y-%m-%d") = m15$
ENDFUNC

FUNC MoneyReadsBack(cents)
    DIM text$ = PIPELINE.MONEY$(cents / 100)
    DIM back = VAL(REPLACE$(text$, ",", ""))
    RETURN ABS(back - cents / 100) < 0.001
ENDFUNC

FUNC NothingLost(amounts)
    DIM rows = []
    DIM k = 0
    FOR k = 0 TO LEN(amounts) - 1
        DIM cc$ = gCenters[k MOD 4]
        PUSH(rows, {"day": "2026-10-01", "cost_center": cc$, _
            "amount": amounts[k]})
    NEXT k
    DIM budgets = {"Sales": 4000, "IT": 3000}
    DIM report = PIPELINE.REPORT(rows, budgets)
    RETURN SUM(DF.COL(report, "spent")) = SUM(amounts)
ENDFUNC

FUNC MonthAddsUp(quarters)
    DIM sessions = []
    DIM k = 0
    FOR k = 0 TO LEN(quarters) - 1
        DIM start = DATEADD("D", k, CDATE("2026-09-25 09:00:00"))
        DIM finish = DATEADD("N", 15 * quarters[k], start)
        DIM s$ = FORMAT_DATE(start, "%Y-%m-%d %H:%M:%S")
        DIM e$ = FORMAT_DATE(finish, "%Y-%m-%d %H:%M:%S")
        PUSH(sessions, {"project": gCenters[k MOD 4], "start": s$, _
            "stop": e$})
    NEXT k
    DIM now$ = "2026-11-02 08:00:00"
    DIM totals = TIMESHEET.MONTH_TOTALS(sessions, "2026-10", now$)
    DIM month_sum = 0.0
    DIM names = MAP.KEYS(totals)
    FOR k = 0 TO LEN(names) - 1
        month_sum = month_sum + totals{names[k]}
    NEXT k
    DIM week_sum = 0.0
    DIM mondays = TIMESHEET.WEEKS("2026-10")
    DIM w = 0
    FOR w = 0 TO LEN(mondays) - 1
        DIM table = TIMESHEET.WEEK_HOURS(sessions, mondays[w], _
            "2026-10", now$)
        DIM projects = MAP.KEYS(table)
        FOR k = 0 TO LEN(projects) - 1
            week_sum = week_sum + SUM(table{projects[k]})
        NEXT k
    NEXT w
    RETURN ABS(month_sum - week_sum) < 0.001
ENDFUNC

TESTKIT.SUITE("Monday's report (X09)")
PROPTEST.FORALL("the week reported is the week before", _
    "int:0..1500", WeekIsBefore@, gSeed)
PROPTEST.FORALL("an amount reads back as written", _
    "int:-100000000..100000000", MoneyReadsBack@, gSeed)
PROPTEST.FORALL("no booking is lost on the way to the report", _
    "list(int:0..5000,0..40)", NothingLost@, gSeed)

TESTKIT.SUITE("two recipes, one calendar (X09 and M15)")
PROPTEST.FORALL("X09 and M15 agree on the Monday", _
    "int:0..1500", RecipesAgree@, gSeed)
PROPTEST.FORALL("the weeks of a timesheet add up to its month", _
    "list(int:0..40,0..45)", MonthAddsUp@, gSeed)

TESTKIT.REPORT()
