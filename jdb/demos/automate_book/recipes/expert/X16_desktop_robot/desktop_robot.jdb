' Desktop Robot: works a desktop program that has no import and no
' interface for other programs, the way a person would, from a job
' file. The settings are the [desktop_robot] part of work.conf.
'
'   jdbasic desktop_robot.jdb            run the job after a countdown
'   jdbasic desktop_robot.jdb --dry-run  show the steps of the job
'   jdbasic desktop_robot.jdb --job other.toml   another job file

IMPORT WORKCONF, LOGGER, INPUTKIT, ROBOT

DIM cfg = WORKCONF.SETTINGS(WORKCONF.CONFIG_PATH$())
DIM key$ = "desktop_robot."
DIM home$ = "~/Documents/AutomateWork"
DIM job_home$ = home$ + "/robot/order_entry.toml"
DIM job_path$ = WORKCONF.FOLDER$(cfg, key$ + "job", job_home$)
IF WORKCONF.ARG$("job") <> "" THEN
    job_path$ = WORKCONF.EXPAND$(WORKCONF.ARG$("job"))
ENDIF
DIM wait_s = WORKCONF.VALUE(cfg, key$ + "countdown", 5)
DIM dry_run = WORKCONF.FLAG("dry-run")

DIM work$ = WORKCONF.FOLDER$(cfg, "paths.work", home$)
DIM logs$ = PATH.JOIN$(work$, "logs")
MKDIR logs$
DIM lg = LOGGER.NEW("desktop_robot")
LOGGER.TO_CONSOLE(lg, FALSE)
LOGGER.TO_FILE(lg, PATH.JOIN$(logs$, "desktop_robot.log"))

DIM job = ROBOT.LOAD(job_path$)
DIM errors = job{"errors"}
IF LEN(errors) > 0 THEN
    PRINT "The job has mistakes:"
    PRINT "  "; JOIN(errors, CHR$(10) + "  ")
    END 1
ENDIF
DIM plan = ROBOT.PLAN_LINES(job)
IF dry_run THEN
    DIM title$ = job{"window"}
    PRINT "Job "; PATH.BASENAME$(job_path$); " for '"; title$; "':"
    PRINT "  "; JOIN(plan, CHR$(10) + "  ")
    PRINT LEN(plan); " steps. Without --dry-run the robot runs them."
    END
ENDIF

LOGGER.INFO(lg, "job started", {"job": job_path$})
INPUTKIT.COUNTDOWN(wait_s)
DIM r = ROBOT.RUN(job, lg, logs$)
IF NOT r{"ok"} THEN
    DIM why = {"step": r{"step"}, "why": r{"why"}}
    LOGGER.ERROR(lg, "job stopped", why)
    END 1
ENDIF
LOGGER.INFO(lg, "job done", {"steps": LEN(plan)})
