' OUTBOX: a message goes into the outbox as an .eml file, the sender and
' server come from [mail], the curl arguments reach To and Cc, and a
' server that does not answer leaves the message where it is.

IMPORT TESTKIT, OUTBOX, MAIL, CONF

DIM LF$ = CHR$(10)
DIM Q$ = CHR$(34)
DIM folder$ = MKTEMP$("outboxtest")
DIM box$ = REPLACE$(PATH.JOIN$(folder$, "outbox"), "\", "/")
DIM toml$ = "[user]" + LF$ + "name = " + Q$ + "Jonas Example" + Q$ + LF$
toml$ = toml$ + "email = " + Q$ + "jonas@example.com" + Q$ + LF$
toml$ = toml$ + "[mail]" + LF$ + "server = " + Q$ + "smtp://127.0.0.1:1" + Q$ + LF$
toml$ = toml$ + "user = " + Q$ + "jonas" + Q$ + LF$
toml$ = toml$ + "outbox = " + Q$ + box$ + Q$ + LF$
DIM cfg = CONF.TOML_TEXT(toml$)

FUNC NoServer(x)
    RETURN OUTBOX.SERVER(CONF.TOML_TEXT("[mail]"), "pw")
ENDFUNC

TESTKIT.SUITE("settings")
TESTKIT.EQ(OUTBOX.FROM$(cfg), "Jonas Example <jonas@example.com>", "the sender from [user]")
TESTKIT.EQ(OUTBOX.FOLDER$(cfg), box$, "the outbox from [mail]")
DIM server = OUTBOX.SERVER(cfg, "secret")
TESTKIT.EQ(server{"url"}, "smtp://127.0.0.1:1", "the server")
TESTKIT.EQ(server{"password"}, "secret", "and the password given, not read")
TESTKIT.THROWS(NoServer@, 0, "a missing server is an error")

TESTKIT.SUITE("the outbox")
DIM msg = MAIL.MESSAGE(OUTBOX.FROM$(cfg), "anna@example.com", "Status")
MAIL.CC(msg, "boss@example.com")
MAIL.PLAIN(msg, "All on track.")
DIM path$ = OUTBOX.PUT$(msg, cfg, "status.eml")
TESTKIT.ISTRUE(FILE.EXISTS(path$), "the message is in the outbox")
TESTKIT.EQ(LEN(OUTBOX.PENDING(cfg)), 1, "and waits there")
DIM args = OUTBOX.SEND_ARGS(path$, server, "cfg.txt")
DIM joined$ = JOIN(args, " ")
TESTKIT.ISTRUE(INSTR(joined$, "--mail-from jonas@example.com") >= 0, "the sender is the bare address")
TESTKIT.ISTRUE(INSTR(joined$, "--mail-rcpt anna@example.com") >= 0, "To is a recipient")
TESTKIT.ISTRUE(INSTR(joined$, "--mail-rcpt boss@example.com") >= 0, "and Cc")
TESTKIT.ISTRUE(INSTR(joined$, "--upload-file " + path$) >= 0, "the file is sent as it is")
TESTKIT.ISTRUE(INSTR(joined$, "secret") < 0, "the password is not on the command line")
DIM dry = OUTBOX.DRY_SEND(cfg)
TESTKIT.EQ(dry{"sent"}, 0, "a dry run sends nothing")
TESTKIT.ISTRUE(FILE.EXISTS(path$), "and leaves the message where it is")
DIM r = OUTBOX.SEND_ALL(cfg, "secret")
TESTKIT.EQ(r{"sent"}, 0, "nothing goes out without a server")
TESTKIT.EQ(LEN(r{"failed"}), 1, "the failure is reported")
TESTKIT.ISTRUE(FILE.EXISTS(path$), "and the message stays in the outbox")

TESTKIT.SUITE("sending with Outlook")
TESTKIT.EQ(OUTBOX.SENDS_WITH$(cfg), "smtp", "SMTP is the default")
DIM empty$ = REPLACE$(PATH.JOIN$(folder$, "empty"), "\", "/")
DIM ol_toml$ = "[mail]" + LF$ + "send_with = " + Q$ + "Outlook" + Q$ + LF$
ol_toml$ = ol_toml$ + "outbox = " + Q$ + empty$ + Q$ + LF$
DIM ol_cfg = CONF.TOML_TEXT(ol_toml$)
TESTKIT.EQ(OUTBOX.SENDS_WITH$(ol_cfg), "outlook", "send_with chooses Outlook")
TESTKIT.EQ(OUTBOX.ASK$(ol_cfg), "", "and no password is asked for")
DIM none = OUTBOX.SEND_ALL(ol_cfg, "")
TESTKIT.EQ(none{"sent"}, 0, "an empty outbox leaves Outlook alone")
TESTKIT.EQ(LEN(none{"failed"}), 0, "and nothing fails")

TESTKIT.SUITE("a refused password and a missing sender")
FUNC NoSender(x)
    DIM bare = MAIL.MESSAGE("", "anna@example.com", "Status")
    RETURN OUTBOX.PUT$(bare, cfg, "nosender.eml")
ENDFUNC
TESTKIT.THROWS(NoSender@, 0, "a message without a sender is refused")
TESTKIT.ISTRUE(NOT FILE.EXISTS(PATH.JOIN$(box$, "nosender.eml")), "and not written")
DIM quiet$ = REPLACE$(PATH.JOIN$(folder$, "quiet"), "\", "/")
DIM quiet_cfg = CONF.TOML_TEXT("[mail]" + LF$ + "outbox = " + Q$ + quiet$ + Q$ + LF$)
TESTKIT.EQ(OUTBOX.ASK$(quiet_cfg), "", "an empty outbox asks for no password")

' A server that refuses every login: three mails cost one failed login,
' the other two are not tried. The server is a second jdBasic process.
IF OS.FEATURE("INTERPRETER") THEN
    DIM stub$ = PATH.JOIN$(folder$, "refuse.jdb")
    DIM log$ = PATH.JOIN$(folder$, "logins.txt")
    DIM s$ = "DIM l = NET.LISTEN(0, " + Q$ + "127.0.0.1" + Q$ + ")" + LF$
    s$ = s$ + "TXTWRITER " + Q$ + REPLACE$(log$, "\", "/") + ".port" + Q$ + ", STR$(NET.PORT(l))" + LF$
    s$ = s$ + "DIM logins = 0" + LF$
    s$ = s$ + "DO" + LF$
    s$ = s$ + "    DIM c = NET.ACCEPT(l, 8000)" + LF$
    s$ = s$ + "    IF c = 0 THEN EXITDO" + LF$
    s$ = s$ + "    DIM sent = NET.SEND(c, " + Q$ + "220 stub" + Q$ + " + CHR$(13) + CHR$(10))" + LF$
    s$ = s$ + "    DO" + LF$
    s$ = s$ + "        DIM line$ = UCASE$(NET.RECVLINE$(c, 4000))" + LF$
    s$ = s$ + "        IF line$ = " + Q$ + Q$ + " THEN EXITDO" + LF$
    s$ = s$ + "        IF LEFT$(line$, 4) = " + Q$ + "EHLO" + Q$ + " THEN sent = NET.SEND(c, " + Q$ + "250-stub" + Q$ + " + CHR$(13) + CHR$(10) + " + Q$ + "250 AUTH PLAIN LOGIN" + Q$ + " + CHR$(13) + CHR$(10))" + LF$
    s$ = s$ + "        IF LEFT$(line$, 4) = " + Q$ + "AUTH" + Q$ + " THEN" + LF$
    s$ = s$ + "            logins = logins + 1" + LF$
    s$ = s$ + "            sent = NET.SEND(c, " + Q$ + "535 denied" + Q$ + " + CHR$(13) + CHR$(10))" + LF$
    s$ = s$ + "        ENDIF" + LF$
    s$ = s$ + "        IF LEFT$(line$, 4) = " + Q$ + "QUIT" + Q$ + " THEN EXITDO" + LF$
    s$ = s$ + "    LOOP" + LF$
    s$ = s$ + "    DIM closed = NET.CLOSE(c)" + LF$
    s$ = s$ + "    TXTWRITER " + Q$ + REPLACE$(log$, "\", "/") + Q$ + ", STR$(logins)" + LF$
    s$ = s$ + "LOOP" + LF$
    TXTWRITER stub$, s$
    DIM pid = OS.SPAWN(OS.SELF$(), [stub$])
    DIM waited = 0
    DO WHILE NOT FILE.EXISTS(log$ + ".port") ANDALSO waited < 50
        SLEEP 100
        waited = waited + 1
    LOOP
    DIM port$ = TRIM$(TXTREADER$(log$ + ".port"))
    DIM deny$ = REPLACE$(PATH.JOIN$(folder$, "deny"), "\", "/")
    DIM d$ = "[user]" + LF$ + "name = " + Q$ + "Jonas" + Q$ + LF$
    d$ = d$ + "email = " + Q$ + "jonas@example.com" + Q$ + LF$
    d$ = d$ + "[mail]" + LF$ + "server = " + Q$ + "smtp://127.0.0.1:" + port$ + Q$ + LF$
    d$ = d$ + "user = " + Q$ + "jonas" + Q$ + LF$
    d$ = d$ + "outbox = " + Q$ + deny$ + Q$ + LF$
    DIM deny_cfg = CONF.TOML_TEXT(d$)
    DIM m = 0
    FOR m = 1 TO 3
        DIM dm = MAIL.MESSAGE(OUTBOX.FROM$(deny_cfg), "anna@example.com", "Mail " + STR$(m))
        MAIL.PLAIN(dm, "text")
        DIM put$ = OUTBOX.PUT$(dm, deny_cfg, "m" + STR$(m) + ".eml")
    NEXT m
    DIM denied = OUTBOX.SEND_ALL(deny_cfg, "wrong")
    DIM ended = OS.KILL(pid)
    TESTKIT.EQ(denied{"sent"}, 0, "nothing is sent with a refused password")
    TESTKIT.EQ(LEN(denied{"failed"}), 3, "every mail is reported")
    TESTKIT.ISTRUE(INSTR(denied{"failed"}[2], "not tried") >= 0, "the later ones as not tried")
    TESTKIT.EQ(TRIM$(TXTREADER$(log$)), "1", "the server saw one login, not three")
    TESTKIT.EQ(LEN(OUTBOX.PENDING(deny_cfg)), 3, "and all three still wait")
ELSE
    TESTKIT.SKIP("the refusing server runs as a second jdBasic process")
ENDIF

OS.EXEC("cmd", ["/c", "rmdir", "/s", "/q", folder$])
TESTKIT.REPORT()
