' outbox.jdb: the mail rule of the book's recipes. A recipe puts its
' messages as .eml files into the outbox folder; sending happens only
' when a person runs a recipe with --send and types the password, or
' has stored it in the Windows Credential Manager; it is never written
' into a settings file. The server comes from the [mail] part of
' work.conf.
'
'   IMPORT OUTBOX
'   DIM path$ = OUTBOX.PUT$(msg, cfg, "invoice-0413.eml")
'   IF WORKCONF.FLAG("send") THEN OUTBOX.SEND_ALL(cfg, OUTBOX.ASK$(cfg))
'
' A message in the outbox reaches the To and Cc addresses of its
' headers; Bcc addresses are not part of an .eml file. With [mail]
' send_with = "outlook" the outbox goes out through classic Outlook
' instead, and no password is asked for.

EXPORT MODULE OUTBOX

IMPORT WORKCONF, MAIL, VAULT, OFFICEKIT

' The outbox folder, [mail] outbox in work.conf.
EXPORT FUNC FOLDER$(cfg)
    DIM home$ = "~/Documents/AutomateWork/outbox"
    RETURN WORKCONF.FOLDER$(cfg, "mail.outbox", home$)
ENDFUNC

' The sender: [mail] from, else the user's name and address.
EXPORT FUNC FROM$(cfg)
    DIM from$ = WORKCONF.VALUE(cfg, "mail.from", "")
    IF from$ <> "" THEN RETURN from$
    DIM who$ = WORKCONF.VALUE(cfg, "user.name", "")
    DIM mail$ = WORKCONF.VALUE(cfg, "user.email", "")
    IF who$ = "" THEN RETURN mail$
    RETURN who$ + " <" + mail$ + ">"
ENDFUNC

' The server map MAIL.SEND and MAIL.COMMAND take.
EXPORT FUNC SERVER(cfg, password$)
    DIM s AS MAP
    s{"url"} = WORKCONF.VALUE(cfg, "mail.server", "")
    s{"user"} = WORKCONF.VALUE(cfg, "mail.user", "")
    s{"password"} = password$
    s{"starttls"} = WORKCONF.VALUE(cfg, "mail.starttls", FALSE)
    IF s{"url"} = "" THEN THROW "Set [mail] server in work.conf first."
    RETURN s
ENDFUNC

' Writes a message into the outbox under file_name$; answers its path.
EXPORT FUNC PUT$(msg, cfg, file_name$)
    DIM folder$ = FOLDER$(cfg)
    MKDIR folder$
    DIM path$ = PATH.JOIN$(folder$, file_name$)
    MAIL.WRITEEML(msg, path$)
    RETURN path$
ENDFUNC

' The messages waiting in the outbox, sorted by name.
EXPORT FUNC PENDING(cfg)
    DIM folder$ = FOLDER$(cfg)
    IF NOT FILE.ISDIR(folder$) THEN RETURN []
    DIM names = SORT(DIR$(PATH.JOIN$(folder$, "*.eml")))
    RETURN SELECT(LAMBDA USE(folder$) n$ -> _
        PATH.JOIN$(folder$, n$), names)
ENDFUNC

' How the outbox is sent: "smtp" (the default, through [mail] server)
' or "outlook" (through classic Outlook), from [mail] send_with.
EXPORT FUNC SENDS_WITH$(cfg)
    RETURN LCASE$(WORKCONF.VALUE(cfg, "mail.send_with", "smtp"))
ENDFUNC

' The mail password: from the Windows Credential Manager when you
' stored it there as AutomateWork/mail, otherwise asked for without
' showing what you type. Nothing is written down, and Outlook needs
' none.
EXPORT FUNC ASK$(cfg)
    IF WORKCONF.FLAG("dry-run") THEN RETURN ""
    IF SENDS_WITH$(cfg) = "outlook" THEN RETURN ""
    DIM user$ = WORKCONF.VALUE(cfg, "mail.user", "")
    DIM ask$ = "Mail password for " + user$ + ": "
    RETURN VAULT.FIND$("AutomateWork/mail", "", ask$)
ENDFUNC

' What a send would do: one line per message in the outbox, nothing
' sent. Answers {"sent": 0, "failed": []}, as a send that sent nothing.
EXPORT FUNC DRY_SEND(cfg)
    DIM files = PENDING(cfg)
    DIM k = 0
    FOR k = 0 TO LEN(files) - 1
        DIM name$ = PATH.BASENAME$(files[k])
        PRINT "would send "; name$; " ("; SENDS_WITH$(cfg); ")"
    NEXT k
    IF LEN(files) = 0 THEN PRINT "the outbox is empty"
    RETURN {"sent": 0, "failed": []}
ENDFUNC

' The curl arguments that send one .eml file of the outbox.
EXPORT FUNC SEND_ARGS(path$, server, config_path$)
    DIM parsed = MAIL.PARSEFILE(path$)
    DIM msg AS MAP
    DIM from = parsed{"from"}
    IF TYPEOF(from) = "ARRAY" THEN from = from[0]
    msg{"from"} = from
    msg{"to"} = parsed{"to"}
    msg{"cc"} = parsed{"cc"}
    msg{"bcc"} = []
    RETURN MAIL.COMMAND(msg, server, path$, config_path$)
ENDFUNC

' Sends every message of the outbox and moves each one that went out
' into outbox/sent. Answers {"sent": n, "failed": [lines]}.
EXPORT FUNC SEND_ALL(cfg, password$)
    IF WORKCONF.FLAG("dry-run") THEN RETURN DRY_SEND(cfg)
    IF SENDS_WITH$(cfg) = "outlook" THEN RETURN SEND_OUTLOOK(cfg)
    DIM server = SERVER(cfg, password$)
    DIM sent_dir$ = PATH.JOIN$(FOLDER$(cfg), "sent")
    MKDIR sent_dir$
    DIM config_path$ = MKTEMP$("outbox") + ".txt"
    DIM q$ = CHR$(34)
    DIM secret$ = server{"user"} + ":" + password$
    secret$ = REPLACE$(REPLACE$(secret$, "\", "\\"), q$, "\" + q$)
    TXTWRITER config_path$, "user = " + q$ + secret$ + q$ + CHR$(10)
    DIM files = PENDING(cfg)
    DIM failed = []
    DIM n = 0
    DIM k = 0
    FOR k = 0 TO LEN(files) - 1
        DIM args = SEND_ARGS(files[k], server, config_path$)
        DIM r = OS.EXEC("curl", args)
        IF r{"EXIT_CODE"} = 0 THEN
            FILE.MOVE(files[k], sent_dir$, TRUE)
            n = n + 1
        ELSE
            DIM why$ = TRIM$(r{"OUTPUT"})
            PUSH(failed, PATH.BASENAME$(files[k]) + ": " + why$)
        ENDIF
    NEXT k
    KILL config_path$
    RETURN {"sent": n, "failed": failed}
ENDFUNC

' Sends every message of the outbox through classic Outlook, from the
' account Outlook uses, and moves each one that went out into
' outbox/sent. Answers {"sent": n, "failed": [lines]}.
EXPORT FUNC SEND_OUTLOOK(cfg)
    IF WORKCONF.FLAG("dry-run") THEN RETURN DRY_SEND(cfg)
    DIM files = PENDING(cfg)
    DIM failed = []
    DIM n = 0
    IF LEN(files) = 0 THEN RETURN {"sent": n, "failed": failed}
    DIM sent_dir$ = PATH.JOIN$(FOLDER$(cfg), "sent")
    MKDIR sent_dir$
    DIM temp$ = MKTEMP$("outlook")
    DIM ol = CREATEOBJECT("Outlook.Application")
    DIM k = 0
    FOR k = 0 TO LEN(files) - 1
        DIM path$ = files[k]
        TRY
            DIM parsed = MAIL.PARSEFILE(path$)
            OFFICEKIT.OUTLOOK_SEND(ol, parsed, temp$)
            FILE.MOVE(path$, sent_dir$, TRUE)
            n = n + 1
        CATCH
            PUSH(failed, PATH.BASENAME$(path$) + ": " + ERRMSG$)
        ENDTRY
    NEXT k
    RELEASEOBJECT(ol)
    IF FILE.ISDIR(temp$) THEN
        DIM gone$ = REPLACE$(temp$, "/", "\")
        OS.EXEC("cmd", ["/c", "rmdir", "/s", "/q", gone$])
    ENDIF
    RETURN {"sent": n, "failed": failed}
ENDFUNC
