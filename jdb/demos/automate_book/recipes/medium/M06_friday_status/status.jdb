' status.jdb: the weekly status of a team from one notes file per
' person, as a plain text and an HTML mail. A note is a check box
' line: "- [x]" done, "- [ ]" still to do, "- [!]" blocked.
'
'   IMPORT STATUS
'   DIM people = STATUS.NOTES("C:/Team/status")
'   PRINT STATUS.PLAIN$(people, "2026-W43")

EXPORT MODULE STATUS

IMPORT TMPL, DT

DIM gLF$ = CHR$(10)

' The notes of one file: a map with "done", "todo" and "blocked",
' each a list of texts in the order of the file.
EXPORT FUNC READ_NOTES(text$)
    DIM out = {"done": [], "todo": [], "blocked": []}
    DIM rows = SPLIT(REPLACE$(text$, CHR$(13), ""), gLF$)
    DIM k = 0
    FOR k = 0 TO LEN(rows) - 1
        DIM t$ = TRIM$(rows[k])
        DIM box$ = LCASE$(LEFT$(t$, 5))
        DIM what$ = TRIM$(MID$(t$, 5, LEN(t$)))
        DIM kind$ = ""
        IF box$ = "- [x]" THEN kind$ = "done"
        IF box$ = "- [ ]" THEN kind$ = "todo"
        IF box$ = "- [!]" THEN kind$ = "blocked"
        IF kind$ <> "" ANDALSO what$ <> "" THEN
            DIM items = out{kind$}
            PUSH(items, what$)
        ENDIF
    NEXT k
    RETURN out
ENDFUNC

' The text of a notes file in the encoding it was saved in: UTF-8
' with or without a byte order mark, UTF-16, or the Windows ANSI
' code page an older editor writes.
EXPORT FUNC READ$(path$)
    RETURN TXTREADER$(path$, TXTENCODING$(path$))
ENDFUNC

' Every person of the notes folder, one per .txt file and named after
' it, sorted by name: maps with "person", "done", "todo", "blocked".
' With a week, the done notes cleared earlier that week count too.
EXPORT FUNC NOTES(folder$, week$ = "")
    DIM out = []
    DIM files = SORT(FILE.LIST(PATH.JOIN$(folder$, "*.txt")))
    DIM k = 0
    FOR k = 0 TO LEN(files) - 1
        DIM file$ = files[k]
        DIM text$ = READ$(PATH.JOIN$(folder$, file$))
        DIM kept$ = PATH.JOIN$(DONE_FOLDER$(folder$, week$), file$)
        IF week$ <> "" ANDALSO FILE.EXISTS(kept$) THEN
            text$ = text$ + gLF$ + READ$(kept$)
        ENDIF
        DIM n = READ_NOTES(text$)
        DIM ext$ = PATH.EXT$(file$)
        n{"person"} = LEFT$(file$, LEN(file$) - LEN(ext$))
        PUSH(out, n)
    NEXT k
    RETURN out
ENDFUNC

' The ISO week of a day, such as 2026-W43.
EXPORT FUNC WEEK$(t)
    DIM w = DT.ISOWEEK(t)
    RETURN STR$(w{"year"}) + "-W" + RIGHT$("0" + STR$(w{"week"}), 2)
ENDFUNC

' How many notes of a kind all people have together.
EXPORT FUNC TOTAL(people, kind$)
    RETURN SUM(SELECT(LAMBDA USE(kind$) p -> LEN(p{kind$}), people))
ENDFUNC

SUB AddList(out, title$, items)
    IF LEN(items) = 0 THEN RETURN
    PUSH(out, "  " + title$)
    DIM k = 0
    FOR k = 0 TO LEN(items) - 1
        PUSH(out, "    - " + items[k])
    NEXT k
ENDSUB

' The mail as plain text: a summary line, then each person with the
' blocked notes first, the open ones next and the done ones last.
EXPORT FUNC PLAIN$(people, week$)
    DIM out = ["Status " + week$, ""]
    DIM info$ = STR$(TOTAL(people, "done")) + " done, "
    info$ = info$ + STR$(TOTAL(people, "todo")) + " open, "
    PUSH(out, info$ + STR$(TOTAL(people, "blocked")) + " blocked.")
    DIM k = 0
    FOR k = 0 TO LEN(people) - 1
        DIM p = people[k]
        PUSH(out, "")
        PUSH(out, p{"person"})
        AddList(out, "Blocked:", p{"blocked"})
        AddList(out, "Open:", p{"todo"})
        AddList(out, "Done:", p{"done"})
    NEXT k
    RETURN JOIN(out, gLF$) + gLF$
ENDFUNC

' The mail as HTML from a TMPL template that sees "week", "people"
' and the totals "done", "todo" and "blocked".
EXPORT FUNC HTML$(people, week$, template$)
    DIM m AS MAP
    m{"week"} = week$
    m{"people"} = people
    m{"done"} = TOTAL(people, "done")
    m{"todo"} = TOTAL(people, "todo")
    m{"blocked"} = TOTAL(people, "blocked")
    RETURN TMPL.RENDER$(template$, m)
ENDFUNC

' Where the done notes of a week are kept once they are cleared.
EXPORT FUNC DONE_FOLDER$(folder$, week$)
    RETURN PATH.JOIN$(folder$, "done", week$)
ENDFUNC

' Only the done lines of the notes.
EXPORT FUNC ONLY_DONE$(text$)
    DIM rows = SPLIT(REPLACE$(text$, CHR$(13), ""), gLF$)
    DIM done = FILTER(LAMBDA r$ -> _
        LCASE$(LEFT$(TRIM$(r$), 5)) = "- [x]", rows)
    RETURN JOIN(done, gLF$)
ENDFUNC

' The notes with the done ones taken out, for the next week.
EXPORT FUNC WITHOUT_DONE$(text$)
    DIM rows = SPLIT(REPLACE$(text$, CHR$(13), ""), gLF$)
    DIM kept = FILTER(LAMBDA r$ -> _
        LCASE$(LEFT$(TRIM$(r$), 5)) <> "- [x]", rows)
    RETURN JOIN(kept, gLF$)
ENDFUNC
