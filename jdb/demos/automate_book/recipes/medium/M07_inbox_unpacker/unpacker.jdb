' unpacker.jdb: the attachments of saved mails (.eml files) filed into
' folders by sender, then by day and subject:
' Anna Miller/2026-10-23 Invoice October/invoice.pdf.
'
'   IMPORT UNPACKER
'   DIM plan = UNPACKER.PLAN("C:/Mail/saved", "C:/Mail/files", FALSE)
'   PRINT UNPACKER.APPLY(plan, FALSE, "C:/Mail/saved/done")

EXPORT MODULE UNPACKER

IMPORT MAIL, DT

' A text that can be a file or folder name on Windows: the characters
' Windows forbids become spaces, runs of spaces one, and it is cut to
' max_chars characters.
EXPORT FUNC SAFE$(text$, max_chars)
    DIM bad = ["\", "/", ":", "*", "?", CHR$(34), "<", ">", "|"]
    DIM t$ = REDUCE(LAMBDA acc$, b$ -> REPLACE$(acc$, b$, " "), bad, _
        text$)
    t$ = REGEX.REPLACE$("[\x00-\x1f]", t$, " ")
    t$ = TRIM$(REGEX.REPLACE$(" +", t$, " "))
    DIM chars = -t$
    IF LEN(chars) > max_chars THEN
        t$ = TRIM$(JOIN(TAKE(max_chars, chars), ""))
    ENDIF
    DO WHILE RIGHT$(t$, 1) = "."
        t$ = LEFT$(t$, LEN(t$) - 1)
    LOOP
    IF t$ = "" THEN t$ = "unnamed"
    RETURN t$
ENDFUNC

' The sender's name, or the bare address when the mail has no name.
EXPORT FUNC SENDER$(parsed)
    DIM from$ = parsed{"from"}
    DIM who$ = MAIL.ADDRESSNAME$(from$)
    IF who$ = "" THEN who$ = MAIL.BAREADDRESS$(from$)
    IF who$ = "" THEN who$ = "unknown sender"
    RETURN SAFE$(who$, 50)
ENDFUNC

' The sending day of the mail as YYYY-MM-DD in the offset given, or
' "undated" for a mail without a readable date.
EXPORT FUNC DAY$(parsed, offset)
    DIM t = DT.PARSE(parsed{"date"})
    IF TYPEOF(t) = "NONE" THEN RETURN "undated"
    RETURN DT.FMT$(t, "%Y-%m-%d", offset)
ENDFUNC

' The offset of this computer on the day the mail was sent, so a mail
' from the summer gets its summer day also in winter; 0 without a
' readable date.
EXPORT FUNC OFFSET_OF(parsed)
    DIM t = DT.PARSE(parsed{"date"})
    IF TYPEOF(t) = "NONE" THEN RETURN 0
    RETURN DT.OFFSET_AT(t)
ENDFUNC

' The folder for one mail: sender, then day and subject.
EXPORT FUNC FOLDER$(parsed, target$, offset)
    DIM subject$ = parsed{"subject"}
    IF TRIM$(subject$) = "" THEN subject$ = "no subject"
    DIM inner$ = DAY$(parsed, offset) + " " + SAFE$(subject$, 60)
    RETURN PATH.JOIN$(target$, SENDER$(parsed), inner$)
ENDFUNC

' A file name for an attachment: the name and its ending made safe
' apart, so "a/b:c?.pdf" becomes "a b c.pdf", and an ending from the
' type when the name has none, such as "unnamed.pdf".
EXPORT FUNC FILE_NAME$(name$, mime$)
    DIM ext$ = LCASE$(PATH.EXT$(TRIM$(name$)))
    IF NOT REGEX.MATCH("^\.[a-z0-9]{1,8}$", ext$) THEN ext$ = ""
    DIM stem$ = LEFT$(TRIM$(name$), LEN(TRIM$(name$)) - LEN(ext$))
    DIM endings = {"application/pdf": ".pdf", "image/jpeg": ".jpg", _
        "image/png": ".png", "text/plain": ".txt", _
        "text/calendar": ".ics", "application/zip": ".zip", _
        "message/rfc822": ".eml"}
    DIM kind$ = LCASE$(mime$)
    IF ext$ = "" ANDALSO MAP.EXISTS(endings, kind$) THEN
        ext$ = endings{kind$}
    ENDIF
    RETURN SAFE$(stem$, 80) + ext$
ENDFUNC

FUNC FreeName$(folder$, file$, taken)
    DIM candidate$ = PATH.JOIN$(folder$, file$)
    DIM used = FILE.EXISTS(candidate$) ORELSE candidate$ IN taken
    IF NOT used THEN RETURN candidate$
    DIM ext$ = PATH.EXT$(file$)
    DIM stem$ = LEFT$(file$, LEN(file$) - LEN(ext$))
    DIM n = 2
    DO
        DIM alt$ = stem$ + " (" + STR$(n) + ")" + ext$
        candidate$ = PATH.JOIN$(folder$, alt$)
        n = n + 1
    LOOP WHILE FILE.EXISTS(candidate$) ORELSE candidate$ IN taken
    RETURN candidate$
ENDFUNC

' TRUE for an attachment that is a mail itself, as Outlook on the web
' attaches one when you forward a mail as an attachment.
FUNC IsMail(parsed, j)
    DIM kind$ = LCASE$(parsed{"att_mimes"}[j])
    DIM ext$ = LCASE$(PATH.EXT$(parsed{"att_names"}[j]))
    RETURN kind$ = "message/rfc822" ORELSE ext$ = ".eml"
ENDFUNC

' Adds the attachments of one mail to files: pictures shown inside its
' text are left out unless keep_inline is TRUE. inner is the position
' of the attached mail they come from, -1 for the saved mail itself,
' whose attached mails are filed on their own.
SUB AddFiles(files, taken, parsed, eml$, inner, target$, keep_inline)
    DIM folder$ = FOLDER$(parsed, target$, OFFSET_OF(parsed))
    DIM att = parsed{"att_names"}
    DIM mimes = parsed{"att_mimes"}
    DIM cids = parsed{"att_cids"}
    DIM html$ = LCASE$(parsed{"html"})
    DIM j = 0
    FOR j = 0 TO LEN(att) - 1
        DIM cid$ = cids[j]
        IF INSTR(html$, "cid:" + LCASE$(cid$)) < 0 THEN cid$ = ""
        DIM wanted = keep_inline ORELSE cid$ = ""
        IF inner < 0 ANDALSO IsMail(parsed, j) THEN wanted = FALSE
        IF wanted THEN
            DIM file$ = FILE_NAME$(att[j], mimes[j])
            DIM to$ = FreeName$(folder$, file$, taken)
            PUSH(taken, to$)
            DIM short$ = MID$(to$, LEN(target$) + 1, LEN(to$))
            PUSH(files, {"eml": eml$, "inner": inner, "index": j, _
                "to": to$, "short": short$})
        ENDIF
    NEXT j
ENDSUB

' What to do with the .eml files of the inbox folder: a map with
' "files" (one map per attachment with "eml", "inner", "index", "to"
' and "short", the path below the target folder) and "mails" (every
' mail looked at). A mail attached to a saved mail is filed like a
' saved mail of its own: its sender, its day, its attachments.
EXPORT FUNC PLAN(inbox$, target$, keep_inline)
    DIM files = []
    DIM mails = []
    DIM taken = []
    DIM names = SORT(FILE.LIST(PATH.JOIN$(inbox$, "*.eml")))
    DIM k = 0
    DIM j = 0
    FOR k = 0 TO LEN(names) - 1
        DIM eml$ = PATH.JOIN$(inbox$, names[k])
        DIM parsed = MAIL.PARSEFILE(eml$)
        PUSH(mails, eml$)
        AddFiles(files, taken, parsed, eml$, -1, target$, keep_inline)
        DIM n_att = LEN(parsed{"att_names"})
        FOR j = 0 TO n_att - 1
            IF IsMail(parsed, j) THEN
                DIM raw$ = MAIL.ATTACHMENTDATA$(parsed, j)
                AddFiles(files, taken, MAIL.PARSE(raw$), eml$, j, _
                    target$, keep_inline)
            ENDIF
        NEXT j
    NEXT k
    RETURN {"files": files, "mails": mails}
ENDFUNC

' Saves the attachments of the plan and moves every mail it looked at
' into done_folder$; with dry_run it only prints. Answers the number
' of attachments.
EXPORT FUNC APPLY(plan, dry_run, done_folder$)
    DIM files = plan{"files"}
    DIM k = 0
    DIM last$ = ""
    DIM parsed = {}
    FOR k = 0 TO LEN(files) - 1
        DIM f = files[k]
        DIM to$ = f{"to"}
        IF dry_run THEN
            PRINT "would save "; f{"short"}
        ELSE
            IF f{"eml"} <> last$ THEN
                parsed = MAIL.PARSEFILE(f{"eml"})
                last$ = f{"eml"}
            ENDIF
            DIM source = parsed
            IF f{"inner"} >= 0 THEN
                DIM raw$ = MAIL.ATTACHMENTDATA$(parsed, f{"inner"})
                source = MAIL.PARSE(raw$)
            ENDIF
            MKDIR PATH.DIRNAME$(to$)
            MAIL.SAVEATTACHMENT(source, f{"index"}, to$)
            PRINT "saved "; f{"short"}
        ENDIF
    NEXT k
    IF NOT dry_run THEN
        MKDIR done_folder$
        DIM mails = plan{"mails"}
        FOR k = 0 TO LEN(mails) - 1
            DIM eml$ = mails[k]
            DIM base$ = PATH.BASENAME$(eml$)
            DIM dest$ = FreeName$(done_folder$, base$, [])
            FILE.MOVE(eml$, dest$)
        NEXT k
    ENDIF
    RETURN LEN(files)
ENDFUNC
