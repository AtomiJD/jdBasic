' Report Merger: three reports in a folder, one with an extra row, one
' with a text cell; the totals add up by the first column, the missing
' person is named, an odd header is noticed, and the workbook reads
' back with a sheet per person; columns in another order add up by
' name, an empty workbook is left out, and sheet names stay apart.

IMPORT TESTKIT, MERGER, XLSX

DIM folder$ = MKTEMP$("merger")
MKDIR folder$
DIM head = ["Project", "Hours", "Costs", "Note"]

SUB Report(file$, rows)
    DIM wb = XLSX.NEW()
    XLSX.SHEET(wb, "October", rows)
    XLSX.WRITE(PATH.JOIN$(folder$, file$), wb)
ENDSUB

Report("anna.xlsx", [head, ["Alpha", 10, 250.5, "on track"], _
    ["Beta", 4, 80, ""]])
Report("ben.xlsx", [head, ["Beta", 6, 120, "late"], _
    ["Gamma", 2.5, 40, ""]])
Report("cleo.xlsx", [head, ["Alpha", 3, 75, ""], ["", "", "", ""]])

TESTKIT.SUITE("reading")
DIM empty = []
DIM reports = MERGER.REPORTS(folder$, "", empty)
TESTKIT.EQ(LEN(reports), 3, "every workbook in the folder")
TESTKIT.EQ(reports[1]{"person"}, "ben", "named after its file")
TESTKIT.EQARRAY(MERGER.MISSING(reports, ["Anna", "Ben", "Dora"]), _
    ["Dora"], "who has not sent a report")
TESTKIT.EQ(LEN(MERGER.ODD_HEADERS(reports)), 0, "the same columns")

TESTKIT.SUITE("totals")
DIM t = MERGER.TOTALS(reports)
TESTKIT.EQ(LEN(t), 4, "the header and three projects")
TESTKIT.EQARRAY(t[0], head, "the header of the first report")
TESTKIT.EQ(t[1][0], "Alpha", "in the order they first appear")
TESTKIT.NEAR(t[1][1], 13, 0.0001, "hours added up")
TESTKIT.NEAR(t[1][2], 325.5, 0.0001, "costs added up")
TESTKIT.EQ(t[1][3], "on track", "a text keeps its first value")
TESTKIT.NEAR(t[2][1], 10, 0.0001, "Beta from two people")
TESTKIT.EQ(t[2][3], "late", "an empty text takes a later one")
TESTKIT.NEAR(t[3][2], 40, 0.0001, "Gamma from one")

TESTKIT.SUITE("writing")
DIM out$ = PATH.JOIN$(folder$, "team.xlsx")
TESTKIT.EQ(MERGER.WRITE(out$, reports, t), 4, "four sheets")
TESTKIT.EQARRAY(XLSX.SHEETS(out$), ["Total", "anna", "ben", "cleo"], _
    "the totals first")
DIM back = XLSX.READ(out$)
TESTKIT.NEAR(back{"Total"}[2][1], 10, 0.0001, "the totals read back")
TESTKIT.EQ(back{"ben"}[2][0], "Gamma", "and each report as it was")
TESTKIT.EQ(MERGER.SHEET_NAME$("a/b:c*d?e[f]"), "a_b_c_d_e_f_", _
    "sheet names Excel accepts")

TESTKIT.SUITE("an odd report")
Report("dan.xlsx", [["Project", "Hours"], ["Alpha", 1]])
DIM more = MERGER.REPORTS(folder$, "", empty)
TESTKIT.EQARRAY(MERGER.ODD_HEADERS(more), ["dan"], "other columns")

TESTKIT.SUITE("columns in another order")
KILL out$
Report("erin.xlsx", [["Project", "Costs", "Hours", "Note"], ["Beta", 99.99, 2, ""]])
DIM empty_book = XLSX.NEW()
DIM blank = XLSX.SHEET(empty_book, "Sheet1", [])
XLSX.WRITE(PATH.JOIN$(folder$, "blank.xlsx"), empty_book)
DIM left_out = []
DIM mixed = MERGER.REPORTS(folder$, "", left_out)
TESTKIT.EQARRAY(left_out, ["blank.xlsx"], "an empty workbook is left out and named")
TESTKIT.EQARRAY(MERGER.ODD_HEADERS(mixed), ["dan"], "another order is not odd")
DIM mt = MERGER.TOTALS(mixed)
TESTKIT.NEAR(mt[2][1], 12, 0.0001, "Beta's hours by the column name")
TESTKIT.NEAR(mt[2][2], 299.99, 0.0001, "and its costs")

TESTKIT.SUITE("sheet names")
DIM used AS MAP
TESTKIT.EQ(MERGER.UNIQUE_NAME$("Total", used), "Total", "the first name as it is")
TESTKIT.EQ(MERGER.UNIQUE_NAME$("total", used), "total (2)", "the same name in another case gets a number")
DIM long1$ = MERGER.UNIQUE_NAME$("Projektleitung Nord-Ost Region 1", used)
DIM long2$ = MERGER.UNIQUE_NAME$("Projektleitung Nord-Ost Region 2", used)
TESTKIT.EQ(long1$, "Projektleitung Nord-Ost Region", "cut to 31 without the space at the end")
TESTKIT.EQ(long2$, "Projektleitung Nord-Ost Reg (2)", "and the second one stays apart")
TESTKIT.ISTRUE(LEN(long2$) <= 31, "within 31 characters")
TESTKIT.EQ(MERGER.SHEET_NAME$("a\b"), "a_b", "a backslash is replaced too")
TESTKIT.EQ(MERGER.SHEET_NAME$("   "), "Sheet", "a name of spaces becomes Sheet")

OS.EXEC("cmd", ["/c", "rmdir", "/s", "/q", folder$])
TESTKIT.REPORT()
