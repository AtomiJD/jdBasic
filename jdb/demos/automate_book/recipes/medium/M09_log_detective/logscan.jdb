' logscan.jdb: application logs read line by line. Errors and warnings
' counted per hour, the same error message found again however its
' numbers change, a short report and a chart of the hours.
'
'   IMPORT LOGSCAN
'   DIM stats = LOGSCAN.NEW()
'   LOGSCAN.SCAN_TEXT(stats, TXTREADER$("app.log"))
'   PRINT LOGSCAN.REPORT$(stats, 5)
'   LOGSCAN.CHART(stats, "hours.svg")

EXPORT MODULE LOGSCAN

IMPORT SVG, WORKCONF

DIM gStamp$ = "^([0-9]{4}-[0-9]{2}-[0-9]{2})[ T]([0-9]{2}):[0-9]{2}"
DIM gLevel$ = "^(\[?)(FATAL|ERROR|WARNING|WARN)\b"

' Empty counters: "hours" (a map per hour of "ERROR" and "WARN"),
' "messages" (how often each error message came), "lines" and
' "skipped" (lines without a time stamp).
EXPORT FUNC NEW()
    DIM hours AS MAP
    DIM messages AS MAP
    RETURN {"hours": hours, "messages": messages, "lines": 0, _
        "skipped": 0}
ENDFUNC

' A message with every number replaced by #, so "job 4711 failed"
' and "job 4712 failed" count as one.
EXPORT FUNC SIGNATURE$(message$)
    DIM t$ = TRIM$(REGEX.REPLACE$("[0-9]+", message$, "#"))
    IF LEN(t$) > 60 THEN t$ = LEFT$(t$, 60)
    RETURN t$
ENDFUNC

' A day as YYYY-MM-DD, also when the log writes it 05.10.2026, so the
' hours sort by time whatever the time stamp looks like.
EXPORT FUNC ISO_DAY$(day$)
    DIM dots$ = "^([0-9]{2})\.([0-9]{2})\.([0-9]{4})$"
    DIM dmy = REGEX.FINDALL(dots$, day$)
    IF LEN(dmy) = 0 THEN RETURN day$
    RETURN dmy[0][2] + "-" + dmy[0][1] + "-" + dmy[0][0]
ENDFUNC

' One line as a map with "hour" ("2026-10-05 09"), "level" ("ERROR",
' "WARN" or "") and "message"; an empty map for a line without a time
' stamp at its start. The level is the first word after the time
' stamp, so "INFO job finished without error" is no error.
EXPORT FUNC PARSE(line$)
    DIM found AS MAP
    DIM stamp = REGEX.FINDALL(gStamp$, line$)
    IF LEN(stamp) = 0 THEN RETURN found
    DIM hour$ = stamp[0][1]
    found{"hour"} = ISO_DAY$(stamp[0][0]) + " " + hour$
    found{"level"} = ""
    found{"message"} = ""
    ' Seconds, fraction and zone belong to the stamp too.
    DIM rest$ = REGEX.REPLACE$(gStamp$, line$, "")
    DIM clock$ = "^[0-9:.,]*(Z|[+-][0-9:]{4,5})?\s*"
    rest$ = REGEX.REPLACE$(clock$, rest$, "")
    DIM lv = REGEX.FINDALL(gLevel$, UCASE$(rest$))
    IF LEN(lv) > 0 THEN
        DIM word$ = lv[0][1]
        DIM text$ = MID$(rest$, LEN(lv[0][0]) + LEN(lv[0][1]), _
            LEN(rest$))
        IF word$ = "FATAL" THEN word$ = "ERROR"
        IF word$ = "WARNING" THEN word$ = "WARN"
        found{"level"} = word$
        text$ = REGEX.REPLACE$("^[\]:\s-]+", text$, "")
        found{"message"} = TRIM$(text$)
    ENDIF
    RETURN found
ENDFUNC

' Adds the lines of a log text to the counters.
EXPORT SUB SCAN_TEXT(stats, text$)
    DIM rows = SPLIT(REPLACE$(text$, CHR$(13), ""), CHR$(10))
    DIM hours = stats{"hours"}
    DIM messages = stats{"messages"}
    DIM k = 0
    FOR k = 0 TO LEN(rows) - 1
        DIM one$ = rows[k]
        IF TRIM$(one$) <> "" THEN
            stats{"lines"} = stats{"lines"} + 1
            DIM p = PARSE(one$)
            IF NOT MAP.EXISTS(p, "hour") THEN
                stats{"skipped"} = stats{"skipped"} + 1
            ELSEIF p{"level"} <> "" THEN
                DIM h$ = p{"hour"}
                IF NOT MAP.EXISTS(hours, h$) THEN
                    hours{h$} = {"ERROR": 0, "WARN": 0}
                ENDIF
                DIM slot = hours{h$}
                DIM lv$ = p{"level"}
                slot{lv$} = slot{lv$} + 1
                IF lv$ = "ERROR" THEN
                    DIM sig$ = SIGNATURE$(p{"message"})
                    IF NOT MAP.EXISTS(messages, sig$) THEN
                        messages{sig$} = 0
                    ENDIF
                    messages{sig$} = messages{sig$} + 1
                ENDIF
            ENDIF
        ENDIF
    NEXT k
ENDSUB

' The total of one level over all hours.
EXPORT FUNC TOTAL(stats, level$)
    DIM hours = stats{"hours"}
    RETURN SUM(SELECT(LAMBDA USE(hours, level$) h$ -> _
        hours{h$}{level$}, MAP.KEYS(hours)))
ENDFUNC

' The error messages, the most frequent first.
EXPORT FUNC TOP_MESSAGES(stats)
    DIM messages = stats{"messages"}
    DIM keys = MAP.KEYS(messages)
    DIM counts = SELECT(LAMBDA USE(messages) m$ -> messages{m$}, keys)
    RETURN SELECT(LAMBDA USE(keys) i -> keys[i], GRADE(-counts))
ENDFUNC

' The busiest hour for errors, "" without any error.
EXPORT FUNC WORST_HOUR$(stats)
    DIM hours = stats{"hours"}
    DIM keys = SORT(MAP.KEYS(hours))
    IF LEN(keys) = 0 THEN RETURN ""
    DIM most = MAX(SELECT(LAMBDA USE(hours) h$ -> _
        hours{h$}{"ERROR"}, keys))
    IF most = 0 THEN RETURN ""
    RETURN FILTER(LAMBDA USE(hours, most) h$ -> _
        hours{h$}{"ERROR"} = most, keys)[0]
ENDFUNC

' The report as text: the totals, the worst hour, the top_n error
' messages and the hours with their counts.
EXPORT FUNC REPORT$(stats, top_n)
    DIM out = []
    DIM errors = TOTAL(stats, "ERROR")
    DIM warnings = TOTAL(stats, "WARN")
    DIM counts$ = WORKCONF.PLURAL$(stats{"lines"}, "line") + ", "
    counts$ = counts$ + WORKCONF.PLURAL$(errors, "error") + ", "
    counts$ = counts$ + WORKCONF.PLURAL$(warnings, "warning")
    IF stats{"skipped"} > 0 THEN
        counts$ = counts$ + ", " + STR$(stats{"skipped"}) + _
            " without a time stamp"
    ENDIF
    PUSH(out, counts$)
    DIM worst$ = WORST_HOUR$(stats)
    IF worst$ <> "" THEN PUSH(out, "Most errors: " + worst$ + ":00")
    PUSH(out, "")
    PUSH(out, "Most frequent errors")
    DIM top = TAKE(top_n, TOP_MESSAGES(stats))
    DIM messages = stats{"messages"}
    out = APPEND(out, SELECT(LAMBDA USE(messages) s$ -> _
        FORMAT$("{:>5}  ", messages{s$}) + s$, top))
    PUSH(out, "")
    PUSH(out, "Per hour          errors  warnings")
    DIM hours = stats{"hours"}
    DIM per_hour = SELECT(LAMBDA USE(hours) h$ -> _
        "  " + h$ + ":00" + FORMAT$("{:>7}{:>10}", _
        hours{h$}{"ERROR"}, hours{h$}{"WARN"}), SORT(MAP.KEYS(hours)))
    out = APPEND(out, per_hour)
    RETURN JOIN(out, CHR$(10))
ENDFUNC

' A stacked bar chart of the errors and warnings per hour, as SVG.
EXPORT SUB CHART(stats, path$)
    DIM hours = stats{"hours"}
    DIM keys = SORT(MAP.KEYS(hours))
    DIM labels = SELECT(LAMBDA h$ -> MID$(h$, 5, 8) + "h", keys)
    DIM errors = SELECT(LAMBDA USE(hours) h$ -> hours{h$}{"ERROR"}, _
        keys)
    DIM warnings = SELECT(LAMBDA USE(hours) h$ -> hours{h$}{"WARN"}, _
        keys)
    DIM c = SVG.CHART("stackedbar", 640, 320)
    SVG.SETOPT(c, "theme", "light")
    SVG.SETOPT(c, "title", "Errors and warnings per hour")
    SVG.LABELS(c, labels)
    SVG.SERIES(c, "errors", errors)
    SVG.SERIES(c, "warnings", warnings)
    SVG.WRITEFILE(SVG.RENDER(c), path$)
ENDSUB
