' cleaner.jdb: messy exports made usable. Dates in several forms to
' ISO, numbers with decimal comma or point, spaces tidied, IBANs and
' mail addresses checked, repeated rows dropped, and names that look
' like the same customer written twice found.
'
'   IMPORT CLEANER
'   DIM spec = {"Date": "date", "Amount": "number"}
'   DIM result = CLEANER.CLEAN(rows, spec, {"day_first": TRUE})
'   CLEANER.WRITE_XLSX(result, [], "clean.xlsx")

EXPORT MODULE CLEANER

IMPORT DT, FUZZY, VALID, XLSX

DIM gMonths = ["jan", "feb", "mar", "apr", "may", "jun", "jul", _
    "aug", "sep", "oct", "nov", "dec"]
' The German names where they differ: Mai, Okt, Dez (Maerz is read
' as mar once its umlaut is gone).
DIM gMonthsDe = ["", "", "", "", "mai", "", "", "", "", "okt", _
    "", "dez"]

DIM gIso$ = "^([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"
DIM gDmy$ = "^([0-9]{1,2})([./-])([0-9]{1,2})[./-]([0-9]{2,4})$"
DIM gDayName$ = "^([0-9]{1,2})\.? ([a-z]{3})[a-z]*\.? ([0-9]{4})$"
DIM gNameDay$ = "^([a-z]{3})[a-z]*\.? ([0-9]{1,2}),? ([0-9]{4})$"

' 1 to 12 for the first three letters of a month name, 0 for others.
FUNC MonthNo(s$)
    DIM k = 0
    FOR k = 0 TO 11
        IF gMonths[k] = s$ ORELSE gMonthsDe[k] = s$ THEN RETURN k + 1
    NEXT k
    RETURN 0
ENDFUNC

FUNC Two$(n)
    RETURN RIGHT$("0" + STR$(n), 2)
ENDFUNC

' "YYYY-MM-DD" for parts that make a real date, else "".
FUNC Ymd$(y, m, d)
    DIM full_y = y
    IF full_y < 100 THEN full_y = full_y + 2000
    IF m < 1 ORELSE m > 12 ORELSE d < 1 THEN RETURN ""
    IF d > DT.DAYS_IN(full_y, m) THEN RETURN ""
    RETURN STR$(full_y) + "-" + Two$(m) + "-" + Two$(d)
ENDFUNC

' A date as YYYY-MM-DD from any of the forms exports use: an Excel
' serial number, 2026-10-05, 05.10.2026, 5/10/26, 5 Oct 2026 or
' Oct 5, 2026, also with German month names (6. Okt. 2026). day_first
' reads 05/10 as the 5th of October. Answers "" for a text that is no
' date.
EXPORT FUNC ISO_DATE$(raw, day_first)
    IF TYPEOF(raw) <> "STRING" THEN
        DIM serial = FLOOR(raw)
        IF serial < 1 ORELSE serial > 2958465 THEN RETURN ""
        DIM t = DT.MAKE(1899, 12, 30) + serial * 86400
        RETURN DT.FMT$(t, "%Y-%m-%d", 0)
    ENDIF
    DIM s$ = REPLACE$(LCASE$(TRIM$(raw)), CHR$(195) + CHR$(164), "a")
    DIM g = REGEX.FINDALL(gIso$, s$)
    IF LEN(g) > 0 THEN
        RETURN Ymd$(VAL(g[0][0]), VAL(g[0][1]), VAL(g[0][2]))
    ENDIF
    g = REGEX.FINDALL(gDmy$, s$)
    IF LEN(g) > 0 THEN
        DIM a = VAL(g[0][0])
        DIM b = VAL(g[0][2])
        DIM y = VAL(g[0][3])
        IF g[0][1] = "." ORELSE day_first THEN RETURN Ymd$(y, b, a)
        RETURN Ymd$(y, a, b)
    ENDIF
    g = REGEX.FINDALL(gDayName$, s$)
    IF LEN(g) > 0 THEN
        DIM mo = MonthNo(g[0][1])
        RETURN Ymd$(VAL(g[0][2]), mo, VAL(g[0][0]))
    ENDIF
    g = REGEX.FINDALL(gNameDay$, s$)
    IF LEN(g) > 0 THEN
        DIM mn = MonthNo(g[0][0])
        RETURN Ymd$(VAL(g[0][2]), mn, VAL(g[0][1]))
    ENDIF
    RETURN ""
ENDFUNC

' A number from a text with a decimal comma or point, thousands
' separators, a currency, a sign in front, a minus behind (as SAP
' writes it) or brackets around. decimal$ is ",", "." or "auto", which
' takes the last separator as the decimal one, and a lone one too.
' Answers NONE for a text that is no number.
EXPORT FUNC NUMBER(raw, decimal$)
    IF TYPEOF(raw) <> "STRING" THEN RETURN raw
    DIM s$ = REPLACE$(TRIM$(raw), CHR$(194) + CHR$(160), "")
    s$ = REGEX.REPLACE$("\s|€|\$|£|EUR|USD|CHF", s$, "")
    DIM minus = FALSE
    IF STARTSWITH(s$, "(") ANDALSO ENDSWITH(s$, ")") THEN
        minus = TRUE
        s$ = MID$(s$, 1, LEN(s$) - 2)
    ENDIF
    IF ENDSWITH(s$, "-") THEN
        minus = TRUE
        s$ = LEFT$(s$, LEN(s$) - 1)
    ENDIF
    DIM shape = REGEX.FINDALL("^[+-]?[0-9][0-9.,]*$", s$)
    IF LEN(shape) = 0 THEN RETURN NONE
    DIM dec$ = decimal$
    IF dec$ = "auto" THEN
        dec$ = "."
        DIM comma = CINT(INSTR(s$, ","))
        DIM point = CINT(INSTR(s$, "."))
        DIM last_comma = comma >= 0 ANDALSO comma > point
        IF last_comma THEN dec$ = ","
    ENDIF
    DIM thousands$ = ","
    IF dec$ = "," THEN thousands$ = "."
    s$ = REPLACE$(REPLACE$(s$, thousands$, ""), dec$, ".")
    shape = REGEX.FINDALL("^[+-]?[0-9]+(\.[0-9]+)?$", s$)
    IF LEN(shape) = 0 THEN RETURN NONE
    DIM v = VAL(s$)
    IF minus THEN v = -v
    RETURN v
ENDFUNC

' A text with its spaces tidied: none at the ends, one between words.
EXPORT FUNC TIDY$(raw)
    DIM s$ = "" + raw
    RETURN TRIM$(REGEX.REPLACE$("\s+", s$, " "))
ENDFUNC

EXPORT FUNC IS_MAIL(s$)
    DIM p$ = "^[^@\s]+@[^@\s]+\.[a-zA-Z]{2,}$"
    RETURN LEN(REGEX.FINDALL(p$, s$)) > 0
ENDFUNC

FUNC Answer(v, why$)
    RETURN {"value": v, "problem": why$}
ENDFUNC

' Whether a number reads two ways: one point, no comma, three digits
' after it, such as 1.234 (a thousand and more in Germany, one and a
' bit in England).
EXPORT FUNC AMBIGUOUS(raw)
    IF TYPEOF(raw) <> "STRING" THEN RETURN FALSE
    DIM s$ = REGEX.REPLACE$("\s|€|\$|£|EUR|USD|CHF", TRIM$(raw), "")
    RETURN REGEX.MATCH("^[+-]?[0-9]{1,3}\.[0-9]{3}-?$", s$)
ENDFUNC

' The decimal sign of a number column read from its cells: a comma
' after the last point anywhere means comma, a point that cannot be a
' thousands point means point; "auto" when every cell reads two ways.
EXPORT FUNC COLUMN_DECIMAL$(rows, c)
    DIM r = 0
    DIM seen_point = FALSE
    FOR r = 1 TO LEN(rows) - 1
        IF c < LEN(rows[r]) THEN
            DIM cell = rows[r][c]
            DIM plain = TYPEOF(cell) = "STRING"
            IF plain ANDALSO NOT AMBIGUOUS(cell) THEN
                DIM comma = INSTR(cell, ",")
                DIM point = INSTR(cell, ".")
                IF comma >= 0 ANDALSO comma > point THEN RETURN ","
                IF point >= 0 THEN seen_point = TRUE
            ENDIF
        ENDIF
    NEXT r
    IF seen_point THEN RETURN "."
    RETURN "auto"
ENDFUNC

' One cell cleaned for its kind: a map with "value" and "problem", ""
' when the cell is fine. Empty cells stay empty, and the kind "keep"
' leaves the cell as it is.
EXPORT FUNC CELL(raw, kind$, opts)
    IF kind$ = "keep" THEN RETURN Answer(raw, "")
    IF TYPEOF(raw) = "NONE" THEN RETURN Answer("", "")
    IF TIDY$(raw) = "" THEN RETURN Answer("", "")
    IF kind$ = "date" THEN
        DIM d$ = ISO_DATE$(raw, opts{"day_first"})
        IF d$ = "" THEN RETURN Answer(raw, "not a date")
        RETURN Answer(d$, "")
    ENDIF
    IF kind$ = "number" THEN
        IF opts{"decimal"} = "auto" ANDALSO AMBIGUOUS(raw) THEN
            RETURN Answer(raw, "thousands or decimals? set decimal")
        ENDIF
        DIM v = NUMBER(raw, opts{"decimal"})
        IF TYPEOF(v) = "NONE" THEN RETURN Answer(raw, "not a number")
        RETURN Answer(v, "")
    ENDIF
    DIM t$ = TIDY$(raw)
    IF kind$ = "iban" THEN
        IF NOT VALID.ISIBAN(t$) THEN
            RETURN Answer(t$, "not a valid IBAN")
        ENDIF
        RETURN Answer(VALID.IBAN$(t$), "")
    ENDIF
    IF kind$ = "mail" THEN
        IF NOT IS_MAIL(t$) THEN
            RETURN Answer(t$, "not a mail address")
        ENDIF
        RETURN Answer(LCASE$(t$), "")
    ENDIF
    RETURN Answer(t$, "")
ENDFUNC

' A kind for each column guessed from its name: "date" when the name
' holds dat (Date, Datum), "number" for amount, betrag, price, preis,
' sum or total, "iban", "mail", and "text" for the rest.
EXPORT FUNC GUESS_KINDS(header)
    DIM spec AS MAP
    DIM c = 0
    FOR c = 0 TO LEN(header) - 1
        DIM col$ = "" + header[c]
        ' The words of the name, so "Mandat" holds no "dat" and
        ' "Consumer" no "sum": a word has to start with the hint.
        DIM low$ = LCASE$(col$)
        DIM words$ = " " + REGEX.REPLACE$("[^a-z0-9]+", low$, " ")
        DIM kind$ = "text"
        IF INSTR(words$, " dat") >= 0 THEN kind$ = "date"
        DIM money = [" amount", " betrag", " price", _
            " preis", " sum", " total"]
        DIM hits = FILTER(LAMBDA USE(words$) m$ -> _
            INSTR(words$, m$) >= 0, money)
        IF LEN(hits) > 0 THEN kind$ = "number"
        IF INSTR(words$, " iban") >= 0 THEN kind$ = "iban"
        IF INSTR(words$, " mail") >= 0 ORELSE _
            INSTR(words$, " email") >= 0 THEN kind$ = "mail"
        IF INSTR(words$, " mailing") >= 0 THEN kind$ = "text"
        spec{col$} = kind$
    NEXT c
    RETURN spec
ENDFUNC

' The kinds checked against the values: a column whose name looked
' like a date, a number, an IBAN or a mail address keeps that kind
' only when most of its filled cells are one; otherwise it is text, so
' a name that only looks right fills the problem list with nothing.
EXPORT FUNC CHECK_KINDS(rows, spec, opts)
    DIM out AS MAP
    DIM header = rows[0]
    DIM c = 0
    DIM r = 0
    FOR c = 0 TO LEN(header) - 1
        DIM col$ = "" + header[c]
        DIM kind$ = "text"
        IF MAP.EXISTS(spec, col$) THEN kind$ = spec{col$}
        IF kind$ <> "text" ANDALSO kind$ <> "keep" THEN
            ' The column's own decimal mark, as CLEAN finds it.
            DIM one AS MAP
            one{"day_first"} = opts{"day_first"}
            one{"decimal"} = opts{"decimal"}
            IF opts{"decimal"} = "auto" THEN
                one{"decimal"} = COLUMN_DECIMAL$(rows, c)
            ENDIF
            DIM filled = 0
            DIM fits = 0
            FOR r = 1 TO LEN(rows) - 1
                IF c < LEN(rows[r]) THEN
                    DIM raw = rows[r][c]
                    IF TRIM$("" + raw) <> "" THEN
                        filled = filled + 1
                        DIM res = CELL(raw, kind$, one)
                        IF res{"problem"} = "" THEN fits = fits + 1
                    ENDIF
                ENDIF
            NEXT r
            IF filled > 0 ANDALSO fits * 2 < filled THEN
                kind$ = "text"
            ENDIF
        ENDIF
        out{col$} = kind$
    NEXT c
    RETURN out
ENDFUNC

' A table cleaned: rows[0] holds the column names, spec maps a name to
' its kind (date, number, text, iban, mail; others stay as they are).
' Answers "rows" (the clean table), "problems" (rows of row, column,
' value, reason), "changed" (cells that changed) and "duplicates"
' (rows dropped as equal to a row before them).
EXPORT FUNC CLEAN(rows, spec, opts)
    DIM header = rows[0]
    DIM out = [header]
    DIM problems = []
    DIM seen AS MAP
    DIM changed = 0
    DIM dups = 0
    DIM r = 0
    DIM c = 0
    ' With decimal = "auto" each number column finds its sign once.
    DIM col_opts = []
    FOR c = 0 TO LEN(header) - 1
        DIM one AS MAP
        one{"day_first"} = opts{"day_first"}
        one{"decimal"} = opts{"decimal"}
        IF opts{"decimal"} = "auto" THEN
            one{"decimal"} = COLUMN_DECIMAL$(rows, c)
        ENDIF
        PUSH(col_opts, one)
    NEXT c
    FOR r = 1 TO LEN(rows) - 1
        DIM src = rows[r]
        DO WHILE LEN(src) < LEN(header)
            PUSH(src, "")
        LOOP
        DIM clean_row = []
        DIM key$ = ""
        FOR c = 0 TO LEN(header) - 1
            DIM col$ = header[c]
            DIM kind$ = "keep"
            IF MAP.EXISTS(spec, col$) THEN kind$ = spec{col$}
            DIM res = CELL(src[c], kind$, col_opts[c])
            DIM was$ = "" + src[c]
            DIM now$ = "" + res{"value"}
            IF res{"problem"} <> "" THEN
                PUSH(problems, [r + 1, col$, was$, res{"problem"}])
            ENDIF
            IF now$ <> was$ THEN changed = changed + 1
            PUSH(clean_row, res{"value"})
            key$ = key$ + LCASE$(now$) + "|"
        NEXT c
        IF MAP.EXISTS(seen, key$) THEN
            dups = dups + 1
        ELSE
            seen{key$} = TRUE
            PUSH(out, clean_row)
        ENDIF
    NEXT r
    RETURN {"rows": out, "problems": problems, "changed": changed, _
        "duplicates": dups}
ENDFUNC

' Pairs of different names in a column that score at least cutoff
' (0 to 100) as the same text: rows of [name, other, score].
EXPORT FUNC SIMILAR(rows, column$, cutoff)
    DIM header = rows[0]
    DIM col = -1
    DIM r = 0
    FOR r = 0 TO LEN(header) - 1
        IF header[r] = column$ THEN col = r
    NEXT r
    DIM out = []
    IF col < 0 THEN RETURN out
    DIM cells = SELECT(LAMBDA USE(col) row -> "" + row[col], _
        DROP(1, rows))
    DIM names = UNIQUE(FILTER(LAMBDA v$ -> v$ <> "", cells))
    DIM i = 0
    DIM j = 0
    FOR i = 0 TO LEN(names) - 1
        FOR j = i + 1 TO LEN(names) - 1
            DIM a$ = names[i]
            DIM b$ = names[j]
            DIM score = FUZZY.SCORE(a$, b$, "token_sort", 1)
            IF score >= cutoff THEN PUSH(out, [a$, b$, ROUND(score)])
        NEXT j
    NEXT i
    RETURN out
ENDFUNC

' The fields of one CSV line, with quoted fields that hold the
' separator or doubled quotes.
EXPORT FUNC CSV_FIELDS(line$, sep$)
    DIM out = []
    DIM cur$ = ""
    DIM quoted = FALSE
    DIM q$ = CHR$(34)
    DIM chars = -line$
    DIM k = 0
    DO WHILE k < LEN(chars)
        DIM ch$ = chars[k]
        IF quoted THEN
            DIM after$ = ""
            IF k + 1 < LEN(chars) THEN after$ = chars[k + 1]
            IF ch$ = q$ ANDALSO after$ = q$ THEN
                cur$ = cur$ + q$
                k = k + 1
            ELSEIF ch$ = q$ THEN
                quoted = FALSE
            ELSE
                cur$ = cur$ + ch$
            ENDIF
        ELSEIF ch$ = q$ THEN
            quoted = TRUE
        ELSEIF ch$ = sep$ THEN
            PUSH(out, cur$)
            cur$ = ""
        ELSE
            cur$ = cur$ + ch$
        ENDIF
        k = k + 1
    LOOP
    PUSH(out, cur$)
    RETURN out
ENDFUNC

' The rows of a CSV file or of the first sheet of a workbook.
EXPORT FUNC READ_TABLE(path$, sep$)
    IF LCASE$(PATH.EXT$(path$)) = ".xlsx" THEN
        DIM sheets = XLSX.SHEETS(path$)
        DIM book = XLSX.READ(path$)
        RETURN book{sheets[0]}
    ENDIF
    DIM text$ = REPLACE$(TXTREADER$(path$), CHR$(13), "")
    DIM lines = SPLIT(text$, CHR$(10))
    DIM rows = []
    DIM k = 0
    FOR k = 0 TO LEN(lines) - 1
        DIM one$ = lines[k]
        IF TRIM$(one$) <> "" THEN PUSH(rows, CSV_FIELDS(one$, sep$))
    NEXT k
    RETURN rows
ENDFUNC

' A header row followed by the rows of a list.
FUNC WithHeader(head, rows)
    DIM out = [head]
    DIM k = 0
    FOR k = 0 TO LEN(rows) - 1
        DIM one = rows[k]
        PUSH(out, one)
    NEXT k
    RETURN out
ENDFUNC

' The columns of a table whose filled cells are mostly dates written
' YYYY-MM-DD, by their position.
EXPORT FUNC DATE_COLUMNS(rows)
    DIM out = []
    IF LEN(rows) < 2 THEN RETURN out
    DIM iso$ = "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    DIM c = 0
    DIM r = 0
    FOR c = 0 TO LEN(rows[0]) - 1
        DIM dates = 0
        DIM others = 0
        FOR r = 1 TO LEN(rows) - 1
            DIM cell$ = ""
            IF c < LEN(rows[r]) THEN cell$ = "" + rows[r][c]
            IF REGEX.MATCH(iso$, cell$) THEN
                dates = dates + 1
            ELSEIF cell$ <> "" THEN
                others = others + 1
            ENDIF
        NEXT r
        IF dates > others THEN PUSH(out, c)
    NEXT c
    RETURN out
ENDFUNC

' The table with the cells of its date columns as Excel day numbers,
' which a column format shows as dates that sort, filter and count;
' a cell that is no date stays as it is.
FUNC AsExcelDates(rows, cols)
    DIM out = [rows[0]]
    DIM day0 = DT.MAKE(1899, 12, 30)
    DIM iso$ = "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    DIM r = 0
    DIM c = 0
    FOR r = 1 TO LEN(rows) - 1
        DIM row = []
        FOR c = 0 TO LEN(rows[r]) - 1
            DIM cell = rows[r][c]
            DIM t = NONE
            IF c IN cols ANDALSO REGEX.MATCH(iso$, "" + cell) THEN
                t = DT.PARSE("" + cell)
            ENDIF
            IF TYPEOF(t) = "NONE" THEN
                PUSH(row, cell)
            ELSE
                PUSH(row, (t - day0) / 86400)
            ENDIF
        NEXT c
        PUSH(out, row)
    NEXT r
    RETURN out
ENDFUNC

' The result as a workbook: Clean, Problems and Similar names. Date
' columns hold real Excel dates.
EXPORT FUNC WRITE_XLSX(result, similar, path$)
    DIM wb = XLSX.NEW()
    DIM rows = result{"rows"}
    DIM cols = DATE_COLUMNS(rows)
    DIM clean = XLSX.SHEET(wb, "Clean", AsExcelDates(rows, cols))
    DIM k = 0
    FOR k = 0 TO LEN(cols) - 1
        XLSX.COLUMN(clean, cols[k] + 1, {"format": "yyyy-mm-dd", _
            "width": 12})
    NEXT k
    XLSX.FREEZE(clean, 1)
    DIM head = ["Row", "Column", "Value", "Problem"]
    DIM prob = WithHeader(head, result{"problems"})
    XLSX.SHEET(wb, "Problems", prob)
    DIM sim = WithHeader(["Name", "Looks like", "Score"], similar)
    XLSX.SHEET(wb, "Similar names", sim)
    RETURN XLSX.WRITE(path$, wb)
ENDFUNC
