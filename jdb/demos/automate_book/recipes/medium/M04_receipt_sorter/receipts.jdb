' receipts.jdb: receipts filed by month and category. The date and
' the amount come from the file name, such as "2026-10-03 fuel
' 45.20.pdf"; the category from the first rule whose word the name
' contains. A month folder holds one folder per category and the
' expense report.
'
'   IMPORT RECEIPTS
'   DIM r = RECEIPTS.PARSE("2026-10-03 Shell 45.20.pdf", rules)
'   PRINT r{"month"}, r{"category"}, r{"amount"}

EXPORT MODULE RECEIPTS

IMPORT XLSX

' The rules of the settings, texts like "shell = Travel", as a list
' of maps with "word" in lower case and "category".
EXPORT FUNC RULES(texts)
    DIM out = []
    DIM k = 0
    FOR k = 0 TO LEN(texts) - 1
        DIM t$ = texts[k]
        DIM eq = CINT(INSTR(t$, "="))
        IF eq > 0 THEN
            DIM word$ = LCASE$(TRIM$(LEFT$(t$, eq)))
            DIM cat$ = TRIM$(MID$(t$, eq + 1, LEN(t$)))
            IF word$ <> "" ANDALSO cat$ <> "" THEN
                PUSH(out, {"word": word$, "category": cat$})
            ENDIF
        ENDIF
    NEXT k
    RETURN out
ENDFUNC

' TRUE when the character before position at and the one after the
' word are no letters, so "rail" is found in "rail ticket" and not in
' "trailer".
FUNC WholeWord(low$, at, word$)
    DIM before$ = ""
    IF at > 0 THEN before$ = MID$(low$, at - 1, 1)
    DIM after$ = MID$(low$, at + LEN(word$), 1)
    DIM letter$ = "^[a-z]$"
    RETURN NOT REGEX.MATCH(letter$, before$) ANDALSO _
        NOT REGEX.MATCH(letter$, after$)
ENDFUNC

' The category of the first rule whose word stands in the name as a
' word of its own, else "Other".
EXPORT FUNC CATEGORY$(name$, rules)
    DIM low$ = LCASE$(name$)
    DIM k = 0
    FOR k = 0 TO LEN(rules) - 1
        DIM r = rules[k]
        DIM word$ = r{"word"}
        DIM at = CINT(INSTR(low$, word$))
        DO WHILE at >= 0
            IF WholeWord(low$, at, word$) THEN RETURN r{"category"}
            at = CINT(INSTR(at + 1, low$, word$))
        LOOP
    NEXT k
    RETURN "Other"
ENDFUNC

' TRUE for a year, month and day that are on the calendar.
FUNC OnCalendar(y$, m$, d$)
    DIM yy = VAL(y$)
    DIM mm = VAL(m$)
    DIM dd = VAL(d$)
    IF mm < 1 ORELSE mm > 12 ORELSE dd < 1 THEN RETURN FALSE
    DIM days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    DIM most = days[mm - 1]
    DIM leap = (yy MOD 4 = 0 ANDALSO yy MOD 100 <> 0) ORELSE _
        yy MOD 400 = 0
    IF mm = 2 ANDALSO leap THEN most = 29
    RETURN dd <= most
ENDFUNC

' The date in a file name as found, such as "2026-10-03", "20261003"
' or "03.10.2026", and as YYYY-MM-DD: a list of the two, empty when
' there is none. Digits next to it, as in a receipt number, and a day
' that is not on the calendar do not count.
FUNC FindDate(name$)
    DIM iso$ = "(?:^|[^0-9])((20[0-9]{2})-?([01][0-9])-?([0-3][0-9]))"
    DIM g = REGEX.FINDALL(iso$ + "(?![0-9])", name$)
    DIM k = 0
    FOR k = 0 TO LEN(g) - 1
        DIM a = g[k]
        IF OnCalendar(a[1], a[2], a[3]) THEN
            RETURN [a[0], a[1] + "-" + a[2] + "-" + a[3]]
        ENDIF
    NEXT k
    DIM dots$ = "(?:^|[^0-9])"
    dots$ = dots$ + "(([0-3][0-9])\.([01][0-9])\.(20[0-9]{2}))"
    g = REGEX.FINDALL(dots$ + "(?![0-9])", name$)
    FOR k = 0 TO LEN(g) - 1
        DIM b = g[k]
        IF OnCalendar(b[3], b[2], b[1]) THEN
            RETURN [b[0], b[3] + "-" + b[2] + "-" + b[1]]
        ENDIF
    NEXT k
    RETURN []
ENDFUNC

' The date in a file name as YYYY-MM-DD: 2026-10-03, 20261003 or
' 03.10.2026; "" when there is none.
EXPORT FUNC DATE$(name$)
    DIM found = FindDate(name$)
    IF LEN(found) = 0 THEN RETURN ""
    RETURN found[1]
ENDFUNC

' The amount in a file name: the last number with two decimals after
' a point or a comma, such as 45.20, 45,20, 1,234.56 or 1.234,56; -1
' when there is none. The date of the name is no amount.
EXPORT FUNC AMOUNT(name$)
    DIM stem$ = LEFT$(name$, LEN(name$) - LEN(PATH.EXT$(name$)))
    DIM found = FindDate(stem$)
    IF LEN(found) > 0 THEN stem$ = REPLACE$(stem$, found[0], " ")
    DIM whole$ = "([0-9]{1,3}(?:[.,'][0-9]{3})+|[0-9]+)"
    DIM pat$ = "(?:^|[^0-9.,])" + whole$ + "[.,]([0-9]{2})(?![0-9])"
    DIM g = REGEX.FINDALL(pat$, stem$)
    IF LEN(g) = 0 THEN RETURN -1
    DIM last = g[LEN(g) - 1]
    DIM units$ = REGEX.REPLACE$("[.,']", last[0], "")
    RETURN VAL(units$ + "." + last[1])
ENDFUNC

' Date, month, category and amount of a receipt; changed$ is the
' file's time, used when the name has no date.
EXPORT FUNC PARSE(name$, rules, changed$ = "")
    DIM stamp$ = DATE$(name$)
    IF stamp$ = "" THEN stamp$ = LEFT$(changed$, 10)
    DIM out AS MAP
    out{"date"} = stamp$
    out{"month"} = LEFT$(stamp$, 7)
    out{"category"} = CATEGORY$(name$, rules)
    out{"amount"} = AMOUNT(name$)
    RETURN out
ENDFUNC

' A path in the folder for the file name that no file uses yet,
' numbered like "x (2).pdf" when needed.
EXPORT FUNC FREE_NAME$(folder$, file_name$)
    DIM candidate$ = PATH.JOIN$(folder$, file_name$)
    IF NOT FILE.EXISTS(candidate$) THEN RETURN candidate$
    DIM ext$ = PATH.EXT$(file_name$)
    DIM stem$ = LEFT$(file_name$, LEN(file_name$) - LEN(ext$))
    DIM n = 2
    DO
        DIM numbered$ = stem$ + " (" + STR$(n) + ")" + ext$
        candidate$ = PATH.JOIN$(folder$, numbered$)
        n = n + 1
    LOOP WHILE FILE.EXISTS(candidate$)
    RETURN candidate$
ENDFUNC

' The rows of the expense report of a month folder: the header, then
' one row per file in its category folders, by category and name.
' A file without a date in its name has the day of its file time, the
' day it was filed by.
EXPORT FUNC MONTH_ROWS(month_folder$)
    DIM rows = [["Date", "Category", "File", "Amount"]]
    IF NOT FILE.ISDIR(month_folder$) THEN RETURN rows
    DIM cats = SORT(FILE.LIST(PATH.JOIN$(month_folder$, "*")))
    DIM k = 0
    DIM j = 0
    FOR k = 0 TO LEN(cats) - 1
        DIM cat$ = cats[k]
        DIM cat_dir$ = PATH.JOIN$(month_folder$, cat$)
        IF FILE.ISDIR(cat_dir$) THEN
            DIM files = SORT(FILE.LIST(PATH.JOIN$(cat_dir$, "*")))
            FOR j = 0 TO LEN(files) - 1
                DIM f$ = files[j]
                DIM amount = AMOUNT(f$)
                DIM stamp$ = DATE$(f$)
                IF stamp$ = "" THEN
                    DIM info = FILE.STAT(PATH.JOIN$(cat_dir$, f$))
                    stamp$ = LEFT$(info{"mtime"}, 10)
                ENDIF
                IF amount >= 0 THEN
                    PUSH(rows, [stamp$, cat$, f$, amount])
                ELSE
                    PUSH(rows, [stamp$, cat$, f$, ""])
                ENDIF
            NEXT j
        ENDIF
    NEXT k
    RETURN rows
ENDFUNC

' The sum per category of the report rows, and "Total" last.
EXPORT FUNC SUMS(rows)
    DIM out = [["Category", "Amount", "Receipts"]]
    DIM where AS MAP
    DIM total = 0
    DIM k = 0
    FOR k = 1 TO LEN(rows) - 1
        DIM cat$ = rows[k][1]
        IF NOT MAP.EXISTS(where, cat$) THEN
            where{cat$} = LEN(out)
            PUSH(out, [cat$, 0, 0])
        ENDIF
        DIM sum_row = out[where{cat$}]
        DIM v = rows[k][3]
        IF TYPEOF(v) <> "STRING" THEN
            sum_row[1] = sum_row[1] + v
            total = total + v
        ENDIF
        sum_row[2] = sum_row[2] + 1
    NEXT k
    PUSH(out, ["Total", total, LEN(rows) - 1])
    RETURN out
ENDFUNC

' Writes the expense report: the sums first, then every receipt.
EXPORT SUB WRITE_REPORT(path$, rows)
    DIM wb = XLSX.NEW()
    DIM s = XLSX.SHEET(wb, "Sums", SUMS(rows))
    XLSX.COLUMN(s, "A", {"width": 20})
    XLSX.COLUMN(s, "B", {"format": "#,##0.00"})
    DIM r = XLSX.SHEET(wb, "Receipts", rows)
    XLSX.COLUMN(r, "C", {"width": 40})
    XLSX.COLUMN(r, "D", {"format": "#,##0.00"})
    XLSX.FREEZE(r, 1)
    XLSX.WRITE(path$, wb)
ENDSUB
