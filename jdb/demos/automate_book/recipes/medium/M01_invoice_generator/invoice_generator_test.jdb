' Invoice Generator: rows grouped by customer, totals with VAT, the
' next numbers from the counter, the PDF, and the mail read back.
' Nothing is sent. The Word file is checked by word_check.jdb.

IMPORT TESTKIT, INVOICES, INVOICE_PDF, MAIL

DIM folder$ = MKTEMP$("invoices")
MKDIR folder$
DIM sheet_rows = [["Customer", "EMAIL", "Item", "Quantity", "Price"], _
    ["Miller Ltd", "buy@miller.example", "Copy paper", 10, 4.5], _
    ["Stone & Co", "office@stone.example", "Toner", 2, 61.9], _
    ["Miller Ltd", "", "Delivery", 1, 12], _
    ["", "", "", "", ""]]
DIM company = {"name": "Example Supplies", _
    "address": "1 Main Street, Exampletown", "date": "2026-10-05"}

FUNC NoColumn(r)
    RETURN INVOICES.COLUMNS(["Customer", "Item"])
ENDFUNC

TESTKIT.SUITE("grouping and totals")
DIM list = INVOICES.GROUP(sheet_rows)
TESTKIT.EQ(LEN(list), 2, "one invoice per customer, empty rows left out")
TESTKIT.EQ(list[0]{"customer"}, "Miller Ltd", "in the order they appear")
TESTKIT.EQ(LEN(list[0]{"lines"}), 2, "with a line for each of its rows")
TESTKIT.EQ(list[0]{"email"}, "buy@miller.example", "the first address")
TESTKIT.THROWS(NoColumn@, 0, "a missing column is named")
DIM inv = INVOICES.TOTALS(list[0], 19)
TESTKIT.NEAR(inv{"net"}, 57, 0.001, "net: 10 x 4.50 + 12")
TESTKIT.NEAR(inv{"vat"}, 10.83, 0.001, "19 percent VAT in cents")
TESTKIT.NEAR(inv{"gross"}, 67.83, 0.001, "and the total")
TESTKIT.EQ(INVOICES.MONEY$(67.83), "67.83 EUR", "money with two digits")
DIM trows = INVOICES.TABLE_ROWS(inv)
TESTKIT.EQ(LEN(trows), 3, "a table row per line under the header")
TESTKIT.EQ(trows[1][3], "45.00 EUR", "with the amount of the line")

FUNC CommaPrice(r)
    RETURN INVOICES.AMOUNT("4,50", "price", 9)
ENDFUNC

FUNC EmptyPrice(r)
    RETURN INVOICES.AMOUNT("", "price", 9)
ENDFUNC

FUNC WordQuantity(r)
    RETURN INVOICES.AMOUNT("two", "quantity", 3)
ENDFUNC

FUNC CommaMessage$()
    DIM said$ = ""
    TRY
        DIM ignored = INVOICES.AMOUNT("4,50", "price", 9)
    CATCH
        said$ = ERRMSG$
    ENDTRY
    RETURN said$
ENDFUNC

TESTKIT.SUITE("amounts")
TESTKIT.EQ(INVOICES.AMOUNT(4.5, "price", 2), 4.5, "a number stays a number")
TESTKIT.EQ(INVOICES.AMOUNT(" 4.50 ", "price", 2), 4.5, "a plain number as text is read")
TESTKIT.THROWS(CommaPrice@, 0, "a decimal comma stops the run")
TESTKIT.EQ(CommaMessage$(), "Row 9: price '4,50' is not a number (write 4.50)", "with the row and the way to write it")
TESTKIT.THROWS(EmptyPrice@, 0, "an empty price stops the run")
TESTKIT.THROWS(WordQuantity@, 0, "and so does a word")

TESTKIT.SUITE("the address column")
DIM with_address = [["Customer", "Email", "Item", "Quantity", "Price", "Address"], _
    ["Miller Ltd", "", "Toner", 1, 10, "Miller Ltd, 4 Mill Lane, 12345 Millton"], _
    ["Stone & Co", "", "Toner", 1, 10, "2 Rock Road" + CHR$(10) + "54321 Stoneham"], _
    ["Miller Ltd", "", "Paper", 1, 5, ""]]
DIM addressed = INVOICES.GROUP(with_address)
TESTKIT.EQARRAY(addressed[0]{"address"}, ["Miller Ltd", "4 Mill Lane", "12345 Millton"], "a one-line address is split at its commas")
TESTKIT.EQARRAY(addressed[1]{"address"}, ["2 Rock Road", "54321 Stoneham"], "a cell with lines keeps its lines")
TESTKIT.EQ(LEN(list[0]{"address"}), 0, "a sheet without the column has no address")

TESTKIT.SUITE("numbers")
DIM counter$ = PATH.JOIN$(folder$, "last_number.txt")
TESTKIT.EQARRAY(INVOICES.NEXT_NUMBERS(counter$, "RE-", "2026", 2), _
    ["RE-2026-0001", "RE-2026-0002"], "the first numbers of a year")
TXTWRITER counter$, "41"
TESTKIT.EQARRAY(INVOICES.NEXT_NUMBERS(counter$, "RE-", "2026", 1), _
    ["RE-2026-0042"], "and after the stored one")
TXTWRITER counter$, "9998"
TESTKIT.EQARRAY(INVOICES.NEXT_NUMBERS(counter$, "RE-", "2026", 3), _
    ["RE-2026-9999", "RE-2026-10000", "RE-2026-10001"], "past 9999 the number grows a digit")
TESTKIT.EQ(INVOICES.LAST_NUMBER(counter$), 9998, "the last number as a number")

TESTKIT.SUITE("invoiced tabs")
TESTKIT.EQ(INVOICES.INVOICED$(folder$, "October"), "", "a tab never invoiced")
INVOICES.NOTE_INVOICED(folder$, "October", "2026-11-02", "RE-2026-0001", "RE-2026-0002")
INVOICES.NOTE_INVOICED(folder$, "November", "2026-12-01", "RE-2026-0003", "RE-2026-0004")
TESTKIT.EQ(INVOICES.INVOICED$(folder$, "October"), "October" + CHR$(9) + "2026-11-02" + CHR$(9) + "RE-2026-0001" + CHR$(9) + "RE-2026-0002", "is noted with its date and numbers")
INVOICES.NOTE_INVOICED(folder$, "October", "2026-11-05", "RE-2026-0005", "RE-2026-0006")
TESTKIT.ISTRUE(INSTR(INVOICES.INVOICED$(folder$, "October"), "RE-2026-0005") >= 0, "the latest run counts")

TESTKIT.SUITE("the PDF")
DIM pdf$ = PATH.JOIN$(folder$, "RE-2026-0042.pdf")
INVOICE_PDF.WRITE(inv, "RE-2026-0042", company, pdf$)
DIM bytes$ = BINREADER$(pdf$)
TESTKIT.EQ(LEFT$(bytes$, 5), "%PDF-", "a PDF is written")
TESTKIT.ISTRUE(INSTR(bytes$, "(Invoice RE-2026-0042) Tj") >= 0, _
    "with its number")
TESTKIT.ISTRUE(INSTR(bytes$, "(67.83 EUR) Tj") >= 0, "and its total")
TESTKIT.ISTRUE(INSTR(bytes$, "(Item) Tj") >= 0, "the table has its header row")

DIM legal = {"name": "Example Supplies", "address": "1 Main Street, Exampletown", _
    "date": "2026-11-02", "tax_id": "DE123456789", "period": "October 2026"}
DIM legal_pdf$ = PATH.JOIN$(folder$, "RE-2026-0043.pdf")
DIM addressed_inv = INVOICES.TOTALS(addressed[0], 19)
INVOICE_PDF.WRITE(addressed_inv, "RE-2026-0043", legal, legal_pdf$)
DIM legal_bytes$ = BINREADER$(legal_pdf$)
TESTKIT.ISTRUE(INSTR(legal_bytes$, "(Tax number: DE123456789) Tj") >= 0, "the tax number")
TESTKIT.ISTRUE(INSTR(legal_bytes$, "(4 Mill Lane) Tj") >= 0, "the customer's address")
TESTKIT.ISTRUE(INSTR(legal_bytes$, "(Delivery period: October 2026) Tj") >= 0, "and the delivery period")
TESTKIT.ISTRUE(INSTR(bytes$, "Tax number") < 0, "a company without a tax_id shows none")

TESTKIT.SUITE("the mail")
DIM m = INVOICES.MAIL_FOR(inv, "RE-2026-0042", _
    "Jonas Example <jonas@example.com>", pdf$)
DIM eml$ = PATH.JOIN$(folder$, "RE-2026-0042.eml")
MAIL.WRITEEML(m, eml$)
DIM p = MAIL.PARSEFILE(eml$)
TESTKIT.EQ(p{"subject"}, "Invoice RE-2026-0042", "the subject")
TESTKIT.EQARRAY(p{"to"}, ["buy@miller.example"], "the customer")
TESTKIT.ISTRUE(INSTR(p{"text"}, "total 67.83 EUR") >= 0, "the total")
TESTKIT.ISTRUE(INSTR(p{"text"}, "Jonas Example") >= 0, "signed")
TESTKIT.EQARRAY(p{"att_names"}, ["RE-2026-0042.pdf"], "the invoice")

OS.EXEC("cmd", ["/c", "rmdir", "/s", "/q", folder$])
TESTKIT.REPORT()
