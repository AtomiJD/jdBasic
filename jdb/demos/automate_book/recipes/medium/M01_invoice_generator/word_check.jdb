' Invoice Generator, the Word file: an invoice written with
' INVOICE_WORD and read back. Kept apart from the main test, which
' also writes the PDF (see the notes of the recipe).

IMPORT TESTKIT, INVOICES, INVOICE_WORD, DOCX

DIM folder$ = MKTEMP$("invoiceword")
MKDIR folder$
DIM sheet_rows = [["Customer", "Email", "Item", "Quantity", "Price"], _
    ["Miller Ltd", "buy@miller.example", "Copy paper", 10, 4.5], _
    ["Miller Ltd", "", "Delivery", 1, 12]]
DIM company = {"name": "Example Supplies", _
    "address": "1 Main Street, Exampletown", "date": "2026-10-05"}
DIM inv = INVOICES.TOTALS(INVOICES.GROUP(sheet_rows)[0], 19)

TESTKIT.SUITE("the Word file")
DIM path$ = PATH.JOIN$(folder$, "RE-2026-0042.docx")
INVOICE_WORD.WRITE(inv, "RE-2026-0042", company, path$)
DIM back = DOCX.READ(path$)
TESTKIT.ISTRUE("Invoice RE-2026-0042" IN back{"paragraphs"}, _
    "the heading")
TESTKIT.ISTRUE("Miller Ltd" IN back{"paragraphs"}, "the customer")
TESTKIT.EQ(back{"tables"}[0][1][0], "Copy paper", "the lines")
TESTKIT.EQ(back{"tables"}[1][2][1], "67.83 EUR", "and the totals")

OS.EXEC("cmd", ["/c", "rmdir", "/s", "/q", folder$])
TESTKIT.REPORT()
