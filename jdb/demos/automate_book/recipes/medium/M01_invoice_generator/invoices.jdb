' invoices.jdb: invoices from the rows of a sheet. Rows with the same
' customer become one invoice with one line per row; each invoice gets
' the next number, its totals, the rows of its table and a mail. The
' PDF and the Word file are written by INVOICE_PDF and INVOICE_WORD.
'
'   IMPORT INVOICES
'   DIM list = INVOICES.GROUP(rows)
'   DIM inv = INVOICES.TOTALS(list[0], 19)

EXPORT MODULE INVOICES

IMPORT MAIL

' The position of each column in the header row, by its name in any
' case. A missing column is an error that names it; the column
' address may be left out and is then -1.
EXPORT FUNC COLUMNS(header)
    DIM wanted = ["customer", "email", "item", "quantity", "price", _
        "address"]
    DIM out AS MAP
    DIM k = 0
    DIM j = 0
    FOR k = 0 TO LEN(wanted) - 1
        out{wanted[k]} = -1
        FOR j = 0 TO LEN(header) - 1
            DIM h$ = LCASE$(TRIM$("" + header[j]))
            IF h$ = wanted[k] THEN out{wanted[k]} = j
        NEXT j
        IF out{wanted[k]} < 0 ANDALSO wanted[k] <> "address" THEN _
            THROW "The sheet has no column " + wanted[k]
    NEXT k
    RETURN out
ENDFUNC

' The number in a cell of a quantity or price column. Text is taken
' only when it is a plain number such as 4.50; anything else stops
' with the row of the sheet, so no invoice is written with a guess.
EXPORT FUNC AMOUNT(cell, what$, row)
    DIM where$ = "Row " + STR$(row) + ": " + what$
    DIM kind$ = TYPEOF(cell)
    IF kind$ = "FLOAT64" ORELSE kind$ = "INT64" THEN RETURN cell
    DIM text$ = TRIM$("" + cell)
    IF kind$ = "NONE" ORELSE text$ = "" THEN
        THROW where$ + " is empty"
    ENDIF
    IF REGEX.MATCH("^-?[0-9]+(?:\.[0-9]+)?$", text$) THEN
        RETURN VAL(text$)
    ENDIF
    DIM hint$ = ""
    IF REGEX.MATCH("^-?[0-9]+,[0-9]+$", text$) THEN
        hint$ = " (write " + REPLACE$(text$, ",", ".") + ")"
    ENDIF
    THROW where$ + " '" + text$ + "' is not a number" + hint$
ENDFUNC

' One invoice per customer, in the order they first appear: maps with
' "customer", "email", "address" and "lines" (maps with item,
' quantity, price). The address is a list of lines, empty when the
' sheet has no column for it.
EXPORT FUNC GROUP(rows)
    DIM col = COLUMNS(rows[0])
    DIM out = []
    DIM where AS MAP
    DIM k = 0
    FOR k = 1 TO LEN(rows) - 1
        DIM r = rows[k]
        DIM who$ = TRIM$("" + r[col{"customer"}])
        IF who$ <> "" THEN
            IF NOT MAP.EXISTS(where, who$) THEN
                where{who$} = LEN(out)
                DIM mail$ = TRIM$("" + r[col{"email"}])
                PUSH(out, {"customer": who$, "email": mail$, _
                    "address": AddressOf(r, col), "lines": []})
            ENDIF
            DIM inv = out[where{who$}]
            DIM item$ = "" + r[col{"item"}]
            DIM qty = AMOUNT(r[col{"quantity"}], "quantity", k + 1)
            DIM price = AMOUNT(r[col{"price"}], "price", k + 1)
            DIM inv_lines = inv{"lines"}
            PUSH(inv_lines, {"item": item$, "quantity": qty, _
                "price": price})
        ENDIF
    NEXT k
    RETURN out
ENDFUNC

' The lines of the address cell of a row: one per line of the cell,
' or one per part between commas when it is a single line.
FUNC AddressOf(r, col)
    IF col{"address"} < 0 THEN RETURN []
    DIM text$ = REPLACE$(TRIM$("" + r[col{"address"}]), CHR$(13), "")
    IF text$ = "" THEN RETURN []
    DIM sep$ = CHR$(10)
    IF INSTR(text$, sep$) < 0 THEN sep$ = ","
    DIM parts = SELECT(LAMBDA s$ -> TRIM$(s$), SPLIT(text$, sep$))
    RETURN FILTER(LAMBDA s$ -> s$ <> "", parts)
ENDFUNC

' The invoice with "net", "vat" and "gross" added, each rounded to
' cents; vat_percent such as 19.
EXPORT FUNC TOTALS(inv, vat_percent)
    DIM net = SUM(SELECT(LAMBDA ln -> ln{"quantity"} * ln{"price"}, _
        inv{"lines"}))
    inv{"net"} = ROUND(net * 100) / 100
    inv{"vat"} = ROUND(net * vat_percent) / 100
    inv{"gross"} = inv{"net"} + inv{"vat"}
    inv{"vat_percent"} = vat_percent
    RETURN inv
ENDFUNC

' The last number stored in the counter file, 0 when there is none.
EXPORT FUNC LAST_NUMBER(counter$)
    IF NOT FILE.EXISTS(counter$) THEN RETURN 0
    RETURN VAL(TRIM$(TXTREADER$(counter$)))
ENDFUNC

' The next n invoice numbers after the one stored in the counter file,
' such as RE-2026-0007, with four digits at least and more after 9999;
' the file is not changed.
EXPORT FUNC NEXT_NUMBERS(counter$, prefix$, year$, n)
    RETURN SELECT(LAMBDA USE(prefix$, year$) v -> _
        prefix$ + year$ + "-" + FORMAT$("{:04d}", v), _
        LAST_NUMBER(counter$) + IOTA(n))
ENDFUNC

' The line of invoiced.txt in the folder for a sheet tab, such as
' "October  2026-11-02  RE-2026-0001  RE-2026-0002" with tabs between
' the parts, or "" when the tab was never invoiced. The latest line
' counts when it was invoiced more than once.
EXPORT FUNC INVOICED$(folder$, tab$)
    DIM log$ = PATH.JOIN$(folder$, "invoiced.txt")
    IF NOT FILE.EXISTS(log$) THEN RETURN ""
    DIM text$ = REPLACE$(TXTREADER$(log$), CHR$(13), "")
    DIM rows = SPLIT(text$, CHR$(10))
    DIM found$ = ""
    DIM k = 0
    FOR k = 0 TO LEN(rows) - 1
        DIM parts = SPLIT(rows[k], CHR$(9))
        IF LEN(parts) = 4 ANDALSO parts[0] = tab$ THEN
            found$ = rows[k]
        ENDIF
    NEXT k
    RETURN found$
ENDFUNC

' Adds the line for a tab to invoiced.txt in the folder.
EXPORT SUB NOTE_INVOICED(folder$, tab$, date$, first$, last$)
    DIM log$ = PATH.JOIN$(folder$, "invoiced.txt")
    DIM old$ = ""
    IF FILE.EXISTS(log$) THEN old$ = TXTREADER$(log$)
    DIM t$ = CHR$(9)
    TXTWRITER log$, old$ + tab$ + t$ + date$ + t$ + first$ + t$ + _
        last$ + CHR$(10)
ENDSUB

EXPORT FUNC MONEY$(v)
    RETURN FORMAT$("{:.2f}", v) + " EUR"
ENDFUNC

' The rows of the invoice table, the header first.
EXPORT FUNC TABLE_ROWS(inv)
    DIM body = SELECT(LAMBDA ln -> _
        [ln{"item"}, STR$(ln{"quantity"}), MONEY$(ln{"price"}), _
        MONEY$(ln{"quantity"} * ln{"price"})], inv{"lines"})
    RETURN APPEND([["Item", "Quantity", "Price", "Amount"]], body)
ENDFUNC

EXPORT FUNC TOTAL_LINES(inv)
    DIM vat$ = "VAT " + STR$(inv{"vat_percent"}) + " %"
    RETURN [["Net", MONEY$(inv{"net"})], [vat$, MONEY$(inv{"vat"})], _
        ["Total", MONEY$(inv{"gross"})]]
ENDFUNC

' The mail that goes with an invoice, the file attached.
EXPORT FUNC MAIL_FOR(inv, number$, sender$, attachment$)
    DIM subject$ = "Invoice " + number$
    DIM m = MAIL.MESSAGE(sender$, inv{"email"}, subject$)
    DIM body$ = "Hello," + CHR$(10) + CHR$(10)
    body$ = body$ + "please find invoice " + number$ + " attached, "
    body$ = body$ + "total " + MONEY$(inv{"gross"}) + "." + CHR$(10)
    body$ = body$ + CHR$(10) + "Kind regards" + CHR$(10)
    MAIL.PLAIN(m, body$ + MAIL.ADDRESSNAME$(sender$))
    MAIL.ATTACH(m, attachment$)
    RETURN m
ENDFUNC

' A text field of a map such as company, "" when it is not there.
EXPORT FUNC FIELD$(m, key$)
    IF NOT MAP.EXISTS(m, key$) THEN RETURN ""
    RETURN "" + m{key$}
ENDFUNC
