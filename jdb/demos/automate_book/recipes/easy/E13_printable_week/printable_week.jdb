' Printable Week: turns the to-do list into a one-page plan of the
' week, a column per day. The settings are the [printable_week] part
' of work.conf.
'
'   jdbasic printable_week.jdb            write the page
'   jdbasic printable_week.jdb --dry-run  show the plan only

IMPORT WORKCONF, PLANNER

DIM cfg = WORKCONF.SETTINGS(WORKCONF.CONFIG_PATH$())
DIM key$ = "printable_week."
DIM home$ = "~/Documents/AutomateWork"
DIM todo_default$ = home$ + "/todo.txt"
DIM todo$ = WORKCONF.FOLDER$(cfg, key$ + "todo_file", todo_default$)
DIM out_default$ = home$ + "/print"
DIM out$ = WORKCONF.FOLDER$(cfg, key$ + "out_folder", out_default$)
DIM n_days = WORKCONF.VALUE(cfg, key$ + "days", 5)
DIM ahead = WORKCONF.VALUE(cfg, key$ + "weeks_ahead", 1)

IF NOT FILE.EXISTS(todo$) THEN THROW "No to-do list at " + todo$
DIM tasks = PLANNER.PARSE(TXTREADER$(todo$))
DIM monday = PLANNER.MONDAY(DATEADD("D", 7 * ahead, NOW()))
DIM plan = PLANNER.PLAN(tasks, monday, n_days)
PRINT plan{"title"}
DIM columns = plan{"columns"}
DIM k = 0
FOR k = 0 TO LEN(columns) - 1
    DIM col = columns[k]
    DIM n_tasks = LEN(col{"tasks"})
    DIM word$ = " tasks"
    IF n_tasks = 1 THEN word$ = " task"
    PRINT "  "; col{"label"}; ": "; n_tasks; word$
NEXT k
IF NOT WORKCONF.FLAG("dry-run") THEN
    MKDIR out$
    DIM week$ = LEFT$(plan{"title"}, INSTR(plan{"title"}, ":"))
    DIM pdf$ = PATH.JOIN$(out$, week$ + ".pdf")
    DIM result = PLANNER.WRITE(plan, pdf$)
    PRINT "Wrote "; pdf$
    IF result{"hidden"} > 0 THEN
        PRINT result{"hidden"}; " tasks did not fit; see + more."
    ENDIF
ENDIF
