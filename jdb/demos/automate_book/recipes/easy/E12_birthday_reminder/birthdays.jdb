' birthdays.jdb: the birthdays and anniversaries of a contact list in
' the next days, with the age or the years, and a calendar file with a
' yearly event for each. A birthday on 29 February is kept on the 28th
' in other years.
'
'   IMPORT BIRTHDAYS
'   DIM people = BIRTHDAYS.CONTACTS("contacts.csv")
'   DIM soon = BIRTHDAYS.UPCOMING(people, "2026-10-01", 14)
'   BIRTHDAYS.CALENDAR(people, "2026-10-01", "birthdays.ics")

EXPORT MODULE BIRTHDAYS

IMPORT DT, ICAL, WORKCONF

FUNC Part(date$, from, n)
    RETURN CINT(MID$(date$, from, n))
ENDFUNC

' TRUE for a date written as YYYY-MM-DD that is on the calendar.
EXPORT FUNC IS_DATE(date$)
    IF NOT REGEX.MATCH("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", date$) THEN
        RETURN FALSE
    ENDIF
    DIM mo = Part(date$, 5, 2)
    DIM dd = Part(date$, 8, 2)
    IF mo < 1 ORELSE mo > 12 THEN RETURN FALSE
    RETURN dd >= 1 ANDALSO dd <= DT.DAYS_IN(Part(date$, 0, 4), mo)
ENDFUNC

' What to say about a date cell that is not a date, such as
' "31.10.1990 is not a date (write 1990-10-31)".
EXPORT FUNC NOT_A_DATE$(date$)
    DIM german$ = "^([0-9]{1,2})\.([0-9]{1,2})\.([0-9]{4})$"
    DIM dotted = REGEX.FINDALL(german$, date$)
    DIM hint$ = "write it as YYYY-MM-DD"
    IF LEN(dotted) = 1 THEN
        DIM d = dotted[0]
        DIM mo$ = RIGHT$("0" + d[1], 2)
        DIM dd$ = RIGHT$("0" + d[0], 2)
        hint$ = "write " + d[2] + "-" + mo$ + "-" + dd$
    ENDIF
    RETURN date$ + " is not a date (" + hint$ + ")"
ENDFUNC

FUNC DateCell$(cell$, who$, problems)
    IF cell$ = "" ORELSE IS_DATE(cell$) THEN RETURN cell$
    PUSH(problems, who$ + ": " + NOT_A_DATE$(cell$))
    RETURN ""
ENDFUNC

' The contacts of a CSV file with the columns name, birthday and
' anniversary (dates as YYYY-MM-DD, an empty cell for none). A cell
' that is not a date is left empty, and what is wrong with it goes
' into the list problems.
EXPORT FUNC CONTACTS(path$, problems)
    DIM kinds = ["STRING", "STRING", "STRING"]
    DIM rows = WORKCONF.READ_CSV(path$, ",", TRUE, kinds)
    DIM out = []
    DIM k = 0
    FOR k = 0 TO LEN(rows) - 1
        DIM r = rows[k]
        DIM anniv$ = ""
        IF LEN(r) > 2 THEN anniv$ = TRIM$(r[2])
        DIM who$ = TRIM$(r[0])
        DIM born$ = DateCell$(TRIM$(r[1]), who$, problems)
        anniv$ = DateCell$(anniv$, who$, problems)
        PUSH(out, {"name": who$, "birthday": born$, _
            "anniversary": anniv$})
    NEXT k
    RETURN out
ENDFUNC

' The day of a yearly date in a given year; 29 February moves to the
' 28th in common years.
FUNC DayIn(yr, date$)
    DIM mo = Part(date$, 5, 2)
    DIM dd = Part(date$, 8, 2)
    IF mo = 2 ANDALSO dd = 29 ANDALSO NOT DT.IS_LEAP(yr) THEN dd = 28
    RETURN DT.MAKE(yr, mo, dd)
ENDFUNC

' The next day on or after today$ that a yearly date comes back.
EXPORT FUNC NEXT_DATE(date$, today$)
    DIM today = DT.PARSE(today$)
    DIM yr = Part(today$, 0, 4)
    DIM on_day = DayIn(yr, date$)
    IF on_day < today THEN on_day = DayIn(yr + 1, date$)
    RETURN on_day
ENDFUNC

SUB AddEvent(out, who$, what$, date$, today$, horizon)
    IF date$ = "" THEN RETURN
    DIM on_day = NEXT_DATE(date$, today$)
    DIM n_days = DT.DIFF(DT.PARSE(today$), on_day, "days")
    IF n_days > horizon THEN RETURN
    DIM when$ = DT.FMT$(on_day, "%Y-%m-%d")
    DIM years = Part(when$, 0, 4) - Part(date$, 0, 4)
    PUSH(out, {"date": when$, "in_days": n_days, "name": who$, _
        "what": what$, "years": years})
ENDSUB

' The birthdays and anniversaries from today$ to horizon days later,
' the nearest first: maps with "date", "in_days", "name", "what" and
' "years".
EXPORT FUNC UPCOMING(people, today$, horizon)
    DIM found = []
    DIM k = 0
    FOR k = 0 TO LEN(people) - 1
        DIM p = people[k]
        AddEvent(found, p{"name"}, "birthday", p{"birthday"}, _
            today$, horizon)
        AddEvent(found, p{"name"}, "anniversary", p{"anniversary"}, _
            today$, horizon)
    NEXT k
    IF LEN(found) = 0 THEN RETURN found
    DIM waits = SELECT(LAMBDA e -> e{"in_days"}, found)
    DIM order = GRADE(waits)
    RETURN SELECT(LAMBDA USE(found) i -> found[i], order)
ENDFUNC

' One line for an entry, such as
' "Sat 03 Oct  Ann Miller turns 41 (in 2 days)".
EXPORT FUNC ENTRY$(e)
    DIM when$ = DT.FMT$(DT.PARSE(e{"date"}), "%a %d %b")
    DIM n = e{"in_days"}
    DIM soon$ = "today"
    IF n = 1 THEN soon$ = "tomorrow"
    IF n > 1 THEN soon$ = "in " + STR$(n) + " days"
    DIM what$ = e{"name"} + " turns " + STR$(e{"years"})
    IF e{"what"} = "anniversary" THEN
        what$ = e{"name"} + ": " + STR$(e{"years"}) + " years"
    ENDIF
    RETURN when$ + "  " + what$ + " (" + soon$ + ")"
ENDFUNC

FUNC AddYearly(cal, title$, date$, today$)
    IF date$ = "" THEN RETURN 0
    DIM ev = ICAL.ADDALLDAY(cal, title$, NEXT_DATE(date$, today$))
    DIM rule$ = "FREQ=YEARLY"
    IF MID$(date$, 5, 5) = "02-29" THEN
        rule$ = "FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1"
    ENDIF
    ICAL.SETPROP(cal, ev, "RRULE", rule$)
    RETURN 1
ENDFUNC

' A calendar file with a yearly all-day event for every birthday and
' anniversary, starting from its next date. Answers the event count.
EXPORT FUNC CALENDAR(people, today$, path$)
    DIM cal = ICAL.NEW()
    DIM n = 0
    DIM k = 0
    FOR k = 0 TO LEN(people) - 1
        DIM p = people[k]
        DIM who$ = p{"name"}
        n = n + AddYearly(cal, "Birthday: " + who$, p{"birthday"}, _
            today$)
        n = n + AddYearly(cal, "Anniversary: " + who$, _
            p{"anniversary"}, today$)
    NEXT k
    ICAL.WRITEFILE(cal, path$)
    RETURN n
ENDFUNC
