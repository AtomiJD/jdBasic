' Duplicate Finder: looks for files stored more than once in your
' folders and writes an Excel report of them. It deletes nothing. The
' settings are the [duplicate_finder] part of work.conf.
'
'   jdbasic duplicate_finder.jdb            the report into Excel
'   jdbasic duplicate_finder.jdb --dry-run  only the numbers, no file

IMPORT WORKCONF, DUPES

DIM cfg = WORKCONF.SETTINGS(WORKCONF.CONFIG_PATH$())
DIM key$ = "duplicate_finder."
DIM folders = WORKCONF.VALUE(cfg, key$ + "folders", ["~/Documents"])
DIM report_default$ = "~/Documents/AutomateWork/duplicates.xlsx"
DIM report$ = WORKCONF.FOLDER$(cfg, key$ + "report", report_default$)
DIM min_kb = WORKCONF.VALUE(cfg, key$ + "min_size_kb", 1)

DIM roots = SELECT(LAMBDA f$ -> WORKCONF.EXPAND$(f$), folders)
DIM paths = DUPES.FILES(roots)
PRINT LEN(paths); " files looked at"
DIM groups = DUPES.GROUPS(paths, min_kb * 1024)
IF LEN(groups) = 0 THEN
    PRINT "No file is stored twice."
ELSE
    DIM sizes = SELECT(LAMBDA g -> LEN(g{"files"}), groups)
    DIM n_rows = CINT(SUM(sizes))
    IF NOT WORKCONF.FLAG("dry-run") THEN
        n_rows = CINT(DUPES.REPORT(groups, report$))
    ENDIF
    DIM mb = ROUND(DUPES.WASTED(groups) / 1048576, 1)
    PRINT LEN(groups); " groups, "; n_rows; " files, ";
    PRINT mb; " MB in copies"
    IF WORKCONF.FLAG("dry-run") THEN
        PRINT "Nothing written. Run without --dry-run for the report."
    ELSE
        PRINT "Report: "; report$
    ENDIF
ENDIF
