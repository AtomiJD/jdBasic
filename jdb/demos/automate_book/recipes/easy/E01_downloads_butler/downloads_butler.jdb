' Downloads Butler: sorts the downloads folder into one folder per
' kind of file and month. The settings are the [downloads_butler]
' part of work.conf.
'
'   jdbasic downloads_butler.jdb            sort now
'   jdbasic downloads_butler.jdb --dry-run  show what would move

IMPORT WORKCONF, BUTLER

DIM cfg = WORKCONF.SETTINGS(WORKCONF.CONFIG_PATH$())
DIM key$ = "downloads_butler."
DIM source$ = WORKCONF.FOLDER$(cfg, key$ + "source", "~/Downloads")
DIM sorted$ = PATH.JOIN$(source$, "Sorted")
DIM target$ = WORKCONF.FOLDER$(cfg, key$ + "target", sorted$)
DIM min_age = WORKCONF.VALUE(cfg, key$ + "min_age_hours", 24)
DIM defaults = BUTLER.DEFAULT_RULES()
DIM rules = WORKCONF.VALUE(cfg, key$ + "rules", defaults)
DIM dry_run = WORKCONF.FLAG("dry-run")

DIM moves = BUTLER.PLAN(source$, target$, rules, min_age, NOW())
DIM n_sorted = BUTLER.APPLY(moves, dry_run)
IF n_sorted = 0 THEN
    PRINT "Nothing to sort in "; source$
ELSEIF dry_run THEN
    PRINT n_sorted; " files would move. Run without --dry-run."
ELSE
    PRINT n_sorted; " files sorted."
ENDIF
