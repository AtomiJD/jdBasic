' Batch Renamer: gives the files of a folder names that start with
' the day they arrived, such as "2026-10-01 scan 4711.pdf". The
' settings are the [batch_renamer] part of work.conf.
'
'   jdbasic batch_renamer.jdb            rename now
'   jdbasic batch_renamer.jdb --dry-run  show the new names

IMPORT WORKCONF, RENAMER

DIM cfg = WORKCONF.SETTINGS(WORKCONF.CONFIG_PATH$())
DIM key$ = "batch_renamer."
DIM scans$ = "~/Documents/Scans"
DIM folder$ = WORKCONF.FOLDER$(cfg, key$ + "folder", scans$)
DIM usual$ = "{date} {name}{ext}"
DIM pattern$ = WORKCONF.VALUE(cfg, key$ + "pattern", usual$)
DIM extensions = WORKCONF.VALUE(cfg, key$ + "extensions", [])
DIM dry_run = WORKCONF.FLAG("dry-run")

DIM plan = RENAMER.PLAN(folder$, pattern$, extensions)
DIM n_renamed = RENAMER.APPLY(plan, dry_run)
IF n_renamed = 0 THEN
    PRINT "Nothing to rename in "; folder$
ELSEIF dry_run THEN
    PRINT n_renamed; " files would get a new name."
ELSE
    PRINT n_renamed; " files renamed."
ENDIF
