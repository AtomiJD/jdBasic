' BASIC Royale - server-authoritative arena simulation.
' The whole match lives in one JSON-serializable state map; SIMSTEP advances
' it by 0.1 s. Shared by the offline harness (game.jdb), the match server and
' the phone client - only this module knows the rules.
EXPORT MODULE ARENA

' Board in tile units, portrait. The river splits the halves; ground units
' cross at the two bridges.
EXPORT FUNC BOARD()
    RETURN { "COLS": 18, "ROWS": 30, "RIVER_Y": 14.5, "BRIDGES": [3.5, 14.5] }
ENDFUNC

' The host can load card stats from cards.json and install them here -
' CARDS() then serves that set to the whole sim.
DIM loaded_cards = 0
EXPORT SUB SETCARDS(m)
    loaded_cards = m
ENDSUB

' Card stats. HITS: "G" = ground only, "A" = ground and air.
' FLY = ignores the river. ONLYTOWERS = walks past enemy units (Giant).
' Built-in set is the fallback when no cards.json was installed.
EXPORT FUNC CARDS()
    IF TYPEOF(loaded_cards) = "OBJECT" THEN RETURN loaded_cards
    DIM cs AS MAP = {}
    cs{"DROID"} = { "COST": 3, "HP": 660, "DMG": 75, "HITSPEED": 1.1, "REACH": 1.2, "AGGRO": 5.5, "SPD": 1.8, "N": 1, "FLY": 0, "HITS": "G", "ONLYTOWERS": 0 }
    cs{"LASER"} = { "COST": 3, "HP": 250, "DMG": 40, "HITSPEED": 0.9, "REACH": 5.0, "AGGRO": 6.5, "SPD": 1.8, "N": 2, "FLY": 0, "HITS": "A", "ONLYTOWERS": 0 }
    cs{"KOLOSS"} = { "COST": 5, "HP": 1800, "DMG": 120, "HITSPEED": 1.5, "REACH": 1.2, "AGGRO": 9.0, "SPD": 1.2, "N": 1, "FLY": 0, "HITS": "G", "ONLYTOWERS": 1 }
    cs{"WESPEN"} = { "COST": 3, "HP": 90, "DMG": 40, "HITSPEED": 1.0, "REACH": 1.6, "AGGRO": 5.5, "SPD": 2.6, "N": 3, "FLY": 1, "HITS": "A", "ONLYTOWERS": 0 }
    cs{"SPLITTER"} = { "COST": 2, "HP": 45, "DMG": 40, "HITSPEED": 1.0, "REACH": 1.0, "AGGRO": 5.5, "SPD": 2.2, "N": 4, "FLY": 0, "HITS": "G", "ONLYTOWERS": 0 }
    cs{"PLASMA"} = { "COST": 4, "SPELL": 1, "DMG": 325, "RADIUS": 2.5 }
    RETURN cs
ENDFUNC

EXPORT FUNC DIST(ax, ay, bx, by)
    RETURN SQR((ax - bx) * (ax - bx) + (ay - by) * (ay - by))
ENDFUNC

' Append a client-FX event (SHOT/HIT/BOOM/CAST/DIE/SPAWN/FALL) and prune
' the log to the newest 40 - clients dedupe by EID.
EXPORT FUNC ADDEVENT(st, ev)
    ev{"EID"} = st{"NEXTEID"}
    ev{"TICKNO"} = st{"TICKNO"}
    st{"NEXTEID"} = st{"NEXTEID"} + 1
    st{"EVENTS"} = APPEND(st{"EVENTS"}, ev)
    DIM evs = st{"EVENTS"}
    IF LEN(evs) > 40 THEN
        DIM ne = []
        DIM i
        FOR i = LEN(evs) - 40 TO LEN(evs) - 1
            ne = APPEND(ne, evs[i])
        NEXT i
        st{"EVENTS"} = ne
    ENDIF
    RETURN 0
ENDFUNC

EXPORT FUNC NEWGAME()
    DIM st AS MAP = {}
    st{"TICKNO"} = 0
    st{"T_LEFT"} = 180.0
    st{"PHASE"} = "play"
    st{"WINNER"} = -1
    st{"NEXTID"} = 1
    st{"NEXTEID"} = 1
    st{"UNITS"} = []
    st{"EVENTS"} = []
    st{"SPELLS"} = []
    st{"ELIXIR"} = [5.0, 5.0]
    st{"CROWNS"} = [0, 0]
    DIM cl = []
    cl = APPEND(cl, {})
    cl = APPEND(cl, {})
    st{"CARDLVL"} = cl
    st{"QUEUES"} = [["DROID", "LASER", "KOLOSS", "WESPEN", "SPLITTER", "PLASMA"], ["KOLOSS", "SPLITTER", "LASER", "PLASMA", "DROID", "WESPEN"]]
    DIM tws = []
    ' kings sleep (AWAKE 0) until hit or until one of their princesses falls
    tws = APPEND(tws, { "OWNER": 0, "KIND": "PRINCESS", "X": 3.5,  "Y": 23.5, "HP": 1400, "MAXHP": 1400, "CD": 0.0, "AWAKE": 1 })
    tws = APPEND(tws, { "OWNER": 0, "KIND": "PRINCESS", "X": 14.5, "Y": 23.5, "HP": 1400, "MAXHP": 1400, "CD": 0.0, "AWAKE": 1 })
    tws = APPEND(tws, { "OWNER": 0, "KIND": "KING",     "X": 9.0,  "Y": 27.5, "HP": 2600, "MAXHP": 2600, "CD": 0.0, "AWAKE": 0 })
    tws = APPEND(tws, { "OWNER": 1, "KIND": "PRINCESS", "X": 3.5,  "Y": 6.5,  "HP": 1400, "MAXHP": 1400, "CD": 0.0, "AWAKE": 1 })
    tws = APPEND(tws, { "OWNER": 1, "KIND": "PRINCESS", "X": 14.5, "Y": 6.5,  "HP": 1400, "MAXHP": 1400, "CD": 0.0, "AWAKE": 1 })
    tws = APPEND(tws, { "OWNER": 1, "KIND": "KING",     "X": 9.0,  "Y": 2.5,  "HP": 2600, "MAXHP": 2600, "CD": 0.0, "AWAKE": 0 })
    st{"TOWERS"} = tws
    RETURN st
ENDFUNC

' Deploy zone: own half, plus the quadrant of a fallen enemy princess
' (up to her row) - the classic tower-down territory gain.
EXPORT FUNC CANDEPLOY(st, pid, x, y)
    IF pid = 0 ANDALSO y >= 16 THEN RETURN 1
    IF pid = 1 ANDALSO y <= 13 THEN RETURN 1
    FOR EACH tw IN st{"TOWERS"}
        IF tw{"OWNER"} = pid ORELSE tw{"KIND"} <> "PRINCESS" ORELSE tw{"HP"} > 0 THEN CONTINUEFOR
        DIM sameside = 0
        IF tw{"X"} < 9 ANDALSO x < 9 THEN sameside = 1
        IF tw{"X"} >= 9 ANDALSO x >= 9 THEN sameside = 1
        IF sameside = 1 THEN
            IF pid = 0 ANDALSO y >= 6 THEN RETURN 1
            IF pid = 1 ANDALSO y <= 23 THEN RETURN 1
        ENDIF
    NEXT tw
    RETURN 0
ENDFUNC

' Slot of a card in a player's hand, -1 when it is not on hand.
EXPORT FUNC HANDSLOT(st, pid, kind$)
    DIM q = st{"QUEUES"}[pid]
    DIM i
    FOR i = 0 TO 3
        IF q[i] = kind$ THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

' The played card goes to the back of the queue, everything behind it moves up.
EXPORT FUNC CYCLEHAND(st, pid, slot, kind$)
    DIM q = st{"QUEUES"}[pid]
    DIM nq = []
    DIM i
    FOR i = 0 TO LEN(q) - 1
        IF i <> slot THEN nq = APPEND(nq, q[i])
    NEXT i
    nq = APPEND(nq, kind$)
    st{"QUEUES"}[pid] = nq
    RETURN 0
ENDFUNC

' Play a card for player pid at tile (x, y).
' Returns "" on success, else a reason string.
EXPORT FUNC PLAYCARD(st, pid, kind$, x, y)
    IF st{"PHASE"} <> "play" THEN RETURN "msg_over"
    DIM cs = CARDS()
    IF NOT MAP.EXISTS(cs, kind$) THEN RETURN "msg_unknown"
    DIM slot = HANDSLOT(st, pid, kind$)
    IF slot < 0 THEN RETURN "msg_nohand"
    DIM c = cs{kind$}
    ' a recall carries a selection and comes in through PLAYWARP
    IF MAP.EXISTS(c, "WARP") THEN RETURN "msg_nosel"
    IF st{"ELIXIR"}[pid] < c{"COST"} THEN RETURN "msg_elixir"
    DIM i

    DIM is_spell = MAP.EXISTS(c, "SPELL")
    IF x < 0.5 THEN x = 0.5
    IF x > 17.5 THEN x = 17.5
    IF NOT is_spell THEN
        IF CANDEPLOY(st, pid, x, y) = 0 THEN RETURN "msg_zone"
        ' a station occupies its tile: dropping on one parks the unit inside
        ' a footprint it can never walk out of
        IF TOWERBLOCK(st, x, y) = 1 THEN RETURN "msg_tower"
    ENDIF
    DIM lvl = 1
    DIM clmap = st{"CARDLVL"}[pid]
    IF MAP.EXISTS(clmap, kind$) THEN lvl = clmap{kind$}
    DIM mult = 1.0 + (lvl - 1) * 0.08

    st{"ELIXIR"}[pid] = st{"ELIXIR"}[pid] - c{"COST"}
    DIM cyc = CYCLEHAND(st, pid, slot, kind$)

    IF is_spell THEN
        ' the strike launches from the caster's king tower and lands 5
        ' ticks later - the effect applies on impact in SIMSTEP
        DIM ky = 27.5
        IF pid = 1 THEN ky = 2.5
        DIM sp AS MAP = { "OWNER": pid, "X": x, "Y": y, "DMG": INT(c{"DMG"} * mult), "RADIUS": c{"RADIUS"}, "LAND": st{"TICKNO"} + 5 }
        IF MAP.EXISTS(c, "STUN") THEN sp{"STUN"} = c{"STUN"}
        IF MAP.EXISTS(c, "PULL") THEN sp{"PULL"} = c{"PULL"}
        IF MAP.EXISTS(c, "SETTLE") THEN sp{"SETTLE"} = c{"SETTLE"}
        st{"SPELLS"} = APPEND(st{"SPELLS"}, sp)
        ADDEVENT(st, { "T": "CAST", "FX": 9.0, "FY": ky, "X": x, "Y": y })
    ELSE
        DIM offs = [[0.0, 0.0], [-0.8, 0.0], [0.8, 0.0], [0.0, -0.8], [0.0, 0.8]]
        FOR i = 0 TO c{"N"} - 1
            DIM u2 AS MAP = {}
            u2{"ID"} = st{"NEXTID"}
            u2{"OWNER"} = pid
            u2{"KIND"} = kind$
            u2{"X"} = x + offs[i][0]
            u2{"Y"} = y + offs[i][1]
            u2{"HP"} = INT(c{"HP"} * mult)
            u2{"MAXHP"} = INT(c{"HP"} * mult)
            u2{"DMG"} = INT(c{"DMG"} * mult)
            u2{"CD"} = 0.3
            ' stationary defences hold their spot and expire on their own
            IF MAP.EXISTS(c, "BUILD") THEN
                u2{"BUILD"} = 1
                u2{"X"} = x
                u2{"Y"} = y
            ENDIF
            IF MAP.EXISTS(c, "TTL") THEN u2{"TTL"} = c{"TTL"}
            IF MAP.EXISTS(c, "SPAWNS") THEN u2{"SPAWNCD"} = c{"SPAWNRATE"}
            st{"NEXTID"} = st{"NEXTID"} + 1
            st{"UNITS"} = APPEND(st{"UNITS"}, u2)
        NEXT i
        ADDEVENT(st, { "T": "SPAWN", "X": x, "Y": y })
    ENDIF
    RETURN ""
ENDFUNC

' Recall: up to WARP of the player's own ships inside the loop drawn around
' (cx, cy) jump to (x, y) in the player's own territory. The nearest to the
' middle of the loop go first, so a drawn circle takes what it encircles.
' Anchored buildings stay - a station that could be moved is not a station.
EXPORT FUNC PLAYWARP(st, pid, kind$, x, y, cx, cy, r)
    IF st{"PHASE"} <> "play" THEN RETURN "msg_over"
    DIM cs = CARDS()
    IF NOT MAP.EXISTS(cs, kind$) THEN RETURN "msg_unknown"
    DIM c = cs{kind$}
    IF NOT MAP.EXISTS(c, "WARP") THEN RETURN "msg_unknown"
    DIM slot = HANDSLOT(st, pid, kind$)
    IF slot < 0 THEN RETURN "msg_nohand"
    IF st{"ELIXIR"}[pid] < c{"COST"} THEN RETURN "msg_elixir"
    IF x < 0.5 THEN x = 0.5
    IF x > 17.5 THEN x = 17.5
    IF CANDEPLOY(st, pid, x, y) = 0 THEN RETURN "msg_zone"
    IF TOWERBLOCK(st, x, y) = 1 THEN RETURN "msg_tower"
    ' the client draws the loop, the card decides how wide it may be
    IF r > c{"RADIUS"} THEN r = c{"RADIUS"}
    IF r < 0.5 THEN r = 0.5

    DIM units = st{"UNITS"}
    DIM picked = []
    DIM taken AS MAP = {}
    DIM n_max = c{"WARP"}
    DIM k
    FOR k = 1 TO n_max
        DIM best_i = -1
        DIM best_d = 99999.0
        DIM i
        FOR i = 0 TO LEN(units) - 1
            IF MAP.EXISTS(taken, "" + i) THEN CONTINUEFOR
            DIM u = units[i]
            IF u{"OWNER"} <> pid ORELSE u{"HP"} <= 0 THEN CONTINUEFOR
            IF MAP.EXISTS(u, "BUILD") THEN CONTINUEFOR
            DIM d = DIST(cx, cy, u{"X"}, u{"Y"})
            IF d <= r ANDALSO d < best_d THEN
                best_d = d
                best_i = i
            ENDIF
        NEXT i
        IF best_i < 0 THEN EXITFOR
        taken{"" + best_i} = 1
        picked = APPEND(picked, best_i)
    NEXT k
    IF LEN(picked) = 0 THEN RETURN "msg_nocatch"

    st{"ELIXIR"}[pid] = st{"ELIXIR"}[pid] - c{"COST"}
    DIM cyc = CYCLEHAND(st, pid, slot, kind$)

    DIM offs = [[0.0, 0.0], [-0.8, 0.0], [0.8, 0.0], [0.0, -0.8], [0.0, 0.8]]
    DIM j
    FOR j = 0 TO LEN(picked) - 1
        DIM uw = units[picked[j]]
        ADDEVENT(st, { "T": "CAST", "FX": uw{"X"}, "FY": uw{"Y"}, "X": x, "Y": y })
        uw{"X"} = x + offs[j MOD 5][0]
        uw{"Y"} = y + offs[j MOD 5][1]
        ' arriving is not attacking: the jump costs the next swing
        uw{"CD"} = c{"SETTLE"}
    NEXT j
    ADDEVENT(st, { "T": "SPAWN", "X": x, "Y": y })
    RETURN ""
ENDFUNC

' Best target for unit u: enemy unit within aggro range, else nearest enemy
' tower. Giants scan towers only; ground-hitters skip flying units.
EXPORT FUNC FINDTARGET(st, u, c, cs)
    DIM best_d = 99999.0
    DIM bt AS MAP = { "OK": 0 }
    DIM i
    DIM units = st{"UNITS"}
    FOR i = 0 TO LEN(units) - 1
        DIM v = units[i]
        IF v{"OWNER"} = u{"OWNER"} ORELSE v{"HP"} <= 0 THEN CONTINUEFOR
        ' station rushers walk past troops, but a defensive building
        ' blocks their path and has to be dealt with
        IF c{"ONLYTOWERS"} = 1 ANDALSO NOT MAP.EXISTS(v, "BUILD") THEN CONTINUEFOR
        IF c{"HITS"} = "G" ANDALSO cs{v{"KIND"}}{"FLY"} = 1 THEN CONTINUEFOR
        DIM d = DIST(u{"X"}, u{"Y"}, v{"X"}, v{"Y"})
        IF d <= c{"AGGRO"} ANDALSO d < best_d THEN
            best_d = d
            bt = { "OK": 1, "T": "U", "I": i, "X": v{"X"}, "Y": v{"Y"}, "D": d }
        ENDIF
    NEXT i
    IF bt{"OK"} = 0 THEN
        DIM tws = st{"TOWERS"}
        FOR i = 0 TO LEN(tws) - 1
            DIM tw = tws[i]
            IF tw{"OWNER"} = u{"OWNER"} ORELSE tw{"HP"} <= 0 THEN CONTINUEFOR
            ' towers are big - range counts to the edge, not the center,
            ' otherwise melee can never out-reach the collision footprint
            DIM half = 1.0
            IF tw{"KIND"} = "KING" THEN half = 1.2
            DIM d2 = DIST(u{"X"}, u{"Y"}, tw{"X"}, tw{"Y"}) - half
            IF d2 < 0 THEN d2 = 0
            IF d2 < best_d THEN
                best_d = d2
                bt = { "OK": 1, "T": "W", "I": i, "X": tw{"X"}, "Y": tw{"Y"}, "D": d2 }
            ENDIF
        NEXT i
    ENDIF
    RETURN bt
ENDFUNC

' TRUE when (x, y) is inside any alive tower footprint plus unit radius.
EXPORT FUNC TOWERBLOCK(st, x, y)
    FOR EACH tw IN st{"TOWERS"}
        IF tw{"HP"} <= 0 THEN CONTINUEFOR
        DIM half = 1.4
        IF tw{"KIND"} = "KING" THEN half = 1.6
        IF ABS(x - tw{"X"}) < half ANDALSO ABS(y - tw{"Y"}) < half THEN RETURN 1
    NEXT tw
    RETURN 0
ENDFUNC

' Push overlapping ground units apart and keep them out of tower
' footprints; flyers pass over everything. Runs once per SIMSTEP after
' movement, so a single relaxation pass per tick is enough.
EXPORT FUNC RESOLVEBUMP(st, cs)
    DIM units = st{"UNITS"}
    DIM n = LEN(units)
    DIM i
    DIM j
    FOR i = 0 TO n - 1
        DIM a = units[i]
        IF a{"HP"} <= 0 THEN CONTINUEFOR
        DIM afly = cs{a{"KIND"}}{"FLY"}
        FOR j = i + 1 TO n - 1
            DIM b = units[j]
            IF b{"HP"} <= 0 THEN CONTINUEFOR
            IF cs{b{"KIND"}}{"FLY"} <> afly THEN CONTINUEFOR
            DIM dx = b{"X"} - a{"X"}
            DIM dy = b{"Y"} - a{"Y"}
            DIM d = SQR(dx * dx + dy * dy)
            IF d < 0.7 THEN
                IF d < 0.001 THEN
                    dx = 0.1
                    dy = 0.05 * ((a{"ID"} MOD 3) - 1)
                    d = 0.1
                ENDIF
                ' anchored buildings shove, they do not budge
                DIM a_fix = MAP.EXISTS(a, "BUILD")
                DIM b_fix = MAP.EXISTS(b, "BUILD")
                DIM push = (0.7 - d) / 2
                IF a_fix ANDALSO b_fix THEN CONTINUEFOR
                IF a_fix THEN
                    b{"X"} = b{"X"} + dx / d * push * 2
                    b{"Y"} = b{"Y"} + dy / d * push * 2
                ELSEIF b_fix THEN
                    a{"X"} = a{"X"} - dx / d * push * 2
                    a{"Y"} = a{"Y"} - dy / d * push * 2
                ELSE
                    a{"X"} = a{"X"} - dx / d * push
                    a{"Y"} = a{"Y"} - dy / d * push
                    b{"X"} = b{"X"} + dx / d * push
                    b{"Y"} = b{"Y"} + dy / d * push
                ENDIF
            ENDIF
        NEXT j
        IF afly = 0 THEN
            FOR EACH tw IN st{"TOWERS"}
                IF tw{"HP"} <= 0 THEN CONTINUEFOR
                DIM half = 1.0
                IF tw{"KIND"} = "KING" THEN half = 1.2
                DIM cxp = a{"X"}
                IF cxp < tw{"X"} - half THEN cxp = tw{"X"} - half
                IF cxp > tw{"X"} + half THEN cxp = tw{"X"} + half
                DIM cyp = a{"Y"}
                IF cyp < tw{"Y"} - half THEN cyp = tw{"Y"} - half
                IF cyp > tw{"Y"} + half THEN cyp = tw{"Y"} + half
                DIM tdx = a{"X"} - cxp
                DIM tdy = a{"Y"} - cyp
                DIM td = SQR(tdx * tdx + tdy * tdy)
                IF td < 0.001 THEN
                    ' center inside the box: exit along the shallowest axis,
                    ' all the way clear of the footprint in one step
                    DIM ox = a{"X"} - tw{"X"}
                    DIM oy = a{"Y"} - tw{"Y"}
                    DIM outx = half + 0.45 - ABS(ox)
                    DIM outy = half + 0.45 - ABS(oy)
                    IF outx <= outy THEN
                        IF ox < 0 THEN outx = 0 - outx
                        a{"X"} = a{"X"} + outx
                    ELSE
                        IF oy < 0 THEN outy = 0 - outy
                        a{"Y"} = a{"Y"} + outy
                    ENDIF
                ELSEIF td < 0.45 THEN
                    a{"X"} = a{"X"} + tdx / td * (0.45 - td)
                    a{"Y"} = a{"Y"} + tdy / td * (0.45 - td)
                ENDIF
            NEXT tw
        ENDIF
        IF a{"X"} < 0.3 THEN a{"X"} = 0.3
        IF a{"X"} > 17.7 THEN a{"X"} = 17.7
        IF a{"Y"} < 0.3 THEN a{"Y"} = 0.3
        IF a{"Y"} > 29.7 THEN a{"Y"} = 29.7
    NEXT i
    RETURN 0
ENDFUNC

' One 0.1 s simulation step: elixir, unit AI, tower fire, deaths, win check.
EXPORT FUNC SIMSTEP(st)
    IF st{"PHASE"} <> "play" THEN RETURN st
    DIM dt = 0.1
    st{"TICKNO"} = st{"TICKNO"} + 1
    st{"T_LEFT"} = st{"T_LEFT"} - dt

    DIM erate = dt / 2.8
    IF st{"T_LEFT"} < 0 THEN erate = erate * 2
    DIM p
    FOR p = 0 TO 1
        DIM ex = st{"ELIXIR"}[p] + erate
        IF ex > 10 THEN ex = 10
        st{"ELIXIR"}[p] = ex
    NEXT p

    DIM cs = CARDS()
    DIM bd = BOARD()

    ' pending spells land
    IF LEN(st{"SPELLS"}) > 0 THEN
        DIM keep = []
        FOR EACH sp IN st{"SPELLS"}
            IF sp{"LAND"} <= st{"TICKNO"} THEN
                FOR EACH u0 IN st{"UNITS"}
                    IF u0{"OWNER"} <> sp{"OWNER"} ANDALSO DIST(sp{"X"}, sp{"Y"}, u0{"X"}, u0{"Y"}) <= sp{"RADIUS"} THEN
                        u0{"HP"} = u0{"HP"} - sp{"DMG"}
                        ' a stasis field holds everything it catches
                        IF MAP.EXISTS(sp, "STUN") THEN u0{"STUN"} = sp{"STUN"}
                        ' a beam drags what it catches toward the middle. It
                        ' never drags it past - a ship yanked through the
                        ' centre would come out the far side of the fight.
                        IF MAP.EXISTS(sp, "PULL") ANDALSO NOT MAP.EXISTS(u0, "BUILD") THEN
                            DIM pdx = sp{"X"} - u0{"X"}
                            DIM pdy = sp{"Y"} - u0{"Y"}
                            DIM pd = SQR(pdx * pdx + pdy * pdy)
                            IF pd > 0.001 THEN
                                DIM haul = sp{"PULL"}
                                IF haul > pd THEN haul = pd
                                u0{"X"} = u0{"X"} + pdx / pd * haul
                                u0{"Y"} = u0{"Y"} + pdy / pd * haul
                                ' being hauled costs the next swing
                                IF MAP.EXISTS(sp, "SETTLE") THEN u0{"CD"} = sp{"SETTLE"}
                            ENDIF
                        ENDIF
                    ENDIF
                NEXT u0
                FOR EACH tw0 IN st{"TOWERS"}
                    IF tw0{"OWNER"} <> sp{"OWNER"} ANDALSO tw0{"HP"} > 0 ANDALSO DIST(sp{"X"}, sp{"Y"}, tw0{"X"}, tw0{"Y"}) <= sp{"RADIUS"} THEN
                        tw0{"HP"} = tw0{"HP"} - sp{"DMG"}
                        IF tw0{"KIND"} = "KING" THEN tw0{"AWAKE"} = 1
                    ENDIF
                NEXT tw0
                ADDEVENT(st, { "T": "BOOM", "X": sp{"X"}, "Y": sp{"Y"}, "RADIUS": sp{"RADIUS"}, "D": sp{"DMG"} })
            ELSE
                keep = APPEND(keep, sp)
            ENDIF
        NEXT sp
        st{"SPELLS"} = keep
    ENDIF

    DIM hatched = []
    FOR EACH u IN st{"UNITS"}
        IF u{"HP"} <= 0 THEN CONTINUEFOR
        DIM c = cs{u{"KIND"}}

        ' held in stasis: no move, no shot, just the clock running down
        IF MAP.EXISTS(u, "STUN") THEN
            IF u{"STUN"} > 0 THEN
                u{"STUN"} = u{"STUN"} - dt
                CONTINUEFOR
            ENDIF
        ENDIF

        ' timed defences wear out
        IF MAP.EXISTS(u, "TTL") THEN
            u{"TTL"} = u{"TTL"} - dt
            IF u{"TTL"} <= 0 THEN
                u{"HP"} = 0
                CONTINUEFOR
            ENDIF
        ENDIF

        ' Carriers and hatcheries release a batch on their own cadence. SPAWNS
        ' is one card or a list of them; a list is dealt out round robin, so
        ' SPAWNN 2 over ["NANOS", "WESPEN"] hatches one of each.
        IF MAP.EXISTS(u, "SPAWNCD") THEN
            u{"SPAWNCD"} = u{"SPAWNCD"} - dt
            IF u{"SPAWNCD"} <= 0 THEN
                u{"SPAWNCD"} = c{"SPAWNRATE"}
                DIM n_brood = 1
                IF MAP.EXISTS(c, "SPAWNN") THEN n_brood = c{"SPAWNN"}
                DIM brood_kinds = c{"SPAWNS"}
                IF TYPEOF(brood_kinds) <> "ARRAY" THEN brood_kinds = [c{"SPAWNS"}]
                DIM bi
                FOR bi = 0 TO n_brood - 1
                    DIM bk$ = "" + brood_kinds[bi MOD LEN(brood_kinds)]
                    hatched = APPEND(hatched, [{ "OWNER": u{"OWNER"}, "KIND": bk$, "X": u{"X"}, "Y": u{"Y"}, "SLOT": bi }])
                NEXT bi
            ENDIF
        ENDIF

        DIM tgt = FINDTARGET(st, u, c, cs)
        IF tgt{"OK"} = 0 THEN CONTINUEFOR
        u{"CD"} = u{"CD"} - dt
        IF tgt{"D"} <= c{"REACH"} THEN
            IF u{"CD"} <= 0 THEN
                u{"CD"} = c{"HITSPEED"}
                DIM hitdmg = c{"DMG"}
                IF MAP.EXISTS(u, "DMG") THEN hitdmg = u{"DMG"}
                IF tgt{"T"} = "U" THEN
                    DIM v2 = st{"UNITS"}[tgt{"I"}]
                    v2{"HP"} = v2{"HP"} - hitdmg
                ELSE
                    DIM tw2 = st{"TOWERS"}[tgt{"I"}]
                    tw2{"HP"} = tw2{"HP"} - hitdmg
                    IF tw2{"KIND"} = "KING" THEN tw2{"AWAKE"} = 1
                ENDIF
                ' SPLASH catches the ships standing around whatever was hit -
                ' stations are too big to be caught by a neighbour's blast, so
                ' only the target itself takes the hit if it is one. What a
                ' hitter cannot reach on its own it cannot splash either: a
                ' ground gun does not throw its blast at flyers.
                IF MAP.EXISTS(c, "SPLASH") THEN
                    DIM si
                    DIM sunits = st{"UNITS"}
                    FOR si = 0 TO LEN(sunits) - 1
                        IF tgt{"T"} = "U" ANDALSO si = tgt{"I"} THEN CONTINUEFOR
                        DIM sv = sunits[si]
                        IF sv{"OWNER"} = u{"OWNER"} ORELSE sv{"HP"} <= 0 THEN CONTINUEFOR
                        IF c{"HITS"} = "G" ANDALSO cs{sv{"KIND"}}{"FLY"} = 1 THEN CONTINUEFOR
                        IF DIST(tgt{"X"}, tgt{"Y"}, sv{"X"}, sv{"Y"}) <= c{"SPLASH"} THEN
                            sv{"HP"} = sv{"HP"} - hitdmg
                        ENDIF
                    NEXT si
                    ADDEVENT(st, { "T": "BOOM", "X": tgt{"X"}, "Y": tgt{"Y"}, "RADIUS": c{"SPLASH"}, "D": hitdmg })
                ENDIF
                DIM adx = tgt{"X"} - u{"X"}
                DIM ady = tgt{"Y"} - u{"Y"}
                DIM ad = SQR(adx * adx + ady * ady)
                IF ad > 0.001 THEN
                    u{"ADX"} = adx / ad
                    u{"ADY"} = ady / ad
                    u{"AT"} = st{"TICKNO"}
                ENDIF
                IF c{"REACH"} > 2 THEN
                    ADDEVENT(st, { "T": "SHOT", "FX": u{"X"}, "FY": u{"Y"}, "X": tgt{"X"}, "Y": tgt{"Y"}, "D": hitdmg })
                ELSE
                    ADDEVENT(st, { "T": "HIT", "X": tgt{"X"}, "Y": tgt{"Y"}, "D": hitdmg })
                ENDIF
            ENDIF
        ELSEIF MAP.EXISTS(u, "BUILD") THEN
            ' a building never closes the distance - it waits
            u{"CD"} = u{"CD"}
        ELSE
            DIM wx = tgt{"X"}
            DIM wy = tgt{"Y"}
            IF c{"FLY"} = 0 THEN
                DIM ry = bd{"RIVER_Y"}
                IF (u{"Y"} < ry ANDALSO tgt{"Y"} > ry) ORELSE (u{"Y"} > ry ANDALSO tgt{"Y"} < ry) THEN
                    DIM b0 = bd{"BRIDGES"}[0]
                    DIM b1 = bd{"BRIDGES"}[1]
                    DIM bx = b0
                    IF ABS(u{"X"} - b1) < ABS(u{"X"} - b0) THEN bx = b1
                    wx = bx
                    ' aim past the far bank, not at the river line - a unit
                    ' arriving sideways would overshoot along the bank and
                    ' oscillate on the bridge forever
                    IF tgt{"Y"} > ry THEN
                        wy = ry + 1.2
                    ELSE
                        wy = ry - 1.2
                    ENDIF
                ENDIF
            ENDIF
            DIM ddx = wx - u{"X"}
            DIM ddy = wy - u{"Y"}
            DIM dd = SQR(ddx * ddx + ddy * ddy)
            IF dd > 0.001 THEN
                DIM nxp = u{"X"} + ddx / dd * c{"SPD"} * dt
                DIM nyp = u{"Y"} + ddy / dd * c{"SPD"} * dt
                ' route around tower footprints: slide along the dominant
                ' axis, and when walking head-on into a face (no tangent
                ' component), side-step perpendicular until the corner clears
                IF c{"FLY"} = 0 ANDALSO TOWERBLOCK(st, nxp, nyp) = 1 THEN
                    DIM stepx = ddx / dd * c{"SPD"} * dt
                    DIM stepy = ddy / dd * c{"SPD"} * dt
                    IF ABS(ddx) >= ABS(ddy) ANDALSO TOWERBLOCK(st, u{"X"} + stepx, u{"Y"}) = 0 THEN
                        nxp = u{"X"} + stepx
                        nyp = u{"Y"}
                    ELSEIF ABS(ddy) > ABS(ddx) ANDALSO TOWERBLOCK(st, u{"X"}, u{"Y"} + stepy) = 0 THEN
                        nxp = u{"X"}
                        nyp = u{"Y"} + stepy
                    ELSE
                        DIM pxd = stepy
                        DIM pyd = 0 - stepx
                        IF u{"ID"} MOD 2 = 1 THEN
                            pxd = 0 - pxd
                            pyd = 0 - pyd
                        ENDIF
                        IF TOWERBLOCK(st, u{"X"} + pxd, u{"Y"} + pyd) = 0 THEN
                            nxp = u{"X"} + pxd
                            nyp = u{"Y"} + pyd
                        ELSEIF TOWERBLOCK(st, u{"X"} - pxd, u{"Y"} - pyd) = 0 THEN
                            nxp = u{"X"} - pxd
                            nyp = u{"Y"} - pyd
                        ELSE
                            nxp = u{"X"}
                            nyp = u{"Y"}
                        ENDIF
                    ENDIF
                ENDIF
                u{"X"} = nxp
                u{"Y"} = nyp
            ENDIF
        ENDIF
    NEXT u

    ' drones join after the pass, so the loop never walks a growing list
    FOR EACH hb IN hatched
        DIM hc = cs{hb{"KIND"}}
        DIM hu AS MAP = {}
        hu{"ID"} = st{"NEXTID"}
        hu{"OWNER"} = hb{"OWNER"}
        hu{"KIND"} = hb{"KIND"}
        hu{"X"} = hb{"X"} + 0.7
        hu{"Y"} = hb{"Y"} + hb{"SLOT"} * 0.6 - 0.3
        hu{"HP"} = hc{"HP"}
        hu{"MAXHP"} = hc{"HP"}
        hu{"DMG"} = hc{"DMG"}
        hu{"CD"} = 0.3
        st{"NEXTID"} = st{"NEXTID"} + 1
        st{"UNITS"} = APPEND(st{"UNITS"}, hu)
        ADDEVENT(st, { "T": "SPAWN", "X": hb{"X"}, "Y": hb{"Y"} })
    NEXT hb

    RESOLVEBUMP(st, cs)

    FOR EACH tw IN st{"TOWERS"}
        IF tw{"HP"} <= 0 ORELSE tw{"AWAKE"} = 0 THEN CONTINUEFOR
        tw{"CD"} = tw{"CD"} - dt
        DIM best_i = -1
        DIM best_d = 7.0
        DIM units2 = st{"UNITS"}
        DIM ii
        FOR ii = 0 TO LEN(units2) - 1
            DIM uu = units2[ii]
            IF uu{"OWNER"} = tw{"OWNER"} ORELSE uu{"HP"} <= 0 THEN CONTINUEFOR
            DIM d3 = DIST(tw{"X"}, tw{"Y"}, uu{"X"}, uu{"Y"})
            IF d3 < best_d THEN
                best_d = d3
                best_i = ii
            ENDIF
        NEXT ii
        IF best_i >= 0 ANDALSO tw{"CD"} <= 0 THEN
            tw{"CD"} = 0.8
            DIM uu2 = units2[best_i]
            uu2{"HP"} = uu2{"HP"} - 90
            ADDEVENT(st, { "T": "SHOT", "FX": tw{"X"}, "FY": tw{"Y"}, "X": uu2{"X"}, "Y": uu2{"Y"}, "D": 90 })
        ENDIF
    NEXT tw

    DIM alive = []
    FOR EACH u3 IN st{"UNITS"}
        IF u3{"HP"} > 0 THEN
            alive = APPEND(alive, u3)
        ELSE
            ADDEVENT(st, { "T": "DIE", "X": u3{"X"}, "Y": u3{"Y"} })
        ENDIF
    NEXT u3
    st{"UNITS"} = alive

    DIM cr = [0, 0]
    FOR EACH tw3 IN st{"TOWERS"}
        IF tw3{"HP"} <= 0 THEN
            IF NOT MAP.EXISTS(tw3, "FALLEN") THEN
                tw3{"FALLEN"} = 1
                ADDEVENT(st, { "T": "FALL", "X": tw3{"X"}, "Y": tw3{"Y"} })
                IF tw3{"KIND"} = "PRINCESS" THEN
                    FOR EACH tw4 IN st{"TOWERS"}
                        IF tw4{"OWNER"} = tw3{"OWNER"} ANDALSO tw4{"KIND"} = "KING" THEN tw4{"AWAKE"} = 1
                    NEXT tw4
                ENDIF
            ENDIF
            DIM scorer = 1 - tw3{"OWNER"}
            IF tw3{"KIND"} = "KING" THEN
                st{"PHASE"} = "over"
                st{"WINNER"} = scorer
                cr[scorer] = 3
            ELSE
                cr[scorer] = cr[scorer] + 1
            ENDIF
        ENDIF
    NEXT tw3
    st{"CROWNS"} = cr

    IF st{"PHASE"} = "play" THEN
        IF st{"T_LEFT"} <= -60 THEN
            st{"PHASE"} = "over"
            IF cr[0] > cr[1] THEN
                st{"WINNER"} = 0
            ELSEIF cr[1] > cr[0] THEN
                st{"WINNER"} = 1
            ELSE
                ' tiebreak: more remaining tower health wins
                DIM hp0 = 0
                DIM hp1 = 0
                FOR EACH twh IN st{"TOWERS"}
                    IF twh{"HP"} > 0 THEN
                        IF twh{"OWNER"} = 0 THEN
                            hp0 = hp0 + twh{"HP"}
                        ELSE
                            hp1 = hp1 + twh{"HP"}
                        ENDIF
                    ENDIF
                NEXT twh
                IF hp0 > hp1 THEN
                    st{"WINNER"} = 0
                ELSEIF hp1 > hp0 THEN
                    st{"WINNER"} = 1
                ELSE
                    st{"WINNER"} = 2
                ENDIF
            ENDIF
        ELSEIF st{"T_LEFT"} <= 0 ANDALSO cr[0] <> cr[1] THEN
            st{"PHASE"} = "over"
            IF cr[0] > cr[1] THEN
                st{"WINNER"} = 0
            ELSE
                st{"WINNER"} = 1
            ENDIF
        ENDIF
    ENDIF
    RETURN st
ENDFUNC
