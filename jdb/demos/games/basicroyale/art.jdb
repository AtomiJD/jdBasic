' BASIC Royale - procedural sprite art.
' Every figure is a handful of signed-distance shapes (disc, rounded box,
' capsule) that a vectorised rasteriser turns into an RGBA sprite once at
' startup. Whole-array math does the work: one pass per shape over the
' pixel grid, so a 40x40 figure costs a few dozen array ops instead of
' 1600 interpreted pixel steps. Glow is a quadratic falloff outside the
' shape, edges get one pixel of coverage antialiasing.
EXPORT MODULE ART

' ── shape constructors ────────────────────────────────────────
' col$ picks the palette slot: "TEAM" (player colour), "HULL", "DARK",
' "LIGHT" or "ACCENT". glow 0..1 adds a halo in the same colour.

EXPORT FUNC DISC(x, y, r, col$, glow)
    RETURN { "T": "CIRC", "X": x, "Y": y, "R": r, "COL": col$, "GLOW": glow }
ENDFUNC

EXPORT FUNC BOXR(x, y, hx, hy, rr, rot, col$, glow)
    RETURN { "T": "BOX", "X": x, "Y": y, "HX": hx, "HY": hy, "RR": rr, "ROT": rot, "COL": col$, "GLOW": glow }
ENDFUNC

EXPORT FUNC BAR(x1, y1, x2, y2, r, col$, glow)
    RETURN { "T": "SEG", "X1": x1, "Y1": y1, "X2": x2, "Y2": y2, "R": r, "COL": col$, "GLOW": glow }
ENDFUNC

' ── palette ───────────────────────────────────────────────────
' Per-card accent colours, installed by the host from cards.json. The team
' keeps the hull lights, so friend and foe stay one glance apart while the
' accent says which card is on the tile.
DIM card_accent = 0
EXPORT SUB SETACCENTS(m)
    card_accent = m
ENDSUB

' Figures authored in cards.json, keyed by card. A card that brings its own
' shape list needs no branch in FIGURE below - which is what makes a new card
' a data change rather than a code change, on the server and in the client
' alike (the client is handed the same table over /cards).
DIM card_shape = 0
EXPORT SUB SETSHAPES(m)
    card_shape = m
ENDSUB

' One authored row -> the map the rasteriser wants. A row reads like the
' constructor call it replaces: ["DISC", x, y, r, col$, glow].
EXPORT FUNC SHAPEOF(row)
    DIM t$ = UCASE$("" + row[0])
    IF t$ = "DISC" THEN RETURN DISC(row[1], row[2], row[3], "" + row[4], row[5])
    IF t$ = "BOXR" THEN RETURN BOXR(row[1], row[2], row[3], row[4], row[5], row[6], "" + row[7], row[8])
    IF t$ = "BAR" THEN RETURN BAR(row[1], row[2], row[3], row[4], row[5], "" + row[6], row[7])
    ' an unreadable row draws a plain hull disc: a wrong figure is easier to
    ' spot on screen than a crash in the middle of baking
    RETURN DISC(20, 20, 7, "HULL", 0)
ENDFUNC

' Two team looks: cyan for the local player, magenta-red for the foe.
EXPORT FUNC PALETTE(team)
    DIM p AS MAP = {}
    IF team = 0 THEN
        ' electric cyan hull lights with a violet neon accent
        p{"TEAM"} = [50, 240, 255]
        p{"ACCENT"} = [190, 110, 255]
    ELSE
        ' hot magenta with a neon amber accent
        p{"TEAM"} = [255, 45, 175]
        p{"ACCENT"} = [255, 190, 60]
    ENDIF
    p{"HULL"} = [186, 190, 230]
    ' darkest slot - a violet tint keeps it glowing against the void
    p{"DARK"} = [122, 96, 180]
    p{"LIGHT"} = [255, 252, 255]
    RETURN p
ENDFUNC

' ── the rasteriser ────────────────────────────────────────────
' Returns a flat RGBA buffer (w*h*4) for the shape list.
' zoom > 1 enlarges the figure inside the same canvas - the grid shrinks
' toward the centre instead of every shape carrying scaled numbers.
EXPORT FUNC RASTER(shapes, w, h, pal, zoom)
    DIM n = w * h
    DIM idx = IOTA(n, 0)
    DIM xs = ((idx MOD w) + 0.5 - w / 2.0) / zoom + w / 2.0
    DIM ys = (INT(idx / w) + 0.5 - h / 2.0) / zoom + h / 2.0

    DIM outr = idx * 0.0
    DIM outg = outr + 0
    DIM outb = outr + 0
    DIM outa = outr + 0

    FOR EACH sh IN shapes
        DIM t$ = sh{"T"}
        DIM d = outr + 0
        IF t$ = "CIRC" THEN
            DIM dx = xs - sh{"X"}
            DIM dy = ys - sh{"Y"}
            d = SQR(dx * dx + dy * dy) - sh{"R"}
        ELSEIF t$ = "BOX" THEN
            DIM bx = xs - sh{"X"}
            DIM by = ys - sh{"Y"}
            DIM ang = sh{"ROT"} * 3.14159265 / 180.0
            DIM ca = COS(ang)
            DIM sa = SIN(ang)
            DIM rx = bx * ca + by * sa
            DIM ry = by * ca - bx * sa
            DIM qx = ABS(rx) - sh{"HX"} + sh{"RR"}
            DIM qy = ABS(ry) - sh{"HY"} + sh{"RR"}
            DIM px = qx * (qx > 0)
            DIM py = qy * (qy > 0)
            DIM inside = qx * (qx > qy) + qy * (qy >= qx)
            d = SQR(px * px + py * py) + inside * (inside < 0) - sh{"RR"}
        ELSE
            DIM ax = sh{"X1"}
            DIM ay = sh{"Y1"}
            DIM ex = sh{"X2"} - ax
            DIM ey = sh{"Y2"} - ay
            DIM elen = ex * ex + ey * ey
            IF elen < 0.0001 THEN elen = 0.0001
            DIM px2 = xs - ax
            DIM py2 = ys - ay
            DIM tt = (px2 * ex + py2 * ey) / elen
            DIM tc = tt * (tt > 0) * (tt < 1) + (tt >= 1)
            DIM cx2 = px2 - ex * tc
            DIM cy2 = py2 - ey * tc
            d = SQR(cx2 * cx2 + cy2 * cy2) - sh{"R"}
        ENDIF

        DIM col = pal{sh{"COL"}}
        ' body coverage with one pixel of antialiasing
        DIM cov = 0.5 - d
        cov = cov * (cov > 0) * (cov < 1) + (cov >= 1)
        ' halo: quadratic falloff over four pixels outside the edge
        DIM gl = sh{"GLOW"}
        IF gl > 0 THEN
            DIM gd = 1.0 - d / 4.5
            gd = gd * (gd > 0) * (gd < 1) + (gd >= 1)
            cov = cov + gd * gd * gl * (cov < 0.999)
        ENDIF
        DIM keep = 1.0 - cov
        outr = outr * keep + col[0] * cov
        outg = outg * keep + col[1] * cov
        outb = outb * keep + col[2] * cov
        outa = outa * keep + 255.0 * cov
    NEXT sh

    DIM stacked = STACK(0, outr, outg, outb, outa)
    RETURN RESHAPE(TRANSPOSE(stacked), [n * 4])
ENDFUNC

' Bakes a shape list into a ready sprite and returns its id.
EXPORT FUNC BAKE(shapes, w, h, team, zoom)
    DIM sid = SPRITE.CREATE(w, h)
    SPRITE.SETBUFFER(sid, RASTER(shapes, w, h, PALETTE(team), zoom))
    SPRITE.SET_ORIGIN(sid, w / 2, h / 2)
    RETURN sid
ENDFUNC

' Same, with the card's own accent in place of the team accent.
EXPORT FUNC BAKECARD(kind$, shapes, w, h, team, zoom)
    DIM pal = PALETTE(team)
    IF TYPEOF(card_accent) = "OBJECT" THEN
        IF MAP.EXISTS(card_accent, kind$) THEN pal{"ACCENT"} = card_accent{kind$}
    ENDIF
    DIM sid = SPRITE.CREATE(w, h)
    SPRITE.SETBUFFER(sid, RASTER(shapes, w, h, pal, zoom))
    SPRITE.SET_ORIGIN(sid, w / 2, h / 2)
    RETURN sid
ENDFUNC

' ── the roster ────────────────────────────────────────────────
' Card figures come from cards.json through SETSHAPES; a card is data. The
' two station classes are not cards and stay here, on a 72x72 canvas.
EXPORT FUNC FIGURE(kind$)
    DIM s = []
    IF TYPEOF(card_shape) = "OBJECT" ANDALSO MAP.EXISTS(card_shape, kind$) THEN
        FOR EACH row IN card_shape{kind$}
            s = APPEND(s, [SHAPEOF(row)])
        NEXT row
        RETURN s
    ENDIF
    IF kind$ = "PRINCESS" THEN
        s = APPEND(s, [BOXR(36, 44, 26, 5, 5, 0, "HULL", 0)])
        s = APPEND(s, [DISC(36, 34, 14, "HULL", 0)])
        s = APPEND(s, [DISC(36, 32, 9, "TEAM", 0.6)])
        s = APPEND(s, [BAR(36, 22, 36, 12, 2, "ACCENT", 1.0)])
        s = APPEND(s, [DISC(36, 12, 3.5, "LIGHT", 1.0)])
    ELSE
        s = APPEND(s, [BOXR(36, 46, 30, 6, 6, 0, "HULL", 0)])
        s = APPEND(s, [DISC(36, 36, 19, "HULL", 0)])
        s = APPEND(s, [DISC(36, 34, 13, "TEAM", 0.7)])
        s = APPEND(s, [DISC(36, 34, 6, "LIGHT", 1.0)])
        s = APPEND(s, [BAR(12, 48, 60, 48, 2.5, "ACCENT", 0.9)])
    ENDIF
    RETURN s
ENDFUNC

' Bakes every unit and station for one team; returns kind -> sprite id.
EXPORT FUNC BAKEALL(kinds, team)
    DIM out AS MAP = {}
    FOR EACH k$ IN kinds
        out{k$} = BAKECARD(k$, FIGURE(k$), 40, 40, team, 1.18)
    NEXT k$
    out{"PRINCESS"} = BAKE(FIGURE("PRINCESS"), 72, 72, team, 1.05)
    out{"KING"} = BAKE(FIGURE("KING"), 72, 72, team, 1.0)
    RETURN out
ENDFUNC
