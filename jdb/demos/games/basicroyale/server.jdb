' BASIC Royale match server - one match, two players, server-authoritative.
' The sim catches up lazily on every request: elapsed wall time is replayed
' as 0.1 s SIMSTEPs, so no background thread is needed and the match simply
' pauses while nobody polls. Clients POST JSON with Content-Type text/plain
' (a CORS simple request - no OPTIONS preflight, which the server has no
' route for) and every response carries Access-Control-Allow-Origin: *.
IMPORT ARENA

' cards.json is the single source of truth for card stats and colors -
' the sim uses it via ARENA.SETCARDS, clients fetch it as GET /cards.
DIM cards_json$ = ""
TRY
    cards_json$ = TXTREADER$("cards.json")
    ARENA.SETCARDS(JSON.PARSE$(cards_json$))
    PRINT "cards.json loaded"
CATCH
    PRINT "cards.json missing - built-in card set"
ENDTRY

' Own MINSTD generator instead of RND: the CRT's rand() keeps per-thread
' state on Windows, so seeding on the main thread leaves the HTTP handler
' threads - where chests are dealt - on the identical default sequence.
' This one lives in VM state and is shared by every handler.
' Seed from the wallclock where available, always folding in a fresh UUID
' so the sequence differs per run even on runtimes without NOW_EPOCH.
FUNC SEEDVAL()
    DIM s = 0
    TRY
        s = NOW_EPOCH()
    CATCH
    ENDTRY
    DIM u$ = LCASE$(CODEC.UUID$())
    DIM i
    FOR i = 0 TO LEN(u$) - 1
        DIM p = INSTR("0123456789abcdef", MID$(u$, i, 1))
        IF p >= 0 THEN s = (s * 31 + p) MOD 2147483647
    NEXT i
    IF s < 1 THEN s = 1
    RETURN s
ENDFUNC

DIM rng_state = SEEDVAL()

FUNC NEXTRAND()
    rng_state = (rng_state * 16807) MOD 2147483647
    RETURN rng_state / 2147483647.0
ENDFUNC

' One match per room, so any number of pairs can play at once. A room is
' created on first contact and holds its own sim, seats and clock.
DIM rooms AS MAP = {}

FUNC ROOMKEY$(raw$)
    DIM out$ = ""
    DIM i
    FOR i = 0 TO LEN(raw$) - 1
        DIM ch$ = LCASE$(MID$(raw$, i, 1))
        IF INSTR("abcdefghijklmnopqrstuvwxyz0123456789-_", ch$) >= 0 THEN out$ = out$ + ch$
        IF LEN(out$) >= 24 THEN EXITFOR
    NEXT i
    IF out$ = "" THEN out$ = "main"
    RETURN out$
ENDFUNC

FUNC ROOM(name$)
    DIM key$ = ROOMKEY$(name$)
    IF NOT MAP.EXISTS(rooms, key$) THEN
        rooms{key$} = { "ST": ARENA.NEWGAME(), "PLAYERS": [], "LAST": TICK(), "KEY": key$ }
        PRINT "room opened: "; key$
    ENDIF
    RETURN rooms{key$}
ENDFUNC

' Room named in a query parameter (GET) or a parsed body (POST).
FUNC ROOMOF(req, b)
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "ROOM") THEN RETURN ROOM(b{"ROOM"})
    IF MAP.EXISTS(req{"PARAMS"}, "room") THEN RETURN ROOM(req{"PARAMS"}{"room"})
    RETURN ROOM("main")
ENDFUNC

' Admin key from admin.txt next to the server. Without the file every
' destructive endpoint stays shut - failing closed beats a default key.
DIM admin_key$ = ""
TRY
    admin_key$ = TRIM$(TXTREADER$("admin.txt"))
CATCH
ENDTRY
IF admin_key$ = "" THEN
    PRINT "admin.txt missing - admin endpoints disabled"
ELSE
    PRINT "admin endpoints armed"
ENDIF

FUNC ISADMIN(req, b)
    IF admin_key$ = "" THEN RETURN 0
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "KEY") THEN
        IF b{"KEY"} = admin_key$ THEN RETURN 1
    ENDIF
    IF MAP.EXISTS(req{"PARAMS"}, "key") THEN
        IF req{"PARAMS"}{"key"} = admin_key$ THEN RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

FUNC DENY()
    RETURN { "__http_status": 403, "__http_body": "{""OK"":0,""MSG"":""admin key required""}", "__http_content_type": "application/json", "__http_headers": { "Access-Control-Allow-Origin": "*" } }
ENDFUNC

' Lifetime stats per player name, persisted across server restarts:
' record, crowns, collected card copies, wildcards and the last chest.
DIM stats AS MAP = {}
TRY
    stats = JSON.PARSE$(TXTREADER$("stats.json"))
CATCH
ENDTRY

SUB SAVESTATS()
    TRY
        TXTWRITER "stats.json", JSON.STRINGIFY$(stats)
    CATCH
    ENDTRY
ENDSUB

FUNC STATOF(name$)
    IF NOT MAP.EXISTS(stats, name$) THEN
        stats{name$} = { "WINS": 0, "LOSSES": 0, "DRAWS": 0, "CROWNS": 0 }
    ENDIF
    DIM s = stats{name$}
    IF NOT MAP.EXISTS(s, "CARDS") THEN s{"CARDS"} = {}
    IF NOT MAP.EXISTS(s, "WILD") THEN s{"WILD"} = 0
    IF NOT MAP.EXISTS(s, "LASTCHEST") THEN s{"LASTCHEST"} = []
    IF NOT MAP.EXISTS(s, "SALT") THEN s{"SALT"} = ""
    IF NOT MAP.EXISTS(s, "PINHASH") THEN s{"PINHASH"} = ""
    IF NOT MAP.EXISTS(s, "TRIES") THEN s{"TRIES"} = 0
    IF NOT MAP.EXISTS(s, "LOCKED") THEN s{"LOCKED"} = 0
    RETURN s
ENDFUNC

' ---- identity ----
'
' A name belongs to whoever claimed it first. The PIN itself is never
' stored, only its salted hash, and a session token stands in for it on
' every later request so the PIN travels exactly once.

CONST PIN_TRIES = 5
CONST PIN_LOCK_MS = 60000
CONST SESSION_MS = 43200000        ' 12 h of idle before a token goes stale

DIM sessions AS MAP = {}

FUNC PINHASH$(salt$, pin$)
    RETURN CODEC.SHA256$(salt$ + ":" + pin$)
ENDFUNC

' A PIN is 4 to 8 digits - long enough to matter, short enough to type on a
' phone between rounds.
FUNC PINOK(pin$)
    IF LEN(pin$) < 4 ORELSE LEN(pin$) > 8 THEN RETURN 0
    DIM i
    FOR i = 0 TO LEN(pin$) - 1
        DIM c$ = MID$(pin$, i, 1)
        IF c$ < "0" ORELSE c$ > "9" THEN RETURN 0
    NEXT i
    RETURN 1
ENDFUNC

FUNC NEWSESSION$(name$)
    DIM tok$ = CODEC.UUID$()
    sessions{tok$} = { "NAME": name$, "LAST": TICK() }
    RETURN tok$
ENDFUNC

' Resolve a session token to its player name, or "" if it is absent or
' stale. Every authenticated endpoint goes through here, so a caller can
' never name someone else.
FUNC WHOIS$(req, b)
    DIM tok$ = ""
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "AUTH") THEN tok$ = b{"AUTH"}
    IF tok$ = "" ANDALSO MAP.EXISTS(req{"PARAMS"}, "auth") THEN tok$ = req{"PARAMS"}{"auth"}
    IF tok$ = "" ORELSE NOT MAP.EXISTS(sessions, tok$) THEN RETURN ""
    DIM se = sessions{tok$}
    DIM now = TICK()
    IF now - se{"LAST"} > SESSION_MS THEN RETURN ""
    se{"LAST"} = now
    RETURN se{"NAME"}
ENDFUNC

FUNC NEEDAUTH()
    RETURN JJ({ "OK": 0, "MSG": "msg_login" })
ENDFUNC

FUNC CARDENTRY(s, kind$)
    DIM cc = s{"CARDS"}
    IF NOT MAP.EXISTS(cc, kind$) THEN
        cc{kind$} = { "LVL": 1, "HAVE": 0 }
    ENDIF
    RETURN cc{kind$}
ENDFUNC

' Per-card level map for the sim state.
FUNC CARDLVLMAP(name$)
    DIM s = STATOF(name$)
    DIM m AS MAP = {}
    DIM ks = MAP.KEYS(s{"CARDS"})
    FOR EACH k$ IN ks
        m{k$} = s{"CARDS"}{k$}{"LVL"}
    NEXT k$
    RETURN m
ENDFUNC

' End-of-match chest, same for winner and loser: 5 common cards, 2 strong
' ones and a wildcard that levels any card.
SUB GIVECHEST(name$)
    DIM s = STATOF(name$)
    DIM cs = ARENA.CARDS()
    DIM commons = []
    DIM strongs = []
    DIM ks = MAP.KEYS(cs)
    FOR EACH k$ IN ks
        IF cs{k$}{"RARITY"} = "S" THEN
            strongs = APPEND(strongs, k$)
        ELSE
            commons = APPEND(commons, k$)
        ENDIF
    NEXT k$
    DIM chest = []
    DIM i
    FOR i = 1 TO 5
        DIM ck$ = commons[INT(NEXTRAND() * LEN(commons)) MOD LEN(commons)]
        DIM ce = CARDENTRY(s, ck$)
        ce{"HAVE"} = ce{"HAVE"} + 1
        chest = APPEND(chest, ck$)
    NEXT i
    FOR i = 1 TO 2
        DIM sk$ = strongs[INT(NEXTRAND() * LEN(strongs)) MOD LEN(strongs)]
        DIM se = CARDENTRY(s, sk$)
        se{"HAVE"} = se{"HAVE"} + 1
        chest = APPEND(chest, sk$)
    NEXT i
    s{"WILD"} = s{"WILD"} + 1
    chest = APPEND(chest, "*")
    s{"LASTCHEST"} = chest
ENDSUB

' First contact with a name hands out a starter chest, so a new player
' can level a card before ever entering a battle.
FUNC ENSURESTARTER(name$)
    DIM s = STATOF(name$)
    IF NOT MAP.EXISTS(s, "STARTED") THEN
        s{"STARTED"} = 1
        GIVECHEST(name$)
        SAVESTATS()
        PRINT "starter chest: "; name$
    ENDIF
    RETURN s
ENDFUNC

' Book the finished match into the lifetime stats, exactly once, and hand
' both players their chest.
SUB RECORDMATCH(rm)
    DIM st = rm{"ST"}
    DIM players = rm{"PLAYERS"}
    IF st{"PHASE"} = "over" ANDALSO NOT MAP.EXISTS(st, "RECORDED") ANDALSO LEN(players) = 2 THEN
        st{"RECORDED"} = 1
        DIM w = st{"WINNER"}
        DIM i
        FOR i = 0 TO 1
            DIM s = STATOF(players[i]{"NAME"})
            s{"CROWNS"} = s{"CROWNS"} + st{"CROWNS"}[i]
            IF w = 2 THEN
                s{"DRAWS"} = s{"DRAWS"} + 1
            ELSEIF w = i THEN
                s{"WINS"} = s{"WINS"} + 1
            ELSE
                s{"LOSSES"} = s{"LOSSES"} + 1
            ENDIF
            GIVECHEST(players[i]{"NAME"})
        NEXT i
        SAVESTATS()
        PRINT "match recorded: winner "; w; " - chests handed out"
    ENDIF
ENDSUB

FUNC JJ(m)
    RETURN { "__http_status": 200, "__http_body": JSON.STRINGIFY$(m), "__http_content_type": "application/json", "__http_headers": { "Access-Control-Allow-Origin": "*" } }
ENDFUNC

FUNC PIDBYTOK(players, tok$)
    DIM i
    FOR i = 0 TO LEN(players) - 1
        IF players[i]{"TOK"} = tok$ THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

SUB SYNCSIM(rm)
    DIM now = TICK()
    IF LEN(rm{"PLAYERS"}) < 2 THEN
        rm{"LAST"} = now
    ELSE
        DIM n_steps = INT((now - rm{"LAST"}) / 100)
        IF n_steps > 100 THEN
            n_steps = 100
            rm{"LAST"} = now - 10000
        ENDIF
        DIM i
        FOR i = 1 TO n_steps
            rm{"ST"} = ARENA.SIMSTEP(rm{"ST"})
        NEXT i
        rm{"LAST"} = rm{"LAST"} + n_steps * 100
        RECORDMATCH(rm)
    ENDIF
ENDSUB

' Validated 6-card deck from the join body, or the classic default.
FUNC PICKDECK(b)
    DIM def = ["DROID", "LASER", "KOLOSS", "WESPEN", "SPLITTER", "PLASMA"]
    IF TYPEOF(b) <> "OBJECT" ORELSE NOT MAP.EXISTS(b, "DECK") THEN RETURN def
    DIM d = b{"DECK"}
    IF TYPEOF(d) <> "ARRAY" ORELSE LEN(d) <> 6 THEN RETURN def
    DIM cs = ARENA.CARDS()
    DIM seen AS MAP = {}
    DIM i
    FOR i = 0 TO 5
        IF NOT MAP.EXISTS(cs, d[i]) ORELSE MAP.EXISTS(seen, d[i]) THEN RETURN def
        seen{d[i]} = 1
    NEXT i
    RETURN d
ENDFUNC

' Fresh copy so the cycling queue never shares storage with the deck.
FUNC DECKQ(d)
    DIM q = []
    DIM i
    FOR i = 0 TO LEN(d) - 1
        q = APPEND(q, d[i])
    NEXT i
    RETURN q
ENDFUNC

FUNC HJOIN(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    ' the seat is taken under the name on the session, never under the one
    ' the caller typed into the request
    DIM name$ = WHOIS$(req, b)
    IF name$ = "" THEN RETURN NEEDAUTH()
    DIM rm = ROOMOF(req, b)
    DIM players = rm{"PLAYERS"}
    DIM st = rm{"ST"}
    DIM deck = PICKDECK(b)
    DIM starter = ENSURESTARTER(name$)
    DIM tok$ = CODEC.UUID$()
    DIM now = TICK()
    DIM i
    ' Your own seat is always yours: a phone that locked or a reloaded tab
    ' gets its place back under the same name, keeping the running match.
    FOR i = 0 TO LEN(players) - 1
        IF players[i]{"NAME"} = name$ THEN
            players[i]{"TOK"} = tok$
            players[i]{"LAST"} = now
            players[i]{"DECK"} = deck
            st{"QUEUES"}[i] = DECKQ(deck)
            st{"CARDLVL"}[i] = CARDLVLMAP(name$)
            PRINT "reconnect: "; name$; " -> pid "; i; " in "; rm{"KEY"}
            RETURN JJ({ "OK": 1, "PID": i, "TOK": tok$, "ROOM": rm{"KEY"} })
        ENDIF
    NEXT i
    IF LEN(players) >= 2 THEN
        ' A stranger may only take over a seat that has been silent for a
        ' while, and never while the match is being played - locking your
        ' screen mid-battle must not hand your base to a bystander.
        DIM idle_ok = 60000
        IF rm{"ST"}{"PHASE"} <> "play" ORELSE rm{"ST"}{"TICKNO"} = 0 THEN idle_ok = 8000
        FOR i = 0 TO LEN(players) - 1
            IF now - players[i]{"LAST"} > idle_ok THEN
                players[i] = { "NAME": name$, "TOK": tok$, "LAST": now, "DECK": deck }
                st{"QUEUES"}[i] = DECKQ(deck)
                st{"CARDLVL"}[i] = CARDLVLMAP(name$)
                PRINT "takeover: "; name$; " claims idle pid "; i; " in "; rm{"KEY"}
                RETURN JJ({ "OK": 1, "PID": i, "TOK": tok$, "ROOM": rm{"KEY"} })
            ENDIF
        NEXT i
        RETURN JJ({ "OK": 0, "MSG": "msg_full" })
    ENDIF
    rm{"PLAYERS"} = APPEND(players, { "NAME": name$, "TOK": tok$, "LAST": TICK(), "DECK": deck })
    DIM slot = LEN(rm{"PLAYERS"}) - 1
    st{"QUEUES"}[slot] = DECKQ(deck)
    st{"CARDLVL"}[slot] = CARDLVLMAP(name$)
    IF slot = 1 THEN rm{"LAST"} = TICK()
    PRINT "join: "; name$; " -> pid "; slot; " in "; rm{"KEY"}
    RETURN JJ({ "OK": 1, "PID": slot, "TOK": tok$, "ROOM": rm{"KEY"} })
ENDFUNC

FUNC HSTATE(req)
    DIM rm = ROOMOF(req, 0)
    SYNCSIM(rm)
    DIM players = rm{"PLAYERS"}
    DIM pid = -1
    IF MAP.EXISTS(req{"PARAMS"}, "tok") THEN pid = PIDBYTOK(players, req{"PARAMS"}{"tok"})
    IF pid >= 0 THEN players[pid]{"LAST"} = TICK()
    DIM names = []
    DIM profiles = []
    DIM i
    FOR i = 0 TO LEN(players) - 1
        DIM pn$ = players[i]{"NAME"}
        names = APPEND(names, pn$)
        DIM s = STATOF(pn$)
        profiles = APPEND(profiles, { "NAME": pn$, "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, "DRAWS": s{"DRAWS"}, "CROWNS": s{"CROWNS"} })
    NEXT i
    RETURN JJ({ "OK": 1, "PID": pid, "WAITING": IIF(LEN(players) < 2, 1, 0), "NAMES": names, "PROFILES": profiles, "ST": rm{"ST"} })
ENDFUNC

FUNC HPLAY(req)
    DIM b = JSON.PARSE$(req{"BODY"})
    DIM rm = ROOMOF(req, b)
    SYNCSIM(rm)
    DIM pid = PIDBYTOK(rm{"PLAYERS"}, b{"TOK"})
    IF pid < 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badtok" })
    DIM res$ = ARENA.PLAYCARD(rm{"ST"}, pid, b{"KIND"}, b{"X"}, b{"Y"})
    RETURN JJ({ "OK": IIF(res$ = "", 1, 0), "MSG": res$ })
ENDFUNC

FUNC HRESET(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM rm = ROOMOF(req, b)
    rm{"ST"} = ARENA.NEWGAME()
    rm{"PLAYERS"} = []
    rm{"LAST"} = TICK()
    PRINT "reset room "; rm{"KEY"}
    RETURN JJ({ "OK": 1, "MSG": "Raum " + rm{"KEY"} + " frei, 0 Spieler" })
ENDFUNC

' Drops a room entirely; it reappears when someone joins it again.
FUNC HDROP(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM key$ = ROOMKEY$(IIF(MAP.EXISTS(req{"PARAMS"}, "room"), req{"PARAMS"}{"room"}, "main"))
    IF MAP.EXISTS(rooms, key$) THEN
        DIM keep AS MAP = {}
        FOR EACH k$ IN MAP.KEYS(rooms)
            IF k$ <> key$ THEN keep{k$} = rooms{k$}
        NEXT k$
        rooms = keep
        PRINT "dropped room "; key$
    ENDIF
    RETURN JJ({ "OK": 1, "MSG": key$ })
ENDFUNC

' Lifetime table, strongest record first.
FUNC HLEADER(req)
    IF ISADMIN(req, 0) = 0 THEN RETURN DENY()
    DIM out = []
    FOR EACH n$ IN MAP.KEYS(stats)
        DIM s = STATOF(n$)
        DIM ncards = 0
        FOR EACH ck$ IN MAP.KEYS(s{"CARDS"})
            ncards = ncards + s{"CARDS"}{ck$}{"LVL"} - 1
        NEXT ck$
        out = APPEND(out, [{ "NAME": n$, "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, "DRAWS": s{"DRAWS"}, "CROWNS": s{"CROWNS"}, "WILD": s{"WILD"}, "UPGRADES": ncards }])
    NEXT n$
    RETURN JJ({ "OK": 1, "PLAYERS": out })
ENDFUNC

' Wipes one player's record and collection - a fresh start on request.
FUNC HWIPE(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM n$ = ""
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "NAME") THEN n$ = b{"NAME"}
    IF n$ = "" ORELSE NOT MAP.EXISTS(stats, n$) THEN RETURN JJ({ "OK": 0, "MSG": "unbekannter Spieler" })
    DIM keep AS MAP = {}
    FOR EACH k$ IN MAP.KEYS(stats)
        IF k$ <> n$ THEN keep{k$} = stats{k$}
    NEXT k$
    stats = keep
    SAVESTATS()
    PRINT "wiped player "; n$
    RETURN JJ({ "OK": 1, "MSG": n$ })
ENDFUNC

' New match, same two players and their decks - the in-game rematch button.
FUNC HREMATCH(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    DIM rm = ROOMOF(req, b)
    DIM players = rm{"PLAYERS"}
    rm{"ST"} = ARENA.NEWGAME()
    DIM st = rm{"ST"}
    DIM i
    FOR i = 0 TO LEN(players) - 1
        st{"QUEUES"}[i] = DECKQ(players[i]{"DECK"})
        st{"CARDLVL"}[i] = CARDLVLMAP(players[i]{"NAME"})
    NEXT i
    rm{"LAST"} = TICK()
    PRINT "rematch in "; rm{"KEY"}
    RETURN JJ({ "OK": 1 })
ENDFUNC

FUNC HROOT(req)
    DIM lines$ = "BASIC Royale match server. Rooms: "
    DIM ks = MAP.KEYS(rooms)
    FOR EACH k$ IN ks
        lines$ = lines$ + k$ + "(" + STR$(LEN(rooms{k$}{"PLAYERS"})) + ") "
    NEXT k$
    RETURN lines$ + "| POST /join, GET /state?tok=&room=, POST /play, POST /rematch, GET /reset?room=, GET /cards, GET /profile?name=, POST /upgrade."
ENDFUNC

' Ends the running match immediately (player 1 takes it).
FUNC HFORCEEND(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM rm = ROOMOF(req, b)
    rm{"ST"}{"TOWERS"}[2]{"HP"} = 0
    RETURN JJ({ "OK": 1 })
ENDFUNC

FUNC HCARDS(req)
    RETURN JJ({ "OK": 1, "CARDS": ARENA.CARDS() })
ENDFUNC

' UI translations - clients look their strings up by key.
DIM lang_json$ = "{}"
TRY
    lang_json$ = TXTREADER$("lang.json")
CATCH
ENDTRY

FUNC HLANG(req)
    RETURN { "__http_status": 200, "__http_body": lang_json$, "__http_content_type": "application/json", "__http_headers": { "Access-Control-Allow-Origin": "*" } }
ENDFUNC

' Room directory for the lobby: who is in, and is there a seat left.
' Empty rooms that nobody has touched for half an hour are swept away so
' the list keeps showing what is actually being played.
FUNC HROOMS(req)
    DIM now = TICK()
    DIM keep AS MAP = {}
    FOR EACH sk$ IN MAP.KEYS(rooms)
        DIM sr = rooms{sk$}
        IF LEN(sr{"PLAYERS"}) > 0 ORELSE now - sr{"LAST"} < 1800000 ORELSE sk$ = "main" THEN keep{sk$} = sr
    NEXT sk$
    rooms = keep

    DIM admin = ISADMIN(req, 0)
    DIM out = []
    FOR EACH k$ IN MAP.KEYS(rooms)
        DIM rr = rooms{k$}
        DIM rp = rr{"PLAYERS"}
        DIM names = []
        DIM i
        FOR i = 0 TO LEN(rp) - 1
            names = APPEND(names, rp[i]{"NAME"})
        NEXT i
        DIM row AS MAP = { "KEY": k$, "N": LEN(rp), "NAMES": names }
        IF admin = 1 THEN
            row{"PHASE"} = rr{"ST"}{"PHASE"}
            row{"TICKNO"} = rr{"ST"}{"TICKNO"}
            row{"CROWNS"} = rr{"ST"}{"CROWNS"}
            row{"IDLE"} = INT((now - rr{"LAST"}) / 1000)
        ENDIF
        out = APPEND(out, [row])
    NEXT k$
    RETURN JJ({ "OK": 1, "ROOMS": out })
ENDFUNC

' Claim a name or prove you already own it. The first login under a free
' name sets its PIN; every later one has to match it.
FUNC HLOGIN(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF TYPEOF(b) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_badreq" })
    DIM name$ = TRIM$("" + b{"NAME"})
    DIM pin$ = TRIM$("" + b{"PIN"})
    IF name$ = "" ORELSE LEN(name$) > 16 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badname" })
    IF PINOK(pin$) = 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badpin" })

    DIM s = STATOF(name$)
    DIM now = TICK()
    IF s{"LOCKED"} > now THEN RETURN JJ({ "OK": 0, "MSG": "msg_locked" })

    IF s{"PINHASH"} = "" THEN
        s{"SALT"} = CODEC.UUID$()
        s{"PINHASH"} = PINHASH$(s{"SALT"}, pin$)
        s{"TRIES"} = 0
        DIM starter = ENSURESTARTER(name$)
        SAVESTATS()
        PRINT "claimed: "; name$
        RETURN JJ({ "OK": 1, "AUTH": NEWSESSION$(name$), "NAME": name$, "CLAIMED": 1 })
    ENDIF

    IF PINHASH$(s{"SALT"}, pin$) <> s{"PINHASH"} THEN
        s{"TRIES"} = s{"TRIES"} + 1
        ' a four digit PIN only holds up if guessing is slow
        IF s{"TRIES"} >= PIN_TRIES THEN
            s{"LOCKED"} = now + PIN_LOCK_MS
            s{"TRIES"} = 0
            PRINT "locked: "; name$
        ENDIF
        SAVESTATS()
        RETURN JJ({ "OK": 0, "MSG": "msg_wrongpin" })
    ENDIF

    s{"TRIES"} = 0
    DIM st2 = ENSURESTARTER(name$)
    RETURN JJ({ "OK": 1, "AUTH": NEWSESSION$(name$), "NAME": name$, "CLAIMED": 0 })
ENDFUNC

' What a client is allowed to see of a profile. The credential fields never
' leave the server, not even to the account they belong to.
FUNC PUBPROFILE(s)
    RETURN { "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, "DRAWS": s{"DRAWS"}, _
             "CROWNS": s{"CROWNS"}, "CARDS": s{"CARDS"}, "WILD": s{"WILD"}, _
             "LASTCHEST": s{"LASTCHEST"} }
ENDFUNC

FUNC HPROFILE(req)
    DIM name$ = WHOIS$(req, 0)
    IF name$ = "" THEN RETURN NEEDAUTH()
    RETURN JJ({ "OK": 1, "PROFILE": PUBPROFILE(ENSURESTARTER(name$)) })
ENDFUNC

' Level a card: costs 2^level copies (2, 4, 8, 16); wildcards fill any
' shortage. Applies live to a seated player's next deploys.
FUNC HUPGRADE(req)
    DIM b = JSON.PARSE$(req{"BODY"})
    DIM name$ = WHOIS$(req, b)
    IF name$ = "" THEN RETURN NEEDAUTH()
    DIM kind$ = b{"KIND"}
    IF NOT MAP.EXISTS(ARENA.CARDS(), kind$) THEN RETURN JJ({ "OK": 0, "MSG": "msg_unknown" })
    DIM s = STATOF(name$)
    DIM ce = CARDENTRY(s, kind$)
    DIM lvl = ce{"LVL"}
    IF lvl >= 5 THEN RETURN JJ({ "OK": 0, "MSG": "msg_maxlvl" })
    DIM cost = INT(2 ^ lvl)
    DIM have = ce{"HAVE"}
    IF have + s{"WILD"} < cost THEN RETURN JJ({ "OK": 0, "MSG": "msg_nocards" })
    DIM used = have
    IF used > cost THEN used = cost
    ce{"HAVE"} = have - used
    s{"WILD"} = s{"WILD"} - (cost - used)
    ce{"LVL"} = lvl + 1
    ' apply live wherever this player is currently seated
    DIM ks = MAP.KEYS(rooms)
    FOR EACH rk$ IN ks
        DIM rp = rooms{rk$}{"PLAYERS"}
        DIM i
        FOR i = 0 TO LEN(rp) - 1
            IF rp[i]{"NAME"} = name$ THEN rooms{rk$}{"ST"}{"CARDLVL"}[i] = CARDLVLMAP(name$)
        NEXT i
    NEXT rk$
    SAVESTATS()
    PRINT "upgrade: "; name$; " "; kind$; " -> Lv"; lvl + 1
    RETURN JJ({ "OK": 1, "LVL": lvl + 1 })
ENDFUNC

