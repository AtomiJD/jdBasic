' BASIC Royale match server - one match, two players, server-authoritative.
' The sim catches up lazily on every request: elapsed wall time is replayed
' as 0.1 s SIMSTEPs, so no background thread is needed and the match simply
' pauses while nobody polls. Clients POST JSON with Content-Type text/plain
' (a CORS simple request - no OPTIONS preflight, which the server has no
' route for) and every response carries Access-Control-Allow-Origin: *.
IMPORT ARENA

' cards.json is the single source of truth for card stats and colors -
' the sim uses it via ARENA.SETCARDS, clients fetch it as GET /cards.
DIM cards_json$ = ""
TRY
    cards_json$ = TXTREADER$("cards.json")
    ARENA.SETCARDS(JSON.PARSE$(cards_json$))
    PRINT "cards.json loaded"
CATCH
    PRINT "cards.json missing - built-in card set"
ENDTRY

' A recording is only replayable against the rules it was made under. Card
' numbers move (that is the point of a balance history), so every recording
' carries a fingerprint of the card table it was played on; a replay that
' finds a different one says so instead of reporting a false drift.
DIM cards_fp$ = "?"
TRY
    cards_fp$ = MID$(CODEC.SHA256$(cards_json$), 0, 12)
CATCH
ENDTRY
PRINT "card table "; cards_fp$

' Own MINSTD generator instead of RND: the CRT's rand() keeps per-thread
' state on Windows, so seeding on the main thread leaves the HTTP handler
' threads - where chests are dealt - on the identical default sequence.
' This one lives in VM state and is shared by every handler.
' Seed from the wallclock where available, always folding in a fresh UUID
' so the sequence differs per run even on runtimes without NOW_EPOCH.
FUNC SEEDVAL()
    DIM s = 0
    TRY
        s = NOW_EPOCH()
    CATCH
    ENDTRY
    DIM u$ = LCASE$(CODEC.UUID$())
    DIM i
    FOR i = 0 TO LEN(u$) - 1
        DIM p = INSTR("0123456789abcdef", MID$(u$, i, 1))
        IF p >= 0 THEN s = (s * 31 + p) MOD 2147483647
    NEXT i
    IF s < 1 THEN s = 1
    RETURN s
ENDFUNC

DIM rng_state = SEEDVAL()

FUNC NEXTRAND()
    rng_state = (rng_state * 16807) MOD 2147483647
    RETURN rng_state / 2147483647.0
ENDFUNC

' One match per room, so any number of pairs can play at once. A room is
' created on first contact and holds its own sim, seats and clock.
DIM rooms AS MAP = {}

FUNC ROOMKEY$(raw$)
    DIM out$ = ""
    DIM i
    FOR i = 0 TO LEN(raw$) - 1
        DIM ch$ = LCASE$(MID$(raw$, i, 1))
        IF INSTR("abcdefghijklmnopqrstuvwxyz0123456789-_", ch$) >= 0 THEN out$ = out$ + ch$
        IF LEN(out$) >= 24 THEN EXITFOR
    NEXT i
    IF out$ = "" THEN out$ = "main"
    RETURN out$
ENDFUNC

FUNC ROOM(name$)
    DIM key$ = ROOMKEY$(name$)
    IF NOT MAP.EXISTS(rooms, key$) THEN
        rooms{key$} = { "ST": ARENA.NEWGAME(), "PLAYERS": [], "LAST": TICK(), "KEY": key$, _
                        "LOG": [], "MARKS": [], "SEED": rng_state }
        PRINT "room opened: "; key$
    ENDIF
    RETURN rooms{key$}
ENDFUNC

' Every card that reached the arena, with the tick it landed on. The sim is
' deterministic, so a match is fully described by its decks, its levels, the
' seed the machine opponent drew from and this list - a few kilobytes instead
' of a film, and it replays through the same SIMSTEP the match ran on.
SUB LOGPLAY(rm, pid, kind$, x, y, sel)
    IF NOT MAP.EXISTS(rm, "LOG") THEN rm{"LOG"} = []
    DIM row AS MAP = { "T": rm{"ST"}{"TICKNO"}, "P": pid, "K": kind$, _
                       "X": INT(x * 100) / 100.0, "Y": INT(y * 100) / 100.0 }
    IF TYPEOF(sel) = "OBJECT" THEN
        row{"CX"} = INT(sel{"CX"} * 100) / 100.0
        row{"CY"} = INT(sel{"CY"} * 100) / 100.0
        row{"R"} = INT(sel{"R"} * 100) / 100.0
    ENDIF
    rm{"LOG"} = APPEND(rm{"LOG"}, row)
ENDSUB

' The room a request names, WITHOUT opening it. Only joining opens a room -
' otherwise an unauthenticated GET can fill the server with arenas nobody
' plays in, which measured at about six kilobytes a piece.
FUNC ROOMFIND(req, b)
    DIM key$ = "main"
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "ROOM") THEN
        key$ = ROOMKEY$("" + b{"ROOM"})
    ELSEIF MAP.EXISTS(req{"PARAMS"}, "room") THEN
        key$ = ROOMKEY$("" + req{"PARAMS"}{"room"})
    ENDIF
    IF NOT MAP.EXISTS(rooms, key$) THEN RETURN 0
    RETURN rooms{key$}
ENDFUNC

' Room named in a query parameter (GET) or a parsed body (POST).
FUNC ROOMOF(req, b)
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "ROOM") THEN RETURN ROOM(b{"ROOM"})
    IF MAP.EXISTS(req{"PARAMS"}, "room") THEN RETURN ROOM(req{"PARAMS"}{"room"})
    RETURN ROOM("main")
ENDFUNC

' Admin key from admin.txt next to the server. Without the file every
' destructive endpoint stays shut - failing closed beats a default key.
DIM admin_key$ = ""
TRY
    admin_key$ = TRIM$(TXTREADER$("admin.txt"))
CATCH
ENDTRY
IF admin_key$ = "" THEN
    PRINT "admin.txt missing - admin endpoints disabled"
ELSE
    PRINT "admin endpoints armed"
ENDIF

FUNC ISADMIN(req, b)
    IF admin_key$ = "" THEN RETURN 0
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "KEY") THEN
        IF b{"KEY"} = admin_key$ THEN RETURN 1
    ENDIF
    IF MAP.EXISTS(req{"PARAMS"}, "key") THEN
        IF req{"PARAMS"}{"key"} = admin_key$ THEN RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

FUNC DENY()
    RETURN { "__http_status": 403, "__http_body": "{""OK"":0,""MSG"":""admin key required""}", "__http_content_type": "application/json", "__http_headers": { "Access-Control-Allow-Origin": "*" } }
ENDFUNC

' Lifetime stats per player name, persisted across server restarts:
' record, crowns, collected card copies, wildcards and the last chest.
DIM stats AS MAP = {}
TRY
    stats = JSON.PARSE$(TXTREADER$("stats.json"))
CATCH
ENDTRY

' The whole file is rewritten on every save, so the cost of a save grows
' with the number of profiles that ever existed - a burst of unknown names
' would make every login slower than the last (measured: 2 ms at zero
' profiles, 10 ms at four hundred). Anything that must not be lost still
' saves at once; the cheap bookkeeping marks the file and rides out with the
' next flush window, so a name flood costs one write every few seconds
' instead of one per name.
CONST STATS_GAP_MS = 4000
DIM stats_dirty = 0
DIM stats_written = 0

SUB SAVESTATS()
    TRY
        TXTWRITER "stats.json", JSON.STRINGIFY$(stats)
    CATCH
    ENDTRY
    stats_dirty = 0
    stats_written = TICK()
ENDSUB

SUB TOUCHSTATS()
    stats_dirty = 1
    FLUSHSTATS()
ENDSUB

SUB FLUSHSTATS()
    IF stats_dirty = 1 ANDALSO TICK() - stats_written >= STATS_GAP_MS THEN SAVESTATS()
ENDSUB

FUNC STATOF(name$)
    IF NOT MAP.EXISTS(stats, name$) THEN
        stats{name$} = { "WINS": 0, "LOSSES": 0, "DRAWS": 0, "CROWNS": 0 }
    ENDIF
    DIM s = stats{name$}
    IF NOT MAP.EXISTS(s, "CARDS") THEN s{"CARDS"} = {}
    IF NOT MAP.EXISTS(s, "WILD") THEN s{"WILD"} = 0
    IF NOT MAP.EXISTS(s, "LASTCHEST") THEN s{"LASTCHEST"} = []
    IF NOT MAP.EXISTS(s, "SALT") THEN s{"SALT"} = ""
    IF NOT MAP.EXISTS(s, "PINHASH") THEN s{"PINHASH"} = ""
    IF NOT MAP.EXISTS(s, "TRIES") THEN s{"TRIES"} = 0
    IF NOT MAP.EXISTS(s, "LOCKED") THEN s{"LOCKED"} = 0
    IF NOT MAP.EXISTS(s, "DECKS") THEN s{"DECKS"} = []
    IF NOT MAP.EXISTS(s, "ACTIVE") THEN s{"ACTIVE"} = 0
    RETURN s
ENDFUNC

' ---- identity ----
'
' A name belongs to whoever claimed it first. The PIN itself is never
' stored, only its salted hash, and a session token stands in for it on
' every later request so the PIN travels exactly once.

CONST PIN_TRIES = 5
CONST PIN_LOCK_MS = 60000

DIM sessions AS MAP = {}
TRY
    sessions = JSON.PARSE$(TXTREADER$("sessions.json"))
CATCH
ENDTRY
IF TYPEOF(sessions) <> "OBJECT" THEN sessions = {}

SUB SAVESESSIONS()
    TRY
        TXTWRITER "sessions.json", JSON.STRINGIFY$(sessions)
    CATCH
    ENDTRY
ENDSUB

FUNC PINHASH$(salt$, pin$)
    RETURN CODEC.SHA256$(salt$ + ":" + pin$)
ENDFUNC

' A PIN is 4 to 8 digits - long enough to matter, short enough to type on a
' phone between rounds.
FUNC PINOK(pin$)
    IF LEN(pin$) < 4 ORELSE LEN(pin$) > 8 THEN RETURN 0
    DIM i
    FOR i = 0 TO LEN(pin$) - 1
        DIM c$ = MID$(pin$, i, 1)
        IF c$ < "0" ORELSE c$ > "9" THEN RETURN 0
    NEXT i
    RETURN 1
ENDFUNC

FUNC NEWSESSION$(name$)
    DIM tok$ = CODEC.UUID$()
    sessions{tok$} = { "NAME": name$, "DAY": STAMP$() }
    SAVESESSIONS()
    RETURN tok$
ENDFUNC

' Resolve a session token to its player name, or "" if it is absent or
' stale. Every authenticated endpoint goes through here, so a caller can
' never name someone else.
FUNC WHOIS$(req, b)
    DIM tok$ = ""
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "AUTH") THEN tok$ = b{"AUTH"}
    IF tok$ = "" ANDALSO MAP.EXISTS(req{"PARAMS"}, "auth") THEN tok$ = req{"PARAMS"}{"auth"}
    IF tok$ = "" ORELSE NOT MAP.EXISTS(sessions, tok$) THEN RETURN ""
    RETURN sessions{tok$}{"NAME"}
ENDFUNC

FUNC NEEDAUTH()
    RETURN JJ({ "OK": 0, "MSG": "msg_login" })
ENDFUNC

FUNC CARDENTRY(s, kind$)
    DIM cc = s{"CARDS"}
    IF NOT MAP.EXISTS(cc, kind$) THEN
        cc{kind$} = { "LVL": 1, "HAVE": 0 }
    ENDIF
    RETURN cc{kind$}
ENDFUNC

' Per-card level map for the sim state.
FUNC CARDLVLMAP(name$)
    DIM s = STATOF(name$)
    DIM m AS MAP = {}
    DIM ks = MAP.KEYS(s{"CARDS"})
    FOR EACH k$ IN ks
        m{k$} = s{"CARDS"}{k$}{"LVL"}
    NEXT k$
    RETURN m
ENDFUNC

' End-of-match chest, same for winner and loser: 5 common cards, 2 strong
' ones and a wildcard that levels any card.
SUB GIVECHEST(name$)
    DIM s = STATOF(name$)
    DIM cs = ARENA.CARDS()
    DIM commons = []
    DIM strongs = []
    DIM ks = MAP.KEYS(cs)
    FOR EACH k$ IN ks
        IF cs{k$}{"RARITY"} = "S" THEN
            strongs = APPEND(strongs, k$)
        ELSE
            commons = APPEND(commons, k$)
        ENDIF
    NEXT k$
    DIM chest = []
    DIM i
    FOR i = 1 TO 5
        DIM ck$ = commons[INT(NEXTRAND() * LEN(commons)) MOD LEN(commons)]
        DIM ce = CARDENTRY(s, ck$)
        ce{"HAVE"} = ce{"HAVE"} + 1
        chest = APPEND(chest, ck$)
    NEXT i
    FOR i = 1 TO 2
        DIM sk$ = strongs[INT(NEXTRAND() * LEN(strongs)) MOD LEN(strongs)]
        DIM se = CARDENTRY(s, sk$)
        se{"HAVE"} = se{"HAVE"} + 1
        chest = APPEND(chest, sk$)
    NEXT i
    s{"WILD"} = s{"WILD"} + 1
    chest = APPEND(chest, "*")
    s{"LASTCHEST"} = chest
ENDSUB

' First contact with a name hands out a starter chest, so a new player
' can level a card before ever entering a battle.
FUNC ENSURESTARTER(name$)
    DIM s = STATOF(name$)
    IF NOT MAP.EXISTS(s, "STARTED") THEN
        s{"STARTED"} = 1
        GIVECHEST(name$)
        TOUCHSTATS()
        PRINT "starter chest: "; name$
    ENDIF
    RETURN s
ENDFUNC

' Book the finished match into the lifetime stats, exactly once, and hand
' both players their chest.
SUB RECORDMATCH(rm)
    DIM st = rm{"ST"}
    DIM players = rm{"PLAYERS"}
    IF st{"PHASE"} = "over" ANDALSO NOT MAP.EXISTS(st, "RECORDED") ANDALSO LEN(players) = 2 THEN
        st{"RECORDED"} = 1
        ' practice against the machine stays out of the record and the
        ' chests, so nobody can farm cards while the other one sleeps
        IF ISBOTROOM(rm) = 1 THEN
            PRINT "bot match finished - not recorded"
            RETURN
        ENDIF
        DIM w = st{"WINNER"}
        DIM i
        FOR i = 0 TO 1
            DIM s = STATOF(players[i]{"NAME"})
            s{"CROWNS"} = s{"CROWNS"} + st{"CROWNS"}[i]
            IF w = 2 THEN
                s{"DRAWS"} = s{"DRAWS"} + 1
            ELSEIF w = i THEN
                s{"WINS"} = s{"WINS"} + 1
            ELSE
                s{"LOSSES"} = s{"LOSSES"} + 1
            ENDIF
            GIVECHEST(players[i]{"NAME"})
        NEXT i
        SAVESTATS()
        ADDMATCH(rm, w)
        PRINT "match recorded: winner "; w; " - chests handed out"
    ENDIF
ENDSUB

' ---- match log ----
'
' The per-player totals cannot answer "how do the two of us stand against
' each other", so every finished match is written down as its own row.

CONST MATCH_KEEP = 300

DIM matches = []
TRY
    matches = JSON.PARSE$(TXTREADER$("matches.json"))
CATCH
ENDTRY
IF TYPEOF(matches) <> "ARRAY" THEN matches = []

' The server binary predates NOW_EPOCH, but DATE$ and TIME$ are there and
' sort correctly as text. Both need their parens: read bare inside a FUNC,
' a zero-argument native resolves as an undeclared local and yields NONE.
FUNC STAMP$()
    DIM t$ = ""
    TRY
        t$ = DATE$() + " " + TIME$()
    CATCH
    ENDTRY
    RETURN t$
ENDFUNC

SUB SAVEMATCHES()
    TRY
        TXTWRITER "matches.json", JSON.STRINGIFY$(matches)
    CATCH
    ENDTRY
ENDSUB

' One line per match in replays.jsonl: what both sides brought, the seed the
' machine drew from, and every card that landed. Appended, never rewritten,
' so the cost of writing does not grow with the history - the mistake the
' profile file made. A reader replays it through ARENA and gets the same
' match back; replay.jdb does exactly that and checks the outcome matches.
SUB LOGREPLAY(rm, w, row)
    DIM st = rm{"ST"}
    DIM players = rm{"PLAYERS"}
    DIM rec AS MAP = {}
    rec{"AT"} = row{"AT"}
    rec{"ROOM"} = rm{"KEY"}
    rec{"A"} = players[0]{"NAME"}
    rec{"B"} = players[1]{"NAME"}
    rec{"DECKA"} = players[0]{"DECK"}
    rec{"DECKB"} = players[1]{"DECK"}
    rec{"LVLA"} = st{"CARDLVL"}[0]
    rec{"LVLB"} = st{"CARDLVL"}[1]
    rec{"SEED"} = rm{"SEED"}
    rec{"BOT"} = ISBOTROOM(rm)
    rec{"WINNER"} = w
    rec{"CA"} = st{"CROWNS"}[0]
    rec{"CB"} = st{"CROWNS"}[1]
    rec{"TICKS"} = st{"TICKNO"}
    rec{"PLAYS"} = rm{"LOG"}
    rec{"CARDS_FP"} = cards_fp$
    IF MAP.EXISTS(rm, "MARKS") THEN rec{"MARKS"} = rm{"MARKS"}
    IF MAP.EXISTS(rm, "FORCED") ANDALSO rm{"FORCED"} = 1 THEN rec{"FORCED"} = 1
    TRY
        DIM entry$ = JSON.STRINGIFY$(rec)
        DIM old$ = ""
        TRY
            old$ = TXTREADER$("replays.jsonl")
        CATCH
        ENDTRY
        DIM ok = TXTWRITER("replays.jsonl", old$ + entry$ + CHR$(10))
        COUNTMATCH(rec)
        PRINT "replay written: "; LEN(rm{"LOG"}); " plays, "; LEN(entry$); " bytes"
    CATCH
        PRINT "replay not written"
    ENDTRY
ENDSUB

SUB ADDMATCH(rm, w)
    DIM st = rm{"ST"}
    DIM players = rm{"PLAYERS"}
    DIM row AS MAP = {}
    row{"AT"} = STAMP$()
    row{"ROOM"} = rm{"KEY"}
    row{"A"} = players[0]{"NAME"}
    row{"B"} = players[1]{"NAME"}
    row{"CA"} = st{"CROWNS"}[0]
    row{"CB"} = st{"CROWNS"}[1]
    row{"WINNER"} = w
    row{"SECS"} = INT(st{"TICKNO"} / 10)
    LOGREPLAY(rm, w, row)
    matches = APPEND(matches, row)
    IF LEN(matches) > MATCH_KEEP THEN
        DIM keep = []
        DIM k
        FOR k = LEN(matches) - MATCH_KEEP TO LEN(matches) - 1
            keep = APPEND(keep, matches[k])
        NEXT k
        matches = keep
    ENDIF
    SAVEMATCHES()
ENDSUB

FUNC JJ(m)
    RETURN { "__http_status": 200, "__http_body": JSON.STRINGIFY$(m), "__http_content_type": "application/json", "__http_headers": { "Access-Control-Allow-Origin": "*" } }
ENDFUNC

FUNC PIDBYTOK(players, tok$)
    DIM i
    FOR i = 0 TO LEN(players) - 1
        IF players[i]{"TOK"} = tok$ THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

' ---- the machine opponent ----
'
' Seat 1 can be held by the server itself, so a match is possible when
' nobody else is around. It decides on the sim clock, not on how often a
' client polls, and it plays out of the same hand and elixir as a person.

CONST BOT_NAME = "Computer"
CONST BOT_EVERY = 12               ' sim ticks between two decisions

FUNC BOTDECK()
    RETURN ["DROID", "LASER", "NANOS", "WESPEN", "SALVE", "KOLOSS"]
ENDFUNC

' Nearest enemy unit on the bot's half, or -1.
FUNC BOTTHREAT(st)
    DIM best = -1
    DIM bestd = 99.0
    DIM i
    DIM us = st{"UNITS"}
    FOR i = 0 TO LEN(us) - 1
        IF us[i]{"OWNER"} = 1 THEN CONTINUEFOR
        IF us[i]{"Y"} > 15.0 THEN CONTINUEFOR
        IF us[i]{"Y"} < bestd THEN
            bestd = us[i]{"Y"}
            best = i
        ENDIF
    NEXT i
    RETURN best
ENDFUNC

SUB BOTTURN(rm)
    DIM st = rm{"ST"}
    IF st{"PHASE"} <> "play" THEN RETURN
    IF st{"TICKNO"} MOD BOT_EVERY <> 0 THEN RETURN
    DIM cs = ARENA.CARDS()
    DIM q = st{"QUEUES"}[1]
    DIM elix = st{"ELIXIR"}[1]

    ' pick the dearest card in hand that is affordable
    DIM pick$ = ""
    DIM pickcost = -1
    DIM i
    FOR i = 0 TO 3
        DIM k$ = q[i]
        DIM c = cs{k$}
        ' a recall needs ships to pick up and a loop drawn around them, which
        ' is a decision the machine does not make
        IF MAP.EXISTS(c, "WARP") THEN CONTINUEFOR
        IF c{"COST"} <= elix ANDALSO c{"COST"} > pickcost THEN
            pick$ = k$
            pickcost = c{"COST"}
        ENDIF
    NEXT i
    IF pick$ = "" THEN RETURN

    ' hold something back early so it is not broke when a push lands
    DIM threat = BOTTHREAT(st)
    IF threat < 0 ANDALSO elix < 7 THEN RETURN

    DIM px = 4.5
    DIM py = 11.0
    IF threat >= 0 THEN
        ' meet the attacker a little ahead of it, on its lane
        DIM u = st{"UNITS"}[threat]
        px = u{"X"}
        py = u{"Y"} - 2.0
        IF py > 13.0 THEN py = 13.0
        IF py < 2.0 THEN py = 2.0
    ELSE
        ' otherwise start a push behind whichever bridge is safer
        px = 3.5
        IF NEXTRAND() > 0.5 THEN px = 14.5
        py = 11.0
    ENDIF
    IF MAP.EXISTS(cs{pick$}, "SPELL") ANDALSO threat >= 0 THEN
        px = st{"UNITS"}[threat]{"X"}
        py = st{"UNITS"}[threat]{"Y"}
    ELSEIF ARENA.TOWERBLOCK(st, px, py) = 1 THEN
        ' a station holds its own tile - step out in front of it
        py = py + 2.0
        IF py > 13.0 THEN py = 13.0
    ENDIF
    DIM res$ = ARENA.PLAYCARD(st, 1, pick$, px, py)
    IF res$ = "" THEN LOGPLAY(rm, 1, pick$, px, py, 0)
ENDSUB

FUNC ISBOTROOM(rm)
    DIM ps = rm{"PLAYERS"}
    DIM i
    FOR i = 0 TO LEN(ps) - 1
        IF MAP.EXISTS(ps[i], "BOT") THEN RETURN 1
    NEXT i
    RETURN 0
ENDFUNC

' A checkpoint every thirty seconds: the six stations and how many ships were
' on the board. Detecting that a replay came out differently is easy; without
' these there is no way to say WHERE it started to differ, and a divergence
' you cannot localise is a divergence you cannot fix.
CONST MARK_EVERY = 300

SUB MARKSIM(rm)
    DIM st = rm{"ST"}
    IF st{"TICKNO"} MOD MARK_EVERY <> 0 THEN RETURN
    IF NOT MAP.EXISTS(rm, "MARKS") THEN rm{"MARKS"} = []
    DIM hp = []
    FOR EACH tw IN st{"TOWERS"}
        hp = APPEND(hp, INT(tw{"HP"}))
    NEXT tw
    rm{"MARKS"} = APPEND(rm{"MARKS"}, [{ "T": st{"TICKNO"}, "HP": hp, "N": LEN(st{"UNITS"}) }])
ENDSUB

SUB SYNCSIM(rm)
    DIM now = TICK()
    IF LEN(rm{"PLAYERS"}) < 2 THEN
        rm{"LAST"} = now
    ELSE
        DIM n_steps = INT((now - rm{"LAST"}) / 100)
        IF n_steps > 100 THEN
            n_steps = 100
            rm{"LAST"} = now - 10000
        ENDIF
        DIM i
        DIM has_bot = ISBOTROOM(rm)
        FOR i = 1 TO n_steps
            rm{"ST"} = ARENA.SIMSTEP(rm{"ST"})
            IF has_bot = 1 THEN BOTTURN(rm)
            MARKSIM(rm)
        NEXT i
        rm{"LAST"} = rm{"LAST"} + n_steps * 100
        RECORDMATCH(rm)
    ENDIF
ENDSUB

FUNC DEFAULTDECK()
    RETURN ["DROID", "LASER", "KOLOSS", "WESPEN", "SPLITTER", "PLASMA"]
ENDFUNC

' Six distinct cards that all exist, or nothing.
FUNC DECKOK(d)
    IF TYPEOF(d) <> "ARRAY" ORELSE LEN(d) <> 6 THEN RETURN 0
    DIM cs = ARENA.CARDS()
    DIM seen AS MAP = {}
    DIM i
    FOR i = 0 TO 5
        IF NOT MAP.EXISTS(cs, d[i]) ORELSE MAP.EXISTS(seen, d[i]) THEN RETURN 0
        seen{d[i]} = 1
    NEXT i
    RETURN 1
ENDFUNC

' Validated 6-card deck from the join body, or the classic default.
FUNC PICKDECK(b)
    IF TYPEOF(b) <> "OBJECT" ORELSE NOT MAP.EXISTS(b, "DECK") THEN RETURN DEFAULTDECK()
    DIM d = b{"DECK"}
    IF DECKOK(d) = 0 THEN RETURN DEFAULTDECK()
    RETURN d
ENDFUNC

' Fresh copy so the cycling queue never shares storage with the deck.
FUNC DECKQ(d)
    DIM q = []
    DIM i
    FOR i = 0 TO LEN(d) - 1
        q = APPEND(q, d[i])
    NEXT i
    RETURN q
ENDFUNC

FUNC HJOIN(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    ' the seat is taken under the name on the session, never under the one
    ' the caller typed into the request
    DIM name$ = WHOIS$(req, b)
    IF name$ = "" THEN RETURN NEEDAUTH()
    DIM rm = ROOMOF(req, b)
    DIM players = rm{"PLAYERS"}
    DIM st = rm{"ST"}
    DIM deck = PICKDECK(b)
    DIM starter = ENSURESTARTER(name$)
    DIM tok$ = CODEC.UUID$()
    DIM now = TICK()
    DIM i
    ' Your own seat is always yours: a phone that locked or a reloaded tab
    ' gets its place back under the same name, keeping the running match.
    FOR i = 0 TO LEN(players) - 1
        IF players[i]{"NAME"} = name$ THEN
            players[i]{"TOK"} = tok$
            players[i]{"LAST"} = now
            players[i]{"DECK"} = deck
            st{"QUEUES"}[i] = DECKQ(deck)
            st{"CARDLVL"}[i] = CARDLVLMAP(name$)
            PRINT "reconnect: "; name$; " -> pid "; i; " in "; rm{"KEY"}
            RETURN JJ({ "OK": 1, "PID": i, "TOK": tok$, "ROOM": rm{"KEY"} })
        ENDIF
    NEXT i
    IF LEN(players) >= 2 THEN
        IF st{"PHASE"} <> "play" THEN
            ' A finished match belongs to the two who played it. Somebody
            ' new does not inherit the result, the crowns or a seat in it -
            ' the room starts over. This also frees a room whose second
            ' seat was held by the machine.
            rm{"ST"} = ARENA.NEWGAME()
            rm{"PLAYERS"} = []
            players = rm{"PLAYERS"}
            st = rm{"ST"}
            PRINT "room "; rm{"KEY"}; " reopened for "; name$
        ELSE
            ' A stranger may only take over a seat that has been silent for
            ' a while - locking your screen mid-battle must not hand your
            ' base to a bystander.
            DIM idle_ok = 60000
            IF st{"TICKNO"} = 0 THEN idle_ok = 8000
            FOR i = 0 TO LEN(players) - 1
                IF now - players[i]{"LAST"} > idle_ok THEN
                    players[i] = { "NAME": name$, "TOK": tok$, "LAST": now, "DECK": deck }
                    st{"QUEUES"}[i] = DECKQ(deck)
                    st{"CARDLVL"}[i] = CARDLVLMAP(name$)
                    PRINT "takeover: "; name$; " claims idle pid "; i; " in "; rm{"KEY"}
                    RETURN JJ({ "OK": 1, "PID": i, "TOK": tok$, "ROOM": rm{"KEY"} })
                ENDIF
            NEXT i
            RETURN JJ({ "OK": 0, "MSG": "msg_full" })
        ENDIF
    ENDIF
    rm{"PLAYERS"} = APPEND(players, { "NAME": name$, "TOK": tok$, "LAST": TICK(), "DECK": deck })
    DIM slot = LEN(rm{"PLAYERS"}) - 1
    st{"QUEUES"}[slot] = DECKQ(deck)
    st{"CARDLVL"}[slot] = CARDLVLMAP(name$)
    IF slot = 1 THEN rm{"LAST"} = TICK()
    PRINT "join: "; name$; " -> pid "; slot; " in "; rm{"KEY"}
    RETURN JJ({ "OK": 1, "PID": slot, "TOK": tok$, "ROOM": rm{"KEY"} })
ENDFUNC

FUNC HSTATE(req)
    ' a pending stats write rides out on the busiest endpoint there is
    FLUSHSTATS()
    DIM rm = ROOMFIND(req, 0)
    IF TYPEOF(rm) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_noroom" })
    SYNCSIM(rm)
    DIM players = rm{"PLAYERS"}
    DIM pid = -1
    IF MAP.EXISTS(req{"PARAMS"}, "tok") THEN pid = PIDBYTOK(players, req{"PARAMS"}{"tok"})
    IF pid >= 0 THEN players[pid]{"LAST"} = TICK()
    DIM names = []
    DIM profiles = []
    DIM i
    FOR i = 0 TO LEN(players) - 1
        DIM pn$ = players[i]{"NAME"}
        names = APPEND(names, pn$)
        IF pn$ = BOT_NAME THEN
            profiles = APPEND(profiles, { "NAME": pn$, "WINS": 0, "LOSSES": 0, "DRAWS": 0, "CROWNS": 0 })
        ELSE
            DIM s = STATOF(pn$)
            profiles = APPEND(profiles, { "NAME": pn$, "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, "DRAWS": s{"DRAWS"}, "CROWNS": s{"CROWNS"} })
        ENDIF
    NEXT i
    RETURN JJ({ "OK": 1, "PID": pid, "WAITING": IIF(LEN(players) < 2, 1, 0), "NAMES": names, "PROFILES": profiles, "ST": rm{"ST"} })
ENDFUNC

FUNC HPLAY(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF TYPEOF(b) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_badreq" })
    DIM rm = ROOMFIND(req, b)
    IF TYPEOF(rm) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_noroom" })
    SYNCSIM(rm)
    DIM pid = PIDBYTOK(rm{"PLAYERS"}, b{"TOK"})
    IF pid < 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badtok" })
    ' a recall carries the loop the player drew: middle and radius in tiles
    DIM res$ = ""
    DIM tick_before = rm{"ST"}{"TICKNO"}
    IF MAP.EXISTS(b, "CX") THEN
        res$ = ARENA.PLAYWARP(rm{"ST"}, pid, b{"KIND"}, b{"X"}, b{"Y"}, b{"CX"}, b{"CY"}, b{"R"})
        IF res$ = "" THEN LOGPLAY(rm, pid, "" + b{"KIND"}, b{"X"}, b{"Y"}, { "CX": b{"CX"}, "CY": b{"CY"}, "R": b{"R"} })
    ELSE
        res$ = ARENA.PLAYCARD(rm{"ST"}, pid, b{"KIND"}, b{"X"}, b{"Y"})
        IF res$ = "" THEN LOGPLAY(rm, pid, "" + b{"KIND"}, b{"X"}, b{"Y"}, 0)
    ENDIF
    RETURN JJ({ "OK": IIF(res$ = "", 1, 0), "MSG": res$ })
ENDFUNC

' Six fixed emotes, no free text: nothing to type on a phone mid-match and
' nothing to moderate. The bubble rides the normal event list, so clients
' pick it up with the next /state like any explosion.
CONST EMOTE_GAP_MS = 1500
CONST EMOTE_COUNT = 6

FUNC HEMOTE(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF TYPEOF(b) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_badreq" })
    DIM rm = ROOMFIND(req, b)
    IF TYPEOF(rm) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_noroom" })
    SYNCSIM(rm)
    DIM pid = PIDBYTOK(rm{"PLAYERS"}, b{"TOK"})
    IF pid < 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badtok" })
    DIM id = INT(b{"ID"})
    IF id < 0 ORELSE id >= EMOTE_COUNT THEN RETURN JJ({ "OK": 0, "MSG": "msg_unknown" })
    DIM p = rm{"PLAYERS"}[pid]
    DIM now = TICK()
    IF MAP.EXISTS(p, "EMOTED") ANDALSO now - p{"EMOTED"} < EMOTE_GAP_MS THEN
        RETURN JJ({ "OK": 0, "MSG": "msg_slowdown" })
    ENDIF
    p{"EMOTED"} = now
    ' place it over the sender's own base, which WY mirrors for player 1
    DIM ey = 26.0
    IF pid = 1 THEN ey = 4.0
    DIM r = ARENA.ADDEVENT(rm{"ST"}, { "T": "EMOTE", "PID": pid, "ID": id, "X": 9.0, "Y": ey })
    RETURN JJ({ "OK": 1 })
ENDFUNC

' Fill the free seat with the machine. Only the player already sitting in
' the room may ask, and only while the seat is still empty.
FUNC HBOT(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF TYPEOF(b) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_badreq" })
    DIM rm = ROOMFIND(req, b)
    IF TYPEOF(rm) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_noroom" })
    DIM ps = rm{"PLAYERS"}
    IF LEN(ps) <> 1 THEN RETURN JJ({ "OK": 0, "MSG": "msg_full" })
    IF PIDBYTOK(ps, b{"TOK"}) <> 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badtok" })
    DIM deck = BOTDECK()
    rm{"PLAYERS"} = APPEND(ps, [{ "NAME": BOT_NAME, "TOK": CODEC.UUID$(), "LAST": TICK(), "DECK": deck, "BOT": 1 }])
    rm{"ST"}{"QUEUES"}[1] = DECKQ(deck)
    rm{"ST"}{"CARDLVL"}[1] = {}
    rm{"LAST"} = TICK()
    PRINT "bot joined "; rm{"KEY"}
    RETURN JJ({ "OK": 1 })
ENDFUNC

FUNC HRESET(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM rm = ROOMFIND(req, b)
    IF TYPEOF(rm) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_noroom" })
    rm{"ST"} = ARENA.NEWGAME()
    rm{"PLAYERS"} = []
    rm{"LAST"} = TICK()
    PRINT "reset room "; rm{"KEY"}
    RETURN JJ({ "OK": 1, "MSG": "Raum " + rm{"KEY"} + " frei, 0 Spieler" })
ENDFUNC

' Drops a room entirely; it reappears when someone joins it again.
FUNC HDROP(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM key$ = ROOMKEY$(IIF(MAP.EXISTS(req{"PARAMS"}, "room"), req{"PARAMS"}{"room"}, "main"))
    IF MAP.EXISTS(rooms, key$) THEN
        DIM keep AS MAP = {}
        FOR EACH k$ IN MAP.KEYS(rooms)
            IF k$ <> key$ THEN keep{k$} = rooms{k$}
        NEXT k$
        rooms = keep
        PRINT "dropped room "; key$
    ENDIF
    RETURN JJ({ "OK": 1, "MSG": key$ })
ENDFUNC

' Lifetime table, strongest record first.
FUNC HLEADER(req)
    IF ISADMIN(req, 0) = 0 THEN RETURN DENY()
    DIM out = []
    FOR EACH n$ IN MAP.KEYS(stats)
        IF n$ = BOT_NAME THEN CONTINUEFOR
        DIM s = STATOF(n$)
        DIM ncards = 0
        FOR EACH ck$ IN MAP.KEYS(s{"CARDS"})
            ncards = ncards + s{"CARDS"}{ck$}{"LVL"} - 1
        NEXT ck$
        DIM claimed = 0
        IF s{"PINHASH"} <> "" THEN claimed = 1
        out = APPEND(out, [{ "NAME": n$, "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, "DRAWS": s{"DRAWS"}, "CROWNS": s{"CROWNS"}, "WILD": s{"WILD"}, "UPGRADES": ncards, "CLAIMED": claimed }])
    NEXT n$
    RETURN JJ({ "OK": 1, "PLAYERS": out })
ENDFUNC

' ---- the public board ----
'
' Everything here is readable without a login: it is what the players want
' to compare after a match. Credentials and wildcards stay out of it.

FUNC HPLAYERS(req)
    DIM out = []
    FOR EACH n$ IN MAP.KEYS(stats)
        IF n$ = BOT_NAME THEN CONTINUEFOR
        DIM s = STATOF(n$)
        DIM lifted = 0
        DIM cards = 0
        FOR EACH ck$ IN MAP.KEYS(s{"CARDS"})
            cards = cards + 1
            lifted = lifted + s{"CARDS"}{ck$}{"LVL"} - 1
        NEXT ck$
        DIM played = s{"WINS"} + s{"LOSSES"} + s{"DRAWS"}
        out = APPEND(out, [{ "NAME": n$, "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, _
                             "DRAWS": s{"DRAWS"}, "PLAYED": played, "CROWNS": s{"CROWNS"}, _
                             "CARDS": cards, "UPGRADES": lifted }])
    NEXT n$
    RETURN JJ({ "OK": 1, "PLAYERS": out })
ENDFUNC

' One player's collection, so two of them can be held side by side.
FUNC HPLAYER(req)
    DIM name$ = ""
    IF MAP.EXISTS(req{"PARAMS"}, "name") THEN name$ = req{"PARAMS"}{"name"}
    IF name$ = "" ORELSE NOT MAP.EXISTS(stats, name$) THEN RETURN JJ({ "OK": 0, "MSG": "unbekannter Spieler" })
    DIM s = STATOF(name$)
    DIM cl = []
    FOR EACH ck$ IN SORT(MAP.KEYS(s{"CARDS"}))
        cl = APPEND(cl, [{ "KIND": ck$, "LVL": s{"CARDS"}{ck$}{"LVL"}, "HAVE": s{"CARDS"}{ck$}{"HAVE"} }])
    NEXT ck$
    RETURN JJ({ "OK": 1, "NAME": name$, "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, _
                "DRAWS": s{"DRAWS"}, "CROWNS": s{"CROWNS"}, "CARDS": cl })
ENDFUNC

' Recent matches, newest first. The head-to-head tally falls out of this.
FUNC HMATCHES(req)
    DIM lim = 40
    IF MAP.EXISTS(req{"PARAMS"}, "limit") THEN lim = INT(VAL(req{"PARAMS"}{"limit"}))
    IF lim < 1 THEN lim = 1
    IF lim > MATCH_KEEP THEN lim = MATCH_KEEP
    DIM out = []
    DIM i
    FOR i = LEN(matches) - 1 TO 0 STEP -1
        IF LEN(out) >= lim THEN EXITFOR
        out = APPEND(out, [matches[i]])
    NEXT i
    RETURN JJ({ "OK": 1, "MATCHES": out, "TOTAL": LEN(matches) })
ENDFUNC

' Free a name's PIN so its owner can set a new one. The record and the
' collection stay; only the credential goes, along with any session still
' running under that name.
FUNC HRESETPIN(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM n$ = ""
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "NAME") THEN n$ = b{"NAME"}
    IF n$ = "" ORELSE NOT MAP.EXISTS(stats, n$) THEN RETURN JJ({ "OK": 0, "MSG": "unbekannter Spieler" })
    DIM s = STATOF(n$)
    s{"PINHASH"} = ""
    s{"SALT"} = ""
    s{"TRIES"} = 0
    s{"LOCKED"} = 0
    DIM keep AS MAP = {}
    FOR EACH t$ IN MAP.KEYS(sessions)
        IF sessions{t$}{"NAME"} <> n$ THEN keep{t$} = sessions{t$}
    NEXT t$
    sessions = keep
    SAVESTATS()
    PRINT "pin reset: "; n$
    RETURN JJ({ "OK": 1, "MSG": n$ })
ENDFUNC

' Wipes one player's record and collection - a fresh start on request.
FUNC HWIPE(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM n$ = ""
    IF TYPEOF(b) = "OBJECT" ANDALSO MAP.EXISTS(b, "NAME") THEN n$ = b{"NAME"}
    IF n$ = "" ORELSE NOT MAP.EXISTS(stats, n$) THEN RETURN JJ({ "OK": 0, "MSG": "unbekannter Spieler" })
    DIM keep AS MAP = {}
    FOR EACH k$ IN MAP.KEYS(stats)
        IF k$ <> n$ THEN keep{k$} = stats{k$}
    NEXT k$
    stats = keep
    SAVESTATS()
    PRINT "wiped player "; n$
    RETURN JJ({ "OK": 1, "MSG": n$ })
ENDFUNC

' New match, same two players and their decks - the in-game rematch button.
FUNC HREMATCH(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    DIM rm = ROOMFIND(req, b)
    IF TYPEOF(rm) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_noroom" })
    DIM players = rm{"PLAYERS"}
    rm{"ST"} = ARENA.NEWGAME()
    ' a fresh match starts a fresh log - without this the next recording
    ' carries the previous match's cards with it and replays as nonsense
    rm{"LOG"} = []
    rm{"MARKS"} = []
    IF MAP.EXISTS(rm, "FORCED") THEN rm{"FORCED"} = 0
    DIM st = rm{"ST"}
    DIM i
    FOR i = 0 TO LEN(players) - 1
        st{"QUEUES"}[i] = DECKQ(players[i]{"DECK"})
        st{"CARDLVL"}[i] = CARDLVLMAP(players[i]{"NAME"})
    NEXT i
    rm{"LAST"} = TICK()
    PRINT "rematch in "; rm{"KEY"}
    RETURN JJ({ "OK": 1 })
ENDFUNC

FUNC HROOT(req)
    DIM lines$ = "BASIC Royale match server. Rooms: "
    DIM ks = MAP.KEYS(rooms)
    FOR EACH k$ IN ks
        lines$ = lines$ + k$ + "(" + STR$(LEN(rooms{k$}{"PLAYERS"})) + ") "
    NEXT k$
    RETURN lines$ + "| POST /join, GET /state?tok=&room=, POST /play, POST /rematch, GET /reset?room=, GET /cards, GET /profile?name=, POST /upgrade."
ENDFUNC

' Ends the running match immediately (player 1 takes it).
FUNC HFORCEEND(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF ISADMIN(req, b) = 0 THEN RETURN DENY()
    DIM rm = ROOMFIND(req, b)
    IF TYPEOF(rm) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_noroom" })
    ' an outcome nobody played cannot be replayed, so the recording says so
    rm{"FORCED"} = 1
    rm{"ST"}{"TOWERS"}[2]{"HP"} = 0
    RETURN JJ({ "OK": 1 })
ENDFUNC

FUNC HCARDS(req)
    RETURN JJ({ "OK": 1, "CARDS": ARENA.CARDS() })
ENDFUNC

' ---- what the cards actually do in matches ----
'
' Counted from the recordings, once at startup and then per finished match,
' because reading the whole history on every request would get slower with
' every match played - the mistake stats.json made and this file must not.
' Per card: how often it sat in a deck, how often it was actually played, and
' how often the side carrying it won. Bot matches stay out; they are not
' evidence about players.
DIM cardstat AS MAP = {}
DIM cardstat_matches = 0

SUB COUNTMATCH(rec)
    IF MAP.EXISTS(rec, "BOT") ANDALSO rec{"BOT"} = 1 THEN RETURN
    cardstat_matches = cardstat_matches + 1
    DIM w = -1
    IF MAP.EXISTS(rec, "WINNER") THEN w = INT(rec{"WINNER"})
    DIM side
    FOR side = 0 TO 1
        DIM deck = rec{"DECKA"}
        IF side = 1 THEN deck = rec{"DECKB"}
        IF TYPEOF(deck) <> "ARRAY" THEN CONTINUEFOR
        FOR EACH k$ IN deck
            IF NOT MAP.EXISTS(cardstat, "" + k$) THEN cardstat{"" + k$} = { "DECKS": 0, "PLAYS": 0, "WINS": 0 }
            DIM ent = cardstat{"" + k$}
            ent{"DECKS"} = ent{"DECKS"} + 1
            IF w = side THEN ent{"WINS"} = ent{"WINS"} + 1
        NEXT k$
    NEXT side
    IF TYPEOF(rec{"PLAYS"}) = "ARRAY" THEN
        FOR EACH p IN rec{"PLAYS"}
            DIM pk$ = "" + p{"K"}
            IF NOT MAP.EXISTS(cardstat, pk$) THEN cardstat{pk$} = { "DECKS": 0, "PLAYS": 0, "WINS": 0 }
            cardstat{pk$}{"PLAYS"} = cardstat{pk$}{"PLAYS"} + 1
        NEXT p
    ENDIF
ENDSUB

' Read the history once at startup. A line that will not parse is skipped
' rather than taking the server down with it.
SUB LOADCARDSTATS()
    DIM raw$ = ""
    TRY
        raw$ = TXTREADER$("replays.jsonl")
    CATCH
    ENDTRY
    IF raw$ = "" THEN RETURN
    FOR EACH ln$ IN SPLIT(raw$, CHR$(10))
        IF LEN(TRIM$(ln$)) > 2 THEN
            TRY
                COUNTMATCH(JSON.PARSE$(ln$))
            CATCH
            ENDTRY
        ENDIF
    NEXT ln$
    PRINT "card stats from "; cardstat_matches; " recorded matches"
ENDSUB

FUNC HCARDSTATS(req)
    RETURN JJ({ "OK": 1, "MATCHES": cardstat_matches, "CARDS": cardstat })
ENDFUNC

' UI translations - clients look their strings up by key.
DIM lang_json$ = "{}"
TRY
    lang_json$ = TXTREADER$("lang.json")
CATCH
ENDTRY

FUNC HLANG(req)
    RETURN { "__http_status": 200, "__http_body": lang_json$, "__http_content_type": "application/json", "__http_headers": { "Access-Control-Allow-Origin": "*" } }
ENDFUNC

' Room directory for the lobby: who is in, and is there a seat left.
' Empty rooms that nobody has touched for half an hour are swept away so
' the list keeps showing what is actually being played.
FUNC HROOMS(req)
    DIM now = TICK()
    DIM keep AS MAP = {}
    FOR EACH sk$ IN MAP.KEYS(rooms)
        DIM sr = rooms{sk$}
        IF LEN(sr{"PLAYERS"}) > 0 ORELSE now - sr{"LAST"} < 1800000 ORELSE sk$ = "main" THEN keep{sk$} = sr
    NEXT sk$
    rooms = keep

    DIM admin = ISADMIN(req, 0)
    DIM out = []
    FOR EACH k$ IN MAP.KEYS(rooms)
        DIM rr = rooms{k$}
        ' the sim only moves when somebody asks, so catch each room up
        ' before reporting it - otherwise a match that ran out of time
        ' keeps claiming it is being played
        SYNCSIM(rr)
        ' and a decided room whose seats went quiet returns to free, so the
        ' list does not fill up with matches nobody is in any more
        IF rr{"ST"}{"PHASE"} <> "play" ANDALSO LEN(rr{"PLAYERS"}) > 0 THEN
            DIM quiet = 1
            FOR EACH pq IN rr{"PLAYERS"}
                IF now - pq{"LAST"} < 60000 THEN quiet = 0
            NEXT pq
            IF quiet = 1 THEN
                rr{"ST"} = ARENA.NEWGAME()
                rr{"PLAYERS"} = []
                PRINT "room "; k$; " went quiet - free again"
            ENDIF
        ENDIF
        DIM rp = rr{"PLAYERS"}
        DIM names = []
        DIM i
        FOR i = 0 TO LEN(rp) - 1
            names = APPEND(names, rp[i]{"NAME"})
        NEXT i
        ' a running match is public knowledge - that is what a spectator
        ' picks from
        DIM live = 0
        IF LEN(rp) = 2 ANDALSO rr{"ST"}{"PHASE"} = "play" ANDALSO rr{"ST"}{"TICKNO"} > 0 THEN live = 1
        ' what the room is actually doing, so the lobby can say so
        DIM state$ = "free"
        IF LEN(rp) = 1 THEN state$ = "waiting"
        IF LEN(rp) >= 2 THEN
            state$ = "ready"
            IF live = 1 THEN state$ = "play"
            IF rr{"ST"}{"PHASE"} <> "play" THEN state$ = "over"
        ENDIF
        DIM row AS MAP = { "KEY": k$, "N": LEN(rp), "NAMES": names, "LIVE": live, "STATE": state$ }
        IF admin = 1 THEN
            row{"PHASE"} = rr{"ST"}{"PHASE"}
            row{"TICKNO"} = rr{"ST"}{"TICKNO"}
            row{"CROWNS"} = rr{"ST"}{"CROWNS"}
            row{"IDLE"} = INT((now - rr{"LAST"}) / 1000)
        ENDIF
        out = APPEND(out, [row])
    NEXT k$
    RETURN JJ({ "OK": 1, "ROOMS": out })
ENDFUNC

' Claim a name or prove you already own it. The first login under a free
' The same name lands in the lobby, the standings and the log, so it is held
' to what the game's font can draw. The font does carry the German letters,
' which was worth checking rather than assuming.
CONST NAME_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 _.-äöüÄÖÜß"

' Sixteen characters, not sixteen bytes: LEN counts bytes, so an umlaut would
' otherwise cost a name two of its letters.
FUNC NAMEOK(nm$)
    IF nm$ = "" THEN RETURN 0
    DIM chars = -nm$
    IF LEN(chars) > 16 THEN RETURN 0
    FOR EACH ch$ IN chars
        IF INSTR(NAME_CHARS, ch$) < 0 THEN RETURN 0
    NEXT ch$
    RETURN 1
ENDFUNC

' name sets its PIN; every later one has to match it.
FUNC HLOGIN(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    IF TYPEOF(b) <> "OBJECT" THEN RETURN JJ({ "OK": 0, "MSG": "msg_badreq" })
    DIM name$ = TRIM$("" + b{"NAME"})
    DIM pin$ = TRIM$("" + b{"PIN"})
    IF NAMEOK(name$) = 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badname" })
    IF PINOK(pin$) = 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_badpin" })

    DIM s = STATOF(name$)
    DIM now = TICK()
    IF s{"LOCKED"} > now THEN RETURN JJ({ "OK": 0, "MSG": "msg_locked" })

    IF s{"PINHASH"} = "" THEN
        s{"SALT"} = CODEC.UUID$()
        s{"PINHASH"} = PINHASH$(s{"SALT"}, pin$)
        s{"TRIES"} = 0
        DIM starter = ENSURESTARTER(name$)
        TOUCHSTATS()
        PRINT "claimed: "; name$
        RETURN JJ({ "OK": 1, "AUTH": NEWSESSION$(name$), "NAME": name$, "CLAIMED": 1 })
    ENDIF

    IF PINHASH$(s{"SALT"}, pin$) <> s{"PINHASH"} THEN
        s{"TRIES"} = s{"TRIES"} + 1
        ' a four digit PIN only holds up if guessing is slow
        IF s{"TRIES"} >= PIN_TRIES THEN
            s{"LOCKED"} = now + PIN_LOCK_MS
            s{"TRIES"} = 0
            PRINT "locked: "; name$
        ENDIF
        TOUCHSTATS()
        RETURN JJ({ "OK": 0, "MSG": "msg_wrongpin" })
    ENDIF

    s{"TRIES"} = 0
    DIM st2 = ENSURESTARTER(name$)
    RETURN JJ({ "OK": 1, "AUTH": NEWSESSION$(name$), "NAME": name$, "CLAIMED": 0 })
ENDFUNC

' What a client is allowed to see of a profile. The credential fields never
' leave the server, not even to the account they belong to.
FUNC PUBPROFILE(s)
    ENSUREDECKS(s)
    RETURN { "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, "DRAWS": s{"DRAWS"}, _
             "CROWNS": s{"CROWNS"}, "CARDS": s{"CARDS"}, "WILD": s{"WILD"}, _
             "LASTCHEST": s{"LASTCHEST"}, "DECKS": s{"DECKS"}, "ACTIVE": s{"ACTIVE"} }
ENDFUNC

' Up to three named decks per player, stored with the profile so they
' survive a reload and follow the name to another device.
CONST DECK_SLOTS = 3

' A stored deck goes stale when a card is renamed or dropped from the table:
' the name stays in the profile, the client cannot show it, and the slot looks
' like it only holds five. Decks are checked when they are saved but were
' never checked when they are read, so repair here. Everything that still
' exists is kept in place and the gap is filled from the default deck.
FUNC REPAIRDECK(d)
    IF DECKOK(d) = 1 THEN RETURN d
    DIM cs = ARENA.CARDS()
    DIM out = []
    DIM seen AS MAP = {}
    DIM i
    IF TYPEOF(d) = "ARRAY" THEN
        FOR i = 0 TO LEN(d) - 1
            DIM k$ = "" + d[i]
            IF MAP.EXISTS(cs, k$) ANDALSO NOT MAP.EXISTS(seen, k$) THEN
                out = APPEND(out, [k$])
                seen{k$} = 1
            ENDIF
        NEXT i
    ENDIF
    DIM fill = DEFAULTDECK()
    FOR i = 0 TO LEN(fill) - 1
        IF LEN(out) >= 6 THEN EXITFOR
        IF NOT MAP.EXISTS(seen, fill[i]) THEN
            out = APPEND(out, [fill[i]])
            seen{fill[i]} = 1
        ENDIF
    NEXT i
    RETURN out
ENDFUNC

SUB ENSUREDECKS(s)
    DIM out = s{"DECKS"}
    DIM i
    FOR i = LEN(out) TO DECK_SLOTS - 1
        out = APPEND(out, [{ "NAME": "Deck " + STR$(i + 1), "CARDS": DEFAULTDECK() }])
    NEXT i
    FOR i = 0 TO LEN(out) - 1
        out[i]{"CARDS"} = REPAIRDECK(out[i]{"CARDS"})
    NEXT i
    s{"DECKS"} = out
    IF s{"ACTIVE"} < 0 ORELSE s{"ACTIVE"} >= DECK_SLOTS THEN s{"ACTIVE"} = 0
ENDSUB

FUNC HDECKS(req)
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
    CATCH
    ENDTRY
    DIM name$ = WHOIS$(req, b)
    IF name$ = "" THEN RETURN NEEDAUTH()
    IF TYPEOF(b{"DECKS"}) <> "ARRAY" THEN RETURN JJ({ "OK": 0, "MSG": "msg_badreq" })
    DIM incoming = b{"DECKS"}
    IF LEN(incoming) < 1 ORELSE LEN(incoming) > DECK_SLOTS THEN RETURN JJ({ "OK": 0, "MSG": "msg_badreq" })
    DIM out = []
    DIM i
    FOR i = 0 TO LEN(incoming) - 1
        DIM d = incoming[i]
        IF TYPEOF(d) <> "OBJECT" ORELSE DECKOK(d{"CARDS"}) = 0 THEN RETURN JJ({ "OK": 0, "MSG": "msg_baddeck" })
        DIM dn$ = "Deck " + STR$(i + 1)
        IF TYPEOF(d{"NAME"}) = "STRING" ANDALSO LEN(d{"NAME"}) > 0 THEN dn$ = MID$(d{"NAME"}, 0, 14)
        out = APPEND(out, [{ "NAME": dn$, "CARDS": d{"CARDS"} }])
    NEXT i
    DIM s = STATOF(name$)
    s{"DECKS"} = out
    s{"ACTIVE"} = 0
    IF TYPEOF(b{"ACTIVE"}) <> "NONE" THEN s{"ACTIVE"} = INT(b{"ACTIVE"})
    ENSUREDECKS(s)
    SAVESTATS()
    RETURN JJ({ "OK": 1, "DECKS": s{"DECKS"}, "ACTIVE": s{"ACTIVE"} })
ENDFUNC

FUNC HPROFILE(req)
    DIM name$ = WHOIS$(req, 0)
    IF name$ = "" THEN RETURN NEEDAUTH()
    RETURN JJ({ "OK": 1, "PROFILE": PUBPROFILE(ENSURESTARTER(name$)) })
ENDFUNC

' Level a card: costs 2^level copies (2, 4, 8, 16); wildcards fill any
' shortage. Applies live to a seated player's next deploys.
FUNC HUPGRADE(req)
    DIM b = JSON.PARSE$(req{"BODY"})
    DIM name$ = WHOIS$(req, b)
    IF name$ = "" THEN RETURN NEEDAUTH()
    DIM kind$ = b{"KIND"}
    IF NOT MAP.EXISTS(ARENA.CARDS(), kind$) THEN RETURN JJ({ "OK": 0, "MSG": "msg_unknown" })
    DIM s = STATOF(name$)
    DIM ce = CARDENTRY(s, kind$)
    DIM lvl = ce{"LVL"}
    IF lvl >= 5 THEN RETURN JJ({ "OK": 0, "MSG": "msg_maxlvl" })
    DIM cost = INT(2 ^ lvl)
    DIM have = ce{"HAVE"}
    IF have + s{"WILD"} < cost THEN RETURN JJ({ "OK": 0, "MSG": "msg_nocards" })
    DIM used = have
    IF used > cost THEN used = cost
    ce{"HAVE"} = have - used
    s{"WILD"} = s{"WILD"} - (cost - used)
    ce{"LVL"} = lvl + 1
    ' apply live wherever this player is currently seated
    DIM ks = MAP.KEYS(rooms)
    FOR EACH rk$ IN ks
        DIM rp = rooms{rk$}{"PLAYERS"}
        DIM i
        FOR i = 0 TO LEN(rp) - 1
            IF rp[i]{"NAME"} = name$ THEN rooms{rk$}{"ST"}{"CARDLVL"}[i] = CARDLVLMAP(name$)
        NEXT i
    NEXT rk$
    SAVESTATS()
    PRINT "upgrade: "; name$; " "; kind$; " -> Lv"; lvl + 1
    RETURN JJ({ "OK": 1, "LVL": lvl + 1 })
ENDFUNC

