' BASIC Royale match server - one match, two players, server-authoritative.
' The sim catches up lazily on every request: elapsed wall time is replayed
' as 0.1 s SIMSTEPs, so no background thread is needed and the match simply
' pauses while nobody polls. Clients POST JSON with Content-Type text/plain
' (a CORS simple request - no OPTIONS preflight, which the server has no
' route for) and every response carries Access-Control-Allow-Origin: *.
IMPORT ARENA

' cards.json is the single source of truth for card stats and colors -
' the sim uses it via ARENA.SETCARDS, clients fetch it as GET /cards.
DIM cards_json$ = ""
TRY
    cards_json$ = TXTREADER$("cards.json")
    ARENA.SETCARDS(JSON.PARSE$(cards_json$))
    PRINT "cards.json loaded"
CATCH
    PRINT "cards.json missing - built-in card set"
ENDTRY

DIM st = ARENA.NEWGAME()
DIM players = []
DIM last_ms = TICK()

' Lifetime stats per player name, persisted across server restarts.
' Wins feed the card level: +1 level per 3 wins, capped at 5.
DIM stats AS MAP = {}
TRY
    stats = JSON.PARSE$(TXTREADER$("stats.json"))
CATCH
ENDTRY

SUB SAVESTATS()
    TRY
        TXTWRITER "stats.json", JSON.STRINGIFY$(stats)
    CATCH
    ENDTRY
ENDSUB

FUNC STATOF(name$)
    IF NOT MAP.EXISTS(stats, name$) THEN
        stats{name$} = { "WINS": 0, "LOSSES": 0, "DRAWS": 0, "CROWNS": 0 }
    ENDIF
    RETURN stats{name$}
ENDFUNC

FUNC PLEVEL(name$)
    DIM s = STATOF(name$)
    DIM lvl = 1 + INT(s{"WINS"} / 3)
    IF lvl > 5 THEN lvl = 5
    RETURN lvl
ENDFUNC

' Book the finished match into the lifetime stats, exactly once.
SUB RECORDMATCH()
    IF st{"PHASE"} = "over" ANDALSO NOT MAP.EXISTS(st, "RECORDED") ANDALSO LEN(players) = 2 THEN
        st{"RECORDED"} = 1
        DIM w = st{"WINNER"}
        DIM i
        FOR i = 0 TO 1
            DIM s = STATOF(players[i]{"NAME"})
            s{"CROWNS"} = s{"CROWNS"} + st{"CROWNS"}[i]
            IF w = 2 THEN
                s{"DRAWS"} = s{"DRAWS"} + 1
            ELSEIF w = i THEN
                s{"WINS"} = s{"WINS"} + 1
            ELSE
                s{"LOSSES"} = s{"LOSSES"} + 1
            ENDIF
        NEXT i
        SAVESTATS()
        PRINT "match recorded: winner "; w
    ENDIF
ENDSUB

FUNC JJ(m)
    RETURN { "__http_status": 200, "__http_body": JSON.STRINGIFY$(m), "__http_content_type": "application/json", "__http_headers": { "Access-Control-Allow-Origin": "*" } }
ENDFUNC

FUNC PIDBYTOK(tok$)
    DIM i
    FOR i = 0 TO LEN(players) - 1
        IF players[i]{"TOK"} = tok$ THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

SUB SYNCSIM()
    DIM now = TICK()
    IF LEN(players) < 2 THEN
        last_ms = now
    ELSE
        DIM n_steps = INT((now - last_ms) / 100)
        IF n_steps > 100 THEN
            n_steps = 100
            last_ms = now - 10000
        ENDIF
        DIM i
        FOR i = 1 TO n_steps
            st = ARENA.SIMSTEP(st)
        NEXT i
        last_ms = last_ms + n_steps * 100
        RECORDMATCH()
    ENDIF
ENDSUB

' Validated 6-card deck from the join body, or the classic default.
FUNC PICKDECK(b)
    DIM def = ["KNIGHT", "ARCHER", "GIANT", "MINIONS", "SKELETONS", "FIREBALL"]
    IF TYPEOF(b) <> "OBJECT" ORELSE NOT MAP.EXISTS(b, "DECK") THEN RETURN def
    DIM d = b{"DECK"}
    IF TYPEOF(d) <> "ARRAY" ORELSE LEN(d) <> 6 THEN RETURN def
    DIM cs = ARENA.CARDS()
    DIM seen AS MAP = {}
    DIM i
    FOR i = 0 TO 5
        IF NOT MAP.EXISTS(cs, d[i]) ORELSE MAP.EXISTS(seen, d[i]) THEN RETURN def
        seen{d[i]} = 1
    NEXT i
    RETURN d
ENDFUNC

' Fresh copy so the cycling queue never shares storage with the deck.
FUNC DECKQ(d)
    DIM q = []
    DIM i
    FOR i = 0 TO LEN(d) - 1
        q = APPEND(q, d[i])
    NEXT i
    RETURN q
ENDFUNC

FUNC HJOIN(req)
    DIM name$ = "P" + STR$(LEN(players))
    DIM b = 0
    TRY
        b = JSON.PARSE$(req{"BODY"})
        IF MAP.EXISTS(b, "NAME") THEN name$ = b{"NAME"}
    CATCH
    ENDTRY
    DIM deck = PICKDECK(b)
    DIM tok$ = CODEC.UUID$()
    IF LEN(players) >= 2 THEN
        ' reclaim the slot of a client that stopped polling (closed tab)
        DIM now = TICK()
        DIM i
        FOR i = 0 TO LEN(players) - 1
            IF now - players[i]{"LAST"} > 5000 THEN
                players[i] = { "NAME": name$, "TOK": tok$, "LAST": now, "DECK": deck }
                st{"QUEUES"}[i] = DECKQ(deck)
                st{"LEVELS"}[i] = PLEVEL(name$)
                PRINT "rejoin: "; name$; " takes stale pid "; i
                RETURN JJ({ "OK": 1, "PID": i, "TOK": tok$ })
            ENDIF
        NEXT i
        RETURN JJ({ "OK": 0, "MSG": "match full - open /reset for a rematch" })
    ENDIF
    players = APPEND(players, { "NAME": name$, "TOK": tok$, "LAST": TICK(), "DECK": deck })
    st{"QUEUES"}[LEN(players) - 1] = DECKQ(deck)
    st{"LEVELS"}[LEN(players) - 1] = PLEVEL(name$)
    IF LEN(players) = 2 THEN last_ms = TICK()
    PRINT "join: "; name$; " -> pid "; LEN(players) - 1
    RETURN JJ({ "OK": 1, "PID": LEN(players) - 1, "TOK": tok$ })
ENDFUNC

FUNC HSTATE(req)
    SYNCSIM()
    DIM pid = -1
    IF MAP.EXISTS(req{"PARAMS"}, "tok") THEN pid = PIDBYTOK(req{"PARAMS"}{"tok"})
    IF pid >= 0 THEN players[pid]{"LAST"} = TICK()
    DIM names = []
    DIM profiles = []
    DIM i
    FOR i = 0 TO LEN(players) - 1
        DIM pn$ = players[i]{"NAME"}
        names = APPEND(names, pn$)
        DIM s = STATOF(pn$)
        profiles = APPEND(profiles, { "NAME": pn$, "LVL": PLEVEL(pn$), "WINS": s{"WINS"}, "LOSSES": s{"LOSSES"}, "DRAWS": s{"DRAWS"}, "CROWNS": s{"CROWNS"} })
    NEXT i
    RETURN JJ({ "OK": 1, "PID": pid, "WAITING": IIF(LEN(players) < 2, 1, 0), "NAMES": names, "PROFILES": profiles, "ST": st })
ENDFUNC

FUNC HPLAY(req)
    SYNCSIM()
    DIM b = JSON.PARSE$(req{"BODY"})
    DIM pid = PIDBYTOK(b{"TOK"})
    IF pid < 0 THEN RETURN JJ({ "OK": 0, "MSG": "bad token" })
    DIM res$ = ARENA.PLAYCARD(st, pid, b{"KIND"}, b{"X"}, b{"Y"})
    RETURN JJ({ "OK": IIF(res$ = "", 1, 0), "MSG": res$ })
ENDFUNC

FUNC HRESET(req)
    st = ARENA.NEWGAME()
    players = []
    last_ms = TICK()
    PRINT "match reset - all slots free"
    RETURN JJ({ "OK": 1, "MSG": "fresh match, 0 players" })
ENDFUNC

' New match, same two players and their decks - the in-game rematch button.
FUNC HREMATCH(req)
    st = ARENA.NEWGAME()
    DIM i
    FOR i = 0 TO LEN(players) - 1
        st{"QUEUES"}[i] = DECKQ(players[i]{"DECK"})
        st{"LEVELS"}[i] = PLEVEL(players[i]{"NAME"})
    NEXT i
    last_ms = TICK()
    PRINT "rematch"
    RETURN JJ({ "OK": 1 })
ENDFUNC

FUNC HROOT(req)
    RETURN "BASIC Royale match server. POST /join, GET /state?tok=, POST /play, POST /rematch, GET /reset, GET /cards."
ENDFUNC

FUNC HCARDS(req)
    RETURN JJ({ "OK": 1, "CARDS": ARENA.CARDS() })
ENDFUNC

HTTP.SERVER.ON_GET "/", "HROOT"
HTTP.SERVER.ON_GET "/state", "HSTATE"
HTTP.SERVER.ON_POST "/join", "HJOIN"
HTTP.SERVER.ON_POST "/play", "HPLAY"
HTTP.SERVER.ON_POST "/reset", "HRESET"
' browser-friendly reset - just open the URL
HTTP.SERVER.ON_GET "/reset", "HRESET"
HTTP.SERVER.ON_POST "/rematch", "HREMATCH"
HTTP.SERVER.ON_GET "/cards", "HCARDS"

DIM srv_port = 8081
IF HTTP.SERVER.START(srv_port, "0.0.0.0") THEN
    PRINT "BASIC Royale server on 0.0.0.0:"; srv_port
    ' Park the main thread inside the native - a DO/SLEEP loop here would
    ' execute bytecode on the same VM the handler threads call into, and
    ' the rare overlap crashes the server mid-match.
    HTTP.SERVER.WAIT
ELSE
    PRINT "cannot bind port "; srv_port
ENDIF
