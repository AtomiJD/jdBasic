' Assertions for hatcheries: a building that spawns, and a brood of more than
' one card. Both are card data, no code per card.
IMPORT ARENA
TRY
    ARENA.SETCARDS(JSON.PARSE$(TXTREADER$("cards.json")))
CATCH
ENDTRY
DIM cs = ARENA.CARDS()

DIM pass = 0
DIM fail = 0
SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  got ["; got$; "] want ["; want$; "]"
    ENDIF
ENDSUB

FUNC COUNTOF(st, kind$)
    DIM n = 0
    FOR EACH u IN st{"UNITS"}
        IF u{"KIND"} = kind$ ANDALSO u{"HP"} > 0 THEN n = n + 1
    NEXT u
    RETURN n
ENDFUNC

' a hatchery defined entirely in data: anchored, temporary, two kinds per cycle
cs{"BRUTNEST"} = { "COST": 5, "HP": 700, "DMG": 0, "HITSPEED": 1.0, "REACH": 1.0, _
                   "AGGRO": 0.1, "SPD": 0.0, "N": 1, "FLY": 0, "HITS": "G", "ONLYTOWERS": 0, _
                   "BUILD": 1, "TTL": 20.0, "SPAWNS": ["NANOS", "WESPEN"], "SPAWNRATE": 2.0, "SPAWNN": 2 }
ARENA.SETCARDS(cs)

DIM st = ARENA.NEWGAME()
st{"ELIXIR"}[0] = 10.0
st{"QUEUES"}[0] = ["BRUTNEST", "DROID", "LASER", "WESPEN", "SPLITTER", "PLASMA"]
CHECK("the hatchery deploys", ARENA.PLAYCARD(st, 0, "BRUTNEST", 9.0, 20.0), "")

DIM t
FOR t = 1 TO 25
    st = ARENA.SIMSTEP(st)
NEXT t
CHECK("it hatched a nano", STR$(COUNTOF(st, "NANOS") >= 1), "TRUE")
CHECK("and a wasp from the same list", STR$(COUNTOF(st, "WESPEN") >= 1), "TRUE")

DIM nest_x = -1.0
FOR EACH u IN st{"UNITS"}
    IF u{"KIND"} = "BRUTNEST" THEN nest_x = u{"X"}
NEXT u
CHECK("the building held its tile", STR$(nest_x), "9")

' it wears out: TTL 20 s is 200 ticks
FOR t = 1 TO 200
    st = ARENA.SIMSTEP(st)
NEXT t
CHECK("and expires", STR$(COUNTOF(st, "BRUTNEST")), "0")

' the single-kind form still works
CHECK("carrier still spawns one kind", "" + cs{"BRUTSCHIFF"}{"SPAWNS"}, "NANOS")

PRINT "spawn_test: passed "; pass; ", failed "; fail
