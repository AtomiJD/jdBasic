' BASIC Royale - phone/desktop client. Renders the server state and sends
' taps; the arena rules live on the server. Each player sees their own side
' at the bottom - player 1's view is mirrored. Ships and stations come from
' the ART module, baked into sprites once at startup.
' Shot mode for headless checks:  jdbasic royale.jdb shot -> tmp/client.png
IMPORT ART

' Where the match server lives. Served from a host (the deployed site),
' the page tells us its own origin and the API sits behind /api - on the
' LAN we fall back to the dev box.
DIM SRV$ = "http://192.168.0.37:8081"

CONST TILE = 26
CONST BOARD_Y0 = 60
CONST SCR_W = 468
CONST SCR_H = 900

DIM running = 1
SUB OnQuit()
    running = 0
ENDSUB
ON "QUIT" CALL OnQuit

' Taps arrive as buffered MOUSEDOWN events - a finger tap is shorter than
' one frame, so polling the button state misses it. The queue also survives
' the blocking /state fetch.
DIM tap_new = 0
DIM tap_x = 0
DIM tap_y = 0
DIM up_new = 0
DIM up_x = 0
DIM up_y = 0
DIM ptr_x = 0
DIM ptr_y = 0
SUB OnTap(info)
    tap_x = info[0]{"x"}
    tap_y = info[0]{"y"}
    ptr_x = tap_x
    ptr_y = tap_y
    tap_new = 1
ENDSUB
ON "MOUSEDOWN" CALL OnTap

SUB OnRelease(info)
    up_x = info[0]{"x"}
    up_y = info[0]{"y"}
    up_new = 1
ENDSUB
ON "MOUSEUP" CALL OnRelease

SUB OnDrag(info)
    ptr_x = info[0]{"x"}
    ptr_y = info[0]{"y"}
ENDSUB
ON "MOUSEMOVE" CALL OnDrag

' Card held down and dragged onto the board - released there it deploys.
DIM drag_kind$ = ""

' Fallbacks until GET /cards answers; the server's cards.json wins.
DIM kindcolor AS MAP = {}
kindcolor{"DROID"} = [175, 188, 215]
kindcolor{"LASER"} = [140, 235, 200]
kindcolor{"KOLOSS"} = [200, 150, 90]
kindcolor{"WESPEN"} = [120, 180, 255]
kindcolor{"SPLITTER"} = [225, 230, 245]
kindcolor{"PLASMA"} = [255, 130, 60]
DIM cardcost AS MAP = {}
cardcost{"DROID"} = 3
cardcost{"LASER"} = 3
cardcost{"KOLOSS"} = 5
cardcost{"WESPEN"} = 3
cardcost{"SPLITTER"} = 2
cardcost{"PLASMA"} = 4

' kind -> sprite id, one set per team, filled by BAKEART
DIM art_own AS MAP = {}
DIM art_foe AS MAP = {}
DIM art_ready = 0
DIM stars = []

DIM mypid = -1
DIM tok$ = ""
DIM world AS MAP = {}
DIM have_state = 0
DIM waiting = 1
DIM foename$ = ""
DIM profiles = []
DIM myprofile AS MAP = {}
DIM chest_shown = 0
DIM sel$ = ""
DIM msg$ = ""
DIM fxseen AS MAP = {}
DIM fxact = []
DIM frame = 0

' Screens: menu -> battle / decks. Battle joins on demand, not at load.
DIM uimode$ = "menu"
DIM mydeck = ["DROID", "LASER", "KOLOSS", "WESPEN", "SPLITTER", "PLASMA"]
DIM mydecks = []          ' all saved decks, the active one feeds mydeck
DIM deckidx = 0
DIM myname$ = "Spieler"
DIM auth$ = ""            ' session token, stands in for the PIN
DIM watching = 0          ' following a match without a seat
DIM prev_room$ = ""       ' the room to return to after watching
DIM h2h$ = ""             ' record against this opponent, filled when a match ends
DIM emote_open = 0
DIM emote_col = [[120, 240, 160], [255, 220, 90], [120, 200, 255], [255, 110, 110], [180, 170, 220], [255, 150, 220]]
DIM allcards AS MAP = {}
DIM cardorder = []

' UI strings by key, fetched from the server; ?lang= wins, otherwise the
' browser language decides, and German is the fallback.
DIM langs AS MAP = {}
DIM lang$ = "de"

FUNC T$(k$)
    IF MAP.EXISTS(langs, lang$) THEN
        IF MAP.EXISTS(langs{lang$}, k$) THEN RETURN langs{lang$}{k$}
    ENDIF
    IF MAP.EXISTS(langs, "de") THEN
        IF MAP.EXISTS(langs{"de"}, k$) THEN RETURN langs{"de"}{k$}
    ENDIF
    RETURN k$
ENDFUNC

SUB LOADLANG()
    TRY
        langs = JSON.PARSE$(HTTP.GET$(SRV$ + "/lang"))
    CATCH
    ENDTRY
ENDSUB

' A shared link personalises the session: ?room= picks the match and ?auth=
' carries the session token the landing page got from the login. ?pin= is
' the way in without that page, for a client started by hand.
DIM room$ = "main"
DIM mypin$ = ""
TRY
    DIM up = JSON.PARSE$(TXTREADER$("/url_params.json"))
    IF MAP.EXISTS(up, "name") THEN myname$ = up{"name"}
    IF MAP.EXISTS(up, "auth") THEN auth$ = up{"auth"}
    IF MAP.EXISTS(up, "pin") THEN mypin$ = up{"pin"}
    IF MAP.EXISTS(up, "room") THEN room$ = up{"room"}
    IF MAP.EXISTS(up, "__lang") THEN lang$ = LCASE$(MID$(up{"__lang"}, 0, 2))
    IF MAP.EXISTS(up, "lang") THEN lang$ = LCASE$(MID$(up{"lang"}, 0, 2))
    IF MAP.EXISTS(up, "__origin") THEN
        DIM org$ = up{"__origin"}
        IF INSTR(org$, "://192.168.") < 0 ANDALSO INSTR(org$, "://localhost") < 0 ANDALSO INSTR(org$, "://127.") < 0 THEN
            SRV$ = org$ + "/api"
        ENDIF
    ENDIF
CATCH
ENDTRY

' Player 1 sees the board mirrored so their own side is at the bottom.
FUNC WY(y)
    IF mypid = 1 THEN RETURN 29.0 - y
    RETURN y
ENDFUNC

' Camera shake, fed by falling stations and decaying per frame.
DIM shake = 0.0
DIM shake_x = 0
DIM shake_y = 0

FUNC PX(tx)
    RETURN INT(tx * TILE) + shake_x
ENDFUNC

FUNC PY(ty)
    RETURN INT(BOARD_Y0 + ty * TILE) + shake_y
ENDFUNC

FUNC MINE(owner)
    RETURN IIF(owner = mypid, 1, 0)
ENDFUNC

' A missing key yields NONE, and comparing NONE to a string reports TRUE -
' so check the type before trusting the phase.
FUNC ISOVER()
    IF have_state = 0 THEN RETURN 0
    IF TYPEOF(world{"PHASE"}) <> "STRING" THEN RETURN 0
    IF world{"PHASE"} = "over" THEN RETURN 1
    RETURN 0
ENDFUNC

' The server's cards.json is the source for stats, colors and icons; the
' hardcoded maps above stay as fallback when the fetch fails.
SUB LOADCARDS()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/cards")
        DIM m = JSON.PARSE$(r$)
        DIM cs = m{"CARDS"}
        allcards = cs
        cardorder = SORT(MAP.KEYS(cs))
        DIM ks = MAP.KEYS(cs)
        FOR EACH k$ IN ks
            cardcost{k$} = cs{k$}{"COST"}
            IF MAP.EXISTS(cs{k$}, "COLOR") THEN kindcolor{k$} = cs{k$}{"COLOR"}
        NEXT k$
    CATCH
    ENDTRY
ENDSUB

' Bake one sprite per card kind for both teams, plus the two station
' classes. Runs once - a few hundred milliseconds of array math.
SUB BAKEART()
    IF LEN(cardorder) > 0 THEN
        art_own = ART.BAKEALL(cardorder, 0)
        art_foe = ART.BAKEALL(cardorder, 1)
        art_ready = 1
    ENDIF
ENDSUB

' Menu button: rounded plate with a lighter top edge and a bright rim.
SUB BUTTON(x, y, w, h, label$, cr, cg, cb)
    DRAWCOLOR INT(cr * 0.45), INT(cg * 0.45), INT(cb * 0.45)
    ROUNDED_RECT x, y + 3, w, h, 12, TRUE
    DRAWCOLOR cr, cg, cb
    ROUNDED_RECT x, y, w, h, 12, TRUE
    DRAWCOLOR INT(cr * 0.35) + 160, INT(cg * 0.35) + 160, INT(cb * 0.35) + 160
    ROUNDED_RECT x, y, w, h, 12, FALSE
    ROUNDED_RECT x + 1, y + 1, w - 2, h - 2, 11, FALSE
    DRAWCOLOR 12, 14, 30
    TEXT x + w / 2 - LEN(label$) * 5, y + h / 2 - 9, label$
ENDSUB

' SPRITE.POS anchors the top-left corner, so blit through here to land a
' sprite on a centre point.
SUB SPRAT(sid, cx, cy)
    SPRITE.POS(sid, cx - SPRITE.WIDTH(sid) / 2, cy - SPRITE.HEIGHT(sid) / 2)
    SPRITE.DRAW(sid)
ENDSUB

' Star field: x, y, brightness, drift speed per star.
SUB MAKESTARS()
    stars = []
    DIM i
    FOR i = 1 TO 90
        DIM sx = RND() * SCR_W
        DIM sy = RND() * (SCR_H - BOARD_Y0)
        DIM sb = 70 + RND() * 150
        DIM sv = 0.15 + RND() * 0.5
        stars = APPEND(stars, [[sx, sy, sb, sv]])
    NEXT i
ENDSUB

FUNC ICON$(kind$)
    IF MAP.EXISTS(allcards, kind$) THEN
        IF MAP.EXISTS(allcards{kind$}, "ICON") THEN RETURN allcards{kind$}{"ICON"}
    ENDIF
    RETURN MID$(kind$, 0, 2)
ENDFUNC

FUNC CCOLOR(kind$)
    IF MAP.EXISTS(kindcolor, kind$) THEN RETURN kindcolor{kind$}
    RETURN [180, 180, 180]
ENDFUNC

' Trade name and PIN for a session token. Only needed when the client was
' started without one, which is the hand-started case.
SUB LOGIN()
    IF auth$ <> "" ORELSE mypin$ = "" THEN RETURN
    TRY
        DIM body$ = JSON.STRINGIFY$({ "NAME": myname$, "PIN": mypin$ })
        DIM r$ = HTTP.POST$(SRV$ + "/login", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            auth$ = m{"AUTH"}
            myname$ = m{"NAME"}
            msg$ = ""
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
        msg$ = "msg_login"
    ENDTRY
    mypin$ = ""
ENDSUB

SUB LOADPROFILE()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/profile?auth=" + auth$)
        DIM m = JSON.PARSE$(r$)
        ' a token the server no longer knows is worse than none: without
        ' this the menu keeps claiming you are signed in
        IF m{"OK"} <> 1 ANDALSO m{"MSG"} = "msg_login" THEN auth$ = ""
        IF m{"OK"} = 1 THEN
            myprofile = m{"PROFILE"}
            IF TYPEOF(myprofile{"DECKS"}) = "ARRAY" ANDALSO LEN(myprofile{"DECKS"}) > 0 THEN
                mydecks = myprofile{"DECKS"}
                deckidx = myprofile{"ACTIVE"}
                IF deckidx < 0 ORELSE deckidx >= LEN(mydecks) THEN deckidx = 0
                mydeck = COPYCARDS(mydecks[deckidx]{"CARDS"})
            ENDIF
        ENDIF
    CATCH
    ENDTRY
ENDSUB

' A fresh array, element by element. The + 0 copy trick is numbers only:
' on strings the addition is element-wise too and appends a "0" to every
' card name.
FUNC COPYCARDS(src)
    DIM out = []
    DIM z
    FOR z = 0 TO LEN(src) - 1
        out = APPEND(out, src[z])
    NEXT z
    RETURN out
ENDFUNC

' Keep the edit in its slot either way, but only send the set once every
' deck holds its six cards - the server rejects anything shorter.
SUB SAVEDECKS()
    IF LEN(mydecks) = 0 THEN RETURN
    mydecks[deckidx]{"CARDS"} = COPYCARDS(mydeck)
    DIM z
    FOR z = 0 TO LEN(mydecks) - 1
        IF LEN(mydecks[z]{"CARDS"}) <> 6 THEN RETURN
    NEXT z
    TRY
        DIM body$ = JSON.STRINGIFY$({ "AUTH": auth$, "DECKS": mydecks, "ACTIVE": deckidx })
        DIM r$ = HTTP.POST$(SRV$ + "/decks", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} <> 1 THEN msg$ = m{"MSG"}
    CATCH
    ENDTRY
ENDSUB

' Every player has the same three slots, so the tab number is the index.
' Without a profile the slots are built locally and the editor still works.
SUB FILLSLOTS()
    DIM i
    FOR i = LEN(mydecks) TO 2
        DIM fresh AS MAP = {}
        fresh{"NAME"} = "Deck " + STR$(i + 1)
        fresh{"CARDS"} = COPYCARDS(mydeck)
        mydecks = APPEND(mydecks, [fresh])
    NEXT i
ENDSUB

SUB PICKDECKSLOT(i)
    IF i < 0 ORELSE i > 2 THEN RETURN
    FILLSLOTS()
    IF i = deckidx THEN RETURN
    SAVEDECKS()
    deckidx = i
    mydeck = COPYCARDS(mydecks[deckidx]{"CARDS"})
    SAVEDECKS()
ENDSUB

' Collection entry {LVL, HAVE} for a card, defaulting to fresh.
FUNC MYCARD(kind$)
    IF MAP.EXISTS(myprofile, "CARDS") THEN
        IF MAP.EXISTS(myprofile{"CARDS"}, kind$) THEN RETURN myprofile{"CARDS"}{kind$}
    ENDIF
    RETURN { "LVL": 1, "HAVE": 0 }
ENDFUNC

FUNC MYWILD()
    IF MAP.EXISTS(myprofile, "WILD") THEN RETURN myprofile{"WILD"}
    RETURN 0
ENDFUNC

SUB SENDUPGRADE(kind$)
    TRY
        DIM body$ = JSON.STRINGIFY$({ "AUTH": auth$, "KIND": kind$ })
        DIM r$ = HTTP.POST$(SRV$ + "/upgrade", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            PLAYFX("SPAWN")
        ENDIF
        LOADPROFILE()
    CATCH
    ENDTRY
ENDSUB

FUNC DECKHAS(kind$)
    FOR EACH d$ IN mydeck
        IF d$ = kind$ THEN RETURN 1
    NEXT d$
    RETURN 0
ENDFUNC

SUB TOGGLECARD(kind$)
    IF DECKHAS(kind$) = 1 THEN
        DIM nd = []
        FOR EACH d$ IN mydeck
            IF d$ <> kind$ THEN nd = APPEND(nd, d$)
        NEXT d$
        mydeck = nd
    ELSEIF LEN(mydeck) < 6 THEN
        mydeck = APPEND(mydeck, kind$)
    ENDIF
ENDSUB

' Tally against exactly this opponent, straight off the match log.
SUB LOADH2H()
    h2h$ = ""
    IF foename$ = "" THEN RETURN
    TRY
        DIM m = JSON.PARSE$(HTTP.GET$(SRV$ + "/matches?limit=300"))
        IF m{"OK"} <> 1 THEN RETURN
        DIM mine = 0
        DIM theirs = 0
        DIM even = 0
        FOR EACH row IN m{"MATCHES"}
            DIM a$ = row{"A"}
            DIM b$ = row{"B"}
            DIM pair = 0
            IF a$ = myname$ ANDALSO b$ = foename$ THEN pair = 1
            IF a$ = foename$ ANDALSO b$ = myname$ THEN pair = 1
            IF pair = 1 THEN
                DIM w = row{"WINNER"}
                IF w = 2 THEN
                    even = even + 1
                ELSE
                    DIM won$ = b$
                    IF w = 0 THEN won$ = a$
                    IF won$ = myname$ THEN
                        mine = mine + 1
                    ELSE
                        theirs = theirs + 1
                    ENDIF
                ENDIF
            ENDIF
        NEXT row
        IF mine + theirs + even > 0 THEN
            h2h$ = T$("vs_record") + " " + MID$(foename$, 0, 9) + "  " + STR$(mine) + ":" + STR$(theirs)
            IF even > 0 THEN h2h$ = h2h$ + " (" + STR$(even) + ")"
        ENDIF
    CATCH
    ENDTRY
ENDSUB

' Nobody there? Let the server take the free seat.
SUB SENDBOT()
    TRY
        DIM body$ = JSON.STRINGIFY$({ "TOK": tok$, "ROOM": room$ })
        DIM r$ = HTTP.POST$(SRV$ + "/bot", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            msg$ = ""
            POLLSTATE()
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
    ENDTRY
ENDSUB

SUB WATCHROOM(key$)
    ' remember the room only on the way in, so a second call cannot
    ' overwrite it with one that is only being watched
    IF watching = 0 THEN prev_room$ = room$
    room$ = key$
    watching = 1
    uimode$ = "battle"
    mypid = 0
    tok$ = ""
    have_state = 0
    fxseen = {}
    fxact = []
    prev_tick = -1
    sel$ = ""
    drag_kind$ = ""
    emote_open = 0
    msg$ = ""
    POLLSTATE()
ENDSUB

SUB LEAVEWATCH()
    ' back to your own room, or GEFECHT would drop you into the one you
    ' were only watching
    IF prev_room$ <> "" THEN room$ = prev_room$
    watching = 0
    mypid = -1
    have_state = 0
    uimode$ = "menu"
    LOADPROFILE()
    LOADLOBBY()
ENDSUB

SUB JOINMATCH()
    TRY
        DIM r$ = HTTP.POST$(SRV$ + "/join", JSON.STRINGIFY$({ "AUTH": auth$, "DECK": mydeck, "ROOM": room$ }), "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            mypid = m{"PID"}
            tok$ = m{"TOK"}
            msg$ = ""
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
        msg$ = "server? " + SRV$
    ENDTRY
ENDSUB

' id -> heading in degrees, tracked from the position deltas between
' polls so ships point where they fly. Figures are drawn facing up, so
' the sprite angle is the travel angle plus a quarter turn.
DIM heads AS MAP = {}
DIM lastpos AS MAP = {}

SUB TRACKHEADING()
    FOR EACH u IN world{"UNITS"}
        DIM k$ = STR$(u{"ID"})
        DIM wx = u{"X"}
        DIM wy = WY(u{"Y"})
        IF MAP.EXISTS(lastpos, k$) THEN
            DIM dx = wx - lastpos{k$}[0]
            DIM dy = wy - lastpos{k$}[1]
            IF dx * dx + dy * dy > 0.0004 THEN
                heads{k$} = ATAN2(dy, dx) * 180.0 / 3.14159265 + 90.0
            ENDIF
        ELSE
            ' fresh unit: face the enemy side
            heads{k$} = IIF(MINE(u{"OWNER"}) = 1, 0.0, 180.0)
        ENDIF
        lastpos{k$} = [wx, wy]
    NEXT u
ENDSUB

FUNC HEADOF(u)
    DIM k$ = STR$(u{"ID"})
    IF MAP.EXISTS(heads, k$) THEN RETURN heads{k$}
    RETURN IIF(MINE(u{"OWNER"}) = 1, 0.0, 180.0)
ENDFUNC

DIM prev_tick = -1
SUB POLLSTATE()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/state?room=" + room$ + "&tok=" + tok$)
        DIM m = JSON.PARSE$(r$)
        world = m{"ST"}
        waiting = m{"WAITING"}
        have_state = 1
        DIM names = m{"NAMES"}
        IF LEN(names) = 2 THEN
            foename$ = names[1 - mypid]
            IF watching = 1 THEN
                myname$ = names[0]
                foename$ = names[1]
            ENDIF
        ENDIF
        IF MAP.EXISTS(m, "PROFILES") THEN profiles = m{"PROFILES"}
        TRACKHEADING()
        ' fetch the fresh chest once when the match ends
        IF ISOVER() = 1 ANDALSO chest_shown = 0 ANDALSO watching = 0 THEN
            chest_shown = 1
            LOADPROFILE()
            LOADH2H()
        ENDIF
        ' a rematch restarts event ids - drop stale FX bookkeeping
        IF world{"TICKNO"} < prev_tick THEN
            fxseen = {}
            fxact = []
            sel$ = ""
            chest_shown = 0
            h2h$ = ""
        ENDIF
        prev_tick = world{"TICKNO"}
    CATCH
        msg$ = "msg_pollfail"
    ENDTRY
ENDSUB

SUB SENDREMATCH()
    TRY
        DIM r$ = HTTP.POST$(SRV$ + "/rematch", JSON.STRINGIFY$({ "ROOM": room$ }), "text/plain")
        msg$ = ""
    CATCH
        msg$ = "msg_rematchfail"
    ENDTRY
ENDSUB

SUB SENDPLAY(kind$, wx, wyv)
    TRY
        DIM body$ = JSON.STRINGIFY$({ "TOK": tok$, "KIND": kind$, "X": wx, "Y": wyv, "ROOM": room$ })
        DIM r$ = HTTP.POST$(SRV$ + "/play", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            sel$ = ""
            msg$ = ""
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
        msg$ = "msg_playfail"
    ENDTRY
ENDSUB

' Retro synth SFX on the built-in sequencer. Track 1 = UI blips, track 2 =
' shots, track 3 = noise booms. Sustain 0 lets every note fade out on its
' own, so no release bookkeeping is needed in the render loop.
' snd_on says the audio device is up; the two switches gate what plays.
DIM snd_on = 0
DIM sfx_on = 1
DIM mus_on = 1
DIM lobby = []

SUB LOADLOBBY()
    TRY
        DIM m = JSON.PARSE$(HTTP.GET$(SRV$ + "/rooms"))
        IF m{"OK"} = 1 THEN lobby = m{"ROOMS"}
    CATCH
    ENDTRY
ENDSUB

SUB SNDINIT()
    TRY
        SOUND.INIT
        SOUND.VOICE 1, "SQUARE", 0.005, 0.08, 0.0, 0.05
        SOUND.VOICE 2, "SQUARE", 0.002, 0.05, 0.0, 0.03
        SOUND.VOICE 3, "NOISE", 0.005, 0.25, 0.0, 0.2
        SOUND.GAIN 1, 0.5
        SOUND.GAIN 2, 0.3
        SOUND.GAIN 3, 0.6
        snd_on = 1
    CATCH
        snd_on = 0
    ENDTRY
ENDSUB

' Music: a two-bar bass riff with an arpeggio on top, stepped from the
' render loop. Overtime switches to the tense pattern.
DIM mus_step = 0
DIM mus_bass = ["A1", "A1", "C2", "A1", "F1", "F1", "G1", "G1"]
DIM mus_arp = ["A3", "E4", "A4", "C5", "E4", "A4", "G4", "E4"]
DIM mus_arp_ot = ["A3", "C5", "E5", "C5", "A4", "C5", "F5", "E5"]

SUB MUSICINIT()
    IF snd_on = 1 ANDALSO sfx_on = 1 THEN
        TRY
            ' Every voice is percussive (sustain 0) on purpose: a held note
            ' occupies its slot until something releases it, and nothing
            ' here ever does - a sustaining bass would fill the pool in
            ' half a minute and silence the whole mix. A long decay gives
            ' the bass its body instead.
            SOUND.VOICE 4, "TRIANGLE", 0.01, 0.55, 0.0, 0.20
            SOUND.VOICE 5, "SQUARE", 0.005, 0.10, 0.0, 0.10
            SOUND.GAIN 4, 0.22
            SOUND.GAIN 5, 0.10
        CATCH
        ENDTRY
    ENDIF
ENDSUB

SUB MUSICSTEP(fnow)
    IF snd_on = 1 ANDALSO mus_on = 1 ANDALSO have_state = 1 ANDALSO waiting = 0 ANDALSO ISOVER() = 0 THEN
        ' one step per ~0.27 s at 30 fps
        IF fnow MOD 8 = 0 THEN
            DIM sidx = mus_step MOD 8
            TRY
                IF sidx MOD 2 = 0 THEN SOUND.PLAY 4, mus_bass[sidx]
                IF world{"T_LEFT"} < 0 THEN
                    SOUND.PLAY 5, mus_arp_ot[sidx]
                ELSE
                    SOUND.PLAY 5, mus_arp[sidx]
                ENDIF
            CATCH
                snd_on = 0
            ENDTRY
            mus_step = mus_step + 1
        ENDIF
    ENDIF
ENDSUB

' Six faces drawn from discs and strokes, so they need no emoji font and
' match the geometric look of the ships.
SUB DrawEmoteFace(cx, cy, r, id)
    DIM col = emote_col[id]
    DRAWCOLOR INT(col[0] * 0.35), INT(col[1] * 0.35), INT(col[2] * 0.35)
    CIRCLE cx, cy, r, TRUE
    DRAWCOLOR col[0], col[1], col[2]
    CIRCLE cx, cy, r, FALSE
    DIM ex = INT(r * 0.38)
    DIM ey = cy - INT(r * 0.25)
    DIM m = cy + INT(r * 0.34)
    IF id = 4 THEN
        ' asleep: two closed lids and a drifting z
        LINE cx - ex - 3, ey, cx - ex + 3, ey
        LINE cx + ex - 3, ey, cx + ex + 3, ey
        TEXT cx + INT(r * 0.45), cy - r - 4, "z"
    ELSE
        CIRCLE cx - ex, ey, 2, TRUE
        CIRCLE cx + ex, ey, 2, TRUE
    ENDIF
    IF id = 3 THEN
        ' angry: brows down toward the nose
        LINE cx - ex - 4, ey - 7, cx - ex + 4, ey - 3
        LINE cx + ex + 4, ey - 7, cx + ex - 4, ey - 3
    ENDIF
    IF id = 0 THEN
        LINE cx - ex, m - 2, cx - 2, m + 3
        LINE cx - 2, m + 3, cx + 2, m + 3
        LINE cx + 2, m + 3, cx + ex, m - 2
    ELSEIF id = 1 THEN
        ' laughing: an open mouth filled in
        DIM w
        FOR w = 0 TO 3
            LINE cx - ex + w, m - 1 + w, cx + ex - w, m - 1 + w
        NEXT w
    ELSEIF id = 2 THEN
        CIRCLE cx, m, INT(r * 0.28), FALSE
    ELSEIF id = 3 THEN
        LINE cx - ex, m + 3, cx - 2, m - 2
        LINE cx - 2, m - 2, cx + 2, m - 2
        LINE cx + 2, m - 2, cx + ex, m + 3
    ELSEIF id = 4 THEN
        LINE cx - 4, m, cx + 4, m
    ELSE
        ' cheeky: a grin with the tongue out
        LINE cx - ex, m - 2, cx + ex, m - 2
        DRAWCOLOR 255, 120, 170
        ROUNDED_RECT cx - 4, m - 1, 8, 7, 3, TRUE
    ENDIF
ENDSUB

SUB SENDEMOTE(id)
    TRY
        DIM body$ = JSON.STRINGIFY$({ "TOK": tok$, "ID": id, "ROOM": room$ })
        DIM r$ = HTTP.POST$(SRV$ + "/emote", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} <> 1 THEN msg$ = m{"MSG"}
    CATCH
    ENDTRY
    emote_open = 0
ENDSUB

SUB PLAYFX(t$)
    IF snd_on = 1 ANDALSO sfx_on = 1 THEN
        TRY
            IF t$ = "SPAWN" THEN
                SOUND.PLAY 1, 330
            ELSEIF t$ = "SHOT" THEN
                SOUND.PLAY 2, 880
            ELSEIF t$ = "HIT" THEN
                SOUND.PLAY 2, 220
            ELSEIF t$ = "CAST" THEN
                SOUND.PLAY 1, 550
            ELSEIF t$ = "BOOM" THEN
                SOUND.PLAY 3, 80
            ELSEIF t$ = "DIE" THEN
                SOUND.PLAY 3, 200
            ELSEIF t$ = "FALL" THEN
                SOUND.PLAY 3, 50
            ELSEIF t$ = "EMOTE" THEN
                SOUND.PLAY 1, 660
            ENDIF
        CATCH
            snd_on = 0
        ENDTRY
    ENDIF
ENDSUB

' HP bar with a health gradient: green, then yellow, then red.
SUB DrawBar(x, y, w, frac)
    DRAWCOLOR 20, 20, 20
    RECT x, y, w, 5, TRUE
    IF frac > 0 THEN
        IF frac > 0.5 THEN
            DRAWCOLOR 90, 240, 90
        ELSEIF frac > 0.2 THEN
            DRAWCOLOR 240, 210, 60
        ELSE
            DRAWCOLOR 240, 70, 50
        ENDIF
        RECT x, y, INT(w * frac), 5, TRUE
    ENDIF
ENDSUB

' Collect unseen sim events into the local FX list (dedup by EID) and give
' each fresh event its sound - shots capped at 2 per batch to avoid spam.
SUB SYNCFX(fnow)
    IF have_state = 1 THEN
        DIM n_shots = 0
        FOR EACH evt IN world{"EVENTS"}
            DIM k$ = STR$(evt{"EID"})
            IF NOT MAP.EXISTS(fxseen, k$) THEN
                fxseen{k$} = 1
                fxact = APPEND(fxact, { "EV": evt, "T0": fnow })
                IF evt{"T"} = "SHOT" THEN
                    n_shots = n_shots + 1
                    IF n_shots <= 2 THEN PLAYFX("SHOT")
                ELSE
                    PLAYFX(evt{"T"})
                ENDIF
                IF evt{"T"} = "FALL" THEN shake = 14.0
                IF evt{"T"} = "BOOM" THEN shake = 6.0
            ENDIF
        NEXT evt
    ENDIF
ENDSUB

SUB DrawFX(fnow)
    DIM keep = []
    FOR EACH fx IN fxact
        DIM evt = fx{"EV"}
        DIM t$ = evt{"T"}
        DIM age = fnow - fx{"T0"}
        DIM dur = 8
        IF t$ = "BOOM" THEN dur = 14
        IF t$ = "CAST" THEN dur = 15
        IF t$ = "FALL" THEN dur = 22
        IF t$ = "HIT" THEN dur = 6
        IF t$ = "DIE" THEN dur = 10
        IF t$ = "EMOTE" THEN dur = 70
        IF age <= dur THEN
            DIM p = age / (dur * 1.0)
            DIM ex = PX(evt{"X"})
            DIM ey = PY(WY(evt{"Y"}))
            IF t$ = "EMOTE" THEN
                ' a bubble over the sender's base, rising and fading out
                DIM lift = INT(p * 14)
                DIM by = ey - 26 - lift
                DRAWCOLOR 18, 20, 44
                ROUNDED_RECT ex - 26, by - 24, 52, 48, 14, TRUE
                DIM ec = emote_col[evt{"ID"}]
                DRAWCOLOR ec[0], ec[1], ec[2]
                ROUNDED_RECT ex - 26, by - 24, 52, 48, 14, FALSE
                LINE ex - 6, by + 24, ex, by + 32
                LINE ex, by + 32, ex + 6, by + 24
                DrawEmoteFace(ex, by, 17, evt{"ID"})
            ELSEIF t$ = "SHOT" THEN
                DIM sx0 = PX(evt{"FX"})
                DIM sy0 = PY(WY(evt{"FY"}))
                DIM x1 = sx0 + INT((ex - sx0) * p)
                DIM y1 = sy0 + INT((ey - sy0) * p)
                ' muzzle flash at the shooter, then a bolt with a trail
                IF p < 0.35 THEN
                    DRAWCOLOR 255, 240, 190
                    CIRCLE sx0, sy0, INT(9 - p * 20), TRUE
                ENDIF
                DRAWCOLOR 190, 160, 90
                LINE sx0 + INT((ex - sx0) * (p - 0.25)), sy0 + INT((ey - sy0) * (p - 0.25)), x1, y1
                DRAWCOLOR 255, 255, 160
                CIRCLE x1, y1, 3, TRUE
                IF p > 0.7 THEN
                    DRAWCOLOR 255, 255, 255
                    TEXT ex + 8, ey - 14 - INT(p * 10), STR$(evt{"D"})
                ENDIF
            ELSEIF t$ = "CAST" THEN
                DIM x2 = PX(evt{"FX"}) + INT((ex - PX(evt{"FX"})) * p)
                DIM y2 = PY(WY(evt{"FY"})) + INT((ey - PY(WY(evt{"FY"}))) * p)
                DRAWCOLOR 255, 140, 30
                CIRCLE x2, y2, 7, TRUE
                DRAWCOLOR 255, 220, 90
                CIRCLE x2, y2, 4, TRUE
            ELSEIF t$ = "BOOM" THEN
                DRAWCOLOR 255, 120, 30
                CIRCLE ex, ey, INT(6 + p * evt{"RADIUS"} * TILE), FALSE
                DRAWCOLOR 255, 200, 60
                CIRCLE ex, ey, INT(3 + p * evt{"RADIUS"} * TILE * 0.7), FALSE
                DRAWCOLOR 255, 255, 255
                TEXT ex - 12, ey - 24 - INT(p * 14), STR$(evt{"D"})
            ELSEIF t$ = "HIT" THEN
                DIM s = 4 + INT(p * 6)
                DRAWCOLOR 255, 240, 120
                LINE ex - s, ey - s, ex + s, ey + s
                LINE ex - s, ey + s, ex + s, ey - s
                LINE ex - s, ey, ex + s, ey
                DRAWCOLOR 255, 255, 255
                TEXT ex + 8, ey - 14 - INT(p * 12), STR$(evt{"D"})
            ELSEIF t$ = "DIE" THEN
                DRAWCOLOR 200, 200, 200
                CIRCLE ex, ey, INT(4 + p * 14), FALSE
            ELSEIF t$ = "SPAWN" THEN
                DRAWCOLOR 255, 255, 255
                CIRCLE ex, ey, INT(16 - p * 12), FALSE
            ELSEIF t$ = "FALL" THEN
                DRAWCOLOR 255, 160, 40
                CIRCLE ex, ey, INT(8 + p * 40), FALSE
                DRAWCOLOR 120, 120, 120
                CIRCLE ex, ey, INT(4 + p * 26), FALSE
            ENDIF
            keep = APPEND(keep, fx)
        ENDIF
    NEXT fx
    fxact = keep
ENDSUB

' Deep space: near-black field, drifting stars, a nebula belt where the
' river used to be and two lit gates standing in for the bridges.
SUB DrawBoard(fnow)
    DRAWCOLOR 6, 8, 22
    RECT 0, BOARD_Y0, SCR_W, SCR_H - BOARD_Y0, TRUE

    FOR EACH st2 IN stars
        DIM sy = st2[1] + fnow * st2[3]
        sy = sy MOD (SCR_H - BOARD_Y0)
        DIM sb = st2[2]
        DRAWCOLOR sb, sb, INT(sb * 0.8) + 40
        PSET INT(st2[0]), BOARD_Y0 + INT(sy)
    NEXT st2

    ' nebula belt, brightest in its middle rows
    DIM r
    FOR r = 13 TO 16
        DIM fade = 1.0 - ABS(r - 14.5) / 2.4
        DIM pulse = 0.75 + 0.25 * SIN(fnow * 0.06 + r)
        DRAWCOLOR INT(30 + 45 * fade * pulse), INT(20 + 30 * fade * pulse), INT(70 + 90 * fade * pulse)
        RECT 0, PY(r), SCR_W, TILE, TRUE
    NEXT r

    ' warp gates on the old bridge lanes: two lit pillars with an energy
    ' curtain drifting between them
    DIM gh = INT(TILE * 2.8)
    DIM gy = PY(13.6)
    DIM gx
    FOR EACH gx IN [2.5, 13.5]
        DIM gl = PX(gx)
        DIM gr = gl + TILE * 2
        DIM curt
        FOR curt = 0 TO 4
            DIM cy2 = gy + ((curt * 15 + INT(fnow * 1.6)) MOD (gh - 6))
            DRAWCOLOR 60, 150, 210
            LINE gl + 7, cy2, gr - 7, cy2
        NEXT curt
        DRAWCOLOR 120, 235, 255
        ROUNDED_RECT gl - 1, gy, 7, gh, 3, TRUE
        ROUNDED_RECT gr - 6, gy, 7, gh, 3, TRUE
        DRAWCOLOR 210, 250, 255
        ROUNDED_RECT gl + 1, gy + 3, 3, gh - 6, 1, TRUE
        ROUNDED_RECT gr - 4, gy + 3, 3, gh - 6, 1, TRUE
    NEXT gx
ENDSUB

' station key -> last seen hull and remaining flash frames
DIM twhp AS MAP = {}
DIM twflash AS MAP = {}

' Stations: the baked sprite, mirrored so an enemy base faces the player.
' A sleeping mothership is dimmed and keeps its Zz.
SUB DrawTowers()
    FOR EACH tw IN world{"TOWERS"}
        IF tw{"HP"} <= 0 THEN CONTINUEFOR
        DIM asleep = 0
        IF tw{"KIND"} = "KING" ANDALSO tw{"AWAKE"} = 0 THEN asleep = 1
        DIM mine = MINE(tw{"OWNER"})
        DIM sid = art_foe{tw{"KIND"}}
        IF mine = 1 THEN sid = art_own{tw{"KIND"}}
        DIM cx = PX(tw{"X"})
        DIM cy = PY(WY(tw{"Y"}))
        SPRITE.FLIP(sid, FALSE, mine = 0)
        SPRITE.ROTATE(sid, 0)
        SPRITE.ALPHA(sid, IIF(asleep = 1, 130, 255))
        SPRAT(sid, cx, cy)
        ' white shield flash while this station is losing hull
        DIM tk$ = STR$(tw{"OWNER"}) + tw{"KIND"} + STR$(INT(tw{"X"}))
        IF MAP.EXISTS(twhp, tk$) THEN
            IF tw{"HP"} < twhp{tk$} THEN twflash{tk$} = 4
        ENDIF
        twhp{tk$} = tw{"HP"}
        IF MAP.EXISTS(twflash, tk$) THEN
            IF twflash{tk$} > 0 THEN
                twflash{tk$} = twflash{tk$} - 1
                DRAWCOLOR 255, 255, 255
                CIRCLE cx, cy, 24 + twflash{tk$} * 3, FALSE
                CIRCLE cx, cy, 23 + twflash{tk$} * 3, FALSE
            ENDIF
        ENDIF
        IF asleep = 1 THEN
            DRAWCOLOR 220, 220, 240
            TEXT cx + 14, cy - 30, "Zz"
        ENDIF
        ' own stations carry their bar below the hull, enemy ones above -
        ' each sits on the side facing its owner
        DIM bary = cy - 30
        IF mine = 1 THEN bary = cy + 26
        DrawBar(cx - TILE, bary, TILE * 2, tw{"HP"} / tw{"MAXHP"})
    NEXT tw
ENDSUB

' Ships: baked sprite per kind and team, flipped to face the enemy side,
' nudged toward the target for two ticks after a strike.
SUB DrawUnits()
    FOR EACH u IN world{"UNITS"}
        DIM mine = MINE(u{"OWNER"})
        DIM ux = PX(u{"X"})
        DIM uy = PY(WY(u{"Y"}))
        IF MAP.EXISTS(u, "AT") THEN
            IF world{"TICKNO"} - u{"AT"} <= 2 THEN
                DIM lgy = u{"ADY"}
                IF mypid = 1 THEN lgy = -lgy
                ux = ux + INT(u{"ADX"} * 5)
                uy = uy + INT(lgy * 5)
            ENDIF
        ENDIF
        DIM kind$ = u{"KIND"}
        IF art_ready = 1 ANDALSO MAP.EXISTS(art_own, kind$) THEN
            DIM sid = art_foe{kind$}
            IF mine = 1 THEN sid = art_own{kind$}
            SPRITE.FLIP(sid, FALSE, FALSE)
            ' anchored defences keep their bearing, ships bank into theirs
            IF MAP.EXISTS(u, "BUILD") THEN
                SPRITE.ROTATE(sid, IIF(mine = 1, 0, 180))
            ELSE
                SPRITE.ROTATE(sid, HEADOF(u))
            ENDIF
            SPRAT(sid, ux, uy)
            SPRITE.ROTATE(sid, 0)
            ' a stasis lock reads as a pulsing cyan cage
            IF MAP.EXISTS(u, "STUN") THEN
                IF u{"STUN"} > 0 THEN
                    DRAWCOLOR 120, 255, 245
                    CIRCLE ux, uy, 15 + INT(2 * SIN(frame * 0.4)), FALSE
                    CIRCLE ux, uy, 14 + INT(2 * SIN(frame * 0.4)), FALSE
                    LINE ux - 15, uy, ux + 15, uy
                    LINE ux, uy - 15, ux, uy + 15
                ENDIF
            ENDIF
        ELSE
            DIM col = kindcolor{kind$}
            DRAWCOLOR col[0], col[1], col[2]
            CIRCLE ux, uy, 9, TRUE
        ENDIF
        DrawBar(ux - 10, uy - 20, 20, u{"HP"} / u{"MAXHP"})
    NEXT u
ENDSUB

' Chest contents as a row of rounded chips, wildcards in gold.
SUB CHESTROW(chest, x, y)
    DIM i
    FOR i = 0 TO LEN(chest) - 1
        DIM cc$ = chest[i]
        DIM cx = x + i * 48
        IF cc$ = "*" THEN
            DRAWCOLOR 150, 115, 20
            ROUNDED_RECT cx, y, 42, 40, 9, TRUE
            DRAWCOLOR 255, 220, 90
            ROUNDED_RECT cx, y, 42, 40, 9, FALSE
            TEXT cx + 16, y + 11, "*"
        ELSE
            DIM col = CCOLOR(cc$)
            DRAWCOLOR INT(col[0] * 0.4), INT(col[1] * 0.4), INT(col[2] * 0.4)
            ROUNDED_RECT cx, y, 42, 40, 9, TRUE
            DRAWCOLOR col[0], col[1], col[2]
            ROUNDED_RECT cx, y, 42, 40, 9, FALSE
            DRAWCOLOR 245, 250, 255
            TEXT cx + 8, y + 11, ICON$(cc$)
        ENDIF
    NEXT i
ENDSUB

' Own half plus the quadrant a fallen enemy princess opened up. Mirroring
' puts the own half at the bottom for both players, so the unlocked strip
' is always the ten rows above it - only its side follows the dead tower.
SUB DrawDeployZone()
    DRAWCOLOR 255, 255, 0
    RECT 0, PY(16), SCR_W, TILE * 14, FALSE
    FOR EACH tw IN world{"TOWERS"}
        IF tw{"OWNER"} = mypid ORELSE tw{"KIND"} <> "PRINCESS" ORELSE tw{"HP"} > 0 THEN CONTINUEFOR
        DIM zx = 0
        IF tw{"X"} >= 9 THEN zx = PX(9)
        RECT zx, PY(6), PX(9), TILE * 10, FALSE
        RECT zx + 1, PY(6) + 1, PX(9) - 2, TILE * 10 - 2, FALSE
    NEXT tw
ENDSUB

' Ghost of the dragged ship under the finger, green where it may land,
' red where the drop would be refused.
SUB DrawGhost(fnow)
    IF drag_kind$ <> "" ANDALSO ptr_y < 840 ANDALSO ptr_y >= BOARD_Y0 THEN
        ' mirroring puts the own half at the bottom for both players, so the
        ' test runs on screen rows - same space the zone outline uses
        DIM srow = (ptr_y - BOARD_Y0) / (TILE * 1.0)
        DIM okdrop = 0
        IF srow >= 16 THEN okdrop = 1
        FOR EACH tw IN world{"TOWERS"}
            IF tw{"OWNER"} = mypid ORELSE tw{"KIND"} <> "PRINCESS" ORELSE tw{"HP"} > 0 THEN CONTINUEFOR
            DIM sameside = 0
            IF tw{"X"} < 9 ANDALSO ptr_x < PX(9) THEN sameside = 1
            IF tw{"X"} >= 9 ANDALSO ptr_x >= PX(9) THEN sameside = 1
            IF sameside = 1 ANDALSO srow >= 6 THEN okdrop = 1
        NEXT tw
        IF MAP.EXISTS(cardcost, drag_kind$) THEN
            IF world{"ELIXIR"}[mypid] < cardcost{drag_kind$} THEN okdrop = 0
        ENDIF
        IF okdrop = 1 THEN
            DRAWCOLOR 90, 250, 140
        ELSE
            DRAWCOLOR 255, 80, 90
        ENDIF
        DIM pulse = 20 + INT(4 * SIN(fnow * 0.3))
        CIRCLE ptr_x, ptr_y, pulse, FALSE
        CIRCLE ptr_x, ptr_y, pulse - 1, FALSE
        IF art_ready = 1 ANDALSO MAP.EXISTS(art_own, drag_kind$) THEN
            DIM gid = art_own{drag_kind$}
            SPRITE.ALPHA(gid, 165)
            SPRITE.ROTATE(gid, 0)
            SPRAT(gid, ptr_x, ptr_y)
            SPRITE.ALPHA(gid, 255)
        ENDIF
    ENDIF
ENDSUB

SUB DrawMenu()
    DRAWCOLOR 8, 8, 20
    RECT 0, 0, SCR_W, SCR_H, TRUE
    FOR EACH st3 IN stars
        DIM mb = st3[2]
        DRAWCOLOR mb, mb, INT(mb * 0.8) + 40
        PSET INT(st3[0]), INT(st3[1])
    NEXT st3
    DRAWCOLOR 60, 240, 255
    TEXT 150, 120, "jdVOID"
    DRAWCOLOR 190, 110, 255
    TEXT 122, 156, T$("tagline")
    DRAWCOLOR 200, 200, 210
    IF auth$ = "" THEN
        DRAWCOLOR 255, 120, 120
        TEXT 60, 196, T$("not_signed_in")
    ELSE
        TEXT 130, 196, T$("player") + ": " + myname$
    ENDIF
    IF MAP.EXISTS(myprofile, "LASTCHEST") THEN
        DIM played = myprofile{"WINS"} + myprofile{"LOSSES"} + myprofile{"DRAWS"}
        DIM head$ = T$("chest_last")
        IF played = 0 THEN head$ = T$("chest_start")
        DRAWCOLOR 22, 24, 48
        ROUNDED_RECT 14, 222, 440, 92, 14, TRUE
        DRAWCOLOR 120, 110, 200
        ROUNDED_RECT 14, 222, 440, 92, 14, FALSE
        DRAWCOLOR 255, 220, 90
        TEXT 26, 230, head$ + "   " + T$("joker") + " x" + STR$(MYWILD())
        CHESTROW(myprofile{"LASTCHEST"}, 26, 260)
    ENDIF
    BUTTON(134, 330, 200, 56, T$("battle"), 80, 210, 120)
    BUTTON(134, 396, 200, 56, T$("deck"), 90, 160, 240)
    BUTTON(24, 462, 200, 44, IIF(mus_on = 1, T$("music_on"), T$("music_off")), 150, 150, 180)
    BUTTON(244, 462, 200, 44, IIF(sfx_on = 1, T$("sfx_on"), T$("sfx_off")), 150, 150, 180)

    ' lobby: the open rooms with their occupancy, tap to switch
    DRAWCOLOR 22, 24, 48
    ROUNDED_RECT 14, 522, 440, 250, 14, TRUE
    DRAWCOLOR 120, 110, 200
    ROUNDED_RECT 14, 522, 440, 250, 14, FALSE
    DRAWCOLOR 190, 200, 235
    TEXT 26, 530, T$("rooms_open") + "   [ " + room$ + " ]"
    DIM li
    FOR li = 0 TO LEN(lobby) - 1
        IF li > 4 THEN EXITFOR
        DIM rr = lobby[li]
        DIM ry = 562 + li * 40
        DIM st$ = T$("room_free")
        IF rr{"N"} = 1 THEN st$ = T$("room_waiting")
        IF rr{"N"} >= 2 THEN st$ = T$("room_full")
        IF rr{"KEY"} = room$ THEN
            DRAWCOLOR 45, 60, 110
        ELSE
            DRAWCOLOR 30, 34, 62
        ENDIF
        ROUNDED_RECT 24, ry, 420, 34, 8, TRUE
        DRAWCOLOR 120, 130, 190
        ROUNDED_RECT 24, ry, 420, 34, 8, FALSE
        DRAWCOLOR 230, 235, 255
        TEXT 36, ry + 8, MID$(rr{"KEY"}, 0, 14)
        DRAWCOLOR 150, 220, 160
        IF rr{"N"} >= 2 THEN DRAWCOLOR 240, 150, 150
        TEXT 230, ry + 8, STR$(rr{"N"}) + "/2 " + st$
        ' a running match can be followed without taking a seat
        IF rr{"LIVE"} = 1 THEN
            DRAWCOLOR 40, 90, 70
            ROUNDED_RECT 344, ry + 4, 94, 26, 8, TRUE
            DRAWCOLOR 120, 240, 190
            ROUNDED_RECT 344, ry + 4, 94, 26, 8, FALSE
            TEXT 356, ry + 9, T$("watch")
        ENDIF
    NEXT li
ENDSUB

' Card sheet: everything the sim knows about a card, at its own level.
DIM info_kind$ = ""

SUB DrawCardInfo()
    IF info_kind$ = "" THEN RETURN
    DIM k$ = info_kind$
    DIM c = allcards{k$}
    DIM mc = MYCARD(k$)
    DIM mult = 1.0 + (mc{"LVL"} - 1) * 0.08
    DIM col = CCOLOR(k$)

    DRAWCOLOR 4, 5, 14
    RECT 0, 0, SCR_W, SCR_H, TRUE
    FOR EACH st4 IN stars
        DIM ib = st4[2]
        DRAWCOLOR ib, ib, INT(ib * 0.8) + 40
        PSET INT(st4[0]), INT(st4[1])
    NEXT st4

    DRAWCOLOR 16, 18, 40
    ROUNDED_RECT 24, 120, 420, 620, 18, TRUE
    DRAWCOLOR col[0], col[1], col[2]
    ROUNDED_RECT 24, 120, 420, 620, 18, FALSE
    ROUNDED_RECT 26, 122, 416, 616, 16, FALSE

    IF art_ready = 1 ANDALSO MAP.EXISTS(art_own, k$) THEN
        SPRITE.ROTATE(art_own{k$}, 0)
        SPRAT(art_own{k$}, 380, 190)
    ENDIF
    DRAWCOLOR col[0], col[1], col[2]
    TEXT 48, 148, k$
    DRAWCOLOR 190, 200, 235
    TEXT 48, 182, "Lv" + STR$(mc{"LVL"}) + "   " + ICON$(k$)
    ELIXCOIN(300, 160, 16, STR$(c{"COST"}))

    DIM y = 236
    DRAWCOLOR 150, 160, 200
    DIM words = SPLIT(T$("desc_" + k$), " ")
    DIM row$ = ""
    FOR EACH w$ IN words
        IF LEN(row$) + LEN(w$) + 1 > 36 THEN
            TEXT 48, y, row$
            y = y + 26
            row$ = w$
        ELSE
            IF row$ = "" THEN
                row$ = w$
            ELSE
                row$ = row$ + " " + w$
            ENDIF
        ENDIF
    NEXT w$
    IF row$ <> "" THEN
        TEXT 48, y, row$
        y = y + 26
    ENDIF

    y = y + 28
    IF MAP.EXISTS(c, "SPELL") THEN
        IF MAP.EXISTS(c, "STUN") THEN
            STATLINE(y, T$("stat_stun"), STR$(c{"STUN"}) + " " + T$("sec"))
            STATLINE(y + 38, T$("stat_radius"), STR$(c{"RADIUS"}) + " " + T$("tiles"))
        ELSE
            STATLINE(y, T$("stat_dmg"), STR$(INT(c{"DMG"} * mult)))
            STATLINE(y + 38, T$("stat_radius"), STR$(c{"RADIUS"}) + " " + T$("tiles"))
        ENDIF
    ELSE
        STATLINE(y, T$("stat_hp"), STR$(INT(c{"HP"} * mult)))
        STATLINE(y + 38, T$("stat_dmg"), STR$(INT(c{"DMG"} * mult)))
        STATLINE(y + 76, T$("stat_dps"), STR$(INT(c{"DMG"} * mult / c{"HITSPEED"})))
        STATLINE(y + 114, T$("stat_range"), STR$(c{"REACH"}) + " " + T$("tiles"))
        STATLINE(y + 152, T$("stat_speed"), STR$(c{"SPD"}))
        STATLINE(y + 190, T$("stat_count"), STR$(c{"N"}))
        DIM tgt$ = T$("air_ground")
        IF c{"HITS"} = "A" THEN tgt$ = T$("air_both")
        IF c{"ONLYTOWERS"} = 1 THEN tgt$ = T$("only_towers")
        STATLINE(y + 228, T$("stat_air"), tgt$)
        DIM yy = y + 266
        IF MAP.EXISTS(c, "SPAWNS") THEN
            STATLINE(yy, T$("stat_spawn"), STR$(c{"SPAWNRATE"}) + " " + T$("sec"))
            yy = yy + 38
        ENDIF
        IF MAP.EXISTS(c, "TTL") THEN
            STATLINE(yy, T$("stat_life"), STR$(INT(c{"TTL"})) + " " + T$("sec"))
            yy = yy + 38
        ENDIF
        DRAWCOLOR 120, 240, 255
        IF c{"FLY"} = 1 THEN
            TEXT 48, yy, "* " + T$("flying")
        ELSEIF MAP.EXISTS(c, "BUILD") THEN
            TEXT 48, yy, "* " + T$("building")
        ENDIF
    ENDIF

    DRAWCOLOR 190, 200, 235
    TEXT 48, 690, STR$(mc{"HAVE"}) + "/" + STR$(INT(2 ^ mc{"LVL"})) + "   " + T$("joker") + " x" + STR$(MYWILD())
    BUTTON(134, 756, 200, 50, T$("close"), 150, 150, 180)
ENDSUB

SUB STATLINE(y, label$, val$)
    DRAWCOLOR 120, 130, 175
    TEXT 48, y, label$
    DRAWCOLOR 235, 242, 255
    TEXT 250, y, val$
ENDSUB

SUB DrawDeckEd()
    DRAWCOLOR 15, 15, 20
    RECT 0, 0, SCR_W, SCR_H, TRUE
    DRAWCOLOR 255, 220, 60
    IF auth$ = "" THEN
        DRAWCOLOR 255, 120, 120
        TEXT 40, 12, T$("not_signed_in")
        DRAWCOLOR 255, 220, 60
    ENDIF
    IF auth$ <> "" THEN TEXT 120, 12, T$("deck") + " " + STR$(LEN(mydeck)) + "/6   " + T$("joker") + " x" + STR$(MYWILD())
    ' one tab per deck slot, the empty ones ready to be filled
    DIM ds
    FOR ds = 0 TO 2
        DIM tabx = 8 + ds * 152
        IF ds = deckidx THEN
            DRAWCOLOR 60, 90, 160
        ELSE
            DRAWCOLOR 24, 26, 52
        ENDIF
        ROUNDED_RECT tabx, 40, 146, 26, 8, TRUE
        DRAWCOLOR 120, 160, 240
        ROUNDED_RECT tabx, 40, 146, 26, 8, FALSE
        DIM dn$ = "Deck " + STR$(ds + 1)
        IF ds < LEN(mydecks) THEN dn$ = mydecks[ds]{"NAME"}
        DRAWCOLOR 235, 242, 255
        TEXT tabx + 14, 46, MID$(dn$, 0, 12)
    NEXT ds
    IF LEN(cardorder) = 0 THEN
        DRAWCOLOR 255, 255, 255
        TEXT 100, 300, T$("no_cards_ui")
    ELSE
        DIM i
        FOR i = 0 TO LEN(cardorder) - 1
            DIM kind$ = cardorder[i]
            DIM col = CCOLOR(kind$)
            DIM x0 = 6 + (i MOD 3) * 154
            DIM y0 = 78 + INT(i / 3) * 126
            IF DECKHAS(kind$) = 1 THEN
                DRAWCOLOR INT(col[0] * 0.5), INT(col[1] * 0.5), INT(col[2] * 0.5)
            ELSE
                DRAWCOLOR INT(col[0] * 0.22), INT(col[1] * 0.22), INT(col[2] * 0.22)
            ENDIF
            ROUNDED_RECT x0, y0, 150, 118, 12, TRUE
            DRAWCOLOR col[0], col[1], col[2]
            ROUNDED_RECT x0, y0, 150, 118, 12, FALSE
            IF DECKHAS(kind$) = 1 THEN
                DRAWCOLOR 255, 255, 0
                ROUNDED_RECT x0, y0, 150, 118, 12, FALSE
                ROUNDED_RECT x0 + 1, y0 + 1, 148, 116, 11, FALSE
            ENDIF
            IF art_ready = 1 ANDALSO MAP.EXISTS(art_own, kind$) THEN
                SPRAT(art_own{kind$}, x0 + 110, y0 + 38)
            ENDIF
            DRAWCOLOR 245, 250, 255
            TEXT x0 + 12, y0 + 10, ICON$(kind$)
            TEXT x0 + 12, y0 + 36, MID$(kind$, 0, 8)
            ' bottom row: cost coin, level and collection progress
            DIM mc = MYCARD(kind$)
            DIM upcost = INT(2 ^ mc{"LVL"})
            ELIXCOIN(x0 + 20, y0 + 92, 13, STR$(cardcost{kind$}))
            DRAWCOLOR 245, 250, 255
            TEXT x0 + 40, y0 + 62, "Lv" + STR$(mc{"LVL"})
            TEXT x0 + 40, y0 + 86, STR$(mc{"HAVE"}) + "/" + STR$(upcost)
            IF mc{"LVL"} < 5 ANDALSO mc{"HAVE"} + MYWILD() >= upcost THEN
                DRAWCOLOR 40, 150, 60
                ROUNDED_RECT x0 + 108, y0 + 76, 34, 34, 9, TRUE
                DRAWCOLOR 120, 255, 150
                ROUNDED_RECT x0 + 108, y0 + 76, 34, 34, 9, FALSE
                DRAWCOLOR 255, 255, 255
                TEXT x0 + 120, y0 + 84, "+"
            ENDIF
            ' info badge - opens the full card sheet
            DRAWCOLOR 30, 40, 80
            CIRCLE x0 + 132, y0 + 14, 12, TRUE
            DRAWCOLOR 150, 200, 255
            CIRCLE x0 + 132, y0 + 14, 12, FALSE
            TEXT x0 + 128, y0 + 6, "i"
        NEXT i
    ENDIF
    IF LEN(mydeck) = 6 THEN
        BUTTON(134, 726, 200, 50, T$("done"), 80, 210, 120)
    ELSE
        BUTTON(134, 726, 200, 50, T$("done"), 95, 95, 115)
    ENDIF
ENDSUB

' Elixir cost as a bare number on an elixir-purple coin.
SUB ELIXCOIN(cx, cy, r, n$)
    DRAWCOLOR 120, 30, 160
    CIRCLE cx, cy, r + 1, TRUE
    DRAWCOLOR 210, 60, 240
    CIRCLE cx, cy, r, TRUE
    DRAWCOLOR 245, 170, 255
    CIRCLE cx, cy, r, FALSE
    DRAWCOLOR 255, 255, 255
    TEXT cx - LEN(n$) * 5, cy - 9, n$
ENDSUB

' In place of the hand: who is playing, and the way out.
SUB DrawWatchBar()
    DRAWCOLOR 16, 18, 40
    RECT 0, 840, SCR_W, 60, TRUE
    DRAWCOLOR 90, 110, 190
    LINE 0, 840, SCR_W, 840
    DRAWCOLOR 150, 220, 255
    TEXT 12, 852, T$("watching") + ": " + MID$(myname$, 0, 9) + " vs " + MID$(foename$, 0, 9)
    BUTTON(334, 848, 124, 44, T$("menu"), 95, 95, 115)
ENDSUB

SUB DrawHand()
    DIM q = world{"QUEUES"}[mypid]
    DIM i
    FOR i = 0 TO 3
        DIM kind$ = q[i]
        DIM col = kindcolor{kind$}
        DIM x0 = i * 117
        DIM afford = 1
        IF world{"ELIXIR"}[mypid] < cardcost{kind$} THEN afford = 0
        IF afford = 0 THEN
            DRAWCOLOR INT(col[0] * 0.3), INT(col[1] * 0.3), INT(col[2] * 0.3)
        ELSE
            DRAWCOLOR INT(col[0] * 0.55), INT(col[1] * 0.55), INT(col[2] * 0.55)
        ENDIF
        ROUNDED_RECT x0 + 3, 843, 111, 54, 9, TRUE
        DRAWCOLOR col[0], col[1], col[2]
        ROUNDED_RECT x0 + 3, 843, 111, 54, 9, FALSE
        IF sel$ = kind$ THEN
            DRAWCOLOR 255, 255, 0
            ROUNDED_RECT x0 + 3, 843, 111, 54, 9, FALSE
            ROUNDED_RECT x0 + 4, 844, 109, 52, 8, FALSE
        ENDIF
        ' ship portrait on the right, tag top-left, cost and level below
        IF art_ready = 1 ANDALSO MAP.EXISTS(art_own, kind$) THEN
            SPRAT(art_own{kind$}, x0 + 84, 868)
        ENDIF
        DRAWCOLOR 245, 250, 255
        TEXT x0 + 10, 848, ICON$(kind$)
        DIM lvl = 1
        DIM hl = world{"CARDLVL"}[mypid]
        IF MAP.EXISTS(hl, kind$) THEN lvl = hl{kind$}
        IF lvl > 1 THEN
            DRAWCOLOR 255, 235, 120
            TEXT x0 + 36, 876, "L" + STR$(lvl)
        ENDIF
        ELIXCOIN(x0 + 20, 883, 12, STR$(cardcost{kind$}))
    NEXT i
    DIM exl = world{"ELIXIR"}[mypid]
    DRAWCOLOR 30, 10, 40
    RECT 0, 832, SCR_W, 8, TRUE
    IF exl > 0 THEN
        DRAWCOLOR 210, 60, 240
        RECT 0, 832, INT(SCR_W * exl / 10.0), 8, TRUE
    ENDIF
    ELIXCOIN(SCR_W - 26, 812, 15, STR$(INT(exl)))
ENDSUB

SUB DrawHud()
    DRAWCOLOR 255, 255, 255
    DIM t = world{"T_LEFT"}
    DIM label$ = ""
    IF t < 0 THEN
        label$ = "OT "
        t = 60 + t
    ENDIF
    TEXT 200, 6, label$ + STR$(INT(t / 60)) + ":" + RIGHT$("0" + STR$(INT(t) MOD 60), 2)
    DIM cr = world{"CROWNS"}
    DIM me$ = T$("you")
    IF watching = 1 THEN me$ = MID$(myname$, 0, 9)
    TEXT 6, 6, me$ + " " + STR$(cr[mypid])
    TEXT 6, 26, foename$ + " " + STR$(cr[1 - mypid])
    IF LEN(profiles) = 2 THEN
        TEXT 290, 26, T$("wins_short") + " " + STR$(profiles[mypid]{"WINS"}) + ":" + STR$(profiles[1 - mypid]{"WINS"})
    ENDIF
    ' emote button, and the picker it opens across the top of the board
    IF watching = 0 THEN DrawEmoteFace(438, 26, 18, 0)
    IF emote_open = 1 THEN
        DRAWCOLOR 14, 16, 36
        ROUNDED_RECT 10, BOARD_Y0 + 8, 448, 60, 16, TRUE
        DRAWCOLOR 90, 110, 190
        ROUNDED_RECT 10, BOARD_Y0 + 8, 448, 60, 16, FALSE
        DIM eb
        FOR eb = 0 TO 5
            DrawEmoteFace(46 + eb * 75, BOARD_Y0 + 38, 22, eb)
        NEXT eb
    ENDIF
    IF msg$ <> "" THEN
        DRAWCOLOR 255, 220, 0
        TEXT 6, 46, T$(msg$)
    ENDIF
    IF ISOVER() = 1 THEN
        DIM w = world{"WINNER"}
        ' celebration sparks for a win, drifting embers otherwise
        DIM ci
        FOR ci = 0 TO 25
            DIM ph = (frame * 2 + ci * 37) MOD 220
            DIM ang = ci * 0.62
            DIM rad = ph * 1.4
            IF w = mypid THEN
                DRAWCOLOR 255, 230 - ph, 90 + ph
                CIRCLE 234 + INT(COS(ang) * rad), 420 + INT(SIN(ang) * rad * 0.6), 3, TRUE
            ELSE
                DRAWCOLOR 120, 90, 140
                PSET 234 + INT(COS(ang) * rad), 420 + INT(SIN(ang) * rad * 0.6)
            ENDIF
        NEXT ci
        DRAWCOLOR 18, 20, 44
        ROUNDED_RECT 54, 372, 360, 108, 18, TRUE
        IF w = mypid THEN
            DRAWCOLOR 90, 250, 160
        ELSEIF w = 2 THEN
            DRAWCOLOR 200, 200, 230
        ELSE
            DRAWCOLOR 255, 90, 120
        ENDIF
        ROUNDED_RECT 54, 372, 360, 108, 18, FALSE
        ROUNDED_RECT 56, 374, 356, 104, 16, FALSE
        DIM ttl$ = T$("draw")
        IF watching = 1 THEN
            IF w = 0 THEN ttl$ = myname$ + " " + T$("foe_wins")
            IF w = 1 THEN ttl$ = foename$ + " " + T$("foe_wins")
        ELSE
            IF w = mypid THEN ttl$ = T$("you_win")
            IF w <> mypid ANDALSO w <> 2 THEN ttl$ = foename$ + " " + T$("foe_wins")
        ENDIF
        TEXT 234 - LEN(ttl$) * 5, 390, ttl$
        IF LEN(profiles) = 2 THEN
            DRAWCOLOR 190, 200, 235
            DIM sline$ = T$("series") + " " + STR$(profiles[mypid]{"WINS"}) + ":" + STR$(profiles[1 - mypid]{"WINS"}) + "   " + T$("crowns") + " " + STR$(profiles[mypid]{"CROWNS"}) + ":" + STR$(profiles[1 - mypid]{"CROWNS"})
            TEXT 234 - LEN(sline$) * 5, 424, sline$
        ENDIF
        IF h2h$ <> "" THEN
            DRAWCOLOR 120, 240, 190
            TEXT 234 - LEN(h2h$) * 5, 450, h2h$
        ENDIF
        IF chest_shown = 1 ANDALSO MAP.EXISTS(myprofile, "LASTCHEST") THEN
            DRAWCOLOR 22, 24, 48
            ROUNDED_RECT 14, 600, 440, 86, 14, TRUE
            DRAWCOLOR 120, 110, 200
            ROUNDED_RECT 14, 600, 440, 86, 14, FALSE
            DRAWCOLOR 255, 220, 90
            TEXT 26, 608, T$("chest") + "   " + T$("joker") + " x" + STR$(MYWILD())
            CHESTROW(myprofile{"LASTCHEST"}, 26, 638)
        ENDIF
        BUTTON(154, 496, 160, 46, T$("again"), 80, 210, 120)
        BUTTON(154, 552, 160, 40, T$("menu"), 150, 150, 180)
    ENDIF
ENDSUB

SUB DrawFrame(fnow)
    DRAWCOLOR 15, 15, 20
    RECT 0, 0, SCR_W, SCR_H, TRUE
    IF have_state = 0 ORELSE mypid < 0 THEN
        DRAWCOLOR 255, 255, 255
        TEXT 150, 420, "jdVOID"
        TEXT 120, 456, T$("connecting") + " " + T$(msg$)
    ELSE
        DrawBoard(fnow)
        IF sel$ <> "" ORELSE drag_kind$ <> "" THEN DrawDeployZone()
        DrawTowers()
        DrawUnits()
        DrawFX(fnow)
        DrawGhost(fnow)
        IF watching = 1 THEN
            DrawWatchBar()
        ELSE
            DrawHand()
        ENDIF
        DrawHud()
        IF waiting = 1 THEN
            DRAWCOLOR 18, 20, 44
            ROUNDED_RECT 44, 372, 380, 116, 16, TRUE
            DRAWCOLOR 120, 110, 200
            ROUNDED_RECT 44, 372, 380, 116, 16, FALSE
            DRAWCOLOR 190, 200, 235
            DIM wt$ = T$("waiting")
            TEXT 234 - LEN(wt$) * 5, 392, wt$
            DRAWCOLOR 60, 240, 255
            DIM wr$ = T$("room") + ": " + room$
            TEXT 234 - LEN(wr$) * 5, 420, wr$
            DRAWCOLOR 130, 140, 180
            DIM wh$ = T$("share_hint")
            TEXT 234 - LEN(wh$) * 5, 452, wh$
            BUTTON(134, 500, 200, 50, T$("vs_bot"), 80, 120, 200)
            ' a pulsing beacon so the screen does not look frozen
            DIM bp = 6 + INT(5 * SIN(fnow * 0.12))
            DRAWCOLOR 90, 250, 160
            CIRCLE 234, 340, bp, FALSE
        ENDIF
    ENDIF
ENDSUB

SUB MenuClick(mx, my)
    ' sound toggles and the lobby list
    IF my >= 462 ANDALSO my <= 506 THEN
        IF mx >= 24 ANDALSO mx <= 224 THEN
            mus_on = 1 - mus_on
            IF mus_on = 1 ANDALSO snd_on = 0 THEN
                SNDINIT()
                MUSICINIT()
            ENDIF
        ELSEIF mx >= 244 ANDALSO mx <= 444 THEN
            sfx_on = 1 - sfx_on
            IF sfx_on = 1 ANDALSO snd_on = 0 THEN SNDINIT()
        ENDIF
        RETURN
    ENDIF
    IF my >= 562 ANDALSO my <= 762 ANDALSO mx >= 24 ANDALSO mx <= 444 THEN
        DIM idx = INT((my - 562) / 40)
        IF idx >= 0 ANDALSO idx < LEN(lobby) THEN
            IF mx >= 344 ANDALSO lobby[idx]{"LIVE"} = 1 THEN
                WATCHROOM(lobby[idx]{"KEY"})
            ELSE
                room$ = lobby[idx]{"KEY"}
                LOADLOBBY()
            ENDIF
        ENDIF
        RETURN
    ENDIF
    IF mx >= 134 ANDALSO mx <= 334 THEN
        IF my >= 330 ANDALSO my <= 386 THEN
            uimode$ = "battle"
            watching = 0
            mypid = -1
            tok$ = ""
            have_state = 0
            fxseen = {}
            fxact = []
            prev_tick = -1
            chest_shown = 0
            msg$ = ""
            JOINMATCH()
        ELSEIF my >= 396 ANDALSO my <= 452 THEN
            uimode$ = "decks"
            IF LEN(cardorder) = 0 THEN
                LOADCARDS()
                BAKEART()
            ENDIF
            LOADPROFILE()
        ENDIF
    ENDIF
ENDSUB

SUB DeckClick(mx, my)
    ' the open card sheet swallows the screen until it is closed
    IF info_kind$ <> "" THEN
        IF my >= 756 ANDALSO my <= 806 ANDALSO mx >= 134 ANDALSO mx <= 334 THEN info_kind$ = ""
        RETURN
    ENDIF
    IF my >= 40 ANDALSO my <= 66 THEN
        DIM tslot = INT((mx - 8) / 152)
        IF tslot >= 0 ANDALSO tslot <= 2 THEN PICKDECKSLOT(tslot)
    ELSEIF my >= 726 ANDALSO my <= 776 ANDALSO mx >= 134 ANDALSO mx <= 334 THEN
        IF LEN(mydeck) = 6 THEN
            SAVEDECKS()
            uimode$ = "menu"
        ENDIF
    ELSEIF my >= 78 ANDALSO my < 712 THEN
        DIM ci = INT((mx - 6) / 154)
        DIM ri = INT((my - 78) / 126)
        IF ci >= 0 ANDALSO ci <= 2 ANDALSO ri >= 0 THEN
            DIM idx = ri * 3 + ci
            IF idx < LEN(cardorder) THEN
                DIM kind$ = cardorder[idx]
                DIM cellx = mx - 6 - ci * 154
                DIM celly = my - 78 - ri * 126
                DIM mc = MYCARD(kind$)
                DIM upcost = INT(2 ^ mc{"LVL"})
                IF cellx >= 116 ANDALSO celly <= 30 THEN
                    info_kind$ = kind$
                ELSEIF cellx >= 106 ANDALSO celly >= 74 ANDALSO celly <= 112 ANDALSO mc{"LVL"} < 5 ANDALSO mc{"HAVE"} + MYWILD() >= upcost THEN
                    SENDUPGRADE(kind$)
                ELSE
                    TOGGLECARD(kind$)
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDSUB

SUB HandleClick(mx, my)
    IF uimode$ = "menu" THEN
        MenuClick(mx, my)
    ELSEIF uimode$ = "decks" THEN
        DeckClick(mx, my)
    ELSEIF have_state = 0 ORELSE mypid < 0 THEN
        msg$ = ""
    ELSEIF watching = 1 THEN
        IF my >= 848 ANDALSO mx >= 334 THEN LEAVEWATCH()
    ELSEIF waiting = 1 ANDALSO my >= 500 ANDALSO my <= 550 ANDALSO mx >= 134 ANDALSO mx <= 334 THEN
        SENDBOT()
    ELSEIF ISOVER() = 1 THEN
        IF mx >= 154 ANDALSO mx <= 314 ANDALSO my >= 496 ANDALSO my <= 542 THEN SENDREMATCH()
        IF mx >= 154 ANDALSO mx <= 314 ANDALSO my >= 552 ANDALSO my <= 592 THEN uimode$ = "menu"
    ELSEIF mx >= 414 ANDALSO my <= 50 THEN
        emote_open = 1 - emote_open
    ELSEIF emote_open = 1 ANDALSO my >= BOARD_Y0 + 8 ANDALSO my <= BOARD_Y0 + 68 THEN
        DIM eslot = INT((mx - 10) / 75)
        IF eslot >= 0 ANDALSO eslot <= 5 THEN
            SENDEMOTE(eslot)
        ELSE
            emote_open = 0
        ENDIF
    ELSEIF my >= 840 THEN
        DIM slot = INT(mx / 117)
        IF slot > 3 THEN slot = 3
        sel$ = world{"QUEUES"}[mypid][slot]
        drag_kind$ = sel$
        msg$ = ""
    ELSEIF my >= BOARD_Y0 THEN
        IF sel$ = "" THEN
            msg$ = "pick_card"
        ELSE
            DIM tx = mx / (TILE * 1.0)
            DIM tyv = (my - BOARD_Y0) / (TILE * 1.0)
            SENDPLAY(sel$, tx, WY(tyv))
        ENDIF
    ENDIF
ENDSUB

DIM shotmode = 0
DIM cliargs = OS.ARGS()
DIM ai
' started by hand: jdbasic royale.jdb <name> <pin> [room] [shot]
DIM plain = []
FOR ai = 1 TO LEN(cliargs) - 1
    IF LCASE$(cliargs[ai]) = "shot" THEN
        shotmode = 1
    ELSE
        plain = APPEND(plain, cliargs[ai])
    ENDIF
NEXT ai
IF LEN(plain) >= 2 THEN
    myname$ = plain[0]
    mypin$ = plain[1]
ENDIF
IF LEN(plain) >= 3 THEN room$ = plain[2]

SCREEN SCR_W, SCR_H, "jdVOID"
DRAWCOLOR 6, 8, 22
RECT 0, 0, SCR_W, SCR_H, TRUE
DRAWCOLOR 190, 220, 255
TEXT 120, 430, "jdVOID"
SCREENFLIP
SNDINIT()
LOADLANG()
LOGIN()
MUSICINIT()
LOADCARDS()
BAKEART()
MAKESTARS()
LOADLOBBY()
LOADPROFILE()

IF shotmode = 1 THEN
    uimode$ = "battle"
    JOINMATCH()
    POLLSTATE()
    SYNCFX(0)
    DrawFrame(6)
    GFX.SAVE_SCREENSHOT("tmp/client.png")
    SCREENFLIP
    PRINT "pid: "; mypid; "  waiting: "; waiting; "  msg: "; msg$
    GFX.CLOSE
ELSE
    DO
        IF running = 0 THEN EXITDO
        frame = frame + 1
        IF uimode$ = "battle" THEN
            IF mypid < 0 ANDALSO frame MOD 30 = 0 THEN JOINMATCH()
            IF mypid >= 0 ANDALSO frame MOD 6 = 0 THEN POLLSTATE()
            SYNCFX(frame)
            MUSICSTEP(frame)
            IF shake > 0.2 THEN
                shake = shake * 0.82
                shake_x = INT(shake * (RND() * 2 - 1))
                shake_y = INT(shake * (RND() * 2 - 1))
            ELSE
                shake = 0.0
                shake_x = 0
                shake_y = 0
            ENDIF
        ENDIF
        IF tap_new = 1 THEN
            tap_new = 0
            HandleClick(tap_x, tap_y)
        ENDIF
        IF up_new = 1 THEN
            up_new = 0
            ' released over the board while holding a card - deploy there
            IF uimode$ = "battle" ANDALSO drag_kind$ <> "" ANDALSO up_y < 840 ANDALSO up_y >= BOARD_Y0 THEN
                IF have_state = 1 ANDALSO mypid >= 0 ANDALSO ISOVER() = 0 THEN
                    SENDPLAY(drag_kind$, up_x / (TILE * 1.0), WY((up_y - BOARD_Y0) / (TILE * 1.0)))
                ENDIF
            ENDIF
            drag_kind$ = ""
        ENDIF
        IF uimode$ = "menu" THEN
            DrawMenu()
        ELSEIF uimode$ = "decks" THEN
            DrawDeckEd()
            DrawCardInfo()
        ELSE
            DrawFrame(frame)
        ENDIF
        SCREENFLIP
        SLEEP 33
    LOOP
    GFX.CLOSE
ENDIF
