' BASIC Royale - phone/desktop client. Renders the server state and sends
' taps; the arena rules live on the server. Each player sees their own side
' at the bottom - player 1's view is mirrored. Ships and stations come from
' the ART module, baked into sprites once at startup.
' Shot mode for headless checks:  jdbasic royale.jdb shot -> tmp/client.png
IMPORT ART

' Where the match server lives. Served from a host (the deployed site),
' the page tells us its own origin and the API sits behind /api - on the
' LAN we fall back to the dev box.
DIM SRV$ = "http://192.168.0.37:8081"

CONST TILE = 26
CONST BOARD_Y0 = 60
CONST SCR_W = 468
CONST SCR_H = 900

DIM running = 1
SUB OnQuit()
    running = 0
ENDSUB
ON "QUIT" CALL OnQuit

' Taps arrive as buffered MOUSEDOWN events - a finger tap is shorter than
' one frame, so polling the button state misses it. The queue also survives
' the blocking /state fetch.
DIM tap_new = 0
DIM tap_x = 0
DIM tap_y = 0
SUB OnTap(info)
    tap_x = info[0]{"x"}
    tap_y = info[0]{"y"}
    tap_new = 1
ENDSUB
ON "MOUSEDOWN" CALL OnTap

' Fallbacks until GET /cards answers; the server's cards.json wins.
DIM kindcolor AS MAP = {}
kindcolor{"DROID"} = [175, 188, 215]
kindcolor{"LASER"} = [140, 235, 200]
kindcolor{"KOLOSS"} = [200, 150, 90]
kindcolor{"WESPEN"} = [120, 180, 255]
kindcolor{"SPLITTER"} = [225, 230, 245]
kindcolor{"PLASMA"} = [255, 130, 60]
DIM cardcost AS MAP = {}
cardcost{"DROID"} = 3
cardcost{"LASER"} = 3
cardcost{"KOLOSS"} = 5
cardcost{"WESPEN"} = 3
cardcost{"SPLITTER"} = 2
cardcost{"PLASMA"} = 4

' kind -> sprite id, one set per team, filled by BAKEART
DIM art_own AS MAP = {}
DIM art_foe AS MAP = {}
DIM art_ready = 0
DIM stars = []

DIM mypid = -1
DIM tok$ = ""
DIM world AS MAP = {}
DIM have_state = 0
DIM waiting = 1
DIM foename$ = ""
DIM profiles = []
DIM myprofile AS MAP = {}
DIM chest_shown = 0
DIM sel$ = ""
DIM msg$ = ""
DIM fxseen AS MAP = {}
DIM fxact = []
DIM frame = 0

' Screens: menu -> battle / decks. Battle joins on demand, not at load.
DIM uimode$ = "menu"
DIM mydeck = ["DROID", "LASER", "KOLOSS", "WESPEN", "SPLITTER", "PLASMA"]
DIM myname$ = "Spieler"
DIM allcards AS MAP = {}
DIM cardorder = []

' A shared link personalises the session: ?name= names the player and
' ?room= picks the match, so several pairs can play at once.
DIM room$ = "main"
TRY
    DIM up = JSON.PARSE$(TXTREADER$("/url_params.json"))
    IF MAP.EXISTS(up, "name") THEN myname$ = up{"name"}
    IF MAP.EXISTS(up, "room") THEN room$ = up{"room"}
    IF MAP.EXISTS(up, "__origin") THEN
        DIM org$ = up{"__origin"}
        IF INSTR(org$, "://192.168.") < 0 ANDALSO INSTR(org$, "://localhost") < 0 ANDALSO INSTR(org$, "://127.") < 0 THEN
            SRV$ = org$ + "/api"
        ENDIF
    ENDIF
CATCH
ENDTRY

' Player 1 sees the board mirrored so their own side is at the bottom.
FUNC WY(y)
    IF mypid = 1 THEN RETURN 29.0 - y
    RETURN y
ENDFUNC

FUNC PX(tx)
    RETURN INT(tx * TILE)
ENDFUNC

FUNC PY(ty)
    RETURN INT(BOARD_Y0 + ty * TILE)
ENDFUNC

FUNC MINE(owner)
    RETURN IIF(owner = mypid, 1, 0)
ENDFUNC

' The server's cards.json is the source for stats, colors and icons; the
' hardcoded maps above stay as fallback when the fetch fails.
SUB LOADCARDS()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/cards")
        DIM m = JSON.PARSE$(r$)
        DIM cs = m{"CARDS"}
        allcards = cs
        cardorder = SORT(MAP.KEYS(cs))
        DIM ks = MAP.KEYS(cs)
        FOR EACH k$ IN ks
            cardcost{k$} = cs{k$}{"COST"}
            IF MAP.EXISTS(cs{k$}, "COLOR") THEN kindcolor{k$} = cs{k$}{"COLOR"}
        NEXT k$
    CATCH
    ENDTRY
ENDSUB

' Bake one sprite per card kind for both teams, plus the two station
' classes. Runs once - a few hundred milliseconds of array math.
SUB BAKEART()
    IF LEN(cardorder) > 0 THEN
        art_own = ART.BAKEALL(cardorder, 0)
        art_foe = ART.BAKEALL(cardorder, 1)
        art_ready = 1
    ENDIF
ENDSUB

' Menu button: rounded plate with a lighter top edge and a bright rim.
SUB BUTTON(x, y, w, h, label$, cr, cg, cb)
    DRAWCOLOR INT(cr * 0.45), INT(cg * 0.45), INT(cb * 0.45)
    ROUNDED_RECT x, y + 3, w, h, 12, TRUE
    DRAWCOLOR cr, cg, cb
    ROUNDED_RECT x, y, w, h, 12, TRUE
    DRAWCOLOR INT(cr * 0.35) + 160, INT(cg * 0.35) + 160, INT(cb * 0.35) + 160
    ROUNDED_RECT x, y, w, h, 12, FALSE
    ROUNDED_RECT x + 1, y + 1, w - 2, h - 2, 11, FALSE
    DRAWCOLOR 12, 14, 30
    TEXT x + w / 2 - LEN(label$) * 5, y + h / 2 - 9, label$
ENDSUB

' SPRITE.POS anchors the top-left corner, so blit through here to land a
' sprite on a centre point.
SUB SPRAT(sid, cx, cy)
    SPRITE.POS(sid, cx - SPRITE.WIDTH(sid) / 2, cy - SPRITE.HEIGHT(sid) / 2)
    SPRITE.DRAW(sid)
ENDSUB

' Star field: x, y, brightness, drift speed per star.
SUB MAKESTARS()
    stars = []
    DIM i
    FOR i = 1 TO 90
        DIM sx = RND() * SCR_W
        DIM sy = RND() * (SCR_H - BOARD_Y0)
        DIM sb = 70 + RND() * 150
        DIM sv = 0.15 + RND() * 0.5
        stars = APPEND(stars, [[sx, sy, sb, sv]])
    NEXT i
ENDSUB

FUNC ICON$(kind$)
    IF MAP.EXISTS(allcards, kind$) THEN
        IF MAP.EXISTS(allcards{kind$}, "ICON") THEN RETURN allcards{kind$}{"ICON"}
    ENDIF
    RETURN MID$(kind$, 0, 2)
ENDFUNC

FUNC CCOLOR(kind$)
    IF MAP.EXISTS(kindcolor, kind$) THEN RETURN kindcolor{kind$}
    RETURN [180, 180, 180]
ENDFUNC

SUB LOADPROFILE()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/profile?name=" + myname$)
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN myprofile = m{"PROFILE"}
    CATCH
    ENDTRY
ENDSUB

' Collection entry {LVL, HAVE} for a card, defaulting to fresh.
FUNC MYCARD(kind$)
    IF MAP.EXISTS(myprofile, "CARDS") THEN
        IF MAP.EXISTS(myprofile{"CARDS"}, kind$) THEN RETURN myprofile{"CARDS"}{kind$}
    ENDIF
    RETURN { "LVL": 1, "HAVE": 0 }
ENDFUNC

FUNC MYWILD()
    IF MAP.EXISTS(myprofile, "WILD") THEN RETURN myprofile{"WILD"}
    RETURN 0
ENDFUNC

SUB SENDUPGRADE(kind$)
    TRY
        DIM body$ = JSON.STRINGIFY$({ "NAME": myname$, "KIND": kind$ })
        DIM r$ = HTTP.POST$(SRV$ + "/upgrade", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            PLAYFX("SPAWN")
        ENDIF
        LOADPROFILE()
    CATCH
    ENDTRY
ENDSUB

FUNC DECKHAS(kind$)
    FOR EACH d$ IN mydeck
        IF d$ = kind$ THEN RETURN 1
    NEXT d$
    RETURN 0
ENDFUNC

SUB TOGGLECARD(kind$)
    IF DECKHAS(kind$) = 1 THEN
        DIM nd = []
        FOR EACH d$ IN mydeck
            IF d$ <> kind$ THEN nd = APPEND(nd, d$)
        NEXT d$
        mydeck = nd
    ELSEIF LEN(mydeck) < 6 THEN
        mydeck = APPEND(mydeck, kind$)
    ENDIF
ENDSUB

SUB JOINMATCH()
    TRY
        DIM r$ = HTTP.POST$(SRV$ + "/join", JSON.STRINGIFY$({ "NAME": myname$, "DECK": mydeck, "ROOM": room$ }), "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            mypid = m{"PID"}
            tok$ = m{"TOK"}
            msg$ = ""
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
        msg$ = "server? " + SRV$
    ENDTRY
ENDSUB

DIM prev_tick = -1
SUB POLLSTATE()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/state?room=" + room$ + "&tok=" + tok$)
        DIM m = JSON.PARSE$(r$)
        world = m{"ST"}
        waiting = m{"WAITING"}
        have_state = 1
        DIM names = m{"NAMES"}
        IF LEN(names) = 2 THEN foename$ = names[1 - mypid]
        IF MAP.EXISTS(m, "PROFILES") THEN profiles = m{"PROFILES"}
        ' fetch the fresh chest once when the match ends
        IF world{"PHASE"} = "over" ANDALSO chest_shown = 0 THEN
            chest_shown = 1
            LOADPROFILE()
        ENDIF
        ' a rematch restarts event ids - drop stale FX bookkeeping
        IF world{"TICKNO"} < prev_tick THEN
            fxseen = {}
            fxact = []
            sel$ = ""
            chest_shown = 0
        ENDIF
        prev_tick = world{"TICKNO"}
    CATCH
        msg$ = "poll failed"
    ENDTRY
ENDSUB

SUB SENDREMATCH()
    TRY
        DIM r$ = HTTP.POST$(SRV$ + "/rematch", JSON.STRINGIFY$({ "ROOM": room$ }), "text/plain")
        msg$ = ""
    CATCH
        msg$ = "rematch failed"
    ENDTRY
ENDSUB

SUB SENDPLAY(kind$, wx, wyv)
    TRY
        DIM body$ = JSON.STRINGIFY$({ "TOK": tok$, "KIND": kind$, "X": wx, "Y": wyv, "ROOM": room$ })
        DIM r$ = HTTP.POST$(SRV$ + "/play", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            sel$ = ""
            msg$ = ""
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
        msg$ = "play failed"
    ENDTRY
ENDSUB

' Retro synth SFX on the built-in sequencer. Track 1 = UI blips, track 2 =
' shots, track 3 = noise booms. Sustain 0 lets every note fade out on its
' own, so no release bookkeeping is needed in the render loop.
DIM snd_on = 0
SUB SNDINIT()
    TRY
        SOUND.INIT
        SOUND.VOICE 1, "SQUARE", 0.005, 0.08, 0.0, 0.05
        SOUND.VOICE 2, "SQUARE", 0.002, 0.05, 0.0, 0.03
        SOUND.VOICE 3, "NOISE", 0.005, 0.25, 0.0, 0.2
        SOUND.GAIN 1, 0.5
        SOUND.GAIN 2, 0.3
        SOUND.GAIN 3, 0.6
        snd_on = 1
    CATCH
        snd_on = 0
    ENDTRY
ENDSUB

SUB PLAYFX(t$)
    IF snd_on = 1 THEN
        TRY
            IF t$ = "SPAWN" THEN
                SOUND.PLAY 1, 330
            ELSEIF t$ = "SHOT" THEN
                SOUND.PLAY 2, 880
            ELSEIF t$ = "HIT" THEN
                SOUND.PLAY 2, 220
            ELSEIF t$ = "CAST" THEN
                SOUND.PLAY 1, 550
            ELSEIF t$ = "BOOM" THEN
                SOUND.PLAY 3, 80
            ELSEIF t$ = "DIE" THEN
                SOUND.PLAY 3, 200
            ELSEIF t$ = "FALL" THEN
                SOUND.PLAY 3, 50
            ENDIF
        CATCH
            snd_on = 0
        ENDTRY
    ENDIF
ENDSUB

' HP bar with a health gradient: green, then yellow, then red.
SUB DrawBar(x, y, w, frac)
    DRAWCOLOR 20, 20, 20
    RECT x, y, w, 5, TRUE
    IF frac > 0 THEN
        IF frac > 0.5 THEN
            DRAWCOLOR 90, 240, 90
        ELSEIF frac > 0.2 THEN
            DRAWCOLOR 240, 210, 60
        ELSE
            DRAWCOLOR 240, 70, 50
        ENDIF
        RECT x, y, INT(w * frac), 5, TRUE
    ENDIF
ENDSUB

' Collect unseen sim events into the local FX list (dedup by EID) and give
' each fresh event its sound - shots capped at 2 per batch to avoid spam.
SUB SYNCFX(fnow)
    IF have_state = 1 THEN
        DIM n_shots = 0
        FOR EACH evt IN world{"EVENTS"}
            DIM k$ = STR$(evt{"EID"})
            IF NOT MAP.EXISTS(fxseen, k$) THEN
                fxseen{k$} = 1
                fxact = APPEND(fxact, { "EV": evt, "T0": fnow })
                IF evt{"T"} = "SHOT" THEN
                    n_shots = n_shots + 1
                    IF n_shots <= 2 THEN PLAYFX("SHOT")
                ELSE
                    PLAYFX(evt{"T"})
                ENDIF
            ENDIF
        NEXT evt
    ENDIF
ENDSUB

SUB DrawFX(fnow)
    DIM keep = []
    FOR EACH fx IN fxact
        DIM evt = fx{"EV"}
        DIM t$ = evt{"T"}
        DIM age = fnow - fx{"T0"}
        DIM dur = 8
        IF t$ = "BOOM" THEN dur = 14
        IF t$ = "CAST" THEN dur = 15
        IF t$ = "FALL" THEN dur = 22
        IF t$ = "HIT" THEN dur = 6
        IF t$ = "DIE" THEN dur = 10
        IF age <= dur THEN
            DIM p = age / (dur * 1.0)
            DIM ex = PX(evt{"X"})
            DIM ey = PY(WY(evt{"Y"}))
            IF t$ = "SHOT" THEN
                DIM x1 = PX(evt{"FX"}) + INT((ex - PX(evt{"FX"})) * p)
                DIM y1 = PY(WY(evt{"FY"})) + INT((ey - PY(WY(evt{"FY"}))) * p)
                DRAWCOLOR 255, 255, 160
                CIRCLE x1, y1, 3, TRUE
                IF p > 0.7 THEN
                    DRAWCOLOR 255, 255, 255
                    TEXT ex + 8, ey - 14 - INT(p * 10), STR$(evt{"D"})
                ENDIF
            ELSEIF t$ = "CAST" THEN
                DIM x2 = PX(evt{"FX"}) + INT((ex - PX(evt{"FX"})) * p)
                DIM y2 = PY(WY(evt{"FY"})) + INT((ey - PY(WY(evt{"FY"}))) * p)
                DRAWCOLOR 255, 140, 30
                CIRCLE x2, y2, 7, TRUE
                DRAWCOLOR 255, 220, 90
                CIRCLE x2, y2, 4, TRUE
            ELSEIF t$ = "BOOM" THEN
                DRAWCOLOR 255, 120, 30
                CIRCLE ex, ey, INT(6 + p * evt{"RADIUS"} * TILE), FALSE
                DRAWCOLOR 255, 200, 60
                CIRCLE ex, ey, INT(3 + p * evt{"RADIUS"} * TILE * 0.7), FALSE
                DRAWCOLOR 255, 255, 255
                TEXT ex - 12, ey - 24 - INT(p * 14), STR$(evt{"D"})
            ELSEIF t$ = "HIT" THEN
                DIM s = 4 + INT(p * 6)
                DRAWCOLOR 255, 240, 120
                LINE ex - s, ey - s, ex + s, ey + s
                LINE ex - s, ey + s, ex + s, ey - s
                LINE ex - s, ey, ex + s, ey
                DRAWCOLOR 255, 255, 255
                TEXT ex + 8, ey - 14 - INT(p * 12), STR$(evt{"D"})
            ELSEIF t$ = "DIE" THEN
                DRAWCOLOR 200, 200, 200
                CIRCLE ex, ey, INT(4 + p * 14), FALSE
            ELSEIF t$ = "SPAWN" THEN
                DRAWCOLOR 255, 255, 255
                CIRCLE ex, ey, INT(16 - p * 12), FALSE
            ELSEIF t$ = "FALL" THEN
                DRAWCOLOR 255, 160, 40
                CIRCLE ex, ey, INT(8 + p * 40), FALSE
                DRAWCOLOR 120, 120, 120
                CIRCLE ex, ey, INT(4 + p * 26), FALSE
            ENDIF
            keep = APPEND(keep, fx)
        ENDIF
    NEXT fx
    fxact = keep
ENDSUB

' Deep space: near-black field, drifting stars, a nebula belt where the
' river used to be and two lit gates standing in for the bridges.
SUB DrawBoard(fnow)
    DRAWCOLOR 6, 8, 22
    RECT 0, BOARD_Y0, SCR_W, SCR_H - BOARD_Y0, TRUE

    FOR EACH st2 IN stars
        DIM sy = st2[1] + fnow * st2[3]
        sy = sy MOD (SCR_H - BOARD_Y0)
        DIM sb = st2[2]
        DRAWCOLOR sb, sb, INT(sb * 0.8) + 40
        PSET INT(st2[0]), BOARD_Y0 + INT(sy)
    NEXT st2

    ' nebula belt, brightest in its middle rows
    DIM r
    FOR r = 13 TO 16
        DIM fade = 1.0 - ABS(r - 14.5) / 2.4
        DIM pulse = 0.75 + 0.25 * SIN(fnow * 0.06 + r)
        DRAWCOLOR INT(30 + 45 * fade * pulse), INT(20 + 30 * fade * pulse), INT(70 + 90 * fade * pulse)
        RECT 0, PY(r), SCR_W, TILE, TRUE
    NEXT r

    ' warp gates on the old bridge lanes: two lit pillars with an energy
    ' curtain drifting between them
    DIM gh = INT(TILE * 2.8)
    DIM gy = PY(13.6)
    DIM gx
    FOR EACH gx IN [2.5, 13.5]
        DIM gl = PX(gx)
        DIM gr = gl + TILE * 2
        DIM curt
        FOR curt = 0 TO 4
            DIM cy2 = gy + ((curt * 15 + INT(fnow * 1.6)) MOD (gh - 6))
            DRAWCOLOR 60, 150, 210
            LINE gl + 7, cy2, gr - 7, cy2
        NEXT curt
        DRAWCOLOR 120, 235, 255
        ROUNDED_RECT gl - 1, gy, 7, gh, 3, TRUE
        ROUNDED_RECT gr - 6, gy, 7, gh, 3, TRUE
        DRAWCOLOR 210, 250, 255
        ROUNDED_RECT gl + 1, gy + 3, 3, gh - 6, 1, TRUE
        ROUNDED_RECT gr - 4, gy + 3, 3, gh - 6, 1, TRUE
    NEXT gx
ENDSUB

' Stations: the baked sprite, mirrored so an enemy base faces the player.
' A sleeping mothership is dimmed and keeps its Zz.
SUB DrawTowers()
    FOR EACH tw IN world{"TOWERS"}
        IF tw{"HP"} <= 0 THEN CONTINUEFOR
        DIM asleep = 0
        IF tw{"KIND"} = "KING" ANDALSO tw{"AWAKE"} = 0 THEN asleep = 1
        DIM mine = MINE(tw{"OWNER"})
        DIM sid = art_foe{tw{"KIND"}}
        IF mine = 1 THEN sid = art_own{tw{"KIND"}}
        DIM cx = PX(tw{"X"})
        DIM cy = PY(WY(tw{"Y"}))
        SPRITE.FLIP(sid, FALSE, mine = 0)
        SPRITE.ALPHA(sid, IIF(asleep = 1, 130, 255))
        SPRAT(sid, cx, cy)
        IF asleep = 1 THEN
            DRAWCOLOR 220, 220, 240
            TEXT cx + 14, cy - 30, "Zz"
        ENDIF
        DrawBar(cx - TILE, cy - 30, TILE * 2, tw{"HP"} / tw{"MAXHP"})
    NEXT tw
ENDSUB

' Ships: baked sprite per kind and team, flipped to face the enemy side,
' nudged toward the target for two ticks after a strike.
SUB DrawUnits()
    FOR EACH u IN world{"UNITS"}
        DIM mine = MINE(u{"OWNER"})
        DIM ux = PX(u{"X"})
        DIM uy = PY(WY(u{"Y"}))
        IF MAP.EXISTS(u, "AT") THEN
            IF world{"TICKNO"} - u{"AT"} <= 2 THEN
                DIM lgy = u{"ADY"}
                IF mypid = 1 THEN lgy = -lgy
                ux = ux + INT(u{"ADX"} * 5)
                uy = uy + INT(lgy * 5)
            ENDIF
        ENDIF
        DIM kind$ = u{"KIND"}
        IF art_ready = 1 ANDALSO MAP.EXISTS(art_own, kind$) THEN
            DIM sid = art_foe{kind$}
            IF mine = 1 THEN sid = art_own{kind$}
            SPRITE.FLIP(sid, FALSE, mine = 0)
            SPRAT(sid, ux, uy)
        ELSE
            DIM col = kindcolor{kind$}
            DRAWCOLOR col[0], col[1], col[2]
            CIRCLE ux, uy, 9, TRUE
        ENDIF
        DrawBar(ux - 10, uy - 20, 20, u{"HP"} / u{"MAXHP"})
    NEXT u
ENDSUB

' One line of chest icons, e.g. "SK AR GO MI DR PK * ".
FUNC CHESTLINE$(chest)
    DIM out$ = ""
    FOR EACH cc$ IN chest
        IF cc$ = "*" THEN
            out$ = out$ + "* "
        ELSE
            out$ = out$ + ICON$(cc$) + " "
        ENDIF
    NEXT cc$
    RETURN out$
ENDFUNC

' Own half plus the quadrant a fallen enemy princess opened up. Mirroring
' puts the own half at the bottom for both players, so the unlocked strip
' is always the ten rows above it - only its side follows the dead tower.
SUB DrawDeployZone()
    DRAWCOLOR 255, 255, 0
    RECT 0, PY(16), SCR_W, TILE * 14, FALSE
    FOR EACH tw IN world{"TOWERS"}
        IF tw{"OWNER"} = mypid ORELSE tw{"KIND"} <> "PRINCESS" ORELSE tw{"HP"} > 0 THEN CONTINUEFOR
        DIM zx = 0
        IF tw{"X"} >= 9 THEN zx = PX(9)
        RECT zx, PY(6), PX(9), TILE * 10, FALSE
        RECT zx + 1, PY(6) + 1, PX(9) - 2, TILE * 10 - 2, FALSE
    NEXT tw
ENDSUB

SUB DrawMenu()
    DRAWCOLOR 15, 15, 20
    RECT 0, 0, SCR_W, SCR_H, TRUE
    DRAWCOLOR 255, 220, 60
    TEXT 150, 190, "BASIC ROYALE"
    DRAWCOLOR 200, 200, 210
    TEXT 150, 230, "Spieler: " + myname$
    IF MAP.EXISTS(myprofile, "LASTCHEST") THEN
        DIM played = myprofile{"WINS"} + myprofile{"LOSSES"} + myprofile{"DRAWS"}
        DIM head$ = "Letzte Kiste:"
        IF played = 0 THEN head$ = "Startkiste!"
        DRAWCOLOR 255, 220, 60
        RECT 34, 268, 400, 60, TRUE
        DRAWCOLOR 0, 0, 0
        TEXT 44, 276, head$ + "   * x" + STR$(MYWILD())
        TEXT 44, 302, CHESTLINE$(myprofile{"LASTCHEST"})
    ENDIF
    BUTTON(134, 360, 200, 60, "BATTLE", 80, 210, 120)
    BUTTON(134, 450, 200, 60, "DECK", 90, 160, 240)
    DIM ton$ = "TON: AUS"
    IF snd_on = 1 THEN ton$ = "TON: AN"
    BUTTON(134, 540, 200, 60, ton$, 150, 150, 180)
    DRAWCOLOR 90, 100, 130
    TEXT 150, 640, "Raum: " + room$
ENDSUB

SUB DrawDeckEd()
    DRAWCOLOR 15, 15, 20
    RECT 0, 0, SCR_W, SCR_H, TRUE
    DRAWCOLOR 255, 220, 60
    TEXT 130, 30, "DECK " + STR$(LEN(mydeck)) + "/6   * x" + STR$(MYWILD())
    IF LEN(cardorder) = 0 THEN
        DRAWCOLOR 255, 255, 255
        TEXT 100, 300, "Karten laden fehlgeschlagen..."
    ELSE
        DIM i
        FOR i = 0 TO LEN(cardorder) - 1
            DIM kind$ = cardorder[i]
            DIM col = CCOLOR(kind$)
            DIM x0 = 6 + (i MOD 3) * 154
            DIM y0 = 80 + INT(i / 3) * 150
            IF DECKHAS(kind$) = 1 THEN
                DRAWCOLOR col[0], col[1], col[2]
            ELSE
                DRAWCOLOR INT(col[0] * 0.35), INT(col[1] * 0.35), INT(col[2] * 0.35)
            ENDIF
            RECT x0, y0, 150, 140, TRUE
            IF DECKHAS(kind$) = 1 THEN
                DRAWCOLOR 255, 255, 0
                RECT x0, y0, 150, 140, FALSE
                RECT x0 + 1, y0 + 1, 148, 138, FALSE
            ENDIF
            IF art_ready = 1 ANDALSO MAP.EXISTS(art_own, kind$) THEN
                SPRAT(art_own{kind$}, x0 + 118, y0 + 34)
            ENDIF
            DRAWCOLOR 0, 0, 0
            TEXT x0 + 12, y0 + 16, ICON$(kind$)
            TEXT x0 + 12, y0 + 48, MID$(kind$, 0, 8)
            TEXT x0 + 12, y0 + 76, STR$(cardcost{kind$}) + " elx"
            DIM mc = MYCARD(kind$)
            DIM upcost = INT(2 ^ mc{"LVL"})
            TEXT x0 + 12, y0 + 108, "Lv" + STR$(mc{"LVL"}) + "  " + STR$(mc{"HAVE"}) + "/" + STR$(upcost)
            IF mc{"LVL"} < 5 ANDALSO mc{"HAVE"} + MYWILD() >= upcost THEN
                DRAWCOLOR 60, 200, 60
                RECT x0 + 108, y0 + 98, 38, 38, TRUE
                DRAWCOLOR 255, 255, 255
                RECT x0 + 108, y0 + 98, 38, 38, FALSE
                TEXT x0 + 121, y0 + 110, "+"
            ENDIF
        NEXT i
    ENDIF
    IF LEN(mydeck) = 6 THEN
        BUTTON(134, 700, 200, 50, "FERTIG", 80, 210, 120)
    ELSE
        BUTTON(134, 700, 200, 50, "FERTIG", 95, 95, 115)
    ENDIF
ENDSUB

SUB DrawHand()
    DIM q = world{"QUEUES"}[mypid]
    DIM i
    FOR i = 0 TO 3
        DIM kind$ = q[i]
        DIM col = kindcolor{kind$}
        DIM x0 = i * 117
        IF world{"ELIXIR"}[mypid] < cardcost{kind$} THEN
            DRAWCOLOR INT(col[0] * 0.35), INT(col[1] * 0.35), INT(col[2] * 0.35)
        ELSE
            DRAWCOLOR col[0], col[1], col[2]
        ENDIF
        RECT x0 + 3, 843, 111, 54, TRUE
        IF sel$ = kind$ THEN
            DRAWCOLOR 255, 255, 0
            RECT x0 + 3, 843, 111, 54, FALSE
            RECT x0 + 4, 844, 109, 52, FALSE
        ENDIF
        DRAWCOLOR 0, 0, 0
        TEXT x0 + 10, 852, ICON$(kind$) + " " + MID$(kind$, 0, 5)
        TEXT x0 + 10, 872, STR$(cardcost{kind$}) + " elx"
        DIM hl = world{"CARDLVL"}[mypid]
        IF MAP.EXISTS(hl, kind$) THEN
            IF hl{kind$} > 1 THEN
                DRAWCOLOR 255, 255, 255
                TEXT x0 + 88, 852, "L" + STR$(hl{kind$})
            ENDIF
        ENDIF
    NEXT i
    DIM exl = world{"ELIXIR"}[mypid]
    DRAWCOLOR 30, 10, 40
    RECT 0, 832, SCR_W, 8, TRUE
    IF exl > 0 THEN
        DRAWCOLOR 210, 60, 240
        RECT 0, 832, INT(SCR_W * exl / 10.0), 8, TRUE
    ENDIF
    DRAWCOLOR 255, 255, 255
    TEXT SCR_W - 60, 812, "elx " + STR$(INT(exl))
ENDSUB

SUB DrawHud()
    DRAWCOLOR 255, 255, 255
    DIM t = world{"T_LEFT"}
    DIM label$ = ""
    IF t < 0 THEN
        label$ = "OT "
        t = 60 + t
    ENDIF
    TEXT 200, 6, label$ + STR$(INT(t / 60)) + ":" + RIGHT$("0" + STR$(INT(t) MOD 60), 2)
    DIM cr = world{"CROWNS"}
    TEXT 6, 6, "DU " + STR$(cr[mypid])
    TEXT 6, 26, foename$ + " " + STR$(cr[1 - mypid])
    IF LEN(profiles) = 2 THEN
        TEXT 300, 26, "Siege " + STR$(profiles[mypid]{"WINS"}) + ":" + STR$(profiles[1 - mypid]{"WINS"})
    ENDIF
    IF msg$ <> "" THEN
        DRAWCOLOR 255, 220, 0
        TEXT 6, 46, msg$
    ENDIF
    IF world{"PHASE"} = "over" THEN
        DRAWCOLOR 255, 255, 255
        RECT 84, 380, 300, 90, TRUE
        DIM w = world{"WINNER"}
        DRAWCOLOR 200, 30, 30
        IF w = 2 THEN
            TEXT 150, 415, "UNENTSCHIEDEN!"
        ELSEIF w = mypid THEN
            TEXT 150, 415, "DU GEWINNST!"
        ELSE
            TEXT 150, 415, foename$ + " GEWINNT!"
        ENDIF
        IF LEN(profiles) = 2 THEN
            DRAWCOLOR 40, 40, 40
            TEXT 150, 442, "Serie " + STR$(profiles[mypid]{"WINS"}) + ":" + STR$(profiles[1 - mypid]{"WINS"}) + "  Kronen " + STR$(profiles[mypid]{"CROWNS"}) + ":" + STR$(profiles[1 - mypid]{"CROWNS"})
        ENDIF
        IF chest_shown = 1 ANDALSO MAP.EXISTS(myprofile, "LASTCHEST") THEN
            DRAWCOLOR 255, 220, 60
            RECT 34, 600, 400, 54, TRUE
            DRAWCOLOR 0, 0, 0
            TEXT 44, 608, "KISTE:"
            TEXT 44, 630, CHESTLINE$(myprofile{"LASTCHEST"})
        ENDIF
        BUTTON(154, 490, 160, 46, "NOCHMAL!", 80, 210, 120)
        BUTTON(154, 548, 160, 40, "MENU", 150, 150, 180)
    ENDIF
ENDSUB

SUB DrawFrame(fnow)
    DRAWCOLOR 15, 15, 20
    RECT 0, 0, SCR_W, SCR_H, TRUE
    IF have_state = 0 ORELSE mypid < 0 THEN
        DRAWCOLOR 255, 255, 255
        TEXT 120, 430, "BASIC ROYALE"
        TEXT 120, 460, "verbinde... " + msg$
    ELSE
        DrawBoard(fnow)
        IF sel$ <> "" THEN DrawDeployZone()
        DrawTowers()
        DrawUnits()
        DrawFX(fnow)
        DrawHand()
        DrawHud()
        IF waiting = 1 THEN
            DRAWCOLOR 255, 255, 255
            RECT 84, 380, 300, 60, TRUE
            DRAWCOLOR 30, 30, 200
            TEXT 120, 402, "Warte auf Gegner..."
        ENDIF
    ENDIF
ENDSUB

SUB MenuClick(mx, my)
    IF mx >= 134 ANDALSO mx <= 334 THEN
        IF my >= 360 ANDALSO my <= 420 THEN
            uimode$ = "battle"
            mypid = -1
            tok$ = ""
            have_state = 0
            fxseen = {}
            fxact = []
            prev_tick = -1
            chest_shown = 0
            msg$ = ""
            JOINMATCH()
        ELSEIF my >= 450 ANDALSO my <= 510 THEN
            uimode$ = "decks"
            IF LEN(cardorder) = 0 THEN
                LOADCARDS()
                BAKEART()
            ENDIF
            LOADPROFILE()
        ELSEIF my >= 540 ANDALSO my <= 600 THEN
            IF snd_on = 1 THEN
                snd_on = 0
            ELSE
                SNDINIT()
            ENDIF
        ENDIF
    ENDIF
ENDSUB

SUB DeckClick(mx, my)
    IF my >= 700 ANDALSO my <= 750 ANDALSO mx >= 134 ANDALSO mx <= 334 THEN
        IF LEN(mydeck) = 6 THEN uimode$ = "menu"
    ELSEIF my >= 80 ANDALSO my < 680 THEN
        DIM ci = INT((mx - 6) / 154)
        DIM ri = INT((my - 80) / 150)
        IF ci >= 0 ANDALSO ci <= 2 ANDALSO ri >= 0 THEN
            DIM idx = ri * 3 + ci
            IF idx < LEN(cardorder) THEN
                DIM kind$ = cardorder[idx]
                DIM cellx = mx - 6 - ci * 154
                DIM celly = my - 80 - ri * 150
                DIM mc = MYCARD(kind$)
                DIM upcost = INT(2 ^ mc{"LVL"})
                IF cellx >= 108 ANDALSO celly >= 98 ANDALSO celly <= 136 ANDALSO mc{"LVL"} < 5 ANDALSO mc{"HAVE"} + MYWILD() >= upcost THEN
                    SENDUPGRADE(kind$)
                ELSE
                    TOGGLECARD(kind$)
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDSUB

SUB HandleClick(mx, my)
    IF uimode$ = "menu" THEN
        MenuClick(mx, my)
    ELSEIF uimode$ = "decks" THEN
        DeckClick(mx, my)
    ELSEIF have_state = 0 ORELSE mypid < 0 THEN
        msg$ = ""
    ELSEIF world{"PHASE"} = "over" THEN
        IF mx >= 154 ANDALSO mx <= 314 ANDALSO my >= 490 ANDALSO my <= 536 THEN SENDREMATCH()
        IF mx >= 154 ANDALSO mx <= 314 ANDALSO my >= 548 ANDALSO my <= 588 THEN uimode$ = "menu"
    ELSEIF my >= 840 THEN
        DIM slot = INT(mx / 117)
        IF slot > 3 THEN slot = 3
        sel$ = world{"QUEUES"}[mypid][slot]
        msg$ = ""
    ELSEIF my >= BOARD_Y0 THEN
        IF sel$ = "" THEN
            msg$ = "erst Karte antippen"
        ELSE
            DIM tx = mx / (TILE * 1.0)
            DIM tyv = (my - BOARD_Y0) / (TILE * 1.0)
            SENDPLAY(sel$, tx, WY(tyv))
        ENDIF
    ENDIF
ENDSUB

DIM shotmode = 0
DIM cliargs = OS.ARGS()
DIM ai
FOR ai = 0 TO LEN(cliargs) - 1
    IF LCASE$(cliargs[ai]) = "shot" THEN shotmode = 1
NEXT ai

SCREEN SCR_W, SCR_H, "BASIC Royale"
DRAWCOLOR 6, 8, 22
RECT 0, 0, SCR_W, SCR_H, TRUE
DRAWCOLOR 190, 220, 255
TEXT 120, 430, "BAUE DIE FLOTTE..."
SCREENFLIP
SNDINIT()
LOADCARDS()
BAKEART()
MAKESTARS()
LOADPROFILE()

IF shotmode = 1 THEN
    uimode$ = "battle"
    JOINMATCH()
    POLLSTATE()
    SYNCFX(0)
    DrawFrame(6)
    GFX.SAVE_SCREENSHOT("tmp/client.png")
    SCREENFLIP
    PRINT "pid: "; mypid; "  waiting: "; waiting; "  msg: "; msg$
    GFX.CLOSE
ELSE
    DO
        IF running = 0 THEN EXITDO
        frame = frame + 1
        IF uimode$ = "battle" THEN
            IF mypid < 0 ANDALSO frame MOD 30 = 0 THEN JOINMATCH()
            IF mypid >= 0 ANDALSO frame MOD 6 = 0 THEN POLLSTATE()
            SYNCFX(frame)
        ENDIF
        IF tap_new = 1 THEN
            tap_new = 0
            HandleClick(tap_x, tap_y)
        ENDIF
        IF uimode$ = "menu" THEN
            DrawMenu()
        ELSEIF uimode$ = "decks" THEN
            DrawDeckEd()
        ELSE
            DrawFrame(frame)
        ENDIF
        SCREENFLIP
        SLEEP 33
    LOOP
    GFX.CLOSE
ENDIF
