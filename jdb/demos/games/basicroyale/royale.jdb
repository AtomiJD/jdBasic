' BASIC Royale - phone/desktop client. Self-contained (no IMPORT) so a single
' file can be shared as a playground link. Renders the server state and sends
' taps; the arena rules live on the server. Each player sees their own side
' at the bottom - player 1's view is mirrored.
' Shot mode for headless checks:  jdbasic royale.jdb shot -> tmp/client.png

CONST SRV$ = "http://192.168.0.37:8081"

CONST TILE = 26
CONST BOARD_Y0 = 60
CONST SCR_W = 468
CONST SCR_H = 900

DIM running = 1
SUB OnQuit()
    running = 0
ENDSUB
ON "QUIT" CALL OnQuit

' Taps arrive as buffered MOUSEDOWN events - a finger tap is shorter than
' one frame, so polling the button state misses it. The queue also survives
' the blocking /state fetch.
DIM tap_new = 0
DIM tap_x = 0
DIM tap_y = 0
SUB OnTap(info)
    tap_x = info[0]{"x"}
    tap_y = info[0]{"y"}
    tap_new = 1
ENDSUB
ON "MOUSEDOWN" CALL OnTap

DIM kindcolor AS MAP = {}
kindcolor{"KNIGHT"} = [230, 180, 60]
kindcolor{"ARCHER"} = [120, 220, 120]
kindcolor{"GIANT"} = [200, 120, 40]
kindcolor{"MINIONS"} = [110, 170, 255]
kindcolor{"SKELETONS"} = [220, 220, 220]
kindcolor{"FIREBALL"} = [255, 90, 30]
DIM cardcost AS MAP = {}
cardcost{"KNIGHT"} = 3
cardcost{"ARCHER"} = 3
cardcost{"GIANT"} = 5
cardcost{"MINIONS"} = 3
cardcost{"SKELETONS"} = 2
cardcost{"FIREBALL"} = 4

DIM mypid = -1
DIM tok$ = ""
DIM world AS MAP = {}
DIM have_state = 0
DIM waiting = 1
DIM foename$ = ""
DIM sel$ = ""
DIM msg$ = ""
DIM fxseen AS MAP = {}
DIM fxact = []
DIM frame = 0

' Player 1 sees the board mirrored so their own side is at the bottom.
FUNC WY(y)
    IF mypid = 1 THEN RETURN 29.0 - y
    RETURN y
ENDFUNC

FUNC PX(tx)
    RETURN INT(tx * TILE)
ENDFUNC

FUNC PY(ty)
    RETURN INT(BOARD_Y0 + ty * TILE)
ENDFUNC

FUNC MINE(owner)
    RETURN IIF(owner = mypid, 1, 0)
ENDFUNC

' Costs and colors come from the server's cards.json; the hardcoded maps
' above stay as fallback when the fetch fails.
SUB LOADCARDS()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/cards")
        DIM m = JSON.PARSE$(r$)
        DIM cs = m{"CARDS"}
        DIM ks = MAP.KEYS(cs)
        FOR EACH k$ IN ks
            cardcost{k$} = cs{k$}{"COST"}
            IF MAP.EXISTS(cs{k$}, "COLOR") THEN kindcolor{k$} = cs{k$}{"COLOR"}
        NEXT k$
    CATCH
    ENDTRY
ENDSUB

SUB JOINMATCH()
    TRY
        DIM r$ = HTTP.POST$(SRV$ + "/join", JSON.STRINGIFY$({ "NAME": "Spieler" }), "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            mypid = m{"PID"}
            tok$ = m{"TOK"}
            msg$ = ""
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
        msg$ = "server? " + SRV$
    ENDTRY
ENDSUB

DIM prev_tick = -1
SUB POLLSTATE()
    TRY
        DIM r$ = HTTP.GET$(SRV$ + "/state?tok=" + tok$)
        DIM m = JSON.PARSE$(r$)
        world = m{"ST"}
        waiting = m{"WAITING"}
        have_state = 1
        DIM names = m{"NAMES"}
        IF LEN(names) = 2 THEN foename$ = names[1 - mypid]
        ' a rematch restarts event ids - drop stale FX bookkeeping
        IF world{"TICKNO"} < prev_tick THEN
            fxseen = {}
            fxact = []
            sel$ = ""
        ENDIF
        prev_tick = world{"TICKNO"}
    CATCH
        msg$ = "poll failed"
    ENDTRY
ENDSUB

SUB SENDREMATCH()
    TRY
        DIM r$ = HTTP.POST$(SRV$ + "/rematch", "{}", "text/plain")
        msg$ = ""
    CATCH
        msg$ = "rematch failed"
    ENDTRY
ENDSUB

SUB SENDPLAY(kind$, wx, wyv)
    TRY
        DIM body$ = JSON.STRINGIFY$({ "TOK": tok$, "KIND": kind$, "X": wx, "Y": wyv })
        DIM r$ = HTTP.POST$(SRV$ + "/play", body$, "text/plain")
        DIM m = JSON.PARSE$(r$)
        IF m{"OK"} = 1 THEN
            sel$ = ""
            msg$ = ""
        ELSE
            msg$ = m{"MSG"}
        ENDIF
    CATCH
        msg$ = "play failed"
    ENDTRY
ENDSUB

' Retro synth SFX on the built-in sequencer. Track 1 = UI blips, track 2 =
' shots, track 3 = noise booms. Sustain 0 lets every note fade out on its
' own, so no release bookkeeping is needed in the render loop.
DIM snd_on = 0
SUB SNDINIT()
    TRY
        SOUND.INIT
        SOUND.VOICE 1, "SQUARE", 0.005, 0.08, 0.0, 0.05
        SOUND.VOICE 2, "SQUARE", 0.002, 0.05, 0.0, 0.03
        SOUND.VOICE 3, "NOISE", 0.005, 0.25, 0.0, 0.2
        SOUND.GAIN 1, 0.5
        SOUND.GAIN 2, 0.3
        SOUND.GAIN 3, 0.6
        snd_on = 1
    CATCH
        snd_on = 0
    ENDTRY
ENDSUB

SUB PLAYFX(t$)
    IF snd_on = 1 THEN
        TRY
            IF t$ = "SPAWN" THEN
                SOUND.PLAY 1, 330
            ELSEIF t$ = "SHOT" THEN
                SOUND.PLAY 2, 880
            ELSEIF t$ = "HIT" THEN
                SOUND.PLAY 2, 220
            ELSEIF t$ = "CAST" THEN
                SOUND.PLAY 1, 550
            ELSEIF t$ = "BOOM" THEN
                SOUND.PLAY 3, 80
            ELSEIF t$ = "DIE" THEN
                SOUND.PLAY 3, 200
            ELSEIF t$ = "FALL" THEN
                SOUND.PLAY 3, 50
            ENDIF
        CATCH
            snd_on = 0
        ENDTRY
    ENDIF
ENDSUB

' HP bar with a health gradient: green, then yellow, then red.
SUB DrawBar(x, y, w, frac)
    DRAWCOLOR 20, 20, 20
    RECT x, y, w, 5, TRUE
    IF frac > 0 THEN
        IF frac > 0.5 THEN
            DRAWCOLOR 90, 240, 90
        ELSEIF frac > 0.2 THEN
            DRAWCOLOR 240, 210, 60
        ELSE
            DRAWCOLOR 240, 70, 50
        ENDIF
        RECT x, y, INT(w * frac), 5, TRUE
    ENDIF
ENDSUB

' Collect unseen sim events into the local FX list (dedup by EID) and give
' each fresh event its sound - shots capped at 2 per batch to avoid spam.
SUB SYNCFX(fnow)
    IF have_state = 1 THEN
        DIM n_shots = 0
        FOR EACH evt IN world{"EVENTS"}
            DIM k$ = STR$(evt{"EID"})
            IF NOT MAP.EXISTS(fxseen, k$) THEN
                fxseen{k$} = 1
                fxact = APPEND(fxact, { "EV": evt, "T0": fnow })
                IF evt{"T"} = "SHOT" THEN
                    n_shots = n_shots + 1
                    IF n_shots <= 2 THEN PLAYFX("SHOT")
                ELSE
                    PLAYFX(evt{"T"})
                ENDIF
            ENDIF
        NEXT evt
    ENDIF
ENDSUB

SUB DrawFX(fnow)
    DIM keep = []
    FOR EACH fx IN fxact
        DIM evt = fx{"EV"}
        DIM t$ = evt{"T"}
        DIM age = fnow - fx{"T0"}
        DIM dur = 8
        IF t$ = "BOOM" THEN dur = 14
        IF t$ = "CAST" THEN dur = 15
        IF t$ = "FALL" THEN dur = 22
        IF t$ = "HIT" THEN dur = 6
        IF t$ = "DIE" THEN dur = 10
        IF age <= dur THEN
            DIM p = age / (dur * 1.0)
            DIM ex = PX(evt{"X"})
            DIM ey = PY(WY(evt{"Y"}))
            IF t$ = "SHOT" THEN
                DIM x1 = PX(evt{"FX"}) + INT((ex - PX(evt{"FX"})) * p)
                DIM y1 = PY(WY(evt{"FY"})) + INT((ey - PY(WY(evt{"FY"}))) * p)
                DRAWCOLOR 255, 255, 160
                CIRCLE x1, y1, 3, TRUE
                IF p > 0.7 THEN
                    DRAWCOLOR 255, 255, 255
                    TEXT ex + 8, ey - 14 - INT(p * 10), STR$(evt{"D"})
                ENDIF
            ELSEIF t$ = "CAST" THEN
                DIM x2 = PX(evt{"FX"}) + INT((ex - PX(evt{"FX"})) * p)
                DIM y2 = PY(WY(evt{"FY"})) + INT((ey - PY(WY(evt{"FY"}))) * p)
                DRAWCOLOR 255, 140, 30
                CIRCLE x2, y2, 7, TRUE
                DRAWCOLOR 255, 220, 90
                CIRCLE x2, y2, 4, TRUE
            ELSEIF t$ = "BOOM" THEN
                DRAWCOLOR 255, 120, 30
                CIRCLE ex, ey, INT(6 + p * evt{"RADIUS"} * TILE), FALSE
                DRAWCOLOR 255, 200, 60
                CIRCLE ex, ey, INT(3 + p * evt{"RADIUS"} * TILE * 0.7), FALSE
                DRAWCOLOR 255, 255, 255
                TEXT ex - 12, ey - 24 - INT(p * 14), STR$(evt{"D"})
            ELSEIF t$ = "HIT" THEN
                DIM s = 4 + INT(p * 6)
                DRAWCOLOR 255, 240, 120
                LINE ex - s, ey - s, ex + s, ey + s
                LINE ex - s, ey + s, ex + s, ey - s
                LINE ex - s, ey, ex + s, ey
                DRAWCOLOR 255, 255, 255
                TEXT ex + 8, ey - 14 - INT(p * 12), STR$(evt{"D"})
            ELSEIF t$ = "DIE" THEN
                DRAWCOLOR 200, 200, 200
                CIRCLE ex, ey, INT(4 + p * 14), FALSE
            ELSEIF t$ = "SPAWN" THEN
                DRAWCOLOR 255, 255, 255
                CIRCLE ex, ey, INT(16 - p * 12), FALSE
            ELSEIF t$ = "FALL" THEN
                DRAWCOLOR 255, 160, 40
                CIRCLE ex, ey, INT(8 + p * 40), FALSE
                DRAWCOLOR 120, 120, 120
                CIRCLE ex, ey, INT(4 + p * 26), FALSE
            ENDIF
            keep = APPEND(keep, fx)
        ENDIF
    NEXT fx
    fxact = keep
ENDSUB

SUB DrawBoard(fnow)
    DIM r
    DIM c
    FOR r = 0 TO 29
        FOR c = 0 TO 17
            IF r = 14 ORELSE r = 15 THEN
                DRAWCOLOR 40, 90 + INT(20 * SIN(fnow * 0.15 + c * 0.7)), 170
            ELSEIF (r + c) MOD 2 = 0 THEN
                DRAWCOLOR 60, 130, 70
            ELSE
                DRAWCOLOR 54, 120, 64
            ENDIF
            RECT c * TILE, BOARD_Y0 + r * TILE, TILE, TILE, TRUE
        NEXT c
    NEXT r
    DRAWCOLOR 150, 110, 60
    RECT PX(2.5), PY(14), TILE * 2, TILE * 2, TRUE
    RECT PX(13.5), PY(14), TILE * 2, TILE * 2, TRUE
ENDSUB

SUB DrawTowers()
    FOR EACH tw IN world{"TOWERS"}
        IF tw{"HP"} <= 0 THEN CONTINUEFOR
        DIM asleep = 0
        IF tw{"KIND"} = "KING" ANDALSO tw{"AWAKE"} = 0 THEN asleep = 1
        IF MINE(tw{"OWNER"}) = 1 THEN
            IF asleep = 1 THEN
                DRAWCOLOR 40, 60, 130
            ELSE
                DRAWCOLOR 70, 110, 230
            ENDIF
        ELSE
            IF asleep = 1 THEN
                DRAWCOLOR 130, 45, 45
            ELSE
                DRAWCOLOR 230, 80, 80
            ENDIF
        ENDIF
        DIM sz = TILE * 2
        IF tw{"KIND"} = "KING" THEN sz = INT(TILE * 2.4)
        DIM x0 = PX(tw{"X"}) - sz / 2
        DIM y0 = PY(WY(tw{"Y"})) - sz / 2
        RECT x0, y0, sz, sz, TRUE
        DRAWCOLOR 0, 0, 0
        RECT x0, y0, sz, sz, FALSE
        IF asleep = 1 THEN
            DRAWCOLOR 220, 220, 240
            TEXT x0 + sz - 20, y0 + 4, "Zz"
        ENDIF
        DrawBar(x0, y0 - 8, sz, tw{"HP"} / tw{"MAXHP"})
    NEXT tw
ENDSUB

SUB DrawUnits()
    FOR EACH u IN world{"UNITS"}
        DIM col = kindcolor{u{"KIND"}}
        IF MINE(u{"OWNER"}) = 1 THEN
            DRAWCOLOR 70, 110, 230
        ELSE
            DRAWCOLOR 230, 80, 80
        ENDIF
        DIM ux = PX(u{"X"})
        DIM uy = PY(WY(u{"Y"}))
        IF MAP.EXISTS(u, "AT") THEN
            IF world{"TICKNO"} - u{"AT"} <= 2 THEN
                DIM lgy = u{"ADY"}
                IF mypid = 1 THEN lgy = -lgy
                ux = ux + INT(u{"ADX"} * 5)
                uy = uy + INT(lgy * 5)
            ENDIF
        ENDIF
        CIRCLE ux, uy, 11, TRUE
        DRAWCOLOR col[0], col[1], col[2]
        CIRCLE ux, uy, 8, TRUE
        DrawBar(ux - 10, uy - 18, 20, u{"HP"} / u{"MAXHP"})
        DRAWCOLOR 0, 0, 0
        TEXT ux - 4, uy - 6, MID$(u{"KIND"}, 0, 1)
    NEXT u
ENDSUB

SUB DrawHand()
    DIM q = world{"QUEUES"}[mypid]
    DIM i
    FOR i = 0 TO 3
        DIM kind$ = q[i]
        DIM col = kindcolor{kind$}
        DIM x0 = i * 117
        IF world{"ELIXIR"}[mypid] < cardcost{kind$} THEN
            DRAWCOLOR INT(col[0] * 0.35), INT(col[1] * 0.35), INT(col[2] * 0.35)
        ELSE
            DRAWCOLOR col[0], col[1], col[2]
        ENDIF
        RECT x0 + 3, 843, 111, 54, TRUE
        IF sel$ = kind$ THEN
            DRAWCOLOR 255, 255, 0
            RECT x0 + 3, 843, 111, 54, FALSE
            RECT x0 + 4, 844, 109, 52, FALSE
        ENDIF
        DRAWCOLOR 0, 0, 0
        TEXT x0 + 10, 852, MID$(kind$, 0, 6)
        TEXT x0 + 10, 872, STR$(cardcost{kind$}) + " elx"
    NEXT i
    DIM exl = world{"ELIXIR"}[mypid]
    DRAWCOLOR 30, 10, 40
    RECT 0, 832, SCR_W, 8, TRUE
    IF exl > 0 THEN
        DRAWCOLOR 210, 60, 240
        RECT 0, 832, INT(SCR_W * exl / 10.0), 8, TRUE
    ENDIF
    DRAWCOLOR 255, 255, 255
    TEXT SCR_W - 60, 812, "elx " + STR$(INT(exl))
ENDSUB

SUB DrawHud()
    DRAWCOLOR 255, 255, 255
    DIM t = world{"T_LEFT"}
    DIM label$ = ""
    IF t < 0 THEN
        label$ = "OT "
        t = 60 + t
    ENDIF
    TEXT 200, 6, label$ + STR$(INT(t / 60)) + ":" + RIGHT$("0" + STR$(INT(t) MOD 60), 2)
    DIM cr = world{"CROWNS"}
    TEXT 6, 6, "DU " + STR$(cr[mypid])
    TEXT 6, 26, foename$ + " " + STR$(cr[1 - mypid])
    IF msg$ <> "" THEN
        DRAWCOLOR 255, 220, 0
        TEXT 6, 46, msg$
    ENDIF
    IF world{"PHASE"} = "over" THEN
        DRAWCOLOR 255, 255, 255
        RECT 84, 380, 300, 90, TRUE
        DIM w = world{"WINNER"}
        DRAWCOLOR 200, 30, 30
        IF w = 2 THEN
            TEXT 150, 415, "UNENTSCHIEDEN!"
        ELSEIF w = mypid THEN
            TEXT 150, 415, "DU GEWINNST!"
        ELSE
            TEXT 150, 415, foename$ + " GEWINNT!"
        ENDIF
        DRAWCOLOR 60, 180, 60
        RECT 154, 490, 160, 46, TRUE
        DRAWCOLOR 255, 255, 255
        RECT 154, 490, 160, 46, FALSE
        TEXT 190, 506, "NOCHMAL!"
    ENDIF
ENDSUB

SUB DrawFrame(fnow)
    DRAWCOLOR 15, 15, 20
    RECT 0, 0, SCR_W, SCR_H, TRUE
    IF have_state = 0 ORELSE mypid < 0 THEN
        DRAWCOLOR 255, 255, 255
        TEXT 120, 430, "BASIC ROYALE"
        TEXT 120, 460, "verbinde... " + msg$
    ELSE
        DrawBoard(fnow)
        IF sel$ <> "" THEN
            DRAWCOLOR 255, 255, 0
            RECT 0, PY(16), SCR_W, TILE * 14, FALSE
        ENDIF
        DrawTowers()
        DrawUnits()
        DrawFX(fnow)
        DrawHand()
        DrawHud()
        IF waiting = 1 THEN
            DRAWCOLOR 255, 255, 255
            RECT 84, 380, 300, 60, TRUE
            DRAWCOLOR 30, 30, 200
            TEXT 120, 402, "Warte auf Gegner..."
        ENDIF
    ENDIF
ENDSUB

SUB HandleClick(mx, my)
    IF have_state = 0 ORELSE mypid < 0 THEN
        msg$ = ""
    ELSEIF world{"PHASE"} = "over" THEN
        IF mx >= 154 ANDALSO mx <= 314 ANDALSO my >= 490 ANDALSO my <= 536 THEN SENDREMATCH()
    ELSEIF my >= 840 THEN
        DIM slot = INT(mx / 117)
        IF slot > 3 THEN slot = 3
        sel$ = world{"QUEUES"}[mypid][slot]
        msg$ = ""
    ELSEIF my >= BOARD_Y0 THEN
        IF sel$ = "" THEN
            msg$ = "erst Karte antippen"
        ELSE
            DIM tx = mx / (TILE * 1.0)
            DIM tyv = (my - BOARD_Y0) / (TILE * 1.0)
            SENDPLAY(sel$, tx, WY(tyv))
        ENDIF
    ENDIF
ENDSUB

DIM shotmode = 0
DIM cliargs = OS.ARGS()
DIM ai
FOR ai = 0 TO LEN(cliargs) - 1
    IF LCASE$(cliargs[ai]) = "shot" THEN shotmode = 1
NEXT ai

SCREEN SCR_W, SCR_H, "BASIC Royale"
SNDINIT()
LOADCARDS()
JOINMATCH()

IF shotmode = 1 THEN
    POLLSTATE()
    SYNCFX(0)
    DrawFrame(6)
    GFX.SAVE_SCREENSHOT("tmp/client.png")
    SCREENFLIP
    PRINT "pid: "; mypid; "  waiting: "; waiting; "  msg: "; msg$
    GFX.CLOSE
ELSE
    DO
        IF running = 0 THEN EXITDO
        frame = frame + 1
        IF mypid < 0 ANDALSO frame MOD 30 = 0 THEN JOINMATCH()
        IF mypid >= 0 ANDALSO frame MOD 6 = 0 THEN POLLSTATE()
        SYNCFX(frame)
        IF tap_new = 1 THEN
            tap_new = 0
            HandleClick(tap_x, tap_y)
        ENDIF
        DrawFrame(frame)
        SCREENFLIP
        SLEEP 33
    LOOP
    GFX.CLOSE
ENDIF
