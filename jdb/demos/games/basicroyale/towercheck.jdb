' What a card actually takes off a station, measured instead of reasoned.
'
'   jdbasic towercheck.jdb [KARTE ...]
'
' Each card is dropped in front of the enemy left tower and the match is run
' until the attacker is gone or nothing has changed for a while. Reported is
' what the tower lost, which is the number BUILDMUL exists to control.

IMPORT ARENA

DIM raw$ = ""
TRY
    raw$ = TXTREADER$("cards.json")
CATCH
    PRINT "cards.json not readable"
    END
ENDTRY
ARENA.SETCARDS(JSON.PARSE$(raw$))

DIM cs = ARENA.CARDS()
DIM args = OS.ARGS()
DIM list$ = ["PLASMA", "SALVE", "SOG", "TRABANT", "GLUTREGEN", "DROID"]
DIM guard$ = ""
DIM sidedrop = 0
IF LEN(args) > 1 THEN
    list$ = []
    DIM ai = 1
    DO WHILE ai < LEN(args)
        IF args[ai] = "-d" THEN
            ai = ai + 1
            guard$ = UCASE$(args[ai])
        ELSEIF args[ai] = "-l" THEN
            sidedrop = 1
        ELSE
            list$ = APPEND(list$, [UCASE$(args[ai])])
        ENDIF
        ai = ai + 1
    LOOP
ENDIF

' The defender's left station. A spell is aimed straight at it, a ship has to
' start in its owner's half and walk, which is the only honest way to see what
' arrives.
CONST TW_X = 3.5
CONST TW_Y = 6.5
CONST MID_X = 9.0
CONST WALK_Y = 16.0
CONST MAX_TICKS = 900

PRINT ""
PRINT "Schaden an der Station (1400 Huelle), Angreifer von Spieler 0"
PRINT ""
PRINT "Karte          Elix  links + rechts = gesamt   Zeit    Ende"

DIM ci
FOR ci = 0 TO LEN(list$) - 1
    DIM kind$ = list$[ci]
    IF NOT MAP.EXISTS(cs, kind$) THEN
        PRINT kind$; " gibt es nicht"
        CONTINUEFOR
    ENDIF

    DIM st = ARENA.NEWGAME()
    st{"PHASE"} = "play"
    st{"QUEUES"}[0] = [kind$, "DROID", "LASER", "KOLOSS"]
    st{"ELIXIR"} = [10.0, 10.0]

    ' One defender, and deliberately only in the left lane: whatever the
    ' right station still loses is what the attacker does unanswered, in the
    ' same run.
    IF guard$ <> "" THEN
        st{"QUEUES"}[1] = [guard$, "DROID", "LASER", "KOLOSS"]
        DIM gwhy$ = ARENA.PLAYCARD(st, 1, guard$, TW_X, 10.0)
        IF gwhy$ <> "" THEN PRINT "Verteidiger abgelehnt: "; gwhy$
    ENDIF

    DIM c = cs{kind$}
    DIM dy = WALK_Y
    DIM dx = TW_X
    IF MAP.EXISTS(c, "SPELL") THEN dy = TW_Y
    ' a card that splits belongs in the middle, which is the whole point of
    ' it; -l drops it over the left lane instead, to see the other case
    IF MAP.EXISTS(c, "LANESPLIT") ANDALSO sidedrop = 0 THEN dx = MID_X
    DIM msg$ = ARENA.PLAYCARD(st, 0, kind$, dx, dy)
    IF msg$ <> "" THEN
        PRINT kind$; " nicht spielbar: "; msg$
        CONTINUEFOR
    ENDIF

    DIM t
    DIM ended$ = "Zeit abgelaufen"
    DIM ticks = 0
    FOR t = 1 TO MAX_TICKS
        st = ARENA.SIMSTEP(st)
        ticks = t
        ' the run is over once the attacker is gone: for a spell that is the
        ' tick after it lands, for a ship the tick it dies or kills the tower
        DIM alive = 0
        FOR EACH u IN st{"UNITS"}
            IF u{"OWNER"} = 0 ANDALSO u{"HP"} > 0 THEN alive = 1
        NEXT u
        IF MAP.EXISTS(c, "SPELL") THEN
            IF LEN(st{"SPELLS"}) = 0 THEN
                ended$ = "Zauber verpufft"
                EXITFOR
            ENDIF
        ELSEIF alive = 0 THEN
            ended$ = "Angreifer tot"
            EXITFOR
        ENDIF
        DIM twl = st{"TOWERS"}[3]
        DIM twr = st{"TOWERS"}[4]
        IF twl{"HP"} <= 0 ORELSE twr{"HP"} <= 0 THEN
            ended$ = "Station gefallen"
            EXITFOR
        ENDIF
    NEXT t

    DIM tl = st{"TOWERS"}[3]
    DIM tr = st{"TOWERS"}[4]
    DIM lostl = 1400 - tl{"HP"}
    DIM lostr = 1400 - tr{"HP"}
    IF lostl < 0 THEN lostl = 0
    IF lostr < 0 THEN lostr = 0
    DIM pad$ = kind$ + "               "
    PRINT LEFT$(pad$, 15); c{"COST"}; "     "; lostl; " + "; lostr; " = "; lostl + lostr; "    "; INT(ticks) / 10; " s   "; ended$
NEXT ci

PRINT ""
PRINT "Ein Treffer aus dem Stand, ohne Verteidigung und ohne Rudel."
