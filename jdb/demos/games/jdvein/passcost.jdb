' What a tick costs, in the only currency this engine has.
'
'   jdbasic passcost.jdb
'
' One pass is one whole-grid elementwise operation. Everything is quoted
' against a measured reference pass on the same grid, so the numbers stay
' honest when the rules change: nothing here counts lines of source.
IMPORT VEIN
IMPORT VPAINT

DIM load_why$ = VEIN.LOADDATA()
IF load_why$ <> "" THEN
    PRINT load_why$
    END
ENDIF

' The rules run at this rate, the picture does not have to.
CONST HZ = 20
CONST REPS = 60

FUNC BARE(st)
    DIM keys$ = ["SRC", "SINK", "MACH", "MACHIN", "MACHOUT", "MACHCD0", "CD"]
    DIM i
    FOR i = 0 TO LEN(keys$) - 1
        st{keys$[i]} = st{keys$[i]} * 0
    NEXT i
    RETURN VEIN.REBUILD(st)
ENDFUNC

' A layout of the wanted size, generated so the shape is identical at every
' size and the rows can be compared.
FUNC LAYOUTOF(n)
    DIM all = VEIN.LAYOUTS()
    DIM spec AS MAP = { "N": n, "GEN": { "KIND": "SERPENTINE", "LANE": 8, _
        "MACHSTEP": 12, "MACH": "SCHMELZE", "SRCSTEP": 48, "GOOD": "REGOLITH", "PLAYER": 1 } }
    all{"MESS"} = spec
    VEIN.SETLAYOUTS(all)
    RETURN VEIN.NEWGAME("MESS")
ENDFUNC

PRINT ""
PRINT "jdVEIN - was ein Tick kostet"
PRINT ""
PRINT "Gitter   1 Durchlauf   Baender      Maschinen+Haefen   Malen        Tick"
PRINT "         ms            ms / Durchl  ms / Durchl        ms / Durchl  ms / Durchl"

DIM sizes = [64, 128, 256]
DIM si
FOR si = 0 TO LEN(sizes) - 1
    DIM n = sizes[si]
    DIM full = LAYOUTOF(n)
    DIM plain = BARE(LAYOUTOF(n))

    ' fill both lines before measuring: an empty belt is not what is played
    DIM warm
    FOR warm = 1 TO 250
        full = VEIN.ADVANCE(full)
    NEXT warm
    plain{"ITEM"} = (plain{"DIR"} > 0) * 1

    ' The reference: one elementwise operation over the whole grid. Every
    ' number in the row is quoted against it, so it is measured twice and the
    ' first run thrown away - a short reference makes the whole table wobble.
    DIM probe = full{"ITEM"} + 0
    DIM k
    FOR k = 1 TO 200
        DIM warmone = probe * 2
    NEXT k
    DIM t0 = TICK()
    FOR k = 1 TO 800
        DIM one = probe * 2
    NEXT k
    DIM ms_pass = (TICK() - t0) / 800.0

    t0 = TICK()
    FOR k = 1 TO REPS
        plain = VEIN.ADVANCE(plain)
    NEXT k
    DIM ms_belt = (TICK() - t0) / REPS

    t0 = TICK()
    FOR k = 1 TO REPS
        full = VEIN.ADVANCE(full)
    NEXT k
    DIM ms_full = (TICK() - t0) / REPS

    DIM base = VPAINT.BASE(full)
    t0 = TICK()
    FOR k = 1 TO REPS
        DIM pix = VPAINT.FRAME(base, full)
    NEXT k
    DIM ms_paint = (TICK() - t0) / REPS

    DIM ms_rest = ms_full - ms_belt
    IF ms_rest < 0 THEN ms_rest = 0
    DIM pad$ = STR$(n) + "x" + STR$(n) + "        "
    PRINT LEFT$(pad$, 9); _
        INT(ms_pass * 1000) / 1000.0; "        "; _
        INT(ms_belt * 10) / 10.0; " / "; INT(ms_belt / ms_pass); "       "; _
        INT(ms_rest * 10) / 10.0; " / "; INT(ms_rest / ms_pass); "            "; _
        INT(ms_paint * 10) / 10.0; " / "; INT(ms_paint / ms_pass); "       "; _
        INT(ms_full * 10) / 10.0; " / "; INT(ms_full / ms_pass)
NEXT si

PRINT ""
DIM budget_ms = 1000.0 / HZ
PRINT "Bei "; HZ; " Hz hat ein Tick "; budget_ms; " ms."
DIM ref = LAYOUTOF(128)
DIM p128 = ref{"ITEM"} + 0
DIM warmj
FOR warmj = 1 TO 200
    DIM warm2 = p128 * 2
NEXT warmj
DIM t1 = TICK()
DIM j
FOR j = 1 TO 800
    DIM one2 = p128 * 2
NEXT j
DIM pass128 = (TICK() - t1) / 800.0
PRINT "Auf 128x128 kostet ein Durchlauf "; INT(pass128 * 1000) / 1000.0; " ms,"
PRINT "das Budget sind also rund "; INT(budget_ms / pass128); " Durchlaeufe je Tick."
PRINT ""
