' Assertions for the jdVEIN rules. Every claim the module makes is checked
' here against something independent: the mover against a plain scalar walk,
' conservation against a count, the recipe chain against a hand-computed
' delivery, and the data drive against an edited parts table.
'   jdbasic vein_test.jdb
IMPORT VEIN

DIM load_why$ = VEIN.LOADDATA()
IF load_why$ <> "" THEN
    PRINT load_why$
    END
ENDIF

DIM pass = 0
DIM fail = 0
SUB CHECK(what$, got$, want$)
    IF got$ = want$ THEN
        pass = pass + 1
    ELSE
        fail = fail + 1
        PRINT "FAIL "; what$; "  got ["; got$; "] want ["; want$; "]"
    ENDIF
ENDSUB

' The independent reference: one cell at a time, no arrays involved.
FUNC WALKONE(dirg, r, c, steps)
    DIM i
    FOR i = 1 TO steps
        DIM d = dirg[r][c]
        IF d = 0 THEN RETURN [r, c]
        DIM nr = r + VEIN.DROF(d)
        DIM nc = c + VEIN.DCOF(d)
        IF dirg[nr][nc] = 0 THEN RETURN [r, c]
        r = nr
        c = nc
    NEXT i
    RETURN [r, c]
ENDFUNC

' Belts and nothing else: a scalar walk knows about direction, not about
' furnaces, so the reference only holds on a bare line.
FUNC BARE(st)
    DIM keys$ = ["SRC", "SINK", "MACH", "MACHIN", "MACHOUT", "MACHCD0", "CD"]
    DIM i
    FOR i = 0 TO LEN(keys$) - 1
        st{keys$[i]} = st{keys$[i]} * 0
    NEXT i
    RETURN VEIN.REBUILD(st)
ENDFUNC

PRINT "--- the mover against a scalar walk"

DIM st = BARE(VEIN.NEWGAME("SCHLANGE40"))
DIM itemg = st{"ITEM"}
itemg[8][2] = 1
st{"ITEM"} = itemg

DIM steps_n = 60
DIM t
FOR t = 1 TO steps_n
    st = VEIN.ADVANCE(st)
NEXT t

DIM ref = VEIN.NEWGAME("SCHLANGE40")
DIM want = WALKONE(ref{"DIR"}, 8, 2, steps_n)
DIM got = VEIN.FINDGOOD(st)
CHECK("the good lands where a scalar walk lands", _
    STR$(got[0]) + "," + STR$(got[1]), STR$(want[0]) + "," + STR$(want[1]))
CHECK("and there is still exactly one", STR$(VEIN.COUNTGOODS(st)), "1")

PRINT "--- a packed belt loses and duplicates nothing"

DIM st2 = BARE(VEIN.NEWGAME("SCHLANGE40"))
st2{"ITEM"} = (st2{"DIR"} > 0) * 1
DIM before = VEIN.COUNTGOODS(st2)
FOR t = 1 TO 30
    st2 = VEIN.ADVANCE(st2)
NEXT t
CHECK("every cell loaded, thirty ticks", STR$(VEIN.COUNTGOODS(st2)), STR$(before))
CHECK("  and the belt was not empty to begin with", STR$(before > 100), "TRUE")

PRINT "--- the recipe consumes what it says it consumes"

' A furnace wants two ore for one ingot. Four ore in, two ingots out, and the
' board empty afterwards: anything else means the buffer arithmetic is wrong.
DIM st3 = VEIN.NEWGAME("KETTE")
st3{"SRC"} = st3{"SRC"} * 0
st3 = VEIN.REBUILD(st3)
DIM i3 = st3{"ITEM"}
DIM ci
FOR ci = 3 TO 6
    i3[10][ci] = VEIN.GOODID("REGOLITH")
NEXT ci
st3{"ITEM"} = i3
FOR t = 1 TO 200
    st3 = VEIN.ADVANCE(st3)
NEXT t
CHECK("four ore made two ingots", STR$(st3{"DELIVERED"}[1]), "2")
CHECK("booked at the ingot's worth", STR$(st3{"SCORE"}[1]), "10")
CHECK("nothing left on the board", STR$(VEIN.COUNTGOODS(st3)), "0")
CHECK("and nothing left in a buffer", STR$(VEIN.INBUFFERS(st3)), "0")

PRINT "--- the line under load"

' A source that outruns the furnace fills its buffer, and what the buffer
' cannot take rides past. That is deliberate: a full machine must not be able
' to deadlock the line it stands on. The port sees the difference.
DIM st4 = VEIN.NEWGAME("KETTE")
FOR t = 1 TO 400
    st4 = VEIN.ADVANCE(st4)
NEXT t
DIM n_del = st4{"DELIVERED"}[1]
CHECK("the port keeps receiving", STR$(n_del > 3), "TRUE")
CHECK("ingots arrive", STR$(VEIN.GOTBY(st4, 1, "BARREN") > 0), "TRUE")
CHECK("raw ore rides past a busy furnace", STR$(VEIN.GOTBY(st4, 1, "REGOLITH") > 0), "TRUE")
CHECK("and the two add up to the crate count", _
    STR$(VEIN.GOTBY(st4, 1, "BARREN") + VEIN.GOTBY(st4, 1, "REGOLITH")), STR$(n_del))
CHECK("the score is what the books say", STR$(st4{"SCORE"}[1]), _
    STR$(VEIN.GOTBY(st4, 1, "BARREN") * 5 + VEIN.GOTBY(st4, 1, "REGOLITH")))

PRINT "--- a seam is finite"

' The gate for this phase: a scripted layout delivers a known count, and the
' count is the deposit. Twelve in the ground, twelve in the port, nothing
' anywhere else.
DIM st9 = VEIN.NEWGAME("GRUBE")
CHECK("the deposit starts at twelve", STR$(VEIN.ORELEFT(st9)), "12")
FOR t = 1 TO 300
    st9 = VEIN.ADVANCE(st9)
NEXT t
CHECK("the seam is empty", STR$(VEIN.ORELEFT(st9)), "0")
CHECK("twelve were dug", STR$(st9{"MINED"}), "12")
CHECK("twelve reached the port", STR$(st9{"DELIVERED"}[1]), "12")
CHECK("nothing is still travelling", STR$(VEIN.COUNTGOODS(st9)), "0")

DIM before9 = st9{"DELIVERED"}[1]
FOR t = 1 TO 200
    st9 = VEIN.ADVANCE(st9)
NEXT t
CHECK("and an empty seam stays empty", STR$(st9{"DELIVERED"}[1]), STR$(before9))

PRINT "--- a drill only works its own seam"

DIM st10 = VEIN.NEWGAME("FALSCHERBOHRER")
FOR t = 1 TO 200
    st10 = VEIN.ADVANCE(st10)
NEXT t
CHECK("the wrong drill digs nothing", STR$(st10{"MINED"}), "0")
CHECK("and the crystal is untouched", STR$(VEIN.ORELEFT(st10)), "12")

PRINT "--- a recipe with two inputs"

DIM st11 = VEIN.NEWGAME("WERK")
FOR t = 1 TO 600
    st11 = VEIN.ADVANCE(st11)
NEXT t
CHECK("the works make finished parts", STR$(VEIN.GOTBY(st11, 1, "ZUENDKERN") > 3), "TRUE")
CHECK("which needed both seams", STR$(st11{"MINED"} > 0), "TRUE")

' The same works with the crystal branch missing. This is the 2v2 rule in a
' unit test: without the partner's input the chain tops out, however long it
' runs, and the press sits on a pile it cannot use.
DIM st12 = VEIN.NEWGAME("WERKHALB")
FOR t = 1 TO 600
    st12 = VEIN.ADVANCE(st12)
NEXT t
CHECK("half a chain makes no finished part", STR$(VEIN.GOTBY(st12, 1, "ZUENDKERN")), "0")
CHECK("  and the press is left holding stock", STR$(VEIN.INBUFFERS(st12) > 0), "TRUE")

PRINT "--- building and unbuilding"

DIM st5 = VEIN.NEWGAME("KETTE")
CHECK("a belt goes down", VEIN.PLACE(st5, 20, 20, "BAHN", 2), "")
CHECK("off the grid is refused", VEIN.PLACE(st5, -1, 20, "BAHN", 2), "msg_offgrid")
CHECK("an unknown part is refused", VEIN.PLACE(st5, 20, 21, "GLEITKISSEN", 2), "msg_unknown")
CHECK("a part without a direction is refused", VEIN.PLACE(st5, 20, 21, "BAHN", 0), "msg_nodir")
DIM built = VEIN.COUNTBUILT(st5)
DIM w5$ = VEIN.UNBUILD(st5, 20, 20)
CHECK("and comes up again", STR$(VEIN.COUNTBUILT(st5)), STR$(built - 1))

PRINT "--- the data drives the rules"

' Same layout, one number changed in the parts table: a furnace that works
' four ticks faster has to deliver sooner. Nothing in vein.jdb knows this.
DIM p = VEIN.PARTS()
DIM quick = JSON.PARSE$(JSON.STRINGIFY$(p))
quick{"machines"}{"SCHMELZE"}{"DWELL"} = 2

' Refined output is what has to grow, not crate count: a slow furnace lets
' more raw ore ride past, which would flatter the crate count.
DIM st6 = VEIN.NEWGAME("KETTE")
FOR t = 1 TO 120
    st6 = VEIN.ADVANCE(st6)
NEXT t
DIM slow_ing = VEIN.GOTBY(st6, 1, "BARREN")

VEIN.SETPARTS(quick)
DIM st7 = VEIN.NEWGAME("KETTE")
FOR t = 1 TO 120
    st7 = VEIN.ADVANCE(st7)
NEXT t
DIM fast_ing = VEIN.GOTBY(st7, 1, "BARREN")
VEIN.SETPARTS(p)
CHECK("a faster furnace refines more", STR$(fast_ing > slow_ing), "TRUE")

PRINT "--- a state survives the round trip"

DIM st8 = VEIN.NEWGAME("KETTE")
FOR t = 1 TO 50
    st8 = VEIN.ADVANCE(st8)
NEXT t
DIM copy = JSON.PARSE$(JSON.STRINGIFY$(st8))
copy = VEIN.REBUILD(copy)
FOR t = 1 TO 50
    st8 = VEIN.ADVANCE(st8)
    copy = VEIN.ADVANCE(copy)
NEXT t
CHECK("written out and read back, it runs the same", _
    STR$(copy{"DELIVERED"}[1]) + "/" + STR$(VEIN.COUNTGOODS(copy)), _
    STR$(st8{"DELIVERED"}[1]) + "/" + STR$(VEIN.COUNTGOODS(st8)))

PRINT "--- a drag lays a run and turns the corner"

DIM st13 = VEIN.NEWGAME("REVIER40")
DIM base13 = VEIN.COUNTBUILT(st13)
DIM w13$ = VEIN.APPLY(st13, { "T": "DRAG", "R": 6, "C": 6, "R2": 6, "C2": 34 })
CHECK("a straight drag is accepted", w13$, "")
CHECK("and lays every cell it crossed", STR$(VEIN.COUNTBUILT(st13) - base13), "29")

DIM st14 = VEIN.NEWGAME("REVIER40")
DIM base14 = VEIN.COUNTBUILT(st14)
DIM w14$ = VEIN.APPLY(st14, { "T": "DRAG", "R": 6, "C": 6, "R2": 16, "C2": 16 })
DIM d14 = st14{"DIR"}
CHECK("a corner drag runs east first", STR$(d14[6][10]), "2")
CHECK("  turns at the corner", STR$(d14[6][16]), "3")
CHECK("  and carries on south", STR$(d14[12][16]), "3")
CHECK("  for the right number of cells", STR$(VEIN.COUNTBUILT(st14) - base14), "21")

DIM w15$ = VEIN.APPLY(st14, { "T": "SPRENGEN", "R": 1, "C": 1 })
CHECK("an unknown command is refused", w15$, "msg_badcmd")

PRINT "--- a whole factory, built by command only"

' Nothing below reaches into a state. This is the gate for the phase: the log
' is the match, and replaying it has to land on the same numbers.
DIM plan = [ _
    { "T": "DRAG", "R": 6, "C": 6, "R2": 6, "C2": 34 }, _
    { "T": "DRAG", "R": 6, "C": 34, "R2": 18, "C2": 34 }, _
    { "T": "DRAG", "R": 30, "C": 8, "R2": 7, "C2": 20 }, _
    { "T": "PLACE", "R": 6, "C": 6, "K": "SCHUERFER", "D": "E" }, _
    { "T": "PLACE", "R": 30, "C": 8, "K": "RESONATOR", "D": "E" }, _
    { "T": "PLACE", "R": 6, "C": 12, "K": "SCHMELZE", "D": "E" }, _
    { "T": "PLACE", "R": 14, "C": 20, "K": "RAFFINERIE", "D": "N" }, _
    { "T": "PLACE", "R": 6, "C": 26, "K": "KOPPLER", "D": "E" }, _
    { "T": "TICK", "N": 800 } ]

DIM live = VEIN.NEWGAME("REVIER40")
DIM log = VEIN.NEWLOG("REVIER40")
DIM refused = 0
DIM cmdi
FOR cmdi = 0 TO LEN(plan) - 1
    IF VEIN.ACT(live, log, plan[cmdi]) <> "" THEN refused = refused + 1
NEXT cmdi
CHECK("every command went through", STR$(refused), "0")
CHECK("and every one was written down", STR$(LEN(log{"CMDS"})), STR$(LEN(plan)))
CHECK("the works reach the top tier", STR$(VEIN.GOTBY(live, 1, "ZUENDKERN") > 0), "TRUE")
CHECK("both seams were worked", STR$(live{"MINED"} > 20), "TRUE")

DIM again = VEIN.REPLAY(log)
CHECK("the log replays to the same match", VEIN.FINGER(again), VEIN.FINGER(live))
CHECK("the parts table it was played on is the current one", VEIN.LOGDRIFT(log), "")

' A fingerprint that cannot tell two different matches apart would make the
' check above meaningless, so one command is dropped and it has to differ.
DIM shortlog = VEIN.NEWLOG("REVIER40")
DIM sc = log{"CMDS"}
DIM si2
FOR si2 = 0 TO LEN(sc) - 2
    shortlog{"CMDS"} = APPEND(shortlog{"CMDS"}, [sc[si2]])
NEXT si2
DIM cutrun = VEIN.REPLAY(shortlog)
CHECK("a log missing its last move lands elsewhere", _
    STR$(VEIN.FINGER(cutrun) <> VEIN.FINGER(live)), "TRUE")

VEIN.SETPARTS(quick)
CHECK("and a log from other rules says so", VEIN.LOGDRIFT(log), "msg_otherparts")
VEIN.SETPARTS(p)

PRINT "--- what a hand on a mouse sends"

' A machine dropped on a belt takes the belt's direction, because that is what
' clicking on it means. On bare ground there is nothing to take.
DIM st15 = VEIN.NEWGAME("REVIER40")
DIM w16$ = VEIN.APPLY(st15, { "T": "DRAG", "R": 6, "C": 6, "R2": 6, "C2": 20 })
CHECK("the run goes down", w16$, "")
CHECK("a machine on the run needs no direction", _
    VEIN.APPLY(st15, { "T": "PLACE", "R": 6, "C": 12, "K": "SCHMELZE" }), "")
DIM d15 = st15{"DIR"}
CHECK("  and it faces the way the belt runs", STR$(d15[6][12]), "2")
CHECK("on bare ground it is refused", _
    VEIN.APPLY(st15, { "T": "PLACE", "R": 25, "C": 25, "K": "SCHMELZE" }), "msg_nodir")

' The builder ticks between moves, so its recording interleaves them. It has
' to replay to the same match or what you built cannot be sent to anyone.
DIM handlog = VEIN.NEWLOG("REVIER40")
DIM handst = VEIN.NEWGAME("REVIER40")
DIM hand = [ _
    { "T": "TICK", "N": 15 }, _
    { "T": "DRAG", "R": 6, "C": 6, "R2": 6, "C2": 34 }, _
    { "T": "TICK", "N": 9 }, _
    { "T": "DRAG", "R": 6, "C": 34, "R2": 18, "C2": 34 }, _
    { "T": "PLACE", "R": 6, "C": 6, "K": "SCHUERFER" }, _
    { "T": "TICK", "N": 40 }, _
    { "T": "PLACE", "R": 6, "C": 14, "K": "SCHMELZE" }, _
    { "T": "TICK", "N": 300 } ]
DIM hi
FOR hi = 0 TO LEN(hand) - 1
    DIM whand$ = VEIN.ACT(handst, handlog, hand[hi])
NEXT hi
CHECK("a hand-built line delivers", STR$(handst{"DELIVERED"}[1] > 0), "TRUE")
CHECK("and its recording replays to the same match", _
    VEIN.FINGER(VEIN.REPLAY(handlog)), VEIN.FINGER(handst))

PRINT "--- a tool cannot half-load the game"

' Starting a tool from another directory used to leave it running on the
' built-in set, on a layout that does not exist there, drawing a board nobody
' asked for. Both halves of that now say so.
DIM ghost = VEIN.NEWGAME("GIBTESNICHT")
CHECK("an unknown layout is refused", "" + ghost{"ERR"}, "msg_nolayout")
CHECK("  and a real one is not", "" + VEIN.NEWGAME("KETTE"){"ERR"}, "")

DIM offgrid = { "LAYOUT": "REVIER40", "FP": "", "CMDS": [ _
    { "T": "DRAG", "R": 6, "C": 6, "R2": 6, "C2": 200 } ] }
DIM ghost2 = VEIN.REPLAY(offgrid)
CHECK("a recording that does not fit its layout is refused", _
    "" + ghost2{"ERR"}, "msg_logrefused")

PRINT ""
PRINT "vein_test: passed "; pass; ", failed "; fail
