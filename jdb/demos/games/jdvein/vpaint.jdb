' jdVEIN - the painter, kept away from the rules.
' Terrain never changes while a layout stands, so its colour is packed once
' and only the goods are laid over it per frame. Colours come from parts.json,
' so recolouring the game is an edit in the data, not here.
EXPORT MODULE VPAINT

IMPORT VEIN

FUNC PACK(rgb)
    RETURN rgb[0] * 65536 + rgb[1] * 256 + rgb[2]
ENDFUNC

' The static half. One pass per layer, run once per layout.
EXPORT FUNC BASE(st)
    DIM p = VEIN.PARTS()
    DIM dirg = st{"DIR"}
    DIM mach = st{"MACH"}
    DIM isbelt = (dirg > 0) * (mach = 0)
    DIM ismach = (mach > 0)
    DIM isgnd = 1 - isbelt - ismach

    DIM cg = PACK(p{"ground"}{"COLOR"})
    DIM cb = PACK(p{"belts"}{VEIN.BELTNAME()}{"COLOR"})
    DIM out = isgnd * cg + isbelt * cb

    ' Every machine kind paints itself. A cell carries no kind after it is
    ' built - only its recipe - so the kind is recovered from the recipe, and
    ' that costs one pass per kind at layout time and nothing per frame.
    DIM ms = p{"machines"}
    FOR EACH k$ IN MAP.KEYS(ms)
        DIM mk = ms{k$}
        DIM sel = ismach * (st{"MACHCD0"} = mk{"DWELL"})
        IF VEIN.ISMINER(mk) = 1 THEN
            sel = sel * (st{"NEED1"} = 0) * (st{"MACHOUT"} = VEIN.GOODID("" + mk{"MINES"}))
        ELSE
            sel = sel * (st{"MACHOUT"} = VEIN.GOODID("" + mk{"OUT"}))
        ENDIF
        out = out * (1 - sel) + sel * PACK(mk{"COLOR"})
    NEXT k$

    ' A port swallows what reaches it, so without a mark of its own the goods
    ' look like they walk off the end of the belt into nothing.
    DIM isport = (st{"SINK"} > 0)
    DIM cport = PACK(p{"ground"}{"COLOR"})
    IF MAP.EXISTS(p, "port") THEN cport = PACK(p{"port"}{"COLOR"})
    RETURN out * (1 - isport) + isport * cport
ENDFUNC

' The moving half. Two passes per good kind, which is the price of having no
' gather by index matrix in the runtime, plus three for the seams: a deposit
' only shows where nothing has been built over it, so it disappears under the
' factory the way it should.
EXPORT FUNC FRAME(base, st)
    DIM p = VEIN.PARTS()
    DIM gs = p{"goods"}
    DIM itemg = st{"ITEM"}
    DIM lit = itemg * 0
    FOR EACH k$ IN MAP.KEYS(gs)
        lit = lit + (itemg = gs{k$}{"ID"}) * PACK(gs{k$}{"COLOR"})
    NEXT k$
    DIM seam = st{"BARE"} * (st{"ORE"} > 0)
    DIM under = base * (1 - seam) + seam * PACK(p{"ore"}{"COLOR"})
    RETURN under * (itemg = 0) + lit
ENDFUNC
