' jdVEIN - the rules, headless and deterministic.
' The whole match is a handful of equally shaped grids in one map. ADVANCE
' moves it on by a tick and touches every grid as a whole; nothing in here
' knows how many goods are in flight, which is the point of the engine.
'
' Parts and layouts are data. Nothing about a belt, a machine, a recipe or a
' map is written into this file, so an editor that emits parts.json and
' maps.json is the only tool needed to change the game.
EXPORT MODULE VEIN

' Directions: 1 north, 2 east, 3 south, 4 west. Zero is bare ground.
EXPORT FUNC DIRNO(d$)
    DIM u$ = UCASE$(d$)
    IF u$ = "N" THEN RETURN 1
    IF u$ = "E" THEN RETURN 2
    IF u$ = "S" THEN RETURN 3
    IF u$ = "W" THEN RETURN 4
    RETURN 0
ENDFUNC

EXPORT FUNC DROF(d)
    IF d = 1 THEN RETURN -1
    IF d = 3 THEN RETURN 1
    RETURN 0
ENDFUNC

EXPORT FUNC DCOF(d)
    IF d = 2 THEN RETURN 1
    IF d = 4 THEN RETURN -1
    RETURN 0
ENDFUNC

' ROTATE turns the row axis only, so a column turn goes through a transpose.
' The value at (r + dr, c + dc) arrives at (r, c).
FUNC LOOKAT(g, dr, dc)
    DIM out = g
    IF dr <> 0 THEN out = ROTATE(out, [dr, 0])
    IF dc <> 0 THEN out = TRANSPOSE(ROTATE(TRANSPOSE(out), [dc, 0]))
    RETURN out
ENDFUNC

FUNC CARRYTO(g, dr, dc)
    RETURN LOOKAT(g, 0 - dr, 0 - dc)
ENDFUNC

' -------------------------------------------------------------- the data ---

DIM loaded_parts = 0
EXPORT SUB SETPARTS(m)
    loaded_parts = m
ENDSUB

' The built-in set is the fallback when no parts.json was installed. It is
' deliberately the smallest thing that still exercises every field: a miner,
' a one-input recipe and a good worth more than what went into it.
EXPORT FUNC PARTS()
    IF TYPEOF(loaded_parts) = "OBJECT" THEN RETURN loaded_parts
    DIM p AS MAP = {}
    p{"goods"} = { "REGOLITH": { "ID": 1, "COLOR": [130, 150, 175], "SCORE": 1 }, _
                   "BARREN": { "ID": 3, "COLOR": [255, 205, 90], "SCORE": 5 } }
    p{"belts"} = { "BAHN": { "COLOR": [46, 54, 88], "COST": 1 } }
    p{"machines"} = { _
        "SCHUERFER": { "MINES": "REGOLITH", "DWELL": 3, "COLOR": [108, 132, 150], "COST": 4 }, _
        "SCHMELZE": { "IN": "REGOLITH", "NEED": 2, "OUT": "BARREN", "DWELL": 6, _
                      "COLOR": [168, 104, 52], "COST": 5 } }
    p{"ore"} = { "COLOR": [34, 52, 74] }
    p{"ground"} = { "COLOR": [10, 14, 26] }
    RETURN p
ENDFUNC

' The directory the running script sits in. Data files live next to it, and a
' tool must not care whether it was started from here or from the repo root.
EXPORT FUNC HERE$()
    DIM a = OS.ARGS()
    IF LEN(a) < 1 THEN RETURN ""
    DIM p$ = "" + a[0]
    DIM cut = -1
    DIM i
    FOR i = 0 TO LEN(p$) - 1
        DIM ch$ = MID$(p$, i, 1)
        IF ch$ = "/" ORELSE ch$ = CHR$(92) THEN cut = i
    NEXT i
    IF cut < 0 THEN RETURN ""
    RETURN LEFT$(p$, cut + 1)
ENDFUNC

' One line for every tool, so no tool can half-load the game. It returns a
' message instead of falling back quietly: a missing table used to leave a
' host running on the built-in set, which looks like a working program and is
' a different game.
EXPORT FUNC LOADDATA()
    DIM dir$ = HERE$()
    TRY
        SETPARTS(JSON.PARSE$(TXTREADER$(dir$ + "parts.json")))
    CATCH
        RETURN "parts.json nicht lesbar in [" + dir$ + "]"
    ENDTRY
    TRY
        SETLAYOUTS(JSON.PARSE$(TXTREADER$(dir$ + "maps.json")))
    CATCH
        RETURN "maps.json nicht lesbar in [" + dir$ + "]"
    ENDTRY
    RETURN ""
ENDFUNC

' The one belt kind, whatever the data calls it. A layout stroke and a drag
' both need it and neither should have the name written into them.
EXPORT FUNC BELTNAME()
    FOR EACH k$ IN MAP.KEYS(PARTS(){"belts"})
        RETURN k$
    NEXT k$
    RETURN ""
ENDFUNC

DIM loaded_layouts = 0
EXPORT SUB SETLAYOUTS(m)
    loaded_layouts = m
ENDSUB

EXPORT FUNC LAYOUTS()
    IF TYPEOF(loaded_layouts) = "OBJECT" THEN RETURN loaded_layouts
    RETURN { "SCHLANGE40": { "N": 40, "GEN": { "KIND": "SERPENTINE", "LANE": 8, _
        "MACHSTEP": 12, "MACH": "SCHMELZE", "SRCSTEP": 48, "GOOD": "REGOLITH", "PLAYER": 1 } } }
ENDFUNC

EXPORT FUNC GOODID(name$)
    DIM gs = PARTS(){"goods"}
    IF NOT MAP.EXISTS(gs, name$) THEN RETURN 0
    RETURN gs{name$}{"ID"}
ENDFUNC

' Goods ordered by id, so a painter or an editor can walk them without
' guessing which ids exist.
EXPORT FUNC GOODLIST()
    DIM gs = PARTS(){"goods"}
    DIM out = []
    DIM top = 0
    FOR EACH k$ IN MAP.KEYS(gs)
        IF gs{k$}{"ID"} > top THEN top = gs{k$}{"ID"}
    NEXT k$
    DIM i
    FOR i = 1 TO top
        FOR EACH k$ IN MAP.KEYS(gs)
            IF gs{k$}{"ID"} = i THEN out = APPEND(out, [k$])
        NEXT k$
    NEXT i
    RETURN out
ENDFUNC

EXPORT FUNC GOODCOLOR(name$)
    DIM gs = PARTS(){"goods"}
    IF NOT MAP.EXISTS(gs, name$) THEN RETURN [200, 200, 200]
    RETURN gs{name$}{"COLOR"}
ENDFUNC

EXPORT FUNC TOPGOOD()
    DIM gs = PARTS(){"goods"}
    DIM top = 0
    FOR EACH k$ IN MAP.KEYS(gs)
        IF gs{k$}{"ID"} > top THEN top = gs{k$}{"ID"}
    NEXT k$
    RETURN top
ENDFUNC

' A machine with no inputs is a miner. Nothing else distinguishes the two.
EXPORT FUNC ISMINER(mk)
    IF MAP.EXISTS(mk, "MINES") THEN RETURN 1
    RETURN 0
ENDFUNC

' ------------------------------------------------------------- the state ---

' All grids are n by n and all of it survives JSON.STRINGIFY, so a state can
' be written out and read back unchanged.
FUNC BLANK(n)
    DIM z = RESHAPE([0], [n, n])
    DIM keys$ = ["DIR", "ITEM", "MACH", "CD", "MACHIN", "MACHIN2", "MACHOUT", _
                 "MACHCD0", "NEED1", "NEED2", "CAP1", "CAP2", "BUF1", "BUF2", _
                 "ORE", "ORETYPE", "SRC", "SINK", "OWNER"]
    DIM st AS MAP = {}
    st{"N"} = n
    st{"TICK"} = 0
    DIM i
    FOR i = 0 TO LEN(keys$) - 1
        st{keys$[i]} = z + 0
    NEXT i
    st{"DELIVERED"} = [0, 0, 0, 0, 0]
    st{"SCORE"} = [0, 0, 0, 0, 0]
    ' what each port received, by good: a port that only counts crates cannot
    ' tell a finished part from the ore that walked past a busy machine
    st{"BOOKED"} = RESHAPE([0], [5, TOPGOOD() + 1])
    st{"MINED"} = 0
    RETURN st
ENDFUNC

EXPORT FUNC GOTBY(st, player, good$)
    DIM b = st{"BOOKED"}
    RETURN b[player][GOODID(good$)]
ENDFUNC

FUNC SETCELL(st, key$, r, c, v)
    DIM g = st{key$}
    g[r][c] = v
    st{key$} = g
    RETURN st
ENDFUNC

' What never changes while a layout stands: which cells point where, which of
' their neighbours can take a good, which cells dig and whether they sit on
' the seam they were built for. Lifting all of it out of the tick is worth
' more than a dozen passes over the grid per tick, so every edit calls this.
EXPORT FUNC REBUILD(st)
    DIM dirg = st{"DIR"}
    DIM accept = (dirg > 0)
    DIM masks = []
    DIM aheads = []
    DIM d
    FOR d = 1 TO 4
        masks = APPEND(masks, [(dirg = d) * 1])
        aheads = APPEND(aheads, [LOOKAT(accept, DROF(d), DCOF(d))])
    NEXT d
    st{"MASK"} = masks
    st{"AHEAD"} = aheads

    DIM digs = st{"MACH"} * (st{"NEED1"} = 0) * (st{"NEED2"} = 0)
    st{"DIGS"} = digs
    st{"DIGOK"} = digs * (st{"ORETYPE"} = st{"MACHOUT"})
    ' cells nothing was built on, which is where a seam is still visible
    st{"BARE"} = (dirg = 0) * 1

    DIM n = st{"N"}
    st{"HASMACH"} = SUM(RESHAPE(st{"MACH"}, [n * n])) > 0
    st{"HASSINK"} = SUM(RESHAPE(st{"SINK"}, [n * n])) > 0
    RETURN st
ENDFUNC

' ------------------------------------------------------------ the builder ---

' One cell. kind$ is a belt name for a plain conveyor or a machine name. A
' machine keeps a direction, so what it makes leaves the way the belt runs.
EXPORT FUNC PLACE(st, r, c, kind$, d)
    DIM n = st{"N"}
    IF r < 0 ORELSE c < 0 ORELSE r >= n ORELSE c >= n THEN RETURN "msg_offgrid"
    DIM p = PARTS()
    DIM isbelt = MAP.EXISTS(p{"belts"}, kind$)
    DIM ismach = MAP.EXISTS(p{"machines"}, kind$)
    IF isbelt = 0 ANDALSO ismach = 0 THEN RETURN "msg_unknown"
    IF d < 1 ORELSE d > 4 THEN RETURN "msg_nodir"

    st = SETCELL(st, "DIR", r, c, d)
    DIM blank$ = ["MACH", "MACHIN", "MACHIN2", "MACHOUT", "MACHCD0", _
                  "NEED1", "NEED2", "CAP1", "CAP2", "BUF1", "BUF2", "CD"]
    DIM i
    FOR i = 0 TO LEN(blank$) - 1
        st = SETCELL(st, blank$[i], r, c, 0)
    NEXT i
    IF ismach = 0 THEN RETURN ""

    DIM mk = p{"machines"}{kind$}
    st = SETCELL(st, "MACH", r, c, 1)
    st = SETCELL(st, "MACHCD0", r, c, mk{"DWELL"})
    st = SETCELL(st, "CD", r, c, mk{"DWELL"})
    IF ISMINER(mk) = 1 THEN
        st = SETCELL(st, "MACHOUT", r, c, GOODID("" + mk{"MINES"}))
        RETURN ""
    ENDIF

    st = SETCELL(st, "MACHOUT", r, c, GOODID("" + mk{"OUT"}))
    DIM n1 = 1
    IF MAP.EXISTS(mk, "NEED") THEN n1 = mk{"NEED"}
    st = SETCELL(st, "MACHIN", r, c, GOODID("" + mk{"IN"}))
    st = SETCELL(st, "NEED1", r, c, n1)
    st = SETCELL(st, "CAP1", r, c, n1 * 2)
    IF MAP.EXISTS(mk, "IN2") THEN
        DIM n2 = 1
        IF MAP.EXISTS(mk, "NEED2") THEN n2 = mk{"NEED2"}
        st = SETCELL(st, "MACHIN2", r, c, GOODID("" + mk{"IN2"}))
        st = SETCELL(st, "NEED2", r, c, n2)
        st = SETCELL(st, "CAP2", r, c, n2 * 2)
    ENDIF
    RETURN ""
ENDFUNC

EXPORT FUNC UNBUILD(st, r, c)
    DIM n = st{"N"}
    IF r < 0 ORELSE c < 0 ORELSE r >= n ORELSE c >= n THEN RETURN "msg_offgrid"
    DIM keys$ = ["DIR", "ITEM", "MACH", "CD", "MACHIN", "MACHIN2", "MACHOUT", _
                 "MACHCD0", "NEED1", "NEED2", "CAP1", "CAP2", "BUF1", "BUF2", _
                 "SRC", "SINK"]
    DIM i
    FOR i = 0 TO LEN(keys$) - 1
        st = SETCELL(st, keys$[i], r, c, 0)
    NEXT i
    RETURN ""
ENDFUNC

EXPORT FUNC PUTSOURCE(st, r, c, good$)
    RETURN SETCELL(st, "SRC", r, c, GOODID(good$))
ENDFUNC

EXPORT FUNC PUTSINK(st, r, c, player)
    RETURN SETCELL(st, "SINK", r, c, player)
ENDFUNC

' A deposit is a disc of richness with a type. A miner only works on the seam
' it was built for, so putting the wrong drill on a patch is a real mistake
' and not a silent success.
EXPORT FUNC PUTORE(st, r, c, radius, amount, good$)
    DIM n = st{"N"}
    DIM flat = IOTA(n * n, 0)
    DIM rowi = RESHAPE(INT(flat / n), [n, n])
    DIM coli = RESHAPE(flat MOD n, [n, n])
    DIM dr = rowi - r
    DIM dc = coli - c
    DIM inside = ((dr * dr + dc * dc) <= radius * radius) * 1
    st{"ORE"} = st{"ORE"} * (1 - inside) + inside * amount
    st{"ORETYPE"} = st{"ORETYPE"} * (1 - inside) + inside * GOODID(good$)
    RETURN st
ENDFUNC

' ------------------------------------------------------------- the layout ---

' A stroke is what an editor draws: a straight run, a single cell, a machine,
' a deposit, a source, a port. Everything a map can be made of goes through
' PLACE, so hand-authored and generated layouts cannot drift apart.
FUNC APPLYSTROKES(st, strokes)
    DIM si
    FOR si = 0 TO LEN(strokes) - 1
        DIM s = strokes[si]
        DIM op$ = UCASE$("" + s{"OP"})
        DIM r = s{"R"}
        DIM c = s{"C"}
        IF op$ = "RUN" THEN
            DIM d = DIRNO("" + s{"DIR"})
            DIM dr = DROF(d)
            DIM dc = DCOF(d)
            DIM k
            FOR k = 0 TO s{"LEN"} - 1
                DIM w0$ = PLACE(st, r + dr * k, c + dc * k, BELTNAME(), d)
            NEXT k
        ELSEIF op$ = "CELL" THEN
            DIM w1$ = PLACE(st, r, c, "" + s{"KIND"}, DIRNO("" + s{"DIR"}))
        ELSEIF op$ = "MACH" THEN
            ' a machine inherits the direction of the belt it is dropped on
            DIM dirg = st{"DIR"}
            DIM w2$ = PLACE(st, r, c, "" + s{"KIND"}, dirg[r][c])
        ELSEIF op$ = "ORE" THEN
            DIM rad = 0
            IF MAP.EXISTS(s, "RADIUS") THEN rad = s{"RADIUS"}
            st = PUTORE(st, r, c, rad, s{"AMOUNT"}, "" + s{"GOOD"})
        ELSEIF op$ = "SRC" THEN
            st = PUTSOURCE(st, r, c, "" + s{"GOOD"})
        ELSEIF op$ = "SINK" THEN
            ' a port has to be reachable, so a stroke may lay the cell it
            ' stands on rather than relying on a run happening to end there
            IF MAP.EXISTS(s, "DIR") THEN
                DIM w5$ = PLACE(st, r, c, BELTNAME(), DIRNO("" + s{"DIR"}))
            ENDIF
            st = PUTSINK(st, r, c, s{"PLAYER"})
        ENDIF
    NEXT si
    RETURN st
ENDFUNC

' The generated layout the probe measured: belt rows every LANE rows running
' in alternating directions, joined at the ends by a riser. One connected path
' over the whole grid, which is the densest a belt layout gets.
FUNC APPLYGEN(st, gen)
    DIM n = st{"N"}
    DIM lane = gen{"LANE"}
    DIM flat = IOTA(n * n, 0)
    DIM rowi = RESHAPE(INT(flat / n), [n, n])
    DIM coli = RESHAPE(flat MOD n, [n, n])

    DIM lastrow = n - 1 - lane
    lastrow = lastrow - (lastrow MOD lane)
    DIM laneno = INT(rowi / lane)
    DIM goeast = ((laneno MOD 2) = 0)
    DIM onlane = ((rowi MOD lane) = 0) * (rowi >= lane) * (rowi <= lastrow)
    DIM inrun = (coli >= 2) * (coli <= n - 3)
    DIM turncol = goeast * (n - 3) + (1 - goeast) * 2
    DIM atturn = (coli = turncol)

    DIM dirg = onlane * inrun * (goeast * 2 + (1 - goeast) * 4)
    DIM turncell = onlane * inrun * atturn
    dirg = dirg * (1 - turncell) + turncell * 3
    DIM ingap = ((rowi MOD lane) <> 0) * (rowi >= lane) * (rowi < lastrow)
    st{"DIR"} = dirg + ingap * atturn * 3

    DIM mk = PARTS(){"machines"}{"" + gen{"MACH"}}
    DIM machcell = onlane * inrun * ((coli MOD gen{"MACHSTEP"}) = 5) * (1 - atturn)
    DIM n1 = 1
    IF MAP.EXISTS(mk, "NEED") THEN n1 = mk{"NEED"}
    st{"MACH"} = machcell
    st{"MACHIN"} = machcell * GOODID("" + mk{"IN"})
    st{"MACHOUT"} = machcell * GOODID("" + mk{"OUT"})
    st{"MACHCD0"} = machcell * mk{"DWELL"}
    st{"CD"} = machcell * mk{"DWELL"}
    st{"NEED1"} = machcell * n1
    st{"CAP1"} = machcell * n1 * 2

    st{"SRC"} = onlane * inrun * ((coli MOD gen{"SRCSTEP"}) = 7) * GOODID("" + gen{"GOOD"})
    st{"SINK"} = onlane * atturn * (rowi = lastrow) * gen{"PLAYER"}
    RETURN st
ENDFUNC

EXPORT FUNC NEWGAME(layout$)
    DIM all = LAYOUTS()
    ' A layout that is not there used to come back as a tiny empty board, which
    ' every caller then happily built on. It says so now.
    IF NOT MAP.EXISTS(all, layout$) THEN
        DIM bad = BLANK(8)
        bad{"ERR"} = "msg_nolayout"
        bad{"LAYOUT"} = layout$
        RETURN REBUILD(bad)
    ENDIF
    DIM spec = all{layout$}
    DIM st = BLANK(spec{"N"})
    st{"LAYOUT"} = layout$
    st{"ERR"} = ""
    IF MAP.EXISTS(spec, "GEN") THEN st = APPLYGEN(st, spec{"GEN"})
    IF MAP.EXISTS(spec, "STROKES") THEN st = APPLYSTROKES(st, spec{"STROKES"})
    RETURN REBUILD(st)
ENDFUNC

' --------------------------------------------------------------- the tick ---

EXPORT FUNC ADVANCE(st)
    DIM itemg = st{"ITEM"}

    IF st{"HASMACH"} THEN
        DIM mach = st{"MACH"}
        DIM cdg = st{"CD"}
        DIM buf1 = st{"BUF1"}
        DIM buf2 = st{"BUF2"}
        DIM ore = st{"ORE"}

        ' A machine takes what its recipe wants off the belt and holds it, so
        ' it never blocks the line the way a cell that just sits on a good
        ' would. The buffer is capped at twice the recipe, which stops one
        ' machine from hoovering up a whole run.
        DIM take1 = mach * (st{"MACHIN"} > 0) * (itemg = st{"MACHIN"}) * (buf1 < st{"CAP1"})
        DIM take2 = mach * (st{"MACHIN2"} > 0) * (itemg = st{"MACHIN2"}) * (buf2 < st{"CAP2"})
        buf1 = buf1 + take1
        buf2 = buf2 + take2
        itemg = itemg * (1 - take1) * (1 - take2)

        ' It works while the recipe is covered and the cell is free to put the
        ' result down. A miner has no recipe to cover and is gated on the seam
        ' instead: right type, and something left in it.
        DIM fed = (buf1 >= st{"NEED1"}) * (buf2 >= st{"NEED2"}) * (itemg = 0)
        DIM gate = 1 - st{"DIGS"} + st{"DIGOK"} * (ore > 0)
        DIM working = mach * fed * gate
        cdg = cdg - working
        DIM ripe = working * (cdg <= 0)

        buf1 = buf1 - ripe * st{"NEED1"}
        buf2 = buf2 - ripe * st{"NEED2"}
        DIM dug = ripe * st{"DIGS"}
        ore = ore - dug
        itemg = itemg + ripe * st{"MACHOUT"}
        cdg = cdg * (1 - ripe) + ripe * st{"MACHCD0"}

        st{"BUF1"} = buf1
        st{"BUF2"} = buf2
        st{"CD"} = cdg
        st{"ORE"} = ore
        DIM n_dug = SUM(RESHAPE(dug, [st{"N"} * st{"N"}]))
        IF n_dug > 0 THEN st{"MINED"} = st{"MINED"} + n_dug
    ENDIF

    ' All four directions read one snapshot of the grid, so a good that turns a
    ' corner cannot be picked up a second time in the same tick by a later
    ' direction. Claims keep two goods off one cell where belts merge.
    DIM masks = st{"MASK"}
    DIM aheads = st{"AHEAD"}
    DIM free0 = (itemg = 0)
    DIM ready = 1 - free0
    DIM claimed = free0 * 0
    DIM d
    FOR d = 1 TO 4
        DIM dr = DROF(d)
        DIM dc = DCOF(d)
        DIM go = masks[d - 1] * ready * aheads[d - 1] * LOOKAT(free0, dr, dc) * (1 - LOOKAT(claimed, dr, dc))
        DIM carry = go * itemg
        itemg = itemg - carry + CARRYTO(carry, dr, dc)
        claimed = claimed + CARRYTO(go, dr, dc)
    NEXT d

    ' What reaches a port is booked to that port's player and leaves the board.
    IF st{"HASSINK"} THEN
        DIM sink = st{"SINK"}
        DIM landed = (sink > 0) * (itemg > 0)
        IF SUM(RESHAPE(landed, [st{"N"} * st{"N"}])) > 0 THEN
            st = BOOK(st, sink, landed, itemg)
        ENDIF
        itemg = itemg * (1 - landed)
    ENDIF

    itemg = itemg + st{"SRC"} * (itemg = 0)
    st{"ITEM"} = itemg
    st{"TICK"} = st{"TICK"} + 1
    RETURN st
ENDFUNC

' Counting costs a pass per player, and a pass per good kind for the players
' that actually received something. It only runs on a tick where a port was
' hit at all, so an idle port is free.
FUNC BOOK(st, sink, landed, itemg)
    DIM n = st{"N"}
    DIM gs = PARTS(){"goods"}
    DIM delivered = st{"DELIVERED"}
    DIM score = st{"SCORE"}
    DIM booked = st{"BOOKED"}
    DIM pl
    FOR pl = 1 TO 4
        DIM mine = landed * (sink = pl)
        DIM cnt = SUM(RESHAPE(mine, [n * n]))
        IF cnt > 0 THEN
            delivered[pl] = delivered[pl] + cnt
            FOR EACH k$ IN MAP.KEYS(gs)
                DIM gid = gs{k$}{"ID"}
                DIM got = SUM(RESHAPE(mine * (itemg = gid), [n * n]))
                IF got > 0 THEN
                    booked[pl][gid] = booked[pl][gid] + got
                    score[pl] = score[pl] + got * gs{k$}{"SCORE"}
                ENDIF
            NEXT k$
        ENDIF
    NEXT pl
    st{"DELIVERED"} = delivered
    st{"SCORE"} = score
    st{"BOOKED"} = booked
    RETURN st
ENDFUNC

' ------------------------------------------------------------- the numbers ---

EXPORT FUNC COUNTGOODS(st)
    DIM n = st{"N"}
    RETURN SUM(RESHAPE((st{"ITEM"} > 0) * 1, [n * n]))
ENDFUNC

EXPORT FUNC COUNTBUILT(st)
    DIM n = st{"N"}
    RETURN SUM(RESHAPE((st{"DIR"} > 0) * 1, [n * n]))
ENDFUNC

EXPORT FUNC ORELEFT(st)
    DIM n = st{"N"}
    RETURN SUM(RESHAPE(st{"ORE"}, [n * n]))
ENDFUNC

' Everything held in a machine buffer, which is where goods hide when the
' board looks emptier than the books say.
EXPORT FUNC INBUFFERS(st)
    DIM n = st{"N"}
    RETURN SUM(RESHAPE(st{"BUF1"} + st{"BUF2"}, [n * n]))
ENDFUNC

' ------------------------------------------------------------ the commands ---
'
' Nothing outside this module may reach into a state. Everything a player does
' arrives as a command, which is what makes a match a seed plus a list instead
' of a grid nobody can ship:
'
'   { "T": "PLACE", "P": 1, "R": 10, "C": 5, "K": "SCHMELZE", "D": "E" }
'   { "T": "DRAG",  "P": 1, "R": 10, "C": 5, "R2": 10, "C2": 30 }
'   { "T": "CLEAR", "P": 1, "R": 10, "C": 5 }
'   { "T": "TICK",  "N": 40 }
'
' A drag lays a run from one cell to the other and turns the corner where it
' has to, because placing a belt one cell at a time is not a game.

FUNC LEG(st, r, c, d, steps, kind$)
    DIM dr = DROF(d)
    DIM dc = DCOF(d)
    DIM k
    FOR k = 0 TO steps
        DIM why$ = PLACE(st, r + dr * k, c + dc * k, kind$, d)
        IF why$ <> "" THEN RETURN why$
    NEXT k
    RETURN ""
ENDFUNC

' Column leg first, then row leg. The corner cell ends up carrying the second
' direction because the second leg starts on it and overwrites it.
FUNC DRAGRUN(st, r1, c1, r2, c2)
    DIM belt$ = BELTNAME()
    DIM why$ = ""
    IF c2 <> c1 THEN
        DIM dh = 2
        IF c2 < c1 THEN dh = 4
        why$ = LEG(st, r1, c1, dh, ABS(c2 - c1), belt$)
        IF why$ <> "" THEN RETURN why$
    ENDIF
    IF r2 <> r1 THEN
        DIM dv = 3
        IF r2 < r1 THEN dv = 1
        why$ = LEG(st, r1, c2, dv, ABS(r2 - r1), belt$)
    ENDIF
    IF c2 = c1 ANDALSO r2 = r1 THEN why$ = PLACE(st, r1, c1, belt$, 2)
    RETURN why$
ENDFUNC

' A direction arrives as "E" from a recording and as 2 from a caller that
' already knows. Both are accepted so a log stays readable.
FUNC ASDIR(v)
    IF TYPEOF(v) = "STRING" THEN RETURN DIRNO("" + v)
    RETURN v
ENDFUNC

EXPORT FUNC APPLY(st, cmd)
    DIM t$ = UCASE$("" + cmd{"T"})
    DIM why$ = "msg_badcmd"
    DIM built = 0
    IF t$ = "PLACE" THEN
        why$ = PLACE(st, cmd{"R"}, cmd{"C"}, "" + cmd{"K"}, ASDIR(cmd{"D"}))
        built = 1
    ELSEIF t$ = "DRAG" THEN
        why$ = DRAGRUN(st, cmd{"R"}, cmd{"C"}, cmd{"R2"}, cmd{"C2"})
        built = 1
    ELSEIF t$ = "CLEAR" THEN
        why$ = UNBUILD(st, cmd{"R"}, cmd{"C"})
        built = 1
    ELSEIF t$ = "TICK" THEN
        DIM k
        FOR k = 1 TO cmd{"N"}
            st = ADVANCE(st)
        NEXT k
        why$ = ""
    ENDIF
    IF built = 1 ANDALSO why$ = "" THEN st = REBUILD(st)
    RETURN why$
ENDFUNC

' A recording is only replayable against the rules it was made under, so it
' carries a fingerprint of the parts table it was played on. A replay that
' finds a different one says so instead of reporting a false result.
EXPORT FUNC PARTSFP()
    DIM fp$ = "?"
    TRY
        fp$ = MID$(CODEC.SHA256$(JSON.STRINGIFY$(PARTS())), 0, 12)
    CATCH
    ENDTRY
    RETURN fp$
ENDFUNC

EXPORT FUNC NEWLOG(layout$)
    RETURN { "LAYOUT": layout$, "FP": PARTSFP(), "CMDS": [] }
ENDFUNC

' Do it and write it down in one move, so a log cannot fall out of step with
' the state it describes.
EXPORT FUNC ACT(st, log, cmd)
    DIM why$ = APPLY(st, cmd)
    IF why$ = "" THEN log{"CMDS"} = APPEND(log{"CMDS"}, [cmd])
    RETURN why$
ENDFUNC

EXPORT FUNC REPLAY(log)
    DIM st = NEWGAME("" + log{"LAYOUT"})
    IF ("" + st{"ERR"}) <> "" THEN RETURN st
    DIM cmds = log{"CMDS"}
    DIM refused = 0
    DIM i
    FOR i = 0 TO LEN(cmds) - 1
        IF APPLY(st, cmds[i]) <> "" THEN refused = refused + 1
    NEXT i
    ' A recording whose commands do not all land is not the match it recorded,
    ' and a viewer that draws it anyway is showing a different game.
    IF refused > 0 THEN st{"ERR"} = "msg_logrefused"
    st{"REFUSED"} = refused
    RETURN st
ENDFUNC

EXPORT FUNC LOGDRIFT(log)
    IF ("" + log{"FP"}) <> PARTSFP() THEN RETURN "msg_otherparts"
    RETURN ""
ENDFUNC

' Everything a replay has to reproduce, in one comparable string.
EXPORT FUNC FINGER(st)
    DIM n = st{"N"}
    RETURN STR$(st{"TICK"}) + "/" + STR$(COUNTBUILT(st)) + "/" + STR$(COUNTGOODS(st)) _
        + "/" + STR$(ORELEFT(st)) + "/" + STR$(INBUFFERS(st)) _
        + "/" + STR$(st{"MINED"}) + "/" + STR$(st{"DELIVERED"}[1]) _
        + "/" + STR$(st{"SCORE"}[1]) _
        + "/" + STR$(SUM(RESHAPE(st{"DIR"} * 1, [n * n]))) _
        + "/" + STR$(SUM(RESHAPE(st{"ITEM"} * 1, [n * n])))
ENDFUNC

' Where a single good sits. Only for tests and tools - it walks the grid.
EXPORT FUNC FINDGOOD(st)
    DIM n = st{"N"}
    DIM g = st{"ITEM"}
    DIM r
    DIM c
    FOR r = 0 TO n - 1
        FOR c = 0 TO n - 1
            IF g[r][c] > 0 THEN RETURN [r, c, g[r][c]]
        NEXT c
    NEXT r
    RETURN [-1, -1, 0]
ENDFUNC
