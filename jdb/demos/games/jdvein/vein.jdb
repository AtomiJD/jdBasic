' jdVEIN - the rules, headless and deterministic.
' The whole match is a handful of equally shaped grids in one map. ADVANCE
' moves it on by a tick and touches every grid as a whole; nothing in here
' knows how many goods are in flight, which is the point of the engine.
'
' Parts and layouts are data. Nothing about a belt, a machine or a map is
' written into this file, so an editor that emits parts.json and maps.json
' is the only tool needed to change the game.
EXPORT MODULE VEIN

' Directions: 1 north, 2 east, 3 south, 4 west. Zero is bare ground.
EXPORT FUNC DIRNO(d$)
    DIM u$ = UCASE$(d$)
    IF u$ = "N" THEN RETURN 1
    IF u$ = "E" THEN RETURN 2
    IF u$ = "S" THEN RETURN 3
    IF u$ = "W" THEN RETURN 4
    RETURN 0
ENDFUNC

EXPORT FUNC DROF(d)
    IF d = 1 THEN RETURN -1
    IF d = 3 THEN RETURN 1
    RETURN 0
ENDFUNC

EXPORT FUNC DCOF(d)
    IF d = 2 THEN RETURN 1
    IF d = 4 THEN RETURN -1
    RETURN 0
ENDFUNC

' ROTATE turns the row axis only, so a column turn goes through a transpose.
' The value at (r + dr, c + dc) arrives at (r, c).
FUNC LOOKAT(g, dr, dc)
    DIM out = g
    IF dr <> 0 THEN out = ROTATE(out, [dr, 0])
    IF dc <> 0 THEN out = TRANSPOSE(ROTATE(TRANSPOSE(out), [dc, 0]))
    RETURN out
ENDFUNC

FUNC CARRYTO(g, dr, dc)
    RETURN LOOKAT(g, 0 - dr, 0 - dc)
ENDFUNC

' -------------------------------------------------------------- the data ---

DIM loaded_parts = 0
EXPORT SUB SETPARTS(m)
    loaded_parts = m
ENDSUB

' The built-in set is the fallback when no parts.json was installed. It is
' deliberately the smallest thing that still exercises every field.
EXPORT FUNC PARTS()
    IF TYPEOF(loaded_parts) = "OBJECT" THEN RETURN loaded_parts
    DIM p AS MAP = {}
    p{"goods"} = { "ROHERZ": { "ID": 1, "COLOR": [90, 170, 255], "SCORE": 1 }, _
                   "BARREN": { "ID": 2, "COLOR": [255, 205, 90], "SCORE": 3 } }
    p{"belts"} = { "BAND": { "COLOR": [46, 54, 88], "COST": 1 } }
    p{"machines"} = { "OFEN": { "IN": "ROHERZ", "OUT": "BARREN", "DWELL": 6, _
                                "COLOR": [150, 112, 44], "COST": 5 } }
    p{"ground"} = { "COLOR": [10, 14, 26] }
    RETURN p
ENDFUNC

DIM loaded_layouts = 0
EXPORT SUB SETLAYOUTS(m)
    loaded_layouts = m
ENDSUB

EXPORT FUNC LAYOUTS()
    IF TYPEOF(loaded_layouts) = "OBJECT" THEN RETURN loaded_layouts
    RETURN { "SCHLANGE40": { "N": 40, "GEN": { "KIND": "SERPENTINE", "LANE": 8, _
        "MACHSTEP": 12, "MACH": "OFEN", "SRCSTEP": 48, "GOOD": "ROHERZ", "PLAYER": 1 } } }
ENDFUNC

EXPORT FUNC GOODID(name$)
    DIM gs = PARTS(){"goods"}
    IF NOT MAP.EXISTS(gs, name$) THEN RETURN 0
    RETURN gs{name$}{"ID"}
ENDFUNC

' Goods ordered by id, so a painter or a score pass can walk them without
' guessing which ids exist.
EXPORT FUNC GOODLIST()
    DIM gs = PARTS(){"goods"}
    DIM out = []
    DIM top = 0
    FOR EACH k$ IN MAP.KEYS(gs)
        IF gs{k$}{"ID"} > top THEN top = gs{k$}{"ID"}
    NEXT k$
    DIM i
    FOR i = 1 TO top
        FOR EACH k$ IN MAP.KEYS(gs)
            IF gs{k$}{"ID"} = i THEN out = APPEND(out, [k$])
        NEXT k$
    NEXT i
    RETURN out
ENDFUNC

' ------------------------------------------------------------- the state ---

' Everything a match is. All grids are n by n and all of it survives
' JSON.STRINGIFY, so a state can be written out and read back unchanged.
FUNC BLANK(n)
    DIM z = RESHAPE([0], [n, n])
    DIM st AS MAP = {}
    st{"N"} = n
    st{"TICK"} = 0
    st{"DIR"} = z
    st{"ITEM"} = z + 0
    st{"MACH"} = z + 0
    st{"CD"} = z + 0
    st{"MACHIN"} = z + 0
    st{"MACHOUT"} = z + 0
    st{"MACHCD0"} = z + 0
    st{"SRC"} = z + 0
    st{"SINK"} = z + 0
    st{"OWNER"} = z + 0
    st{"DELIVERED"} = [0, 0, 0, 0, 0]
    st{"SCORE"} = [0, 0, 0, 0, 0]
    RETURN st
ENDFUNC

' Which cells point where, and which of their neighbours can take a good,
' only changes when something is built. Lifting both out of the tick is worth
' eight passes over the grid per tick, so every edit calls this once.
EXPORT FUNC REBUILD(st)
    DIM dirg = st{"DIR"}
    DIM accept = (dirg > 0)
    DIM masks = []
    DIM aheads = []
    DIM d
    FOR d = 1 TO 4
        masks = APPEND(masks, [(dirg = d) * 1])
        aheads = APPEND(aheads, [LOOKAT(accept, DROF(d), DCOF(d))])
    NEXT d
    st{"MASK"} = masks
    st{"AHEAD"} = aheads
    DIM n = st{"N"}
    st{"HASMACH"} = SUM(RESHAPE(st{"MACH"}, [n * n])) > 0
    st{"HASSINK"} = SUM(RESHAPE(st{"SINK"}, [n * n])) > 0
    RETURN st
ENDFUNC

' ------------------------------------------------------------ the builder ---

' One cell. kind$ is a belt name for a plain conveyor, a machine name for a
' machine. A machine keeps a direction, so a good leaves it the way it came.
EXPORT FUNC PLACE(st, r, c, kind$, d)
    DIM n = st{"N"}
    IF r < 0 ORELSE c < 0 ORELSE r >= n ORELSE c >= n THEN RETURN "msg_offgrid"
    DIM p = PARTS()
    DIM isbelt = MAP.EXISTS(p{"belts"}, kind$)
    DIM ismach = MAP.EXISTS(p{"machines"}, kind$)
    IF isbelt = 0 ANDALSO ismach = 0 THEN RETURN "msg_unknown"
    IF d < 1 ORELSE d > 4 THEN RETURN "msg_nodir"

    DIM dirg = st{"DIR"}
    dirg[r][c] = d
    st{"DIR"} = dirg

    DIM mach = st{"MACH"}
    DIM min_g = st{"MACHIN"}
    DIM mout = st{"MACHOUT"}
    DIM mcd = st{"MACHCD0"}
    DIM cdg = st{"CD"}
    IF ismach = 1 THEN
        DIM mk = p{"machines"}{kind$}
        mach[r][c] = 1
        min_g[r][c] = GOODID("" + mk{"IN"})
        mout[r][c] = GOODID("" + mk{"OUT"})
        mcd[r][c] = mk{"DWELL"}
        cdg[r][c] = mk{"DWELL"}
    ELSE
        mach[r][c] = 0
        min_g[r][c] = 0
        mout[r][c] = 0
        mcd[r][c] = 0
        cdg[r][c] = 0
    ENDIF
    st{"MACH"} = mach
    st{"MACHIN"} = min_g
    st{"MACHOUT"} = mout
    st{"MACHCD0"} = mcd
    st{"CD"} = cdg
    RETURN ""
ENDFUNC

EXPORT FUNC UNBUILD(st, r, c)
    DIM n = st{"N"}
    IF r < 0 ORELSE c < 0 ORELSE r >= n ORELSE c >= n THEN RETURN "msg_offgrid"
    DIM keys$ = ["DIR", "ITEM", "MACH", "CD", "MACHIN", "MACHOUT", "MACHCD0", "SRC", "SINK"]
    DIM i
    FOR i = 0 TO LEN(keys$) - 1
        DIM g = st{keys$[i]}
        g[r][c] = 0
        st{keys$[i]} = g
    NEXT i
    RETURN ""
ENDFUNC

EXPORT FUNC PUTSOURCE(st, r, c, good$)
    DIM g = st{"SRC"}
    g[r][c] = GOODID(good$)
    st{"SRC"} = g
    RETURN ""
ENDFUNC

EXPORT FUNC PUTSINK(st, r, c, player)
    DIM g = st{"SINK"}
    g[r][c] = player
    st{"SINK"} = g
    RETURN ""
ENDFUNC

' ------------------------------------------------------------- the layout ---

' A stroke is what an editor draws: a straight run, a single cell, a source,
' a sink, a machine. Everything a map can be made of goes through PLACE, so
' hand-authored and generated layouts cannot drift apart.
FUNC APPLYSTROKES(st, strokes)
    DIM si
    FOR si = 0 TO LEN(strokes) - 1
        DIM s = strokes[si]
        DIM op$ = UCASE$("" + s{"OP"})
        DIM r = s{"R"}
        DIM c = s{"C"}
        IF op$ = "RUN" THEN
            DIM d = DIRNO("" + s{"DIR"})
            DIM dr = DROF(d)
            DIM dc = DCOF(d)
            DIM k
            FOR k = 0 TO s{"LEN"} - 1
                DIM why$ = PLACE(st, r + dr * k, c + dc * k, "BAND", d)
            NEXT k
        ELSEIF op$ = "CELL" THEN
            DIM w1$ = PLACE(st, r, c, "" + s{"KIND"}, DIRNO("" + s{"DIR"}))
        ELSEIF op$ = "MACH" THEN
            ' a machine inherits the direction of the belt it is dropped on
            DIM dirg = st{"DIR"}
            DIM w2$ = PLACE(st, r, c, "" + s{"KIND"}, dirg[r][c])
        ELSEIF op$ = "SRC" THEN
            DIM w3$ = PUTSOURCE(st, r, c, "" + s{"GOOD"})
        ELSEIF op$ = "SINK" THEN
            DIM w4$ = PUTSINK(st, r, c, s{"PLAYER"})
        ENDIF
    NEXT si
    RETURN st
ENDFUNC

' The generated layout the probe measured: belt rows every LANE rows running
' in alternating directions, joined at the ends by a riser. One connected path
' over the whole grid, which is the densest a belt layout gets.
FUNC APPLYGEN(st, gen)
    DIM n = st{"N"}
    DIM lane = gen{"LANE"}
    DIM flat = IOTA(n * n, 0)
    DIM rowi = RESHAPE(INT(flat / n), [n, n])
    DIM coli = RESHAPE(flat MOD n, [n, n])

    DIM lastrow = n - 1 - lane
    lastrow = lastrow - (lastrow MOD lane)
    DIM laneno = INT(rowi / lane)
    DIM goeast = ((laneno MOD 2) = 0)
    DIM onlane = ((rowi MOD lane) = 0) * (rowi >= lane) * (rowi <= lastrow)
    DIM inrun = (coli >= 2) * (coli <= n - 3)
    DIM turncol = goeast * (n - 3) + (1 - goeast) * 2
    DIM atturn = (coli = turncol)

    DIM dirg = onlane * inrun * (goeast * 2 + (1 - goeast) * 4)
    DIM turncell = onlane * inrun * atturn
    dirg = dirg * (1 - turncell) + turncell * 3
    DIM ingap = ((rowi MOD lane) <> 0) * (rowi >= lane) * (rowi < lastrow)
    st{"DIR"} = dirg + ingap * atturn * 3

    DIM mstep = gen{"MACHSTEP"}
    DIM machcell = onlane * inrun * ((coli MOD mstep) = 5) * (1 - atturn)
    DIM mk = PARTS(){"machines"}{"" + gen{"MACH"}}
    st{"MACH"} = machcell
    st{"MACHIN"} = machcell * GOODID("" + mk{"IN"})
    st{"MACHOUT"} = machcell * GOODID("" + mk{"OUT"})
    st{"MACHCD0"} = machcell * mk{"DWELL"}
    st{"CD"} = machcell * mk{"DWELL"}

    DIM sstep = gen{"SRCSTEP"}
    st{"SRC"} = onlane * inrun * ((coli MOD sstep) = 7) * GOODID("" + gen{"GOOD"})
    st{"SINK"} = onlane * atturn * (rowi = lastrow) * gen{"PLAYER"}
    RETURN st
ENDFUNC

EXPORT FUNC NEWGAME(layout$)
    DIM all = LAYOUTS()
    IF NOT MAP.EXISTS(all, layout$) THEN RETURN BLANK(8)
    DIM spec = all{layout$}
    DIM st = BLANK(spec{"N"})
    st{"LAYOUT"} = layout$
    IF MAP.EXISTS(spec, "GEN") THEN st = APPLYGEN(st, spec{"GEN"})
    IF MAP.EXISTS(spec, "STROKES") THEN st = APPLYSTROKES(st, spec{"STROKES"})
    RETURN REBUILD(st)
ENDFUNC

' --------------------------------------------------------------- the tick ---

EXPORT FUNC ADVANCE(st)
    DIM itemg = st{"ITEM"}
    DIM masks = st{"MASK"}
    DIM aheads = st{"AHEAD"}
    DIM free0 = (itemg = 0)
    DIM ready = 1 - free0

    ' A machine keeps the good it is built for until its dwell is up and hands
    ' back what its recipe says. Both sit in the cell as numbers, so the cost
    ' of this block does not grow when the game gains machine kinds.
    IF st{"HASMACH"} THEN
        DIM mach = st{"MACH"}
        DIM cdg = st{"CD"}
        DIM busy = mach * (itemg = st{"MACHIN"})
        cdg = cdg - busy
        DIM ripe = busy * (cdg = 0)
        itemg = itemg * (1 - ripe) + ripe * st{"MACHOUT"}
        ready = ready * (1 - busy * (cdg > 0))
        st{"CD"} = cdg * (itemg > 0) + mach * (itemg = 0) * st{"MACHCD0"}
    ENDIF

    ' All four directions read one snapshot of the grid, so a good that turns a
    ' corner cannot be picked up a second time in the same tick by a later
    ' direction. Claims keep two goods off one cell where belts merge.
    DIM claimed = free0 * 0
    DIM d
    FOR d = 1 TO 4
        DIM dr = DROF(d)
        DIM dc = DCOF(d)
        DIM go = masks[d - 1] * ready * aheads[d - 1] * LOOKAT(free0, dr, dc) * (1 - LOOKAT(claimed, dr, dc))
        DIM carry = go * itemg
        itemg = itemg - carry + CARRYTO(carry, dr, dc)
        claimed = claimed + CARRYTO(go, dr, dc)
    NEXT d

    ' What reaches a sink is booked to that sink's player and leaves the board.
    IF st{"HASSINK"} THEN
        DIM sink = st{"SINK"}
        DIM landed = (sink > 0) * (itemg > 0)
        IF SUM(RESHAPE(landed, [st{"N"} * st{"N"}])) > 0 THEN
            st = BOOK(st, sink, landed, itemg)
        ENDIF
        itemg = itemg * (1 - landed)
    ENDIF

    itemg = itemg + st{"SRC"} * (itemg = 0)
    st{"ITEM"} = itemg
    st{"TICK"} = st{"TICK"} + 1
    RETURN st
ENDFUNC

' Counting per player costs one pass per player and one per good kind. It only
' runs on a tick where something actually arrived.
FUNC BOOK(st, sink, landed, itemg)
    DIM n = st{"N"}
    DIM gs = PARTS(){"goods"}
    DIM worth = landed * 0
    FOR EACH k$ IN MAP.KEYS(gs)
        worth = worth + (itemg = gs{k$}{"ID"}) * gs{k$}{"SCORE"}
    NEXT k$
    DIM delivered = st{"DELIVERED"}
    DIM score = st{"SCORE"}
    DIM pl
    FOR pl = 1 TO 4
        DIM mine = landed * (sink = pl)
        DIM cnt = SUM(RESHAPE(mine, [n * n]))
        IF cnt > 0 THEN
            delivered[pl] = delivered[pl] + cnt
            score[pl] = score[pl] + SUM(RESHAPE(mine * worth, [n * n]))
        ENDIF
    NEXT pl
    st{"DELIVERED"} = delivered
    st{"SCORE"} = score
    RETURN st
ENDFUNC

' ------------------------------------------------------------- the numbers ---

EXPORT FUNC COUNTGOODS(st)
    DIM n = st{"N"}
    RETURN SUM(RESHAPE((st{"ITEM"} > 0) * 1, [n * n]))
ENDFUNC

EXPORT FUNC COUNTBUILT(st)
    DIM n = st{"N"}
    RETURN SUM(RESHAPE((st{"DIR"} > 0) * 1, [n * n]))
ENDFUNC

' Where a single good sits. Only for tests and tools - it walks the grid.
EXPORT FUNC FINDGOOD(st)
    DIM n = st{"N"}
    DIM g = st{"ITEM"}
    DIM r
    DIM c
    FOR r = 0 TO n - 1
        FOR c = 0 TO n - 1
            IF g[r][c] > 0 THEN RETURN [r, c, g[r][c]]
        NEXT c
    NEXT r
    RETURN [-1, -1, 0]
ENDFUNC
