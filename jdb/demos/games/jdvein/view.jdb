' A window on a running layout. The rules tick at their own rate and the
' picture is drawn from whatever the state happens to be, which is the split
' the whole design rests on: 20 ticks a second, as many frames as fit.
'
'   jdbasic view.jdb                     SCHLANGE, live
'   jdbasic view.jdb WERK                another layout
'   jdbasic view.jdb --log bauplan.json  replay a recording and watch it
'   jdbasic view.jdb WERK --shot         one picture to tmp/jdvein.png
IMPORT VEIN
IMPORT VPAINT

CONST HZ = 20
DIM stopafter = 600

DIM why$ = VEIN.LOADDATA()
IF why$ <> "" THEN
    PRINT why$
    END
ENDIF

DIM args = OS.ARGS()
DIM layout$ = "SCHLANGE"
DIM logfile$ = ""
DIM shot = 0
DIM ai
FOR ai = 1 TO LEN(args) - 1
    IF args[ai] = "--shot" THEN
        shot = 1
    ELSEIF args[ai] = "--log" ANDALSO ai + 1 < LEN(args) THEN
        logfile$ = args[ai + 1]
        ai = ai + 1
    ELSEIF args[ai] = "--secs" ANDALSO ai + 1 < LEN(args) THEN
        stopafter = VAL(args[ai + 1])
        ai = ai + 1
    ELSEIF LEFT$(args[ai], 2) <> "--" THEN
        layout$ = UCASE$(args[ai])
    ENDIF
NEXT ai

DIM st = 0
IF logfile$ <> "" THEN
    ' a recording is the match: the factory below was never placed by hand
    DIM raw$ = ""
    TRY
        raw$ = TXTREADER$(logfile$)
    CATCH
        TRY
            raw$ = TXTREADER$(VEIN.HERE$() + logfile$)
        CATCH
            PRINT "Aufzeichnung nicht lesbar: "; logfile$
            END
        ENDTRY
    ENDTRY
    DIM log = JSON.PARSE$(raw$)
    layout$ = "" + log{"LAYOUT"}
    st = VEIN.REPLAY(log)
    PRINT "nachgespielt: "; LEN(log{"CMDS"}); " Befehle auf "; layout$
ELSE
    DIM all = VEIN.LAYOUTS()
    IF NOT MAP.EXISTS(all, layout$) THEN
        PRINT layout$; " gibt es nicht"
        END
    ENDIF
    st = VEIN.NEWGAME(layout$)
ENDIF

IF ("" + st{"ERR"}) <> "" THEN
    PRINT "Abbruch: "; st{"ERR"}
    IF ("" + st{"ERR"}) = "msg_logrefused" THEN
        PRINT st{"REFUSED"}; " von "; LEN(log{"CMDS"}); " Befehlen wurden abgelehnt."
    ENDIF
    END
ENDIF

DIM n = st{"N"}
CONST WIN = 1024
CONST STRIP = 52
DIM zoom = INT(WIN / n)
IF zoom < 1 THEN zoom = 1

SCREEN WIN, WIN + STRIP, "jdVEIN - " + layout$
CLS 0, 0, 0
DIM base = VPAINT.BASE(st)
DIM goods$ = VEIN.GOODLIST()

' What the port received and what is still in the ground. Without it the board
' is squares moving: the whole point of a run is the two numbers at the bottom.
SUB HUD(s, y0)
    RECT 0, y0, WIN, STRIP, TRUE, 10, 14, 26
    DIM x = 12
    DIM gi
    FOR gi = 0 TO LEN(goods$) - 1
        DIM g$ = "" + goods$[gi]
        DIM c = VEIN.GOODCOLOR(g$)
        DIM txt$ = g$ + " " + STR$(VEIN.GOTBY(s, 1, g$))
        TEXT x, y0 + 8, txt$, c[0], c[1], c[2]
        x = x + 26 + LEN(txt$) * 11
    NEXT gi
    TEXT 12, y0 + 30, "Punkte " + STR$(s{"SCORE"}[1]) _
        + "    Floez " + STR$(VEIN.ORELEFT(s)) _
        + "    in Maschinen " + STR$(VEIN.INBUFFERS(s)) _
        + "    unterwegs " + STR$(VEIN.COUNTGOODS(s)) _
        + "    Tick " + STR$(s{"TICK"}), 170, 180, 210
ENDSUB

DIM running = 1
SUB STOPIT()
    running = 0
ENDSUB

IF shot = 1 THEN
    DIM k
    FOR k = 1 TO 400
        st = VEIN.ADVANCE(st)
    NEXT k
    PLOTRAW 0, 0, VPAINT.FRAME(base, st), zoom, zoom
    HUD(st, n * zoom + 2)
    GFX.SAVE_SCREENSHOT(VEIN.HERE$() + "../../../../tmp/jdvein.png")
    SCREENFLIP
    PRINT "wrote tmp/jdvein.png  "; VEIN.COUNTGOODS(st); " Waren, geliefert "; st{"DELIVERED"}[1]
ELSE
    ON "QUIT" CALL STOPIT
    ON "KEYDOWN" CALL STOPIT
    DIM per_tick = 1000.0 / HZ
    DIM frames = 0
    DIM t_start = TICK()
    DIM t_last = t_start
    DIM tick0 = st{"TICK"}
    DIM carry = 0.0
    DO WHILE running = 1
        DIM now = TICK()
        carry = carry + (now - t_last)
        t_last = now
        ' the rules do not speed up just because the picture is cheap to draw
        DO WHILE carry >= per_tick
            st = VEIN.ADVANCE(st)
            carry = carry - per_tick
        LOOP
        PLOTRAW 0, 0, VPAINT.FRAME(base, st), zoom, zoom
        HUD(st, n * zoom + 2)
        SCREENFLIP
        frames = frames + 1
        IF (now - t_start) / 1000.0 >= stopafter THEN running = 0
    LOOP
    DIM secs = (TICK() - t_start) / 1000.0
    PRINT frames; " Bilder in "; INT(secs * 10) / 10.0; " s = "; INT(frames / secs); " fps"
    PRINT st{"TICK"} - tick0; " Ticks in dieser Sitzung = "; INT((st{"TICK"} - tick0) / secs); " je Sekunde"
    PRINT "geliefert "; st{"DELIVERED"}[1]; ", Punkte "; st{"SCORE"}[1]
ENDIF
