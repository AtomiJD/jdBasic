' INVICTUS - The Unbeatable Duel
' Local 2-player top-down twin-stick arena duel.
' Run: build/jdBasic.exe invictus.jdb [shot]
' "shot" mode plays a scripted demo, saves screenshots, exits.
' F fullscreen, ESC quit, R rematch.

BASE$ = "D:/usr/dev/cc/jdb/demos/games/invictus/"
NAME1$ = "DAD"
NAME2$ = "SON"

' --- tweakables (balancing is live-editable through this map) ---
TW = {}
TW{"move_speed"}   = 240
TW{"dash_speed"}   = 720
TW{"dash_s"}       = 0.15
TW{"dash_cool"}    = 0.8
TW{"hp_max"}       = 5
TW{"lives_max"}    = 3
TW{"respawn_s"}    = 1.2
TW{"inv_s"}        = 1.5
TW{"crowns_win"}   = 5
TW{"deadzone"}     = 0.25
TW{"aim_ax_x"}     = 3
TW{"aim_ax_y"}     = 4
TW{"pad_first_s"}  = 3.0
TW{"pad_respawn_s"} = 8.0
TW{"pickup_reach"} = 24
TW{"star_s"}       = 5.0
TW{"over_s"}       = 8.0
TW{"boots_s"}      = 8.0
TW{"ghost_s"}      = 6.0
TW{"boots_mult"}   = 1.4

' --- sound: music loop on voices 0/1, SFX on 2-7 ---

SUB SOUND_SETUP()
    SOUND.INIT
    SOUND.BPM 140

    SOUND.VOICE 0, "SQUARE", 0.01, 0.15, 0.30, 0.22
    SOUND.FILTER 0, 2400
    SOUND.GAIN 0, 0.32

    SOUND.VOICE 1, "SAW", 0.005, 0.12, 0.45, 0.10
    SOUND.FILTER 1, 600
    SOUND.GAIN 1, 0.42

    SOUND.VOICE 2, "SQUARE", 0.005, 0.05, 0.0, 0.04
    SOUND.FILTER 2, 4200
    SOUND.GAIN 2, 0.26

    SOUND.VOICE 3, "NOISE", 0.005, 0.28, 0.0, 0.22
    SOUND.FILTER 3, 750
    SOUND.GAIN 3, 0.6
    SOUND.BITCRUSH 3, 0.4, 6

    SOUND.VOICE 4, "SQUARE", 0.003, 0.06, 0.0, 0.05
    SOUND.FILTER 4, 2600
    SOUND.GAIN 4, 0.3

    SOUND.VOICE 5, "TRIANGLE", 0.003, 0.12, 0.0, 0.1
    SOUND.FILTER 5, 3000
    SOUND.GAIN 5, 0.4

    SOUND.VOICE 6, "NOISE", 0.005, 0.5, 0.0, 0.4
    SOUND.FILTER 6, 300
    SOUND.GAIN 6, 0.7

    SOUND.VOICE 7, "TRIANGLE", 0.005, 0.15, 0.0, 0.12
    SOUND.FILTER 7, 800
    SOUND.GAIN 7, 0.45

    SOUND.REVERB 0.7, 0.3, 0.8, 0.25
    SOUND.REVERBSEND 0, 0.35
    SOUND.REVERBSEND 3, 0.3
    SOUND.REVERBSEND 6, 0.4

    DIM melody$ = _
        "[a4 ~ c5 e5] [a5 g5 e5 c5] [d5 ~ f5 a5] [g5 f5 e5 d5] " + _
        "[c5 ~ e5 g5] [f5 e5 d5 c5] [b4 ~ d5 f5] [e5 d5 b4 g4]"
    DIM bass$ = _
        "[[a2 a3]*4] [[a2 a3]*4] [[d2 d3]*4] [[g2 g3]*4] " + _
        "[[c2 c3]*4] [[f2 f3]*4] [[e2 e3]*4] [[e2 e3]*4]"
    SOUND.NOTE "< " + melody$ + " , " + bass$ + " >", TRUE
ENDSUB

SUB SFX_SHOT(kind$)
    IF kind$ = "rocket" ORELSE kind$ = "grenade" THEN
        SOUND.PLAY 7, "e3"
    ELSEIF kind$ = "flame" THEN
        SOUND.PLAY 2, "c4"
    ELSEIF kind$ = "disc" THEN
        SOUND.PLAY 2, "e6"
    ELSE
        SOUND.PLAY 2, "g6"
    ENDIF
ENDSUB

SUB SFX_BOOM()
    SOUND.PLAY 3, "c2"
ENDSUB

SUB SFX_RAIL()
    SOUND.PLAY 3, "c5"
    SOUND.PLAY 2, "c7"
ENDSUB

SUB SFX_SWORD()
    SOUND.PLAY 7, "a3"
ENDSUB

SUB SFX_HIT()
    SOUND.PLAY 4, "e5"
ENDSUB

SUB SFX_SHIELD()
    SOUND.PLAY 4, "b5"
ENDSUB

SUB SFX_PICKUP()
    SOUND.PLAY 5, "c6"
ENDSUB

SUB SFX_DEATH()
    SOUND.PLAY 6, "c2"
ENDSUB

SUB SFX_CROWN()
    SOUND.PLAY 5, "g6"
    SOUND.PLAY 6, "c2"
ENDSUB

' 0-sustain SFX voices hold their gate; drain every frame so notes retrigger
SUB SFX_DRAIN()
    DIM t AS INTEGER
    FOR t = 2 TO 7
        SOUND.RELEASE t
    NEXT t
ENDSUB

SUB MUSIC_TOGGLE()
    music_on = NOT music_on
    IF music_on THEN
        SOUND.GAIN 0, 0.32
        SOUND.GAIN 1, 0.42
    ELSE
        SOUND.GAIN 0, 0
        SOUND.GAIN 1, 0
    ENDIF
ENDSUB

' --- weapons ---

FUNC MK_WPN(wname$, kind$, cool, dmg, spd, ammo, pellets, spread, ttl, splash)
    DIM w = {}
    w{"name"} = wname$
    w{"kind"} = kind$
    w{"cool"} = cool
    w{"dmg"} = dmg
    w{"spd"} = spd
    w{"ammo"} = ammo
    w{"pellets"} = pellets
    w{"spread"} = spread
    w{"ttl"} = ttl
    w{"splash"} = splash
    RETURN w
ENDFUNC

