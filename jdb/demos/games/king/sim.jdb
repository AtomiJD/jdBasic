' test hook: put the hero somewhere
EXPORT SUB PLACE_HERO(x, y)
    PL{"x"} = x
    PL{"y"} = y
    PL{"vx"} = 0
    PL{"vy"} = 0
    PL{"climb"} = -1
    PL{"plat"} = PLATUNDER(x, y, 4)
    PL{"fall_y"} = y
    PL{"ride"} = -1
ENDSUB

' test hook: drop a spool at x on platform pi rolling at vx
EXPORT SUB ADD_SPOOL(pidx, x, vx)
    DIM s AS MAP = {}
    s{"x"} = x
    s{"y"} = SURFY(PLATS[pidx], x)
    s{"plat"} = pidx
    s{"vx"} = vx
    s{"vy"} = 0
    s{"ladder"} = -1
    s{"last_ladder"} = -1
    s{"scored"} = 0
    s{"anim"} = 0
    s{"roll"} = 0
    s{"dead"} = 0
    SPOOLS = APPEND(SPOOLS, s)
ENDSUB

EXPORT SUB SET_KING_TIMER(t)
    KG{"t"} = t
ENDSUB

EXPORT FUNC BUTTON()
    RETURN BTN
ENDFUNC

EXPORT FUNC SINKLIST()
    RETURN SINKS
ENDFUNC

EXPORT FUNC LEVEL()
    RETURN LV
ENDFUNC
