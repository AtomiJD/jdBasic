' jdTower - neon tower defence for phone and desktop.
'   jdbasic jdtower.jdb                       play (guest, or the saved login)
'   jdbasic jdtower.jdb <name> <pin>          play logged in
'   jdbasic jdtower.jdb shot [level]          one frame of a running level -> tmp/shot.png
'   jdbasic jdtower.jdb shotmenu              the level select -> tmp/shot.png
' The rules live in sim.jdb. Everything bright is drawn additively into an
' offscreen image; the frame goes to the screen with three ever blurrier
' copies of itself on top, which is the glow. Text is set afterwards so it
' stays sharp.
IMPORT SIM

CONST SCR_W = 480
CONST SCR_H = 864
CONST TILE = 40
CONST FY0 = 64
CONST BAR_Y = 784
CONST SIM_DT = 0.0333
CONST TWO_PI = 6.283185307

DIM running = 1
SUB OnQuit()
    running = 0
ENDSUB
ON "QUIT" CALL OnQuit@

DIM taps = []
SUB OnTap(info)
    taps = APPEND(taps, [[info[0]{"x"}, info[0]{"y"}]])
ENDSUB
ON "MOUSEDOWN" CALL OnTap@

DIM keys_in = []
SUB OnKey(info)
    keys_in = APPEND(keys_in, info[0]{"key"})
ENDSUB
ON "KEYDOWN" CALL OnKey@

' ── where things are ────────────────────────────────────────────

DIM GAMEDIR$ = ""
DIM cli = OS.ARGS()
IF LEN(cli) > 0 THEN
    DIM a0$ = REPLACE$("" + cli[0], "\", "/")
    DIM cut = -1
    DIM ci
    FOR ci = 0 TO LEN(a0$) - 1
        IF MID$(a0$, ci, 1) = "/" THEN cut = ci
    NEXT ci
    IF cut >= 0 THEN GAMEDIR$ = LEFT$(a0$, cut + 1)
ENDIF

DIM SRV$ = "http://127.0.0.1:8082"
DIM WEB$ = ""
DIM WEB_PATH$ = "/tower/play/"
DIM myname$ = ""
DIM mypin$ = ""
DIM auth$ = ""
DIM lang$ = "de"
DIM show_fps = 0
TRY
    DIM up = JSON.PARSE(TXTREADER$("/url_params.json"))
    IF MAP.EXISTS(up, "name") THEN myname$ = up{"name"}
    IF MAP.EXISTS(up, "auth") THEN auth$ = up{"auth"}
    IF MAP.EXISTS(up, "base") THEN WEB_PATH$ = up{"base"}
    IF MAP.EXISTS(up, "fps") THEN show_fps = 1
    IF MAP.EXISTS(up, "__lang") THEN lang$ = LCASE$(MID$(up{"__lang"}, 0, 2))
    IF MAP.EXISTS(up, "lang") THEN lang$ = LCASE$(MID$(up{"lang"}, 0, 2))
    IF MAP.EXISTS(up, "__origin") THEN
        DIM org$ = up{"__origin"}
        WEB$ = org$ + WEB_PATH$
        IF INSTR(org$, "://192.168.") < 0 ANDALSO INSTR(org$, "://localhost") < 0 ANDALSO INSTR(org$, "://127.") < 0 THEN
            SRV$ = org$ + "/tower/api"
        ENDIF
    ENDIF
CATCH
ENDTRY

' Stamped by deploy.sh with a hash of data/, so a deploy never meets a
' browser cache that still holds the files of the one before
DIM DATA_VER$ = "dev"

' A data file from next to the game, else from the site that served it
FUNC LOADTEXT$(rel$)
    IF FILE.EXISTS(GAMEDIR$ + rel$) THEN RETURN TXTREADER$(GAMEDIR$ + rel$)
    IF FILE.EXISTS(rel$) THEN RETURN TXTREADER$(rel$)
    RETURN HTTP.GET$(WEB$ + rel$ + "?v=" + DATA_VER$)
ENDFUNC

DIM towers_json = JSON.PARSE(LOADTEXT$("data/towers.json"))
DIM enemies_json = JSON.PARSE(LOADTEXT$("data/enemies.json"))
DIM ach_defs = JSON.PARSE(LOADTEXT$("data/achievements.json")){"LIST"}
DIM langs = JSON.PARSE(LOADTEXT$("data/lang.json"))
IF NOT MAP.EXISTS(langs, lang$) THEN lang$ = "en"
SIM.SETDATA(towers_json, enemies_json)

FUNC T$(k$)
    IF MAP.EXISTS(langs{lang$}, k$) THEN RETURN langs{lang$}{k$}
    RETURN k$
ENDFUNC

FUNC HAST(k$)
    RETURN IIF(MAP.EXISTS(langs{lang$}, k$), 1, 0)
ENDFUNC

' A text with {n}, {r} or {k} filled in
FUNC TF$(k$, n$, r$)
    RETURN REPLACE$(REPLACE$(REPLACE$(T$(k$), "{n}", n$), "{r}", r$), "{k}", n$)
ENDFUNC

CONST N_LEVELS = 40
' the maps endless runs are played on, by level number
DIM ARENAS = [7, 12, 19]

' A copy the caller may change without touching the cached level
FUNC CLONE(m)
    RETURN JSON.PARSE(JSON.STRINGIFY$(m))
ENDFUNC

DIM level_cache AS MAP = {}
FUNC LEVELDATA(n)
    DIM key$ = STR$(n)
    IF NOT MAP.EXISTS(level_cache, key$) THEN
        level_cache{key$} = JSON.PARSE(LOADTEXT$("data/levels/level_" + RIGHT$("0" + key$, 2) + ".json"))
    ENDIF
    RETURN level_cache{key$}
ENDFUNC

' enemy looks, by kind number as the sim counts them
DIM ek_sides = []
DIM ek_size = []
DIM ek_col = []
DIM ek_spin = []
DIM ek_mirror = []
SUB LOADKINDS()
    DIM i = 0
    FOR EACH k$ IN enemies_json{"ORDER"}
        DIM ed = enemies_json{"ENEMIES"}{k$}
        ek_sides = APPEND(ek_sides, ed{"SIDES"})
        ek_size = APPEND(ek_size, ed{"SIZE"})
        ek_col = APPEND(ek_col, [ed{"COLOR"}])
        ek_spin = APPEND(ek_spin, 0.6 + (i MOD 4) * 0.35)
        ek_mirror = APPEND(ek_mirror, IIF(MAP.EXISTS(ed, "REFLECT"), 1, 0))
        i = i + 1
    NEXT k$
ENDSUB
LOADKINDS()

FUNC TCOL(kind$)
    IF NOT MAP.EXISTS(towers_json{"TOWERS"}, kind$) THEN RETURN [200, 200, 230]
    RETURN towers_json{"TOWERS"}{kind$}{"COLOR"}
ENDFUNC

' ── progress ────────────────────────────────────────────────────
' The server keeps a profile: best result per level, counters, earned
' badges and endless records. A guest on the desktop keeps the same in
' profile.json next to the game.

DIM progress AS MAP = {}
DIM stats AS MAP = {}
DIM ach = []
DIM endless_rec AS MAP = {}
DIM online = 0
DIM net_msg$ = ""

SUB TAKEPROFILE(r)
    IF TYPEOF(r{"PROGRESS"}) = "OBJECT" THEN progress = r{"PROGRESS"}
    IF TYPEOF(r{"STATS"}) = "OBJECT" THEN stats = r{"STATS"}
    IF TYPEOF(r{"ACH"}) = "ARRAY" THEN ach = r{"ACH"}
    IF TYPEOF(r{"ENDLESS"}) = "OBJECT" THEN endless_rec = r{"ENDLESS"}
ENDSUB

SUB SAVELOCAL()
    IF auth$ = "" ANDALSO GAMEDIR$ <> "" THEN
        TRY
            TXTWRITER GAMEDIR$ + "profile.json", JSON.STRINGIFY$({ "PROGRESS": progress, "STATS": stats, "ACH": ach, "ENDLESS": endless_rec })
        CATCH
        ENDTRY
    ENDIF
ENDSUB

SUB LOADLOCAL()
    TRY
        IF FILE.EXISTS(GAMEDIR$ + "profile.json") THEN
            TAKEPROFILE(JSON.PARSE(TXTREADER$(GAMEDIR$ + "profile.json")))
        ELSEIF FILE.EXISTS(GAMEDIR$ + "progress.json") THEN
            progress = JSON.PARSE(TXTREADER$(GAMEDIR$ + "progress.json"))
        ENDIF
    CATCH
    ENDTRY
ENDSUB

SUB LOGIN()
    IF auth$ = "" ANDALSO myname$ <> "" ANDALSO mypin$ <> "" THEN
        TRY
            DIM body$ = JSON.STRINGIFY$({ "NAME": myname$, "PIN": mypin$ })
            DIM r = JSON.PARSE(HTTP.POST$(SRV$ + "/login", body$, "text/plain"))
            IF r{"OK"} = 1 THEN
                auth$ = r{"AUTH"}
                myname$ = r{"NAME"}
            ELSE
                net_msg$ = r{"MSG"}
            ENDIF
        CATCH
            net_msg$ = T$("offline")
        ENDTRY
    ENDIF
    IF auth$ <> "" THEN
        TRY
            DIM r2 = JSON.PARSE(HTTP.GET$(SRV$ + "/progress?auth=" + auth$))
            IF r2{"OK"} = 1 THEN
                TAKEPROFILE(r2)
                myname$ = r2{"NAME"}
                online = 1
            ENDIF
        CATCH
            net_msg$ = T$("offline")
        ENDTRY
    ELSE
        LOADLOCAL()
    ENDIF
ENDSUB

FUNC STARSOF(n)
    DIM k$ = STR$(n)
    IF MAP.EXISTS(progress, k$) THEN RETURN progress{k$}{"STARS"}
    RETURN 0
ENDFUNC

FUNC BESTOF(n)
    DIM k$ = STR$(n)
    IF MAP.EXISTS(progress, k$) THEN RETURN progress{k$}{"SCORE"}
    RETURN 0
ENDFUNC

FUNC WORLDSTARS(w)
    DIM total = 0
    DIM n
    FOR n = 20 * (w - 1) + 1 TO 20 * w
        total = total + STARSOF(n)
    NEXT n
    RETURN total
ENDFUNC

FUNC UNLOCKED(n)
    IF n = 1 THEN RETURN 1
    IF STARSOF(n - 1) > 0 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC ENDLESSBEST(a)
    DIM k$ = STR$(a)
    IF MAP.EXISTS(endless_rec, k$) THEN RETURN endless_rec{k$}{"WAVE"}
    RETURN 0
ENDFUNC

SUB RECORD(n, stars, score)
    DIM k$ = STR$(n)
    DIM old_s = STARSOF(n)
    DIM old_p = BESTOF(n)
    DIM row AS MAP = {}
    row{"STARS"} = MAX([old_s, stars])
    row{"SCORE"} = MAX([old_p, score])
    progress{k$} = row
    IF auth$ <> "" THEN
        TRY
            DIM body$ = JSON.STRINGIFY$({ "AUTH": auth$, "LEVEL": n, "STARS": stars, "SCORE": score })
            DIM r = JSON.PARSE(HTTP.POST$(SRV$ + "/result", body$, "text/plain"))
            IF r{"OK"} = 1 THEN progress = r{"PROGRESS"}
        CATCH
            net_msg$ = T$("offline")
        ENDTRY
    ELSE
        SAVELOCAL()
    ENDIF
ENDSUB

' A new endless record; answers 1 when it beat the old one
FUNC RECORDENDLESS(a, waves_done, score)
    DIM k$ = STR$(a)
    DIM better = IIF(waves_done > ENDLESSBEST(a), 1, 0)
    IF better = 1 THEN endless_rec{k$} = { "WAVE": waves_done, "SCORE": score }
    IF auth$ <> "" THEN
        TRY
            DIM body$ = JSON.STRINGIFY$({ "AUTH": auth$, "ARENA": a, "WAVE": waves_done, "SCORE": score })
            DIM r = JSON.PARSE(HTTP.POST$(SRV$ + "/endless", body$, "text/plain"))
            IF r{"OK"} = 1 THEN TAKEPROFILE(r)
        CATCH
            net_msg$ = T$("offline")
        ENDTRY
    ELSE
        SAVELOCAL()
    ENDIF
    RETURN better
ENDFUNC

' ── counters and badges ─────────────────────────────────────────

FUNC STAT(k$)
    IF MAP.EXISTS(stats, k$) THEN RETURN stats{k$}
    RETURN 0
ENDFUNC

SUB STATADD(k$, n)
    stats{k$} = STAT(k$) + n
ENDSUB

SUB STATMAX(k$, v)
    IF v > STAT(k$) THEN stats{k$} = v
ENDSUB

' Counters the badges read that follow from the rest of the profile
SUB DERIVESTATS()
    stats{"stars_w1"} = WORLDSTARS(1)
    stats{"stars_w2"} = WORLDSTARS(2)
    stats{"w1_done"} = IIF(STARSOF(20) > 0, 1, 0)
    stats{"w2_done"} = IIF(STARSOF(40) > 0, 1, 0)
    DIM best = 0
    DIM a
    FOR a = 1 TO LEN(ARENAS)
        IF ENDLESSBEST(a) > best THEN best = ENDLESSBEST(a)
    NEXT a
    stats{"endless_best"} = best
ENDSUB

' How far a badge is, 0..1, the weakest of its counters
FUNC ACHFRAC(d)
    DIM f = 1.0
    FOR EACH k$ IN d{"STATS"}
        DIM v = STAT(k$) / d{"GOAL"}
        IF v < f THEN f = v
    NEXT k$
    RETURN f
ENDFUNC

FUNC HASACH(id$)
    RETURN IIF(INDEXOF(ach, id$) >= 0, 1, 0)
ENDFUNC

FUNC ACHNAME$(d)
    IF LEFT$(d{"ID"}, 4) = "max_" THEN RETURN T$("a_max") + ": " + T$(d{"TOWER"})
    RETURN T$("a_" + d{"ID"})
ENDFUNC

FUNC ACHDESC$(d)
    IF LEFT$(d{"ID"}, 4) = "max_" THEN RETURN T$("a_max_d")
    RETURN T$("a_" + d{"ID"} + "_d")
ENDFUNC

FUNC ACHCOLOR(d)
    IF MAP.EXISTS(d, "TOWER") THEN RETURN TCOL(d{"TOWER"})
    RETURN d{"COLOR"}
ENDFUNC

DIM ach_queue = []
DIM ach_dirty = 0

SUB ACHCHECK()
    DERIVESTATS()
    FOR EACH d IN ach_defs
        IF HASACH(d{"ID"}) = 0 ANDALSO ACHFRAC(d) >= 1 THEN
            ach = APPEND(ach, d{"ID"})
            ach_queue = APPEND(ach_queue, [d])
            ach_dirty = 1
        ENDIF
    NEXT d
ENDSUB

SUB SAVEPROFILE()
    DERIVESTATS()
    IF auth$ <> "" THEN
        TRY
            DIM body$ = JSON.STRINGIFY$({ "AUTH": auth$, "STATS": stats, "ACH": ach })
            DIM r = JSON.PARSE(HTTP.POST$(SRV$ + "/profile", body$, "text/plain"))
            IF r{"OK"} = 1 THEN TAKEPROFILE(r)
        CATCH
            net_msg$ = T$("offline")
        ENDTRY
    ELSE
        SAVELOCAL()
    ENDIF
    ach_dirty = 0
ENDSUB

' ── boards and the daily challenge ──────────────────────────────

DIM board AS MAP = {}
DIM board_tab$ = "W1"
SUB LOADBOARD(tab$)
    board_tab$ = tab$
    board = {}
    TRY
        DIM url$ = SRV$ + "/board?tab=" + tab$
        IF auth$ <> "" THEN url$ = url$ + "&auth=" + auth$
        DIM r = JSON.PARSE(HTTP.GET$(url$))
        IF r{"OK"} = 1 THEN board = r
    CATCH
        net_msg$ = T$("offline")
    ENDTRY
ENDSUB

DIM daily AS MAP = {}
DIM daily_top = []
SUB LOADDAILY()
    daily = {}
    daily_top = []
    TRY
        DIM url$ = SRV$ + "/daily"
        IF auth$ <> "" THEN url$ = url$ + "?auth=" + auth$
        DIM r = JSON.PARSE(HTTP.GET$(url$))
        IF r{"OK"} = 1 THEN daily = r
        DIM b = JSON.PARSE(HTTP.GET$(SRV$ + "/board?tab=DAY"))
        IF b{"OK"} = 1 THEN daily_top = b{"TOP"}
    CATCH
        net_msg$ = T$("offline")
    ENDTRY
ENDSUB

' The tower a "one tower only" day allows: one that hits air and ground
FUNC DAILYKIND$(lv, arg)
    DIM cands = []
    FOR EACH k$ IN ["LASER", "BLASTER", "TESLA"]
        IF INDEXOF(lv{"TOWERS"}, k$) >= 0 THEN cands = APPEND(cands, k$)
    NEXT k$
    RETURN cands[arg MOD LEN(cands)]
ENDFUNC

FUNC DAILYRULE$()
    IF NOT MAP.EXISTS(daily, "RULE") THEN RETURN ""
    IF daily{"RULE"} = "ONLY" THEN RETURN TF$("rule_ONLY", T$(DAILYKIND$(LEVELDATA(daily{"LEVEL"}), daily{"ARG"})), "")
    RETURN T$("rule_" + daily{"RULE"})
ENDFUNC

' Sends a won daily run; counts a new day for the badges
SUB RECORDDAILY(score)
    IF auth$ = "" ORELSE NOT MAP.EXISTS(daily, "DATE") THEN RETURN
    TRY
        DIM body$ = JSON.STRINGIFY$({ "AUTH": auth$, "DATE": daily{"DATE"}, "SCORE": score })
        DIM r = JSON.PARSE(HTTP.POST$(SRV$ + "/dailyresult", body$, "text/plain"))
        IF r{"OK"} = 1 THEN
            daily{"MINE"} = r{"MINE"}
            IF r{"NEW"} = 1 THEN STATADD("daily", 1)
        ENDIF
    CATCH
        net_msg$ = T$("offline")
    ENDTRY
ENDSUB

' ── sound ───────────────────────────────────────────────────────
' Tracks 1-5 are effects played by hand, 6-9 the background loop on the
' sequencer. Every effect voice has sustain 0, so notes end on their own.

DIM snd_on = 0
DIM sfx_on = 1
DIM mus_on = 1
DIM sfx_last AS MAP = {}

SUB SNDINIT()
    TRY
        SOUND.INIT
        SOUND.VOICE 1, "TRIANGLE", 0.002, 0.12, 0.0, 0.06
        SOUND.VOICE 2, "SQUARE", 0.001, 0.05, 0.0, 0.03
        SOUND.VOICE 3, "NOISE", 0.002, 0.28, 0.0, 0.15
        SOUND.VOICE 4, "SAW", 0.001, 0.09, 0.0, 0.05
        SOUND.VOICE 5, "SINE", 0.002, 0.16, 0.0, 0.08
        SOUND.GAIN 1, 0.35
        SOUND.GAIN 2, 0.14
        SOUND.GAIN 3, 0.4
        SOUND.GAIN 4, 0.16
        SOUND.GAIN 5, 0.28
        SOUND.FILTER 4, 2600, 0.3
        SOUND.FILTER 3, 1800
        snd_on = 1
    CATCH
        snd_on = 0
    ENDTRY
ENDSUB

' The menu loop: Am - F - C - G, slow and soft. Each level brings its own
' loop in the MUSIC block of its JSON file, same four tracks.
DIM MENU_SONG AS MAP = {}
MENU_SONG{"BPM"} = 92
MENU_SONG{"PAD"} = "<[a3,c4,e4] [f3,a3,c4] [c4,e4,g4] [g3,b3,d4]>"
MENU_SONG{"BASS"} = "<[a1 ~ a2 ~]*2 [f1 ~ f2 ~]*2 [c2 ~ c3 ~]*2 [g1 ~ g2 ~]*2>"
MENU_SONG{"ARP"} = "<[a4 c5 e5 c5]*2 [f4 a4 c5 a4]*2 [c5 e5 g5 e5]*2 [g4 b4 d5 b4]*2>"
MENU_SONG{"DRUMS"} = "[bd ~ ~ ~] [~ hh ~ hh] [~ ~ bd ~] [~ hh ~ hh]"

' The finale: C - G - Am - F, bright and fast
DIM FINALE_SONG AS MAP = {}
FINALE_SONG{"BPM"} = 128
FINALE_SONG{"PAD"} = "<[c4,e4,g4] [g3,b3,d4] [a3,c4,e4] [f3,a3,c4]>"
FINALE_SONG{"BASS"} = "<[c2 c3]*4 [g1 g2]*4 [a1 a2]*4 [f1 f2]*4>"
FINALE_SONG{"ARP"} = "<[c5 e5 g5 c6]*4 [b4 d5 g5 b5]*4 [a4 c5 e5 a5]*4 [a4 c5 f5 a5]*4>"
FINALE_SONG{"DRUMS"} = "[bd hh bd hh] [sd hh bd hh] [bd hh bd oh] [sd hh cp hh]"

' A song missing a track or carrying a pattern the sequencer refuses keeps
' the menu loop for that track instead of going silent
SUB SETSONG(song)
    IF snd_on = 0 THEN RETURN
    DIM tracks = ["PAD", "BASS", "ARP", "DRUMS"]
    DIM t
    FOR t = 0 TO 3
        DIM pat$ = MENU_SONG{tracks[t]}
        IF TYPEOF(song) = "OBJECT" THEN
            IF MAP.EXISTS(song, tracks[t]) THEN pat$ = "" + song{tracks[t]}
        ENDIF
        TRY
            SOUND.SEQ 6 + t, pat$, "VOICE"
        CATCH
            TRY
                SOUND.SEQ 6 + t, MENU_SONG{tracks[t]}, "VOICE"
            CATCH
            ENDTRY
        ENDTRY
    NEXT t
    DIM bpm = 92
    IF TYPEOF(song) = "OBJECT" THEN
        IF MAP.EXISTS(song, "BPM") THEN bpm = song{"BPM"}
    ENDIF
    TRY
        SOUND.BPM bpm
    CATCH
    ENDTRY
ENDSUB

SUB MUSICINIT()
    IF snd_on = 0 THEN RETURN
    TRY
        SOUND.VOICE 6, "SAW", 0.6, 0.5, 0.7, 1.2
        SOUND.FILTER 6, 900, 0.2
        SOUND.GAIN 6, 0.07
        SOUND.VOICE 7, "TRIANGLE", 0.005, 0.3, 0.3, 0.1
        SOUND.GAIN 7, 0.2
        SOUND.VOICE 8, "SQUARE", 0.002, 0.09, 0.1, 0.08
        SOUND.FILTER 8, 1700, 0.25
        SOUND.GAIN 8, 0.05
        SOUND.KIT 9, "SYNTH"
        SOUND.GAIN 9, 0.13
    CATCH
    ENDTRY
    SETSONG(MENU_SONG)
    MUSICMIX("menu")
ENDSUB

DIM mus_mode$ = "menu"
SUB MUSICMIX(mode$)
    mus_mode$ = mode$
    IF snd_on = 0 THEN RETURN
    TRY
        DIM all_off = IIF(mus_on = 1, 0, 1)
        SOUND.MUTE 6, all_off
        SOUND.MUTE 8, all_off
        DIM groove_off = IIF(mus_on = 1 ANDALSO mode$ = "play", 0, 1)
        SOUND.MUTE 7, groove_off
        SOUND.MUTE 9, groove_off
    CATCH
    ENDTRY
ENDSUB

SUB SFX(name$)
    IF snd_on = 0 ORELSE sfx_on = 0 THEN RETURN
    DIM sfx_now = TICK()
    IF MAP.EXISTS(sfx_last, name$) THEN
        IF sfx_now - sfx_last{name$} < 70 THEN RETURN
    ENDIF
    sfx_last{name$} = sfx_now
    TRY
        IF name$ = "BLASTER" THEN
            SOUND.PLAY 2, 1320 + RND() * 200
        ELSEIF name$ = "RAIL" THEN
            SOUND.PLAY 4, 196
            SOUND.PLAY 2, 1760
        ELSEIF name$ = "BOMB" THEN
            SOUND.PLAY 1, 110
        ELSEIF name$ = "BOOM" THEN
            SOUND.PLAY 3, 70 + RND() * 30
        ELSEIF name$ = "ZAP" THEN
            SOUND.PLAY 4, 880 + RND() * 300
        ELSEIF name$ = "PULSE" THEN
            SOUND.PLAY 1, 165
            SOUND.PLAY 5, 330
        ELSEIF name$ = "LASER" THEN
            SOUND.PLAY 5, 990
        ELSEIF name$ = "FLAME" THEN
            SOUND.PLAY 3, 400
        ELSEIF name$ = "DIE" THEN
            DIM notes = [523, 587, 659, 784, 880]
            SOUND.PLAY 5, notes[INT(RND() * 5)] * 2
        ELSEIF name$ = "BUILD" THEN
            SOUND.PLAY 1, 523
            SOUND.PLAY 5, 784
        ELSEIF name$ = "SELL" THEN
            SOUND.PLAY 1, 392
        ELSEIF name$ = "LEAK" THEN
            SOUND.PLAY 4, 98
            SOUND.PLAY 3, 60
        ELSEIF name$ = "WAVE" THEN
            SOUND.PLAY 1, 220
            SOUND.PLAY 5, 440
        ELSEIF name$ = "TAP" THEN
            SOUND.PLAY 2, 660
        ELSEIF name$ = "WIN" THEN
            SOUND.PLAY 1, 523
            SOUND.PLAY 5, 659
            SOUND.PLAY 2, 784
        ELSEIF name$ = "LOSE" THEN
            SOUND.PLAY 4, 110
            SOUND.PLAY 1, 82
        ELSEIF name$ = "PULL" THEN
            SOUND.PLAY 4, 130
            SOUND.PLAY 5, 196
        ELSEIF name$ = "BLINK" THEN
            SOUND.PLAY 2, 1568
        ELSEIF name$ = "ACH" THEN
            SOUND.PLAY 5, 1047
            SOUND.PLAY 1, 784
            SOUND.PLAY 2, 1319
        ENDIF
    CATCH
        snd_on = 0
    ENDTRY
ENDSUB

' ── drawing primitives ──────────────────────────────────────────

DIM glow_on = 1
DIM scene_img = 0
DIM mip_img = [0, 0, 0, 0]
DIM bg_img = 0
DIM font$ = ""
DIM font_now = 0

SUB GFXINIT()
    scene_img = GFX.NEWTARGET(SCR_W, SCR_H)
    DIM i
    FOR i = 0 TO 3
        mip_img[i] = GFX.NEWTARGET(INT(SCR_W / 2 ^ (i + 1)), INT(SCR_H / 2 ^ (i + 1)))
    NEXT i
    bg_img = GFX.NEWTARGET(SCR_W, 12 * 0 + 18 * TILE)
    DIM cands = ["/jdbasic_default.ttf", GAMEDIR$ + "jdbasic_default.ttf", "jdbasic_default.ttf", GAMEDIR$ + "../../../../build/jdbasic_default.ttf"]
    FOR EACH c$ IN cands
        IF font$ = "" ANDALSO FILE.EXISTS(c$) THEN font$ = c$
    NEXT c$
ENDSUB

SUB FONTSIZE(sz)
    IF font$ <> "" ANDALSO sz <> font_now THEN
        SETFONT font$, sz
        font_now = sz
    ENDIF
ENDSUB

SUB BEGINFRAME()
    GFX.TARGET scene_img, TRUE
    CLS 3, 3, 12
    GFX.BLEND "ADD"
ENDSUB

SUB ENDFRAME()
    GFX.BLEND "BLEND"
    GFX.TARGET
    CLS 0, 0, 0
    DIM qx = [0, SCR_W, SCR_W, 0]
    DIM qy = [0, 0, SCR_H, SCR_H]
    IF glow_on = 1 THEN
        DIM src = scene_img
        DIM i
        FOR i = 0 TO 3
            DIM mw = INT(SCR_W / 2 ^ (i + 1))
            DIM mh = INT(SCR_H / 2 ^ (i + 1))
            GFX.TARGET mip_img[i], TRUE
            GFX.DRAWQUAD src, [0, mw, mw, 0], [0, 0, mh, mh], 255, "NONE", 1
            src = mip_img[i]
        NEXT i
        GFX.TARGET
    ENDIF
    GFX.DRAWQUAD scene_img, qx, qy, 255, "NONE", 1
    IF glow_on = 1 THEN
        GFX.DRAWQUAD mip_img[1], qx, qy, 105, "ADD", 1
        GFX.DRAWQUAD mip_img[2], qx, qy, 160, "ADD", 1
        GFX.DRAWQUAD mip_img[3], qx, qy, 210, "ADD", 1
    ENDIF
    FLUSHTEXT()
ENDSUB

' a0, b0, a1, b1, ...
FUNC WEAVE(a, b)
    RETURN FLATTEN(TRANSPOSE(RESHAPE(APPEND(a, b), [2, LEN(a)])))
ENDFUNC

FUNC WHICH(mask)
    RETURN TAKE(SUM(mask), GRADE(0 - mask))
ENDFUNC

FUNC SHADE(c, k)
    RETURN [INT(c[0] * k), INT(c[1] * k), INT(c[2] * k)]
ENDFUNC

' A closed regular polygon around one centre
SUB POLY(cx, cy, r, sides, rot, c, w)
    DIM a = rot + IOTA(sides + 1, 0) * TWO_PI / sides
    GFX.LINES cx + r * COS(a), cy + r * SIN(a), w, c[0], c[1], c[2]
ENDSUB

' Regular polygons around many centres in one call; rs may be one radius
' or one per centre
SUB POLYBATCH(xs, ys, rs, sides, rot, c, w)
    DIM n = LEN(xs)
    IF n = 0 THEN RETURN
    DIM rr = rs + xs * 0
    DIM a0 = rot + IOTA(sides, 0) * TWO_PI / sides
    DIM a1 = a0 + TWO_PI / sides
    DIM unit_row = ONES(sides)
    DIM bx = OUTER(xs, unit_row, "*")
    DIM by = OUTER(ys, unit_row, "*")
    DIM sx = FLATTEN(OUTER(rr, COS(a0), "*") + bx)
    DIM sy = FLATTEN(OUTER(rr, SIN(a0), "*") + by)
    DIM ex = FLATTEN(OUTER(rr, COS(a1), "*") + bx)
    DIM ey = FLATTEN(OUTER(rr, SIN(a1), "*") + by)
    GFX.LINES WEAVE(sx, ex), WEAVE(sy, ey), w, c[0], c[1], c[2], TRUE
ENDSUB

SUB SEG(x1, y1, x2, y2, c, w)
    GFX.LINES [x1, x2], [y1, y2], w, c[0], c[1], c[2]
ENDSUB

' A neon outline box; filled dark first so it reads over the field
SUB PANEL(x, y, w, h, c, alpha)
    GFX.BLEND "BLEND"
    DRAWCOLOR 4, 4, 16, alpha
    ROUNDED_RECT x, y, w, h, 12, TRUE
    GFX.BLEND "ADD"
    DRAWCOLOR c[0], c[1], c[2], 255
    ROUNDED_RECT x, y, w, h, 12, FALSE
    DIM d = SHADE(c, 0.45)
    DRAWCOLOR d[0], d[1], d[2], 255
    ROUNDED_RECT x + 2, y + 2, w - 4, h - 4, 10, FALSE
ENDSUB

' ── text, set after the glow ────────────────────────────────────

DIM text_q = []
SUB QTEXT(x, y, s$, c, sz)
    text_q = APPEND(text_q, [[x, y, s$, c, sz]])
ENDSUB

FUNC TEXTW(s$, sz)
    FONTSIZE(sz)
    TRY
        RETURN GFX.TEXTSIZE(s$)[0]
    CATCH
    ENDTRY
    RETURN LEN(s$) * sz * 0.55
ENDFUNC

SUB CTEXT(cx, y, s$, c, sz)
    QTEXT(cx - TEXTW(s$, sz) / 2, y, s$, c, sz)
ENDSUB

SUB FLUSHTEXT()
    GFX.BLEND "BLEND"
    FOR EACH q IN text_q
        FONTSIZE(q[4])
        DIM c = q[3]
        TEXT q[0], q[1], q[2], c[0], c[1], c[2]
    NEXT q
    text_q = []
ENDSUB

' ── hit areas ───────────────────────────────────────────────────
' Every button registers itself while it is drawn; a tap is tested against
' the list of the frame the finger saw.

DIM hits = []
DIM hits_prev = []
SUB HIT(x, y, w, h, act$)
    hits = APPEND(hits, [[x, y, w, h, act$]])
ENDSUB

FUNC HITTEST$(px, py)
    DIM found$ = ""
    FOR EACH h IN hits_prev
        IF px >= h[0] ANDALSO px < h[0] + h[2] ANDALSO py >= h[1] ANDALSO py < h[1] + h[3] THEN found$ = h[4]
    NEXT h
    RETURN found$
ENDFUNC

SUB BUTTON(x, y, w, h, label$, c, act$, sz)
    PANEL(x, y, w, h, c, 200)
    CTEXT(x + w / 2, y + h / 2 - sz * 0.62, label$, [235, 240, 255], sz)
    HIT(x, y, w, h, act$)
ENDSUB

' ── game state ──────────────────────────────────────────────────

DIM uimode$ = "menu"
DIM cur_level = 1
DIM speed = 1
DIM paused = 0
DIM sel_slot = -1
DIM pending$ = ""
DIM ring_cx = 0
DIM ring_cy = 0
DIM toast$ = ""
DIM toast_t = 0
DIM result_done = 0
DIM result_score = 0
DIM result_stars = 0
DIM fx = []
DIM paths_px = []
DIM tnow = 0.0
DIM frame = 0
DIM flash = 0.0
DIM sim_acc = 0.0
DIM dt_frame = 0.0333
DIM fps_avg = 30.0
DIM toast2$ = ""

' what is being played: "level", "endless" or "daily", on which map
DIM play_kind$ = "level"
DIM cur_lv AS MAP = {}
DIM cur_arena = 1
DIM world = 1
DIM gold_on = 0

' what the badges need to know about the running level
DIM lv_kinds = []
DIM lv_max_towers = 0
DIM lv_turbo = 1
DIM lost_set AS MAP = {}
DIM perks_taken = 0
DIM result_record = 0
DIM ach_pick = -1
DIM finale_world = 1

SUB TOAST(s$)
    toast$ = s$
    toast2$ = ""
    toast_t = tnow + 1.6
ENDSUB

FUNC PXX(tx)
    RETURN tx * TILE
ENDFUNC

FUNC PXY(ty)
    RETURN FY0 + ty * TILE
ENDFUNC

FUNC TOWERCOUNT()
    DIM n = 0
    DIM i
    FOR i = 0 TO SIM.NSLOTS() - 1
        IF SIM.TOWER(i){"KIND"} <> "" THEN n = n + 1
    NEXT i
    RETURN n
ENDFUNC

' Gold look for whoever has every star of world 1
FUNC THEMECOL(normal, golden)
    IF gold_on = 1 THEN RETURN golden
    RETURN normal
ENDFUNC

' The field that never changes during a level: grid, roads, portal frames
SUB BAKEFIELD(lv)
    GFX.TARGET bg_img, TRUE
    GFX.BLEND "ADD"
    DIM fh = lv{"ROWS"} * TILE
    DIM i
    DIM gx = []
    DIM gy = []
    FOR i = 0 TO lv{"COLS"}
        gx = APPEND(gx, [i * TILE, i * TILE])
        gy = APPEND(gy, [0, fh])
    NEXT i
    FOR i = 0 TO lv{"ROWS"}
        gx = APPEND(gx, [0, SCR_W])
        gy = APPEND(gy, [i * TILE, i * TILE])
    NEXT i
    DIM gc = THEMECOL([26, 18, 52], [44, 32, 10])
    GFX.LINES gx, gy, 1, gc[0], gc[1], gc[2], TRUE
    DIM edge_cols = THEMECOL([[40, 200, 255], [255, 60, 190], [140, 255, 120]], [[255, 200, 80], [255, 140, 40], [255, 235, 160]])
    DIM p = 0
    GFX.BLEND "NONE"
    FOR EACH pts IN lv{"PATHS"}
        DIM xs = []
        DIM ys = []
        FOR EACH q IN pts
            xs = APPEND(xs, q[0] * TILE)
            ys = APPEND(ys, q[1] * TILE)
        NEXT q
        DIM ec = edge_cols[p MOD 3]
        GFX.LINES xs, ys, 34, INT(ec[0] * 0.55), INT(ec[1] * 0.55), INT(ec[2] * 0.55)
        p = p + 1
    NEXT pts
    FOR EACH pts2 IN lv{"PATHS"}
        DIM xs2 = []
        DIM ys2 = []
        FOR EACH q2 IN pts2
            xs2 = APPEND(xs2, q2[0] * TILE)
            ys2 = APPEND(ys2, q2[1] * TILE)
        NEXT q2
        GFX.LINES xs2, ys2, 28, 12, 10, 30
    NEXT pts2
    GFX.BLEND "ADD"
    GFX.TARGET
ENDSUB

FUNC WAVEKINDS(lv)
    DIM out = []
    FOR EACH wv IN lv{"WAVES"}
        FOR EACH g IN wv{"GROUPS"}
            IF INDEXOF(out, g{"E"}) < 0 THEN out = APPEND(out, g{"E"})
        NEXT g
    NEXT wv
    RETURN out
ENDFUNC

' Starts whatever map lv is; the callers set play_kind$ first
SUB STARTMAP(lv)
    cur_lv = lv
    SIM.START(lv)
    BAKEFIELD(lv)
    paths_px = []
    DIM p
    FOR p = 0 TO SIM.NPATHS() - 1
        DIM pm = SIM.PATHXY(p)
        DIM m AS MAP = {}
        m{"X"} = pm{"X"} * TILE
        m{"Y"} = pm{"Y"} * TILE + FY0
        m{"N"} = LEN(pm{"X"})
        paths_px = APPEND(paths_px, [m])
    NEXT p
    sel_slot = -1
    pending$ = ""
    paused = 0
    speed = 1
    fx = []
    result_done = 0
    result_record = 0
    flash = 0.0
    perks_taken = 0
    lv_kinds = []
    lv_max_towers = 0
    lv_turbo = 1
    uimode$ = "play"
    IF MAP.EXISTS(lv, "MUSIC") THEN
        SETSONG(lv{"MUSIC"})
    ELSE
        SETSONG(MENU_SONG)
    ENDIF
    MUSICMIX("play")
ENDSUB

SUB STARTLEVEL(n)
    cur_level = n
    play_kind$ = "level"
    world = IIF(n > 20, 2, 1)
    DIM lv = LEVELDATA(n)
    STARTMAP(lv)
    IF n > 1 THEN
        DIM before = LEVELDATA(n - 1)
        FOR EACH k$ IN lv{"TOWERS"}
            IF INDEXOF(before{"TOWERS"}, k$) < 0 THEN
                TOAST(T$("new_tower") + ": " + T$(k$))
                toast2$ = T$(k$ + "_d")
                toast_t = tnow + 5
            ENDIF
        NEXT k$
        DIM old_kinds = WAVEKINDS(before)
        FOR EACH e$ IN WAVEKINDS(lv)
            IF INDEXOF(old_kinds, e$) < 0 ANDALSO HAST(e$ + "_h") = 1 THEN
                TOAST(T$("new_enemy") + ": " + T$(e$))
                toast2$ = T$(e$ + "_h")
                toast_t = tnow + 6
            ENDIF
        NEXT e$
    ENDIF
ENDSUB

' An endless run on one of the arenas, with every tower
SUB STARTENDLESS(a)
    cur_arena = a
    play_kind$ = "endless"
    DIM lv = CLONE(LEVELDATA(ARENAS[a - 1]))
    lv{"TOWERS"} = towers_json{"ORDER"}
    lv{"CREDITS"} = 900
    lv{"LIVES"} = 25
    lv{"ENDLESS"} = 1000 + a
    lv{"NAME"} = T$("endless") + " - " + lv{"NAME"}
    cur_level = ARENAS[a - 1]
    STARTMAP(lv)
ENDSUB

' Today's challenge: a level of world 1 with one rule bent
SUB STARTDAILY()
    IF NOT MAP.EXISTS(daily, "LEVEL") THEN RETURN
    play_kind$ = "daily"
    cur_level = daily{"LEVEL"}
    DIM lv = CLONE(LEVELDATA(cur_level))
    DIM rule$ = daily{"RULE"}
    IF rule$ = "ONLY" THEN lv{"TOWERS"} = [DAILYKIND$(lv, daily{"ARG"})]
    IF rule$ = "FAST" THEN lv{"SPDX"} = 1.4
    IF rule$ = "POOR" THEN lv{"CREDITS"} = INT(lv{"CREDITS"} * 0.6)
    IF rule$ = "FRAGILE" THEN lv{"LIVES"} = 5
    IF rule$ = "TOUGH" THEN lv{"HPMUL"} = 1.5
    lv{"NAME"} = T$("daily_title") + " - " + lv{"NAME"}
    STARTMAP(lv)
    TOAST(DAILYRULE$())
    toast_t = tnow + 5
ENDSUB

SUB RESTART()
    IF play_kind$ = "endless" THEN
        STARTENDLESS(cur_arena)
    ELSEIF play_kind$ = "daily" THEN
        STARTDAILY()
    ELSE
        STARTLEVEL(cur_level)
    ENDIF
ENDSUB

' ── effects ─────────────────────────────────────────────────────

SUB ADDFX(m)
    m{"T0"} = tnow
    fx = APPEND(fx, [m])
ENDSUB

SUB EVENTSTOFX()
    FOR EACH ev IN SIM.EVENTS()
        DIM t$ = ev{"T"}
        IF t$ = "SHOT" THEN
            SFX(ev{"K"})
        ELSEIF t$ = "BEAMON" THEN
            SFX("LASER")
        ELSEIF t$ = "HIT" THEN
            ADDFX({ "F": "BURST", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "C": TCOL(ev{"K"}), "R": 9, "N": 4, "DUR": 0.18 })
        ELSEIF t$ = "BOOM" THEN
            ADDFX({ "F": "RING", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "R0": 4, "R1": ev{"R"} * TILE, "C": TCOL(ev{"K"}), "DUR": 0.35, "W": 4 })
            ADDFX({ "F": "BURST", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "C": [255, 220, 140], "R": ev{"R"} * TILE * 0.8, "N": 8, "DUR": 0.3 })
            SFX("BOOM")
        ELSEIF t$ = "ZAP" THEN
            ADDFX({ "F": "ZAP", "XS": ev{"XS"} * TILE, "YS": ev{"YS"} * TILE + FY0, "C": TCOL("TESLA"), "DUR": 0.16 })
            SFX("ZAP")
            IF LEN(ev{"XS"}) >= 6 THEN stats{"chain5"} = 1
        ELSEIF t$ = "RAIL" THEN
            ADDFX({ "F": "LINE", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "X2": PXX(ev{"X2"}), "Y2": PXY(ev{"Y2"}), "C": [200, 255, 210], "W": 5, "DUR": 0.3 })
            SFX("RAIL")
        ELSEIF t$ = "PULSE" THEN
            ADDFX({ "F": "RING", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "R0": 10, "R1": ev{"R"} * TILE, "C": TCOL("PULSE"), "DUR": 0.45, "W": 5 })
            SFX("PULSE")
        ELSEIF t$ = "FLAME" THEN
            ADDFX({ "F": "FLAME", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "X2": PXX(ev{"X2"}), "Y2": PXY(ev{"Y2"}), "R": ev{"R"} * TILE, "DUR": 0.3 })
            SFX("FLAME")
        ELSEIF t$ = "DIE" THEN
            DIM kno = INDEXOF(enemies_json{"ORDER"}, ev{"K"})
            ADDFX({ "F": "BURST", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "C": ek_col[kno], "R": ek_size[kno] * 2.2, "N": 7, "DUR": 0.4 })
            ADDFX({ "F": "TXT", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}) - 10, "S": "+" + STR$(ev{"REW"}), "C": [255, 220, 90], "DUR": 0.8 })
            SFX("DIE")
            STATADD("kills", 1)
            IF ev{"K"} = "OVERLORD" THEN STATADD("boss_kills", 1)
            IF ev{"K"} = "TITAN" THEN STATADD("titan_kills", 1)
        ELSEIF t$ = "LEAK" THEN
            flash = 1.0
            SFX("LEAK")
        ELSEIF t$ = "BUILD" ORELSE t$ = "UPGRADE" THEN
            ADDFX({ "F": "RING", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "R0": 22, "R1": 4, "C": TCOL(ev{"K"}), "DUR": 0.35, "W": 3 })
            SFX("BUILD")
            IF t$ = "BUILD" THEN
                STATADD("builds", 1)
                IF INDEXOF(lv_kinds, ev{"K"}) < 0 THEN lv_kinds = APPEND(lv_kinds, ev{"K"})
                lv_max_towers = MAX([lv_max_towers, TOWERCOUNT()])
            ENDIF
        ELSEIF t$ = "SELL" THEN
            ADDFX({ "F": "RING", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "R0": 4, "R1": 30, "C": [255, 220, 90], "DUR": 0.4, "W": 3 })
            SFX("SELL")
        ELSEIF t$ = "WAVE" THEN
            SFX("WAVE")
            STATADD("waves", 1)
            IF ev{"EARLY"} > 0 THEN STATADD("early", 1)
            IF ev{"EARLY"} > 0 THEN TOAST("+" + STR$(ev{"EARLY"}) + " " + T$("early"))
        ELSEIF t$ = "WIN" THEN
            SFX("WIN")
        ELSEIF t$ = "LOSE" THEN
            SFX("LOSE")
        ELSEIF t$ = "PULL" THEN
            ADDFX({ "F": "RING", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "R0": ev{"R"} * TILE, "R1": 8, "C": TCOL("VORTEX"), "DUR": 0.5, "W": 4 })
            IF ev{"N"} > 0 THEN SFX("PULL")
        ELSEIF t$ = "BLINK" THEN
            ADDFX({ "F": "BURST", "X": PXX(ev{"X"}), "Y": PXY(ev{"Y"}), "C": [255, 255, 150], "R": 14, "N": 6, "DUR": 0.3 })
            SFX("BLINK")
        ENDIF
    NEXT ev
ENDSUB

SUB DRAWFX()
    DIM keep = []
    FOR EACH f IN fx
        DIM age = (tnow - f{"T0"}) / f{"DUR"}
        IF age < 1 THEN
            keep = APPEND(keep, [f])
            DIM k = 1 - age
            DIM kind$ = f{"F"}
            IF kind$ = "RING" THEN
                DIM rr = f{"R0"} + (f{"R1"} - f{"R0"}) * (1 - k * k)
                POLY(f{"X"}, f{"Y"}, rr, 28, 0, SHADE(f{"C"}, k), f{"W"} * k + 1)
            ELSEIF kind$ = "BURST" THEN
                DIM n = f{"N"}
                DIM a = IOTA(n, 0) * TWO_PI / n + f{"T0"} * 3
                DIM r1 = f{"R"} * (0.3 + 0.7 * age)
                DIM r2 = r1 + 5 * k
                GFX.LINES WEAVE(f{"X"} + r1 * COS(a), f{"X"} + r2 * COS(a)), WEAVE(f{"Y"} + r1 * SIN(a), f{"Y"} + r2 * SIN(a)), 2, INT(f{"C"}[0] * k), INT(f{"C"}[1] * k), INT(f{"C"}[2] * k), TRUE
            ELSEIF kind$ = "ZAP" THEN
                DIM jx = f{"XS"} + (RND() - 0.5) * 0 + SIN(IOTA(LEN(f{"XS"}), 0) * 7 + tnow * 40) * 3
                DIM jy = f{"YS"} + COS(IOTA(LEN(f{"YS"}), 0) * 5 + tnow * 37) * 3
                DIM zc = SHADE(f{"C"}, k)
                GFX.LINES jx, jy, 5, INT(zc[0] * 0.5), INT(zc[1] * 0.5), INT(zc[2] * 0.5)
                GFX.LINES jx, jy, 2, 230, 220, 255
            ELSEIF kind$ = "LINE" THEN
                DIM lc = SHADE(f{"C"}, k)
                SEG(f{"X"}, f{"Y"}, f{"X2"}, f{"Y2"}, lc, f{"W"} * k + 1)
            ELSEIF kind$ = "FLAME" THEN
                DIM fa = ATAN2(f{"Y2"} - f{"Y"}, f{"X2"} - f{"X"})
                DIM fd = SQR((f{"X2"} - f{"X"}) ^ 2 + (f{"Y2"} - f{"Y"}) ^ 2)
                DIM sp = IOTA(5, 0) * 0.12 - 0.24
                DIM fl = fd * (0.4 + 0.6 * age)
                GFX.LINES WEAVE(f{"X"} + 0 * sp, f{"X"} + fl * COS(fa + sp)), WEAVE(f{"Y"} + 0 * sp, f{"Y"} + fl * SIN(fa + sp)), 3, INT(255 * k), INT(110 * k), INT(40 * k), TRUE
                POLY(f{"X2"}, f{"Y2"}, f{"R"} * (0.5 + 0.5 * age), 10, tnow, SHADE([255, 120, 40], k * 0.7), 2)
            ELSEIF kind$ = "TXT" THEN
                CTEXT(f{"X"}, f{"Y"} - age * 26, f{"S"}, SHADE(f{"C"}, 0.4 + 0.6 * k), 15)
            ENDIF
        ENDIF
    NEXT f
    fx = keep
ENDSUB

' ── the field ───────────────────────────────────────────────────

SUB DRAWFLOW()
    DIM p = 0
    FOR EACH pm IN paths_px
        DIM gap = 30
        DIM n = INT((pm{"N"} - 12) / gap)
        IF n > 0 THEN
            DIM shift_px = INT(tnow * 22) MOD gap
            DIM idx = IOTA(n, 0) * gap + shift_px
            DIM nxt = idx + 6
            DIM x0 = pm{"X"}[idx]
            DIM y0 = pm{"Y"}[idx]
            DIM dx = pm{"X"}[nxt] - x0
            DIM dy = pm{"Y"}[nxt] - y0
            DIM dl = SQR(dx * dx + dy * dy) + 0.001
            dx = dx / dl * 6
            dy = dy / dl * 6
            DIM tipx = x0 + dx
            DIM tipy = y0 + dy
            DIM lx = x0 - dy
            DIM ly = y0 + dx
            DIM rx = x0 + dy
            DIM ry = y0 - dx
            DIM c = IIF(p MOD 2 = 0, [30, 120, 160], [150, 40, 120])
            GFX.LINES APPEND(WEAVE(lx, tipx), WEAVE(rx, tipx)), APPEND(WEAVE(ly, tipy), WEAVE(ry, tipy)), 2, c[0], c[1], c[2], TRUE
        ENDIF
        p = p + 1
    NEXT pm
ENDSUB

SUB DRAWGATES(lv)
    DIM pulse = 0.6 + 0.4 * SIN(tnow * 3)
    FOR EACH pts IN lv{"PATHS"}
        DIM sx = pts[0][0] * TILE
        POLY(sx, FY0 + 6, 16, 3, 1.5708, SHADE([255, 70, 160], pulse), 3)
    NEXT pts
    DIM last = lv{"PATHS"}[0][LEN(lv{"PATHS"}[0]) - 1]
    DIM bx = last[0] * TILE
    DIM by = FY0 + (lv{"ROWS"} - 0.5) * TILE
    POLY(bx, by, 17, 6, tnow * 0.5, [80, 230, 255], 3)
    POLY(bx, by, 10 + 2 * pulse, 6, 0 - tnow, [190, 250, 255], 2)
    POLY(bx, by, 24, 6, 0, SHADE([60, 160, 255], 0.5), 1.5)
ENDSUB

SUB DRAWSLOTS()
    DIM xs = []
    DIM ys = []
    DIM i
    FOR i = 0 TO SIM.NSLOTS() - 1
        IF SIM.TOWER(i){"KIND"} = "" THEN
            DIM s = SIM.SLOTPOS(i)
            xs = APPEND(xs, PXX(s[0] + 0.5))
            ys = APPEND(ys, PXY(s[1] + 0.5))
        ENDIF
    NEXT i
    IF LEN(xs) = 0 THEN RETURN
    POLYBATCH(xs, ys, 15, 6, 0, [70, 60, 130], 2)
    DIM pl = 4
    GFX.LINES APPEND(WEAVE(xs - pl, xs + pl), WEAVE(xs, xs)), APPEND(WEAVE(ys, ys), WEAVE(ys - pl, ys + pl)), 2, 90, 80, 160, TRUE
ENDSUB

SUB DRAWTOWER(slot)
    DIM t = SIM.TOWER(slot)
    DIM k$ = t{"KIND"}
    DIM cx = PXX(t{"X"})
    DIM cy = PXY(t{"Y"})
    DIM c = TCOL(k$)
    DIM a = t{"AIM"}
    DIM s = t{"S"}
    DIM mode$ = s{"MODE"}
    POLY(cx, cy, 17, 6, 0, SHADE(c, 0.35), 2)
    IF k$ = "LASER" THEN
        POLY(cx, cy, 12, 4, a, c, 2.5)
        POLY(cx, cy, 5, 4, a, [220, 255, 255], 2)
    ELSEIF k$ = "BLASTER" THEN
        POLY(cx, cy, 10, 8, 0, c, 2.5)
        DIM nb = s{"BARRELS"}
        IF mode$ = "RAIL" THEN nb = 1
        DIM b
        FOR b = 0 TO nb - 1
            DIM bar_off = (b - (nb - 1) / 2) * 5
            DIM ox = cx - SIN(a) * bar_off
            DIM oy = cy + COS(a) * bar_off
            SEG(ox, oy, ox + COS(a) * IIF(mode$ = "RAIL", 22, 15), oy + SIN(a) * IIF(mode$ = "RAIL", 22, 15), c, 3)
        NEXT b
    ELSEIF k$ = "CRYO" THEN
        POLY(cx, cy, 11, 6, 0, c, 2)
        DIM sa = IOTA(6, 0) * TWO_PI / 6 + tnow * 0.6
        GFX.LINES WEAVE(cx + sa * 0, cx + 9 * COS(sa)), WEAVE(cy + sa * 0, cy + 9 * SIN(sa)), 2, 200, 240, 255, TRUE
    ELSEIF k$ = "BOMB" THEN
        POLY(cx, cy, 13, 4, 0.785, c, 2.5)
        SEG(cx, cy, cx + COS(a) * 11, cy + SIN(a) * 11, [255, 220, 150], 6)
    ELSEIF k$ = "TESLA" THEN
        POLY(cx, cy, 13, 3, -1.5708, c, 2.5)
        POLY(cx, cy, 6, 3, 1.5708, [230, 210, 255], 2)
        IF frame MOD 6 < 3 THEN SEG(cx, cy - 13, cx + (RND() - 0.5) * 10, cy - 20, [220, 200, 255], 1.5)
    ELSEIF k$ = "PULSE" THEN
        DIM pr = 1 - MAX([0, t{"CD"}]) * s{"RATE"}
        POLY(cx, cy, 12, 8, tnow * 0.3, c, 2.5)
        POLY(cx, cy, 3 + 6 * pr, 12, 0, [255, 190, 240], 2)
    ELSEIF k$ = "PLASMA" THEN
        POLY(cx, cy, 11, 5, a, c, 2.5)
        SEG(cx + COS(a) * 6, cy + SIN(a) * 6, cx + COS(a) * 15, cy + SIN(a) * 15, [255, 200, 120], 5)
    ELSEIF k$ = "RELAY" THEN
        DIM st = IOTA(11, 0) * TWO_PI / 10 - 1.5708 + tnow * 0.2
        DIM sr = 6 + 7 * ((IOTA(11, 0) MOD 2) = 0)
        GFX.LINES cx + sr * COS(st), cy + sr * SIN(st), 2.5, c[0], c[1], c[2]
    ELSEIF k$ = "VORTEX" THEN
        ' a spiral that winds inwards
        DIM va = IOTA(25, 0) * 0.42 + tnow * 2.2
        DIM vr = 14 - IOTA(25, 0) * 0.5
        GFX.LINES cx + vr * COS(va), cy + vr * SIN(va), 2.5, c[0], c[1], c[2]
        GFX.LINES cx - vr * COS(va), cy - vr * SIN(va), 1.5, 200, 210, 255
    ENDIF
    ' tier pips under the tower, branch ring around it
    DIM pips = t{"TIER"} + t{"BT"}
    DIM pi_x = cx - (pips - 1) * 3.5
    DIM i
    FOR i = 0 TO pips - 1
        DIM pc = IIF(i < t{"TIER"}, [200, 200, 230], IIF(t{"BR"} = "A", [120, 255, 255], [255, 210, 90]))
        SEG(pi_x + i * 7, cy + 21, pi_x + i * 7 + 3, cy + 21, pc, 3)
    NEXT i
    IF t{"BR"} <> "" THEN POLY(cx, cy, 19, 6, 0, IIF(t{"BR"} = "A", [80, 200, 230], [230, 170, 60]), 1 + t{"BT"})
ENDSUB

SUB DRAWBEAMS(slot)
    DIM t = SIM.TOWER(slot)
    IF t{"S"}{"MODE"} <> "BEAM" THEN RETURN
    DIM n = LEN(t{"BX"})
    IF n = 0 THEN RETURN
    DIM cx = PXX(t{"X"})
    DIM cy = PXY(t{"Y"})
    DIM ex = t{"BX"} * TILE
    DIM ey = t{"BY"} * TILE + FY0
    DIM sx = ex * 0 + cx
    DIM sy = ey * 0 + cy
    DIM c = TCOL("LASER")
    DIM rf = 1.0
    IF MAP.EXISTS(t, "RAMPF") THEN rf = t{"RAMPF"}
    DIM w = 2 + 3 * rf + SIN(tnow * 40) * 0.8
    GFX.LINES WEAVE(sx, ex), WEAVE(sy, ey), w + 3, INT(c[0] * 0.35), INT(c[1] * 0.35), INT(c[2] * 0.35), TRUE
    GFX.LINES WEAVE(sx, ex), WEAVE(sy, ey), 1.5, 210, 255, 255, TRUE
    POLYBATCH(ex, ey, 5 + 2 * rf, 6, tnow * 4, [140, 250, 255], 2)
ENDSUB

SUB DRAWAURAS()
    DIM i
    FOR i = 0 TO SIM.NSLOTS() - 1
        DIM t = SIM.TOWER(i)
        IF t{"KIND"} = "CRYO" THEN
            DIM r = t{"S"}{"RANGE"} * t{"RBUFF"} * TILE
            DIM ph = (tnow * 0.5 + i * 0.37) - INT(tnow * 0.5 + i * 0.37)
            POLY(PXX(t{"X"}), PXY(t{"Y"}), r, 32, 0, [30, 60, 90], 1.5)
            POLY(PXX(t{"X"}), PXY(t{"Y"}), r * ph, 24, 0, SHADE([110, 190, 255], 0.5 * (1 - ph)), 2)
        ELSEIF t{"KIND"} = "RELAY" THEN
            DIM j
            FOR j = 0 TO SIM.NSLOTS() - 1
                DIM o = SIM.TOWER(j)
                IF j <> i ANDALSO o{"KIND"} <> "" ANDALSO o{"KIND"} <> "RELAY" THEN
                    IF SQR((o{"X"} - t{"X"}) ^ 2 + (o{"Y"} - t{"Y"}) ^ 2) <= t{"S"}{"RANGE"} + 0.01 THEN
                        SEG(PXX(t{"X"}), PXY(t{"Y"}), PXX(o{"X"}), PXY(o{"Y"}), [70, 60, 20], 1.5)
                    ENDIF
                ENDIF
            NEXT j
        ENDIF
    NEXT i
ENDSUB

SUB DRAWENEMIES()
    DIM en = SIM.ENEMIES()
    DIM n = LEN(en{"X"})
    IF n = 0 THEN RETURN
    DIM px = en{"X"} * TILE
    DIM py = en{"Y"} * TILE + FY0
    DIM kinds = en{"K"}
    DIM vis = en{"VIS"}
    DIM k
    FOR k = 0 TO LEN(ek_sides) - 1
        DIM m = kinds = k
        IF SUM(m) > 0 THEN
            DIM c = ek_col[k]
            DIM rot = tnow * ek_spin[k]
            DIM mv = m * vis
            IF SUM(mv) > 0 THEN
                DIM idx = WHICH(mv)
                POLYBATCH(px[idx], py[idx], ek_size[k], ek_sides[k], rot, c, 2.5)
                POLYBATCH(px[idx], py[idx], ek_size[k] * 0.45, ek_sides[k], 0 - rot * 1.7, [255, 245, 250], 1.5)
                IF ek_mirror[k] = 1 THEN POLYBATCH(px[idx], py[idx], ek_size[k] + 4, ek_sides[k], 0.785 - rot, [150, 170, 210], 1.2)
            ENDIF
            ' cloaked and out of every revealer's reach: a faint shimmer
            DIM mh = m * (1 - vis)
            IF SUM(mh) > 0 THEN
                DIM hid = WHICH(mh)
                POLYBATCH(px[hid], py[hid], ek_size[k] * (0.9 + 0.1 * SIN(tnow * 5)), ek_sides[k], rot, SHADE(c, 0.22), 1.5)
            ENDIF
        ENDIF
    NEXT k
    DIM sizes = ek_size[kinds]
    DIM shm = en{"SHF"} > 0.02
    IF SUM(shm) > 0 THEN
        DIM si = WHICH(shm)
        POLYBATCH(px[si], py[si], sizes[si] + 5, 10, tnow, [90, 140, 255], 1.5)
    ENDIF
    DIM stm = en{"STUN"}
    IF SUM(stm) > 0 THEN
        DIM sti = WHICH(stm)
        POLYBATCH(px[sti], py[sti] - sizes[sti] - 5, 3, 4, tnow * 6, [255, 255, 255], 1.5)
    ENDIF
    DIM slm = en{"SLOW"} > 0.01
    IF SUM(slm) > 0 THEN
        DIM sli = WHICH(slm)
        POLYBATCH(px[sli], py[sli], sizes[sli] + 2, 6, 0, [80, 150, 220], 1)
    ENDIF
    DIM bum = en{"BURN"}
    IF SUM(bum) > 0 THEN
        DIM bi = WHICH(bum)
        POLYBATCH(px[bi], py[bi] - 2, sizes[bi] * 0.7, 3, 0 - 1.5708, [255, 110, 30], 2)
    ENDIF
    DIM hm = en{"HPF"} < 0.995
    IF SUM(hm) > 0 THEN
        DIM hi = WHICH(hm)
        DIM bx0 = px[hi] - 11
        DIM by0 = py[hi] - sizes[hi] - 7
        DIM bw = en{"HPF"}[hi] * 22
        GFX.LINES WEAVE(bx0, bx0 + 22), WEAVE(by0, by0), 3, 50, 20, 30, TRUE
        GFX.LINES WEAVE(bx0, bx0 + bw), WEAVE(by0, by0), 3, 90, 255, 120, TRUE
    ENDIF
ENDSUB

SUB DRAWSHOTS()
    DIM sh = SIM.SHOTS()
    DIM n = LEN(sh{"X"})
    IF n = 0 THEN RETURN
    DIM i
    FOR i = 0 TO n - 1
        DIM x = PXX(sh{"X"}[i])
        DIM y = PXY(sh{"Y"}[i])
        DIM dx = PXX(sh{"TX"}[i]) - x
        DIM dy = PXY(sh{"TY"}[i]) - y
        DIM dl = SQR(dx * dx + dy * dy) + 0.001
        DIM c = TCOL(sh{"K"}[i])
        IF sh{"SPL"}[i] > 0 THEN
            POLY(x, y, 5, 6, tnow * 8, c, 2.5)
        ELSE
            SEG(x - dx / dl * 9, y - dy / dl * 9, x, y, c, 3)
        ENDIF
    NEXT i
ENDSUB

' ── ring menu ───────────────────────────────────────────────────

DIM ring_items = []

FUNC RINGOPTS(slot)
    DIM out = []
    DIM t = SIM.TOWER(slot)
    IF t{"KIND"} = "" THEN
        FOR EACH k$ IN cur_lv{"TOWERS"}
            out = APPEND(out, [["B:" + k$, SIM.COST(k$), k$]])
        NEXT k$
    ELSE
        FOR EACH o IN SIM.UPOPTS(slot)
            out = APPEND(out, [["U:" + o[0], o[1], t{"KIND"}]])
        NEXT o
        out = APPEND(out, [["SELL", 0 - SIM.SELLVALUE(slot), t{"KIND"}]])
    ENDIF
    RETURN out
ENDFUNC

SUB OPENRING(slot)
    sel_slot = slot
    pending$ = ""
    DIM s = SIM.SLOTPOS(slot)
    ring_cx = PXX(s[0] + 0.5)
    ring_cy = PXY(s[1] + 0.5)
    SFX("TAP")
ENDSUB

SUB DRAWRING()
    IF sel_slot < 0 THEN RETURN
    DIM t = SIM.TOWER(sel_slot)
    DIM opts = RINGOPTS(sel_slot)
    DIM n = LEN(opts)
    IF t{"KIND"} <> "" THEN
        DIM r = t{"S"}{"RANGE"} * t{"RBUFF"} * TILE
        POLY(ring_cx, ring_cy, r, 48, 0, SHADE(TCOL(t{"KIND"}), 0.5), 2)
    ENDIF
    DIM ring_r = 64
    IF n > 6 THEN ring_r = 74
    ' keep the whole ring on screen
    DIM ccx = ring_cx
    DIM ccy = ring_cy
    IF ccx < ring_r + 26 THEN ccx = ring_r + 26
    IF ccx > SCR_W - ring_r - 26 THEN ccx = SCR_W - ring_r - 26
    IF ccy < FY0 + ring_r + 26 THEN ccy = FY0 + ring_r + 26
    IF ccy > BAR_Y - ring_r - 26 THEN ccy = BAR_Y - ring_r - 26
    POLY(ring_cx, ring_cy, 19, 6, 0, [255, 255, 255], 2)
    DIM i
    FOR i = 0 TO n - 1
        DIM ang = -1.5708 + i * TWO_PI / n
        IF t{"KIND"} <> "" THEN
            ang = -1.5708 + (i - (n - 1) / 2) * 0.95
            IF opts[i][0] = "SELL" THEN ang = 1.5708
        ENDIF
        DIM ix = ccx + ring_r * COS(ang)
        DIM iy = ccy + ring_r * SIN(ang)
        DIM code$ = opts[i][0]
        DIM cost = opts[i][1]
        DIM afford = IIF(cost <= SIM.CREDITS(), 1, 0)
        DIM c = TCOL(opts[i][2])
        IF code$ = "SELL" THEN c = [255, 210, 90]
        IF afford = 0 THEN c = SHADE(c, 0.35)
        GFX.BLEND "BLEND"
        DRAWCOLOR 4, 4, 14, 230
        CIRCLE ix, iy, 22, TRUE
        GFX.BLEND "ADD"
        DIM sel = IIF(pending$ = code$, 1, 0)
        POLY(ix, iy, 22, 24, 0, c, 2 + sel * 2)
        IF sel = 1 THEN POLY(ix, iy, 27 + 2 * SIN(tnow * 8), 24, 0, SHADE(c, 0.6), 2)
        IF LEFT$(code$, 2) = "B:" THEN
            ICON(opts[i][2], ix, iy - 3, c)
            CTEXT(ix, iy + 7, STR$(cost), IIF(afford = 1, [255, 230, 120], [140, 120, 90]), 12)
        ELSEIF code$ = "SELL" THEN
            CTEXT(ix, iy - 14, "$", [255, 230, 120], 16)
            CTEXT(ix, iy + 2, "+" + STR$(0 - cost), [255, 230, 120], 12)
        ELSE
            DIM lab$ = MID$(code$, 2, 1)
            IF lab$ = "U" THEN lab$ = "^"
            CTEXT(ix, iy - 15, lab$, [235, 240, 255], 18)
            CTEXT(ix, iy + 3, STR$(cost), IIF(afford = 1, [255, 230, 120], [140, 120, 90]), 12)
        ENDIF
        HIT(ix - 24, iy - 24, 48, 48, "R:" + code$)
    NEXT i
ENDSUB

SUB ICON(k$, cx, cy, c)
    IF k$ = "LASER" THEN
        POLY(cx, cy, 8, 4, 0, c, 2)
    ELSEIF k$ = "BLASTER" THEN
        POLY(cx, cy, 7, 8, 0, c, 2)
        SEG(cx, cy, cx + 10, cy - 6, c, 2)
    ELSEIF k$ = "CRYO" THEN
        POLY(cx, cy, 8, 6, 0, c, 2)
    ELSEIF k$ = "BOMB" THEN
        POLY(cx, cy, 8, 4, 0.785, c, 2)
    ELSEIF k$ = "TESLA" THEN
        POLY(cx, cy, 9, 3, -1.5708, c, 2)
    ELSEIF k$ = "PULSE" THEN
        POLY(cx, cy, 8, 8, 0, c, 2)
        POLY(cx, cy, 3, 8, 0, c, 1.5)
    ELSEIF k$ = "PLASMA" THEN
        POLY(cx, cy, 8, 5, -1.5708, c, 2)
    ELSEIF k$ = "VORTEX" THEN
        DIM va = IOTA(17, 0) * 0.5
        DIM vr = 9 - IOTA(17, 0) * 0.5
        GFX.LINES cx + vr * COS(va), cy + vr * SIN(va), 2, c[0], c[1], c[2]
    ELSE
        DIM st = IOTA(11, 0) * TWO_PI / 10 - 1.5708
        DIM sr = 4 + 5 * ((IOTA(11, 0) MOD 2) = 0)
        GFX.LINES cx + sr * COS(st), cy + sr * SIN(st), 2, c[0], c[1], c[2]
    ENDIF
ENDSUB

' What the selected choice does, in the panel at the bottom of the field
FUNC STATLINE$(s)
    DIM m$ = s{"MODE"}
    DIM r$ = T$("range") + " " + STR$(s{"RANGE"})
    IF m$ = "BEAM" THEN RETURN T$("dmg") + " " + STR$(s{"DMG"}) + "/s x" + STR$(s{"BEAMS"}) + "   " + r$
    IF m$ = "BOLT" THEN RETURN T$("dmg") + " " + STR$(s{"DMG"}) + " x" + STR$(s{"BARRELS"}) + "   " + STR$(s{"RATE"}) + "/s   " + r$
    IF m$ = "RAIL" THEN RETURN T$("dmg") + " " + STR$(s{"DMG"}) + "   " + STR$(s{"RATE"}) + "/s   " + r$
    IF m$ = "SHELL" THEN RETURN T$("dmg") + " " + STR$(s{"DMG"}) + "   " + STR$(s{"RATE"}) + "/s   " + r$
    IF m$ = "ZAP" THEN RETURN T$("dmg") + " " + STR$(s{"DMG"}) + "  x" + STR$(s{"CHAIN"}) + "   " + r$
    IF m$ = "AURA" THEN RETURN "-" + STR$(INT(s{"SLOW"} * 100)) + "%   " + r$
    IF m$ = "PULSE" THEN RETURN T$("dmg") + " " + STR$(s{"DMG"}) + "   " + STR$(s{"STUN"}) + "s   " + r$
    IF m$ = "FLAME" THEN RETURN STR$(s{"BURN"}) + "/s   " + r$
    IF m$ = "PULL" THEN
        DIM pull$ = "<< " + STR$(s{"PULL"}) + "   " + T$("dmg") + " " + STR$(s{"DMG"})
        IF s{"PCT"} > 0 THEN pull$ = pull$ + " +" + STR$(INT(s{"PCT"} * 100)) + "%"
        RETURN pull$ + "   " + r$
    ENDIF
    IF m$ = "RELAY" THEN
        IF s{"INCOME"} > 0 THEN RETURN "+" + STR$(s{"INCOME"}) + " / " + T$("wave")
        RETURN "+" + STR$(INT(s{"BUFFD"} * 100)) + "% " + T$("dmg") + "   +" + STR$(INT(s{"BUFFR"} * 100)) + "% " + T$("range")
    ENDIF
    RETURN r$
ENDFUNC

SUB DRAWINFO()
    IF sel_slot < 0 THEN RETURN
    DIM t = SIM.TOWER(sel_slot)
    DIM title$ = ""
    DIM desc$ = ""
    DIM stat$ = ""
    DIM c = [200, 200, 255]
    DIM code$ = pending$
    IF t{"KIND"} = "" ANDALSO code$ = "" THEN RETURN
    IF LEFT$(code$, 2) = "B:" THEN
        DIM k$ = MID$(code$, 2, 40)
        c = TCOL(k$)
        title$ = T$(k$) + "   " + STR$(SIM.COST(k$))
        desc$ = T$(k$ + "_d")
        stat$ = STATLINE$(SIM.STATS(k$, 1, "", 0))
    ELSE
        DIM kk$ = t{"KIND"}
        c = TCOL(kk$)
        DIM name$ = T$(kk$)
        IF t{"BR"} <> "" THEN name$ = T$(kk$ + "_" + t{"BR"})
        title$ = name$ + "   " + T$("tier") + " " + STR$(t{"TIER"} + t{"BT"})
        desc$ = IIF(t{"BR"} <> "", T$(kk$ + "_" + t{"BR"} + "d"), T$(kk$ + "_d"))
        stat$ = STATLINE$(t{"S"})
        IF code$ = "U:UP" THEN
            DIM nt = t{"TIER"}
            DIM nb = t{"BT"}
            IF t{"BR"} = "" THEN
                nt = nt + 1
            ELSE
                nb = nb + 1
            ENDIF
            stat$ = "> " + STATLINE$(SIM.STATS(kk$, nt, t{"BR"}, nb))
            desc$ = T$("upgrade")
        ELSEIF code$ = "U:A" ORELSE code$ = "U:B" THEN
            DIM br$ = RIGHT$(code$, 1)
            title$ = T$(kk$ + "_" + br$) + "   (" + br$ + ")"
            desc$ = T$(kk$ + "_" + br$ + "d")
            stat$ = "> " + STATLINE$(SIM.STATS(kk$, 3, br$, 1))
        ELSEIF code$ = "SELL" THEN
            desc$ = T$("sell") + "  +" + STR$(SIM.SELLVALUE(sel_slot))
        ELSEIF LEN(SIM.UPOPTS(sel_slot)) = 0 THEN
            desc$ = T$("maxed")
        ENDIF
    ENDIF
    DIM py = BAR_Y - 92
    IF ring_cy > FY0 + 420 THEN py = FY0 + 6
    PANEL(8, py, SCR_W - 16, 84, c, 225)
    QTEXT(22, py + 8, title$, [240, 245, 255], 18)
    QTEXT(22, py + 34, desc$, SHADE(c, 0.9), 14)
    QTEXT(22, py + 56, stat$, [190, 200, 230], 14)
    IF code$ <> "" THEN QTEXT(SCR_W - 22 - TEXTW(T$("tap_again"), 12), py + 10, T$("tap_again"), [150, 150, 190], 12)
ENDSUB

' ── HUD and bars ────────────────────────────────────────────────

SUB DRAWHUD()
    PANEL(4, 4, SCR_W - 8, FY0 - 10, THEMECOL([120, 80, 255], [255, 190, 80]), 210)
    POLY(26, 30, 9, 4, 0, [255, 220, 90], 2.5)
    QTEXT(42, 18, STR$(SIM.CREDITS()), [255, 230, 130], 20)
    POLY(170, 30, 9, 6, tnow * 0.5, [80, 230, 255], 2.5)
    QTEXT(186, 18, STR$(SIM.LIVES()), IIF(flash > 0.1, [255, 120, 120], [180, 245, 255]), 20)
    DIM w$ = T$("wave") + " " + STR$(SIM.WAVE()) + "/" + STR$(SIM.NWAVES())
    IF SIM.ENDLESS() = 1 THEN w$ = T$("wave") + " " + STR$(SIM.WAVE())
    QTEXT(SCR_W - 20 - TEXTW(w$, 18), 12, w$, [235, 220, 255], 18)
    DIM l$ = STR$(cur_level) + "  " + cur_lv{"NAME"}
    IF play_kind$ <> "level" THEN l$ = cur_lv{"NAME"}
    IF play_kind$ = "endless" THEN l$ = T$("record") + " " + STR$(ENDLESSBEST(cur_arena))
    QTEXT(SCR_W - 20 - TEXTW(l$, 12), 36, l$, [150, 130, 200], 12)
    IF show_fps = 1 THEN QTEXT(240, 40, STR$(INT(fps_avg)) + " fps", [120, 255, 160], 12)
ENDSUB

' An endless run offers a bonus after every tenth wave
FUNC PERKOPEN()
    IF play_kind$ <> "endless" ORELSE SIM.PHASE$() <> "run" THEN RETURN 0
    IF SIM.BUSY() > 0 ORELSE SIM.WAVE() = 0 THEN RETURN 0
    IF SIM.WAVE() MOD 10 <> 0 THEN RETURN 0
    RETURN IIF(perks_taken < SIM.WAVE() / 10, 1, 0)
ENDFUNC

SUB DRAWBAR()
    DIM has_next = IIF(SIM.WAVE() < SIM.NWAVES() ANDALSO PERKOPEN() = 0, 1, 0)
    DIM c = IIF(has_next = 1, [255, 70, 190], [80, 70, 110])
    PANEL(8, BAR_Y + 6, 262, 70, c, 210)
    IF has_next = 1 THEN HIT(8, BAR_Y + 6, 262, 70, "next")
    POLY(34, BAR_Y + 41, 11, 3, 0, c, 3)
    DIM lab$ = T$("next_wave") + " " + STR$(SIM.WAVE() + 1) + "/" + STR$(SIM.NWAVES())
    IF SIM.ENDLESS() = 1 THEN lab$ = T$("next_wave") + " " + STR$(SIM.WAVE() + 1)
    IF SIM.WAVE() = 0 THEN lab$ = T$("start") + "  " + lab$
    IF SIM.WAVE() >= SIM.NWAVES() THEN lab$ = T$("wave") + " " + STR$(SIM.NWAVES()) + "/" + STR$(SIM.NWAVES())
    QTEXT(54, BAR_Y + 14, lab$, [245, 235, 255], 17)
    IF has_next = 1 THEN
        DIM pv = SIM.PREVIEW()
        DIM gap = IIF(LEN(pv) > 3, 40, 52)
        DIM px = 56
        FOR EACH g IN pv
            DIM kn = INDEXOF(enemies_json{"ORDER"}, g[0])
            POLY(px + 6, BAR_Y + 55, 6, ek_sides[kn], tnow, ek_col[kn], 1.5)
            QTEXT(px + 15, BAR_Y + 46, "x" + STR$(g[1]), [200, 190, 220], 12)
            px = px + gap
        NEXT g
        DIM eb = SIM.EARLYBONUS()
        IF eb > 0 ANDALSO LEN(pv) <= 3 THEN QTEXT(214, BAR_Y + 46, "+" + STR$(eb), [255, 220, 90], 12)
    ENDIF
    BUTTON(280, BAR_Y + 6, 90, 70, "x" + STR$(speed), [80, 220, 255], "speed", 22)
    BUTTON(380, BAR_Y + 6, 92, 70, "II", [190, 120, 255], "pause", 22)
ENDSUB

SUB DRAWSTARS(cx, cy, n_lit)
    DIM s
    FOR s = 0 TO 2
        DIM sc = IIF(s < n_lit, [255, 220, 80], [60, 55, 80])
        DIM sa = IOTA(11, 0) * TWO_PI / 10 - 1.5708
        DIM srr = 9 + 13 * ((IOTA(11, 0) MOD 2) = 0)
        GFX.LINES cx + (s - 1) * 62 + srr * COS(sa), cy + srr * SIN(sa), 3, sc[0], sc[1], sc[2]
    NEXT s
ENDSUB

SUB DRAWRESULT()
    DIM won = IIF(SIM.PHASE$() = "won", 1, 0)
    DIM c = IIF(won = 1, [90, 255, 180], [255, 70, 110])
    PANEL(50, 230, SCR_W - 100, 380, c, 235)
    CTEXT(SCR_W / 2, 256, IIF(won = 1, T$("won"), T$("lost")), c, 34)
    IF play_kind$ = "endless" THEN
        DIM done = MAX([0, SIM.WAVE() - 1])
        CTEXT(SCR_W / 2, 318, STR$(done), [235, 235, 255], 44)
        CTEXT(SCR_W / 2, 374, T$("waves_done"), [180, 170, 220], 16)
        CTEXT(SCR_W / 2, 404, T$("record") + "  " + STR$(ENDLESSBEST(cur_arena)), [160, 150, 200], 15)
        IF result_record = 1 THEN CTEXT(SCR_W / 2, 430, T$("new_record"), [255, 220, 90], 18)
        BUTTON(80, 470, SCR_W - 160, 56, T$("retry"), [255, 200, 90], "res:retry", 20)
        BUTTON(80, 536, SCR_W - 160, 56, T$("endless"), [150, 120, 255], "endlessmenu", 18)
        RETURN
    ENDIF
    IF won = 1 THEN DRAWSTARS(SCR_W / 2, 345, result_stars)
    CTEXT(SCR_W / 2, 390, T$("score") + "  " + STR$(result_score), [235, 235, 255], 20)
    IF play_kind$ = "daily" THEN
        DIM mine = 0
        IF MAP.EXISTS(daily, "MINE") THEN mine = daily{"MINE"}
        CTEXT(SCR_W / 2, 420, T$("daily_best") + "  " + STR$(mine), [160, 150, 200], 15)
        BUTTON(80, 470, SCR_W - 160, 56, T$("retry"), [255, 200, 90], "res:retry", 20)
        BUTTON(80, 536, SCR_W - 160, 56, T$("daily_title"), [120, 255, 170], "dailymenu", 18)
        RETURN
    ENDIF
    CTEXT(SCR_W / 2, 420, T$("best") + "  " + STR$(BESTOF(cur_level)), [160, 150, 200], 15)
    IF won = 1 THEN
        IF cur_level = 20 ORELSE cur_level = N_LEVELS THEN
            BUTTON(80, 470, SCR_W - 160, 56, T$("finale"), [255, 210, 90], "res:finale", 20)
        ELSE
            BUTTON(80, 470, SCR_W - 160, 56, T$("next_level"), [90, 255, 180], "res:next", 20)
        ENDIF
        BUTTON(80, 536, 150, 56, T$("retry"), [255, 200, 90], "res:retry", 18)
        BUTTON(250, 536, 150, 56, T$("levels"), [150, 120, 255], "res:levels", 18)
    ELSE
        BUTTON(80, 470, SCR_W - 160, 56, T$("retry"), [255, 200, 90], "res:retry", 22)
        BUTTON(80, 536, SCR_W - 160, 56, T$("levels"), [150, 120, 255], "res:levels", 18)
    ENDIF
ENDSUB

SUB DRAWPERKS()
    PANEL(60, 260, SCR_W - 120, 300, [150, 120, 255], 235)
    CTEXT(SCR_W / 2, 280, T$("perk_title"), [235, 220, 255], 26)
    BUTTON(90, 330, SCR_W - 180, 56, T$("perk_DMG"), [255, 90, 120], "perk:DMG", 19)
    BUTTON(90, 400, SCR_W - 180, 56, T$("perk_COST"), [255, 210, 90], "perk:COST", 19)
    BUTTON(90, 470, SCR_W - 180, 56, T$("perk_LIVES"), [90, 230, 255], "perk:LIVES", 19)
ENDSUB

SUB DRAWOVERLAY()
    IF flash > 0.02 THEN
        GFX.BLEND "ADD"
        DRAWCOLOR INT(90 * flash), 0, INT(20 * flash), 255
        RECT 0, FY0, SCR_W, BAR_Y - FY0, FALSE
        RECT 2, FY0 + 2, SCR_W - 4, BAR_Y - FY0 - 4, FALSE
    ENDIF
    IF toast$ <> "" ANDALSO tnow < toast_t THEN
        CTEXT(SCR_W / 2, FY0 + 14, toast$, [255, 230, 140], 18)
        IF toast2$ <> "" THEN CTEXT(SCR_W / 2, FY0 + 40, toast2$, [200, 200, 240], 14)
    ENDIF
    DIM ph$ = SIM.PHASE$()
    IF ph$ = "won" ORELSE ph$ = "lost" THEN
        DRAWRESULT()
    ELSEIF paused = 1 THEN
        PANEL(60, 210, SCR_W - 120, 430, [190, 120, 255], 235)
        CTEXT(SCR_W / 2, 232, T$("paused"), [235, 220, 255], 30)
        BUTTON(90, 290, SCR_W - 180, 52, T$("resume"), [90, 255, 180], "resume", 19)
        BUTTON(90, 352, SCR_W - 180, 52, T$("restart"), [255, 200, 90], "restart", 19)
        BUTTON(90, 414, SCR_W - 180, 52, T$("levels"), [150, 120, 255], "levels", 19)
        BUTTON(90, 488, 92, 48, T$("music"), IIF(mus_on = 1, [80, 220, 255], [70, 70, 90]), "music", 13)
        BUTTON(194, 488, 92, 48, T$("sfx"), IIF(sfx_on = 1, [80, 220, 255], [70, 70, 90]), "sfx", 13)
        BUTTON(298, 488, 92, 48, T$("glow"), IIF(glow_on = 1, [80, 220, 255], [70, 70, 90]), "glow", 13)
        IF WORLDSTARS(1) >= 60 THEN BUTTON(194, 550, 92, 48, T$("gold"), IIF(gold_on = 1, [255, 210, 90], [70, 70, 90]), "gold", 13)
    ELSEIF PERKOPEN() = 1 THEN
        DRAWPERKS()
    ENDIF
ENDSUB

SUB DRAWPLAY()
    DIM lv = cur_lv
    GFX.DRAWIMAGE bg_img, 0, FY0
    DRAWFLOW()
    DRAWGATES(lv)
    DRAWAURAS()
    DRAWSLOTS()
    DIM i
    FOR i = 0 TO SIM.NSLOTS() - 1
        IF SIM.TOWER(i){"KIND"} <> "" THEN DRAWTOWER(i)
    NEXT i
    DRAWENEMIES()
    FOR i = 0 TO SIM.NSLOTS() - 1
        IF SIM.TOWER(i){"KIND"} <> "" THEN DRAWBEAMS(i)
    NEXT i
    DRAWSHOTS()
    DRAWFX()
    DRAWHUD()
    DRAWBAR()
    IF paused = 0 ANDALSO SIM.PHASE$() <> "won" ANDALSO SIM.PHASE$() <> "lost" THEN
        DRAWRING()
        DRAWINFO()
    ENDIF
    DRAWOVERLAY()
ENDSUB

' ── menus ───────────────────────────────────────────────────────

' A synthwave floor running towards the horizon
SUB DRAWFLOOR(hy)
    DIM xs = []
    DIM ys = []
    DIM i
    FOR i = 0 TO 13
        DIM z = (i + (tnow * 0.6 - INT(tnow * 0.6))) / 14
        DIM y = hy + (SCR_H - hy) * z * z
        xs = APPEND(xs, [0, SCR_W])
        ys = APPEND(ys, [y, y])
    NEXT i
    FOR i = -8 TO 8
        xs = APPEND(xs, [SCR_W / 2 + i * 10, SCR_W / 2 + i * 120])
        ys = APPEND(ys, [hy, SCR_H])
    NEXT i
    DIM fc = THEMECOL([120, 30, 110], [150, 105, 25])
    GFX.LINES xs, ys, 1.5, fc[0], fc[1], fc[2], TRUE
ENDSUB

' A small crown; kind 2 burns pink for both worlds complete
SUB CROWN(cx, cy, kind, k)
    DIM c = IIF(kind = 2, [255, 110, 220], [255, 210, 80])
    DIM xs = [-1, -1, -0.5, 0, 0.5, 1, 1, -1] * 8 * k + cx
    DIM ys = [0.6, -0.5, 0.1, -0.8, 0.1, -0.5, 0.6, 0.6] * 8 * k + cy
    GFX.LINES xs, ys, 2, c[0], c[1], c[2]
ENDSUB

SUB TABBUTTON(x, y, w, h, label$, act$, active, sz)
    DIM c = IIF(active = 1, [120, 240, 255], [70, 70, 120])
    PANEL(x, y, w, h, c, IIF(active = 1, 220, 160))
    CTEXT(x + w / 2, y + h / 2 - sz * 0.62, label$, IIF(active = 1, [240, 250, 255], [150, 150, 190]), sz)
    HIT(x, y, w, h, act$)
ENDSUB

SUB DRAWMENU()
    DRAWFLOOR(796)
    CTEXT(SCR_W / 2, 18, "jdTOWER", THEMECOL([120, 240, 255], [255, 220, 120]), 46)
    CTEXT(SCR_W / 2, 72, T$("subtitle"), [255, 120, 210], 16)
    TABBUTTON(36, 100, 200, 42, T$("world1"), "world:1", IIF(world = 1, 1, 0), 17)
    TABBUTTON(244, 100, 200, 42, T$("world2"), "world:2", IIF(world = 2, 1, 0), 17)
    DIM base = 20 * (world - 1)
    DIM i
    FOR i = 1 TO 20
        DIM n = base + i
        DIM col = (i - 1) MOD 4
        DIM row = INT((i - 1) / 4)
        DIM x = 36 + col * 106
        DIM y = 156 + row * 92
        DIM is_open = UNLOCKED(n)
        DIM stars = STARSOF(n)
        DIM c = [70, 60, 100]
        IF is_open = 1 THEN c = IIF(n MOD 5 = 0, [255, 80, 150], IIF(world = 2, [255, 150, 70], [100, 200, 255]))
        IF stars = 3 THEN c = [255, 210, 90]
        PANEL(x, y, 90, 80, c, 190)
        CTEXT(x + 45, y + 8, STR$(n), IIF(is_open = 1, [240, 245, 255], [90, 85, 120]), 26)
        DIM s
        FOR s = 0 TO 2
            DIM sc = IIF(s < stars, [255, 220, 80], [55, 50, 80])
            POLY(x + 25 + s * 20, y + 60, 6, 5, -1.5708, sc, 2)
        NEXT s
        IF is_open = 1 THEN HIT(x, y, 90, 80, "lvl:" + STR$(n))
    NEXT i
    IF world = 2 ANDALSO UNLOCKED(21) = 0 THEN
        PANEL(60, 330, SCR_W - 120, 70, [255, 150, 70], 235)
        CTEXT(SCR_W / 2, 354, T$("w2_locked"), [255, 220, 180], 16)
    ENDIF
    DIM w_stars = WORLDSTARS(world)
    CTEXT(SCR_W / 2, 618, STR$(w_stars) + " / 60  " + T$("fin_stars"), [255, 220, 120], 15)
    BUTTON(36, 646, 200, 52, T$("endless"), IIF(STARSOF(20) > 0, [150, 120, 255], [70, 60, 100]), "endlessmenu", 18)
    BUTTON(244, 646, 200, 52, T$("daily"), [120, 255, 170], "dailymenu", 18)
    IF online = 1 THEN
        BUTTON(36, 708, 200, 52, T$("board"), [255, 120, 210], "board", 18)
    ELSE
        BUTTON(36, 708, 200, 52, T$("board"), [70, 60, 100], "", 18)
    ENDIF
    BUTTON(244, 708, 200, 52, T$("ach") + "  " + STR$(LEN(ach)), [255, 210, 90], "ach", 18)
    DIM who$ = myname$
    IF auth$ = "" THEN who$ = T$("guest")
    DIM crown_kind = 0
    IF WORLDSTARS(1) >= 60 THEN crown_kind = 1
    IF WORLDSTARS(1) >= 60 ANDALSO WORLDSTARS(2) >= 60 THEN crown_kind = 2
    DIM ww = TEXTW(who$, 13)
    CTEXT(SCR_W / 2, 774, who$, [170, 160, 210], 13)
    IF crown_kind > 0 THEN CROWN(SCR_W / 2 - ww / 2 - 14, 782, crown_kind, 1)
    IF net_msg$ <> "" THEN CTEXT(SCR_W / 2, 800, net_msg$, [255, 130, 130], 13)
ENDSUB

FUNC GAPTEXT$()
    IF NOT MAP.EXISTS(board, "ME") THEN RETURN ""
    IF board{"ME"} = 0 THEN RETURN ""
    IF board{"ME"} = 1 THEN RETURN T$("lead")
    DIM key$ = "gap_P"
    IF board_tab$ = "W1" ORELSE board_tab$ = "W2" THEN key$ = "gap_W"
    IF board_tab$ = "END" THEN key$ = "gap_END"
    DIM n = board{"GAP"}
    IF n = 0 THEN n = 1
    RETURN TF$(key$, STR$(n), STR$(board{"ME"} - 1))
ENDFUNC

SUB BOARDROW(r, y)
    DIM mine = IIF(r{"NAME"} = myname$, 1, 0)
    DIM c = IIF(mine = 1, [120, 255, 200], [225, 225, 245])
    IF mine = 1 THEN
        GFX.BLEND "ADD"
        DRAWCOLOR 10, 34, 30, 255
        RECT 28, y - 3, SCR_W - 56, 26, TRUE
    ENDIF
    QTEXT(36, y, STR$(r{"RANK"}), c, 15)
    IF r{"CROWN"} > 0 THEN CROWN(76, y + 11, r{"CROWN"}, 0.9)
    QTEXT(88, y, LEFT$(r{"NAME"}, 13), c, 15)
    DIM vc = IIF(board_tab$ = "W1" ORELSE board_tab$ = "W2", [255, 220, 90], c)
    QTEXT(286, y, STR$(r{"VAL"}), vc, 15)
    IF board_tab$ <> "DAY" THEN QTEXT(350, y, STR$(r{"SUB"}), [170, 170, 210], 13)
    IF r{"BADGES"} > 0 THEN
        POLY(424, y + 10, 6, 5, -1.5708, [255, 210, 90], 1.5)
        QTEXT(434, y + 2, STR$(r{"BADGES"}), [220, 200, 140], 12)
    ENDIF
ENDSUB

SUB DRAWBOARD()
    DRAWFLOOR(720)
    CTEXT(SCR_W / 2, 20, T$("board"), [255, 120, 210], 32)
    DIM tabs = ["W1", "W2", "END", "WEEK", "DAY"]
    DIM i
    FOR i = 0 TO 4
        TABBUTTON(20 + i * 89, 72, 84, 40, T$("tab_" + tabs[i]), "btab:" + tabs[i], IIF(board_tab$ = tabs[i], 1, 0), 13)
    NEXT i
    PANEL(20, 124, SCR_W - 40, 520, [120, 80, 255], 220)
    DIM h1$ = T$("stars")
    DIM h2$ = T$("score")
    IF board_tab$ = "END" THEN
        h1$ = T$("col_wave")
    ELSEIF board_tab$ = "WEEK" THEN
        h1$ = T$("score")
        h2$ = T$("col_levels")
    ELSEIF board_tab$ = "DAY" THEN
        h1$ = T$("score")
        h2$ = ""
    ENDIF
    QTEXT(36, 136, "#", [150, 140, 200], 13)
    QTEXT(88, 136, "Name", [150, 140, 200], 13)
    QTEXT(286, 136, h1$, [150, 140, 200], 13)
    QTEXT(350, 136, h2$, [150, 140, 200], 13)
    DIM top = []
    IF MAP.EXISTS(board, "TOP") THEN top = board{"TOP"}
    IF LEN(top) = 0 THEN
        CTEXT(SCR_W / 2, 300, T$("nobody"), [180, 170, 220], 16)
    ENDIF
    DIM me = 0
    IF MAP.EXISTS(board, "ME") THEN me = board{"ME"}
    DIM n_top = LEN(top)
    IF me > 12 THEN n_top = MIN([10, n_top])
    FOR i = 0 TO n_top - 1
        BOARDROW(top[i], 166 + i * 28)
    NEXT i
    IF me > 12 THEN
        CTEXT(SCR_W / 2, 446, ". . .", [150, 140, 200], 16)
        DIM j = 0
        FOR EACH r IN board{"AROUND"}
            BOARDROW(r, 474 + j * 28)
            j = j + 1
        NEXT r
    ENDIF
    DIM gap$ = GAPTEXT$()
    IF gap$ <> "" THEN CTEXT(SCR_W / 2, 612, gap$, [255, 220, 120], 15)
    BUTTON(140, 680, SCR_W - 280, 56, T$("back"), [100, 200, 255], "back", 19)
ENDSUB

SUB DRAWACH()
    DRAWFLOOR(760)
    CTEXT(SCR_W / 2, 20, T$("ach"), [255, 210, 90], 32)
    CTEXT(SCR_W / 2, 62, STR$(LEN(ach)) + " / " + STR$(LEN(ach_defs)), [200, 190, 230], 15)
    DIM i = 0
    FOR EACH d IN ach_defs
        DIM x = 20 + (i MOD 5) * 89
        DIM y = 92 + INT(i / 5) * 72
        DIM have = HASACH(d{"ID"})
        DIM c = ACHCOLOR(d)
        DIM cc = IIF(have = 1, c, SHADE(c, 0.3))
        PANEL(x, y, 84, 66, IIF(ach_pick = i, [255, 255, 255], cc), IIF(have = 1, 210, 150))
        DIM sides = 6
        IF MAP.EXISTS(d, "SIDES") THEN sides = d{"SIDES"}
        IF MAP.EXISTS(d, "TOWER") THEN
            ICON(d{"TOWER"}, x + 42, y + 22, cc)
        ELSE
            POLY(x + 42, y + 22, 13, sides, -1.5708, cc, IIF(have = 1, 2.5, 1.5))
            IF have = 1 THEN POLY(x + 42, y + 22, 5, sides, 1.5708 + tnow, [255, 255, 255], 1.5)
        ENDIF
        DIM nm$ = ACHNAME$(d)
        IF LEFT$(d{"ID"}, 4) = "max_" THEN nm$ = T$(d{"TOWER"})
        CTEXT(x + 42, y + 40, LEFT$(nm$, 12), IIF(have = 1, [235, 240, 255], [120, 115, 150]), 10)
        IF have = 0 THEN
            DIM f = ACHFRAC(d)
            IF f > 0 THEN
                SEG(x + 10, y + 59, x + 74, y + 59, [40, 35, 60], 3)
                SEG(x + 10, y + 59, x + 10 + 64 * f, y + 59, c, 3)
            ENDIF
        ENDIF
        HIT(x, y, 84, 66, "achpick:" + STR$(i))
        i = i + 1
    NEXT d
    IF ach_pick >= 0 THEN
        DIM pd = ach_defs[ach_pick]
        PANEL(20, 672, SCR_W - 40, 76, ACHCOLOR(pd), 230)
        QTEXT(36, 682, ACHNAME$(pd), [240, 245, 255], 17)
        QTEXT(36, 708, ACHDESC$(pd), [200, 200, 235], 13)
        IF HASACH(pd{"ID"}) = 0 ANDALSO LEN(pd{"STATS"}) = 1 ANDALSO pd{"GOAL"} > 1 THEN
            DIM prog$ = STR$(MIN([STAT(pd{"STATS"}[0]), pd{"GOAL"}])) + " / " + STR$(pd{"GOAL"})
            QTEXT(SCR_W - 36 - TEXTW(prog$, 13), 684, prog$, [255, 220, 120], 13)
        ENDIF
    ENDIF
    BUTTON(140, 772, SCR_W - 280, 56, T$("back"), [100, 200, 255], "back", 19)
ENDSUB

SUB DRAWENDLESSMENU()
    DRAWFLOOR(740)
    CTEXT(SCR_W / 2, 20, T$("endless"), [150, 120, 255], 36)
    IF STARSOF(20) = 0 THEN
        PANEL(60, 300, SCR_W - 120, 80, [150, 120, 255], 230)
        CTEXT(SCR_W / 2, 328, T$("endless_locked"), [220, 210, 255], 16)
    ELSE
        CTEXT(SCR_W / 2, 74, T$("endless_pick"), [200, 190, 230], 16)
        DIM arena_cols = [[90, 230, 255], [255, 90, 190], [255, 200, 90]]
        DIM a
        FOR a = 1 TO LEN(ARENAS)
            DIM lv = LEVELDATA(ARENAS[a - 1])
            DIM y = 120 + (a - 1) * 170
            DIM c = arena_cols[a - 1]
            PANEL(40, y, SCR_W - 80, 150, c, 210)
            CTEXT(SCR_W / 2, y + 18, T$("arena_" + STR$(a)), [240, 245, 255], 22)
            CTEXT(SCR_W / 2, y + 52, lv{"NAME"}, [190, 190, 230], 14)
            CTEXT(SCR_W / 2, y + 86, T$("record") + ": " + T$("wave") + " " + STR$(ENDLESSBEST(a)), [255, 220, 120], 18)
            HIT(40, y, SCR_W - 80, 150, "arena:" + STR$(a))
        NEXT a
    ENDIF
    BUTTON(140, 680, SCR_W - 280, 56, T$("back"), [100, 200, 255], "back", 19)
ENDSUB

SUB DRAWDAILYMENU()
    DRAWFLOOR(740)
    CTEXT(SCR_W / 2, 20, T$("daily_title"), [120, 255, 170], 34)
    IF NOT MAP.EXISTS(daily, "LEVEL") THEN
        CTEXT(SCR_W / 2, 300, T$("offline"), [255, 130, 130], 16)
    ELSE
        DIM lv = LEVELDATA(daily{"LEVEL"})
        PANEL(40, 90, SCR_W - 80, 200, [120, 255, 170], 215)
        CTEXT(SCR_W / 2, 104, daily{"DATE"}, [180, 220, 200], 14)
        CTEXT(SCR_W / 2, 130, T$("level") + " " + STR$(daily{"LEVEL"}) + "  " + lv{"NAME"}, [240, 245, 255], 20)
        CTEXT(SCR_W / 2, 172, DAILYRULE$(), [255, 220, 120], 18)
        DIM mine = 0
        IF MAP.EXISTS(daily, "MINE") THEN mine = daily{"MINE"}
        CTEXT(SCR_W / 2, 214, T$("daily_best") + ": " + STR$(mine), [200, 200, 235], 15)
        IF auth$ = "" THEN CTEXT(SCR_W / 2, 244, T$("daily_login"), [255, 160, 160], 12)
        BUTTON(120, 306, SCR_W - 240, 60, T$("daily_go"), [120, 255, 170], "dailygo", 24)
        PANEL(40, 386, SCR_W - 80, 250, [120, 80, 255], 210)
        QTEXT(60, 396, T$("tab_DAY"), [150, 140, 200], 13)
        DIM i = 0
        FOR EACH r IN daily_top
            IF i >= 7 THEN EXITFOR
            DIM c = IIF(r{"NAME"} = myname$, [120, 255, 200], [225, 225, 245])
            QTEXT(60, 422 + i * 28, STR$(r{"RANK"}) + "   " + LEFT$(r{"NAME"}, 14), c, 15)
            QTEXT(340, 422 + i * 28, STR$(r{"VAL"}), c, 15)
            i = i + 1
        NEXT r
        IF LEN(daily_top) = 0 THEN CTEXT(SCR_W / 2, 480, T$("nobody"), [180, 170, 220], 14)
    ENDIF
    BUTTON(140, 680, SCR_W - 280, 56, T$("back"), [100, 200, 255], "back", 19)
ENDSUB

SUB OPENFINALE(w)
    finale_world = w
    uimode$ = "finale"
    fx = []
    SETSONG(FINALE_SONG)
    MUSICMIX("play")
ENDSUB

SUB DRAWFINALE()
    DRAWFLOOR(700)
    IF frame MOD 7 = 0 THEN
        DIM cols = [[255, 90, 190], [90, 230, 255], [255, 210, 90], [150, 255, 140], [190, 140, 255]]
        DIM fc = cols[INT(RND() * 5)]
        DIM fxx = 60 + RND() * (SCR_W - 120)
        DIM fyy = IIF(RND() < 0.4, 70 + RND() * 90, 470 + RND() * 190)
        ADDFX({ "F": "RING", "X": fxx, "Y": fyy, "R0": 4, "R1": 50 + RND() * 40, "C": fc, "DUR": 0.9, "W": 3 })
        ADDFX({ "F": "BURST", "X": fxx, "Y": fyy, "C": fc, "R": 70, "N": 12, "DUR": 1.0 })
    ENDIF
    DRAWFX()
    DIM gold = [255, 215, 90]
    CROWN(SCR_W / 2, 150, finale_world, 4 + 0.3 * SIN(tnow * 3))
    CTEXT(SCR_W / 2, 200, T$("fin_w" + STR$(finale_world) + "_t"), IIF(finale_world = 2, [255, 120, 220], gold), 44)
    CTEXT(SCR_W / 2, 262, T$("fin_w" + STR$(finale_world)), [235, 240, 255], 22)
    DIM who$ = myname$
    IF auth$ = "" THEN who$ = T$("guest")
    CTEXT(SCR_W / 2, 306, who$, [170, 230, 255], 20)
    CTEXT(SCR_W / 2, 350, STR$(WORLDSTARS(finale_world)) + " / 60  " + T$("fin_stars"), gold, 22)
    IF finale_world = 1 THEN
        CTEXT(SCR_W / 2, 410, T$("fin_unlock"), [200, 255, 210], 16)
    ELSE
        CTEXT(SCR_W / 2, 410, T$("fin_unlock2"), [200, 255, 210], 16)
    ENDIF
    IF WORLDSTARS(finale_world) >= 60 ANDALSO finale_world = 1 THEN CTEXT(SCR_W / 2, 440, T$("fin_gold"), gold, 16)
    BUTTON(120, 690, SCR_W - 240, 60, T$("continue"), [120, 240, 255], "fin:done", 22)
ENDSUB

' The newest badge slides over whatever is on screen
DIM banner_t0 = 0.0
SUB DRAWBANNER()
    IF LEN(ach_queue) = 0 THEN RETURN
    IF banner_t0 = 0 THEN
        banner_t0 = tnow
        SFX("ACH")
    ENDIF
    DIM age = tnow - banner_t0
    IF age > 2.8 THEN
        ach_queue = DROP(1, ach_queue)
        banner_t0 = 0.0
        RETURN
    ENDIF
    DIM d = ach_queue[0]
    DIM c = ACHCOLOR(d)
    DIM y = 70 + IIF(age < 0.25, (age - 0.25) * 240, 0)
    PANEL(40, y, SCR_W - 80, 60, c, 240)
    DIM sides = 6
    IF MAP.EXISTS(d, "SIDES") THEN sides = d{"SIDES"}
    POLY(72, y + 30, 16, sides, -1.5708 + tnow, c, 3)
    POLY(72, y + 30, 22 + 3 * SIN(tnow * 9), 24, 0, SHADE(c, 0.5), 2)
    QTEXT(104, y + 8, T$("ach_new"), c, 15)
    QTEXT(104, y + 28, ACHNAME$(d), [245, 245, 255], 19)
ENDSUB

' ── input ───────────────────────────────────────────────────────

SUB TOMENU()
    uimode$ = "menu"
    paused = 0
    IF ach_dirty = 1 THEN SAVEPROFILE()
    SETSONG(MENU_SONG)
    MUSICMIX("menu")
ENDSUB

SUB DOACTION(act$)
    IF act$ = "" THEN RETURN
    IF LEFT$(act$, 4) = "lvl:" THEN
        SFX("TAP")
        STARTLEVEL(VAL(MID$(act$, 4, 4)))
    ELSEIF LEFT$(act$, 6) = "world:" THEN
        SFX("TAP")
        world = VAL(MID$(act$, 6, 2))
    ELSEIF act$ = "board" THEN
        SFX("TAP")
        LOADBOARD(board_tab$)
        uimode$ = "board"
    ELSEIF LEFT$(act$, 5) = "btab:" THEN
        SFX("TAP")
        LOADBOARD(MID$(act$, 5, 8))
    ELSEIF act$ = "ach" THEN
        SFX("TAP")
        ACHCHECK()
        ach_pick = -1
        uimode$ = "ach"
    ELSEIF LEFT$(act$, 8) = "achpick:" THEN
        SFX("TAP")
        ach_pick = VAL(MID$(act$, 8, 4))
    ELSEIF act$ = "endlessmenu" THEN
        SFX("TAP")
        IF uimode$ = "play" THEN SETSONG(MENU_SONG)
        MUSICMIX("menu")
        uimode$ = "endless"
    ELSEIF LEFT$(act$, 6) = "arena:" THEN
        SFX("TAP")
        STARTENDLESS(VAL(MID$(act$, 6, 2)))
    ELSEIF act$ = "dailymenu" THEN
        SFX("TAP")
        IF uimode$ = "play" THEN SETSONG(MENU_SONG)
        MUSICMIX("menu")
        LOADDAILY()
        uimode$ = "daily"
    ELSEIF act$ = "dailygo" THEN
        SFX("TAP")
        STARTDAILY()
    ELSEIF act$ = "back" ORELSE act$ = "levels" ORELSE act$ = "res:levels" THEN
        SFX("TAP")
        TOMENU()
    ELSEIF act$ = "next" THEN
        IF PERKOPEN() = 0 THEN
            IF SIM.LAUNCH() = "" THEN sel_slot = -1
        ENDIF
    ELSEIF act$ = "speed" THEN
        speed = speed + 1
        IF speed > 3 THEN speed = 1
        SFX("TAP")
    ELSEIF act$ = "pause" THEN
        paused = 1 - paused
        SFX("TAP")
    ELSEIF act$ = "resume" THEN
        paused = 0
        SFX("TAP")
    ELSEIF act$ = "restart" ORELSE act$ = "res:retry" THEN
        RESTART()
    ELSEIF act$ = "res:next" THEN
        STARTLEVEL(cur_level + 1)
    ELSEIF act$ = "res:finale" THEN
        OPENFINALE(IIF(cur_level > 20, 2, 1))
    ELSEIF act$ = "fin:done" THEN
        SFX("TAP")
        IF finale_world = 1 THEN world = 2
        TOMENU()
    ELSEIF LEFT$(act$, 5) = "perk:" THEN
        SFX("BUILD")
        SIM.PERK(MID$(act$, 5, 8))
        perks_taken = perks_taken + 1
    ELSEIF act$ = "music" THEN
        mus_on = 1 - mus_on
        MUSICMIX(mus_mode$)
    ELSEIF act$ = "sfx" THEN
        sfx_on = 1 - sfx_on
        SFX("TAP")
    ELSEIF act$ = "glow" THEN
        glow_on = 1 - glow_on
    ELSEIF act$ = "gold" THEN
        gold_on = 1 - gold_on
        BAKEFIELD(cur_lv)
    ELSEIF LEFT$(act$, 2) = "R:" THEN
        RINGACT(MID$(act$, 2, 40))
    ENDIF
ENDSUB

' The first tap on a choice explains it, the second one does it
SUB RINGACT(code$)
    IF pending$ <> code$ THEN
        pending$ = code$
        SFX("TAP")
        RETURN
    ENDIF
    DIM r$ = ""
    IF LEFT$(code$, 2) = "B:" THEN
        r$ = SIM.BUILD(sel_slot, MID$(code$, 2, 40))
    ELSEIF code$ = "SELL" THEN
        r$ = SIM.SELL(sel_slot)
    ELSE
        r$ = SIM.UPGRADE(sel_slot, MID$(code$, 2, 4))
        IF r$ = "" THEN
            DIM t = SIM.TOWER(sel_slot)
            IF t{"BR"} <> "" ANDALSO LEN(SIM.UPOPTS(sel_slot)) = 0 THEN stats{"max" + t{"BR"} + "_" + t{"KIND"}} = 1
        ENDIF
    ENDIF
    IF r$ = "credits" THEN
        TOAST(T$("no_credits"))
        RETURN
    ENDIF
    IF r$ = "" THEN
        IF code$ = "SELL" ORELSE LEFT$(code$, 2) = "B:" THEN
            sel_slot = -1
        ENDIF
        pending$ = ""
    ENDIF
ENDSUB

FUNC SLOTAT(px, py)
    DIM i
    FOR i = 0 TO SIM.NSLOTS() - 1
        DIM s = SIM.SLOTPOS(i)
        IF ABS(PXX(s[0] + 0.5) - px) < 21 ANDALSO ABS(PXY(s[1] + 0.5) - py) < 21 THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

SUB HANDLETAP(px, py)
    DIM act$ = HITTEST$(px, py)
    IF act$ <> "" THEN
        DOACTION(act$)
        RETURN
    ENDIF
    IF uimode$ <> "play" ORELSE paused = 1 THEN RETURN
    IF SIM.PHASE$() = "won" ORELSE SIM.PHASE$() = "lost" THEN RETURN
    IF py < FY0 ORELSE py >= BAR_Y THEN RETURN
    DIM s = SLOTAT(px, py)
    IF s >= 0 ANDALSO s <> sel_slot THEN
        OPENRING(s)
    ELSE
        sel_slot = -1
        pending$ = ""
    ENDIF
ENDSUB

SUB HANDLEKEY(k$)
    IF k$ = "Escape" THEN
        IF uimode$ = "play" THEN
            IF sel_slot >= 0 THEN
                sel_slot = -1
            ELSE
                paused = 1 - paused
            ENDIF
        ELSEIF uimode$ <> "menu" THEN
            TOMENU()
        ELSE
            running = 0
        ENDIF
    ELSEIF k$ = "Space" ANDALSO uimode$ = "play" ANDALSO paused = 0 ANDALSO PERKOPEN() = 0 THEN
        SIM.LAUNCH()
    ENDIF
ENDSUB

' ── frame ───────────────────────────────────────────────────────

' Badges a won level can bring, from what happened during it
SUB WINSTATS()
    IF SIM.LIVES() >= cur_lv{"LIVES"} THEN stats{"flawless"} = 1
    IF SIM.LIVES() = 1 THEN stats{"clutch"} = 1
    IF cur_level >= 5 ANDALSO lv_max_towers <= 3 ANDALSO lv_max_towers > 0 THEN stats{"minimalist"} = 1
    IF cur_level >= 5 ANDALSO LEN(lv_kinds) = 1 THEN stats{"specialist"} = 1
    IF lv_turbo = 1 THEN stats{"turbo_win"} = 1
    IF play_kind$ = "level" ANDALSO MAP.EXISTS(lost_set, STR$(cur_level)) THEN stats{"comeback"} = 1
ENDSUB

SUB LEVELOVER()
    result_done = 1
    result_stars = SIM.STARS()
    result_score = SIM.SCORE()
    sel_slot = -1
    DIM won = IIF(SIM.PHASE$() = "won", 1, 0)
    DIM finale = 0
    IF play_kind$ = "level" THEN
        IF won = 1 THEN
            IF STARSOF(cur_level) = 0 ANDALSO (cur_level = 20 ORELSE cur_level = N_LEVELS) THEN finale = 1
            WINSTATS()
            RECORD(cur_level, result_stars, result_score)
        ELSE
            lost_set{STR$(cur_level)} = 1
        ENDIF
    ELSEIF play_kind$ = "endless" THEN
        result_record = RECORDENDLESS(cur_arena, MAX([0, SIM.WAVE() - 1]), result_score)
    ELSEIF won = 1 THEN
        WINSTATS()
        RECORDDAILY(result_score)
    ENDIF
    IF WORLDSTARS(1) >= 60 ANDALSO STAT("stars_w1") < 60 THEN gold_on = 1
    ACHCHECK()
    SAVEPROFILE()
    IF finale = 1 THEN OPENFINALE(IIF(cur_level > 20, 2, 1))
ENDSUB

SUB UPDATE()
    IF uimode$ <> "play" THEN RETURN
    IF paused = 1 THEN RETURN
    DIM ph$ = SIM.PHASE$()
    IF ph$ = "won" ORELSE ph$ = "lost" THEN
        IF result_done = 0 THEN LEVELOVER()
        RETURN
    ENDIF
    ' fixed steps for the time that really passed, so a slow device plays
    ' at the right pace with coarser frames instead of in slow motion
    sim_acc = sim_acc + dt_frame * speed
    DIM n_steps = 0
    DO WHILE sim_acc >= SIM_DT ANDALSO n_steps < 8
        SIM.ADVANCE(SIM_DT)
        sim_acc = sim_acc - SIM_DT
        n_steps = n_steps + 1
    LOOP
    IF n_steps = 8 THEN sim_acc = 0.0
    EVENTSTOFX()
    IF SIM.WAVE() > 0 ANDALSO speed < 3 ANDALSO SIM.BUSY() > 0 THEN lv_turbo = 0
    IF frame MOD 30 = 0 THEN
        STATMAX("credits_peak", SIM.CREDITS())
        ACHCHECK()
    ENDIF
ENDSUB

SUB DRAWFRAME()
    hits = []
    BEGINFRAME()
    IF uimode$ = "play" THEN
        DRAWPLAY()
    ELSEIF uimode$ = "board" THEN
        DRAWBOARD()
    ELSEIF uimode$ = "ach" THEN
        DRAWACH()
    ELSEIF uimode$ = "endless" THEN
        DRAWENDLESSMENU()
    ELSEIF uimode$ = "daily" THEN
        DRAWDAILYMENU()
    ELSEIF uimode$ = "finale" THEN
        DRAWFINALE()
    ELSE
        DRAWMENU()
    ENDIF
    DRAWBANNER()
    ENDFRAME()
    hits_prev = hits
ENDSUB

' ── start ───────────────────────────────────────────────────────

DIM shotmode$ = ""
DIM shot_level = 1
DIM selftest = 0
DIM shot_screen$ = "menu"

' Taps the centre of whatever button the last frame registered for act$
SUB TAPACT(act$)
    FOR EACH h IN hits_prev
        IF h[4] = act$ THEN
            taps = APPEND(taps, [[h[0] + h[2] / 2, h[1] + h[3] / 2]])
            RETURN
        ENDIF
    NEXT h
    PRINT "selftest: no button "; act$
ENDSUB

SUB TAPSLOT(i)
    DIM s = SIM.SLOTPOS(i)
    taps = APPEND(taps, [[PXX(s[0] + 0.5), PXY(s[1] + 0.5)]])
ENDSUB

' A scripted session through the real tap path: pick level 1, build two
' towers with the confirm tap, launch, speed up, upgrade, pause, resume
SUB SELFTEST_STEP(f)
    IF f = 3 THEN TAPACT("lvl:1")
    IF f = 6 THEN TAPSLOT(0)
    IF f = 9 ORELSE f = 12 THEN TAPACT("R:B:LASER")
    IF f = 15 THEN TAPSLOT(1)
    IF f = 18 ORELSE f = 21 THEN TAPACT("R:B:BLASTER")
    IF f = 24 THEN TAPACT("next")
    IF f = 27 ORELSE f = 30 THEN TAPACT("speed")
    IF f = 60 THEN TAPSLOT(0)
    IF f = 63 ORELSE f = 66 THEN TAPACT("R:U:UP")
    IF f = 200 THEN TAPACT("pause")
    IF f = 210 THEN
        IF NOT FILE.EXISTS(GAMEDIR$ + "tmp") THEN MKDIR GAMEDIR$ + "tmp"
        GFX.SAVE_SCREENSHOT(GAMEDIR$ + "tmp/pause.png")
        TAPACT("resume")
    ENDIF
    IF f = 300 THEN
        GFX.SAVE_SCREENSHOT(GAMEDIR$ + "tmp/selftest.png")
        PRINT "slot0 "; SIM.TOWER(0){"KIND"}; " tier "; SIM.TOWER(0){"TIER"}; "  slot1 "; SIM.TOWER(1){"KIND"}
        PRINT "wave "; SIM.WAVE(); "  speed "; speed; "  paused "; paused; "  credits "; SIM.CREDITS(); "  kills "; SIM.KILLS(); "  lives "; SIM.LIVES(); "  phase "; SIM.PHASE$()
        running = 0
    ENDIF
ENDSUB
DIM plain = []
DIM ai
FOR ai = 1 TO LEN(cli) - 1
    DIM arg$ = "" + cli[ai]
    IF LCASE$(arg$) = "shot" ORELSE LCASE$(arg$) = "shotmenu" ORELSE LCASE$(arg$) = "shotendless" THEN
        shotmode$ = LCASE$(arg$)
    ELSEIF LCASE$(arg$) = "fps" THEN
        show_fps = 1
    ELSEIF LCASE$(arg$) = "selftest" THEN
        selftest = 1
    ELSEIF LCASE$(arg$) = "shotscreen" THEN
        shotmode$ = "shotscreen"
    ELSEIF shotmode$ = "shotscreen" THEN
        shot_screen$ = LCASE$(arg$)
    ELSEIF shotmode$ <> "" THEN
        shot_level = VAL(arg$)
    ELSE
        plain = APPEND(plain, arg$)
    ENDIF
NEXT ai
IF LEN(plain) >= 2 THEN
    myname$ = plain[0]
    mypin$ = plain[1]
ENDIF

SCREEN SCR_W, SCR_H, "jdTower"
GFXINIT()
FONTSIZE(18)
LOGIN()
DERIVESTATS()
IF WORLDSTARS(1) >= 60 THEN gold_on = 1
IF shotmode$ = "" THEN
    SNDINIT()
    MUSICINIT()
ENDIF

' Plays a level for a while with a few towers, then saves one frame
' (n < 0: the first endless arena)
SUB SHOT(n)
    IF n < 0 THEN
        STARTENDLESS(1)
    ELSE
        STARTLEVEL(n)
    ENDIF
    DIM lv = cur_lv
    DIM kinds = lv{"TOWERS"}
    DIM i
    FOR i = 0 TO SIM.NSLOTS() - 1
        SIM.BUILD(i, kinds[i MOD LEN(kinds)])
    NEXT i
    SIM.LAUNCH()
    SIM.LAUNCH()
    FOR i = 1 TO 330
        SIM.ADVANCE(SIM_DT)
        tnow = tnow + SIM_DT
        IF i > 300 THEN EVENTSTOFX()
        IF i < 300 THEN SIM.QUIET(0)
    NEXT i
    sel_slot = 0
    pending$ = "U:UP"
    DIM s = SIM.SLOTPOS(0)
    ring_cx = PXX(s[0] + 0.5)
    ring_cy = PXY(s[1] + 0.5)
ENDSUB

IF shotmode$ <> "" THEN
    IF shotmode$ = "shot" THEN SHOT(shot_level)
    IF shotmode$ = "shotendless" THEN SHOT(-1)
    IF shotmode$ = "shotmenu" ANDALSO shot_level = 2 THEN world = 2
    IF shotmode$ = "shotscreen" THEN
        IF shot_screen$ = "daily" THEN LOADDAILY()
        IF shot_screen$ = "board" THEN LOADBOARD("W1")
        IF shot_screen$ = "finale" THEN
            OPENFINALE(1)
        ELSE
            uimode$ = shot_screen$
        ENDIF
        IF shot_screen$ = "ach" THEN ach_pick = 2
    ENDIF
    tnow = tnow + 0.5
    DIM tf0 = TICK()
    DIM fi
    FOR fi = 1 TO 10
        DRAWFRAME()
    NEXT fi
    DIM frame_ms = (TICK() - tf0) / 10
    IF NOT FILE.EXISTS(GAMEDIR$ + "tmp") THEN MKDIR GAMEDIR$ + "tmp"
    GFX.SAVE_SCREENSHOT(GAMEDIR$ + "tmp/shot.png")
    SCREENFLIP
    PRINT "shot saved, phase "; SIM.PHASE$(); "  credits "; SIM.CREDITS(); "  draw "; frame_ms; " ms"
    GFX.CLOSE
ELSE
    DIM t_last = TICK()
    DO
        IF running = 0 THEN EXITDO
        DIM t0 = TICK()
        dt_frame = (t0 - t_last) / 1000.0
        IF dt_frame > 0.25 THEN dt_frame = 0.25
        IF dt_frame > 0 THEN fps_avg = fps_avg * 0.95 + 0.05 / dt_frame
        tnow = tnow + dt_frame
        t_last = t0
        frame = frame + 1
        IF flash > 0 THEN flash = flash * 0.9
        IF selftest = 1 THEN SELFTEST_STEP(frame)
        DO WHILE LEN(taps) > 0
            DIM tp = taps[0]
            taps = DROP(1, taps)
            HANDLETAP(tp[0], tp[1])
        LOOP
        DO WHILE LEN(keys_in) > 0
            DIM kk$ = keys_in[0]
            keys_in = DROP(1, keys_in)
            HANDLEKEY(kk$)
        LOOP
        UPDATE()
        DRAWFRAME()
        SCREENFLIP
        DIM rest = 33 - (TICK() - t0)
        IF rest < 1 THEN rest = 1
        SLEEP rest
    LOOP
    GFX.CLOSE
ENDIF
