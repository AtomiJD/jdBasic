' FIT demo: a sensor calibration line, a radioactive decay fitted with the
' uncertainty of each parameter, a temperature curve through a few
' readings, the time a tank reaches a level, and the cheapest box size.

IMPORT FIT

FUNC Decay(t, p)
    DIM amp = p[0]
    DIM rate = p[1]
    DIM background = p[2]
    RETURN amp * EXP(-rate * t) + background
ENDFUNC

FUNC TankLevel(t)
    RETURN 2.0 * (1.0 - EXP(-0.35 * t)) - 1.5
ENDFUNC

' The sheet metal a closed box of one litre with a square base needs, by
' the side of the base in decimetres.
FUNC BoxArea(side)
    DIM height = 1.0 / (side * side)
    RETURN 2.0 * side * side + 4.0 * side * height
ENDFUNC

FUNC Fixed$(value, places)
    RETURN FORMAT$("{:." + STR$(places) + "f}", value)
ENDFUNC

PRINT "Calibration: raw sensor counts against a reference thermometer"
DIM counts = [412.0, 530.0, 655.0, 771.0, 898.0, 1013.0]
DIM celsius = [0.0, 10.0, 20.1, 30.0, 40.2, 49.9]
DIM cal = FIT.POLYFIT(counts, celsius, 1)
PRINT "  degrees = " + Fixed$(cal[0], 5) + " * counts + " + Fixed$(cal[1], 3)
PRINT "  a reading of 720 counts is " + Fixed$(FIT.POLYVAL(cal, 720.0), 2) + " C"
PRINT ""

PRINT "Decay: counts per minute over an hour"
DIM minutes = [0.0, 5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 35.0, 40.0, 45.0, 50.0, 55.0, 60.0]
DIM rates = [1021.0, 790.0, 612.0, 480.0, 381.0, 300.0, 244.0, 199.0, 163.0, 139.0, 120.0, 106.0, 93.0]
DIM noise = []
DIM i = 0
FOR i = 0 TO LEN(rates) - 1
    DIM r = rates[i]
    PUSH(noise, SQR(r))
NEXT i
DIM opts AS MAP
opts{"sigma"} = noise
DIM fitted = FIT.CURVEFIT(Decay@, minutes, rates, [1000.0, 0.05, 50.0], opts)
DIM params = fitted{"params"}
DIM errors = fitted{"errors"}
DIM labels = ["start rate", "decay constant", "background"]
FOR i = 0 TO 2
    DIM label$ = labels[i]
    DIM pv = params[i]
    DIM ev = errors[i]
    PRINT "  " + LEFT$(label$ + "                ", 16) + Fixed$(pv, 4) + " +- " + Fixed$(ev, 4)
NEXT i
DIM decay_rate = params[1]
PRINT "  half-life " + Fixed$(LOG(2.0) / decay_rate, 2) + " minutes, after " + STR$(fitted{"iterations"}) + " iterations"
PRINT ""

PRINT "Temperature through four readings, as a natural spline"
DIM hours = [6.0, 10.0, 14.0, 20.0]
DIM temps = [11.5, 17.0, 21.5, 15.0]
DIM curve = FIT.SPLINE(hours, temps, "natural")
FOR i = 6 TO 20 STEP 2
    DIM hour = i * 1.0
    DIM temp = FIT.SPLINEVAL(curve, hour)
    DIM rise = FIT.SPLINEDERIV(curve, hour)
    PRINT "  " + LPAD$(STR$(i), 2) + ":00  " + Fixed$(temp, 1) + " C  " + LPAD$(Fixed$(rise, 2), 5) + " C per hour  " + REPEAT$("#", CLNG(temp))
NEXT i
PRINT ""

PRINT "A tank filling towards 2 m reaches 1.5 m after " + Fixed$(FIT.BRENT(TankLevel@, 0.0, 30.0), 3) + " hours"
DIM box = FIT.MINIMIZE(BoxArea@, 0.2, 3.0)
PRINT "The one-litre box with the least metal has a base of " + Fixed$(box{"x"}, 4) + " dm and needs " + Fixed$(box{"fun"}, 4) + " square dm"
