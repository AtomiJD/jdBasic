' SECRET demo: a small user table with sign-up and sign-in, one old account
' hashed the way jdweb did before (salted SHA-256) that moves to PBKDF2 on
' its next sign-in, a password reset token, and an API key shown once.

IMPORT SECRET

DIM gHashes AS MAP
DIM gRounds = 20000

SUB SignUp(name$, password$)
    gHashes{name$} = SECRET.HASH$(password$, gRounds)
    PRINT "signed up " + name$
ENDSUB

FUNC SignIn(name$, attempt$)
    IF NOT MAP.EXISTS(gHashes, name$) THEN RETURN FALSE
    DIM stored$ = gHashes{name$}
    DIM ok = FALSE
    IF LEFT$(stored$, 7) = "sha256:" THEN
        DIM parts = SPLIT(stored$, ":")
        DIM salt$ = parts[1]
        DIM old$ = parts[2]
        ok = SECRET.EQUAL(CODEC.SHA256$(salt$ + ":" + attempt$), old$)
    ELSE
        ok = SECRET.VERIFY(attempt$, stored$)
    ENDIF
    IF ok ANDALSO SECRET.NEEDS_REHASH(stored$, gRounds) THEN
        gHashes{name$} = SECRET.HASH$(attempt$, gRounds)
        PRINT "  " + name$ + ": hash renewed"
    ENDIF
    RETURN ok
ENDFUNC

SignUp("ann", "correct horse battery staple")
SignUp("bob", "hunter2")
DIM legacy_salt$ = "5f2b"
gHashes{"carl"} = "sha256:" + legacy_salt$ + ":" + CODEC.SHA256$(legacy_salt$ + ":" + "tr0ub4dor")

FUNC Outcome$(name$, attempt$)
    IF SignIn(name$, attempt$) THEN RETURN "accepted"
    RETURN "refused"
ENDFUNC

PRINT ""
PRINT "Signing in"
PRINT "  ann with her password:  " + Outcome$("ann", "correct horse battery staple")
PRINT "  bob with a typo:        " + Outcome$("bob", "hunter3")
DIM carl_first$ = Outcome$("carl", "tr0ub4dor")
PRINT "  carl, old account:      " + carl_first$
DIM carl$ = gHashes{"carl"}
PRINT "  carl's hash now:        " + LEFT$(carl$, 40) + "..."
PRINT "  carl again:             " + Outcome$("carl", "tr0ub4dor")

PRINT ""
PRINT "A password reset link"
DIM reset$ = SECRET.TOKEN$()
PRINT "  https://example.org/reset?token=" + reset$
PRINT "  keep only its hash:     " + SECRET.KEYHASH$(reset$)

PRINT ""
PRINT "An API key"
DIM api_key$ = SECRET.APIKEY$("jdk")
DIM kept$ = SECRET.KEYHASH$(api_key$)
PRINT "  shown once:             " + api_key$
PRINT "  stored:                 " + kept$
PRINT "  the right key:          "; SECRET.KEYMATCH(api_key$, kept$)
PRINT "  a guessed key:          "; SECRET.KEYMATCH("jdk_" + SECRET.TOKEN$(), kept$)
