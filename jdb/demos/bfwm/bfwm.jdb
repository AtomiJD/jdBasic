' Black Forest Games - single-file championship scoreboard (SQLite + ImGui)
' with a built-in PDF certificate generator. Self-contained so it runs
' from one link in the jdBasic WASM playground.

' Certificate PDF generator - hand-built landscape-A4 PDF.
' URK_CREATE(path$, event$, date$, name$, title$, place) writes one page.
' No external library: PDF is assembled as bytes and written with TXTWRITER.

DIM PLF$ = CHR$(10)

' Helvetica-Bold advance widths (1/1000 em) for WinAnsi codes 32..126,
' used to centre text.
DIM HWSTR$ = "278 333 474 556 556 889 722 238 333 333 389 584 278 333 278 278 556 556 556 556 556 556 556 556 556 556 333 333 584 584 584 611 975 722 722 722 722 667 611 778 722 278 556 722 611 833 722 778 667 778 722 667 611 722 667 944 667 667 611 333 278 333 584 556 333 556 611 556 611 556 333 611 611 278 278 556 278 889 611 611 611 611 389 556 333 611 556 778 556 556 500 389 280 389 584"
DIM HW = IOTA(256, 0) * 0 + 556
DIM hwi
DIM HWPARTS = SPLIT(HWSTR$, " ")
FOR hwi = 0 TO LEN(HWPARTS) - 1
    HW[32 + hwi] = VAL(HWPARTS[hwi])
NEXT hwi

' Visible character -> WinAnsi code. ASC on a multi-byte UTF-8 char returns
' the byte value.
FUNC CCODE(c$)
    RETURN ASC(c$)
ENDFUNC

' Width of a string in points at the given font size.
FUNC TW(txt$, size, widths)
    DIM chars = -txt$
    DIM total = 0
    DIM j
    FOR j = 0 TO LEN(chars) - 1
        DIM code = CCODE(chars[j])
        IF code >= 0 ANDALSO code < 256 THEN total = total + widths[code]
    NEXT j
    RETURN total * size / 1000.0
ENDFUNC

' Escape the PDF-special characters in a text literal.
FUNC ENC$(s$)
    DIM r$ = s$
    r$ = REPLACE$(r$, CHR$(92), CHR$(92) + CHR$(92))
    r$ = REPLACE$(r$, "(", CHR$(92) + "(")
    r$ = REPLACE$(r$, ")", CHR$(92) + ")")
    RETURN r$
ENDFUNC

FUNC NUM$(n)
    RETURN LTRIM$(STR$(INT(n)))
ENDFUNC

FUNC PAD10$(n)
    DIM s$ = LTRIM$(STR$(INT(n)))
    DO WHILE LEN(s$) < 10
        s$ = "0" + s$
    LOOP
    RETURN s$
ENDFUNC

' One centered line of text at page-centre cx, baseline y.
FUNC CLINE$(cx, y, size, colr$, txt$, widths)
    DIM x = cx - TW(txt$, size, widths) / 2.0
    RETURN "BT /F1 " + NUM$(size) + " Tf " + colr$ + " rg " + NUM$(x) + " " + NUM$(y) + " Td (" + ENC$(txt$) + ") Tj ET" + PLF$
ENDFUNC

' Filled circle via four Bezier arcs (PDF has no circle primitive).
FUNC PCIRCLE$(cx, cy, r, colr$)
    DIM k = 0.5523 * r
    DIM s$ = colr$ + " rg" + PLF$
    s$ = s$ + NUM$(cx + r) + " " + NUM$(cy) + " m" + PLF$
    s$ = s$ + NUM$(cx + r) + " " + NUM$(cy + k) + " " + NUM$(cx + k) + " " + NUM$(cy + r) + " " + NUM$(cx) + " " + NUM$(cy + r) + " c" + PLF$
    s$ = s$ + NUM$(cx - k) + " " + NUM$(cy + r) + " " + NUM$(cx - r) + " " + NUM$(cy + k) + " " + NUM$(cx - r) + " " + NUM$(cy) + " c" + PLF$
    s$ = s$ + NUM$(cx - r) + " " + NUM$(cy - k) + " " + NUM$(cx - k) + " " + NUM$(cy - r) + " " + NUM$(cx) + " " + NUM$(cy - r) + " c" + PLF$
    s$ = s$ + NUM$(cx + k) + " " + NUM$(cy - r) + " " + NUM$(cx + r) + " " + NUM$(cy - k) + " " + NUM$(cx + r) + " " + NUM$(cy) + " c" + PLF$
    s$ = s$ + "f" + PLF$
    RETURN s$
ENDFUNC

FUNC URK_CREATE(path$, comp$, dat$, nam$, titl$, place)
    DIM widths = HW
    DIM cx = 421
    DIM navy$ = "0.09 0.11 0.35"
    DIM gray$ = "0.30 0.30 0.34"

    DIM medal$ = "0.72 0.47 0.25"
    DIM plabel$ = NUM$(place) + "th Place"
    IF place = 1 THEN medal$ = "0.86 0.68 0.20"
    IF place = 2 THEN medal$ = "0.62 0.63 0.67"
    IF place = 1 THEN plabel$ = "1st Place"
    IF place = 2 THEN plabel$ = "2nd Place"
    IF place = 3 THEN plabel$ = "3rd Place"

    DIM S$ = ""
    ' outer + inner frame
    S$ = S$ + "3 w " + navy$ + " RG" + PLF$
    S$ = S$ + "28 28 786 539 re S" + PLF$
    S$ = S$ + "1 w" + PLF$
    S$ = S$ + "40 40 762 515 re S" + PLF$
    ' title with an underline the exact width of the word
    DIM titlew = TW("CERTIFICATE", 58, widths)
    S$ = S$ + CLINE$(cx, 470, 58, navy$, "CERTIFICATE", widths)
    S$ = S$ + "2 w " + navy$ + " RG " + NUM$(cx - titlew / 2.0) + " 455 m " + NUM$(cx + titlew / 2.0) + " 455 l S" + PLF$
    ' competition + date
    S$ = S$ + CLINE$(cx, 415, 24, navy$, comp$, widths)
    S$ = S$ + CLINE$(cx, 388, 15, gray$, dat$, widths)
    ' recipient
    S$ = S$ + CLINE$(cx, 330, 17, gray$, "awarded to", widths)
    S$ = S$ + CLINE$(cx, 285, 40, navy$, nam$, widths)
    IF LEN(titl$) > 0 THEN S$ = S$ + CLINE$(cx, 250, 18, gray$, titl$, widths)
    ' medal + placement
    S$ = S$ + PCIRCLE$(cx, 150, 46, medal$)
    S$ = S$ + CLINE$(cx, 133, 44, "1 1 1", NUM$(place), widths)
    S$ = S$ + CLINE$(cx, 78, 30, medal$, plabel$, widths)

    DIM objs = []
    objs = APPEND(objs, "<</Type /Catalog /Pages 2 0 R>>")
    objs = APPEND(objs, "<</Type /Pages /Kids [3 0 R] /Count 1>>")
    objs = APPEND(objs, "<</Type /Page /Parent 2 0 R /MediaBox [0 0 842 595] /Resources <</Font <</F1 5 0 R>>>> /Contents 4 0 R>>")
    objs = APPEND(objs, "<</Length " + NUM$(LEN(S$)) + ">>" + PLF$ + "stream" + PLF$ + S$ + "endstream")
    objs = APPEND(objs, "<</Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding>>")

    DIM pdf$ = "%PDF-1.4" + PLF$
    DIM xref = []
    DIM m
    FOR m = 0 TO LEN(objs) - 1
        xref = APPEND(xref, LEN(pdf$))
        pdf$ = pdf$ + NUM$(m + 1) + " 0 obj" + PLF$ + objs[m] + PLF$ + "endobj" + PLF$
    NEXT m
    DIM sx = LEN(pdf$)
    pdf$ = pdf$ + "xref" + PLF$ + "0 " + NUM$(LEN(objs) + 1) + PLF$
    pdf$ = pdf$ + "0000000000 65535 f" + CHR$(13) + PLF$
    FOR m = 0 TO LEN(objs) - 1
        pdf$ = pdf$ + PAD10$(xref[m]) + " 00000 n" + CHR$(13) + PLF$
    NEXT m
    pdf$ = pdf$ + "trailer" + PLF$ + "<</Size " + NUM$(LEN(objs) + 1) + " /Root 1 0 R>>" + PLF$
    pdf$ = pdf$ + "startxref" + PLF$ + NUM$(sx) + PLF$ + "%%EOF" + PLF$
    TXTWRITER path$, pdf$, FALSE
    RETURN LEN(pdf$)
ENDFUNC

' Black Forest championship scoreboard - SQLite + ImGui.
' Tabs: dashboard (record a result, live standings), participants, games.
' A game awards p1/p2/p3 points for the 1st/2nd/3rd place (default 3/2/1).


' OS.ARGS() is empty in the browser (WASM), so guard the index; the app then
' runs there too, with the database at the in-memory filesystem root.
DIM ARGV = OS.ARGS()
DIM SCRIPT_DIR$ = ""
IF LEN(ARGV) > 0 THEN SCRIPT_DIR$ = PATH.DIRNAME$(ARGV[0])
DIM DB_PATH$ = PATH.JOIN$(SCRIPT_DIR$, "bfwm.db")
DIM DB = SQL.OPEN(DB_PATH$)
IF DB = 0 THEN
    PRINT "DB open failed: " + SQL.ERRMSG$(0)
    END
ENDIF

SQL.EXEC(DB, "CREATE TABLE IF NOT EXISTS participants(id INTEGER PRIMARY KEY AUTOINCREMENT, nr INTEGER, name TEXT, title TEXT, extra TEXT)")
SQL.EXEC(DB, "CREATE TABLE IF NOT EXISTS games(id INTEGER PRIMARY KEY AUTOINCREMENT, nr INTEGER, name TEXT, p1 INTEGER, p2 INTEGER, p3 INTEGER)")
SQL.EXEC(DB, "CREATE TABLE IF NOT EXISTS results(id INTEGER PRIMARY KEY AUTOINCREMENT, game_id INTEGER, part_id INTEGER, place INTEGER)")
SQL.EXEC(DB, "CREATE TABLE IF NOT EXISTS settings(k TEXT PRIMARY KEY, v TEXT)")

DIM MonNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
DIM Today$ = MonNames[MONTH(NOW()) - 1] + " " + LTRIM$(STR$(DAY(NOW()))) + ", " + LTRIM$(STR$(YEAR(NOW())))

' Filename-safe form of a participant name (no spaces).
FUNC SafeName$(s$)
    DIM r$ = s$
    r$ = REPLACE$(r$, " ", "_")
    RETURN r$
ENDFUNC

FUNC LoadGames(dbh)
    RETURN SQL.QUERY(dbh, "SELECT id, nr, name, p1, p2, p3 FROM games ORDER BY nr, id")
ENDFUNC

FUNC LoadParts(dbh)
    RETURN SQL.QUERY(dbh, "SELECT id, nr, name, title, extra FROM participants ORDER BY nr, id")
ENDFUNC

FUNC LoadStandings(dbh)
    RETURN SQL.QUERY(dbh, "SELECT t.nr AS nr, t.name AS name, t.title AS title, COALESCE(SUM(CASE r.place WHEN 1 THEN g.p1 WHEN 2 THEN g.p2 WHEN 3 THEN g.p3 ELSE 0 END), 0) AS pts FROM participants t LEFT JOIN results r ON r.part_id = t.id LEFT JOIN games g ON g.id = r.game_id GROUP BY t.id ORDER BY pts DESC, t.name ASC")
ENDFUNC

FUNC LoadResults(dbh)
    RETURN SQL.QUERY(dbh, "SELECT r.id AS id, g.name AS game, t.name AS part, r.place AS place, CASE r.place WHEN 1 THEN g.p1 WHEN 2 THEN g.p2 WHEN 3 THEN g.p3 ELSE 0 END AS pts FROM results r JOIN games g ON g.id = r.game_id JOIN participants t ON t.id = r.part_id ORDER BY r.id DESC")
ENDFUNC

' Double single quotes so free text is safe inside an SQL string literal.
FUNC Esc$(s$)
    RETURN REPLACE$(s$, "'", "''")
ENDFUNC

' Combo label array (number + name) from a games/participants list.
FUNC LabelsOf(list)
    DIM out = []
    FOR i = 0 TO LEN(list) - 1
        DIM row = list[i]
        out = APPEND(out, STR$(row{"nr"}) + " - " + row{"name"})
    NEXT i
    RETURN out
ENDFUNC

' Scale factor 2 renders everything at double size for easy reading from
' across the room. The ImGui coordinate space is the physical window, so the
' fill size below is SCALE * the logical screen size.
DIM SCALE = 2
SCREEN 1280, 800, "Black Forest Games", SCALE
GUI.THEME "DARK"

SUB HandleQuit(QuitData)
    Running = 0
ENDSUB
ON "QUIT" CALL HandleQuit

' F11 toggles fullscreen (the desktop panel steals width in windowed mode).
' SDL3 keycode = scancode | $40000000; F11 scancode is $44.
SUB HandleKey(KeyData)
    IF KeyData[0]{"keycode"} = $40000044 THEN
        TOGGLE_FULLSCREEN
    ENDIF
ENDSUB
ON "KEYDOWN" CALL HandleKey

DIM Running = 1
DIM StatusMsg$ = "Ready."

DIM CompName$ = "Black Forest Games 2026"
DIM crows = SQL.QUERY(DB, "SELECT v FROM settings WHERE k = 'comp'")
IF LEN(crows) > 0 THEN CompName$ = crows[0]{"v"}
DIM CompSaved$ = CompName$

DIM EventDate$ = Today$
DIM drows = SQL.QUERY(DB, "SELECT v FROM settings WHERE k = 'date'")
IF LEN(drows) > 0 THEN EventDate$ = drows[0]{"v"}
DIM DateSaved$ = EventDate$

DIM SelGame = 0
DIM SelPart = 0
DIM SelPlace = 0
DIM PlaceLabels = ["1st place", "2nd place", "3rd place"]

DIM InPartNr = 0
DIM InPartName$ = ""
DIM InPartTitle$ = ""
DIM InPartExtra$ = ""

DIM InGameNr = 0
DIM InGameName$ = ""
DIM InGameP1 = 3
DIM InGameP2 = 2
DIM InGameP3 = 1

' Edit buffers for the "Edit" modals.
DIM OpenPartEdit = FALSE
DIM EditPartId = 0
DIM EditPartNr = 0
DIM EditPartName$ = ""
DIM EditPartTitle$ = ""
DIM EditPartExtra$ = ""

DIM OpenGameEdit = FALSE
DIM EditGameId = 0
DIM EditGameNr = 0
DIM EditGameName$ = ""
DIM EditGameP1 = 3
DIM EditGameP2 = 2
DIM EditGameP3 = 1

DIM FieldW = 800
DIM TableFlags = GUI.FLAG("BORDERS") + GUI.FLAG("ROW_BG")
DIM WinFlags = GUI.FLAG("NOTITLEBAR") + GUI.FLAG("NORESIZE") + GUI.FLAG("NOMOVE") + GUI.FLAG("NOCOLLAPSE")

DO
    CLS
    DIM SW = GUI.DISPLAY_WIDTH()
    DIM SH = GUI.DISPLAY_HEIGHT()
    DIM Games = LoadGames(DB)
    DIM Parts = LoadParts(DB)
    DIM Standings = LoadStandings(DB)
    DIM Results = LoadResults(DB)

    IF SelGame >= LEN(Games) THEN SelGame = 0
    IF SelPart >= LEN(Parts) THEN SelPart = 0

    GUI.BEGIN "Black Forest Games", 0, 0, SW, SH, TRUE, WinFlags
        IF GUI.BEGIN_TAB_BAR("tabs") THEN

            IF GUI.BEGIN_TAB_ITEM("Dashboard") THEN
                GUI.SEPARATOR_TEXT "Record a result"
                IF LEN(Games) = 0 ORELSE LEN(Parts) = 0 THEN
                    GUI.TEXT "Add games and participants first."
                ELSE
                    DIM gLabels = LabelsOf(Games)
                    DIM pLabels = LabelsOf(Parts)
                    GUI.TEXT "Game:       "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    SelGame = GUI.COMBO("##game", SelGame, gLabels)
                    GUI.TEXT "Participant:"
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    SelPart = GUI.COMBO("##part", SelPart, pLabels)
                    GUI.TEXT "Place:      "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    SelPlace = GUI.COMBO("##place", SelPlace, PlaceLabels)
                    IF GUI.BUTTON("Record", 160, 0) THEN
                        DIM g = Games[SelGame]
                        DIM p = Parts[SelPart]
                        DIM placeVal = SelPlace + 1
                        SQL.EXEC(DB, "INSERT INTO results(game_id, part_id, place) VALUES(" + STR$(g{"id"}) + ", " + STR$(p{"id"}) + ", " + STR$(placeVal) + ")")
                        StatusMsg$ = p{"name"} + ": place " + STR$(placeVal) + " in " + g{"name"}
                    ENDIF
                ENDIF

                GUI.SEPARATOR_TEXT "Standings (" + CompName$ + ", " + EventDate$ + ")"
                IF GUI.BEGIN_TABLE("standings", 6, TableFlags) THEN
                    GUI.TABLE_SETUP_COLUMN "Rank"
                    GUI.TABLE_SETUP_COLUMN "No"
                    GUI.TABLE_SETUP_COLUMN "Name"
                    GUI.TABLE_SETUP_COLUMN "Title"
                    GUI.TABLE_SETUP_COLUMN "Points"
                    GUI.TABLE_SETUP_COLUMN "Certificate"
                    GUI.TABLE_HEADERS_ROW
                    FOR i = 0 TO LEN(Standings) - 1
                        DIM sr = Standings[i]
                        GUI.TABLE_NEXT_ROW
                        GUI.TABLE_SET_COLUMN_INDEX(0)
                        GUI.TEXT STR$(i + 1)
                        GUI.TABLE_SET_COLUMN_INDEX(1)
                        GUI.TEXT STR$(sr{"nr"})
                        GUI.TABLE_SET_COLUMN_INDEX(2)
                        GUI.TEXT sr{"name"}
                        GUI.TABLE_SET_COLUMN_INDEX(3)
                        GUI.TEXT sr{"title"}
                        GUI.TABLE_SET_COLUMN_INDEX(4)
                        GUI.TEXT STR$(sr{"pts"})
                        GUI.TABLE_SET_COLUMN_INDEX(5)
                        GUI.PUSH_ID(3000 + i)
                        IF GUI.BUTTON("Certificate") THEN
                            DIM fp$ = PATH.JOIN$(SCRIPT_DIR$, "certificate_" + LTRIM$(STR$(i + 1)) + "_" + SafeName$(sr{"name"}) + ".pdf")
                            URK_CREATE(fp$, CompName$, EventDate$, sr{"name"}, sr{"title"}, i + 1)
                            StatusMsg$ = "Certificate saved: " + fp$
                        ENDIF
                        GUI.POP_ID
                    NEXT i
                    GUI.END_TABLE
                ENDIF

                GUI.SEPARATOR_TEXT "Recent results"
                GUI.BEGIN_CHILD "reslist", 0, 180, TRUE
                    IF GUI.BEGIN_TABLE("results", 5, TableFlags) THEN
                        GUI.TABLE_SETUP_COLUMN "Game"
                        GUI.TABLE_SETUP_COLUMN "Participants"
                        GUI.TABLE_SETUP_COLUMN "Place"
                        GUI.TABLE_SETUP_COLUMN "Points"
                        GUI.TABLE_SETUP_COLUMN "Action"
                        GUI.TABLE_HEADERS_ROW
                        FOR i = 0 TO LEN(Results) - 1
                            DIM rr = Results[i]
                            GUI.TABLE_NEXT_ROW
                            GUI.TABLE_SET_COLUMN_INDEX(0)
                            GUI.TEXT rr{"game"}
                            GUI.TABLE_SET_COLUMN_INDEX(1)
                            GUI.TEXT rr{"part"}
                            GUI.TABLE_SET_COLUMN_INDEX(2)
                            GUI.TEXT STR$(rr{"place"}) + "."
                            GUI.TABLE_SET_COLUMN_INDEX(3)
                            GUI.TEXT STR$(rr{"pts"})
                            GUI.TABLE_SET_COLUMN_INDEX(4)
                            GUI.PUSH_ID(i)
                            IF GUI.BUTTON("Delete") THEN
                                SQL.EXEC(DB, "DELETE FROM results WHERE id = " + STR$(rr{"id"}))
                                StatusMsg$ = "Result deleted."
                            ENDIF
                            GUI.POP_ID
                        NEXT i
                        GUI.END_TABLE
                    ENDIF
                GUI.END_CHILD

                GUI.END_TAB_ITEM
            ENDIF

            IF GUI.BEGIN_TAB_ITEM("Participants") THEN
                GUI.SEPARATOR_TEXT "New participant"
                GUI.TEXT "No:       "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InPartNr = GUI.INPUT_INT("##pnr", InPartNr)
                GUI.TEXT "Name:     "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InPartName$ = GUI.INPUT("##pname", InPartName$)
                GUI.TEXT "Title:    "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InPartTitle$ = GUI.INPUT("##ptitle", InPartTitle$)
                GUI.TEXT "Extra:    "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InPartExtra$ = GUI.INPUT("##pextra", InPartExtra$)
                IF GUI.BUTTON("Add##addpart", 160, 0) THEN
                    IF LEN(InPartName$) > 0 THEN
                        SQL.EXEC(DB, "INSERT INTO participants(nr, name, title, extra) VALUES(" + STR$(InPartNr) + ", '" + Esc$(InPartName$) + "', '" + Esc$(InPartTitle$) + "', '" + Esc$(InPartExtra$) + "')")
                        StatusMsg$ = "Participant added: " + InPartName$
                        InPartName$ = ""
                        InPartTitle$ = ""
                        InPartExtra$ = ""
                        InPartNr = InPartNr + 1
                    ELSE
                        StatusMsg$ = "Name must not be empty."
                    ENDIF
                ENDIF

                GUI.SEPARATOR_TEXT "Participants (" + STR$(LEN(Parts)) + ")"
                IF GUI.BEGIN_TABLE("parttable", 5, TableFlags) THEN
                    GUI.TABLE_SETUP_COLUMN "No"
                    GUI.TABLE_SETUP_COLUMN "Name"
                    GUI.TABLE_SETUP_COLUMN "Title"
                    GUI.TABLE_SETUP_COLUMN "Extra"
                    GUI.TABLE_SETUP_COLUMN "Action"
                    GUI.TABLE_HEADERS_ROW
                    FOR i = 0 TO LEN(Parts) - 1
                        DIM pr = Parts[i]
                        GUI.TABLE_NEXT_ROW
                        GUI.TABLE_SET_COLUMN_INDEX(0)
                        GUI.TEXT STR$(pr{"nr"})
                        GUI.TABLE_SET_COLUMN_INDEX(1)
                        GUI.TEXT pr{"name"}
                        GUI.TABLE_SET_COLUMN_INDEX(2)
                        GUI.TEXT pr{"title"}
                        GUI.TABLE_SET_COLUMN_INDEX(3)
                        GUI.TEXT pr{"extra"}
                        GUI.TABLE_SET_COLUMN_INDEX(4)
                        GUI.PUSH_ID(1000 + i)
                        IF GUI.BUTTON("Edit") THEN
                            EditPartId = pr{"id"}
                            EditPartNr = pr{"nr"}
                            EditPartName$ = pr{"name"}
                            EditPartTitle$ = pr{"title"}
                            EditPartExtra$ = pr{"extra"}
                            OpenPartEdit = TRUE
                        ENDIF
                        GUI.SAME_LINE
                        IF GUI.BUTTON("Delete") THEN
                            SQL.EXEC(DB, "DELETE FROM participants WHERE id = " + STR$(pr{"id"}))
                            SQL.EXEC(DB, "DELETE FROM results WHERE part_id = " + STR$(pr{"id"}))
                            StatusMsg$ = "Participant deleted."
                        ENDIF
                        GUI.POP_ID
                    NEXT i
                    GUI.END_TABLE
                ENDIF

                IF OpenPartEdit THEN
                    GUI.OPEN_POPUP("Edit participant")
                    OpenPartEdit = FALSE
                ENDIF
                IF GUI.BEGIN_POPUP_MODAL("Edit participant", TRUE) THEN
                    GUI.TEXT "No:       "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditPartNr = GUI.INPUT_INT("##epnr", EditPartNr)
                    GUI.TEXT "Name:     "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditPartName$ = GUI.INPUT("##epname", EditPartName$)
                    GUI.TEXT "Title:    "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditPartTitle$ = GUI.INPUT("##eptitle", EditPartTitle$)
                    GUI.TEXT "Extra:    "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditPartExtra$ = GUI.INPUT("##epextra", EditPartExtra$)
                    GUI.SEPARATOR
                    IF GUI.BUTTON("Save", 200, 0) THEN
                        SQL.EXEC(DB, "UPDATE participants SET nr = " + STR$(EditPartNr) + ", name = '" + Esc$(EditPartName$) + "', title = '" + Esc$(EditPartTitle$) + "', extra = '" + Esc$(EditPartExtra$) + "' WHERE id = " + STR$(EditPartId))
                        StatusMsg$ = "Participant updated: " + EditPartName$
                        GUI.CLOSE_CURRENT_POPUP
                    ENDIF
                    GUI.SAME_LINE
                    IF GUI.BUTTON("Cancel", 200, 0) THEN
                        GUI.CLOSE_CURRENT_POPUP
                    ENDIF
                    GUI.END_POPUP
                ENDIF

                GUI.END_TAB_ITEM
            ENDIF

            IF GUI.BEGIN_TAB_ITEM("Games") THEN
                GUI.SEPARATOR_TEXT "New game"
                GUI.TEXT "No:       "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InGameNr = GUI.INPUT_INT("##gnr", InGameNr)
                GUI.TEXT "Name:     "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InGameName$ = GUI.INPUT("##gname", InGameName$)
                GUI.TEXT "1st pts:  "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InGameP1 = GUI.INPUT_INT("##gp1", InGameP1)
                GUI.TEXT "2nd pts:  "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InGameP2 = GUI.INPUT_INT("##gp2", InGameP2)
                GUI.TEXT "3rd pts:  "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                InGameP3 = GUI.INPUT_INT("##gp3", InGameP3)
                IF GUI.BUTTON("Add##addgame", 160, 0) THEN
                    IF LEN(InGameName$) > 0 THEN
                        SQL.EXEC(DB, "INSERT INTO games(nr, name, p1, p2, p3) VALUES(" + STR$(InGameNr) + ", '" + Esc$(InGameName$) + "', " + STR$(InGameP1) + ", " + STR$(InGameP2) + ", " + STR$(InGameP3) + ")")
                        StatusMsg$ = "Game added: " + InGameName$
                        InGameName$ = ""
                        InGameNr = InGameNr + 1
                        InGameP1 = 3
                        InGameP2 = 2
                        InGameP3 = 1
                    ELSE
                        StatusMsg$ = "Name must not be empty."
                    ENDIF
                ENDIF

                GUI.SEPARATOR_TEXT "Games (" + STR$(LEN(Games)) + ")"
                IF GUI.BEGIN_TABLE("gametable", 6, TableFlags) THEN
                    GUI.TABLE_SETUP_COLUMN "No"
                    GUI.TABLE_SETUP_COLUMN "Name"
                    GUI.TABLE_SETUP_COLUMN "1."
                    GUI.TABLE_SETUP_COLUMN "2."
                    GUI.TABLE_SETUP_COLUMN "3."
                    GUI.TABLE_SETUP_COLUMN "Action"
                    GUI.TABLE_HEADERS_ROW
                    FOR i = 0 TO LEN(Games) - 1
                        DIM gr = Games[i]
                        GUI.TABLE_NEXT_ROW
                        GUI.TABLE_SET_COLUMN_INDEX(0)
                        GUI.TEXT STR$(gr{"nr"})
                        GUI.TABLE_SET_COLUMN_INDEX(1)
                        GUI.TEXT gr{"name"}
                        GUI.TABLE_SET_COLUMN_INDEX(2)
                        GUI.TEXT STR$(gr{"p1"})
                        GUI.TABLE_SET_COLUMN_INDEX(3)
                        GUI.TEXT STR$(gr{"p2"})
                        GUI.TABLE_SET_COLUMN_INDEX(4)
                        GUI.TEXT STR$(gr{"p3"})
                        GUI.TABLE_SET_COLUMN_INDEX(5)
                        GUI.PUSH_ID(2000 + i)
                        IF GUI.BUTTON("Edit") THEN
                            EditGameId = gr{"id"}
                            EditGameNr = gr{"nr"}
                            EditGameName$ = gr{"name"}
                            EditGameP1 = gr{"p1"}
                            EditGameP2 = gr{"p2"}
                            EditGameP3 = gr{"p3"}
                            OpenGameEdit = TRUE
                        ENDIF
                        GUI.SAME_LINE
                        IF GUI.BUTTON("Delete") THEN
                            SQL.EXEC(DB, "DELETE FROM games WHERE id = " + STR$(gr{"id"}))
                            SQL.EXEC(DB, "DELETE FROM results WHERE game_id = " + STR$(gr{"id"}))
                            StatusMsg$ = "Game deleted."
                        ENDIF
                        GUI.POP_ID
                    NEXT i
                    GUI.END_TABLE
                ENDIF

                IF OpenGameEdit THEN
                    GUI.OPEN_POPUP("Edit game")
                    OpenGameEdit = FALSE
                ENDIF
                IF GUI.BEGIN_POPUP_MODAL("Edit game", TRUE) THEN
                    GUI.TEXT "No:       "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditGameNr = GUI.INPUT_INT("##egnr", EditGameNr)
                    GUI.TEXT "Name:     "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditGameName$ = GUI.INPUT("##egname", EditGameName$)
                    GUI.TEXT "1st pts:  "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditGameP1 = GUI.INPUT_INT("##egp1", EditGameP1)
                    GUI.TEXT "2nd pts:  "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditGameP2 = GUI.INPUT_INT("##egp2", EditGameP2)
                    GUI.TEXT "3rd pts:  "
                    GUI.SAME_LINE
                    GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                    EditGameP3 = GUI.INPUT_INT("##egp3", EditGameP3)
                    GUI.SEPARATOR
                    IF GUI.BUTTON("Save", 200, 0) THEN
                        SQL.EXEC(DB, "UPDATE games SET nr = " + STR$(EditGameNr) + ", name = '" + Esc$(EditGameName$) + "', p1 = " + STR$(EditGameP1) + ", p2 = " + STR$(EditGameP2) + ", p3 = " + STR$(EditGameP3) + " WHERE id = " + STR$(EditGameId))
                        StatusMsg$ = "Game updated: " + EditGameName$
                        GUI.CLOSE_CURRENT_POPUP
                    ENDIF
                    GUI.SAME_LINE
                    IF GUI.BUTTON("Cancel", 200, 0) THEN
                        GUI.CLOSE_CURRENT_POPUP
                    ENDIF
                    GUI.END_POPUP
                ENDIF

                GUI.END_TAB_ITEM
            ENDIF

            IF GUI.BEGIN_TAB_ITEM("Einstellungen") THEN
                GUI.SEPARATOR_TEXT "Event"
                GUI.TEXT "These fields go on every certificate."
                GUI.DUMMY 0, 10
                GUI.TEXT "Name:  "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                CompName$ = GUI.INPUT("##comp", CompName$)
                IF CompName$ <> CompSaved$ THEN
                    SQL.EXEC(DB, "INSERT OR REPLACE INTO settings(k, v) VALUES('comp', '" + Esc$(CompName$) + "')")
                    CompSaved$ = CompName$
                ENDIF
                GUI.TEXT "Date:  "
                GUI.SAME_LINE
                GUI.SET_NEXT_ITEM_WIDTH(FieldW)
                EventDate$ = GUI.INPUT("##date", EventDate$)
                IF EventDate$ <> DateSaved$ THEN
                    SQL.EXEC(DB, "INSERT OR REPLACE INTO settings(k, v) VALUES('date', '" + Esc$(EventDate$) + "')")
                    DateSaved$ = EventDate$
                ENDIF
                GUI.DUMMY 0, 10
                GUI.TEXT "F11 toggles fullscreen."
                GUI.END_TAB_ITEM
            ENDIF

            GUI.END_TAB_BAR
        ENDIF

        GUI.SEPARATOR
        GUI.TEXT "Status: " + StatusMsg$
    GUI.END

    SCREENFLIP
    SLEEP 16
LOOP WHILE Running = 1

SQL.CLOSE(DB)
