' coproc.jdb - local AI co-processor toolkit (CO_*) for coding agents.
'
' Load into the persistent MCP VM once, then drive via jdb_eval:
'   jdb_load  path="D:/usr/dev/cc/jdb/demos/ai/coproc.jdb"
'   jdb_eval  CO_INDEX("D:/usr/dev/cc/src")      ' build + save the index
'   jdb_eval  CO_SEARCH("where is X handled", 5) ' semantic search -> file:line
'
' Backed by AI.RAG_* (dense embeddings + HNSW + persistence). Retrieve-only
' (llm_id 0) - the calling agent is the reasoner. The embedder + RAG stay warm
' in the VM across calls; one load, many searches.

DIM CO_EID = 0
DIM CO_RAG = 0
DIM CO_REPO$ = ""
DIM CO_EMB_PATH$ = "D:/usr/dev/cc/models/nomic-embed-text-v1.5.Q4_K_M.gguf"

' Load the embedding model once (idempotent).
SUB CO_EMBEDDER()
	IF CO_EID = 0 THEN
		CO_EID = AI.LOAD_EMBEDDINGS(CO_EMB_PATH$, 2048, 99)
		PRINT "embedder loaded (id="; CO_EID; ")"
	ENDIF
ENDSUB

FUNC CO_IDX_PATH$(repo$)
	RETURN repo$ + "/.jdco_index.rag"
ENDFUNC

' Build (or rebuild) the index for a repo directory and persist it.
SUB CO_INDEX(repo$)
	CO_EMBEDDER()
	CO_RAG = AI.RAG_CREATE(0, 400, 40, CO_EID)
	DIM pats = ["*.cpp", "*.h", "*.jdb", "*.md"]
	DIM p
	FOR p = 0 TO LEN(pats) - 1
		DIM st = AI.RAG_ADD_DIR(CO_RAG, repo$, pats[p], 1)
		PRINT "  "; pats[p]; ": "; st{"files_added"}; " files"
	NEXT
	AI.RAG_BUILD_INDEX(CO_RAG, 16, 200)
	CO_REPO$ = repo$
	AI.RAG_SAVE(CO_RAG, CO_IDX_PATH$(repo$))
	DIM info = AI.RAG_INFO(CO_RAG)
	PRINT "TOTAL "; info{"chunks"}; " chunks indexed -> "; CO_IDX_PATH$(repo$)
ENDSUB

' Index a repo from a prebuilt file list - one absolute path per line.
' The calling AGENT produces the list (git ls-files respects .gitignore, so
' vendored/build dirs are excluded for free):
'   git -C <root> ls-files | grep -iE '\.(cpp|h|py|js|ts|go|rs|md|...)$' \
'     | sed 's|^|<root>/|' > <root>/.jdco_files.txt
' jdBasic does NOT shell out (OS.EXEC deadlocks in the MCP stdio server).
SUB CO_INDEX_FROM_LIST(root$, listfile$)
	CO_EMBEDDER()
	CO_RAG = AI.RAG_CREATE(0, 400, 40, CO_EID)
	DIM lines = SPLIT(TXTREADER$(listfile$), CHR$(10))
	DIM n = 0
	DIM fail = 0
	DIM i
	FOR i = 0 TO LEN(lines) - 1
		DIM f$ = TRIM$(lines[i])
		IF LEN(f$) > 0 THEN
			TRY
				AI.RAG_ADD_FILE(CO_RAG, f$)
				n = n + 1
			CATCH
				fail = fail + 1
			ENDTRY
		ENDIF
	NEXT
	AI.RAG_BUILD_INDEX(CO_RAG, 16, 200)
	CO_REPO$ = root$
	AI.RAG_SAVE(CO_RAG, CO_IDX_PATH$(root$))
	DIM info = AI.RAG_INFO(CO_RAG)
	PRINT n; " files indexed ("; fail; " skipped), "; info{"chunks"}; " chunks -> "; CO_IDX_PATH$(root$)
ENDSUB

' Load a previously-saved index for a repo.
SUB CO_OPEN(repo$)
	CO_EMBEDDER()
	TRY
		CO_RAG = AI.RAG_LOAD(CO_IDX_PATH$(repo$), 0, CO_EID)
		CO_REPO$ = repo$
		DIM info = AI.RAG_INFO(CO_RAG)
		PRINT "opened "; repo$; " ("; info{"chunks"}; " chunks)"
	CATCH
		PRINT "no index at "; CO_IDX_PATH$(repo$); " - run CO_INDEX first"
	ENDTRY
ENDSUB

' Semantic search -> formatted hits with file:line and a text preview.
SUB CO_SEARCH(query$, k)
	IF CO_RAG = 0 THEN
		PRINT "no index loaded - call CO_OPEN or CO_INDEX first"
		RETURN
	ENDIF
	DIM hits = AI.RAG_SEARCH(CO_RAG, query$, k)
	PRINT LEN(hits); " hits for: "; query$
	DIM i
	FOR i = 0 TO LEN(hits) - 1
		DIM h = hits[i]
		PRINT "[" ; h{"score"}; "] "; h{"source"}; ":"; h{"line_start"}; "-"; h{"line_end"}
		PRINT "    "; LEFT$(h{"text"}, 150)
	NEXT
ENDSUB

' ── Tier 1: bulk LLM offload (the calling agent stays the reasoner; the local
' model does the volume) ─────────────────────────────────────────────────────

DIM CO_LLM = 0
DIM CO_LLM_PATH$ = "D:/usr/dev/cc/models/qwen2.5-3b-instruct-q4_k_m.gguf"
DIM CO_MAX_CHARS = 9000   ' truncate file to fit the LLM context window

SUB CO_LLM_INIT()
	IF CO_LLM = 0 THEN CO_LLM = AI.LOAD_LLM(CO_LLM_PATH$, 4096, 99)
ENDSUB

FUNC CO_CLIP$(s$)
	IF LEN(s$) > CO_MAX_CHARS THEN RETURN LEFT$(s$, CO_MAX_CHARS)
	RETURN s$
ENDFUNC

' Summarize one file in a few terse lines - offload reading the whole file.
FUNC CO_DIGEST$(path$)
	CO_LLM_INIT()
	AI.CLEAR_HISTORY(CO_LLM)
	DIM p$ = "Summarize what this source file does in 2-4 terse lines (purpose + key functions/symbols). No preamble, no markdown." + CHR$(10) + "FILE: " + path$ + CHR$(10) + CO_CLIP$(TXTREADER$(path$)) + CHR$(10) + "/no_think"
	RETURN AI.CHAT(CO_LLM, p$)
ENDFUNC

SUB CO_DIGEST(path$)
	PRINT path$
	PRINT CO_DIGEST$(path$)
ENDSUB

' Structured extraction - grammar-constrained JSON (returns a parsed OBJECT,
' not a string). instruction$ says what to pull.
FUNC CO_EXTRACT(path$, instruction$)
	CO_LLM_INIT()
	AI.CLEAR_HISTORY(CO_LLM)
	DIM p$ = instruction$ + " Output JSON only, no prose." + CHR$(10) + CO_CLIP$(TXTREADER$(path$)) + CHR$(10) + "/no_think"
	RETURN AI.CHAT_JSON(CO_LLM, p$)
ENDFUNC

' One-label classification of a free-text item.
FUNC CO_CLASSIFY$(item$, labels$)
	CO_LLM_INIT()
	AI.CLEAR_HISTORY(CO_LLM)
	DIM p$ = "Classify the item into exactly ONE of these labels: " + labels$ + ". Reply with only the label, nothing else." + CHR$(10) + "ITEM: " + item$ + CHR$(10) + "/no_think"
	RETURN TRIM$(AI.CHAT(CO_LLM, p$))
ENDFUNC
