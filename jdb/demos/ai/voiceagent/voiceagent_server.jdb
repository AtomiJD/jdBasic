' voiceagent_server.jdb - TwiML dialog server for the voice assistant.
' Twilio connects a call to /voice; jdBasic serves the spoken turns: Say
' (Twilio TTS) -> Gather speech (Twilio STT) -> LLM -> reply -> loop.
'
' Prompts live in prompts.json and are extracted into plain string globals at
' boot - the request handlers must NEVER read the JSON map directly (reading a
' shared map object from a handler thread breaks Twilio's response). Each call's
' turns are stored in SQLite so the LLM gets conversation context.

DIM gPort = 5005
DIM gBind$ = "0.0.0.0"
DIM gPendingFile$ = "/tmp/va_pending.txt"
DIM gBrainUrl$ = "http://127.0.0.1:8082/v1/chat/completions"
DIM gPromptsPath$ = "prompts.json"
DIM gDbPath$ = "conversations.db"
DIM gHistoryWindow = 16
DIM gMaxTokens = 110

SUB logLine(msg$)
    PRINT DATE$() + " " + TIME$() + "  " + msg$
ENDSUB

FUNC xmlEsc$(s$)
    DIM r$ = REPLACE$(s$, "&", "&amp;")
    r$ = REPLACE$(r$, "<", "&lt;")
    r$ = REPLACE$(r$, ">", "&gt;")
    r$ = REPLACE$(r$, CHR$(34), "&quot;")
    RETURN r$
ENDFUNC

FUNC mkTwiml$(bodyXml$)
    DIM q$ = CHR$(34)
    RETURN "<?xml version=" + q$ + "1.0" + q$ + " encoding=" + q$ + "UTF-8" + q$ + "?>" + "<Response>" + bodyXml$ + "</Response>"
ENDFUNC

FUNC mkSay$(text$)
    RETURN "<Say voice=" + CHR$(34) + gVoice$ + CHR$(34) + ">" + xmlEsc$(text$) + "</Say>"
ENDFUNC

FUNC mkGather$(promptText$)
    DIM q$ = CHR$(34)
    RETURN "<Gather input=" + q$ + "speech" + q$ + " action=" + q$ + "/gather" + q$ + " method=" + q$ + "POST" + q$ + " language=" + q$ + gLang$ + q$ + " speechTimeout=" + q$ + "auto" + q$ + ">" + mkSay$(promptText$) + "</Gather>"
ENDFUNC

FUNC xmlResponse(body$)
    RETURN { "__http_status": 200, "__http_content_type": "text/xml", "__http_body": body$ }
ENDFUNC

FUNC sqlEsc$(s$)
    RETURN REPLACE$(s$, "'", "''")
ENDFUNC

FUNC loadHistory(callSid$)
    IF gDb = 0 OR callSid$ = "" THEN RETURN []
    RETURN SQL.QUERY(gDb, "SELECT role, content FROM turns WHERE call_sid='" + sqlEsc$(callSid$) + "' ORDER BY seq ASC")
ENDFUNC

SUB saveTurn(callSid$, seq, role$, content$)
    IF gDb = 0 OR callSid$ = "" THEN RETURN
    DIM ts$ = DATE$() + " " + TIME$()
    SQL.EXEC(gDb, "INSERT INTO turns(call_sid, seq, role, content, ts) VALUES ('" + sqlEsc$(callSid$) + "', " + STR$(seq) + ", '" + sqlEsc$(role$) + "', '" + sqlEsc$(content$) + "', '" + sqlEsc$(ts$) + "')")
ENDSUB

FUNC brainReply$(callSid$, userText$)
    DIM t$ = TRIM$(userText$)
    IF t$ = "" THEN RETURN gNotUnderstood$

    DIM hist = loadHistory(callSid$)
    DIM nHist = LEN(hist)

    DIM msgs = []
    DIM sysm = {}
    sysm{"role"} = "system"
    sysm{"content"} = gSystem$
    msgs = APPEND(msgs, sysm)

    DIM start = nHist - gHistoryWindow
    IF start < 0 THEN start = 0
    DIM i
    FOR i = start TO nHist - 1
        DIM hm = {}
        hm{"role"} = hist[i]{"role"}
        hm{"content"} = hist[i]{"content"}
        msgs = APPEND(msgs, hm)
    NEXT i

    DIM usrm = {}
    usrm{"role"} = "user"
    usrm{"content"} = t$
    msgs = APPEND(msgs, usrm)

    DIM req = {}
    req{"messages"} = msgs
    req{"temperature"} = 0.5
    req{"max_tokens"} = gMaxTokens
    DIM body$ = JSON.STRINGIFY$(req)

    HTTP.SETTIMEOUT(12)
    DIM reply$ = gBrainError$
    DIM t0 = TICK()
    TRY
        DIM resp$ = HTTP.POST$(gBrainUrl$, body$, "application/json")
        DIM o = JSON.PARSE$(resp$)
        DIM ch = o{"choices"}
        IF TYPEOF(ch) <> "NONE" THEN
            DIM c$ = ch[0]{"message"}{"content"}
            IF TYPEOF(c$) <> "NONE" THEN
                IF TRIM$(c$) <> "" THEN reply$ = TRIM$(c$)
            ENDIF
        ENDIF
    CATCH
        reply$ = gBrainError$
    ENDTRY
    logLine("  brain " + STR$(INT(TICK() - t0)) + "ms  ctx=" + STR$(nHist) + " turns  reply=" + reply$)

    saveTurn(callSid$, nHist, "user", t$)
    saveTurn(callSid$, nHist + 1, "assistant", reply$)
    RETURN reply$
ENDFUNC

FUNC isBye(userText$)
    DIM t$ = LCASE$(userText$)
    IF INSTR(t$, "tschuess") >= 0 THEN RETURN TRUE
    IF INSTR(t$, "tschuss") >= 0 THEN RETURN TRUE
    IF INSTR(t$, "wiederhoeren") >= 0 THEN RETURN TRUE
    IF INSTR(t$, "wiederhoren") >= 0 THEN RETURN TRUE
    IF INSTR(t$, "beenden") >= 0 THEN RETURN TRUE
    IF INSTR(t$, "auf wiedersehen") >= 0 THEN RETURN TRUE
    RETURN FALSE
ENDFUNC

FUNC paramVal$(params, key$)
    IF TYPEOF(params{key$}) = "NONE" THEN RETURN ""
    RETURN params{key$}
ENDFUNC

' HandleVoice must stay string-only: reading a map here (request{"PARAMS"} or
' any global map) makes Twilio's very first fetch return no body (status 0),
' though the same access works from curl and works in HandleGather. Keep the
' greeting turn free of map lookups (cpp-httplib already logs the raw request).
FUNC HandleVoice(request)
    DIM msg$ = gGreeting$
    IF FILE.EXISTS(gPendingFile$) THEN
        DIM p$ = TRIM$(TXTREADER$(gPendingFile$))
        IF p$ <> "" THEN
            msg$ = p$
            TXTWRITER gPendingFile$, ""
        ENDIF
    ENDIF
    DIM body$ = mkSay$(msg$) + mkGather$(gGatherPrompt$) + mkSay$(gNoInput$)
    RETURN xmlResponse(mkTwiml$(body$))
ENDFUNC

FUNC HandleGather(request)
    DIM params = request{"PARAMS"}
    DIM speech$ = paramVal$(params, "SpeechResult")
    DIM callSid$ = paramVal$(params, "CallSid")
    logLine("/gather call=" + callSid$ + "  heard=" + speech$)
    IF isBye(speech$) THEN
        RETURN xmlResponse(mkTwiml$(mkSay$(gGoodbye$) + "<Hangup/>"))
    ENDIF
    DIM reply$ = brainReply$(callSid$, speech$)
    DIM body$ = mkSay$(reply$) + mkGather$(gGatherReprompt$) + mkSay$(gNoInput$)
    RETURN xmlResponse(mkTwiml$(body$))
ENDFUNC

FUNC HandleHealth(request)
    RETURN { "status": "ok", "service": "voiceagent", "port": gPort }
ENDFUNC

' Boot: load prompts once, extract into plain string globals (never read the
' map from a handler), then open the conversation store.
DIM gLocale$ = GETENV$("VA_LOCALE")
IF gLocale$ = "" THEN gLocale$ = "de"
DIM gRaw$ = TXTREADER$(gPromptsPath$)
DIM gAll = JSON.PARSE$(gRaw$)
DIM gLocs = gAll{"locales"}
DIM gPr = gLocs{gLocale$}
IF TYPEOF(gPr) = "NONE" THEN gPr = gLocs{gAll{"default_locale"}}
DIM gLang$ = gPr{"twilio_lang"}
DIM gVoice$ = gPr{"voice"}
DIM gGreeting$ = gPr{"greeting"}
DIM gGatherPrompt$ = gPr{"gather_prompt"}
DIM gGatherReprompt$ = gPr{"gather_reprompt"}
DIM gNoInput$ = gPr{"no_input"}
DIM gGoodbye$ = gPr{"goodbye"}
DIM gNotUnderstood$ = gPr{"not_understood"}
DIM gBrainError$ = gPr{"brain_error"}
DIM gSystem$ = gPr{"system"}

DIM gDb = SQL.OPEN(gDbPath$)
IF gDb = 0 THEN
    logLine("WARN: no SQLite (" + SQL.ERRMSG$(0) + ") - running without memory")
ELSE
    SQL.EXEC(gDb, "CREATE TABLE IF NOT EXISTS turns (call_sid TEXT, seq INTEGER, role TEXT, content TEXT, ts TEXT)")
    SQL.EXEC(gDb, "CREATE INDEX IF NOT EXISTS idx_turns_call ON turns(call_sid, seq)")
ENDIF

HTTP.SERVER.ON_POST("/voice", "HANDLEVOICE")
HTTP.SERVER.ON_GET("/voice", "HANDLEVOICE")
HTTP.SERVER.ON_POST("/gather", "HANDLEGATHER")
HTTP.SERVER.ON_GET("/gather", "HANDLEGATHER")
HTTP.SERVER.ON_GET("/health", "HANDLEHEALTH")

IF HTTP.SERVER.START(gPort, gBind$) THEN
    logLine("Voice agent on " + gBind$ + ":" + STR$(gPort) + " locale=" + gLocale$ + " voice=" + gVoice$)
    logLine("  brain=" + gBrainUrl$ + "  memory=" + gDbPath$)
    HTTP.SERVER.WAIT()
    HTTP.SERVER.STOP()
ELSE
    logLine("FEHLER: HTTP-Server-Start fehlgeschlagen auf Port " + STR$(gPort))
ENDIF
