' oxygen_synth.jdb - play the synth from an Oxygen 61 (or any MIDI keyboard).
' Usage: jdBasic oxygen_synth.jdb [seconds] [fast] [panel]   (default 300 s)
'   fast    takes the audio device alone (MON.SYNTH exclusive): under 10 ms
'           from key to speaker instead of 20, other programs go silent
'   panel   opens a window with every parameter, the knob map, the
'           modulation matrix and a scope, fullscreen (F toggles, Esc closes)
'
' Left of the split: mono legato saw bass, one octave down.
' Right of the split: the lead, a patch from oxygen_patches.json (plus the
' ones saved in oxygen_patches_user.json). Velocity opens its filter, the
' mod wheel adds vibrato. On the DAW port:
'   knobs 1-8    lead cutoff, resonance, attack, release; bass cutoff,
'                resonance; lead detune, reverb
'   faders 1-3   lead / bass / drum level
'   fader 9      morph from the lead patch to the next one
'   MODE < >     previous / next lead patch
'   PLAY         start the loop (pads play the kit live, on channel 10)
'   REC          record pads and keys into the loop, with a click; again stops
'   STOP         stop the loop; STOP when stopped clears it
'   LOOP + key   that key becomes the new split
' MIDI clock goes out to the keyboard (Start with PLAY, Stop with STOP); a
' clock coming in on the keyboard port sets the tempo and starts the loop.
' The lead keys can run an arpeggiator on the loop clock, play a chord per
' key and lock to a scale (panel "Arp and chords", or APPLY_ARP from live
' code). The looper records the keys, not the arp steps.
' Sampler (panel): Record takes a note from the audio input (capture in
' oxygen61.json picks the device), finds its root and plays it on the lead
' keys through the patch's filter and envelope; Loop sustains it, Grains
' plays it granular with knob 7 moving through the take.
' Voice (panel): the lead keys sing a phonetic lyric, a syllable a key, or
' say the recorded take, or the microphone live (Vocode mic), through a
' vocoder at the pitch of each key.
' Live code: oxygen_live.jdb next to this file runs again each time it is
' saved, while the keyboard plays on (see oxygen_live_example.jdb).
' The pads reach the drums only in DAW mode (DAW button lit); in preset mode
' they send keys 36-43 on the keyboard port and play the bass.

IMPORT SYNTHPATCH

DIM run_secs = 300
DIM fast = FALSE
DIM panel = FALSE
FOR EACH a$ IN OS.ARGS()[IOTA(LEN(OS.ARGS()) - 1) ]
    IF LCASE$(a$) = "fast" THEN
        fast = TRUE
    ELSEIF LCASE$(a$) = "panel" THEN
        panel = TRUE
    ELSEIF VAL(a$) > 0 THEN
        run_secs = VAL(a$)
    ENDIF
NEXT a$

DIM here$ = PATH.DIRNAME$(OS.ARGS()[0])
DIM cfg = JSON.PARSE(TXTREADER$(here$ + "/oxygen61.json"))
DIM user_bank$ = here$ + "/oxygen_patches_user.json"
DIM bank = SYNTHPATCH.LOAD_BANK(here$ + "/oxygen_patches.json")
DIM n_shipped = LEN(bank)
IF FILE.EXISTS(user_bank$) THEN
    FOR EACH up IN SYNTHPATCH.LOAD_BANK(user_bank$)
        bank = APPEND(bank, up)
    NEXT up
ENDIF

FUNC PORT_INDEX(names, wanted$)
    FOR i = 0 TO LEN(names) - 1
        IF STARTSWITH(names[i], wanted$) THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

DIM ins = MIDI.PORTS(){"in"}
DIM main_idx = PORT_INDEX(ins, cfg{"ports"}{"main"})
DIM daw_idx = PORT_INDEX(ins, cfg{"ports"}{"daw"})
IF main_idx < 0 THEN
    PRINT "Keyboard port not found: " + cfg{"ports"}{"main"}
    PRINT ins
    END
ENDIF

DIM out_ms = 0
IF fast THEN
    SOUND.INIT "PULL"
    out_ms = MON.SYNTH(128, -1, TRUE)
    IF out_ms < 0 THEN
        PRINT "Exclusive device refused, falling back to the shared one"
        out_ms = MON.SYNTH(128)
    ENDIF
    PRINT "Output buffer: " + STR$(ROUND(out_ms, 1)) + " ms"
ELSE
    SOUND.INIT
ENDIF
SOUND.VOICE 0, "SAW", 0.005, 0.25, 0.6, 0.15
SOUND.FILTER 0, 900, 0.3, "LP"
SOUND.GLIDE 0, 60
SOUND.GAIN 0, 0.7

DIM split_key = 60
DIM status$ = ""
' ImGui scale: the largest whole factor at which the 980 x 860 panel fits
' the primary display (2 on 4K, 1 on 1920 x 1080). SCREEN multiplies fonts
' and spacing by it; the widths given to GUI calls are raw pixels and are
' multiplied here.
CONST PANEL_W = 980
CONST PANEL_H = 860
FUNC PANEL_SCALE()
    DIM w = 1920
    DIM h = 1080
    FOR EACH d IN GFX.DISPLAYS()
        IF d{"primary"} THEN
            w = d{"w"}
            h = d{"h"}
        ENDIF
    NEXT d
    RETURN MAX([1, INT(MIN([w / PANEL_W, h / PANEL_H]))])
ENDFUNC
DIM ui = 1
IF panel THEN ui = PANEL_SCALE()

SUB SAY(msg$)
    status$ = msg$
    PRINT msg$
ENDSUB

' ---- arp and chords on the lead zone, run by the engine on the loop clock ----
DIM arp_modes$ = ["off", "up", "down", "updown", "downup", "random", "played"]
DIM arp_rates$ = ["1/8", "1/8T", "1/16", "1/16T", "1/32"]
DIM chord_names$ = ["off", "maj", "min", "triad", "seventh", "ninth", "power", "oct", "sus4", "maj7", "min7"]
DIM scale_roots$ = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
DIM scale_modes$ = ["MAJOR", "MINOR", "DORIAN", "PHRYGIAN", "LYDIAN", "MIXOLYDIAN", "PENT_MAJ", "PENT_MIN", "BLUES"]
DIM arp_i = 0
DIM arp_rate_i = 2
DIM arp_oct = 1
DIM arp_gate = 0.5
DIM arp_latch = FALSE
DIM chord_i = 0
DIM scale_lock = FALSE
DIM scale_root_i = 0
DIM scale_mode_i = 0

FUNC LEAD_ZONE_OPTS(arp$, rate$, octaves, gate, latch, chord$, lock)
    RETURN {"vel_cutoff": 2, "mod_vibrato": 0.4, "arp": arp$, "arp_rate": rate$, "arp_octaves": octaves, "arp_gate": gate, "arp_latch": latch, "chord": chord$, "scale": lock}
ENDFUNC

' Lead zone is zone 1 (bass 0, drums 2); held keys and a running arp stay
SUB APPLY_ARP()
    SOUND.SCALE 1, scale_roots$[scale_root_i] + "3", scale_modes$[scale_mode_i]
    SOUND.ZONESET 1, LEAD_ZONE_OPTS(arp_modes$[arp_i], arp_rates$[arp_rate_i], arp_oct, arp_gate, arp_latch, chord_names$[chord_i], scale_lock)
ENDSUB

SUB APPLY_ZONES()
    SOUND.SCALE 1, scale_roots$[scale_root_i] + "3", scale_modes$[scale_mode_i]
    SOUND.ZONE -1
    SOUND.ZONE 0, 0, split_key - 1, 1, -12, {"legato": TRUE}
    SOUND.ZONE 1, split_key, 127, 1, 0, LEAD_ZONE_OPTS(arp_modes$[arp_i], arp_rates$[arp_rate_i], arp_oct, arp_gate, arp_latch, chord_names$[chord_i], scale_lock)
    SOUND.ZONE DRUMS, 0, 127, 10
ENDSUB

SUB SET_SPLIT(key)
    split_key = key
    APPLY_ZONES()
    SAY("Split at key " + STR$(split_key))
ENDSUB

' ---- drums: the pads play kit track DRUMS live, the looper records them ----
CONST DRUMS = 2
CONST CLICK = 3
CONST STEPS = 16
' pad notes 36-43 (bottom row 36-39) and the kit sound each one plays
DIM pad_notes = [36, 37, 38, 39, 40, 41, 42, 43]
DIM pad_names$ = ["bd", "sd", "hh", "oh", "cp", "rim", "lt", "cr"]
DIM n_rows = LEN(pad_names$)
SOUND.KIT DRUMS, "SYNTH"
SOUND.GAIN DRUMS, 0.9
SOUND.KIT CLICK, "SYNTH"
SOUND.GAIN CLICK, 0.35
FOR i = 0 TO n_rows - 1
    SOUND.PADMAP DRUMS, pad_notes[i], pad_names$[i]
NEXT i
SET_SPLIT(60)

DIM loop_bars = 1
DIM n_steps = STEPS
DIM grid = IOTA(n_rows * n_steps, 0) * 0
DIM bpm = 110
DIM looping = FALSE
DIM recording = FALSE
DIM view_bar = 0
DIM follow = TRUE
DIM clock_h = -1
DIM ext_running = FALSE
SOUND.BPM bpm

' Recorded keyboard notes, one entry per note: track, sounding note, first
' step, length in steps, and the take it came from (for undo)
DIM mel_trk = []
DIM mel_note = []
DIM mel_start = []
DIM mel_len = []
DIM mel_take = []
DIM take_no = 0
' step position where each held key went down while recording, -1 when up
DIM key_start = IOTA(128, 0) * 0 - 1
DIM note_names$ = ["c", "c#", "d", "d#", "e", "f", "f#", "g", "g#", "a", "a#", "b"]

' Where in the loop the music is that is leaving the speaker, in steps
FUNC HEARD_STEP()
    DIM heard = SOUND.CYCLE() - (out_ms / 1000 + 0.01) * bpm / 240
    RETURN (heard - FLOOR(heard / loop_bars) * loop_bars) * STEPS
ENDFUNC

FUNC SLOWED$(steps$)
    IF loop_bars = 1 THEN RETURN steps$
    RETURN "[" + steps$ + "]/" + STR$(loop_bars)
ENDFUNC

' The drum loop in mini-notation: per step a rest, a sound, or [a,b] stacked
FUNC LOOP_PATTERN$()
    DIM steps$ = ""
    FOR s = 0 TO n_steps - 1
        DIM hits$ = ""
        DIM n_hits = 0
        FOR r = 0 TO n_rows - 1
            IF grid[r * n_steps + s] THEN
                hits$ = hits$ + IIF(n_hits > 0, ",", "") + pad_names$[r]
                n_hits = n_hits + 1
            ENDIF
        NEXT r
        IF n_hits = 0 THEN hits$ = "~"
        IF n_hits > 1 THEN hits$ = "[" + hits$ + "]"
        steps$ = steps$ + IIF(s > 0, " ", "") + hits$
    NEXT s
    RETURN SLOWED$(steps$)
ENDFUNC

' The notes of one track as stacked lanes; in each lane a note lasts its
' length (name@len) and the gaps are weighted rests, so a lane spans the loop
FUNC MELODY_PATTERN$(trk)
    DIM idx = []
    FOR i = 0 TO LEN(mel_trk) - 1
        IF mel_trk[i] = trk THEN idx = APPEND(idx, i)
    NEXT i
    IF LEN(idx) = 0 THEN RETURN "~"
    DIM order = idx[GRADE(mel_start[idx])]
    DIM lanes$ = []
    DIM lane_end = []
    FOR EACH i IN order
        DIM k = -1
        FOR l = 0 TO LEN(lane_end) - 1
            IF k < 0 ANDALSO lane_end[l] <= mel_start[i] THEN k = l
        NEXT l
        IF k < 0 THEN
            lanes$ = APPEND(lanes$, "")
            lane_end = APPEND(lane_end, 0)
            k = LEN(lane_end) - 1
        ENDIF
        DIM gap = mel_start[i] - lane_end[k]
        IF gap > 0 THEN lanes$[k] = lanes$[k] + " ~@" + STR$(gap)
        DIM nn = mel_note[i]
        lanes$[k] = lanes$[k] + " " + note_names$[nn MOD 12] + STR$(INT(nn / 12) - 1) + "@" + STR$(mel_len[i])
        lane_end[k] = mel_start[i] + mel_len[i]
    NEXT i
    FOR l = 0 TO LEN(lane_end) - 1
        IF lane_end[l] < n_steps THEN lanes$[l] = lanes$[l] + " ~@" + STR$(n_steps - lane_end[l])
    NEXT l
    RETURN "legato(1, " + SLOWED$(JOIN(lanes$, ",")) + ")"
ENDFUNC

SUB SEND_LOOP()
    IF looping THEN
        SOUND.SEQ DRUMS, LOOP_PATTERN$(), "VOICE"
        SOUND.SEQ 0, MELODY_PATTERN$(0), "VOICE"
        SOUND.SEQ 1, MELODY_PATTERN$(1), "VOICE"
    ELSE
        SOUND.SEQ DRUMS, "~", "VOICE"
        SOUND.SEQ 0, "~", "VOICE"
        SOUND.SEQ 1, "~", "VOICE"
    ENDIF
    SOUND.SEQ CLICK, IIF(recording, "cl ~ ~ ~ rim ~ ~ ~ rim ~ ~ ~ rim ~ ~ ~", "~"), "VOICE"
ENDSUB

SUB CLEAR_LOOP()
    grid = grid * 0
    mel_trk = []
    mel_note = []
    mel_start = []
    mel_len = []
    mel_take = []
    SEND_LOOP()
ENDSUB

' Longer loops repeat what is there; shorter ones keep the first bars
SUB SET_BARS(bars)
    IF bars = loop_bars THEN RETURN
    DIM new_steps = bars * STEPS
    DIM new_grid = IOTA(n_rows * new_steps, 0) * 0
    FOR r = 0 TO n_rows - 1
        FOR s = 0 TO new_steps - 1
            new_grid[r * new_steps + s] = grid[r * n_steps + (s MOD n_steps)]
        NEXT s
    NEXT r
    DIM n_mel = LEN(mel_trk)
    FOR i = 0 TO n_mel - 1
        FOR c = 1 TO bars / loop_bars - 1
            mel_trk = APPEND(mel_trk, mel_trk[i])
            mel_note = APPEND(mel_note, mel_note[i])
            mel_start = APPEND(mel_start, mel_start[i] + c * n_steps)
            mel_len = APPEND(mel_len, mel_len[i])
            mel_take = APPEND(mel_take, mel_take[i])
        NEXT c
    NEXT i
    IF bars < loop_bars THEN
        DIM keep = []
        FOR i = 0 TO n_mel - 1
            IF mel_start[i] < new_steps THEN
                keep = APPEND(keep, i)
                mel_len[i] = MIN([mel_len[i], new_steps - mel_start[i]])
            ENDIF
        NEXT i
        mel_trk = mel_trk[keep]
        mel_note = mel_note[keep]
        mel_start = mel_start[keep]
        mel_len = mel_len[keep]
        mel_take = mel_take[keep]
    ENDIF
    grid = new_grid
    loop_bars = bars
    n_steps = new_steps
    SEND_LOOP()
    SAY("Loop length " + STR$(bars) + IIF(bars = 1, " bar", " bars"))
ENDSUB

SUB LOOP_PLAY()
    looping = TRUE
    SEND_LOOP()
    IF clock_h >= 0 THEN MIDI.CLOCK(clock_h, "START")
    SAY("Loop playing at " + STR$(bpm) + " BPM")
ENDSUB

SUB LOOP_STOP()
    IF NOT looping ANDALSO NOT recording THEN
        CLEAR_LOOP()
        SAY("Loop cleared")
    ELSE
        CLOSE_HELD()
        SAY("Loop stopped (STOP again clears it)")
    ENDIF
    looping = FALSE
    recording = FALSE
    SEND_LOOP()
    IF clock_h >= 0 THEN MIDI.CLOCK(clock_h, "STOP")
ENDSUB

SUB LOOP_REC()
    IF recording THEN CLOSE_HELD()
    recording = NOT recording
    IF recording THEN take_no = take_no + 1
    looping = TRUE
    SEND_LOOP()
    SAY(IIF(recording, "Recording pads and keys into the loop", "Recording off, loop plays on"))
ENDSUB

SUB UNDO_TAKE()
    DIM keep = []
    FOR i = 0 TO LEN(mel_take) - 1
        IF mel_take[i] <> take_no THEN keep = APPEND(keep, i)
    NEXT i
    mel_trk = mel_trk[keep]
    mel_note = mel_note[keep]
    mel_start = mel_start[keep]
    mel_len = mel_len[keep]
    mel_take = mel_take[keep]
    IF take_no > 0 THEN take_no = take_no - 1
    SEND_LOOP()
    SAY("Last take of keys removed")
ENDSUB

' A pad hit lands on the nearest 16th of the loop that is being heard
SUB RECORD_HIT(note)
    DIM row = -1
    FOR i = 0 TO n_rows - 1
        IF pad_notes[i] = note THEN row = i
    NEXT i
    IF row < 0 THEN RETURN
    DIM s = INT(HEARD_STEP() + 0.5) MOD n_steps
    IF grid[row * n_steps + s] = 0 THEN
        grid[row * n_steps + s] = 1
        SEND_LOOP()
    ENDIF
ENDSUB

SUB KEY_DOWN(note)
    IF recording THEN key_start[note] = HEARD_STEP()
ENDSUB

' A key starts on the nearest 16th and lasts at least one; a note that would
' run past the loop end stops there
SUB KEY_UP(note)
    DIM from = key_start[note]
    IF from < 0 THEN RETURN
    key_start[note] = -1
    DIM held = HEARD_STEP() - from
    IF held < 0 THEN held = held + n_steps
    DIM s0 = INT(from + 0.5) MOD n_steps
    DIM ln = MIN([MAX([1, INT(held + 0.5)]), n_steps - s0])
    DIM trk = IIF(note < split_key, 0, 1)
    IF note + IIF(trk = 0, -12, 0) < 12 THEN RETURN
    mel_trk = APPEND(mel_trk, trk)
    mel_note = APPEND(mel_note, note + IIF(trk = 0, -12, 0))
    mel_start = APPEND(mel_start, s0)
    mel_len = APPEND(mel_len, ln)
    mel_take = APPEND(mel_take, take_no)
    SEND_LOOP()
ENDSUB

SUB CLOSE_HELD()
    FOR n = 0 TO 127
        IF key_start[n] >= 0 THEN KEY_UP(n)
    NEXT n
ENDSUB

' What the hardware moves: [label, cc index list key, index, track, param, lo, hi, curve]
DIM knob = cfg{"knobs"}{"daw"}{"cc"}
DIM fader = cfg{"faders"}{"daw"}{"cc"}
DIM hw_map = [["Knob 1", "knob", 0, 1, "CUTOFF", 150, 9000, "EXP"], ["Knob 2", "knob", 1, 1, "RESONANCE", 0, 0.9, "LIN"], ["Knob 3", "knob", 2, 1, "ATTACK", 0.002, 1.5, "EXP"], ["Knob 4", "knob", 3, 1, "RELEASE", 0.02, 3, "EXP"], ["Knob 5", "knob", 4, 0, "CUTOFF", 80, 4000, "EXP"], ["Knob 6", "knob", 5, 0, "RESONANCE", 0, 0.9, "LIN"], ["Knob 7", "knob", 6, 1, "DETUNE", 0, 0.5, "LIN"], ["Knob 8", "knob", 7, 1, "REVERB", 0, 0.8, "LIN"], ["Fader 1", "fader", 0, 1, "GAIN", 0, 1, "LIN"], ["Fader 2", "fader", 1, 0, "GAIN", 0, 1, "LIN"], ["Fader 3", "fader", 2, DRUMS, "GAIN", 0, 1, "LIN"]]

' Mapping anew also restarts the pickup, so a knob waits for the new sound
' Knob 7 scans the wavetable when the lead patch has one, else it detunes
' ---- sampler: a recorded take on the lead keys, through the lead patch ----
' The take is recorded from the audio input (WAV.RECSTART), trimmed, its
' root found with SOUND.PITCHOF, and played chromatically on track 1 in
' place of the patch's oscillator; filter, envelope and sends stay the
' patch's. oxygen_take.wav next to this file keeps the last take.
DIM can_record = OS.FEATURE("MINIAUDIO") ANDALSO OS.FEATURE("FX")
DIM take_path$ = here$ + "/oxygen_take.wav"
DIM take_buf = [0.0, 0.0]
DIM take_rate = 44100
DIM take_secs = 0
DIM take_root = 60.0
DIM sampler_on = FALSE
DIM take_recording = FALSE
DIM take_loop = FALSE
DIM take_loop_a = 0.2
DIM take_loop_b = 0.8
DIM grain_on = FALSE
DIM grain_ms = 80
DIM grain_dens = 40
DIM grain_spray = 0.03

' Loop region and grains, without loading the take again
SUB SAMPLER_SETTINGS()
    IF NOT sampler_on ORELSE take_secs <= 0 THEN RETURN
    IF take_loop ANDALSO take_loop_b > take_loop_a + 0.02 THEN
        SOUND.SAMPLELOOP 1, take_loop_a * take_secs, take_loop_b * take_secs, 0.03
    ELSE
        SOUND.SAMPLELOOP 1, 0, 0
    ENDIF
    SOUND.GRAIN 1, IIF(grain_on, grain_ms, 0), grain_dens, grain_spray
ENDSUB

SUB APPLY_SAMPLER()
    IF NOT sampler_on ORELSE take_secs <= 0 THEN RETURN
    DIM secs = SOUND.SAMPLE(1, take_buf, take_root, FALSE, take_rate)
    SAMPLER_SETTINGS()
ENDSUB

' A take from samples at a rate: trimmed to where it is louder than 2 % of
' its peak, scaled to a peak of 0.9, its root measured
SUB SET_TAKE(raw, rate)
    DIM pk = MAX(ABS(raw))
    IF pk < 0.001 THEN
        SAY("The take is silent: check the input")
        RETURN
    ENDIF
    DIM loud = ABS(raw) > pk * 0.02
    DIM first = MAX([0, INDEXOF(loud, TRUE) - INT(rate * 0.005)])
    DIM last = LEN(raw) - 1 - INDEXOF(REVERSE(loud), TRUE)
    IF last <= first + 64 THEN
        SAY("The take is too short")
        RETURN
    ENDIF
    take_buf = raw[IOTA(last - first + 1, 0) + first] * (0.9 / pk)
    take_rate = rate
    take_secs = LEN(take_buf) / rate
    DIM hz = SOUND.PITCHOF(take_buf, rate)
    IF hz > 0 THEN
        take_root = 69 + 12 * LOG(hz / 440) / LOG(2)
        SAY("Take: " + STR$(ROUND(take_secs, 2)) + " s, root " + UCASE$(note_names$[INT(take_root + 0.5) MOD 12]) + STR$(INT((take_root + 0.5) / 12) - 1) + IIF(ABS(take_root - INT(take_root + 0.5)) > 0.1, " (" + STR$(ROUND(hz, 1)) + " Hz)", ""))
    ELSE
        take_root = 60
        SAY("Take: " + STR$(ROUND(take_secs, 2)) + " s, no clear pitch: root set to C4")
    ENDIF
    IF voc_on THEN
        VOCODER_APPLY()
    ELSE
        sampler_on = TRUE
        APPLY_SAMPLER()
        MAP_KNOBS()
    ENDIF
ENDSUB

SUB TAKE_RECORD()
    IF NOT can_record THEN
        SAY("Recording needs a build with MINIAUDIO and FX")
        RETURN
    ENDIF
    IF take_recording THEN
        DIM got = WAV.RECSTOP()
        take_recording = FALSE
        IF TYPEOF(got) = "NONE" THEN
            SAY("The recording came back empty")
            RETURN
        ENDIF
        DIM raw = got{"samples"}
        IF got{"channels"} > 1 THEN raw = raw[IOTA(got{"frames"}, 0) * got{"channels"}]
        SET_TAKE(raw, got{"rate"})
        IF take_secs > 0 THEN
            DIM ok = WAV.WRITE(take_path$, take_buf, take_rate, 1)
        ENDIF
        RETURN
    ENDIF
    DIM opts = {"channels": 1, "seconds": 30}
    IF MAP.EXISTS(cfg, "capture") THEN opts{"device"} = cfg{"capture"}
    IF WAV.RECSTART(opts) THEN
        take_recording = TRUE
        SAY("Recording the input: play the note, then Stop (30 s at most)")
    ELSE
        SAY("No audio input opened (set capture in oxygen61.json to an index of MON.DEVICES())")
    ENDIF
ENDSUB

SUB TAKE_LOAD()
    IF NOT can_record THEN
        SAY("Loading a take needs a build with FX")
        RETURN
    ENDIF
    IF NOT FILE.EXISTS(take_path$) THEN
        SAY("No take saved yet: record one")
        RETURN
    ENDIF
    DIM w = WAV.READ(take_path$)
    IF TYPEOF(w) = "NONE" THEN
        SAY("Cannot read " + take_path$)
        RETURN
    ENDIF
    DIM raw = w{"samples"}
    IF w{"channels"} > 1 THEN raw = raw[IOTA(w{"frames"}, 0) * w{"channels"}]
    SET_TAKE(raw, w{"rate"})
ENDSUB

SUB SAMPLER_OFF()
    sampler_on = FALSE
    SOUND.GRAIN 1, 0
    SELECT_PATCH(cur)
ENDSUB

' ---- voice: the lead keys sing a lyric, or say the take through a vocoder ----
' The lyric is phonetic (SOUND.SING spelling): each key sings the next
' syllable; it starts over when it runs out.
DIM lyric$ = "hel lo neon wer ld"
DIM sing_on = FALSE
DIM sing_base = 0
DIM sung_lyric$ = ""
DIM voc_on = FALSE
DIM voc_loop = TRUE
DIM can_mic = OS.FEATURE("MINIAUDIO")
DIM voc_mic = FALSE
DIM mic_ms = -1

' The lyric being sung: a text SOUND.SING cannot spell (a digit, a comma)
' is reported, and the keys hum until the lyric reads again
SUB SING_START()
    SOUND.SING 1, ""
    sung_lyric$ = ""
    IF NOT sing_on ORELSE TRIM$(lyric$) = "" THEN RETURN
    TRY
        SOUND.SING 1, lyric$
        sung_lyric$ = lyric$
        sing_base = SOUND.SUNG(1)
    CATCH
        SAY("Lyric: " + ERRMSG$)
    ENDTRY
ENDSUB

' Queues the lyric again before it runs out, so the keys never just hum
SUB VOICE_TICK()
    IF NOT sing_on ORELSE sung_lyric$ = "" THEN RETURN
    DIM n_syl = LEN(SPLIT(TRIM$(sung_lyric$), " "))
    IF n_syl > 0 ANDALSO SOUND.SUNG(1) - sing_base >= n_syl - 1 THEN
        SOUND.SING 1, sung_lyric$
        sing_base = sing_base + n_syl
    ENDIF
ENDSUB

' The microphone as the live input of the synth (capture in oxygen61.json)
SUB MIC_INPUT(want)
    IF want THEN
        DIM dev = -1
        IF MAP.EXISTS(cfg, "capture") THEN dev = cfg{"capture"}
        mic_ms = MON.SYNTHIN(128, dev)
        IF mic_ms < 0 THEN SAY("No audio input opened for the vocoder (set capture in oxygen61.json to an index of MON.DEVICES())")
    ELSE
        mic_ms = -1
        DIM shut = MON.SYNTHIN(0)
    ENDIF
ENDSUB

SUB VOCODER_APPLY()
    IF voc_mic ANDALSO mic_ms >= 0 THEN
        DIM secs = SOUND.VOCODER(1, "INPUT", {"bands": 20})
    ELSEIF voc_on ANDALSO take_secs > 0 THEN
        DIM secs = SOUND.VOCODER(1, take_buf, {"rate": take_rate, "loop": voc_loop, "bands": 20})
    ELSE
        DIM secs = SOUND.VOCODER(1)
    ENDIF
ENDSUB


SUB MAP_KNOBS()
    IF sampler_on ANDALSO grain_on THEN
        hw_map[6] = ["Knob 7", "knob", 6, 1, "GRAINPOS", 0, 1, "LIN"]
    ELSEIF UCASE$("" + bank[cur]{"wave"}) = "WAVETABLE" THEN
        hw_map[6] = ["Knob 7", "knob", 6, 1, "WTPOS", 0, 1, "LIN"]
    ELSE
        hw_map[6] = ["Knob 7", "knob", 6, 1, "DETUNE", 0, 0.5, "LIN"]
    ENDIF
    SOUND.CCMAP -1
    FOR EACH m IN hw_map
        DIM cc = knob[m[2]]
        IF m[1] = "fader" THEN cc = fader[m[2]]
        SOUND.CCMAP cc, m[3], m[4], m[5], m[6], m[7]
    NEXT m
ENDSUB

DIM cur = 0
DIM morph = 0

SUB SELECT_PATCH(i)
    cur = i
    morph = 0
    SYNTHPATCH.APPLY 1, bank[i]
    APPLY_SAMPLER()
    MAP_KNOBS()
    SAY("Lead patch " + STR$(i + 1) + "/" + STR$(LEN(bank)) + ": " + bank[i]{"name"} + "   (fader 9 morphs to " + bank[(i + 1) MOD LEN(bank)]{"name"} + ")")
ENDSUB
SELECT_PATCH(0)

SUB SAVE_LEAD()
    DIM mine = SYNTHPATCH.CAPTURE(1, bank[cur])
    mine{"name"} = "user_" + STR$(LEN(bank) - n_shipped + 1)
    bank = APPEND(bank, mine)
    SYNTHPATCH.SAVE_BANK user_bank$, bank[IOTA(LEN(bank) - n_shipped, 0) + n_shipped]
    SAY("Saved " + mine{"name"} + " to " + user_bank$)
ENDSUB

' ---- modulation matrix rows of the lead: source, target, amount ----
DIM mm_sources$ = ["OFF", "LFO1", "LFO2", "MODWHEEL", "AFTERTOUCH", "VELOCITY", "NOTE", "RANDOM"]
DIM mm_targets$ = ["CUTOFF", "RESONANCE", "GAIN", "PAN", "DETUNE", "PITCH", "REVERB", "DELAY", "FENV", "ATTACK", "RELEASE"]
DIM mm_src = [1, 4, 0, 0]
DIM mm_dst = [0, 5, 0, 0]
DIM mm_amt = [0.0, 0.0, 0.0, 0.0]
DIM lfo_shapes$ = ["SINE", "TRI", "SAW", "ISAW", "SQUARE", "RAND", "PERLIN"]
DIM lfo_rate = [1.0, 0.25]
DIM lfo_shape = [0, 1]

SUB APPLY_MATRIX()
    DIM n = SOUND.MATRIX("OFF")
    FOR r = 0 TO 3
        IF mm_src[r] > 0 ANDALSO mm_amt[r] <> 0 THEN n = SOUND.MATRIX(mm_sources$[mm_src[r]], 1, mm_targets$[mm_dst[r]], mm_amt[r])
    NEXT r
    SOUND.MODLFO 1, lfo_rate[0], lfo_shapes$[lfo_shape[0]]
    SOUND.MODLFO 2, lfo_rate[1], lfo_shapes$[lfo_shape[1]]
ENDSUB
APPLY_MATRIX()

DIM main_h = MIDI.OPEN_IN(main_idx)
PRINT "Route " + ins[main_idx] + ": " + STR$(MIDI.ROUTE(main_h))
DIM daw_h = -1
IF daw_idx >= 0 THEN
    daw_h = MIDI.OPEN_IN(daw_idx)
    PRINT "Controls " + ins[daw_idx] + ": " + STR$(MIDI.ROUTE(daw_h, "ALL", 10))
    PRINT "Drums on the pads need DAW mode (press DAW until it lights)"
ENDIF

' MIDI clock out to the keyboard (its arpeggiator can sync to it): ticks all
' the time, Start with PLAY on the next bar line, Stop with STOP
DIM clock_idx = PORT_INDEX(MIDI.PORTS(){"out"}, cfg{"ports"}{"main"})
IF clock_idx >= 0 THEN
    clock_h = MIDI.OPEN_OUT(clock_idx)
    IF clock_h >= 0 THEN PRINT "Clock out " + MIDI.PORTS(){"out"}[clock_idx] + ": " + STR$(MIDI.CLOCK(clock_h, TRUE))
ENDIF

' A clock arriving on the keyboard port sets the tempo; its Start and Stop
' start and stop the loop
SUB FOLLOW_CLOCK()
    DIM ck = MIDI.CLOCKIN(main_h)
    IF ck{"bpm"} > 0 ANDALSO ABS(ck{"bpm"} - bpm) >= 0.5 THEN
        bpm = ROUND(ck{"bpm"})
        SOUND.BPM bpm
    ENDIF
    IF ck{"running"} <> ext_running THEN
        ext_running = ck{"running"}
        IF ext_running THEN
            SOUND.SEEK FLOOR(SOUND.CYCLE() / loop_bars + 1) * loop_bars
            SOUND.AT
            LOOP_PLAY()
        ELSEIF looping ORELSE recording THEN
            LOOP_STOP()
        ENDIF
    ENDIF
ENDSUB


' ---- live code: oxygen_live.jdb runs again each time it is saved ----
DIM live$ = here$ + "/oxygen_live.jdb"
IF NOT FILE.EXISTS(live$) THEN FILE.COPY(here$ + "/oxygen_live_example.jdb", live$)
DIM live_sig$ = ""
DIM live_t = 0

' One drum row from a step string ("x" or "X" a hit), repeated over the loop
SUB DRUM_ROW(name$, steps$)
    DIM row = -1
    FOR i = 0 TO n_rows - 1
        IF pad_names$[i] = name$ THEN row = i
    NEXT i
    IF row < 0 ORELSE LEN(steps$) = 0 THEN RETURN
    DIM chars = -steps$
    FOR s = 0 TO n_steps - 1
        grid[row * n_steps + s] = IIF(UCASE$(chars[s MOD LEN(chars)]) = "X", 1, 0)
    NEXT s
    SEND_LOOP()
ENDSUB

SUB LIVE_CHECK()
    IF TICK() - live_t < 250 THEN RETURN
    live_t = TICK()
    IF NOT FILE.EXISTS(live$) THEN RETURN
    DIM st = FILE.STAT(live$)
    DIM sig$ = STR$(st{"mtime"}) + "/" + STR$(st{"size"})
    IF sig$ = live_sig$ THEN RETURN
    live_sig$ = sig$
    TRY
        EXECUTE TXTREADER$(live$)
        SAY("Live code applied (" + PATH.BASENAME$(live$) + ")")
    CATCH
        SAY("Live code error: " + ERRMSG$)
    ENDTRY
ENDSUB

DIM tp = cfg{"transport"}{"daw_port_cc"}
DIM mode_left = cfg{"mode_buttons"}{"left_cc"}
DIM mode_right = cfg{"mode_buttons"}{"right_cc"}
DIM preset_cc = cfg{"mode_report"}{"preset_mode_cc"}
DIM daw_cc = cfg{"mode_report"}{"daw_mode_cc"}
DIM morph_cc = fader[8]
DIM learning = FALSE
DIM seen = 0
DIM lat$ = "-"

SUB SET_MORPH(x)
    morph = x
    SYNTHPATCH.MORPH 1, bank[cur], bank[(cur + 1) MOD LEN(bank)], x
ENDSUB

SUB START_LEARN()
    learning = TRUE
    seen = SOUND.LASTNOTE(){"count"}
    SAY("Press the key for the new split")
ENDSUB

SUB HANDLE_MIDI()
    FOR EACH k IN MIDI.POLL(main_h)
        IF LEN(k) >= 3 ANDALSO k[0] = 144 ANDALSO k[2] > 0 THEN
            KEY_DOWN(k[1])
        ELSEIF LEN(k) >= 3 ANDALSO (k[0] = 128 ORELSE k[0] = 144) THEN
            KEY_UP(k[1])
        ENDIF
    NEXT k
    IF daw_h >= 0 THEN
        FOR EACH m IN MIDI.POLL(daw_h)
            IF m[0] = 176 THEN
                IF m[1] = morph_cc THEN
                    SET_MORPH(m[2] / 127)
                ELSEIF m[2] = 127 ANDALSO m[1] = mode_right THEN
                    SELECT_PATCH((cur + 1) MOD LEN(bank))
                ELSEIF m[2] = 127 ANDALSO m[1] = mode_left THEN
                    SELECT_PATCH((cur + LEN(bank) - 1) MOD LEN(bank))
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"play"} THEN
                    LOOP_PLAY()
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"stop"} THEN
                    LOOP_STOP()
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"rec"} THEN
                    LOOP_REC()
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"loop"} THEN
                    START_LEARN()
                ELSEIF m[2] = 127 ANDALSO m[1] = daw_cc THEN
                    SAY("DAW mode: the pads play the drums")
                ELSEIF m[2] = 127 ANDALSO m[1] = preset_cc THEN
                    SAY("Preset mode: the pads play keys 36-43, press DAW for the drums")
                ENDIF
            ELSEIF m[0] = 144 ANDALSO m[2] > 0 ANDALSO recording THEN
                RECORD_HIT(m[1])
            ENDIF
        NEXT m
    ENDIF
    IF learning THEN
        DIM ln = SOUND.LASTNOTE()
        IF ln{"count"} > seen THEN
            IF ln{"channel"} = 1 THEN
                learning = FALSE
                SET_SPLIT(ln{"note"})
            ELSE
                seen = ln{"count"}
            ENDIF
        ENDIF
    ENDIF
    FOLLOW_CLOCK()
ENDSUB

SUB TAKE_STATS(to_console)
    DIM stats = SOUND.MIDISTATS()
    IF stats{"events"} > 0 THEN
        lat$ = STR$(ROUND(stats{"total_ms"}, 1)) + " ms (max " + STR$(ROUND(stats{"total_max_ms"}, 1)) + ")"
        IF to_console THEN PRINT STR$(stats{"events"}) + " events  key->speaker " + lat$
    ENDIF
ENDSUB

' ---- panel ----
' A parameter slider; times and cutoff on a log2 scale
SUB PARAM_SLIDER(label$, t, p$, lo, hi, logscale)
    DIM v = SOUND.PARAM(t, p$)
    GUI.SET_NEXT_ITEM_WIDTH 260 * ui
    IF logscale THEN
        DIM lv = LOG(MAX([v, lo])) / LOG(2)
        DIM nv = GUI.SLIDER(label$ + " " + STR$(IIF(v >= 100, ROUND(v, 0), ROUND(v, 3))) + "##" + STR$(t) + p$, lv, LOG(lo) / LOG(2), LOG(hi) / LOG(2))
        IF nv <> lv THEN v = SOUND.PARAM(t, p$, 2 ^ nv)
    ELSE
        DIM nl = GUI.SLIDER(label$ + "##" + STR$(t) + p$, v, lo, hi)
        IF nl <> v THEN v = SOUND.PARAM(t, p$, nl)
    ENDIF
ENDSUB

SUB METER(label$, v, bipolar)
    DIM f = v
    IF bipolar THEN f = (v + 1) / 2
    GUI.TEXT LEFT$(label$ + "            ", 11)
    GUI.SAME_LINE
    GUI.SET_NEXT_ITEM_WIDTH 200 * ui
    GUI.PROGRESS MAX([0, MIN([1, f])]), STR$(ROUND(v, 2))
ENDSUB

SUB DRAW_PANEL()
    DIM dw = GUI.DISPLAY_WIDTH()
    DIM dh = GUI.DISPLAY_HEIGHT()
    GUI.BEGIN "Oxygen Synth##" + STR$(INT(dw)) + "x" + STR$(INT(dh)), 0, 0, dw, dh, GUI.FLAG("NOTITLEBAR") + GUI.FLAG("NORESIZE") + GUI.FLAG("NOMOVE") + GUI.FLAG("NOCOLLAPSE") + GUI.FLAG("NOSAVEDSETTINGS")
    GUI.SEPARATOR_TEXT("Lead patch")
    IF GUI.BUTTON("<") THEN SELECT_PATCH((cur + LEN(bank) - 1) MOD LEN(bank))
    GUI.SAME_LINE
    GUI.TEXT STR$(cur + 1) + "/" + STR$(LEN(bank)) + "  " + bank[cur]{"name"}
    GUI.SAME_LINE
    IF GUI.BUTTON(">") THEN SELECT_PATCH((cur + 1) MOD LEN(bank))
    GUI.SAME_LINE
    IF GUI.BUTTON("Save as user patch") THEN SAVE_LEAD()
    GUI.SAME_LINE
    IF GUI.BUTTON("Learn split (" + STR$(split_key) + ")") THEN START_LEARN()
    GUI.SET_NEXT_ITEM_WIDTH 260 * ui
    DIM nm = GUI.SLIDER("Morph to " + bank[(cur + 1) MOD LEN(bank)]{"name"} + "##morph", morph, 0, 1)
    IF nm <> morph THEN SET_MORPH(nm)
    GUI.TEXT "Key to speaker: " + lat$ + IIF(fast, "   output " + STR$(ROUND(out_ms, 1)) + " ms exclusive", "")
    GUI.TEXT status$

    IF GUI.BEGIN_TABLE("cols", 2) THEN
        GUI.TABLE_NEXT_ROW
        GUI.TABLE_NEXT_COLUMN
        GUI.SEPARATOR_TEXT("Lead (track 1)")
        PARAM_SLIDER("Cutoff", 1, "CUTOFF", 40, 18000, TRUE)
        PARAM_SLIDER("Resonance", 1, "RESONANCE", 0, 1, FALSE)
        PARAM_SLIDER("Filter env", 1, "FENV", 0, 5, FALSE)
        PARAM_SLIDER("Attack", 1, "ATTACK", 0.001, 3, TRUE)
        PARAM_SLIDER("Decay", 1, "DECAY", 0.01, 3, TRUE)
        PARAM_SLIDER("Sustain", 1, "SUSTAIN", 0, 1, FALSE)
        PARAM_SLIDER("Release", 1, "RELEASE", 0.01, 5, TRUE)
        PARAM_SLIDER("Detune", 1, "DETUNE", 0, 0.6, FALSE)
        PARAM_SLIDER("Wave scan", 1, "WTPOS", 0, 1, FALSE)
        PARAM_SLIDER("FM", 1, "FM", 0, 3, FALSE)
        PARAM_SLIDER("Reverb", 1, "REVERB", 0, 1, FALSE)
        PARAM_SLIDER("Delay", 1, "DELAY", 0, 1, FALSE)
        PARAM_SLIDER("Level", 1, "GAIN", 0, 1, FALSE)
        GUI.SEPARATOR_TEXT("Bass (track 0)")
        PARAM_SLIDER("Cutoff", 0, "CUTOFF", 40, 8000, TRUE)
        PARAM_SLIDER("Resonance", 0, "RESONANCE", 0, 1, FALSE)
        PARAM_SLIDER("Release", 0, "RELEASE", 0.01, 2, TRUE)
        PARAM_SLIDER("Level", 0, "GAIN", 0, 1, FALSE)
        GUI.SEPARATOR_TEXT("Arp and chords (lead keys)")
        DIM zone_was$ = STR$(arp_i) + STR$(arp_rate_i) + STR$(arp_oct) + STR$(arp_gate) + STR$(arp_latch) + STR$(chord_i) + STR$(scale_lock) + STR$(scale_root_i) + STR$(scale_mode_i)
        GUI.SET_NEXT_ITEM_WIDTH 100 * ui
        arp_i = GUI.COMBO("Arp##arp", arp_i, arp_modes$)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 80 * ui
        arp_rate_i = GUI.COMBO("##arprate", arp_rate_i, arp_rates$)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 70 * ui
        arp_oct = GUI.COMBO("Oct##arpoct", arp_oct - 1, ["1", "2", "3", "4"]) + 1
        GUI.SAME_LINE
        arp_latch = GUI.CHECKBOX("Latch##arplatch", arp_latch)
        GUI.SET_NEXT_ITEM_WIDTH 260 * ui
        arp_gate = GUI.SLIDER("Gate##arpgate", arp_gate, 0.05, 1)
        GUI.SET_NEXT_ITEM_WIDTH 100 * ui
        chord_i = GUI.COMBO("Chord##chord", chord_i, chord_names$)
        GUI.SAME_LINE
        scale_lock = GUI.CHECKBOX("Scale##scalelock", scale_lock)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 60 * ui
        scale_root_i = GUI.COMBO("##scaleroot", scale_root_i, scale_roots$)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 110 * ui
        scale_mode_i = GUI.COMBO("##scalemode", scale_mode_i, scale_modes$)
        DIM zone_now$ = STR$(arp_i) + STR$(arp_rate_i) + STR$(arp_oct) + STR$(arp_gate) + STR$(arp_latch) + STR$(chord_i) + STR$(scale_lock) + STR$(scale_root_i) + STR$(scale_mode_i)
        IF zone_now$ <> zone_was$ THEN APPLY_ARP()
        GUI.SEPARATOR_TEXT("Sampler (lead keys)")
        IF GUI.BUTTON(IIF(take_recording, "Stop rec##take", "Record##take")) THEN TAKE_RECORD()
        GUI.SAME_LINE
        IF GUI.BUTTON("Load last##take") THEN TAKE_LOAD()
        GUI.SAME_LINE
        DIM s_was = sampler_on
        sampler_on = GUI.CHECKBOX("On##sampler", sampler_on) ANDALSO take_secs > 0
        IF sampler_on <> s_was THEN
            IF sampler_on THEN
                APPLY_SAMPLER()
                MAP_KNOBS()
            ELSE
                SAMPLER_OFF()
            ENDIF
        ENDIF
        IF take_secs > 0 THEN
            GUI.SAME_LINE
            GUI.TEXT STR$(ROUND(take_secs, 2)) + " s, root " + UCASE$(note_names$[INT(take_root + 0.5) MOD 12]) + STR$(INT((take_root + 0.5) / 12) - 1)
            GUI.SAME_LINE
            IF GUI.BUTTON("-##root") THEN
                take_root = take_root - 1
                APPLY_SAMPLER()
            ENDIF
            GUI.SAME_LINE
            IF GUI.BUTTON("+##root") THEN
                take_root = take_root + 1
                APPLY_SAMPLER()
            ENDIF
        ENDIF
        DIM smp_was$ = STR$(take_loop) + STR$(take_loop_a) + STR$(take_loop_b) + STR$(grain_on) + STR$(grain_ms) + STR$(grain_dens) + STR$(grain_spray)
        take_loop = GUI.CHECKBOX("Loop##takeloop", take_loop)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 120 * ui
        take_loop_a = GUI.SLIDER("##loopa", take_loop_a, 0, 0.95)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 120 * ui
        take_loop_b = GUI.SLIDER("##loopb", take_loop_b, 0.05, 1)
        grain_on = GUI.CHECKBOX("Grains##grain", grain_on)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 90 * ui
        grain_ms = GUI.SLIDER("ms##grainms", grain_ms, 10, 400)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 90 * ui
        grain_dens = GUI.SLIDER("/s##graind", grain_dens, 5, 120)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 70 * ui
        grain_spray = GUI.SLIDER("spray##grains", grain_spray, 0, 0.3)
        IF grain_on THEN PARAM_SLIDER("Grain pos", 1, "GRAINPOS", 0, 1, FALSE)
        DIM smp_now$ = STR$(take_loop) + STR$(take_loop_a) + STR$(take_loop_b) + STR$(grain_on) + STR$(grain_ms) + STR$(grain_dens) + STR$(grain_spray)
        IF smp_now$ <> smp_was$ ANDALSO sampler_on THEN
            SAMPLER_SETTINGS()
            MAP_KNOBS()
        ENDIF

        GUI.SEPARATOR_TEXT("Voice (lead keys)")
        DIM v_was$ = STR$(sing_on) + lyric$
        sing_on = GUI.CHECKBOX("Sing##sing", sing_on)
        GUI.SAME_LINE
        GUI.SET_NEXT_ITEM_WIDTH 300 * ui
        lyric$ = GUI.INPUT$("##lyric", lyric$)
        IF STR$(sing_on) + lyric$ <> v_was$ THEN SING_START()
        DIM was_on = voc_on
        DIM was_mic = voc_mic
        DIM voc_was$ = STR$(voc_on) + STR$(voc_loop) + STR$(voc_mic)
        voc_on = GUI.CHECKBOX("Vocode take##voc", voc_on) ANDALSO take_secs > 0
        GUI.SAME_LINE
        voc_loop = GUI.CHECKBOX("Loop##vocloop", voc_loop)
        IF can_mic THEN
            GUI.SAME_LINE
            voc_mic = GUI.CHECKBOX("Vocode mic##vocmic", voc_mic)
        ENDIF
        IF voc_mic ANDALSO mic_ms >= 0 THEN
            DIM ist = SOUND.INPUT()
            GUI.TEXT "Mic " + STR$(ROUND(mic_ms + ist{"ms"}, 1)) + " ms behind, " + STR$(ist{"underruns"}) + " dropouts"
        ELSEIF take_secs <= 0 THEN
            GUI.SAME_LINE
            GUI.TEXT "(record some words in the sampler first)"
        ENDIF
        IF STR$(voc_on) + STR$(voc_loop) + STR$(voc_mic) <> voc_was$ THEN
            IF voc_mic ANDALSO NOT was_mic THEN voc_on = FALSE
            IF voc_on ANDALSO NOT was_on THEN voc_mic = FALSE
            IF voc_mic <> was_mic THEN MIC_INPUT(voc_mic)
            IF (voc_on ORELSE voc_mic) ANDALSO sampler_on THEN SAMPLER_OFF()
            VOCODER_APPLY()
        ENDIF


        GUI.TABLE_NEXT_COLUMN
        GUI.SEPARATOR_TEXT("Modulation matrix (lead)")
        DIM changed = FALSE
        FOR r = 0 TO 3
            GUI.PUSH_ID r
            GUI.SET_NEXT_ITEM_WIDTH 110 * ui
            DIM ns = GUI.COMBO("##src", mm_src[r], mm_sources$)
            GUI.SAME_LINE
            GUI.SET_NEXT_ITEM_WIDTH 110 * ui
            DIM nd = GUI.COMBO("##dst", mm_dst[r], mm_targets$)
            GUI.SAME_LINE
            GUI.SET_NEXT_ITEM_WIDTH 150 * ui
            DIM na = GUI.SLIDER("##amt", mm_amt[r], -4, 4)
            IF ns <> mm_src[r] ORELSE nd <> mm_dst[r] ORELSE na <> mm_amt[r] THEN changed = TRUE
            mm_src[r] = ns
            mm_dst[r] = nd
            mm_amt[r] = na
            GUI.POP_ID
        NEXT r
        GUI.TEXT "amount: octaves for cutoff and times, semitones for pitch"
        FOR l = 0 TO 1
            GUI.PUSH_ID 10 + l
            GUI.SET_NEXT_ITEM_WIDTH 150 * ui
            DIM nr = GUI.SLIDER("LFO" + STR$(l + 1) + " Hz", lfo_rate[l], 0.05, 12)
            GUI.SAME_LINE
            GUI.SET_NEXT_ITEM_WIDTH 100 * ui
            DIM nsh = GUI.COMBO("##shape", lfo_shape[l], lfo_shapes$)
            IF nr <> lfo_rate[l] ORELSE nsh <> lfo_shape[l] THEN changed = TRUE
            lfo_rate[l] = nr
            lfo_shape[l] = nsh
            GUI.POP_ID
        NEXT l
        IF changed THEN APPLY_MATRIX()
        METER("LFO1", SOUND.MODSRC("LFO1"), TRUE)
        METER("LFO2", SOUND.MODSRC("LFO2"), TRUE)
        METER("Mod wheel", SOUND.MODSRC("MODWHEEL"), FALSE)
        METER("Aftertouch", SOUND.MODSRC("AFTERTOUCH"), FALSE)
        METER("Velocity", SOUND.MODSRC("VELOCITY"), FALSE)
        METER("Note", SOUND.MODSRC("NOTE"), TRUE)
        METER("Random", SOUND.MODSRC("RANDOM"), TRUE)

        GUI.SEPARATOR_TEXT("Hardware map")
        FOR EACH m IN hw_map
            GUI.TEXT m[0] + "  ->  " + ["bass ", "lead ", "drums "][m[3]] + LCASE$(m[4])
        NEXT m
        GUI.TEXT "Fader 9  ->  morph       MODE < >  ->  patch"
        GUI.TEXT "PLAY STOP REC  ->  loop (pads and keys)    LOOP + key  ->  split"
        GUI.TEXT "Pads  ->  bd sd hh oh (bottom row), cp rim lt cr (top row)"
        GUI.END_TABLE
    ENDIF

    GUI.SEPARATOR_TEXT("Loop (pads on channel 10, keys of bass and lead)")
    IF GUI.BUTTON(IIF(looping, "Playing", "Play")) THEN LOOP_PLAY()
    GUI.SAME_LINE
    IF GUI.BUTTON("Stop") THEN LOOP_STOP()
    GUI.SAME_LINE
    IF GUI.BUTTON(IIF(recording, "Recording", "Rec")) THEN LOOP_REC()
    GUI.SAME_LINE
    IF GUI.BUTTON("Clear") THEN CLEAR_LOOP()
    GUI.SAME_LINE
    IF GUI.BUTTON("Undo keys") THEN UNDO_TAKE()
    GUI.SAME_LINE
    GUI.SET_NEXT_ITEM_WIDTH 200 * ui
    DIM nb = INT(GUI.SLIDER("BPM", bpm, 60, 180))
    IF nb <> bpm THEN
        bpm = nb
        SOUND.BPM bpm
    ENDIF
    GUI.TEXT "Bars"
    FOR EACH b IN [1, 2, 4, 8]
        GUI.SAME_LINE
        IF GUI.BUTTON(IIF(b = loop_bars, "[" + STR$(b) + "]", " " + STR$(b) + " ") + "###bars" + STR$(b)) THEN SET_BARS(b)
    NEXT b
    DIM play_step = INT(HEARD_STEP())
    IF follow ANDALSO looping THEN view_bar = INT(play_step / STEPS)
    view_bar = view_bar MOD loop_bars
    GUI.SAME_LINE
    IF GUI.BUTTON("<##bar") THEN
        view_bar = (view_bar + loop_bars - 1) MOD loop_bars
        follow = FALSE
    ENDIF
    GUI.SAME_LINE
    GUI.TEXT "bar " + STR$(view_bar + 1) + "/" + STR$(loop_bars)
    GUI.SAME_LINE
    IF GUI.BUTTON(">##bar") THEN
        view_bar = (view_bar + 1) MOD loop_bars
        follow = FALSE
    ENDIF
    GUI.SAME_LINE
    follow = GUI.CHECKBOX("Follow", follow)
    DIM n_lead = 0
    FOR EACH t IN mel_trk
        IF t = 1 THEN n_lead = n_lead + 1
    NEXT t
    GUI.SAME_LINE
    GUI.TEXT "   keys: " + STR$(n_lead) + " lead, " + STR$(LEN(mel_trk) - n_lead) + " bass notes"
    DIM edited = FALSE
    FOR r = 0 TO n_rows - 1
        GUI.TEXT LEFT$(pad_names$[r] + "    ", 4)
        FOR s = 0 TO STEPS - 1
            DIM cell = r * n_steps + view_bar * STEPS + s
            GUI.SAME_LINE
            GUI.PUSH_ID r * STEPS + s
            DIM was = grid[cell]
            DIM lbl$ = IIF(looping ANDALSO view_bar * STEPS + s = play_step, ">", "") + "###cell"
            DIM now_on = GUI.CHECKBOX(lbl$, was)
            IF now_on <> was THEN
                grid[cell] = IIF(now_on, 1, 0)
                edited = TRUE
            ENDIF
            GUI.POP_ID
        NEXT s
    NEXT r
    IF edited THEN SEND_LOOP()

    GUI.SEPARATOR_TEXT("Output")
    GUI.PLOT_LINES "##scope", SOUND.GET_WAVE(), "", -1.0, 1.0
    GUI.END
ENDSUB

DIM t0 = TICK()
DIM t_stats = t0
TAKE_STATS(FALSE)
IF panel THEN
    SCREEN PANEL_W, PANEL_H, "jdBasic Oxygen Synth", ui
    PRINT "Panel scale " + STR$(ui)
    TOGGLE_FULLSCREEN
    DIM key$ = ""
    DO
        CLS
        HANDLE_MIDI()
        LIVE_CHECK()
        VOICE_TICK()
        DRAW_PANEL()
        SCREENFLIP
        IF TICK() - t_stats >= 1000 THEN
            t_stats = TICK()
            TAKE_STATS(FALSE)
        ENDIF
        key$ = INKEY$()
        IF UCASE$(key$) = "F" THEN TOGGLE_FULLSCREEN
    LOOP UNTIL key$ = CHR$(27) ORELSE TICK() - t0 >= run_secs * 1000
ELSE
    DO WHILE TICK() - t0 < run_secs * 1000
        HANDLE_MIDI()
        LIVE_CHECK()
        VOICE_TICK()
        IF TICK() - t_stats >= 2000 THEN
            t_stats = TICK()
            TAKE_STATS(TRUE)
        ENDIF
        SLEEP 10
    LOOP
ENDIF

IF clock_h >= 0 THEN MIDI.CLOCK(clock_h, FALSE)
IF clock_h >= 0 THEN MIDI.CLOSE(clock_h)
MIDI.CLOSE(main_h)
IF daw_h >= 0 THEN MIDI.CLOSE(daw_h)
IF mic_ms >= 0 THEN MIC_INPUT(FALSE)
IF fast THEN MON.SYNTH(0)
SOUND.SHUTDOWN
