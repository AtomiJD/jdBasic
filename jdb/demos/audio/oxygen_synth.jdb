' oxygen_synth.jdb - play the synth from an Oxygen 61 (or any MIDI keyboard).
' Usage: jdBasic oxygen_synth.jdb [seconds]   (default 300)
' Left of middle C: saw bass one octave down. From middle C up: detuned lead.
' Knob 1 / knob 2 (DAW port) open the lead / bass filter. Latency every 2 s.

DIM run_secs = 300
IF LEN(OS.ARGS()) > 1 THEN run_secs = VAL(OS.ARGS()[1])

DIM cfg = JSON.PARSE$(TXTREADER$(PATH.DIRNAME$(OS.ARGS()[0]) + "/oxygen61.json"))

FUNC PORT_INDEX(names, wanted$)
    FOR i = 0 TO LEN(names) - 1
        IF STARTSWITH(names[i], wanted$) THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

DIM ins = MIDI.PORTS(){"in"}
DIM main_idx = PORT_INDEX(ins, cfg{"ports"}{"main"})
DIM daw_idx = PORT_INDEX(ins, cfg{"ports"}{"daw"})
IF main_idx < 0 THEN
    PRINT "Keyboard port not found: " + cfg{"ports"}{"main"}
    PRINT ins
    END
ENDIF

SOUND.INIT
SOUND.VOICE 0, "SAW", 0.005, 0.25, 0.6, 0.15
SOUND.FILTER 0, 900, 0.3, "LP"
SOUND.GAIN 0, 0.7
SOUND.VOICE 1, "SAW", 0.01, 0.3, 0.7, 0.35
SOUND.UNISON(1, 3, 0.12, 0.6)
SOUND.FILTER 1, 2500, 0.2, "LP"
SOUND.GAIN 1, 0.5
SOUND.REVERBSEND 1, 0.25

SOUND.ZONE 0, 0, 59, 0, -12
SOUND.ZONE 1, 60, 127

DIM main_h = MIDI.OPEN_IN(main_idx)
PRINT "Route " + ins[main_idx] + ": " + STR$(MIDI.ROUTE(main_h))
DIM daw_h = -1
IF daw_idx >= 0 THEN daw_h = MIDI.OPEN_IN(daw_idx)

DIM knob_cc = cfg{"knobs"}{"daw"}{"cc"}
DIM t0 = TICK()
DIM t_stats = t0
DIM stats = SOUND.MIDISTATS()
PRINT "Play. Knob 1 = lead filter, knob 2 = bass filter."
DO WHILE TICK() - t0 < run_secs * 1000
    MIDI.POLL(main_h)
    IF daw_h >= 0 THEN
        FOR EACH m IN MIDI.POLL(daw_h)
            IF m[0] = 176 ANDALSO m[1] = knob_cc[0] THEN SOUND.FILTER 1, 200 * 2 ^ (m[2] / 18), 0.2, "LP"
            IF m[0] = 176 ANDALSO m[1] = knob_cc[1] THEN SOUND.FILTER 0, 100 * 2 ^ (m[2] / 20), 0.3, "LP"
        NEXT m
    ENDIF
    IF TICK() - t_stats >= 2000 THEN
        t_stats = TICK()
        stats = SOUND.MIDISTATS()
        IF stats{"events"} > 0 THEN
            PRINT STR$(stats{"events"}) + " events  key->speaker " + STR$(ROUND(stats{"total_ms"}, 1)) + " ms (max " + STR$(ROUND(stats{"total_max_ms"}, 1)) + ")  queue " + STR$(ROUND(stats{"wait_ms"}, 2)) + " ms  in-buffer " + STR$(ROUND(stats{"offset_ms"}, 1)) + " ms  output " + STR$(ROUND(stats{"output_ms"}, 1)) + " ms"
        ENDIF
    ENDIF
    SLEEP 20
LOOP

MIDI.CLOSE(main_h)
IF daw_h >= 0 THEN MIDI.CLOSE(daw_h)
SOUND.SHUTDOWN
