' oxygen_synth.jdb - play the synth from an Oxygen 61 (or any MIDI keyboard).
' Usage: jdBasic oxygen_synth.jdb [seconds] [fast] [panel]   (default 300 s)
'   fast    takes the audio device alone (MON.SYNTH exclusive): under 10 ms
'           from key to speaker instead of 20, other programs go silent
'   panel   opens a window with every parameter, the knob map, the
'           modulation matrix and a scope, fullscreen (F toggles, Esc closes)
'
' Left of the split: mono legato saw bass, one octave down.
' Right of the split: the lead, a patch from oxygen_patches.json (plus the
' ones saved in oxygen_patches_user.json). Velocity opens its filter, the
' mod wheel adds vibrato. On the DAW port:
'   knobs 1-8    lead cutoff, resonance, attack, release; bass cutoff,
'                resonance; lead detune, reverb
'   faders 1-2   lead / bass level
'   fader 9      morph from the lead patch to the next one
'   MODE < >     previous / next lead patch
'   PLAY         start the drum loop (pads play the kit live, on channel 10)
'   REC          record the pads into the loop, with a click; again stops
'   STOP         stop the loop; STOP when stopped clears it
'   LOOP + key   that key becomes the new split
' The pads reach the drums only in DAW mode (DAW button lit); in preset mode
' they send keys 36-43 on the keyboard port and play the bass.

IMPORT SYNTHPATCH

DIM run_secs = 300
DIM fast = FALSE
DIM panel = FALSE
FOR EACH a$ IN OS.ARGS()[IOTA(LEN(OS.ARGS()) - 1) ]
    IF LCASE$(a$) = "fast" THEN
        fast = TRUE
    ELSEIF LCASE$(a$) = "panel" THEN
        panel = TRUE
    ELSEIF VAL(a$) > 0 THEN
        run_secs = VAL(a$)
    ENDIF
NEXT a$

DIM here$ = PATH.DIRNAME$(OS.ARGS()[0])
DIM cfg = JSON.PARSE(TXTREADER$(here$ + "/oxygen61.json"))
DIM user_bank$ = here$ + "/oxygen_patches_user.json"
DIM bank = SYNTHPATCH.LOAD_BANK(here$ + "/oxygen_patches.json")
DIM n_shipped = LEN(bank)
IF FILE.EXISTS(user_bank$) THEN
    FOR EACH up IN SYNTHPATCH.LOAD_BANK(user_bank$)
        bank = APPEND(bank, up)
    NEXT up
ENDIF

FUNC PORT_INDEX(names, wanted$)
    FOR i = 0 TO LEN(names) - 1
        IF STARTSWITH(names[i], wanted$) THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

DIM ins = MIDI.PORTS(){"in"}
DIM main_idx = PORT_INDEX(ins, cfg{"ports"}{"main"})
DIM daw_idx = PORT_INDEX(ins, cfg{"ports"}{"daw"})
IF main_idx < 0 THEN
    PRINT "Keyboard port not found: " + cfg{"ports"}{"main"}
    PRINT ins
    END
ENDIF

DIM out_ms = 0
IF fast THEN
    SOUND.INIT "PULL"
    out_ms = MON.SYNTH(128, -1, TRUE)
    IF out_ms < 0 THEN
        PRINT "Exclusive device refused, falling back to the shared one"
        out_ms = MON.SYNTH(128)
    ENDIF
    PRINT "Output buffer: " + STR$(ROUND(out_ms, 1)) + " ms"
ELSE
    SOUND.INIT
ENDIF
SOUND.VOICE 0, "SAW", 0.005, 0.25, 0.6, 0.15
SOUND.FILTER 0, 900, 0.3, "LP"
SOUND.GLIDE 0, 60
SOUND.GAIN 0, 0.7

DIM split_key = 60
DIM status$ = ""
' ImGui scale: the largest whole factor at which the 980 x 860 panel fits
' the primary display (2 on 4K, 1 on 1920 x 1080). SCREEN multiplies fonts
' and spacing by it; the widths given to GUI calls are raw pixels and are
' multiplied here.
CONST PANEL_W = 980
CONST PANEL_H = 860
FUNC PANEL_SCALE()
    DIM w = 1920
    DIM h = 1080
    FOR EACH d IN GFX.DISPLAYS()
        IF d{"primary"} THEN
            w = d{"w"}
            h = d{"h"}
        ENDIF
    NEXT d
    RETURN MAX([1, INT(MIN([w / PANEL_W, h / PANEL_H]))])
ENDFUNC
DIM ui = 1
IF panel THEN ui = PANEL_SCALE()

SUB SAY(msg$)
    status$ = msg$
    PRINT msg$
ENDSUB

SUB SET_SPLIT(key)
    split_key = key
    SOUND.ZONE -1
    SOUND.ZONE 0, 0, split_key - 1, 1, -12, {"legato": TRUE}
    SOUND.ZONE 1, split_key, 127, 1, 0, {"vel_cutoff": 2, "mod_vibrato": 0.4}
    SOUND.ZONE DRUMS, 0, 127, 10
    SAY("Split at key " + STR$(split_key))
ENDSUB

' ---- drums: the pads play kit track DRUMS live, the looper records them ----
CONST DRUMS = 2
CONST CLICK = 3
CONST STEPS = 16
' pad notes 36-43 (bottom row 36-39) and the kit sound each one plays
DIM pad_notes = [36, 37, 38, 39, 40, 41, 42, 43]
DIM pad_names$ = ["bd", "sd", "hh", "oh", "cp", "rim", "lt", "cr"]
DIM n_rows = LEN(pad_names$)
SOUND.KIT DRUMS, "SYNTH"
SOUND.GAIN DRUMS, 0.9
SOUND.KIT CLICK, "SYNTH"
SOUND.GAIN CLICK, 0.35
FOR i = 0 TO n_rows - 1
    SOUND.PADMAP DRUMS, pad_notes[i], pad_names$[i]
NEXT i
SET_SPLIT(60)

DIM grid = IOTA(n_rows * STEPS, 0) * 0
DIM bpm = 110
DIM looping = FALSE
DIM recording = FALSE
SOUND.BPM bpm

' One bar of 16 steps in mini-notation: a rest, a sound, or [a,b] stacked
FUNC LOOP_PATTERN$()
    DIM steps$ = ""
    FOR s = 0 TO STEPS - 1
        DIM hits$ = ""
        DIM n_hits = 0
        FOR r = 0 TO n_rows - 1
            IF grid[r * STEPS + s] THEN
                hits$ = hits$ + IIF(n_hits > 0, ",", "") + pad_names$[r]
                n_hits = n_hits + 1
            ENDIF
        NEXT r
        IF n_hits = 0 THEN hits$ = "~"
        IF n_hits > 1 THEN hits$ = "[" + hits$ + "]"
        steps$ = steps$ + IIF(s > 0, " ", "") + hits$
    NEXT s
    RETURN steps$
ENDFUNC

SUB SEND_LOOP()
    IF looping THEN
        SOUND.SEQ DRUMS, LOOP_PATTERN$(), "VOICE"
    ELSE
        SOUND.SEQ DRUMS, "~", "VOICE"
    ENDIF
    SOUND.SEQ CLICK, IIF(recording, "cl ~ ~ ~ rim ~ ~ ~ rim ~ ~ ~ rim ~ ~ ~", "~"), "VOICE"
ENDSUB

SUB LOOP_PLAY()
    looping = TRUE
    SEND_LOOP()
    SAY("Loop playing at " + STR$(bpm) + " BPM")
ENDSUB

SUB LOOP_STOP()
    IF NOT looping ANDALSO NOT recording THEN
        grid = grid * 0
        SAY("Loop cleared")
    ELSE
        SAY("Loop stopped (STOP again clears it)")
    ENDIF
    looping = FALSE
    recording = FALSE
    SEND_LOOP()
ENDSUB

SUB LOOP_REC()
    recording = NOT recording
    looping = TRUE
    SEND_LOOP()
    SAY(IIF(recording, "Recording pads into the loop", "Recording off, loop plays on"))
ENDSUB

' A pad hit lands on the nearest 16th of the bar that is being heard
SUB RECORD_HIT(note)
    DIM row = -1
    FOR i = 0 TO n_rows - 1
        IF pad_notes[i] = note THEN row = i
    NEXT i
    IF row < 0 THEN RETURN
    DIM cps = bpm / 240
    DIM heard = SOUND.CYCLE() - (out_ms / 1000 + 0.01) * cps
    DIM pos = heard - INT(heard)
    DIM s = INT(pos * STEPS + 0.5) MOD STEPS
    IF grid[row * STEPS + s] = 0 THEN
        grid[row * STEPS + s] = 1
        SEND_LOOP()
    ENDIF
ENDSUB

' What the hardware moves: [label, cc index list key, index, track, param, lo, hi, curve]
DIM knob = cfg{"knobs"}{"daw"}{"cc"}
DIM fader = cfg{"faders"}{"daw"}{"cc"}
DIM hw_map = [["Knob 1", "knob", 0, 1, "CUTOFF", 150, 9000, "EXP"], ["Knob 2", "knob", 1, 1, "RESONANCE", 0, 0.9, "LIN"], ["Knob 3", "knob", 2, 1, "ATTACK", 0.002, 1.5, "EXP"], ["Knob 4", "knob", 3, 1, "RELEASE", 0.02, 3, "EXP"], ["Knob 5", "knob", 4, 0, "CUTOFF", 80, 4000, "EXP"], ["Knob 6", "knob", 5, 0, "RESONANCE", 0, 0.9, "LIN"], ["Knob 7", "knob", 6, 1, "DETUNE", 0, 0.5, "LIN"], ["Knob 8", "knob", 7, 1, "REVERB", 0, 0.8, "LIN"], ["Fader 1", "fader", 0, 1, "GAIN", 0, 1, "LIN"], ["Fader 2", "fader", 1, 0, "GAIN", 0, 1, "LIN"]]

' Mapping anew also restarts the pickup, so a knob waits for the new sound
SUB MAP_KNOBS()
    SOUND.CCMAP -1
    FOR EACH m IN hw_map
        DIM cc = knob[m[2]]
        IF m[1] = "fader" THEN cc = fader[m[2]]
        SOUND.CCMAP cc, m[3], m[4], m[5], m[6], m[7]
    NEXT m
ENDSUB

DIM cur = 0
DIM morph = 0

SUB SELECT_PATCH(i)
    cur = i
    morph = 0
    SYNTHPATCH.APPLY 1, bank[i]
    MAP_KNOBS()
    SAY("Lead patch " + STR$(i + 1) + "/" + STR$(LEN(bank)) + ": " + bank[i]{"name"} + "   (fader 9 morphs to " + bank[(i + 1) MOD LEN(bank)]{"name"} + ")")
ENDSUB
SELECT_PATCH(0)

SUB SAVE_LEAD()
    DIM mine = SYNTHPATCH.CAPTURE(1, bank[cur])
    mine{"name"} = "user_" + STR$(LEN(bank) - n_shipped + 1)
    bank = APPEND(bank, mine)
    SYNTHPATCH.SAVE_BANK user_bank$, bank[IOTA(LEN(bank) - n_shipped, 0) + n_shipped]
    SAY("Saved " + mine{"name"} + " to " + user_bank$)
ENDSUB

' ---- modulation matrix rows of the lead: source, target, amount ----
DIM mm_sources$ = ["OFF", "LFO1", "LFO2", "MODWHEEL", "AFTERTOUCH", "VELOCITY", "NOTE", "RANDOM"]
DIM mm_targets$ = ["CUTOFF", "RESONANCE", "GAIN", "PAN", "DETUNE", "PITCH", "REVERB", "DELAY", "FENV", "ATTACK", "RELEASE"]
DIM mm_src = [1, 4, 0, 0]
DIM mm_dst = [0, 5, 0, 0]
DIM mm_amt = [0.0, 0.0, 0.0, 0.0]
DIM lfo_shapes$ = ["SINE", "TRI", "SAW", "ISAW", "SQUARE", "RAND", "PERLIN"]
DIM lfo_rate = [1.0, 0.25]
DIM lfo_shape = [0, 1]

SUB APPLY_MATRIX()
    DIM n = SOUND.MATRIX("OFF")
    FOR r = 0 TO 3
        IF mm_src[r] > 0 ANDALSO mm_amt[r] <> 0 THEN n = SOUND.MATRIX(mm_sources$[mm_src[r]], 1, mm_targets$[mm_dst[r]], mm_amt[r])
    NEXT r
    SOUND.MODLFO 1, lfo_rate[0], lfo_shapes$[lfo_shape[0]]
    SOUND.MODLFO 2, lfo_rate[1], lfo_shapes$[lfo_shape[1]]
ENDSUB
APPLY_MATRIX()

DIM main_h = MIDI.OPEN_IN(main_idx)
PRINT "Route " + ins[main_idx] + ": " + STR$(MIDI.ROUTE(main_h))
DIM daw_h = -1
IF daw_idx >= 0 THEN
    daw_h = MIDI.OPEN_IN(daw_idx)
    PRINT "Controls " + ins[daw_idx] + ": " + STR$(MIDI.ROUTE(daw_h, "ALL", 10))
    PRINT "Drums on the pads need DAW mode (press DAW until it lights)"
ENDIF

DIM tp = cfg{"transport"}{"daw_port_cc"}
DIM mode_left = cfg{"mode_buttons"}{"left_cc"}
DIM mode_right = cfg{"mode_buttons"}{"right_cc"}
DIM preset_cc = cfg{"mode_report"}{"preset_mode_cc"}
DIM daw_cc = cfg{"mode_report"}{"daw_mode_cc"}
DIM morph_cc = fader[8]
DIM learning = FALSE
DIM seen = 0
DIM lat$ = "-"

SUB SET_MORPH(x)
    morph = x
    SYNTHPATCH.MORPH 1, bank[cur], bank[(cur + 1) MOD LEN(bank)], x
ENDSUB

SUB START_LEARN()
    learning = TRUE
    seen = SOUND.LASTNOTE(){"count"}
    SAY("Press the key for the new split")
ENDSUB

SUB HANDLE_MIDI()
    MIDI.POLL(main_h)
    IF daw_h >= 0 THEN
        FOR EACH m IN MIDI.POLL(daw_h)
            IF m[0] = 176 THEN
                IF m[1] = morph_cc THEN
                    SET_MORPH(m[2] / 127)
                ELSEIF m[2] = 127 ANDALSO m[1] = mode_right THEN
                    SELECT_PATCH((cur + 1) MOD LEN(bank))
                ELSEIF m[2] = 127 ANDALSO m[1] = mode_left THEN
                    SELECT_PATCH((cur + LEN(bank) - 1) MOD LEN(bank))
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"play"} THEN
                    LOOP_PLAY()
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"stop"} THEN
                    LOOP_STOP()
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"rec"} THEN
                    LOOP_REC()
                ELSEIF m[2] = 127 ANDALSO m[1] = tp{"loop"} THEN
                    START_LEARN()
                ELSEIF m[2] = 127 ANDALSO m[1] = daw_cc THEN
                    SAY("DAW mode: the pads play the drums")
                ELSEIF m[2] = 127 ANDALSO m[1] = preset_cc THEN
                    SAY("Preset mode: the pads play keys 36-43, press DAW for the drums")
                ENDIF
            ELSEIF m[0] = 144 ANDALSO m[2] > 0 ANDALSO recording THEN
                RECORD_HIT(m[1])
            ENDIF
        NEXT m
    ENDIF
    IF learning THEN
        DIM ln = SOUND.LASTNOTE()
        IF ln{"count"} > seen THEN
            IF ln{"channel"} = 1 THEN
                learning = FALSE
                SET_SPLIT(ln{"note"})
            ELSE
                seen = ln{"count"}
            ENDIF
        ENDIF
    ENDIF
ENDSUB

SUB TAKE_STATS(to_console)
    DIM stats = SOUND.MIDISTATS()
    IF stats{"events"} > 0 THEN
        lat$ = STR$(ROUND(stats{"total_ms"}, 1)) + " ms (max " + STR$(ROUND(stats{"total_max_ms"}, 1)) + ")"
        IF to_console THEN PRINT STR$(stats{"events"}) + " events  key->speaker " + lat$
    ENDIF
ENDSUB

' ---- panel ----
' A parameter slider; times and cutoff on a log2 scale
SUB PARAM_SLIDER(label$, t, p$, lo, hi, logscale)
    DIM v = SOUND.PARAM(t, p$)
    GUI.SET_NEXT_ITEM_WIDTH 260 * ui
    IF logscale THEN
        DIM lv = LOG(MAX([v, lo])) / LOG(2)
        DIM nv = GUI.SLIDER(label$ + " " + STR$(IIF(v >= 100, ROUND(v, 0), ROUND(v, 3))) + "##" + STR$(t) + p$, lv, LOG(lo) / LOG(2), LOG(hi) / LOG(2))
        IF nv <> lv THEN v = SOUND.PARAM(t, p$, 2 ^ nv)
    ELSE
        DIM nl = GUI.SLIDER(label$ + "##" + STR$(t) + p$, v, lo, hi)
        IF nl <> v THEN v = SOUND.PARAM(t, p$, nl)
    ENDIF
ENDSUB

SUB METER(label$, v, bipolar)
    DIM f = v
    IF bipolar THEN f = (v + 1) / 2
    GUI.TEXT LEFT$(label$ + "            ", 11)
    GUI.SAME_LINE
    GUI.SET_NEXT_ITEM_WIDTH 200 * ui
    GUI.PROGRESS MAX([0, MIN([1, f])]), STR$(ROUND(v, 2))
ENDSUB

SUB DRAW_PANEL()
    DIM dw = GUI.DISPLAY_WIDTH()
    DIM dh = GUI.DISPLAY_HEIGHT()
    GUI.BEGIN "Oxygen Synth##" + STR$(INT(dw)) + "x" + STR$(INT(dh)), 0, 0, dw, dh, GUI.FLAG("NOTITLEBAR") + GUI.FLAG("NORESIZE") + GUI.FLAG("NOMOVE") + GUI.FLAG("NOCOLLAPSE") + GUI.FLAG("NOSAVEDSETTINGS")
    GUI.SEPARATOR_TEXT("Lead patch")
    IF GUI.BUTTON("<") THEN SELECT_PATCH((cur + LEN(bank) - 1) MOD LEN(bank))
    GUI.SAME_LINE
    GUI.TEXT STR$(cur + 1) + "/" + STR$(LEN(bank)) + "  " + bank[cur]{"name"}
    GUI.SAME_LINE
    IF GUI.BUTTON(">") THEN SELECT_PATCH((cur + 1) MOD LEN(bank))
    GUI.SAME_LINE
    IF GUI.BUTTON("Save as user patch") THEN SAVE_LEAD()
    GUI.SAME_LINE
    IF GUI.BUTTON("Learn split (" + STR$(split_key) + ")") THEN START_LEARN()
    GUI.SET_NEXT_ITEM_WIDTH 260 * ui
    DIM nm = GUI.SLIDER("Morph to " + bank[(cur + 1) MOD LEN(bank)]{"name"} + "##morph", morph, 0, 1)
    IF nm <> morph THEN SET_MORPH(nm)
    GUI.TEXT "Key to speaker: " + lat$ + IIF(fast, "   output " + STR$(ROUND(out_ms, 1)) + " ms exclusive", "")
    GUI.TEXT status$

    IF GUI.BEGIN_TABLE("cols", 2) THEN
        GUI.TABLE_NEXT_ROW
        GUI.TABLE_NEXT_COLUMN
        GUI.SEPARATOR_TEXT("Lead (track 1)")
        PARAM_SLIDER("Cutoff", 1, "CUTOFF", 40, 18000, TRUE)
        PARAM_SLIDER("Resonance", 1, "RESONANCE", 0, 1, FALSE)
        PARAM_SLIDER("Filter env", 1, "FENV", 0, 5, FALSE)
        PARAM_SLIDER("Attack", 1, "ATTACK", 0.001, 3, TRUE)
        PARAM_SLIDER("Decay", 1, "DECAY", 0.01, 3, TRUE)
        PARAM_SLIDER("Sustain", 1, "SUSTAIN", 0, 1, FALSE)
        PARAM_SLIDER("Release", 1, "RELEASE", 0.01, 5, TRUE)
        PARAM_SLIDER("Detune", 1, "DETUNE", 0, 0.6, FALSE)
        PARAM_SLIDER("FM", 1, "FM", 0, 3, FALSE)
        PARAM_SLIDER("Reverb", 1, "REVERB", 0, 1, FALSE)
        PARAM_SLIDER("Delay", 1, "DELAY", 0, 1, FALSE)
        PARAM_SLIDER("Level", 1, "GAIN", 0, 1, FALSE)
        GUI.SEPARATOR_TEXT("Bass (track 0)")
        PARAM_SLIDER("Cutoff", 0, "CUTOFF", 40, 8000, TRUE)
        PARAM_SLIDER("Resonance", 0, "RESONANCE", 0, 1, FALSE)
        PARAM_SLIDER("Release", 0, "RELEASE", 0.01, 2, TRUE)
        PARAM_SLIDER("Level", 0, "GAIN", 0, 1, FALSE)

        GUI.TABLE_NEXT_COLUMN
        GUI.SEPARATOR_TEXT("Modulation matrix (lead)")
        DIM changed = FALSE
        FOR r = 0 TO 3
            GUI.PUSH_ID r
            GUI.SET_NEXT_ITEM_WIDTH 110 * ui
            DIM ns = GUI.COMBO("##src", mm_src[r], mm_sources$)
            GUI.SAME_LINE
            GUI.SET_NEXT_ITEM_WIDTH 110 * ui
            DIM nd = GUI.COMBO("##dst", mm_dst[r], mm_targets$)
            GUI.SAME_LINE
            GUI.SET_NEXT_ITEM_WIDTH 150 * ui
            DIM na = GUI.SLIDER("##amt", mm_amt[r], -4, 4)
            IF ns <> mm_src[r] ORELSE nd <> mm_dst[r] ORELSE na <> mm_amt[r] THEN changed = TRUE
            mm_src[r] = ns
            mm_dst[r] = nd
            mm_amt[r] = na
            GUI.POP_ID
        NEXT r
        GUI.TEXT "amount: octaves for cutoff and times, semitones for pitch"
        FOR l = 0 TO 1
            GUI.PUSH_ID 10 + l
            GUI.SET_NEXT_ITEM_WIDTH 150 * ui
            DIM nr = GUI.SLIDER("LFO" + STR$(l + 1) + " Hz", lfo_rate[l], 0.05, 12)
            GUI.SAME_LINE
            GUI.SET_NEXT_ITEM_WIDTH 100 * ui
            DIM nsh = GUI.COMBO("##shape", lfo_shape[l], lfo_shapes$)
            IF nr <> lfo_rate[l] ORELSE nsh <> lfo_shape[l] THEN changed = TRUE
            lfo_rate[l] = nr
            lfo_shape[l] = nsh
            GUI.POP_ID
        NEXT l
        IF changed THEN APPLY_MATRIX()
        METER("LFO1", SOUND.MODSRC("LFO1"), TRUE)
        METER("LFO2", SOUND.MODSRC("LFO2"), TRUE)
        METER("Mod wheel", SOUND.MODSRC("MODWHEEL"), FALSE)
        METER("Aftertouch", SOUND.MODSRC("AFTERTOUCH"), FALSE)
        METER("Velocity", SOUND.MODSRC("VELOCITY"), FALSE)
        METER("Note", SOUND.MODSRC("NOTE"), TRUE)
        METER("Random", SOUND.MODSRC("RANDOM"), TRUE)

        GUI.SEPARATOR_TEXT("Hardware map")
        FOR EACH m IN hw_map
            GUI.TEXT m[0] + "  ->  " + IIF(m[3] = 1, "lead ", "bass ") + LCASE$(m[4])
        NEXT m
        GUI.TEXT "Fader 9  ->  morph       MODE < >  ->  patch"
        GUI.TEXT "PLAY STOP REC  ->  drum loop    LOOP + key  ->  split"
        GUI.TEXT "Pads  ->  bd sd hh oh (bottom row), cp rim lt cr (top row)"
        GUI.END_TABLE
    ENDIF

    GUI.SEPARATOR_TEXT("Drum loop (pads, channel 10)")
    IF GUI.BUTTON(IIF(looping, "Playing", "Play")) THEN LOOP_PLAY()
    GUI.SAME_LINE
    IF GUI.BUTTON("Stop") THEN LOOP_STOP()
    GUI.SAME_LINE
    IF GUI.BUTTON(IIF(recording, "Recording", "Rec")) THEN LOOP_REC()
    GUI.SAME_LINE
    IF GUI.BUTTON("Clear") THEN
        grid = grid * 0
        SEND_LOOP()
    ENDIF
    GUI.SAME_LINE
    GUI.SET_NEXT_ITEM_WIDTH 200 * ui
    DIM nb = INT(GUI.SLIDER("BPM", bpm, 60, 180))
    IF nb <> bpm THEN
        bpm = nb
        SOUND.BPM bpm
    ENDIF
    DIM cyc = SOUND.CYCLE()
    DIM now_step = INT((cyc - INT(cyc)) * STEPS)
    DIM edited = FALSE
    FOR r = 0 TO n_rows - 1
        GUI.TEXT LEFT$(pad_names$[r] + "    ", 4)
        FOR s = 0 TO STEPS - 1
            GUI.SAME_LINE
            GUI.PUSH_ID r * STEPS + s
            DIM was = grid[r * STEPS + s]
            DIM lbl$ = IIF(looping ANDALSO s = now_step, ">", "") + "###cell"
            DIM now_on = GUI.CHECKBOX(lbl$, was)
            IF now_on <> was THEN
                grid[r * STEPS + s] = IIF(now_on, 1, 0)
                edited = TRUE
            ENDIF
            GUI.POP_ID
        NEXT s
    NEXT r
    IF edited THEN SEND_LOOP()

    GUI.SEPARATOR_TEXT("Output")
    GUI.PLOT_LINES "##scope", SOUND.GET_WAVE(), "", -1.0, 1.0
    GUI.END
ENDSUB

DIM t0 = TICK()
DIM t_stats = t0
TAKE_STATS(FALSE)
IF panel THEN
    SCREEN PANEL_W, PANEL_H, "jdBasic Oxygen Synth", ui
    PRINT "Panel scale " + STR$(ui)
    TOGGLE_FULLSCREEN
    DIM key$ = ""
    DO
        CLS
        HANDLE_MIDI()
        DRAW_PANEL()
        SCREENFLIP
        IF TICK() - t_stats >= 1000 THEN
            t_stats = TICK()
            TAKE_STATS(FALSE)
        ENDIF
        key$ = INKEY$()
        IF UCASE$(key$) = "F" THEN TOGGLE_FULLSCREEN
    LOOP UNTIL key$ = CHR$(27) ORELSE TICK() - t0 >= run_secs * 1000
ELSE
    DO WHILE TICK() - t0 < run_secs * 1000
        HANDLE_MIDI()
        IF TICK() - t_stats >= 2000 THEN
            t_stats = TICK()
            TAKE_STATS(TRUE)
        ENDIF
        SLEEP 10
    LOOP
ENDIF

MIDI.CLOSE(main_h)
IF daw_h >= 0 THEN MIDI.CLOSE(daw_h)
IF fast THEN MON.SYNTH(0)
SOUND.SHUTDOWN
