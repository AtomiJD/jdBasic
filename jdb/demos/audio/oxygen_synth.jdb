' oxygen_synth.jdb - play the synth from an Oxygen 61 (or any MIDI keyboard).
' Usage: jdBasic oxygen_synth.jdb [seconds]   (default 300)
'
' Left of the split: mono legato saw bass, one octave down.
' Right of the split: detuned lead; velocity opens its filter, the mod
' wheel adds vibrato. Knobs and faders on the DAW port drive the sound in
' the audio thread. LOOP, then a key: that key becomes the new split.
' Latency is printed every 2 s while keys are played.

DIM run_secs = 300
IF LEN(OS.ARGS()) > 1 THEN run_secs = VAL(OS.ARGS()[1])

DIM cfg = JSON.PARSE$(TXTREADER$(PATH.DIRNAME$(OS.ARGS()[0]) + "/oxygen61.json"))

FUNC PORT_INDEX(names, wanted$)
    FOR i = 0 TO LEN(names) - 1
        IF STARTSWITH(names[i], wanted$) THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

DIM ins = MIDI.PORTS(){"in"}
DIM main_idx = PORT_INDEX(ins, cfg{"ports"}{"main"})
DIM daw_idx = PORT_INDEX(ins, cfg{"ports"}{"daw"})
IF main_idx < 0 THEN
    PRINT "Keyboard port not found: " + cfg{"ports"}{"main"}
    PRINT ins
    END
ENDIF

SOUND.INIT
SOUND.VOICE 0, "SAW", 0.005, 0.25, 0.6, 0.15
SOUND.FILTER 0, 900, 0.3, "LP"
SOUND.GLIDE 0, 60
SOUND.GAIN 0, 0.7
SOUND.VOICE 1, "SAW", 0.01, 0.3, 0.7, 0.35
SOUND.UNISON(1, 3, 0.12, 0.6)
SOUND.FILTER 1, 2500, 0.2, "LP"
SOUND.GAIN 1, 0.5
SOUND.REVERBSEND 1, 0.25

SUB SET_SPLIT(split)
    SOUND.ZONE -1
    SOUND.ZONE 0, 0, split - 1, 0, -12, {"legato": TRUE}
    SOUND.ZONE 1, split, 127, 0, 0, {"vel_cutoff": 2, "mod_vibrato": 0.4}
    PRINT "Split at key " + STR$(split)
ENDSUB
SET_SPLIT(60)

' The DAW port carries the knobs and faders in both keyboard modes
DIM knob = cfg{"knobs"}{"daw"}{"cc"}
DIM fader = cfg{"faders"}{"daw"}{"cc"}
SOUND.CCMAP knob[0], 1, "CUTOFF", 150, 9000, "EXP"
SOUND.CCMAP knob[1], 1, "RESONANCE", 0, 0.9
SOUND.CCMAP knob[2], 1, "ATTACK", 0.002, 1.5, "EXP"
SOUND.CCMAP knob[3], 1, "RELEASE", 0.02, 3, "EXP"
SOUND.CCMAP knob[4], 0, "CUTOFF", 80, 4000, "EXP"
SOUND.CCMAP knob[5], 0, "RESONANCE", 0, 0.9
SOUND.CCMAP knob[6], 1, "DETUNE", 0, 0.5
SOUND.CCMAP knob[7], 1, "REVERB", 0, 0.8
SOUND.CCMAP fader[0], 1, "GAIN", 0, 1
SOUND.CCMAP fader[1], 0, "GAIN", 0, 1

DIM main_h = MIDI.OPEN_IN(main_idx)
PRINT "Route " + ins[main_idx] + ": " + STR$(MIDI.ROUTE(main_h))
DIM daw_h = -1
IF daw_idx >= 0 THEN
    daw_h = MIDI.OPEN_IN(daw_idx)
    PRINT "Controls " + ins[daw_idx] + ": " + STR$(MIDI.ROUTE(daw_h, "CC"))
ENDIF

PRINT "Knobs 1-4: lead cutoff, resonance, attack, release. 5-6: bass cutoff, resonance."
PRINT "Knobs 7-8: lead detune, reverb. Faders 1-2: lead / bass level. LOOP + key: new split."

DIM loop_cc = cfg{"transport"}{"daw_port_cc"}{"loop"}
DIM learning = FALSE
DIM seen = 0
DIM t0 = TICK()
DIM t_stats = t0
DIM stats = SOUND.MIDISTATS()
DO WHILE TICK() - t0 < run_secs * 1000
    MIDI.POLL(main_h)
    IF daw_h >= 0 THEN
        FOR EACH m IN MIDI.POLL(daw_h)
            IF m[0] = 176 ANDALSO m[1] = loop_cc ANDALSO m[2] = 127 THEN
                learning = TRUE
                seen = SOUND.LASTNOTE(){"count"}
                PRINT "Press the key for the new split"
            ENDIF
        NEXT m
    ENDIF
    IF learning THEN
        DIM ln = SOUND.LASTNOTE()
        IF ln{"count"} > seen THEN
            learning = FALSE
            SET_SPLIT(ln{"note"})
        ENDIF
    ENDIF
    IF TICK() - t_stats >= 2000 THEN
        t_stats = TICK()
        stats = SOUND.MIDISTATS()
        IF stats{"events"} > 0 THEN
            PRINT STR$(stats{"events"}) + " events  key->speaker " + STR$(ROUND(stats{"total_ms"}, 1)) + " ms (max " + STR$(ROUND(stats{"total_max_ms"}, 1)) + ")"
        ENDIF
    ENDIF
    SLEEP 20
LOOP

MIDI.CLOSE(main_h)
IF daw_h >= 0 THEN MIDI.CLOSE(daw_h)
SOUND.SHUTDOWN
