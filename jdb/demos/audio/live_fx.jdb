' live_fx.jdb - hear your instrument LIVE through an FX chain in jdBasic.
' Needs the FX + MINIAUDIO build flags.
'
'   *** HEADPHONES + a guitar/line input. *** (mic -> speakers will howl.)
'   Pick devices with MON.START(inIdx, outIdx); see MON.DEVICES() for the indices.

' a crunch pedalboard (cabinet is offline-only, so not on the live path here)
' "Brian May" - singing, mid-focused crunch + harmonised echo (cabinet faked
' with the lowpass, since the IR convolution is offline-only on the live path)
DIM ch = FX.NEW()
DIM ok = FX.ADD(ch, "compressor", { "threshold": 0.15, "ratio": 4, "makeup": 1.4 })  ' even out the input
ok = FX.ADD(ch, "gain",     { "gain": 7 })                   ' push toward breakup
ok = FX.ADD(ch, "highpass", { "cutoff": 450, "q": 0.7 })     ' treble-booster (Rangemaster) feel
ok = FX.ADD(ch, "drive",    { "amount": 16, "level": 0.72 }) ' AC30 gain = singing sustain
ok = FX.ADD(ch, "lowpass",  { "cutoff": 3300, "q": 1.1 })    ' fake the AC30 2x12 cabinet roll-off
ok = FX.ADD(ch, "compressor", { "threshold": 0.10, "ratio": 8, "makeup": 1.8 })  ' SUSTAIN: lift the note tail
ok = FX.ADD(ch, "delay",    { "time_ms": 90, "feedback": 0.0, "mix": 0.06 })   ' tiny thickening, no audible echo

' auto-pick the audio interface (iRig etc.) for input + output; else defaults
DIM dev = MON.DEVICES()
DIM caps = dev{"capture"}
DIM pbs = dev{"playback"}
DIM inIdx = -1
DIM outIdx = -1
DIM i
FOR i = 0 TO LEN(caps) - 1
    IF INSTR(caps[i], "iRig") >= 0 THEN inIdx = i
NEXT i
FOR i = 0 TO LEN(pbs) - 1
    IF INSTR(pbs[i], "iRig") >= 0 THEN outIdx = i
NEXT i
IF inIdx < 0 THEN inIdx = 0
IF outIdx < 0 THEN outIdx = 0
PRINT "input  ["; inIdx; "] "; caps[inIdx]
PRINT "output ["; outIdx; "] "; pbs[outIdx]

DIM mok = MON.START(inIdx, outIdx)
IF NOT mok THEN
    PRINT "could not open the audio device"
ELSE
    DIM g = MON.GAIN(0.7)
    DIM f = MON.FX(ch)             ' route the live monitor through the chain
    PRINT "LIVE pedalboard - play! (monitoring 60 s; Ctrl-C to stop early)"
    PRINT "  MON.FX(0) bypasses, MON.GAIN(x) sets level."
    SLEEP 60000
    DIM s = MON.STOP()
    PRINT "stopped."
ENDIF
