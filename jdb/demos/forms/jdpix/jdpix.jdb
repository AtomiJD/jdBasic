' jdPix - a picture viewer on native Windows forms.
'
'   jdbasic jdpix.jdb [picture | folder]
'   jdpix --register | --unregister   (Open with and Default apps)
'   jdbasic -c jdpix.jdb            (jdpix.jdb.props gives the .exe its icon)
'
' Opens a picture and steps through the pictures of its folder. Fit to the
' window or zoom with the wheel at the pointer, drag to pan, a slideshow,
' turn a photo without losing quality, print it, see what it gives away
' (camera, date, GPS position) and save a copy without any of it. No
' library, no account.

OPTION "EXPLICIT"
IMPORT APPREG

DIM APP_NAME AS STRING = "jdPix"
DIM PROG_ID AS STRING = "jdPix.Picture"
DIM PIC_EXTS AS ARRAY = [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tif", ".tiff", ".ico", ".webp", ".heic", ".jxr"]
DIM PIC_FILTER AS STRING = "Pictures|*.jpg;*.jpeg;*.png;*.gif;*.bmp;*.tif;*.tiff;*.ico;*.webp;*.heic|All files (*.*)|*.*"
DIM CR AS STRING = CHR$(13)
DIM LF AS STRING = CHR$(10)
DIM CRLF AS STRING = CR + LF
DIM SB_HEIGHT AS INTEGER = 22
DIM INFO_W AS INTEGER = 300
DIM ARROW_W AS INTEGER = 44
DIM ARROW_H AS INTEGER = 80
DIM ARROW_MS AS INTEGER = 3000
DIM SLIDE_MS AS INTEGER = 3000
DIM PRINT_MAX_W AS INTEGER = 2400
DIM DARK_BACK AS INTEGER = $1E1E1E
DIM DARK_FORE AS INTEGER = $D4D4D4
DIM DARK_PIC AS INTEGER = $202020
DIM LIGHT_PIC AS INTEGER = $F0F0F0
DIM ZOOM_STEP AS DOUBLE = 1.25
DIM MAX_RECENT AS INTEGER = 8
DIM REG_KEY AS STRING = "Software\jdPix"
DIM HKEY_CURRENT_USER AS INTEGER = -2147483647
DIM REG_SZ AS INTEGER = 1

DIM frm AS DOUBLE = 0
DIM pic AS DOUBLE = 0
DIM info AS DOUBLE = 0
DIM sb AS DOUBLE = 0
DIM hint AS DOUBLE = 0
DIM btn_prev AS DOUBLE = 0
DIM btn_next AS DOUBLE = 0
DIM tmr_arrows AS DOUBLE = 0
DIM tmr_slide AS DOUBLE = 0
DIM printer_rt AS DOUBLE = 0
DIM client_w AS INTEGER = 1100
DIM client_h AS INTEGER = 760

' Kept across runs.
DIM window_place AS STRING = ""
DIM info_on AS INTEGER = 0
DIM dark_on AS INTEGER = 0
DIM status_on AS INTEGER = 1
DIM recent AS ARRAY = []

' The folder being looked through and where in it we are.
DIM folder AS STRING = ""
DIM names AS ARRAY = []
DIM cur AS INTEGER = -1
DIM cur_path AS STRING = ""

' A drag that pans: the picture pixel the mouse took hold of.
DIM dragging AS INTEGER = 0
DIM grab_x AS DOUBLE = 0
DIM grab_y AS DOUBLE = 0

DIM arrows_on AS INTEGER = 0
DIM slide_on AS INTEGER = 0
DIM slide_place AS STRING = ""

' ── settings (registry) ─────────────────────────────────────────

DECLARE FUNC RegSetKeyValueA LIB "advapi32.dll" ALIAS "RegSetKeyValueA" (hkey AS INTEGER, subkey AS STRING, value_name AS STRING, kind AS INTEGER, data AS STRING, n_bytes AS INTEGER) AS INTEGER
DECLARE FUNC SHRegGetPathA LIB "shlwapi.dll" ALIAS "SHRegGetPathA" (hkey AS INTEGER, subkey AS STRING, value_name AS STRING, buf AS RETURN, flags AS INTEGER) AS ARRAY

FUNC REG_GET$(item_name AS STRING, fallback AS STRING)
    DIM got AS ARRAY = SHRegGetPathA(HKEY_CURRENT_USER, REG_KEY, item_name, 260, 0)
    IF got[0] <> 0 THEN RETURN fallback
    RETURN got[1]
ENDFUNC

FUNC REG_GET_INT(item_name AS STRING, fallback AS INTEGER) AS INTEGER
    RETURN CINT(VAL(REG_GET$(item_name, STR$(fallback))))
ENDFUNC

SUB REG_PUT(item_name AS STRING, v AS STRING)
    DIM rc AS INTEGER = RegSetKeyValueA(HKEY_CURRENT_USER, REG_KEY, item_name, REG_SZ, v, LEN(v) + 1)
ENDSUB

SUB LOAD_SETTINGS()
    window_place = REG_GET$("Window", "")
    info_on = REG_GET_INT("Info", info_on)
    dark_on = REG_GET_INT("DarkMode", dark_on)
    status_on = REG_GET_INT("StatusBar", status_on)
ENDSUB

SUB SAVE_SETTINGS()
    REG_PUT("Info", STR$(info_on))
    REG_PUT("DarkMode", STR$(dark_on))
    REG_PUT("StatusBar", STR$(status_on))
ENDSUB

' ── recent pictures ────────────────────────────────────────────

FUNC RECENT_FILE$()
    RETURN GETENV$("APPDATA") + "\jdPix\recent.txt"
ENDFUNC

SUB LOAD_RECENT()
    recent = []
    IF NOT FILE.EXISTS(RECENT_FILE$()) THEN RETURN
    DIM entries AS ARRAY = SPLIT(REPLACE$(TXTREADER$(RECENT_FILE$()), CR, ""), LF)
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(entries) - 1
        IF entries[i] <> "" ANDALSO LEN(recent) < MAX_RECENT THEN recent = APPEND(recent, entries[i])
    NEXT
ENDSUB

SUB SAVE_RECENT()
    TRY
        MKDIR PATH.DIRNAME$(RECENT_FILE$())
        TXTWRITER RECENT_FILE$(), JOIN(recent, CRLF)
    CATCH
    ENDTRY
ENDSUB

SUB ADD_RECENT(path AS STRING)
    DIM kept AS ARRAY = [path]
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(recent) - 1
        IF UCASE$(recent[i]) <> UCASE$(path) ANDALSO LEN(kept) < MAX_RECENT THEN kept = APPEND(kept, recent[i])
    NEXT
    recent = kept
    SAVE_RECENT()
    BUILD_MENU()
ENDSUB

SUB OPEN_RECENT(n AS INTEGER)
    IF n > LEN(recent) THEN RETURN
    IF NOT FILE.EXISTS(recent[n - 1]) THEN
        MSGBOX(recent[n - 1] + " is not there any more.", 48, APP_NAME)
        RETURN
    ENDIF
    OPEN_PATH(recent[n - 1])
ENDSUB

' ── the folder ─────────────────────────────────────────────────

FUNC IS_PICTURE(name AS STRING) AS BOOLEAN
    RETURN INDEXOF(PIC_EXTS, LCASE$(PATH.EXT$(name))) >= 0
ENDFUNC

' The pictures of `dir_path`, by name regardless of case.
FUNC PICTURES_IN(dir_path AS STRING) AS ARRAY
    DIM found AS ARRAY = []
    DIM f AS STRING = ""
    FOR EACH f IN FILE.LIST(PATH.JOIN$(dir_path, "*"))
        IF IS_PICTURE(f) ANDALSO NOT FILE.ISDIR(PATH.JOIN$(dir_path, f)) THEN found = APPEND(found, f)
    NEXT
    IF LEN(found) < 2 THEN RETURN found
    DIM order AS ARRAY = GRADE(SELECT(LAMBDA s -> LCASE$(s), found))
    DIM sorted AS ARRAY = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(order) - 1
        sorted = APPEND(sorted, found[order[i]])
    NEXT
    RETURN sorted
ENDFUNC

' ── showing a picture ──────────────────────────────────────────

SUB UPDATE_STATUS()
    IF cur < 0 THEN
        FORM.SET(sb, "TEXT", ["", "", "", ""])
        FORM.SET(frm, "TEXT", APP_NAME)
        RETURN
    ENDIF
    DIM where AS STRING = STR$(cur + 1) + " / " + STR$(LEN(names))
    DIM dims AS STRING = STR$(FORM.GET(pic, "IMAGEWIDTH")) + " x " + STR$(FORM.GET(pic, "IMAGEHEIGHT"))
    DIM pct AS STRING = STR$(CINT(FORM.GET(pic, "SCALE") * 100)) + "%"
    IF FORM.GET(pic, "SCALEMODE") = "fit" THEN pct = pct + " (fit)"
    IF slide_on THEN pct = pct + "   Slideshow - any key stops it"
    FORM.SET(sb, "TEXT", [names[cur], where, dims, pct])
    FORM.SET(frm, "TEXT", names[cur] + " - " + APP_NAME)
ENDSUB

FUNC FILE_SIZE_TEXT$(bytes AS DOUBLE)
    IF bytes >= 1048576 THEN RETURN STR$(ROUND(bytes / 1048576, 1)) + " MB"
    IF bytes >= 1024 THEN RETURN STR$(ROUND(bytes / 1024, 0)) + " KB"
    RETURN STR$(bytes) + " bytes"
ENDFUNC

SUB UPDATE_INFO()
    IF NOT info_on THEN RETURN
    FORM.SET(info, "CLEAR", TRUE)
    IF cur < 0 THEN RETURN
    DIM st AS OBJECT = FILE.STAT(cur_path)
    DIM m AS OBJECT = IMAGE.META(cur_path)
    DIM rows AS ARRAY = []
    PUSH(rows, ["File", names[cur]])
    PUSH(rows, ["Folder", folder])
    PUSH(rows, ["Size", STR$(FORM.GET(pic, "IMAGEWIDTH")) + " x " + STR$(FORM.GET(pic, "IMAGEHEIGHT")) + " pixels"])
    PUSH(rows, ["File size", FILE_SIZE_TEXT$(st{"size"})])
    PUSH(rows, ["Modified", st{"mtime"}])
    DIM labels AS ARRAY = [["datetime_original", "Taken"], ["make", "Camera make"], ["model", "Camera model"], _
        ["software", "Software"], ["artist", "Artist"], ["copyright", "Copyright"], ["owner", "Camera owner"], _
        ["serial", "Camera serial"], ["description", "Description"], ["xp_author", "Author"], ["comment", "Comment"]]
    DIM lab AS ARRAY = []
    FOR EACH lab IN labels
        IF MAP.EXISTS(m, lab[0]) THEN PUSH(rows, [lab[1], m{lab[0]}])
    NEXT
    IF MAP.EXISTS(m, "gps_latitude") THEN
        PUSH(rows, ["GPS position", STR$(ROUND(m{"gps_latitude"}, 6)) + ", " + STR$(ROUND(m{"gps_longitude"}, 6))])
    ENDIF
    IF MAP.EXISTS(m, "gps_altitude") THEN PUSH(rows, ["GPS altitude", STR$(ROUND(m{"gps_altitude"}, 1)) + " m"])
    IF MAP.EXISTS(m, "format") THEN
        DIM leaks AS STRING = "nothing"
        IF MAP.EXISTS(m, "gps_latitude") THEN
            leaks = "its position"
        ELSEIF MAP.EXISTS(m, "artist") ORELSE MAP.EXISTS(m, "owner") ORELSE MAP.EXISTS(m, "xp_author") ORELSE MAP.EXISTS(m, "serial") THEN
            leaks = "a name or serial"
        ENDIF
        PUSH(rows, ["Gives away", leaks])
    ENDIF
    FORM.SET(info, "ITEMS", rows)
ENDSUB

SUB SHOW_HINT(empty AS INTEGER)
    FORM.SET(hint, "VISIBLE", empty)
ENDSUB

' Shows names[i] fitted to the window.
SUB SHOW_AT(i AS INTEGER)
    IF LEN(names) = 0 THEN
        cur = -1
        cur_path = ""
        SHOW_HINT(1)
        HIDE_ARROWS()
        UPDATE_STATUS()
        UPDATE_INFO()
        RETURN
    ENDIF
    IF i < 0 THEN i = 0
    IF i > LEN(names) - 1 THEN i = LEN(names) - 1
    DIM path AS STRING = PATH.JOIN$(folder, names[i])
    TRY
        FORM.SET(pic, "PICTURE", path)
    CATCH
        MSGBOX("Cannot show " + names[i] + "." + CHR$(10) + "It is not a picture this computer can read.", 48, APP_NAME)
        RETURN
    ENDTRY
    cur = i
    cur_path = path
    FORM.SET(pic, "SCALEMODE", "fit")
    SHOW_HINT(0)
    IF arrows_on THEN PLACE_ARROWS()
    UPDATE_STATUS()
    UPDATE_INFO()
ENDSUB

' Opens a picture, or the first picture of a folder, with its folder.
SUB OPEN_PATH(p AS STRING)
    IF p = "" THEN RETURN
    p = PATH.ABS$(p)
    IF FILE.ISDIR(p) THEN
        folder = p
        names = PICTURES_IN(folder)
        SHOW_AT(0)
        IF LEN(names) > 0 THEN ADD_RECENT(cur_path)
        RETURN
    ENDIF
    folder = PATH.DIRNAME$(p)
    names = PICTURES_IN(folder)
    DIM at AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(names) - 1
        IF LCASE$(names[i]) = LCASE$(PATH.BASENAME$(p)) THEN at = i
    NEXT
    IF at < 0 THEN
        names = APPEND(names, PATH.BASENAME$(p))
        at = LEN(names) - 1
    ENDIF
    SHOW_AT(at)
    IF cur >= 0 THEN ADD_RECENT(cur_path)
ENDSUB

' ── zoom and pan ───────────────────────────────────────────────

' Sets the zoom to `z`, keeping the picture pixel (ix, iy) where it is.
SUB ZOOM_AT(z AS DOUBLE, ix AS DOUBLE, iy AS DOUBLE)
    IF cur < 0 THEN RETURN
    z = CLAMP(z, 0.02, 32)
    DIM k AS DOUBLE = FORM.GET(pic, "SCALE") / z
    ' the middle of the control after the zoom, so (ix, iy) stays put
    DIM cx AS DOUBLE = ix - (ix - FORM.GET(pic, "CENTERX")) * k
    DIM cy AS DOUBLE = iy - (iy - FORM.GET(pic, "CENTERY")) * k
    FORM.SET(pic, "ZOOM", z)
    FORM.SET(pic, "SCROLLX", cx - (FORM.GET(pic, "CENTERX") - FORM.GET(pic, "SCROLLX")))
    FORM.SET(pic, "SCROLLY", cy - (FORM.GET(pic, "CENTERY") - FORM.GET(pic, "SCROLLY")))
    UPDATE_STATUS()
ENDSUB

' Zooms by `f` at the middle of what is shown.
SUB ZOOM_BY(f AS DOUBLE)
    IF cur < 0 THEN RETURN
    ZOOM_AT(FORM.GET(pic, "SCALE") * f, FORM.GET(pic, "CENTERX"), FORM.GET(pic, "CENTERY"))
ENDSUB

SUB FIT()
    IF cur < 0 THEN RETURN
    FORM.SET(pic, "SCALEMODE", "fit")
    UPDATE_STATUS()
ENDSUB

SUB ACTUAL_SIZE()
    IF cur < 0 THEN RETURN
    ZOOM_AT(1, FORM.GET(pic, "IMAGEWIDTH") / 2, FORM.GET(pic, "IMAGEHEIGHT") / 2)
ENDSUB

' ── the arrows over the picture ────────────────────────────────

' Previous and next show while the mouse moves over the picture and go
' again ARROW_MS after it stopped; at the first or last picture only the
' one that leads somewhere shows.
SUB PLACE_ARROWS()
    FORM.SET(btn_prev, "VISIBLE", arrows_on ANDALSO cur > 0)
    FORM.SET(btn_next, "VISIBLE", arrows_on ANDALSO cur >= 0 ANDALSO cur < LEN(names) - 1)
ENDSUB

SUB SHOW_ARROWS()
    IF slide_on ORELSE LEN(names) < 2 THEN RETURN
    arrows_on = 1
    PLACE_ARROWS()
    FORM.SET(tmr_arrows, "INTERVAL", 0)
    FORM.SET(tmr_arrows, "INTERVAL", ARROW_MS)
ENDSUB

SUB HIDE_ARROWS()
    arrows_on = 0
    FORM.SET(tmr_arrows, "INTERVAL", 0)
    PLACE_ARROWS()
ENDSUB

SUB tmrArrows_TICK(e)
    HIDE_ARROWS()
ENDSUB

SUB btnPrev_CLICK(e)
    STEP_BY(-1)
    SHOW_ARROWS()
    FORM.SET(pic, "FOCUS", TRUE)
ENDSUB

SUB btnNext_CLICK(e)
    STEP_BY(1)
    SHOW_ARROWS()
    FORM.SET(pic, "FOCUS", TRUE)
ENDSUB

' ── slideshow ──────────────────────────────────────────────────

' The pictures one after the other, SLIDE_MS each, on the whole screen;
' any key or click stops it.
SUB SLIDE_START()
    IF LEN(names) < 2 ORELSE slide_on THEN RETURN
    slide_on = 1
    slide_place = FORM.GET(frm, "PLACEMENT")
    HIDE_ARROWS()
    FORM.MENU(frm, [])
    FORM.SET(frm, "BORDERSTYLE", 0)
    FORM.SET(frm, "MAXIMIZED", TRUE)
    LAYOUT()
    FIT()
    FORM.SET(tmr_slide, "INTERVAL", SLIDE_MS)
    FORM.SET(pic, "FOCUS", TRUE)
ENDSUB

SUB SLIDE_STOP()
    IF NOT slide_on THEN RETURN
    slide_on = 0
    FORM.SET(tmr_slide, "INTERVAL", 0)
    FORM.SET(frm, "BORDERSTYLE", 2)
    FORM.SET(frm, "MAXIMIZED", FALSE)
    IF slide_place <> "" THEN FORM.SET(frm, "PLACEMENT", slide_place)
    BUILD_MENU()
    LAYOUT()
ENDSUB

SUB tmrSlide_TICK(e)
    IF cur < 0 THEN RETURN
    DIM nxt AS INTEGER = cur + 1
    IF nxt >= LEN(names) THEN nxt = 0
    SHOW_AT(nxt)
ENDSUB

' ── the actions ────────────────────────────────────────────────

SUB STEP_BY(n AS INTEGER)
    IF cur < 0 THEN RETURN
    SHOW_AT(cur + n)
ENDSUB

SUB TURN_PICTURE(turn_by AS INTEGER)
    IF cur < 0 THEN RETURN
    DIM rc AS INTEGER = IMAGE.ROTATE(cur_path, cur_path, turn_by)
    IF rc <> 0 THEN
        MSGBOX("Cannot turn " + names[cur] + " (error " + STR$(rc) + ").", 48, APP_NAME)
        RETURN
    ENDIF
    SHOW_AT(cur)
ENDSUB

SUB DELETE_CURRENT()
    IF cur < 0 THEN RETURN
    IF NOT FILE.RECYCLE(cur_path) THEN
        MSGBOX("Cannot move " + names[cur] + " to the recycle bin.", 48, APP_NAME)
        RETURN
    ENDIF
    DIM kept AS ARRAY = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(names) - 1
        IF i <> cur THEN kept = APPEND(kept, names[i])
    NEXT
    names = kept
    SHOW_AT(cur)
ENDSUB

SUB COPY_PICTURE()
    IF cur < 0 THEN RETURN
    IF NOT CLIPBOARD.SETIMAGE(cur_path) THEN MSGBOX("Cannot copy the picture.", 48, APP_NAME)
ENDSUB

' A copy without camera, date, position or names, under a name chosen.
SUB SAVE_CLEAN()
    IF cur < 0 THEN RETURN
    DIM ext AS STRING = PATH.EXT$(names[cur])
    DIM base AS STRING = LEFT$(names[cur], LEN(names[cur]) - LEN(ext))
    DIM target AS STRING = FILESAVE$(PIC_FILTER, "Save a copy without metadata", base + "-clean" + ext)
    IF target = "" THEN RETURN
    DIM rc AS INTEGER = 0
    DIM lext AS STRING = LCASE$(PATH.EXT$(target))
    IF (lext = LCASE$(ext)) ANDALSO (lext = ".jpg" ORELSE lext = ".jpeg" ORELSE lext = ".png") THEN
        rc = IMAGE.STRIP(cur_path, target)
    ELSE
        rc = IMAGE.CONVERT(cur_path, target)
    ENDIF
    IF rc <> 0 THEN
        MSGBOX("Cannot write " + target + " (error " + STR$(rc) + ").", 48, APP_NAME)
    ELSEIF PATH.DIRNAME$(PATH.ABS$(target)) = folder THEN
        DIM keep AS INTEGER = cur
        names = PICTURES_IN(folder)
        SHOW_AT(keep)
    ENDIF
ENDSUB

SUB OPEN_DIALOG()
    DIM p AS STRING = FILEOPEN$(PIC_FILTER, "Open a picture", folder)
    IF p <> "" THEN OPEN_PATH(p)
ENDSUB

' ── printing ───────────────────────────────────────────────────

' The bytes of b$ as hexadecimal digits, the way RTF carries a picture.
FUNC HEX_OF$(b$)
    DIM digits AS STRING = "0123456789abcdef"
    DIM table AS ARRAY = []
    DIM i AS INTEGER
    FOR i = 0 TO 255
        table = APPEND(table, MID$(digits, INT(i / 16), 1) + MID$(digits, i MOD 16, 1))
    NEXT
    DIM parts AS ARRAY = []
    DIM piece AS STRING = ""
    FOR i = 0 TO LEN(b$) - 1
        piece = piece + table[BYTEAT(b$, i)]
        IF LEN(piece) >= 8192 THEN
            parts = APPEND(parts, piece)
            piece = ""
        ENDIF
    NEXT
    parts = APPEND(parts, piece)
    RETURN JOIN(parts, "")
ENDFUNC

' The picture, as displayed, as large as fits the page, with its name on
' top: it goes into a hidden RICHTEXT as an RTF picture and is printed from
' there.
SUB PRINT_PICTURE()
    IF cur < 0 THEN RETURN
    DIM tmp AS STRING = MKTEMP$("jdpix") + ".jpg"
    DIM rc AS INTEGER = 0
    IF FORM.GET(pic, "IMAGEWIDTH") > PRINT_MAX_W THEN
        rc = IMAGE.RESIZE(cur_path, tmp, PRINT_MAX_W, 0)
    ELSE
        rc = IMAGE.CONVERT(cur_path, tmp)
    ENDIF
    IF rc <> 0 THEN
        MSGBOX("Cannot prepare the picture for printing (error " + STR$(rc) + ").", 48, APP_NAME)
        RETURN
    ENDIF
    DIM wh AS ARRAY = IMAGE.SIZE(tmp)
    DIM area AS OBJECT = FORM.PRINTAREA()
    ' 15 twips to a pixel at 96 dpi; the title line takes about 700 twips
    DIM f AS DOUBLE = MIN([area{"width"} / (wh[0] * 15), (area{"height"} - 700) / (wh[1] * 15)])
    DIM gw AS INTEGER = CINT(wh[0] * 15 * f)
    DIM gh AS INTEGER = CINT(wh[1] * 15 * f)
    DIM rtf AS STRING = "{\rtf1\ansi{\pard\qc{\pict\jpegblip\picw" + STR$(wh[0]) + "\pich" + STR$(wh[1]) + _
        "\picwgoal" + STR$(gw) + "\pichgoal" + STR$(gh) + " " + HEX_OF$(BINREADER$(tmp)) + "}\par}}"
    KILL tmp
    FORM.SET(printer_rt, "TEXTRTF", rtf)
    DIM done AS BOOLEAN = FORM.PRINTRICH(printer_rt, names[cur])
    FORM.SET(printer_rt, "TEXT", "")
ENDSUB

' ── look ───────────────────────────────────────────────────────

SUB APPLY_COLORS()
    FORM.SET(frm, "DARKMODE", dark_on = 1)
    FORM.SET(pic, "BACKCOLOR", IIF(dark_on, DARK_PIC, LIGHT_PIC))
    FORM.SET(info, "BACKCOLOR", IIF(dark_on, DARK_BACK, $FFFFFF))
    FORM.SET(info, "FORECOLOR", IIF(dark_on, DARK_FORE, $000000))
    FORM.SET(hint, "BACKCOLOR", IIF(dark_on, DARK_PIC, LIGHT_PIC))
    FORM.SET(hint, "FORECOLOR", IIF(dark_on, DARK_FORE, $404040))
ENDSUB

SUB CHECK_ITEM(item_name AS STRING, checked AS INTEGER)
    FORM.SET(FORM.FIND(frm, item_name), "CHECKED", checked)
ENDSUB

SUB MENU_CHECKS()
    CHECK_ITEM("mnuInfo", info_on)
    CHECK_ITEM("mnuStatus", status_on)
    CHECK_ITEM("mnuDark", dark_on)
ENDSUB

FUNC RECENT_ITEMS()
    DIM items AS ARRAY = []
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(recent) - 1
        items = APPEND(items, {"text": "&" + STR$(i + 1) + " " + REPLACE$(recent[i], "&", "&&"), "name": "mnuRecent" + STR$(i + 1)})
    NEXT
    IF LEN(recent) = 0 THEN items = APPEND(items, {"text": "(none)", "name": "mnuRecentNone"})
    items = APPEND(items, "-")
    items = APPEND(items, {"text": "&Clear Recent Pictures", "name": "mnuRecentClear"})
    RETURN items
ENDFUNC

SUB BUILD_MENU()
    IF slide_on THEN RETURN
    FORM.MENU(frm, [ _
        {"text": "&File", "items": [ _
            {"text": "&Open...", "name": "mnuOpen", "key": "Ctrl+O"}, _
            {"text": "Open &Recent", "items": RECENT_ITEMS()}, _
            {"text": "&Save a Copy without Metadata...", "name": "mnuSaveClean", "key": "Ctrl+Shift+S"}, _
            "-", _
            {"text": "Page Set&up...", "name": "mnuPageSetup"}, _
            {"text": "&Print...", "name": "mnuPrint", "key": "Ctrl+P"}, _
            "-", _
            {"text": "E&xit", "name": "mnuExit"}]}, _
        {"text": "&Edit", "items": [ _
            {"text": "&Copy Picture", "name": "mnuCopy", "key": "Ctrl+C"}, _
            {"text": "&Delete to Recycle Bin" + CHR$(9) + "Del", "name": "mnuDelete"}, _
            "-", _
            {"text": "Turn &Right", "name": "mnuRotRight", "key": "Ctrl+R"}, _
            {"text": "Turn &Left", "name": "mnuRotLeft", "key": "Ctrl+L"}]}, _
        {"text": "&View", "items": [ _
            {"text": "&Previous" + CHR$(9) + "Left", "name": "mnuPrev"}, _
            {"text": "&Next" + CHR$(9) + "Right", "name": "mnuNext"}, _
            {"text": "S&lideshow", "name": "mnuSlide", "key": "F5"}, _
            "-", _
            {"text": "&Fit to Window", "name": "mnuFit", "key": "Ctrl+0"}, _
            {"text": "&Actual Size (100%)", "name": "mnuActual", "key": "Ctrl+1"}, _
            {"text": "Zoom &In", "name": "mnuZoomIn", "key": "Ctrl+Plus"}, _
            {"text": "Zoom &Out", "name": "mnuZoomOut", "key": "Ctrl+Minus"}, _
            "-", _
            {"text": "&Info", "name": "mnuInfo", "key": "Ctrl+I"}, _
            {"text": "&Status Bar", "name": "mnuStatus"}, _
            {"text": "&Dark Mode", "name": "mnuDark"}]}, _
        {"text": "&Help", "items": [ _
            {"text": "Set as &Default App...", "name": "mnuRegister"}, _
            {"text": "&Remove from Default Apps", "name": "mnuUnregister"}, _
            "-", _
            {"text": "&About " + APP_NAME, "name": "mnuAbout"}]}])
    IF LEN(recent) = 0 THEN FORM.SET(FORM.FIND(frm, "mnuRecentNone"), "ENABLED", FALSE)
    MENU_CHECKS()
ENDSUB

' ── layout ─────────────────────────────────────────────────────

SUB LAYOUT()
    DIM show_status AS INTEGER = status_on ANDALSO NOT slide_on
    DIM show_info AS INTEGER = info_on ANDALSO NOT slide_on
    FORM.SET(sb, "VISIBLE", show_status)
    FORM.SET(info, "VISIBLE", show_info)
    DIM w AS INTEGER = client_w
    DIM h AS INTEGER = client_h
    IF show_status THEN h = h - SB_HEIGHT
    IF show_info THEN w = w - INFO_W
    IF w < 50 THEN w = 50
    IF h < 50 THEN h = 50
    FORM.SET(pic, "WIDTH", w)
    FORM.SET(pic, "HEIGHT", h)
    FORM.SET(hint, "WIDTH", w)
    FORM.SET(hint, "Y", h / 2 - 12)
    FORM.SET(info, "X", w)
    FORM.SET(info, "HEIGHT", h)
    FORM.SET(btn_prev, "X", 10)
    FORM.SET(btn_prev, "Y", (h - ARROW_H) / 2)
    FORM.SET(btn_next, "X", w - ARROW_W - 10)
    FORM.SET(btn_next, "Y", (h - ARROW_H) / 2)
    UPDATE_STATUS()
ENDSUB

' ── events ─────────────────────────────────────────────────────

SUB MAIN_RESIZE(e)
    client_w = CINT(e[0]{"width"})
    client_h = CINT(e[0]{"height"})
    LAYOUT()
ENDSUB

SUB MAIN_UNLOAD(e)
    IF slide_on THEN
        IF slide_place <> "" THEN REG_PUT("Window", slide_place)
    ELSE
        REG_PUT("Window", FORM.GET(frm, "PLACEMENT"))
    ENDIF
    SAVE_SETTINGS()
ENDSUB

SUB MAIN_DROPFILES(e)
    OPEN_PATH(e[0]{"files"}[0])
ENDSUB

SUB pic_DROPFILES(e)
    OPEN_PATH(e[0]{"files"}[0])
ENDSUB

SUB pic_KEYDOWN(e)
    DIM k AS INTEGER = CINT(e[0]{"key"})
    IF slide_on THEN
        SLIDE_STOP()
        RETURN
    ENDIF
    IF e[0]{"ctrl"} THEN RETURN
    SWITCH k
        CASE 37, 33
            STEP_BY(-1)
        CASE 39, 34, 32
            STEP_BY(1)
        CASE 36
            SHOW_AT(0)
        CASE 35
            SHOW_AT(LEN(names) - 1)
        CASE 46
            DELETE_CURRENT()
        CASE 187, 107
            ZOOM_BY(ZOOM_STEP)
        CASE 189, 109
            ZOOM_BY(1 / ZOOM_STEP)
    ENDSWITCH
ENDSUB

SUB pic_MOUSEWHEEL(e)
    IF cur < 0 ORELSE slide_on THEN RETURN
    DIM f AS DOUBLE = ZOOM_STEP
    IF e[0]{"delta"} < 0 THEN f = 1 / ZOOM_STEP
    ZOOM_AT(FORM.GET(pic, "SCALE") * f, e[0]{"imagex"}, e[0]{"imagey"})
ENDSUB

SUB pic_MOUSEDOWN(e)
    IF slide_on THEN
        SLIDE_STOP()
        RETURN
    ENDIF
    IF cur < 0 ORELSE e[0]{"button"} <> 1 THEN RETURN
    IF FORM.GET(pic, "SCALEMODE") <> "zoom" THEN RETURN
    dragging = 1
    grab_x = e[0]{"imagex"}
    grab_y = e[0]{"imagey"}
    FORM.SET(pic, "CURSOR", "SIZEALL")
ENDSUB

SUB pic_MOUSEMOVE(e)
    IF NOT dragging THEN
        SHOW_ARROWS()
        RETURN
    ENDIF
    FORM.SET(pic, "SCROLLX", FORM.GET(pic, "SCROLLX") + grab_x - e[0]{"imagex"})
    FORM.SET(pic, "SCROLLY", FORM.GET(pic, "SCROLLY") + grab_y - e[0]{"imagey"})
ENDSUB

SUB pic_MOUSEUP(e)
    IF NOT dragging THEN RETURN
    dragging = 0
    FORM.SET(pic, "CURSOR", "DEFAULT")
ENDSUB

' A double click switches between the whole picture and 100% at the pointer.
SUB pic_DBLCLICK(e)
    IF cur < 0 ORELSE slide_on THEN RETURN
    IF FORM.GET(pic, "SCALEMODE") = "fit" THEN
        ZOOM_AT(1, e[0]{"imagex"}, e[0]{"imagey"})
    ELSE
        FIT()
    ENDIF
ENDSUB

SUB mnuOpen_CLICK(e)
    OPEN_DIALOG()
ENDSUB
SUB mnuRecent1_CLICK(e)
    OPEN_RECENT(1)
ENDSUB
SUB mnuRecent2_CLICK(e)
    OPEN_RECENT(2)
ENDSUB
SUB mnuRecent3_CLICK(e)
    OPEN_RECENT(3)
ENDSUB
SUB mnuRecent4_CLICK(e)
    OPEN_RECENT(4)
ENDSUB
SUB mnuRecent5_CLICK(e)
    OPEN_RECENT(5)
ENDSUB
SUB mnuRecent6_CLICK(e)
    OPEN_RECENT(6)
ENDSUB
SUB mnuRecent7_CLICK(e)
    OPEN_RECENT(7)
ENDSUB
SUB mnuRecent8_CLICK(e)
    OPEN_RECENT(8)
ENDSUB
SUB mnuRecentClear_CLICK(e)
    recent = []
    SAVE_RECENT()
    BUILD_MENU()
ENDSUB
SUB mnuSaveClean_CLICK(e)
    SAVE_CLEAN()
ENDSUB
SUB mnuPageSetup_CLICK(e)
    DIM ok AS BOOLEAN = FORM.PAGESETUP()
ENDSUB
SUB mnuPrint_CLICK(e)
    PRINT_PICTURE()
ENDSUB
SUB mnuExit_CLICK(e)
    FORM.CLOSE(frm)
ENDSUB
SUB mnuCopy_CLICK(e)
    COPY_PICTURE()
ENDSUB
SUB mnuDelete_CLICK(e)
    DELETE_CURRENT()
ENDSUB
SUB mnuRotRight_CLICK(e)
    TURN_PICTURE(90)
ENDSUB
SUB mnuRotLeft_CLICK(e)
    TURN_PICTURE(-90)
ENDSUB
SUB mnuPrev_CLICK(e)
    STEP_BY(-1)
ENDSUB
SUB mnuNext_CLICK(e)
    STEP_BY(1)
ENDSUB
SUB mnuSlide_CLICK(e)
    SLIDE_START()
ENDSUB
SUB mnuFit_CLICK(e)
    FIT()
ENDSUB
SUB mnuActual_CLICK(e)
    ACTUAL_SIZE()
ENDSUB
SUB mnuZoomIn_CLICK(e)
    ZOOM_BY(ZOOM_STEP)
ENDSUB
SUB mnuZoomOut_CLICK(e)
    ZOOM_BY(1 / ZOOM_STEP)
ENDSUB
SUB mnuInfo_CLICK(e)
    info_on = 1 - info_on
    MENU_CHECKS()
    LAYOUT()
    UPDATE_INFO()
ENDSUB
SUB mnuStatus_CLICK(e)
    status_on = 1 - status_on
    MENU_CHECKS()
    LAYOUT()
ENDSUB
SUB mnuDark_CLICK(e)
    dark_on = 1 - dark_on
    MENU_CHECKS()
    APPLY_COLORS()
ENDSUB
SUB mnuAbout_CLICK(e)
    MSGBOX(APP_NAME + " - a picture viewer written in jdBasic." + CHR$(10) + CHR$(10) + _
        "No library, no account, no cloud, no ads.", 64, APP_NAME)
ENDSUB

' ── Open with and Default apps ─────────────────────────────────

FUNC REGISTER_APP() AS INTEGER
    RETURN APPREG.REGISTER(APP_NAME, PROG_ID, "A picture viewer written in jdBasic.", APP_NAME + " Picture", PIC_EXTS)
ENDFUNC

SUB mnuRegister_CLICK(e)
    IF REGISTER_APP() <> 0 THEN
        MSGBOX("Windows did not take every entry of the registration.", 48, APP_NAME)
        RETURN
    ENDIF
    MSGBOX(APP_NAME + " now shows under Open with and in Default apps." + CRLF + CRLF + _
        "Windows lets only you make it the default: Settings opens on its page, " + _
        "pick " + APP_NAME + " there for each type of picture.", 64, APP_NAME)
    APPREG.OPEN_SETTINGS(APP_NAME)
ENDSUB
SUB mnuUnregister_CLICK(e)
    DIM rc AS INTEGER = APPREG.UNREGISTER(APP_NAME, PROG_ID, PIC_EXTS)
    MSGBOX(APP_NAME + " is no longer offered under Open with and in Default apps.", 64, APP_NAME)
ENDSUB

' ── build the window ───────────────────────────────────────────

DIM args AS ARRAY = OS.ARGS()
IF LEN(args) > 1 THEN
    IF LCASE$(args[1]) = "--register" THEN END REGISTER_APP()
    IF LCASE$(args[1]) = "--unregister" THEN END APPREG.UNREGISTER(APP_NAME, PROG_ID, PIC_EXTS)
ENDIF

LOAD_SETTINGS()
LOAD_RECENT()

frm = FORM.CREATE(APP_NAME, client_w, client_h, "MAIN")
pic = FORM.PICTURE(frm, "pic", "", 0, 0, client_w, client_h - SB_HEIGHT)
FORM.SET(pic, "SCALEMODE", "fit")
FORM.SET(pic, "DROPFILES", TRUE)
FORM.SET(frm, "DROPFILES", TRUE)
hint = FORM.LABEL(frm, "hint", "Open a picture with Ctrl+O, or drop one here.", 0, 0, client_w, 24)
FORM.SET(hint, "ALIGN", "CENTER")
FORM.SET(hint, "TABINDEX", 0)
btn_prev = FORM.BUTTON(frm, "btnPrev", "<", 10, 0, ARROW_W, ARROW_H)
btn_next = FORM.BUTTON(frm, "btnNext", ">", 0, 0, ARROW_W, ARROW_H)
FORM.SET(btn_prev, "FONT", {"name": "Segoe UI", "size": 20, "bold": TRUE})
FORM.SET(btn_next, "FONT", {"name": "Segoe UI", "size": 20, "bold": TRUE})
FORM.SET(btn_prev, "TOOLTIP", "Previous picture (Left)")
FORM.SET(btn_next, "TOOLTIP", "Next picture (Right)")
FORM.SET(btn_prev, "TABINDEX", 0)
FORM.SET(btn_next, "TABINDEX", 0)
FORM.SET(btn_prev, "VISIBLE", FALSE)
FORM.SET(btn_next, "VISIBLE", FALSE)
info = FORM.LISTVIEW(frm, "info", client_w - INFO_W, 0, INFO_W, client_h - SB_HEIGHT)
FORM.SET(info, "COLUMNS", [{"text": "Property", "width": 100}, {"text": "Value", "width": INFO_W - 104}])
sb = FORM.STATUSBAR(frm, "sb", [300, 90, 120, -1])
printer_rt = FORM.RICHTEXT(frm, "printerRt", 0, 0, 10, 10)
FORM.SET(printer_rt, "VISIBLE", FALSE)
tmr_arrows = FORM.TIMER(frm, "tmrArrows", 0)
tmr_slide = FORM.TIMER(frm, "tmrSlide", 0)

BUILD_MENU()
APPLY_COLORS()
LAYOUT()
IF LEN(args) > 1 THEN
    OPEN_PATH(args[1])
ELSE
    SHOW_AT(0)
ENDIF
IF window_place <> "" THEN FORM.SET(frm, "PLACEMENT", window_place)
FORM.RUN(frm)
