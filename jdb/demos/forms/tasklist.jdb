' Code-behind for tasklist.jdform - the declarative twin of forms_demo.jdb.
' The layout lives in the .jdform file; FORM.LOAD instantiates it and binds
' every SUB named <CONTROL>_<EVENT> below automatically. No ON statements.
' Declared throughout, so the same file runs interpreted and compiles with -c.
OPTION "EXPLICIT"

DIM frm AS DOUBLE = 0
DIM txtTask AS DOUBLE = 0
DIM lstTasks AS DOUBLE = 0
DIM chkBeep AS DOUBLE = 0
DIM lblClock AS DOUBLE = 0
DIM tasks_added AS INTEGER = 0
DIM btn1 AS INTEGER = 0

SUB MAIN_LOAD(e)
    FORM.SET(txtTask, "FOCUS")
ENDSUB

SUB BTNADD_CLICK(e)
    DIM task AS STRING = FORM.GET(txtTask, "TEXT")
    IF task = "" THEN
        MSGBOX("Type a task first.", 48, "Task List")
        RETURN
    ENDIF
    FORM.SET(lstTasks, "ADDITEM", task)
    FORM.SET(txtTask, "TEXT", "")
    FORM.SET(txtTask, "FOCUS")
    tasks_added = tasks_added + 1
ENDSUB

SUB BTNEDIT_CLICK(e)
    DIM idx AS INTEGER = FORM.GET(lstTasks, "SELINDEX")
    IF idx < 0 THEN
        MSGBOX("Select a task to edit.", 48, "Task List")
        RETURN
    ENDIF
    DIM current AS STRING = FORM.GET(lstTasks, "SELTEXT")
    DIM edited AS STRING = INPUTBOX$("Edit the task:", "Task List", current)
    IF edited <> "" THEN
        DIM items AS ARRAY = []
        DIM i AS INTEGER = 0
        FOR i = 0 TO FORM.GET(lstTasks, "COUNT") - 1
            FORM.SET(lstTasks, "SELINDEX", i)
            IF i = idx THEN
                items = APPEND(items, edited)
            ELSE
                items = APPEND(items, FORM.GET(lstTasks, "SELTEXT"))
            ENDIF
        NEXT
        FORM.SET(lstTasks, "ITEMS", items)
        FORM.SET(lstTasks, "SELINDEX", idx)
    ENDIF
ENDSUB

SUB BTNDONE_CLICK(e)
    DIM idx AS INTEGER = FORM.GET(lstTasks, "SELINDEX")
    IF idx < 0 THEN
        MSGBOX("Select a task to remove.", 48, "Task List")
        RETURN
    ENDIF
    IF FORM.GET(chkBeep, "CHECKED") THEN
        IF MSGBOX("Remove '" + FORM.GET(lstTasks, "SELTEXT") + "'?", 36, "Task List") <> 6 THEN RETURN
    ENDIF
    DIM items AS ARRAY = []
    DIM i AS INTEGER = 0
    FOR i = 0 TO FORM.GET(lstTasks, "COUNT") - 1
        IF i <> idx THEN
            FORM.SET(lstTasks, "SELINDEX", i)
            items = APPEND(items, FORM.GET(lstTasks, "SELTEXT"))
        ENDIF
    NEXT
    FORM.SET(lstTasks, "ITEMS", items)
ENDSUB

SUB LSTTASKS_DBLCLICK(e)
    MSGBOX("Task: " + e[0]{"text"}, 64, "Task List")
ENDSUB

SUB TMRCLOCK_TICK(e)
    FORM.SET(lblClock, "TEXT", TIME$())
ENDSUB

SUB MAIN_UNLOAD(e)
    PRINT "Session over - "; tasks_added; " task(s) added."
ENDSUB

SUB BTN1_CLICK(e)
    FORM.SET(btn1, "ENABLED", FALSE)
ENDSUB

frm = FORM.LOAD("tasklist.jdform")
txtTask  = FORM.FIND(frm, "txtTask")
lstTasks = FORM.FIND(frm, "lstTasks")
chkBeep  = FORM.FIND(frm, "chkBeep")
lblClock = FORM.FIND(frm, "lblClock")
btn1 = FORM.FIND(frm, "btn1")

FORM.RUN(frm)
