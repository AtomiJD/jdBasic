' MDI demo: a frame with a menu bar and a toolbar; File > New (Ctrl+N)
' loads mdi_doc.jdform as a document child - each hosting its own
' controls. Closing every document keeps the frame alive - closing the
' frame ends the program. Declared throughout, so the same file runs
' interpreted and compiles with -c.
OPTION "EXPLICIT"

DIM frame AS DOUBLE = 0
DIM sbar AS DOUBLE = 0
DIM doc_count AS INTEGER = 0

SUB NewDoc()
    doc_count = doc_count + 1
    DIM child AS DOUBLE = FORM.LOAD("mdi_doc.jdform", frame)
    FORM.SET(child, "TEXT", "Document " + STR$(doc_count))
    FORM.SET(sbar, "TEXT", ["Ready", STR$(doc_count) + " document(s)"])
ENDSUB

SUB MNUNEW_CLICK(e)
    NewDoc()
ENDSUB

SUB TBNEW_CLICK(e)
    NewDoc()
ENDSUB

SUB MNUABOUT_CLICK(e)
    MSGBOX("jdBasic MDI demo" + CHR$(10) + "Real Win32 MDI: frame, children, menus.", 64, "About")
ENDSUB

SUB MNUEXIT_CLICK(e)
    FORM.CLOSE(frame)
ENDSUB

frame = FORM.MDI("jdBasic MDI Demo", 720, 480, "FRAME")
FORM.MENU(frame, [ _
    { "text": "&File", "items": [ _
        { "name": "mnuNew", "text": "&New Document", "key": "Ctrl+N" }, _
        "-", _
        { "name": "mnuExit", "text": "E&xit" } _
    ]}, _
    { "text": "&Help", "items": [ _
        { "name": "mnuAbout", "text": "&About..." } _
    ]} _
])

FORM.TOOLBAR(frame, "tbMain", [ _
    { "name": "tbNew", "text": "New document (Ctrl+N)", "icon": "NEW" }, _
    "-", _
    { "name": "tbAbout", "text": "About", "icon": "HELP" } _
])

SUB TBABOUT_CLICK(e)
    MNUABOUT_CLICK(e)
ENDSUB

sbar = FORM.STATUSBAR(frame, "sbMain", [300, -1])
FORM.SET(sbar, "TEXT", ["Ready", "0 document(s)"])

FORM.RUN(frame)
