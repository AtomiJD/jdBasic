' jdTexti - a plain-text editor on native Windows forms (FORMS build).
' Multi-level undo, find/replace with whole-word and wrap-around, go to
' line, word wrap, zoom, spell check, tab width, dark mode, printing,
' recent files, and files kept in their own encoding and line endings.
' Watches the open file for changes made by other programs and offers to
' reload it. Dark mode, word wrap, spell check and the font are kept in the
' registry under HKCU\Software\jdTexti. Markdown files
' open next to their rendered view: both panes are editable and kept in
' step, and an edit in the view changes only the Markdown it reached.
'
'   jdbasic jdtexti.jdb [file.txt | file.md]
'   jdtexti --register | --unregister   (Open with and Default apps)
'   jdbasic -c jdtexti.jdb       (jdtexti.jdb.props gives the .exe its icon)
OPTION "EXPLICIT"
IMPORT MDSYNC
IMPORT MDRICH
IMPORT TEXTX
IMPORT MD
IMPORT APPREG

DIM APP_NAME AS STRING = "jdTexti"
DIM PROG_ID AS STRING = "jdTexti.Document"
DIM DOC_EXTS AS ARRAY = [".txt", ".md", ".markdown", ".log"]
DIM CR AS STRING = CHR$(13)
DIM LF AS STRING = CHR$(10)
DIM CRLF AS STRING = CR + LF
DIM TXT_FILTER AS STRING = "Text files (*.txt)|*.txt|Markdown (*.md)|*.md;*.markdown|All files (*.*)|*.*"
DIM SB_HEIGHT AS INTEGER = 22
DIM MDBAR_HEIGHT AS INTEGER = 30
DIM CODE_BACK AS INTEGER = $F0F0F0
DIM MAX_RECENT AS INTEGER = 8
DIM DARK_BACK AS INTEGER = $1E1E1E
DIM DARK_FORE AS INTEGER = $D4D4D4
DIM REG_KEY AS STRING = "Software\jdTexti"
' the predefined HKEY 0x80000001, sign-extended as Windows passes it
DIM HKEY_CURRENT_USER AS INTEGER = -2147483647
DIM REG_SZ AS INTEGER = 1

DIM frm AS DOUBLE = 0
DIM txt AS DOUBLE = 0
DIM sb AS DOUBLE = 0
DIM dlg AS DOUBLE = 0
DIM txtFind AS DOUBLE = 0
DIM txtRepl AS DOUBLE = 0
DIM chkCase AS DOUBLE = 0
DIM chkWord AS DOUBLE = 0
DIM chkWrap AS DOUBLE = 0
DIM chkRegex AS DOUBLE = 0
' length of the last hit FIND_FROM answered
DIM hit_len AS INTEGER = 0
DIM optUp AS DOUBLE = 0
DIM lblRepl AS DOUBLE = 0
DIM btnRepl AS DOUBLE = 0
DIM btnAll AS DOUBLE = 0

DIM file_path AS STRING = ""
DIM file_enc AS STRING = "utf-8"
DIM file_eol AS STRING = CRLF
' A file with both CRLF and LF keeps each line's own ending where the line
' was not edited; disk_lines and disk_ends hold the file as last read or
' written, until a line ending is chosen in the menu.
DIM file_mixed AS INTEGER = 0
DIM disk_lines AS ARRAY = []
DIM disk_ends AS ARRAY = []
' mtime and size of the file as last read or written; "" when it is gone
DIM file_stamp AS STRING = ""
DIM file_ro AS INTEGER = 0
DIM font_face AS STRING = "Consolas"
DIM font_size AS INTEGER = 11
DIM font_bold AS INTEGER = 0
DIM font_italic AS INTEGER = 0
DIM wrap_on AS INTEGER = 0
DIM status_on AS INTEGER = 1
DIM dark_on AS INTEGER = 0
DIM spell_on AS INTEGER = 1
DIM tab_w AS INTEGER = 8
DIM zoom_pct AS INTEGER = 100
DIM doc_chars AS INTEGER = 0
DIM recent AS ARRAY = []
DIM quitting AS INTEGER = 0
DIM disk_prompt AS INTEGER = 0
DIM app_active AS INTEGER = 1
DIM client_w AS INTEGER = 760
DIM client_h AS INTEGER = 500

' Markdown: md_on while the file is shown rendered; md_layout 1 shows source
' and view side by side, 2 the view alone. The source pane stays the
' document: saving, encodings and line endings work on it as before.
DIM mdv AS DOUBLE = 0
' a hidden copy of the view drawn light, for printing in dark mode
DIM mdprint AS DOUBLE = 0
DIM md_on AS INTEGER = 0
DIM md_layout AS INTEGER = 1
' The layout a Markdown file opens in: the one chosen last, kept across runs.
DIM md_pref AS INTEGER = 1
' Where the window sat when the program was closed, as FORM PLACEMENT text.
DIM window_place AS STRING = ""
DIM TEXT_MARGIN AS INTEGER = 10
' The bar between source and view: where it sits as a share of the width,
' and while it is dragged, where in the bar the mouse took hold.
DIM split_bar AS DOUBLE = 0
DIM split_pct AS DOUBLE = 50.0
DIM split_drag AS INTEGER = 0
DIM split_grab AS INTEGER = 0
DIM SPLIT_W AS INTEGER = 6
DIM SPLIT_MIN AS INTEGER = 80
DIM md_doc AS MAP
DIM md_dirty_view AS INTEGER = 0
DIM md_dirty_src AS INTEGER = 0
' the other pane follows once typing has rested this long
DIM SYNC_QUIET_MS AS DOUBLE = 400.0
DIM md_edit_at AS DOUBLE = 0.0
DIM view_active AS INTEGER = 0
DIM md_bar AS ARRAY = []
DIM md_state AS STRING = ""

' ── document state ──────────────────────────────────────────────

FUNC DOC_NAME$()
    IF file_path = "" THEN RETURN "Untitled"
    RETURN PATH.BASENAME$(file_path)
ENDFUNC

FUNC ENC_LABEL$(enc AS STRING)
    IF LEFT$(enc, 8) = "utf-16le" THEN RETURN "UTF-16 LE"
    IF LEFT$(enc, 8) = "utf-16be" THEN RETURN "UTF-16 BE"
    SWITCH enc
        CASE "utf-8-bom"
            RETURN "UTF-8 with BOM"
        CASE "cp1252"
            RETURN "ANSI"
    ENDSWITCH
    RETURN "UTF-8"
ENDFUNC

' Characters as a reader counts them: a line break is one.
FUNC CHAR_COUNT(s AS STRING) AS INTEGER
    RETURN LEN(-REPLACE$(s, CR, ""))
ENDFUNC

SUB UPDATE_TITLE()
    DIM mark AS STRING = ""
    IF FORM.GET(txt, "MODIFIED") THEN mark = "*"
    DIM ro AS STRING = ""
    IF file_ro THEN ro = " [Read-Only]"
    FORM.SET(frm, "TEXT", mark + DOC_NAME$() + ro + " - " + APP_NAME)
ENDSUB

' The pane the user works in: the rendered view when it has the focus or
' stands alone, else the source.
FUNC ED() AS DOUBLE
    IF md_on ANDALSO (md_layout = 2 ORELSE view_active = 1) THEN RETURN mdv
    RETURN txt
ENDFUNC

SUB UPDATE_STATUS()
    DIM ed_now AS DOUBLE = ED()
    DIM pos AS STRING = "Ln " + STR$(FORM.GET(ed_now, "CARETLINE")) + ", Col " + STR$(FORM.GET(ed_now, "CARETCOL"))
    IF ed_now = mdv THEN pos = "Rendered"
    DIM chars AS STRING = STR$(doc_chars) + " characters"
    DIM sel AS STRING = FORM.GET(ed_now, "SELTEXT")
    IF sel <> "" THEN chars = STR$(CHAR_COUNT(sel)) + " of " + chars
    DIM eol AS STRING = "Windows (CRLF)"
    IF file_eol <> CRLF THEN eol = "Unix (LF)"
    IF file_mixed THEN eol = "Mixed (CRLF/LF)"
    FORM.SET(sb, "TEXT", [pos, chars, STR$(zoom_pct) + "%", eol, ENC_LABEL$(file_enc)])
ENDSUB

SUB LAYOUT()
    DIM top AS INTEGER = 0
    IF md_on THEN top = MDBAR_HEIGHT
    DIM h AS INTEGER = client_h - top
    IF status_on THEN h = h - SB_HEIGHT
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(md_bar) - 1
        FORM.SET(md_bar[i], "VISIBLE", md_on = 1)
    NEXT
    IF NOT md_on THEN
        FORM.SET(split_bar, "VISIBLE", FALSE)
        FORM.SET(mdv, "VISIBLE", FALSE)
        FORM.SET(txt, "VISIBLE", TRUE)
        FORM.SET(txt, "Y", 0)
        FORM.SET(txt, "WIDTH", client_w)
        FORM.SET(txt, "HEIGHT", h)
        RETURN
    ENDIF
    FORM.SET(mdv, "VISIBLE", TRUE)
    FORM.SET(mdv, "Y", top)
    FORM.SET(mdv, "HEIGHT", h)
    IF md_layout = 2 THEN
        FORM.SET(split_bar, "VISIBLE", FALSE)
        FORM.SET(txt, "VISIBLE", FALSE)
        FORM.SET(mdv, "X", 0)
        FORM.SET(mdv, "WIDTH", client_w)
    ELSE
        DIM left_w AS INTEGER = SPLIT_LEFT(INT(client_w * split_pct / 100))
        FORM.SET(txt, "VISIBLE", TRUE)
        FORM.SET(txt, "Y", top)
        FORM.SET(txt, "WIDTH", left_w)
        FORM.SET(txt, "HEIGHT", h)
        FORM.SET(split_bar, "X", left_w)
        FORM.SET(split_bar, "Y", top)
        FORM.SET(split_bar, "HEIGHT", h)
        FORM.SET(split_bar, "VISIBLE", TRUE)
        FORM.SET(mdv, "X", left_w + SPLIT_W)
        FORM.SET(mdv, "WIDTH", client_w - left_w - SPLIT_W)
    ENDIF
ENDSUB

' The width of the source pane for a wanted one, leaving both panes usable.
FUNC SPLIT_LEFT(want AS INTEGER) AS INTEGER
    DIM hi AS INTEGER = client_w - SPLIT_W - SPLIT_MIN
    IF hi < SPLIT_MIN THEN RETURN MAX([0, INT((client_w - SPLIT_W) / 2)])
    IF want > hi THEN want = hi
    IF want < SPLIT_MIN THEN want = SPLIT_MIN
    RETURN want
ENDFUNC

' Dragging moves only the bar; the panes follow when the button is let go.
SUB SPLITBAR_MOUSEDOWN(e)
    IF CINT(e[0]{"button"}) <> 1 THEN RETURN
    split_drag = 1
    split_grab = CINT(e[0]{"x"})
ENDSUB

SUB SPLITBAR_MOUSEMOVE(e)
    IF NOT split_drag THEN RETURN
    DIM bar_x AS INTEGER = CINT(FORM.GET(split_bar, "X"))
    FORM.SET(split_bar, "X", SPLIT_LEFT(bar_x + CINT(e[0]{"x"}) - split_grab))
ENDSUB

SUB SPLITBAR_MOUSEUP(e)
    IF NOT split_drag THEN RETURN
    split_drag = 0
    IF client_w > 0 THEN split_pct = 100.0 * CINT(FORM.GET(split_bar, "X")) / client_w
    LAYOUT()
    SAVE_SETTINGS()
ENDSUB

SUB APPLY_COLORS()
    DIM back AS INTEGER = $FFFFFF
    DIM fore AS INTEGER = $000000
    IF dark_on THEN
        back = DARK_BACK
        fore = DARK_FORE
    ENDIF
    FORM.SET(txt, "BACKCOLOR", back)
    FORM.SET(txt, "FORECOLOR", fore)
    IF split_bar <> 0 THEN FORM.SET(split_bar, "COLOR", IIF(dark_on, $3C3C3C, $D8D8D8))
    IF mdv = 0 THEN RETURN
    FORM.SET(mdv, "BACKCOLOR", back)
    IF md_on THEN
        MD_FLUSH()
        DIM redrawn AS INTEGER = MDSYNC.SETOPTS(md_doc, {"dark": dark_on = 1})
    ENDIF
ENDSUB

' The folder relative image paths in the view resolve against.
FUNC MD_BASE$()
    IF file_path = "" THEN RETURN "."
    RETURN PATH.DIRNAME$(file_path)
ENDFUNC

SUB APPLY_FONT()
    FORM.SET(txt, "FONT", {"name": font_face, "size": font_size, "bold": font_bold = 1, "italic": font_italic = 1})
    APPLY_COLORS()
ENDSUB

' The control wants CRLF; files arrive with LF, CRLF or a mix.
FUNC TO_CRLF$(s AS STRING)
    RETURN REPLACE$(REPLACE$(s, CRLF, LF), LF, CRLF)
ENDFUNC

' Notes each line of the file's text and the ending after it ("" for the
' last); file_mixed when both CRLF and a bare LF occur.
SUB REMEMBER_LINES(content AS STRING)
    file_mixed = 0
    disk_lines = []
    disk_ends = []
    IF INSTR(content, CRLF) < 0 ORELSE INSTR(REPLACE$(content, CRLF, ""), LF) < 0 THEN RETURN
    file_mixed = 1
    DIM pieces AS ARRAY = SPLIT(content, LF)
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(pieces) - 1
        DIM one AS STRING = pieces[i]
        DIM ending AS STRING = LF
        IF RIGHT$(one, 1) = CR THEN
            one = LEFT$(one, LEN(one) - 1)
            ending = CRLF
        ENDIF
        IF i = LEN(pieces) - 1 THEN ending = ""
        PUSH(disk_lines, one)
        PUSH(disk_ends, ending)
    NEXT
ENDSUB

' The editor's CRLF text with the endings of a mixed file: lines that match
' the file from its start or its end keep their own ending, the edited
' lines between get file_eol.
FUNC MIXED_BODY$(body AS STRING)
    DIM now_lines AS ARRAY = SPLIT(body, CRLF)
    DIM n_now AS INTEGER = LEN(now_lines)
    DIM n_disk AS INTEGER = LEN(disk_lines)
    DIM lim AS INTEGER = n_now
    IF n_disk < lim THEN lim = n_disk
    DIM p AS INTEGER = 0
    DO WHILE p < lim ANDALSO now_lines[p] = disk_lines[p]
        p = p + 1
    LOOP
    DIM s AS INTEGER = 0
    DO WHILE s < lim - p ANDALSO now_lines[n_now - 1 - s] = disk_lines[n_disk - 1 - s]
        s = s + 1
    LOOP
    DIM out AS ARRAY = []
    DIM i AS INTEGER = 0
    FOR i = 0 TO n_now - 1
        DIM ending AS STRING = file_eol
        IF i < p THEN
            ending = disk_ends[i]
        ELSEIF i >= n_now - s THEN
            ending = disk_ends[i - n_now + n_disk]
        ENDIF
        IF ending = "" THEN ending = file_eol
        IF i = n_now - 1 THEN ending = ""
        PUSH(out, now_lines[i] + ending)
    NEXT
    RETURN JOIN(out, "")
ENDFUNC

FUNC DISK_STAMP$(st AS OBJECT)
    RETURN st{"mtime"} + "|" + STR$(st{"size"})
ENDFUNC

SUB REMEMBER_DISK()
    DIM st AS OBJECT = FILE.STAT(file_path)
    file_stamp = DISK_STAMP$(st)
    file_ro = 0
    IF st{"readonly"} THEN file_ro = 1
ENDSUB

' ── settings (registry) ─────────────────────────────────────────
' Every value is kept as text (REG_SZ). SHRegGetPathA reads into a MAX_PATH
' buffer and needs no size pointer, which DECLARE cannot pass.

DECLARE FUNC RegSetKeyValueA LIB "advapi32.dll" ALIAS "RegSetKeyValueA" (hkey AS INTEGER, subkey AS STRING, value_name AS STRING, kind AS INTEGER, data AS STRING, n_bytes AS INTEGER) AS INTEGER
DECLARE FUNC SHRegGetPathA LIB "shlwapi.dll" ALIAS "SHRegGetPathA" (hkey AS INTEGER, subkey AS STRING, value_name AS STRING, buf AS RETURN, flags AS INTEGER) AS ARRAY

FUNC REG_GET$(item_name AS STRING, fallback AS STRING)
    DIM got AS ARRAY = SHRegGetPathA(HKEY_CURRENT_USER, REG_KEY, item_name, 260, 0)
    IF got[0] <> 0 THEN RETURN fallback
    RETURN got[1]
ENDFUNC

FUNC REG_GET_INT(item_name AS STRING, fallback AS INTEGER) AS INTEGER
    RETURN CINT(VAL(REG_GET$(item_name, STR$(fallback))))
ENDFUNC

SUB REG_PUT(item_name AS STRING, v AS STRING)
    DIM rc AS INTEGER = RegSetKeyValueA(HKEY_CURRENT_USER, REG_KEY, item_name, REG_SZ, v, LEN(v) + 1)
ENDSUB

SUB LOAD_SETTINGS()
    dark_on = REG_GET_INT("DarkMode", dark_on)
    wrap_on = REG_GET_INT("WordWrap", wrap_on)
    spell_on = REG_GET_INT("SpellCheck", spell_on)
    font_face = REG_GET$("FontName", font_face)
    font_size = REG_GET_INT("FontSize", font_size)
    font_bold = REG_GET_INT("FontBold", font_bold)
    font_italic = REG_GET_INT("FontItalic", font_italic)
    split_pct = VAL(REG_GET$("SplitPercent", STR$(split_pct)))
    IF font_size < 1 THEN font_size = 11
    IF split_pct < 5 ORELSE split_pct > 95 THEN split_pct = 50.0
    md_pref = REG_GET_INT("MarkdownLayout", md_pref)
    IF md_pref <> 2 THEN md_pref = 1
    window_place = REG_GET$("Window", "")
ENDSUB

SUB SAVE_SETTINGS()
    REG_PUT("DarkMode", STR$(dark_on))
    REG_PUT("WordWrap", STR$(wrap_on))
    REG_PUT("SpellCheck", STR$(spell_on))
    REG_PUT("FontName", font_face)
    REG_PUT("FontSize", STR$(font_size))
    REG_PUT("FontBold", STR$(font_bold))
    REG_PUT("FontItalic", STR$(font_italic))
    REG_PUT("SplitPercent", STR$(ROUND(split_pct, 1)))
    REG_PUT("MarkdownLayout", STR$(md_pref))
ENDSUB

' ── Markdown ────────────────────────────────────────────────────

FUNC IS_MD_PATH(path AS STRING)
    DIM ext AS STRING = LCASE$(PATH.EXT$(path))
    RETURN ext = ".md" ORELSE ext = ".markdown"
ENDFUNC

' Shows the source rendered next to it (or alone, md_layout 2).
SUB MD_START(layout_kind AS INTEGER)
    md_doc = MDSYNC.OPEN(mdv, FORM.GET(txt, "TEXT"), {"base": MD_BASE$(), "dark": dark_on = 1})
    md_on = 1
    md_layout = layout_kind
    md_dirty_view = 0
    md_dirty_src = 0
    view_active = 0
    IF md_layout = 2 THEN view_active = 1
    LAYOUT()
    MENU_CHECKS()
    md_state = ""
    MD_STATE()
    UPDATE_STATUS()
ENDSUB

SUB MD_STOP()
    MD_FLUSH()
    md_on = 0
    view_active = 0
    LAYOUT()
    MENU_CHECKS()
    FORM.SET(txt, "FOCUS")
    UPDATE_STATUS()
ENDSUB

' Puts a source span from MDSYNC into the source pane: one undoable edit
' there, its own caret kept where it was relative to the text.
SUB APPLY_SPAN(d AS MAP)
    IF d{"changed"} <> TRUE THEN RETURN
    DIM at AS INTEGER = CINT(d{"start"})
    DIM gone AS INTEGER = CINT(d{"old_len"})
    DIM put AS STRING = d{"text"}
    DIM keep AS INTEGER = CINT(FORM.GET(txt, "SELSTART"))
    FORM.SET(txt, "SELSTART", at)
    FORM.SET(txt, "SELLENGTH", gone)
    FORM.SET(txt, "SELTEXT", put)
    IF keep > at THEN keep = CINT(MAX([at, keep + LEN(put) - gone]))
    FORM.SET(txt, "SELSTART", keep)
    doc_chars = CHAR_COUNT(FORM.GET(txt, "TEXT"))
ENDSUB

SUB MD_FROM_VIEW()
    md_dirty_view = 0
    DIM d AS MAP = MDSYNC.VIEWCHANGED(md_doc)
    APPLY_SPAN(d)
ENDSUB

SUB MD_FROM_SOURCE()
    md_dirty_src = 0
    DIM redrawn AS INTEGER = MDSYNC.SOURCECHANGED(md_doc, FORM.GET(txt, "TEXT"))
ENDSUB

' Brings the other pane up to date now instead of on the next sync tick.
SUB MD_FLUSH()
    IF NOT md_on THEN RETURN
    IF md_dirty_view THEN MD_FROM_VIEW()
    IF md_dirty_src THEN MD_FROM_SOURCE()
ENDSUB

' Bold, italic, strikethrough and code on the selection. In the view the
' format is set and read back; in the source the selection gets markers.
SUB MD_INLINE(which AS STRING)
    IF NOT md_on THEN RETURN
    MD_FLUSH()
    IF ED() = txt THEN
        DIM mark AS STRING = "**"
        IF which = "italic" THEN mark = "*"
        IF which = "strike" THEN mark = "~~"
        IF which = "code" THEN mark = "`"
        FORM.SET(txt, "SELTEXT", mark + FORM.GET(txt, "SELTEXT") + mark)
        md_dirty_src = 1
        MD_FLUSH()
        RETURN
    ENDIF
    IF which = "bold" THEN
        FORM.SET(mdv, "SELBOLD", FORM.GET(mdv, "SELBOLD") <> TRUE)
    ELSEIF which = "italic" THEN
        FORM.SET(mdv, "SELITALIC", FORM.GET(mdv, "SELITALIC") <> TRUE)
    ELSEIF which = "strike" THEN
        FORM.SET(mdv, "SELSTRIKETHRU", FORM.GET(mdv, "SELSTRIKETHRU") <> TRUE)
    ELSE
        IF FORM.GET(mdv, "SELFONTNAME") = "Consolas" THEN
            FORM.SET(mdv, "SELFONTNAME", "Segoe UI")
            FORM.SET(mdv, "SELFONTSIZE", 11)
            FORM.SET(mdv, "SELBACKCOLOR", -1)
        ELSE
            FORM.SET(mdv, "SELFONTNAME", "Consolas")
            FORM.SET(mdv, "SELFONTSIZE", 10)
            FORM.SET(mdv, "SELBACKCOLOR", CODE_BACK)
        ENDIF
    ENDIF
    MD_FROM_VIEW()
    FORM.SET(mdv, "FOCUS")
    MD_STATE()
ENDSUB

' Turns the block under the caret (of either pane) into another kind.
SUB MD_KIND(kind AS STRING, level AS INTEGER)
    IF NOT md_on THEN RETURN
    MD_FLUSH()
    DIM k AS INTEGER = 0
    IF ED() = txt THEN
        k = CINT(MDSYNC.BLOCKOFSOURCE(md_doc, CINT(FORM.GET(txt, "SELSTART"))))
    ELSE
        k = CINT(MDSYNC.BLOCKAT(md_doc, CINT(FORM.GET(mdv, "SELSTART"))))
    ENDIF
    DIM d AS MAP = MDSYNC.SETKIND(md_doc, k, kind, level)
    APPLY_SPAN(d)
    FORM.SET(ED(), "FOCUS")
    MD_STATE()
ENDSUB

SUB MD_LINK()
    IF NOT md_on THEN RETURN
    MD_FLUSH()
    DIM url AS STRING = INPUTBOX$("Link address:", "Insert Link", "https://")
    IF url = "" THEN RETURN
    IF ED() = txt THEN
        FORM.SET(txt, "SELTEXT", "[" + FORM.GET(txt, "SELTEXT") + "](" + url + ")")
        md_dirty_src = 1
        MD_FLUSH()
        RETURN
    ENDIF
    DIM d AS MAP = MDSYNC.SETLINK(md_doc, url)
    APPLY_SPAN(d)
    FORM.SET(mdv, "FOCUS")
ENDSUB

' The block the caret of the working pane is in, -1 in an empty document.
FUNC MD_CARET_BLOCK() AS INTEGER
    IF LEN(MDSYNC.BLOCKS(md_doc)) = 0 THEN RETURN -1
    IF ED() = txt THEN RETURN CINT(MDSYNC.BLOCKOFSOURCE(md_doc, CINT(FORM.GET(txt, "SELSTART"))))
    RETURN CINT(MDSYNC.BLOCKAT(md_doc, CINT(FORM.GET(mdv, "SELSTART"))))
ENDFUNC

' Puts Markdown in as blocks of its own after the block under the caret.
SUB MD_INSERT(piece AS STRING)
    IF NOT md_on THEN RETURN
    MD_FLUSH()
    DIM k AS INTEGER = MD_CARET_BLOCK()
    DIM d AS MAP = MDSYNC.INSERT(md_doc, k, piece)
    APPLY_SPAN(d)
    IF ED() = txt THEN FORM.SET(txt, "SELSTART", CINT(MDSYNC.SOURCEPOS(md_doc, k + 1)))
    FORM.SET(ED(), "FOCUS")
    MD_STATE()
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

SUB MD_INSERT_TABLE()
    MD_INSERT("| Column 1 | Column 2 |" + LF + "| --- | --- |" + LF + "|  |  |")
ENDSUB

' An image next to the document is written relative to it, with / and
' spaces as %20 so the link target stays one word.
SUB MD_INSERT_IMAGE()
    IF NOT md_on THEN RETURN
    DIM path AS STRING = FILEOPEN$("Images (*.png;*.jpg;*.jpeg;*.gif;*.bmp)|*.png;*.jpg;*.jpeg;*.gif;*.bmp|All files (*.*)|*.*", "Insert Image")
    IF path = "" THEN RETURN
    DIM target AS STRING = path
    IF file_path <> "" THEN
        DIM doc_dir AS STRING = PATH.DIRNAME$(file_path) + "\"
        IF LCASE$(LEFT$(path, LEN(doc_dir))) = LCASE$(doc_dir) THEN target = MID$(path, LEN(doc_dir), LEN(path))
    ENDIF
    target = REPLACE$(REPLACE$(target, "\", "/"), " ", "%20")
    DIM alt AS STRING = PATH.BASENAME$(path)
    DIM ext AS STRING = PATH.EXT$(path)
    IF ext <> "" THEN alt = LEFT$(alt, LEN(alt) - LEN(ext))
    MD_INSERT("![" + alt + "](" + target + ")")
ENDSUB

' A row below, or a column right of, the table cell under the caret of
' either pane.
SUB MD_TABLE_ADD(what AS STRING)
    IF NOT md_on THEN RETURN
    MD_FLUSH()
    DIM from_src AS BOOLEAN = ED() = txt
    DIM at AS INTEGER = CINT(FORM.GET(txt, "SELSTART"))
    DIM d AS MAP
    IF what = "row" THEN
        d = MDSYNC.ADDROW(md_doc, from_src, at)
    ELSE
        d = MDSYNC.ADDCOL(md_doc, from_src, at)
    ENDIF
    IF d{"changed"} <> TRUE THEN RETURN
    APPLY_SPAN(d)
    IF from_src THEN FORM.SET(txt, "SELSTART", at)
    FORM.SET(ED(), "FOCUS")
    MD_STATE()
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

' Shows the format under the caret: the Markdown menu ticks it, the button
' bar draws the matching buttons bold. Inline formats are known in the
' rendered view only.
SUB MD_MARK(btn_name AS STRING, item_name AS STRING, on_now AS BOOLEAN)
    FORM.SET(FORM.FIND(frm, item_name), "CHECKED", on_now)
    FORM.SET(FORM.FIND(frm, btn_name), "FONT", {"bold": on_now, "underline": on_now})
ENDSUB

SUB MD_STATE()
    IF NOT md_on ORELSE md_dirty_view ORELSE md_dirty_src THEN RETURN
    DIM kind AS STRING = ""
    DIM level AS INTEGER = 0
    DIM ordered AS INTEGER = 0
    DIM k AS INTEGER = MD_CARET_BLOCK()
    DIM blocks AS ARRAY = MDSYNC.BLOCKS(md_doc)
    IF k >= 0 ANDALSO k < LEN(blocks) THEN
        DIM b AS MAP = blocks[k]
        kind = b{"kind"}
        IF kind = "heading" THEN level = CINT(b{"level"})
        IF kind = "item" ANDALSO b{"ordered"} = TRUE THEN ordered = 1
    ENDIF
    DIM bold_on AS INTEGER = 0
    DIM italic_on AS INTEGER = 0
    DIM strike_on AS INTEGER = 0
    DIM code_on AS INTEGER = 0
    IF ED() = mdv THEN
        IF FORM.GET(mdv, "SELBOLD") = TRUE THEN bold_on = 1
        IF FORM.GET(mdv, "SELITALIC") = TRUE THEN italic_on = 1
        IF FORM.GET(mdv, "SELSTRIKETHRU") = TRUE THEN strike_on = 1
        IF FORM.GET(mdv, "SELFONTNAME") = "Consolas" ANDALSO kind <> "code" THEN code_on = 1
    ENDIF
    DIM state AS STRING = kind + STR$(level) + STR$(ordered) + STR$(bold_on) + STR$(italic_on) + STR$(strike_on) + STR$(code_on)
    IF state = md_state THEN RETURN
    md_state = state
    MD_MARK("btnMdB", "mnuMdBold", bold_on = 1)
    MD_MARK("btnMdI", "mnuMdItalic", italic_on = 1)
    MD_MARK("btnMdS", "mnuMdStrike", strike_on = 1)
    MD_MARK("btnMdCode", "mnuMdCode", code_on = 1)
    MD_MARK("btnMdH1", "mnuMdH1", kind = "heading" ANDALSO level = 1)
    MD_MARK("btnMdH2", "mnuMdH2", kind = "heading" ANDALSO level = 2)
    MD_MARK("btnMdH3", "mnuMdH3", kind = "heading" ANDALSO level = 3)
    MD_MARK("btnMdPara", "mnuMdPara", kind = "para")
    MD_MARK("btnMdBullet", "mnuMdBullet", kind = "item" ANDALSO ordered = 0)
    MD_MARK("btnMdNumber", "mnuMdNumber", ordered = 1)
    MD_MARK("btnMdQuote", "mnuMdQuote", kind = "quote")
    MD_MARK("btnMdBlock", "mnuMdCodeBlock", kind = "code")
ENDSUB

' Keeps the other pane on the block the caret is in.
SUB MD_FOLLOW()
    IF NOT md_on ORELSE md_layout <> 1 THEN RETURN
    IF md_dirty_view ORELSE md_dirty_src THEN RETURN
    DIM k AS INTEGER = 0
    IF view_active THEN
        k = CINT(MDSYNC.BLOCKAT(md_doc, CINT(FORM.GET(mdv, "SELSTART"))))
        FORM.SET(txt, "SELSTART", CINT(MDSYNC.SOURCEPOS(md_doc, k)))
    ELSE
        k = CINT(MDSYNC.BLOCKOFSOURCE(md_doc, CINT(FORM.GET(txt, "SELSTART"))))
        FORM.SET(mdv, "SELSTART", CINT(MDSYNC.VIEWPOS(md_doc, k)))
    ENDIF
ENDSUB

' ── recent files ────────────────────────────────────────────────

FUNC RECENT_FILE$()
    RETURN GETENV$("APPDATA") + "\jdTexti\recent.txt"
ENDFUNC

SUB LOAD_RECENT()
    recent = []
    IF NOT FILE.EXISTS(RECENT_FILE$()) THEN RETURN
    DIM entries AS ARRAY = SPLIT(REPLACE$(TXTREADER$(RECENT_FILE$()), CR, ""), LF)
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(entries) - 1
        IF entries[i] <> "" ANDALSO LEN(recent) < MAX_RECENT THEN recent = APPEND(recent, entries[i])
    NEXT
ENDSUB

SUB SAVE_RECENT()
    TRY
        MKDIR PATH.DIRNAME$(RECENT_FILE$())
        TXTWRITER RECENT_FILE$(), JOIN(recent, CRLF)
    CATCH
    ENDTRY
ENDSUB

SUB ADD_RECENT(path AS STRING)
    DIM kept AS ARRAY = [path]
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(recent) - 1
        IF UCASE$(recent[i]) <> UCASE$(path) ANDALSO LEN(kept) < MAX_RECENT THEN kept = APPEND(kept, recent[i])
    NEXT
    recent = kept
    SAVE_RECENT()
    BUILD_MENU()
ENDSUB

' ── menu ────────────────────────────────────────────────────────

FUNC RECENT_ITEMS()
    DIM items AS ARRAY = []
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(recent) - 1
        items = APPEND(items, {"text": "&" + STR$(i + 1) + " " + REPLACE$(recent[i], "&", "&&"), "name": "mnuRecent" + STR$(i + 1)})
    NEXT
    IF LEN(recent) = 0 THEN items = APPEND(items, {"text": "(none)", "name": "mnuRecentNone"})
    items = APPEND(items, "-")
    items = APPEND(items, {"text": "&Clear Recent Files", "name": "mnuRecentClear"})
    RETURN items
ENDFUNC

