ENDSUB

SUB CHECK_ITEM(item_name AS STRING, checked AS INTEGER)
    FORM.SET(FORM.FIND(frm, item_name), "CHECKED", checked)
ENDSUB

SUB MENU_CHECKS()
    CHECK_ITEM("mnuEncUtf8", file_enc = "utf-8")
    CHECK_ITEM("mnuEncUtf8Bom", file_enc = "utf-8-bom")
    CHECK_ITEM("mnuEncUtf16Le", LEFT$(file_enc, 8) = "utf-16le")
    CHECK_ITEM("mnuEncUtf16Be", LEFT$(file_enc, 8) = "utf-16be")
    CHECK_ITEM("mnuEncAnsi", file_enc = "cp1252")
    CHECK_ITEM("mnuEolCrlf", file_eol = CRLF ANDALSO NOT file_mixed)
    CHECK_ITEM("mnuEolLf", file_eol <> CRLF ANDALSO NOT file_mixed)
    CHECK_ITEM("mnuWrap", wrap_on)
    CHECK_ITEM("mnuTab2", tab_w = 2)
    CHECK_ITEM("mnuTab4", tab_w = 4)
    CHECK_ITEM("mnuTab8", tab_w = 8)
    CHECK_ITEM("mnuSpell", spell_on)
    CHECK_ITEM("mnuStatus", status_on)
    CHECK_ITEM("mnuDark", dark_on)
    CHECK_ITEM("mnuMdOff", md_on = 0)
    CHECK_ITEM("mnuMdSplit", md_on = 1 ANDALSO md_layout = 1)
    CHECK_ITEM("mnuMdRendered", md_on = 1 ANDALSO md_layout = 2)
    DIM names AS ARRAY = ["mnuMdBold", "mnuMdItalic", "mnuMdStrike", "mnuMdCode", "mnuMdLink", "mnuMdH1", "mnuMdH2", "mnuMdH3", "mnuMdPara", "mnuMdBullet", "mnuMdNumber", "mnuMdQuote", "mnuMdCodeBlock", "mnuMdTable", "mnuMdImage", "mnuMdRule", "mnuMdRow", "mnuMdCol"]
    DIM i AS INTEGER = 0
    FOR i = 0 TO LEN(names) - 1
        FORM.SET(FORM.FIND(frm, names[i]), "ENABLED", md_on = 1)
    NEXT
ENDSUB

' ── load and save ───────────────────────────────────────────────

' Writing to ANSI drops what cp1252 cannot hold; a trial write finds out.
FUNC ANSI_SAFE(body AS STRING)
    DIM probe AS STRING = MKTEMP$("jdt")
    DIM same AS INTEGER = 0
    TRY
        TXTWRITER probe, body, FALSE, "cp1252"
        IF TXTREADER$(probe, "cp1252") = body THEN same = 1
        KILL probe
    CATCH
    ENDTRY
    RETURN same = 1
ENDFUNC

FUNC SAVE_TO(path AS STRING)
    MD_FLUSH()
    DIM body AS STRING = FORM.GET(txt, "TEXT")
    IF file_mixed THEN
        body = MIXED_BODY$(body)
    ELSEIF file_eol <> CRLF THEN
        body = REPLACE$(body, CRLF, file_eol)
    ENDIF
    IF file_enc = "cp1252" ANDALSO NOT ANSI_SAFE(body) THEN
        DIM answer AS INTEGER = MSGBOX("This file contains characters that ANSI cannot store; they would be lost." + CRLF + CRLF + "Save it as UTF-8 instead?", 3 + 48, APP_NAME)
        IF answer = 2 THEN RETURN FALSE
        IF answer = 6 THEN file_enc = "utf-8"
    ENDIF
    TRY
        TXTWRITER path, body, FALSE, file_enc
    CATCH
        MSGBOX("Cannot save " + path + CRLF + ERRMSG$, 16, APP_NAME)
        RETURN FALSE
    ENDTRY
    IF file_mixed THEN REMEMBER_LINES(body)
    file_path = path
    IF md_on THEN
        DIM rebased AS INTEGER = MDSYNC.SETOPTS(md_doc, {"base": MD_BASE$()})
    ENDIF
    REMEMBER_DISK()
    FORM.SET(txt, "MODIFIED", FALSE)
    ADD_RECENT(path)
    UPDATE_TITLE()
    UPDATE_STATUS()
    RETURN TRUE
ENDFUNC

FUNC SAVE_AS()
    DIM path AS STRING = FILESAVE$(TXT_FILTER, "Save As", DOC_NAME$())
    IF path = "" THEN RETURN FALSE
    IF PATH.EXT$(path) = "" THEN
        IF md_on THEN path = path + ".md" ELSE path = path + ".txt"
    ENDIF
    RETURN SAVE_TO(path)
ENDFUNC

FUNC SAVE_DOC()
    IF file_path = "" THEN RETURN SAVE_AS()
    IF file_ro THEN
        MSGBOX(DOC_NAME$() + " is read-only. Save it under another name.", 48, APP_NAME)
        RETURN SAVE_AS()
    ENDIF
    RETURN SAVE_TO(file_path)
ENDFUNC

' "Do you want to save changes?" - FALSE means stay put.
FUNC CONFIRM_DISCARD()
    MD_FLUSH()
    IF NOT FORM.GET(txt, "MODIFIED") THEN RETURN TRUE
    DIM answer AS INTEGER = MSGBOX("Do you want to save changes to " + DOC_NAME$() + "?", 3 + 48, APP_NAME)
    IF answer = 2 THEN RETURN FALSE
    IF answer = 6 THEN RETURN SAVE_DOC()
    RETURN TRUE
ENDFUNC

SUB LOAD_DOC(path AS STRING)
    DIM content AS STRING = ""
    DIM enc AS STRING = ""
    TRY
        enc = TXTENCODING$(path)
        content = TXTREADER$(path, enc)
    CATCH
        MSGBOX("Cannot open " + path + CRLF + ERRMSG$, 16, APP_NAME)
        RETURN
    ENDTRY
    file_enc = enc
    file_eol = CRLF
    IF INSTR(content, LF) >= 0 ANDALSO INSTR(content, CRLF) < 0 THEN file_eol = LF
    REMEMBER_LINES(content)
    FORM.SET(txt, "TEXT", TO_CRLF$(content))
    FORM.SET(txt, "MODIFIED", FALSE)
    FORM.SET(txt, "SELSTART", 0)
    file_path = path
    REMEMBER_DISK()
    doc_chars = CHAR_COUNT(FORM.GET(txt, "TEXT"))
    ADD_RECENT(path)
    IF IS_MD_PATH(path) THEN
        MD_START(md_pref)
    ELSEIF md_on THEN
        md_on = 0
        LAYOUT()
        MENU_CHECKS()
    ENDIF
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

SUB NEW_DOC()
    IF md_on THEN MD_STOP()
    FORM.SET(txt, "TEXT", "")
    FORM.SET(txt, "MODIFIED", FALSE)
    file_path = ""
    file_enc = "utf-8"
    file_eol = CRLF
    file_stamp = ""
    REMEMBER_LINES("")
    file_ro = 0
    doc_chars = 0
    MENU_CHECKS()
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

' Another program changed, replaced or deleted the file since it was loaded
' or saved. A reload keeps the caret where it was.
SUB CHECK_DISK()
    IF file_path = "" ORELSE disk_prompt ORELSE quitting THEN RETURN
    IF NOT FILE.EXISTS(file_path) THEN
        IF file_stamp = "" THEN RETURN
        file_stamp = ""
        disk_prompt = 1
        MSGBOX(DOC_NAME$() + " was deleted or moved by another program." + CRLF + "The text stays here; save it to keep it.", 48, APP_NAME)
        FORM.SET(txt, "MODIFIED", TRUE)
        UPDATE_TITLE()
        disk_prompt = 0
        RETURN
    ENDIF
    DIM stamp AS STRING = DISK_STAMP$(FILE.STAT(file_path))
    IF stamp = file_stamp THEN RETURN
    file_stamp = stamp
    disk_prompt = 1
    DIM ask AS STRING = DOC_NAME$() + " was changed by another program." + CRLF + CRLF + "Reload it?"
    IF FORM.GET(txt, "MODIFIED") THEN ask = ask + " Your changes here would be lost."
    IF MSGBOX(ask, 4 + 32, APP_NAME) = 6 THEN
        DIM keep AS INTEGER = CINT(FORM.GET(txt, "SELSTART"))
        LOAD_DOC(file_path)
        DIM n_text AS INTEGER = LEN(FORM.GET(txt, "TEXT"))
        IF keep > n_text THEN keep = n_text
        FORM.SET(txt, "SELSTART", keep)
        MD_FOLLOW()
        UPDATE_STATUS()
    ENDIF
    disk_prompt = 0
ENDSUB

' ── find and replace ────────────────────────────────────────────

' First hit at or after `from`, honouring "whole word"; -1 when none.
FUNC NEXT_HIT(hay AS STRING, needle AS STRING, start_at AS INTEGER) AS INTEGER
    IF NOT FORM.GET(chkWord, "CHECKED") THEN RETURN INSTR(start_at, hay, needle)
    RETURN CINT(TEXTX.FINDWORD(hay, needle, start_at))
ENDFUNC

' The search text as a pattern for REGEX: "Match case" off adds (?i),
' "whole word" puts \b around it.
FUNC RX_PATTERN$(needle AS STRING)
    DIM pat AS STRING = needle
    IF FORM.GET(chkWord, "CHECKED") THEN pat = "\b(?:" + pat + ")\b"
    IF NOT FORM.GET(chkCase, "CHECKED") THEN pat = "(?i)" + pat
    RETURN pat
ENDFUNC

' Every non-empty match of pat in hay as [start, length, replacement],
' start and length in bytes, the units of SELSTART; replacement is repl
' with $1, $2 and $& filled in from that match within the whole text.
' REGEX.REPLACE$ writes each match as M1 match M3 replacement M2, and the
' pieces between the markers give the positions.
FUNC RX_HITS(hay AS STRING, pat AS STRING, repl AS STRING) AS ARRAY
    DIM M1 AS STRING = CHR$(1)
    DIM M2 AS STRING = CHR$(2)
    DIM M3 AS STRING = CHR$(3)
    DIM hits AS ARRAY = []
    DIM both AS STRING = hay + repl
    IF INSTR(both, M1) >= 0 ORELSE INSTR(both, M2) >= 0 ORELSE INSTR(both, M3) >= 0 THEN RETURN hits
    DIM marked AS STRING = ""
    TRY
        marked = REGEX.REPLACE$(pat, hay, M1 + "$&" + M3 + repl + M2)
    CATCH
        RETURN hits
    ENDTRY
    DIM pieces AS ARRAY = SPLIT(marked, M1)
    DIM at AS INTEGER = LEN(pieces[0])
    DIM i AS INTEGER = 0
    FOR i = 1 TO LEN(pieces) - 1
        DIM piece AS STRING = pieces[i]
        DIM cut AS INTEGER = INSTR(piece, M3)
        DIM cut_end AS INTEGER = INSTR(piece, M2)
        IF cut > 0 THEN PUSH(hits, [at, cut, MID$(piece, cut + 1, cut_end - cut - 1)])
        at = at + cut + LEN(piece) - cut_end - 1
    NEXT
    RETURN hits
ENDFUNC

FUNC RX_FIND_FROM(needle AS STRING, upward AS INTEGER) AS INTEGER
    DIM hits AS ARRAY = RX_HITS(FORM.GET(ED(), "TEXT"), RX_PATTERN$(needle), "")
    IF LEN(hits) = 0 THEN RETURN -1
    DIM wrap_around AS INTEGER = FORM.GET(chkWrap, "CHECKED")
    DIM sel_start AS INTEGER = FORM.GET(ED(), "SELSTART")
    DIM after_sel AS INTEGER = sel_start + FORM.GET(ED(), "SELLENGTH")
    DIM pick AS INTEGER = -1
    DIM i AS INTEGER = 0
    IF upward THEN
        FOR i = 0 TO LEN(hits) - 1
            IF hits[i][0] < sel_start THEN pick = i
        NEXT
        IF pick < 0 ANDALSO wrap_around THEN pick = LEN(hits) - 1
    ELSE
        FOR i = LEN(hits) - 1 TO 0 STEP -1
            IF hits[i][0] >= after_sel THEN pick = i
        NEXT
        IF pick < 0 ANDALSO wrap_around THEN pick = 0
    ENDIF
    IF pick < 0 THEN RETURN -1
    hit_len = CINT(hits[pick][1])
    RETURN CINT(hits[pick][0])
ENDFUNC

FUNC FIND_FROM(needle AS STRING, upward AS INTEGER) AS INTEGER
    hit_len = LEN(needle)
    IF FORM.GET(chkRegex, "CHECKED") THEN RETURN RX_FIND_FROM(needle, upward)
    DIM hay AS STRING = FORM.GET(ED(), "TEXT")
    IF NOT FORM.GET(chkCase, "CHECKED") THEN
        hay = UCASE$(hay)
        needle = UCASE$(needle)
    ENDIF
    DIM wrap_around AS INTEGER = FORM.GET(chkWrap, "CHECKED")
    DIM sel_start AS INTEGER = FORM.GET(ED(), "SELSTART")
    IF NOT upward THEN
        DIM hit AS INTEGER = NEXT_HIT(hay, needle, sel_start + FORM.GET(ED(), "SELLENGTH"))
        IF hit < 0 ANDALSO wrap_around THEN hit = NEXT_HIT(hay, needle, 0)
        RETURN hit
    ENDIF
    DIM before AS INTEGER = -1
    DIM last_hit AS INTEGER = -1
    DIM probe AS INTEGER = NEXT_HIT(hay, needle, 0)
    DO WHILE probe >= 0
        IF probe < sel_start THEN before = probe
        last_hit = probe
        probe = NEXT_HIT(hay, needle, probe + 1)
    LOOP
    IF before < 0 ANDALSO wrap_around THEN before = last_hit
    RETURN before
ENDFUNC

SUB FIND_IN(upward AS INTEGER)
    DIM needle AS STRING = FORM.GET(txtFind, "TEXT")
    IF needle = "" THEN
        SHOW_FIND(FALSE)
        RETURN
    ENDIF
    DIM hit AS INTEGER = FIND_FROM(needle, upward)
    IF hit < 0 THEN
        MSGBOX("Cannot find " + CHR$(34) + needle + CHR$(34), 64, APP_NAME)
        RETURN
    ENDIF
    FORM.SET(ED(), "SELSTART", hit)
    FORM.SET(ED(), "SELLENGTH", hit_len)
    UPDATE_STATUS()
ENDSUB

FUNC SELECTION_MATCHES(needle AS STRING)
    DIM sel AS STRING = FORM.GET(ED(), "SELTEXT")
    IF FORM.GET(chkCase, "CHECKED") THEN RETURN sel = needle
    RETURN UCASE$(sel) = UCASE$(needle)
ENDFUNC

SUB SHOW_FIND(with_replace AS INTEGER)
    FORM.SET(lblRepl, "VISIBLE", with_replace)
    FORM.SET(txtRepl, "VISIBLE", with_replace)
    FORM.SET(btnRepl, "VISIBLE", with_replace)
    FORM.SET(btnAll, "VISIBLE", with_replace)
    IF with_replace THEN
        FORM.SET(dlg, "TEXT", "Replace")
    ELSE
        FORM.SET(dlg, "TEXT", "Find")
    ENDIF
    DIM sel AS STRING = FORM.GET(ED(), "SELTEXT")
    IF sel <> "" ANDALSO INSTR(sel, LF) < 0 THEN FORM.SET(txtFind, "TEXT", sel)
    FORM.SHOW(dlg)
    FORM.SET(txtFind, "FOCUS")
ENDSUB

' ── zoom ────────────────────────────────────────────────────────

SUB SET_ZOOM(pct AS INTEGER)
    IF pct < 10 THEN pct = 10
    IF pct > 500 THEN pct = 500
    zoom_pct = pct
    FORM.SET(txt, "ZOOM", pct)
    FORM.SET(mdv, "ZOOM", pct)
    UPDATE_STATUS()
ENDSUB

' ── main window events ──────────────────────────────────────────

SUB MAIN_LOAD(e)
    FORM.SET(txt, "FOCUS")
    UPDATE_STATUS()
ENDSUB

SUB MAIN_ACTIVATE(e)
    app_active = 1
    CHECK_DISK()
ENDSUB

SUB MAIN_DEACTIVATE(e)
    app_active = 0
ENDSUB

SUB MAIN_RESIZE(e)
    client_w = CINT(e[0]{"width"})
    client_h = CINT(e[0]{"height"})
    LAYOUT()
ENDSUB

SUB MAIN_UNLOAD(e)
    IF NOT CONFIRM_DISCARD() THEN
        e[0]{"cancel"} = TRUE
        RETURN
    ENDIF
    REG_PUT("Window", FORM.GET(frm, "PLACEMENT"))
    quitting = 1
    FORM.CLOSE(dlg)
ENDSUB

SUB OPEN_DROPPED(e)
    IF NOT CONFIRM_DISCARD() THEN RETURN
    LOAD_DOC(e[0]{"files"}[0])
ENDSUB

SUB MAIN_DROPFILES(e)
    OPEN_DROPPED(e)
ENDSUB

SUB TXT_DROPFILES(e)
    OPEN_DROPPED(e)
ENDSUB

SUB TXT_CHANGE(e)
    IF quitting THEN RETURN
    DIM now_text AS STRING = FORM.GET(txt, "TEXT")
    doc_chars = CHAR_COUNT(now_text)
    ' a span the view put here is no edit of the source
    IF md_on ANDALSO now_text <> MDSYNC.SOURCE$(md_doc) THEN
        md_dirty_src = 1
        md_edit_at = TICK()
    ENDIF
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

SUB TXT_KEYUP(e)
    IF quitting THEN RETURN
    MD_FOLLOW()
    MD_STATE()
    UPDATE_STATUS()
ENDSUB

SUB TXT_MOUSEUP(e)
    IF quitting THEN RETURN
    MD_FOLLOW()
    MD_STATE()
    UPDATE_STATUS()
ENDSUB

SUB TXT_GOTFOCUS(e)
    IF quitting THEN RETURN
    view_active = 0
    MD_STATE()
    CHECK_DISK()
ENDSUB

SUB MDV_CHANGE(e)
    IF quitting ORELSE NOT md_on THEN RETURN
    md_dirty_view = 1
    md_edit_at = TICK()
ENDSUB

SUB MDV_GOTFOCUS(e)
    IF quitting THEN RETURN
    view_active = 1
    MD_STATE()
    UPDATE_STATUS()
    CHECK_DISK()
ENDSUB

SUB MDV_KEYUP(e)
    IF quitting THEN RETURN
    MD_FOLLOW()
    MD_STATE()
    UPDATE_STATUS()
ENDSUB

SUB MDV_MOUSEUP(e)
    IF quitting THEN RETURN
    MD_FOLLOW()
    MD_STATE()
    UPDATE_STATUS()
ENDSUB

' A right-click opens the edit menu for the pane that was clicked; the pane
' takes the focus first, so the commands work on it.
SUB SHOW_EDIT_POPUP(pane AS DOUBLE)
    FORM.SET(pane, "FOCUS")
    view_active = 0
    IF pane = mdv THEN view_active = 1
    MD_STATE()
    UPDATE_STATUS()
    FORM.POPUP(frm, [ _
        {"text": "&Undo", "name": "popUndo"}, _
        {"text": "&Redo", "name": "popRedo"}, _
        "-", _
        {"text": "Cu&t", "name": "popCut"}, _
        {"text": "&Copy", "name": "popCopy"}, _
        {"text": "&Paste", "name": "popPaste"}, _
        {"text": "&Delete", "name": "popDelete"}, _
        "-", _
        {"text": "Select &All", "name": "popSelAll"}])
ENDSUB

SUB TXT_MOUSEDOWN(e)
    IF quitting ORELSE CINT(e[0]{"button"}) <> 2 THEN RETURN
    SHOW_EDIT_POPUP(txt)
ENDSUB

SUB MDV_MOUSEDOWN(e)
    IF quitting ORELSE CINT(e[0]{"button"}) <> 2 THEN RETURN
    SHOW_EDIT_POPUP(mdv)
ENDSUB

SUB POPUNDO_CLICK(e)
    MNUUNDO_CLICK(e)
ENDSUB

