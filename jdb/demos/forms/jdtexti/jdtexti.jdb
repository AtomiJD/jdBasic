' ── Find / Replace window ───────────────────────────────────────

SUB FINDDLG_UNLOAD(e)
    IF quitting = 0 THEN
        e[0]{"cancel"} = TRUE
        FORM.SET(dlg, "VISIBLE", FALSE)
    ENDIF
ENDSUB

SUB BTNFINDNEXT_CLICK(e)
    FIND_IN(FORM.GET(optUp, "CHECKED"))
ENDSUB

SUB BTNREPLACE_CLICK(e)
    DIM needle AS STRING = FORM.GET(txtFind, "TEXT")
    IF needle = "" THEN RETURN
    IF SELECTION_MATCHES(needle) THEN FORM.SET(ED(), "SELTEXT", FORM.GET(txtRepl, "TEXT"))
    FIND_IN(FORM.GET(optUp, "CHECKED"))
ENDSUB

' Rebuilds the text and swaps it in through SELTEXT, so one Undo restores it.
SUB BTNREPLACEALL_CLICK(e)
    DIM needle AS STRING = FORM.GET(txtFind, "TEXT")
    IF needle = "" THEN RETURN
    MD_FLUSH()
    DIM src AS STRING = FORM.GET(txt, "TEXT")
    DIM repl AS STRING = FORM.GET(txtRepl, "TEXT")
    DIM hay AS STRING = src
    IF NOT FORM.GET(chkCase, "CHECKED") THEN
        hay = UCASE$(src)
        needle = UCASE$(needle)
    ENDIF
    DIM rebuilt AS STRING = ""
    DIM done_to AS INTEGER = 0
    DIM hits AS INTEGER = 0
    DIM hit AS INTEGER = NEXT_HIT(hay, needle, 0)
    DO WHILE hit >= 0
        rebuilt = rebuilt + MID$(src, done_to, hit - done_to) + repl
        done_to = hit + LEN(needle)
        hits = hits + 1
        hit = NEXT_HIT(hay, needle, done_to)
    LOOP
    IF hits = 0 THEN
        MSGBOX("Cannot find " + CHR$(34) + FORM.GET(txtFind, "TEXT") + CHR$(34), 64, APP_NAME)
        RETURN
    ENDIF
    rebuilt = rebuilt + MID$(src, done_to, LEN(src) - done_to)
    FORM.SET(txt, "SELSTART", 0)
    FORM.SET(txt, "SELLENGTH", LEN(src))
    FORM.SET(txt, "SELTEXT", rebuilt)
    FORM.SET(txt, "SELSTART", 0)
    IF md_on THEN
        md_dirty_src = 1
        MD_FLUSH()
    ENDIF
    UPDATE_STATUS()
ENDSUB

SUB BTNCANCEL_CLICK(e)
    FORM.SET(dlg, "VISIBLE", FALSE)
    FORM.SET(ED(), "FOCUS")
ENDSUB

' ── build the windows ───────────────────────────────────────────

LOAD_RECENT()
frm = FORM.CREATE("Untitled - " + APP_NAME, client_w, client_h, "MAIN")

txt = FORM.RICHTEXT(frm, "txt", 0, 0, client_w, client_h - SB_HEIGHT)
FORM.SET(txt, "PLAINTEXT", TRUE)
FORM.SET(txt, "MAXLENGTH", 0)
FORM.SET(txt, "WORDWRAP", FALSE)
FORM.SET(txt, "HIDESELECTION", FALSE)
FORM.SET(txt, "ACCEPTSTAB", TRUE)
FORM.SET(txt, "SPELLCHECK", TRUE)
FORM.SET(txt, "DROPFILES", TRUE)
FORM.SET(frm, "DROPFILES", TRUE)
APPLY_FONT()
FORM.SET(txt, "TABWIDTH", tab_w)
mdv = FORM.RICHTEXT(frm, "mdv", 0, 0, client_w, client_h - SB_HEIGHT)
FORM.SET(mdv, "MAXLENGTH", 0)
FORM.SET(mdv, "HIDESELECTION", FALSE)
FORM.SET(mdv, "SPELLCHECK", TRUE)
FORM.SET(mdv, "VISIBLE", FALSE)

DIM bar_spec AS ARRAY = [["btnMdB", "B", 30], ["btnMdI", "I", 30], ["btnMdS", "S", 30], ["btnMdCode", "</>", 40], _
    ["btnMdH1", "H1", 36], ["btnMdH2", "H2", 36], ["btnMdH3", "H3", 36], ["btnMdPara", "Text", 44], _
    ["btnMdBullet", "List", 44], ["btnMdNumber", "1. List", 54], ["btnMdQuote", "Quote", 50], _
    ["btnMdBlock", "Code", 48], ["btnMdLink", "Link", 44]]
DIM bar_x AS INTEGER = 4
DIM bi AS INTEGER = 0
FOR bi = 0 TO LEN(bar_spec) - 1
    DIM spec AS ARRAY = bar_spec[bi]
    DIM bw AS INTEGER = CINT(spec[2])
    DIM bh AS DOUBLE = FORM.BUTTON(frm, spec[0], spec[1], bar_x, 3, bw, 24)
    FORM.SET(bh, "VISIBLE", FALSE)
    md_bar = APPEND(md_bar, bh)
    bar_x = bar_x + bw + 2
    IF bi = 3 ORELSE bi = 7 ORELSE bi = 11 THEN bar_x = bar_x + 8
NEXT

sb = FORM.STATUSBAR(frm, "sb", [140, 180, 60, 120, -1])
BUILD_MENU()
FORM.TIMER(frm, "tmrZoom", 400)
FORM.TIMER(frm, "tmrSync", 250)

dlg = FORM.CREATE("Find", 430, 150, "FINDDLG")
FORM.SET(dlg, "BORDERSTYLE", 3)
FORM.SET(dlg, "OWNER", frm)
FORM.LABEL(dlg, "lblFind", "Fi&nd what:", 10, 14, 80, 18)
txtFind = FORM.TEXTBOX(dlg, "txtFind", "", 92, 10, 220, 22)
lblRepl = FORM.LABEL(dlg, "lblRepl", "Re&place with:", 10, 42, 80, 18)
txtRepl = FORM.TEXTBOX(dlg, "txtRepl", "", 92, 38, 220, 22)
chkCase = FORM.CHECKBOX(dlg, "chkCase", "Match &case", 10, 72, 130, 20)
chkWord = FORM.CHECKBOX(dlg, "chkWord", "Match &whole word", 10, 96, 130, 20)
chkWrap = FORM.CHECKBOX(dlg, "chkWrap", "Wrap ar&ound", 10, 120, 130, 20)
FORM.SET(chkWrap, "CHECKED", TRUE)
FORM.FRAME(dlg, "fraDir", "Direction", 160, 72, 152, 52)
optUp = FORM.RADIO(dlg, "optUp", "&Up", 172, 94, 60, 20, TRUE)
DIM optDown AS DOUBLE = FORM.RADIO(dlg, "optDown", "&Down", 238, 94, 66, 20)
FORM.SET(optDown, "CHECKED", TRUE)
FORM.BUTTON(dlg, "btnFindNext", "&Find Next", 326, 9, 94, 26)
btnRepl = FORM.BUTTON(dlg, "btnReplace", "&Replace", 326, 39, 94, 26)
btnAll = FORM.BUTTON(dlg, "btnReplaceAll", "Replace &All", 326, 69, 94, 26)
FORM.BUTTON(dlg, "btnCancel", "Cancel", 326, 115, 94, 26)

DIM args AS ARRAY = OS.ARGS()
IF LEN(args) > 1 THEN LOAD_DOC(args[1])
UPDATE_TITLE()

FORM.RUN(frm)
