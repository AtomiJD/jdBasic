' Edits are carried to the other pane a moment after typing stops, so a
' long file stays quick to type in; saving and the format commands carry
' them at once.
SUB TMRSYNC_TICK(e)
    IF quitting ORELSE NOT md_on THEN RETURN
    IF md_dirty_view ORELSE md_dirty_src THEN
        MD_FLUSH()
        UPDATE_TITLE()
        UPDATE_STATUS()
    ENDIF
ENDSUB

' Ctrl+wheel zooms inside the control; the status bar follows it here.
SUB TMRZOOM_TICK(e)
    IF quitting THEN RETURN
    DIM z AS INTEGER = CINT(FORM.GET(txt, "ZOOM"))
    IF z <> zoom_pct THEN
        zoom_pct = z
        UPDATE_STATUS()
    ENDIF
ENDSUB

