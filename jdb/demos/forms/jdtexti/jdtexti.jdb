' Fills the hidden copy of the view with the document drawn light, its
' tables cut down to the width inside the page margins.
SUB MD_PAPER()
    MD_FLUSH()
    DIM area AS MAP = FORM.PRINTAREA()
    FORM.SET(mdprint, "TEXTRTF", MDRICH.DOC$(MDSYNC.BLOCKS(md_doc), {"base": MD_BASE$(), "table_width": CINT(area{"width"})}))
ENDSUB

' The rendered view prints as it is shown while it has the focus or is
' shown alone, the source as plain text otherwise. It goes to paper drawn
' light, with every table inside the margins.
SUB MNUPRINT_CLICK(e)
    TRY
        IF md_on ANDALSO (view_active ORELSE md_layout = 2) THEN
            MD_PAPER()
            FORM.PRINTRICH(mdprint, DOC_NAME$())
        ELSE
            FORM.PRINT(FORM.GET(txt, "TEXT"), DOC_NAME$(), {"name": font_face, "size": font_size})
        ENDIF
    CATCH
        MSGBOX("Printing failed." + CRLF + ERRMSG$, 16, APP_NAME)
    ENDTRY
ENDSUB

SUB MNUEXIT_CLICK(e)
    FORM.CLOSE(frm)
ENDSUB

' ── Edit ────────────────────────────────────────────────────────

' With Markdown shown there is one history, the source's: every edit in the
' view reaches the source as one undoable step, and a redraw of the view
' (a table, a kind change) leaves the view's own history empty. Undo and
' Redo step the source and redraw the view from it.
SUB MD_HISTORY(prop AS STRING)
    MD_FLUSH()
    FORM.SET(txt, prop, TRUE)
    md_dirty_src = 1
    MD_FLUSH()
    MD_STATE()
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

SUB MNUUNDO_CLICK(e)
    IF md_on THEN
        MD_HISTORY("UNDO")
    ELSE
        FORM.SET(ED(), "UNDO", TRUE)
    ENDIF
ENDSUB

SUB MNUREDO_CLICK(e)
    IF md_on THEN
        MD_HISTORY("REDO")
    ELSE
        FORM.SET(ED(), "REDO", TRUE)
    ENDIF
ENDSUB

' The selection in the view as plain text: table cells apart by a tab, a
' line per paragraph and row, without RichEdit's row and cell marks.
FUNC VIEW_PLAIN$()
    DIM s AS STRING = REPLACE$(FORM.GET(mdv, "SELTEXT"), CRLF, CR)
    s = REPLACE$(REPLACE$(s, CHR$(65529) + CR, ""), CHR$(65531), "")
    s = REPLACE$(REPLACE$(s, CHR$(65529), ""), CHR$(7), CHR$(9))
    RETURN REPLACE$(REPLACE$(s, CHR$(11), CR), CR, CRLF)
ENDFUNC

' The Markdown of every block a view selection touches as an HTML fragment,
' tables ruled and pictures addressed by their full path; "" when the
' selection lies inside one block, whose Markdown would be more than it.
FUNC VIEW_HTML$(sel_from AS INTEGER, sel_len AS INTEGER)
    DIM k_first AS INTEGER = CINT(MDSYNC.BLOCKAT(md_doc, sel_from))
    DIM k_last AS INTEGER = CINT(MDSYNC.BLOCKAT(md_doc, sel_from + sel_len - 1))
    IF k_first = k_last ANDALSO sel_len < LEN(FORM.GET(mdv, "TEXT")) THEN
        DIM blk_from AS INTEGER = CINT(MDSYNC.VIEWPOS(md_doc, k_first))
        DIM blk_to AS INTEGER = CINT(MDSYNC.VIEWPOS(md_doc, k_first + 1))
        IF sel_from > blk_from ORELSE sel_from + sel_len < blk_to - 1 THEN RETURN ""
    ENDIF
    DIM src_from AS INTEGER = CINT(MDSYNC.SOURCEPOS(md_doc, k_first))
    DIM src_to AS INTEGER = CINT(MDSYNC.SOURCEPOS(md_doc, k_last + 1))
    DIM h AS STRING = MD.RENDER$(MID$(MDSYNC.SOURCE$(md_doc), src_from, src_to - src_from))
    DIM cell_css AS STRING = "border:1px solid #888;padding:3px 6px;"
    h = REPLACE$(h, "<table>", "<table style=" + CHR$(34) + "border-collapse:collapse" + CHR$(34) + ">")
    h = REPLACE$(REPLACE$(h, "<th style=" + CHR$(34), "<th style=" + CHR$(34) + cell_css), "<td style=" + CHR$(34), "<td style=" + CHR$(34) + cell_css)
    h = REPLACE$(REPLACE$(h, "<th>", "<th style=" + CHR$(34) + cell_css + CHR$(34) + ">"), "<td>", "<td style=" + CHR$(34) + cell_css + CHR$(34) + ">")
    h = REPLACE$(h, "<code>", "<code style=" + CHR$(34) + "background:#F0F0F0" + CHR$(34) + ">")
    DIM base_url AS STRING = "file:///" + REPLACE$(REPLACE$(PATH.ABS$(MD_BASE$()), "\", "/"), " ", "%20") + "/"
    h = REGEX.REPLACE$("src=" + CHR$(34) + "(?![a-zA-Z][a-zA-Z0-9+.-]*:|/)", h, "src=" + CHR$(34) + base_url)
    RETURN "<div style=" + CHR$(34) + "font-family:'Segoe UI',sans-serif;font-size:11pt" + CHR$(34) + ">" + h + "</div>"
ENDFUNC

' A selection in the rendered view goes to the clipboard three ways: as
' HTML, which Word takes before the plain text, as the RTF it would print
' (drawn light, tables inside the page width) and as plain text. The paper
' copy holds the same text as the view, so the selection carries over by
' offset.
SUB COPY_SELECTION()
    DIM ed_now AS DOUBLE = ED()
    IF ed_now <> mdv THEN
        FORM.SET(ed_now, "COPY", TRUE)
        RETURN
    ENDIF
    DIM sel_from AS INTEGER = CINT(FORM.GET(mdv, "SELSTART"))
    DIM sel_len AS INTEGER = CINT(FORM.GET(mdv, "SELLENGTH"))
    IF sel_len <= 0 THEN RETURN
    MD_PAPER()
    IF FORM.GET(mdprint, "TEXT") <> FORM.GET(mdv, "TEXT") THEN
        FORM.SET(mdv, "COPY", TRUE)
        RETURN
    ENDIF
    FORM.SET(mdprint, "SELSTART", sel_from)
    FORM.SET(mdprint, "SELLENGTH", sel_len)
    CLIPBOARD.SET VIEW_PLAIN$(), FORM.GET(mdprint, "SELRTF"), VIEW_HTML$(sel_from, sel_len)
ENDSUB

SUB MNUCUT_CLICK(e)
    IF ED() <> mdv THEN
        FORM.SET(ED(), "CUT", TRUE)
        RETURN
    ENDIF
    IF FORM.GET(mdv, "SELTEXT") = "" THEN RETURN
    COPY_SELECTION()
    FORM.SET(mdv, "SELTEXT", "")
ENDSUB

SUB MNUCOPY_CLICK(e)
    COPY_SELECTION()
ENDSUB

