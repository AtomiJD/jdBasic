SUB TXT_CHANGE(e)
    IF quitting THEN RETURN
    DIM now_text AS STRING = FORM.GET(txt, "TEXT")
    doc_chars = CHAR_COUNT(now_text)
    ' a span the view put here is no edit of the source
    IF md_on ANDALSO now_text <> MDSYNC.SOURCE$(md_doc) THEN md_dirty_src = 1
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

