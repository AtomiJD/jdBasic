' jdNotepad - a Windows Notepad clone on native forms (FORMS build).
' File, Edit, Format, View and Help menus, a modeless Find/Replace window,
' word wrap, font choice and a status bar with the caret position.
' Files keep their encoding (UTF-8, UTF-8 with BOM, UTF-16, ANSI) and line
' endings on save, and can be dropped onto the window from Explorer.
'
'   jdbasic notepad.jdb [file.txt]
OPTION "EXPLICIT"

DIM APP_NAME AS STRING = "jdNotepad"
DIM CRLF AS STRING = CHR$(13) + CHR$(10)
DIM TXT_FILTER AS STRING = "Text files (*.txt)|*.txt|All files (*.*)|*.*"
DIM SB_HEIGHT AS INTEGER = 22

DIM frm AS DOUBLE = 0
DIM txt AS DOUBLE = 0
DIM sb AS DOUBLE = 0
DIM dlg AS DOUBLE = 0
DIM txtFind AS DOUBLE = 0
DIM txtRepl AS DOUBLE = 0
DIM chkCase AS DOUBLE = 0
DIM optUp AS DOUBLE = 0
DIM optDown AS DOUBLE = 0
DIM lblRepl AS DOUBLE = 0
DIM btnRepl AS DOUBLE = 0
DIM btnAll AS DOUBLE = 0

DIM file_path AS STRING = ""
DIM file_enc AS STRING = "utf-8"
DIM file_eol AS STRING = CRLF
DIM font_face AS STRING = "Consolas"
DIM font_size AS INTEGER = 11
DIM quitting AS INTEGER = 0
DIM client_w AS INTEGER = 720
DIM client_h AS INTEGER = 480

' ── helpers ─────────────────────────────────────────────────────

FUNC DOC_NAME$()
    IF file_path = "" THEN RETURN "Untitled"
    RETURN PATH.BASENAME$(file_path)
ENDFUNC

SUB UPDATE_TITLE()
    DIM mark AS STRING = ""
    IF FORM.GET(txt, "MODIFIED") THEN mark = "*"
    FORM.SET(frm, "TEXT", mark + DOC_NAME$() + " - " + APP_NAME)
ENDSUB

FUNC ENC_LABEL$(enc AS STRING)
    SWITCH enc
        CASE "utf-8-bom"
            RETURN "UTF-8 with BOM"
        CASE "utf-16le"
            RETURN "UTF-16 LE"
        CASE "utf-16be"
            RETURN "UTF-16 BE"
        CASE "cp1252"
            RETURN "ANSI"
    ENDSWITCH
    RETURN "UTF-8"
ENDFUNC

SUB UPDATE_STATUS()
    DIM pos AS STRING = "Ln " + STR$(FORM.GET(txt, "CARETLINE")) + ", Col " + STR$(FORM.GET(txt, "CARETCOL"))
    DIM eol AS STRING = "Windows (CRLF)"
    IF file_eol <> CRLF THEN eol = "Unix (LF)"
    FORM.SET(sb, "TEXT", [pos, eol, ENC_LABEL$(file_enc)])
ENDSUB

SUB LAYOUT()
    DIM h AS INTEGER = client_h
    IF FORM.GET(FORM.FIND(frm, "mnuStatus"), "CHECKED") THEN h = h - SB_HEIGHT
    FORM.SET(txt, "WIDTH", client_w)
    FORM.SET(txt, "HEIGHT", h)
ENDSUB

SUB APPLY_FONT()
    FORM.SET(txt, "FONT", {"name": font_face, "size": font_size})
ENDSUB

' The edit control wants CRLF; files arrive with LF, CRLF or a mix.
FUNC TO_CRLF$(s AS STRING)
    RETURN REPLACE$(REPLACE$(s, CRLF, CHR$(10)), CHR$(10), CRLF)
ENDFUNC

FUNC SAVE_TO(path AS STRING)
    DIM body AS STRING = FORM.GET(txt, "TEXT")
    IF file_eol <> CRLF THEN body = REPLACE$(body, CRLF, file_eol)
    ' TXTWRITER writes UTF-16 without a BOM; Notepad's UTF-16 files carry one
    IF LEFT$(file_enc, 6) = "utf-16" THEN body = CHR$(65279) + body
    TRY
        TXTWRITER path, body, FALSE, file_enc
    CATCH
        MSGBOX("Cannot save " + path + CRLF + ERRMSG$, 16, APP_NAME)
        RETURN FALSE
    ENDTRY
    file_path = path
    FORM.SET(txt, "MODIFIED", FALSE)
    UPDATE_TITLE()
    RETURN TRUE
ENDFUNC

FUNC SAVE_AS()
    DIM path AS STRING = FILESAVE$(TXT_FILTER, "Save As", DOC_NAME$() + ".txt")
    IF path = "" THEN RETURN FALSE
    IF PATH.EXT$(path) = "" THEN path = path + ".txt"
    RETURN SAVE_TO(path)
ENDFUNC

FUNC SAVE_DOC()
    IF file_path = "" THEN RETURN SAVE_AS()
    RETURN SAVE_TO(file_path)
ENDFUNC

' Notepad's "Do you want to save changes?" - FALSE means stay put.
FUNC CONFIRM_DISCARD()
    IF NOT FORM.GET(txt, "MODIFIED") THEN RETURN TRUE
    DIM answer AS INTEGER = MSGBOX("Do you want to save changes to " + DOC_NAME$() + "?", 3 + 48, APP_NAME)
    IF answer = 2 THEN RETURN FALSE
    IF answer = 6 THEN RETURN SAVE_DOC()
    RETURN TRUE
ENDFUNC

SUB LOAD_DOC(path AS STRING)
    DIM content AS STRING = ""
    DIM enc AS STRING = ""
    TRY
        enc = TXTENCODING$(path)
        content = TXTREADER$(path, enc)
    CATCH
        MSGBOX("Cannot open " + path + CRLF + ERRMSG$, 16, APP_NAME)
        RETURN
    ENDTRY
    file_enc = enc
    file_eol = CRLF
    IF INSTR(content, CHR$(10)) >= 0 ANDALSO INSTR(content, CRLF) < 0 THEN file_eol = CHR$(10)
    FORM.SET(txt, "TEXT", TO_CRLF$(content))
    FORM.SET(txt, "MODIFIED", FALSE)
    FORM.SET(txt, "SELSTART", 0)
    file_path = path
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

' Searches from the selection in the chosen direction and wraps around.
' Returns the byte position of the hit or -1.
FUNC FIND_FROM(needle AS STRING, upward AS INTEGER)
    DIM hay AS STRING = FORM.GET(txt, "TEXT")
    IF NOT FORM.GET(chkCase, "CHECKED") THEN
        hay = UCASE$(hay)
        needle = UCASE$(needle)
    ENDIF
    DIM sel_start AS INTEGER = FORM.GET(txt, "SELSTART")
    DIM hit AS INTEGER = -1
    IF upward THEN
        DIM probe AS INTEGER = INSTR(0, hay, needle)
        DIM last_hit AS INTEGER = -1
        DO WHILE probe >= 0
            IF probe < sel_start THEN hit = probe
            last_hit = probe
            probe = INSTR(probe + 1, hay, needle)
        LOOP
        IF hit < 0 THEN hit = last_hit
    ELSE
        hit = INSTR(sel_start + FORM.GET(txt, "SELLENGTH"), hay, needle)
        IF hit < 0 THEN hit = INSTR(0, hay, needle)
    ENDIF
    RETURN hit
ENDFUNC

SUB FIND_NEXT()
    DIM needle AS STRING = FORM.GET(txtFind, "TEXT")
    IF needle = "" THEN
        SHOW_FIND(FALSE)
        RETURN
    ENDIF
    DIM hit AS INTEGER = FIND_FROM(needle, FORM.GET(optUp, "CHECKED"))
    IF hit < 0 THEN
        MSGBOX("Cannot find " + CHR$(34) + needle + CHR$(34), 64, APP_NAME)
        RETURN
    ENDIF
    FORM.SET(txt, "SELSTART", hit)
    FORM.SET(txt, "SELLENGTH", LEN(needle))
    UPDATE_STATUS()
ENDSUB

FUNC SELECTION_MATCHES(needle AS STRING)
    DIM sel AS STRING = FORM.GET(txt, "SELTEXT")
    IF FORM.GET(chkCase, "CHECKED") THEN RETURN sel = needle
    RETURN UCASE$(sel) = UCASE$(needle)
ENDFUNC

SUB SHOW_FIND(with_replace AS INTEGER)
    FORM.SET(lblRepl, "VISIBLE", with_replace)
    FORM.SET(txtRepl, "VISIBLE", with_replace)
    FORM.SET(btnRepl, "VISIBLE", with_replace)
    FORM.SET(btnAll, "VISIBLE", with_replace)
    IF with_replace THEN
        FORM.SET(dlg, "TEXT", "Replace")
    ELSE
        FORM.SET(dlg, "TEXT", "Find")
    ENDIF
    DIM sel AS STRING = FORM.GET(txt, "SELTEXT")
    IF sel <> "" ANDALSO INSTR(sel, CHR$(10)) < 0 THEN FORM.SET(txtFind, "TEXT", sel)
    FORM.SHOW(dlg)
    FORM.SET(txtFind, "FOCUS")
ENDSUB

' ── main window events ──────────────────────────────────────────

SUB MAIN_LOAD(e)
    FORM.SET(txt, "FOCUS")
    UPDATE_STATUS()
ENDSUB

SUB MAIN_RESIZE(e)
    client_w = e[0]{"width"}
    client_h = e[0]{"height"}
    LAYOUT()
ENDSUB

SUB MAIN_UNLOAD(e)
    IF NOT CONFIRM_DISCARD() THEN
        e[0]{"cancel"} = TRUE
        RETURN
    ENDIF
    quitting = 1
    FORM.CLOSE(dlg)
ENDSUB

SUB TXT_CHANGE(e)
    IF quitting THEN RETURN
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

SUB OPEN_DROPPED(e)
    IF NOT CONFIRM_DISCARD() THEN RETURN
    LOAD_DOC(e[0]{"files"}[0])
ENDSUB

SUB MAIN_DROPFILES(e)
    OPEN_DROPPED(e)
ENDSUB

SUB TXT_DROPFILES(e)
    OPEN_DROPPED(e)
ENDSUB

SUB TXT_KEYUP(e)
    IF quitting THEN RETURN
    UPDATE_STATUS()
ENDSUB

SUB TXT_MOUSEUP(e)
    IF quitting THEN RETURN
    UPDATE_STATUS()
ENDSUB

' ── File ────────────────────────────────────────────────────────

SUB MNUNEW_CLICK(e)
    IF NOT CONFIRM_DISCARD() THEN RETURN
    FORM.SET(txt, "TEXT", "")
    FORM.SET(txt, "MODIFIED", FALSE)
    file_path = ""
    file_enc = "utf-8"
    file_eol = CRLF
    UPDATE_TITLE()
    UPDATE_STATUS()
ENDSUB

SUB MNUOPEN_CLICK(e)
    IF NOT CONFIRM_DISCARD() THEN RETURN
    DIM path AS STRING = FILEOPEN$(TXT_FILTER, "Open")
    IF path <> "" THEN LOAD_DOC(path)
ENDSUB

SUB MNUSAVE_CLICK(e)
    SAVE_DOC()
ENDSUB

SUB MNUSAVEAS_CLICK(e)
    SAVE_AS()
ENDSUB

SUB MNUEXIT_CLICK(e)
    FORM.CLOSE(frm)
ENDSUB

' ── Edit ────────────────────────────────────────────────────────

SUB MNUUNDO_CLICK(e)
    FORM.SET(txt, "UNDO", TRUE)
ENDSUB

SUB MNUCUT_CLICK(e)
    FORM.SET(txt, "CUT", TRUE)
ENDSUB

SUB MNUCOPY_CLICK(e)
    FORM.SET(txt, "COPY", TRUE)
ENDSUB

SUB MNUPASTE_CLICK(e)
    FORM.SET(txt, "PASTE", TRUE)
ENDSUB

SUB MNUDELETE_CLICK(e)
    FORM.SET(txt, "SELTEXT", "")
ENDSUB

SUB MNUFIND_CLICK(e)
    SHOW_FIND(FALSE)
ENDSUB

SUB MNUFINDNEXT_CLICK(e)
    FIND_NEXT()
ENDSUB

SUB MNUREPLACE_CLICK(e)
    SHOW_FIND(TRUE)
ENDSUB

SUB MNUGOTO_CLICK(e)
    DIM answer AS STRING = INPUTBOX$("Line number:", "Go To Line", STR$(FORM.GET(txt, "CARETLINE")))
    IF answer = "" THEN RETURN
    DIM target AS INTEGER = CINT(VAL(answer))
    DIM lines AS ARRAY = SPLIT(FORM.GET(txt, "TEXT"), CHR$(10))
    IF target < 1 ORELSE target > LEN(lines) THEN
        MSGBOX("The line number is beyond the total number of lines", 64, APP_NAME + " - Goto Line")
        RETURN
    ENDIF
    ' each line keeps its CR, so line + LF covers the full stride
    DIM offset AS INTEGER = 0
    DIM i AS INTEGER = 0
    FOR i = 0 TO target - 2
        offset = offset + LEN(lines[i]) + 1
    NEXT
    FORM.SET(txt, "SELSTART", offset)
    UPDATE_STATUS()
ENDSUB

SUB MNUSELALL_CLICK(e)
    FORM.SET(txt, "SELSTART", 0)
    FORM.SET(txt, "SELLENGTH", LEN(FORM.GET(txt, "TEXT")))
ENDSUB

SUB MNUTIMEDATE_CLICK(e)
    FORM.SET(txt, "SELTEXT", TIME$() + " " + DATE$())
ENDSUB

' ── Format / View / Help ────────────────────────────────────────

SUB MNUWRAP_CLICK(e)
    DIM item AS DOUBLE = FORM.FIND(frm, "mnuWrap")
    DIM wrap AS INTEGER = NOT FORM.GET(item, "CHECKED")
    FORM.SET(item, "CHECKED", wrap)
    FORM.SET(txt, "WORDWRAP", wrap)
ENDSUB

SUB MNUFONT_CLICK(e)
    DIM picked AS STRING = FONTDIALOG$(font_face, font_size)
    IF picked = "" THEN RETURN
    DIM parts AS ARRAY = SPLIT(picked, ",")
    font_face = parts[0]
    font_size = CINT(VAL(parts[1]))
    FORM.SET(txt, "FONT", {"name": font_face, "size": font_size, "bold": parts[2] = "1", "italic": parts[3] = "1"})
ENDSUB

SUB MNUSTATUS_CLICK(e)
    DIM item AS DOUBLE = FORM.FIND(frm, "mnuStatus")
    DIM shown AS INTEGER = NOT FORM.GET(item, "CHECKED")
    FORM.SET(item, "CHECKED", shown)
    FORM.SET(sb, "VISIBLE", shown)
    LAYOUT()
ENDSUB

SUB MNUABOUT_CLICK(e)
    MSGBOX(APP_NAME + CRLF + CRLF + "A Notepad clone written in jdBasic" + CRLF + "on native Windows forms.", 64, "About " + APP_NAME)
ENDSUB

' ── Find / Replace window ───────────────────────────────────────

SUB FINDDLG_UNLOAD(e)
    IF quitting = 0 THEN
        e[0]{"cancel"} = TRUE
        FORM.SET(dlg, "VISIBLE", FALSE)
    ENDIF
ENDSUB

SUB BTNFINDNEXT_CLICK(e)
    FIND_NEXT()
ENDSUB

SUB BTNREPLACE_CLICK(e)
    DIM needle AS STRING = FORM.GET(txtFind, "TEXT")
    IF needle = "" THEN RETURN
    IF SELECTION_MATCHES(needle) THEN FORM.SET(txt, "SELTEXT", FORM.GET(txtRepl, "TEXT"))
    FIND_NEXT()
ENDSUB

' Rebuilds the text and swaps it in through SELTEXT, so one Undo restores it.
SUB BTNREPLACEALL_CLICK(e)
    DIM needle AS STRING = FORM.GET(txtFind, "TEXT")
    IF needle = "" THEN RETURN
    DIM src AS STRING = FORM.GET(txt, "TEXT")
    DIM repl AS STRING = FORM.GET(txtRepl, "TEXT")
    DIM hay AS STRING = src
    IF NOT FORM.GET(chkCase, "CHECKED") THEN
        hay = UCASE$(src)
        needle = UCASE$(needle)
    ENDIF
    DIM out AS STRING = ""
    DIM done_to AS INTEGER = 0
    DIM hits AS INTEGER = 0
    DIM hit AS INTEGER = INSTR(0, hay, needle)
    DO WHILE hit >= 0
        out = out + MID$(src, done_to, hit - done_to) + repl
        done_to = hit + LEN(needle)
        hits = hits + 1
        hit = INSTR(done_to, hay, needle)
    LOOP
    IF hits = 0 THEN
        MSGBOX("Cannot find " + CHR$(34) + FORM.GET(txtFind, "TEXT") + CHR$(34), 64, APP_NAME)
        RETURN
    ENDIF
    out = out + MID$(src, done_to, LEN(src) - done_to)
    FORM.SET(txt, "SELSTART", 0)
    FORM.SET(txt, "SELLENGTH", LEN(src))
    FORM.SET(txt, "SELTEXT", out)
    FORM.SET(txt, "SELSTART", 0)
    UPDATE_STATUS()
ENDSUB

SUB BTNCANCEL_CLICK(e)
    FORM.SET(dlg, "VISIBLE", FALSE)
    FORM.SET(txt, "FOCUS")
ENDSUB

' ── build the windows ───────────────────────────────────────────

frm = FORM.CREATE("Untitled - " + APP_NAME, client_w, client_h, "MAIN")
FORM.MENU(frm, [ _
    {"text": "&File", "items": [ _
        {"text": "&New", "name": "mnuNew", "key": "Ctrl+N"}, _
        {"text": "&Open...", "name": "mnuOpen", "key": "Ctrl+O"}, _
        {"text": "&Save", "name": "mnuSave", "key": "Ctrl+S"}, _
        {"text": "Save &As...", "name": "mnuSaveAs", "key": "Ctrl+Shift+S"}, _
        {"text": "-"}, _
        {"text": "E&xit", "name": "mnuExit"}]}, _
    {"text": "&Edit", "items": [ _
        {"text": "&Undo", "name": "mnuUndo", "key": "Ctrl+Z"}, _
        {"text": "-"}, _
        {"text": "Cu&t", "name": "mnuCut", "key": "Ctrl+X"}, _
        {"text": "&Copy", "name": "mnuCopy", "key": "Ctrl+C"}, _
        {"text": "&Paste", "name": "mnuPaste", "key": "Ctrl+V"}, _
        {"text": "De&lete" + CHR$(9) + "Del", "name": "mnuDelete"}, _
        {"text": "-"}, _
        {"text": "&Find...", "name": "mnuFind", "key": "Ctrl+F"}, _
        {"text": "Find &Next", "name": "mnuFindNext", "key": "F3"}, _
        {"text": "&Replace...", "name": "mnuReplace", "key": "Ctrl+H"}, _
        {"text": "&Go To...", "name": "mnuGoto", "key": "Ctrl+G"}, _
        {"text": "-"}, _
        {"text": "Select &All", "name": "mnuSelAll", "key": "Ctrl+A"}, _
        {"text": "Time/&Date", "name": "mnuTimeDate", "key": "F5"}]}, _
    {"text": "F&ormat", "items": [ _
        {"text": "&Word Wrap", "name": "mnuWrap"}, _
        {"text": "&Font...", "name": "mnuFont"}]}, _
    {"text": "&View", "items": [ _
        {"text": "&Status Bar", "name": "mnuStatus"}]}, _
    {"text": "&Help", "items": [ _
        {"text": "&About " + APP_NAME, "name": "mnuAbout"}]}])

txt = FORM.TEXTBOX(frm, "txt", "", 0, 0, client_w, client_h - SB_HEIGHT, TRUE)
FORM.SET(txt, "MAXLENGTH", 0)
FORM.SET(txt, "WORDWRAP", FALSE)
FORM.SET(txt, "DROPFILES", TRUE)
FORM.SET(frm, "DROPFILES", TRUE)
APPLY_FONT()
sb = FORM.STATUSBAR(frm, "sb", [160, 140, -1])
FORM.SET(FORM.FIND(frm, "mnuStatus"), "CHECKED", TRUE)

dlg = FORM.CREATE("Find", 420, 132, "FINDDLG")
FORM.LABEL(dlg, "lblFind", "Fi&nd what:", 10, 14, 80, 18)
txtFind = FORM.TEXTBOX(dlg, "txtFind", "", 92, 10, 210, 22)
lblRepl = FORM.LABEL(dlg, "lblRepl", "Re&place with:", 10, 42, 80, 18)
txtRepl = FORM.TEXTBOX(dlg, "txtRepl", "", 92, 38, 210, 22)
chkCase = FORM.CHECKBOX(dlg, "chkCase", "Match &case", 10, 100, 110, 20)
FORM.FRAME(dlg, "fraDir", "Direction", 150, 70, 152, 52)
optUp = FORM.RADIO(dlg, "optUp", "&Up", 162, 92, 60, 20, TRUE)
optDown = FORM.RADIO(dlg, "optDown", "&Down", 228, 92, 66, 20)
FORM.SET(optDown, "CHECKED", TRUE)
FORM.BUTTON(dlg, "btnFindNext", "&Find Next", 316, 9, 94, 26)
btnRepl = FORM.BUTTON(dlg, "btnReplace", "&Replace", 316, 39, 94, 26)
btnAll = FORM.BUTTON(dlg, "btnReplaceAll", "Replace &All", 316, 69, 94, 26)
FORM.BUTTON(dlg, "btnCancel", "Cancel", 316, 99, 94, 26)

DIM args AS ARRAY = OS.ARGS()
IF LEN(args) > 1 THEN LOAD_DOC(args[1])

FORM.RUN(frm)
