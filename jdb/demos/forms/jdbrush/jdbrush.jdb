' ── Open with and Default apps ─────────────────────────────────

FUNC REGISTER_APP() AS INTEGER
    RETURN APPREG.REGISTER(APP_NAME, PROG_ID, "Paint and screenshot annotation written in jdBasic.", APP_NAME + " Picture", PIC_EXTS)
ENDFUNC

SUB mnuRegister_CLICK(e)
    IF REGISTER_APP() <> 0 THEN
        MSGBOX("Windows did not take every entry of the registration.", 48, APP_NAME)
        RETURN
    ENDIF
    MSGBOX(APP_NAME + " now shows under Open with and in Default apps." + CRLF + CRLF + _
        "Windows lets only you make it the default: Settings opens on its page, " + _
        "pick " + APP_NAME + " there for each type of picture.", 64, APP_NAME)
    APPREG.OPEN_SETTINGS(APP_NAME)
ENDSUB
SUB mnuUnregister_CLICK(e)
    DIM rc AS INTEGER = APPREG.UNREGISTER(APP_NAME, PROG_ID, PIC_EXTS)
    MSGBOX(APP_NAME + " is no longer offered under Open with and in Default apps.", 64, APP_NAME)
ENDSUB

' ── build the window ───────────────────────────────────────────

DIM args AS ARRAY = OS.ARGS()
IF LEN(args) > 1 THEN
    IF LCASE$(args[1]) = "--register" THEN END REGISTER_APP()
    IF LCASE$(args[1]) = "--unregister" THEN END APPREG.UNREGISTER(APP_NAME, PROG_ID, PIC_EXTS)
ENDIF

LOAD_SETTINGS()
LOAD_RECENT()

frm = FORM.CREATE(APP_NAME, client_w, client_h, "MAIN")
tb = FORM.TOOLBAR(frm, "tb", [ _
    {"name": "tbNew", "text": "New (Ctrl+N)", "icon": "NEW"}, _
    {"name": "tbOpen", "text": "Open (Ctrl+O)", "icon": "OPEN"}, _
    {"name": "tbSave", "text": "Save (Ctrl+S)", "icon": "SAVE"}, _
    "-", _
    {"name": "tbCopy", "text": "Copy picture (Ctrl+C)", "icon": "COPY"}, _
    {"name": "tbPaste", "text": "New from clipboard (Ctrl+Shift+V)", "icon": "PASTE"}, _
    "-", _
    {"name": "tbUndo", "text": "Undo (Ctrl+Z)", "icon": "UNDO"}, _
    {"name": "tbRedo", "text": "Redo (Ctrl+Y)", "icon": "REDO"}, _
    "-", _
    {"name": "tbPrint", "text": "Print (Ctrl+P)", "icon": "PRINT"}])
tb_h = CINT(FORM.GET(tb, "HEIGHT"))

DIM y AS INTEGER = tb_h + 8
FORM.FRAME(frm, "fraTool", "Tool", 6, y, PANEL_W - 12, LEN(TOOLS) * 24 + 26)
DIM i AS INTEGER
DIM sw AS DOUBLE = 0
FOR i = 0 TO LEN(TOOLS) - 1
    FORM.RADIO(frm, "opt" + TOOLS[i][0], TOOLS[i][1], 16, y + 20 + i * 24, PANEL_W - 30, 22, i = 0)
NEXT
y = y + LEN(TOOLS) * 24 + 34

FORM.FRAME(frm, "fraColor", "Colour", 6, y, PANEL_W - 12, 4 * (SWATCH + 4) + 92)
cur_swatch = FORM.SHAPE(frm, "swCur", 16, y + 22, PANEL_W - 32, 22, ink)
FORM.SET(cur_swatch, "TOOLTIP", "The colour in use - click for more colours")
FORM.SET(cur_swatch, "CURSOR", "HAND")
FOR i = 0 TO LEN(PALETTE) - 1
    sw = FORM.SHAPE(frm, "sw" + STR$(i), 16 + (i MOD 3) * (SWATCH + 4), y + 52 + INT(i / 3) * (SWATCH + 4), SWATCH, SWATCH, PALETTE[i])
    FORM.SET(sw, "CURSOR", "HAND")
NEXT
y = y + 52 + 4 * (SWATCH + 4)
FORM.BUTTON(frm, "btnMore", "&More...", 16, y, PANEL_W - 32, 24)
y = y + 48

FORM.LABEL(frm, "lblWidth", "&Width", 10, y + 3, 50, 20)
upd_width = FORM.UPDOWN(frm, "updWidth", 62, y, PANEL_W - 72, 24, 1, 60)
FORM.SET(upd_width, "VALUE", pen_w)
y = y + 32
chk_fill = FORM.CHECKBOX(frm, "chkFill", "&Fill shapes", 10, y, PANEL_W - 16, 22)
FORM.SET(chk_fill, "CHECKED", fill_on)

pic = FORM.PICTURE(frm, "pic", "", PANEL_W, tb_h, client_w - PANEL_W, client_h - tb_h - SB_HEIGHT)
FORM.SET(pic, "SCALEMODE", "fit")
FORM.SET(pic, "DROPFILES", TRUE)
FORM.SET(frm, "DROPFILES", TRUE)
hint = FORM.LABEL(frm, "hint", "New screenshot: Ctrl+Shift+N    From the clipboard: Ctrl+Shift+V    Open: Ctrl+O    Empty page: Ctrl+N", PANEL_W, 0, client_w - PANEL_W, 24)
FORM.SET(hint, "ALIGN", "CENTER")
sb = FORM.STATUSBAR(frm, "sb", [110, 110, 70, -1])
printer_rt = FORM.RICHTEXT(frm, "printerRt", 0, 0, 10, 10)
FORM.SET(printer_rt, "VISIBLE", FALSE)

BUILD_MENU()
APPLY_COLORS()
LAYOUT()
SELECT_TOOL(tool)
MENU_STATE()
UPDATE_TITLE()
IF LEN(args) > 1 THEN OPEN_FILE(args[1])
IF window_place <> "" THEN FORM.SET(frm, "PLACEMENT", window_place)
FORM.RUN(frm)
