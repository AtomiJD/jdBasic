' tmpl.jdb - a small HTML template engine for jdBasic (jdweb view layer).
'
' Renders a template against a model MAP. Interpolation auto-escapes HTML;
' a triple brace emits raw markup. Compiled templates are cached per path
' and mtime, so a file is parsed once and re-rendered from the cache.
'
'   IMPORT TMPL
'   DIM html$ = TMPL.RENDER$("page.html", { "name": "Kat" })
'   DIM s$    = TMPL.RENDERSTR$("Hi {{ name }}", { "name": "<b>Kat</b>" })
'
' Holes are dotted/bracket lookups into the model:
'   {{ name }}              escaped
'   {{{ body }}}           raw (no escaping)
'   {{ user.name }}        nested map
'   {{ items[0].title }}   array index then map key
'
' Control tags:
'   {% if cond %} ... {% elseif cond %} ... {% else %} ... {% endif %}
'   {% for item in items %} ... {% endfor %}
'   {% include "partial.html" %}            (resolved next to the rendered file)
'   {% extends "layout.html" %}             (this file fills the layout's blocks)
'   {% block name %} ... {% endblock %}     (override point / default content)
' Conditions: a bare path (truthy), path == "lit", path != "lit", not path.

EXPORT MODULE TMPL

DIM gCache AS MAP        ' path -> compiled template map
DIM gMtime AS MAP        ' path -> mtime string captured at parse time
DIM gVoid AS MAP         ' a missing key here yields a NONE value
DIM gEmptyBlocks AS MAP  ' shared empty block-override set (never mutated)
DIM gCompiles = 0        ' cache-miss parse count (diagnostics / tests)
DIM gIncBase$ = ""       ' directory include/extends paths resolve against
DIM gToks = []           ' token stream for the active parse pass
DIM gPos = 0             ' cursor into gToks
DIM gExt$ = ""           ' extends target collected during the active parse
DIM gBlocks AS MAP       ' block bodies collected during the active parse

FUNC VoidVal()
    RETURN gVoid{"__none__"}
ENDFUNC

FUNC EscHtml$(s$)
    DIM r$ = REPLACE$(s$, "&", "&amp;")
    r$ = REPLACE$(r$, "<", "&lt;")
    r$ = REPLACE$(r$, ">", "&gt;")
    r$ = REPLACE$(r$, CHR$(34), "&quot;")
    r$ = REPLACE$(r$, "'", "&#39;")
    RETURN r$
ENDFUNC

FUNC AsText$(v)
    DIM ty$ = TYPEOF(v)
    IF ty$ = "NONE" THEN RETURN ""
    IF ty$ = "ARRAY" ORELSE ty$ = "OBJECT" THEN RETURN ""
    RETURN "" + v
ENDFUNC

' walk a dotted/bracket path into the model; NONE if any step is missing
FUNC PathGet(path$, scope)
    DIM p$ = REPLACE$(path$, "[", ".")
    p$ = REPLACE$(p$, "]", "")
    DIM segs = SPLIT(p$, ".")
    DIM cur = scope
    DIM i
    FOR i = 0 TO LEN(segs) - 1
        DIM key$ = TRIM$(segs[i])
        IF key$ = "" THEN CONTINUEFOR
        DIM ty$ = TYPEOF(cur)
        IF ty$ = "OBJECT" THEN
            IF MAP.EXISTS(cur, key$) THEN
                cur = cur{key$}
            ELSE
                RETURN VoidVal()
            ENDIF
        ELSEIF ty$ = "ARRAY" THEN
            DIM idx = VAL(key$)
            IF idx >= 0 ANDALSO idx < LEN(cur) THEN
                cur = cur[idx]
            ELSE
                RETURN VoidVal()
            ENDIF
        ELSE
            RETURN VoidVal()
        ENDIF
    NEXT i
    RETURN cur
ENDFUNC

FUNC CloneMap(m)
    DIM c AS MAP
    DIM ks = MAP.KEYS(m)
    DIM i
    FOR i = 0 TO LEN(ks) - 1
        c{ks[i]} = m{ks[i]}
    NEXT i
    RETURN c
ENDFUNC

FUNC Truthy(v)
    DIM ty$ = TYPEOF(v)
    IF ty$ = "NONE" THEN RETURN FALSE
    IF ty$ = "ARRAY" THEN RETURN LEN(v) > 0
    IF ty$ = "OBJECT" THEN RETURN TRUE
    IF ty$ = "STRING" THEN RETURN LEN(v) > 0
    RETURN (v <> 0)
ENDFUNC

' resolve the right side of a comparison: a quoted literal, else a path
FUNC RhsVal$(tok$, scope)
    DIM t$ = TRIM$(tok$)
    IF LEN(t$) >= 2 THEN
        DIM f$ = LEFT$(t$, 1)
        IF f$ = CHR$(34) ORELSE f$ = "'" THEN RETURN MID$(t$, 1, LEN(t$) - 2)
    ENDIF
    RETURN AsText$(PathGet(t$, scope))
ENDFUNC

FUNC EvalCond(expr$, scope)
    DIM ex$ = TRIM$(expr$)
    IF LCASE$(LEFT$(ex$, 4)) = "not " THEN
        RETURN (NOT EvalCond(MID$(ex$, 4), scope))
    ENDIF
    DIM neg = 0
    DIM oppos = INSTR(0, ex$, "==")
    IF oppos < 0 THEN
        DIM np = INSTR(0, ex$, "!=")
        IF np >= 0 THEN
            oppos = np
            neg = 1
        ENDIF
    ENDIF
    IF oppos >= 0 THEN
        DIM lstr$ = AsText$(PathGet(TRIM$(LEFT$(ex$, oppos)), scope))
        DIM rstr$ = RhsVal$(TRIM$(MID$(ex$, oppos + 2)), scope)
        DIM eq = (lstr$ = rstr$)
        IF neg THEN RETURN (NOT eq)
        RETURN eq
    ENDIF
    RETURN Truthy(PathGet(ex$, scope))
ENDFUNC

' --- filters: {{ value | name | name:arg }} ---

DIM gFilters AS MAP      ' name -> custom filter funcref (value, arg$) -> value

FUNC Zp2$(n)
    DIM s$ = FORMAT$("{}", INT(n))
    IF LEN(s$) < 2 THEN RETURN "0" + s$
    RETURN s$
ENDFUNC

FUNC FilterLen(vv)
    DIM ty$ = TYPEOF(vv)
    IF ty$ = "ARRAY" ORELSE ty$ = "STRING" THEN RETURN LEN(vv)
    RETURN 0
ENDFUNC

FUNC FilterMoney$(vv, arg$)
    DIM s$ = FORMAT$("{:.2f}", VAL(AsText$(vv)))
    s$ = REPLACE$(s$, ".", ",")
    DIM cur$ = arg$
    IF cur$ = "" THEN cur$ = "EUR"
    RETURN s$ + " " + cur$
ENDFUNC

FUNC FilterDate$(s$, fmt$)
    IF LEN(s$) < 8 THEN RETURN s$
    DIM dt = CVDATE(s$, 0)
    DIM f$ = fmt$
    IF f$ = "" THEN f$ = "DD.MM.YYYY"
    f$ = REPLACE$(f$, "YYYY", FORMAT$("{}", YEAR(dt)))
    f$ = REPLACE$(f$, "MM", Zp2$(MONTH(dt)))
    f$ = REPLACE$(f$, "DD", Zp2$(DAY(dt)))
    f$ = REPLACE$(f$, "HH", Zp2$(HOUR(dt)))
    f$ = REPLACE$(f$, "mm", Zp2$(MINUTE(dt)))
    RETURN f$
ENDFUNC

FUNC ApplyFilter(name$, vv, arg$)
    IF name$ = "upper" THEN RETURN UCASE$(AsText$(vv))
    IF name$ = "lower" THEN RETURN LCASE$(AsText$(vv))
    IF name$ = "trim" THEN RETURN TRIM$(AsText$(vv))
    IF name$ = "length" THEN RETURN FilterLen(vv)
    IF name$ = "money" THEN RETURN FilterMoney$(vv, arg$)
    IF name$ = "date" THEN RETURN FilterDate$(AsText$(vv), arg$)
    IF name$ = "default" THEN
        IF Truthy(vv) THEN RETURN vv
        RETURN arg$
    ENDIF
    IF MAP.EXISTS(gFilters, name$) THEN
        DIM fn = gFilters{name$}
        RETURN fn(vv, arg$)
    ENDIF
    RETURN vv
ENDFUNC

FUNC ParseFilter(seg$)
    DIM m AS MAP
    DIM cp = INSTR(0, seg$, ":")
    IF cp < 0 THEN
        m{"name"} = LCASE$(TRIM$(seg$))
        m{"arg"} = ""
    ELSE
        m{"name"} = LCASE$(TRIM$(LEFT$(seg$, cp)))
        m{"arg"} = Unquote$(TRIM$(MID$(seg$, cp + 1)))
    ENDIF
    RETURN m
ENDFUNC

' --- token constructors ---

FUNC LitTok(s$)
    DIM m AS MAP
    m{"tt"} = "lit"
    m{"s"} = s$
    RETURN m
ENDFUNC

FUNC VarTok(x$, raw)
    DIM m AS MAP
    m{"tt"} = "var"
    m{"x"} = x$
    m{"raw"} = raw
    RETURN m
ENDFUNC

FUNC TagTok(g$)
    DIM m AS MAP
    m{"tt"} = "tag"
    m{"g"} = g$
    RETURN m
ENDFUNC

' position of the next {{ or {% at/after i, earliest wins; -1 if none
FUNC NextMark(src$, i)
    DIM a = INSTR(i, src$, "{{")
    DIM b = INSTR(i, src$, "{%")
    IF a < 0 THEN RETURN b
    IF b < 0 THEN RETURN a
    IF a < b THEN RETURN a
    RETURN b
ENDFUNC

' split a template into a flat token stream
FUNC Lex(src$)
    DIM toks = []
    DIM i = 0
    DIM n = LEN(src$)
    DO WHILE i < n
        DIM mk = NextMark(src$, i)
        IF mk < 0 THEN
            toks = APPEND(toks, LitTok(MID$(src$, i)))
            EXITDO
        ENDIF
        IF mk > i THEN toks = APPEND(toks, LitTok(MID$(src$, i, mk - i)))
        IF MID$(src$, mk, 2) = "{%" THEN
            DIM ce = INSTR(mk + 2, src$, "%}")
            IF ce < 0 THEN
                toks = APPEND(toks, LitTok(MID$(src$, mk)))
                EXITDO
            ENDIF
            toks = APPEND(toks, TagTok(TRIM$(MID$(src$, mk + 2, ce - (mk + 2)))))
            i = ce + 2
        ELSE
            DIM raw = 0
            DIM clo$ = "}}"
            DIM hdr = 2
            IF MID$(src$, mk, 3) = "{{{" THEN
                raw = 1
                clo$ = "}}}"
                hdr = 3
            ENDIF
            DIM es = mk + hdr
            DIM cce = INSTR(es, src$, clo$)
            IF cce < 0 THEN
                toks = APPEND(toks, LitTok(MID$(src$, mk)))
                EXITDO
            ENDIF
            toks = APPEND(toks, VarTok(TRIM$(MID$(src$, es, cce - es)), raw))
            i = cce + LEN(clo$)
        ENDIF
    LOOP
    RETURN toks
ENDFUNC

' --- recursive-descent parser over gToks/gPos ---

FUNC TagWord$(g$)
    DIM sp = INSTR(0, g$, " ")
    IF sp < 0 THEN RETURN LCASE$(TRIM$(g$))
    RETURN LCASE$(TRIM$(LEFT$(g$, sp)))
ENDFUNC

FUNC TagRest$(g$)
    DIM sp = INSTR(0, g$, " ")
    IF sp < 0 THEN RETURN ""
    RETURN TRIM$(MID$(g$, sp + 1))
ENDFUNC

FUNC Unquote$(t0$)
    DIM t$ = TRIM$(t0$)
    IF LEN(t$) >= 2 THEN
        DIM f$ = LEFT$(t$, 1)
        IF f$ = CHR$(34) ORELSE f$ = "'" THEN RETURN MID$(t$, 1, LEN(t$) - 2)
    ENDIF
    RETURN t$
ENDFUNC

FUNC InList(list$, w$)
    RETURN INSTR(0, " " + list$ + " ", " " + w$ + " ") >= 0
ENDFUNC

FUNC LitOp(s$)
    DIM m AS MAP
    m{"t"} = "lit"
    m{"s"} = s$
    RETURN m
ENDFUNC

FUNC VarOp(x$, raw)
    DIM parts = SPLIT(x$, "|")
    DIM m AS MAP
    m{"t"} = "var"
    m{"x"} = TRIM$(parts[0])
    m{"raw"} = raw
    DIM filters = []
    DIM i
    FOR i = 1 TO LEN(parts) - 1
        DIM seg$ = TRIM$(parts[i])
        IF seg$ <> "" THEN filters = APPEND(filters, ParseFilter(seg$))
    NEXT i
    m{"filters"} = filters
    RETURN m
ENDFUNC

FUNC IncOp(path$)
    DIM m AS MAP
    m{"t"} = "inc"
    m{"path"} = path$
    RETURN m
ENDFUNC

FUNC Branch(cond$, body)
    DIM m AS MAP
    m{"cond"} = cond$
    m{"body"} = body
    RETURN m
ENDFUNC

FUNC ParseSeq(stoppers$)
    DIM ops = []
    DO WHILE gPos < LEN(gToks)
        DIM tk = gToks[gPos]
        DIM tt$ = tk{"tt"}
        IF tt$ = "lit" THEN
            ops = APPEND(ops, LitOp(tk{"s"}))
            gPos = gPos + 1
        ELSEIF tt$ = "var" THEN
            ops = APPEND(ops, VarOp(tk{"x"}, tk{"raw"}))
            gPos = gPos + 1
        ELSE
            DIM g$ = tk{"g"}
            DIM word$ = TagWord$(g$)
            IF InList(stoppers$, word$) THEN RETURN ops
            IF word$ = "if" THEN
                ops = APPEND(ops, ParseIf())
            ELSEIF word$ = "for" THEN
                ops = APPEND(ops, ParseFor())
            ELSEIF word$ = "block" THEN
                ops = APPEND(ops, ParseBlock())
            ELSEIF word$ = "include" THEN
                ops = APPEND(ops, IncOp(Unquote$(TagRest$(g$))))
                gPos = gPos + 1
            ELSEIF word$ = "extends" THEN
                gExt$ = Unquote$(TagRest$(g$))
                gPos = gPos + 1
            ELSE
                ops = APPEND(ops, LitOp("{% " + g$ + " %}"))
                gPos = gPos + 1
            ENDIF
        ENDIF
    LOOP
    RETURN ops
ENDFUNC

FUNC ParseIf()
    DIM tk = gToks[gPos]
    DIM branches = []
    branches = APPEND(branches, Branch("", []))
    DIM firstCond$ = TagRest$(tk{"g"})
    gPos = gPos + 1
    branches[0] = Branch(firstCond$, ParseSeq("elseif else endif"))
    DIM elsebody = []
    DO WHILE gPos < LEN(gToks)
        DIM t2 = gToks[gPos]
        DIM w$ = TagWord$(t2{"g"})
        IF w$ = "elseif" THEN
            DIM c2$ = TagRest$(t2{"g"})
            gPos = gPos + 1
            branches = APPEND(branches, Branch(c2$, ParseSeq("elseif else endif")))
        ELSEIF w$ = "else" THEN
            gPos = gPos + 1
            elsebody = ParseSeq("endif")
        ELSEIF w$ = "endif" THEN
            gPos = gPos + 1
            EXITDO
        ELSE
            EXITDO
        ENDIF
    LOOP
    DIM m AS MAP
    m{"t"} = "if"
    m{"branches"} = branches
    m{"else"} = elsebody
    RETURN m
ENDFUNC

FUNC ParseFor()
    DIM tk = gToks[gPos]
    DIM rest$ = TagRest$(tk{"g"})
    gPos = gPos + 1
    DIM body = ParseSeq("endfor")
    IF gPos < LEN(gToks) THEN gPos = gPos + 1
    DIM vpos = INSTR(0, rest$, " in ")
    DIM vname$ = ""
    DIM src$ = ""
    IF vpos >= 0 THEN
        vname$ = TRIM$(LEFT$(rest$, vpos))
        src$ = TRIM$(MID$(rest$, vpos + 4))
    ENDIF
    DIM m AS MAP
    m{"t"} = "for"
    m{"var"} = vname$
    m{"src"} = src$
    m{"body"} = body
    RETURN m
ENDFUNC

FUNC ParseBlock()
    DIM tk = gToks[gPos]
    DIM nm$ = TRIM$(TagRest$(tk{"g"}))
    gPos = gPos + 1
    DIM body = ParseSeq("endblock")
    IF gPos < LEN(gToks) THEN gPos = gPos + 1
    gBlocks{nm$} = body
    DIM m AS MAP
    m{"t"} = "block"
    m{"name"} = nm$
    m{"body"} = body
    RETURN m
ENDFUNC

' parse a source string into a compiled template: ops + extends + blocks
FUNC BuildOps(src$)
    gCompiles = gCompiles + 1
    gExt$ = ""
    DIM freshBlocks AS MAP
    gBlocks = freshBlocks
    gToks = Lex(src$)
    gPos = 0
    DIM ops = ParseSeq("")
    DIM tpl AS MAP
    tpl{"ops"} = ops
    tpl{"ext"} = gExt$
    tpl{"blocks"} = gBlocks
    RETURN tpl
ENDFUNC

FUNC BadTpl(msg$)
    DIM ops = []
    ops = APPEND(ops, LitOp(msg$))
    DIM tpl AS MAP
    tpl{"ops"} = ops
    tpl{"ext"} = ""
    DIM b AS MAP
    tpl{"blocks"} = b
    RETURN tpl
ENDFUNC

FUNC LoadTpl(path$)
    DIM st = FILE.STAT(path$)
    IF NOT st{"exists"} THEN RETURN BadTpl("<!-- tmpl: not found: " + path$ + " -->")
    DIM mt$ = st{"mtime"}
    IF MAP.EXISTS(gCache, path$) ANDALSO gMtime{path$} = mt$ THEN RETURN gCache{path$}
    DIM tpl = BuildOps(TXTREADER$(path$))
    gCache{path$} = tpl
    gMtime{path$} = mt$
    RETURN tpl
ENDFUNC

' --- rendering (blocks = active override set for {% block %}) ---

FUNC EmitIf$(op, scope, blocks)
    DIM branches = op{"branches"}
    DIM i
    FOR i = 0 TO LEN(branches) - 1
        DIM br = branches[i]
        IF EvalCond(br{"cond"}, scope) THEN RETURN EmitOps$(br{"body"}, scope, blocks)
    NEXT i
    RETURN EmitOps$(op{"else"}, scope, blocks)
ENDFUNC

FUNC EmitFor$(op, scope, blocks)
    DIM seq = PathGet(op{"src"}, scope)
    IF TYPEOF(seq) <> "ARRAY" THEN RETURN ""
    DIM vname$ = op{"var"}
    DIM body = op{"body"}
    DIM out$ = ""
    DIM i
    FOR i = 0 TO LEN(seq) - 1
        DIM child = CloneMap(scope)
        child{vname$} = seq[i]
        out$ = out$ + EmitOps$(body, child, blocks)
    NEXT i
    RETURN out$
ENDFUNC

FUNC EmitInc$(op, scope)
    DIM part = LoadTpl(gIncBase$ + op{"path"})
    RETURN EmitOps$(part{"ops"}, scope, gEmptyBlocks)
ENDFUNC

FUNC EmitOps$(ops, scope, blocks)
    DIM out$ = ""
    DIM i
    FOR i = 0 TO LEN(ops) - 1
        DIM op = ops[i]
        DIM ty$ = op{"t"}
        IF ty$ = "lit" THEN
            out$ = out$ + op{"s"}
        ELSEIF ty$ = "var" THEN
            DIM vv = PathGet(op{"x"}, scope)
            DIM fl = op{"filters"}
            DIM fi
            FOR fi = 0 TO LEN(fl) - 1
                vv = ApplyFilter(fl[fi]{"name"}, vv, fl[fi]{"arg"})
            NEXT fi
            DIM s$ = AsText$(vv)
            IF op{"raw"} THEN
                out$ = out$ + s$
            ELSE
                out$ = out$ + EscHtml$(s$)
            ENDIF
        ELSEIF ty$ = "if" THEN
            out$ = out$ + EmitIf$(op, scope, blocks)
        ELSEIF ty$ = "for" THEN
            out$ = out$ + EmitFor$(op, scope, blocks)
        ELSEIF ty$ = "inc" THEN
            out$ = out$ + EmitInc$(op, scope)
        ELSEIF ty$ = "block" THEN
            DIM nm$ = op{"name"}
            IF MAP.EXISTS(blocks, nm$) THEN
                out$ = out$ + EmitOps$(blocks{nm$}, scope, blocks)
            ELSE
                out$ = out$ + EmitOps$(op{"body"}, scope, blocks)
            ENDIF
        ENDIF
    NEXT i
    RETURN out$
ENDFUNC

' render a compiled template; if it extends a layout, fill the layout's blocks
FUNC EmitTpl$(tpl, scope)
    IF tpl{"ext"} = "" THEN RETURN EmitOps$(tpl{"ops"}, scope, gEmptyBlocks)
    DIM layout = LoadTpl(gIncBase$ + tpl{"ext"})
    RETURN EmitOps$(layout{"ops"}, scope, tpl{"blocks"})
ENDFUNC

' directory portion of a path (with trailing slash), or "" if none
FUNC DirOf$(path$)
    DIM p$ = REPLACE$(path$, "\", "/")
    DIM last = -1
    DIM i
    FOR i = 0 TO LEN(p$) - 1
        IF MID$(p$, i, 1) = "/" THEN last = i
    NEXT i
    IF last < 0 THEN RETURN ""
    RETURN MID$(p$, 0, last + 1)
ENDFUNC

' --- public API ---

' render a template string directly (no caching, no file)
EXPORT FUNC RENDERSTR$(src$, model)
    gIncBase$ = ""
    RETURN EmitTpl$(BuildOps(src$), model)
ENDFUNC

' render a template file against the model; parses once, then serves from cache
EXPORT FUNC RENDER$(path$, model)
    gIncBase$ = DirOf$(path$)
    RETURN EmitTpl$(LoadTpl(path$), model)
ENDFUNC

' register a custom filter: fn is a funcref, called as fn(value, arg$) -> value
EXPORT SUB ADDFILTER(name$, fn)
    gFilters{LCASE$(name$)} = fn
ENDSUB

' number of cache-miss parses so far (for tests / diagnostics)
EXPORT FUNC COMPILES()
    RETURN gCompiles
ENDFUNC
