[Unit]
Description=jdBBS markdown board
After=network.target

[Service]
Type=simple
User=mdbbs
Group=mdbbs
WorkingDirectory=/opt/mdbbs
ExecStart=/opt/mdbbs/jdBasic /opt/mdbbs/mdbbs.jdb 8100
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
