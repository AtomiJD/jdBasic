' wm_dashboard.jdb - FIFA World Cup 2026 dashboard (GFX/ImGui).
' Phase 1: group tables + nations grid.  Phase 2: schedule + match detail
' (events, boxscore stats, lineups). Data: ESPN hidden API (no key).
' Flags: HTTP.GET$ -> BINWRITER -> SPRITE.LOAD -> GUI.IMAGE, cached by code.
' Run:  jdBasic wm_dashboard.jdb            (ESC quits)
' Test: jdBasic wm_dashboard.jdb shot [nat|match]   (one screenshot to tmp/dash.png)

SCREEN 1100, 740, "WM 2026 Dashboard", 2

DIM SB$ = "https://site.api.espn.com/apis/site/v2/sports/soccer/fifa.world/scoreboard"
DIM SUMURL$ = "https://site.api.espn.com/apis/site/v2/sports/soccer/fifa.world/summary?event="
DIM gFlags AS MAP
DIM gTeams = []
DIM gSched = []
DIM gSum AS MAP
DIM gSelIdx = -1
DIM gSelTeam$ = ""
DIM gImg AS MAP
DIM gRoster AS MAP
DIM gNews = []

FUNC TXT$(v)
    IF ISNONE(v) THEN RETURN ""
    RETURN "" + v
ENDFUNC

FUNC ZP2$(n)
    DIM s$ = FORMAT$("{}", INT(n))
    IF LEN(s$) < 2 THEN RETURN "0" + s$
    RETURN s$
ENDFUNC

' ISO UTC kickoff -> local HH:MM (CVDATE+HOUR give local time)
FUNC HHMM$(iso$)
    IF LEN(iso$) < 16 THEN RETURN "--:--"
    DIM s$ = REPLACE$(iso$, "T", " ")
    s$ = REPLACE$(s$, "Z", "")
    DIM dt = CVDATE(s$, 0)
    RETURN ZP2$(HOUR(dt)) + ":" + ZP2$(MINUTE(dt))
ENDFUNC

' ISO -> local "DD.MM. HH:MM"
FUNC DTSHORT$(iso$)
    IF LEN(iso$) < 16 THEN RETURN ""
    DIM s$ = REPLACE$(iso$, "T", " ")
    s$ = REPLACE$(s$, "Z", "")
    DIM dt = CVDATE(s$, 0)
    RETURN ZP2$(DAY(dt)) + "." + ZP2$(MONTH(dt)) + ". " + ZP2$(HOUR(dt)) + ":" + ZP2$(MINUTE(dt))
ENDFUNC

' one loading-screen frame with a little wait line + progress bar
SUB SPLASH(msg$, frac)
    CLS
    IF GUI.BEGIN("Bitte warten", 330, 320, 440, 110) THEN
        GUI.TEXT msg$
        GUI.PROGRESS frac
        GUI.END
    ENDIF
    SCREENFLIP
ENDSUB

' flag cache: ESPN flag URL is deterministic from the lowercase team code
FUNC FLAG(code$)
    IF code$ = "" THEN RETURN -1
    IF MAP.EXISTS(gFlags, code$) THEN RETURN gFlags{code$}
    DIM url$ = "https://a.espncdn.com/i/teamlogos/countries/500/" + LCASE$(code$) + ".png"
    DIM png$ = HTTP.GET$(url$)
    IF LEN(png$) < 100 THEN RETURN -1
    DIM fn$ = "tmp/flag_" + code$ + ".png"
    BINWRITER fn$, png$
    DIM sid = SPRITE.LOAD(fn$)
    gFlags{code$} = sid
    RETURN sid
ENDFUNC

FUNC STATD$(stats, nm$)
    DIM k
    FOR k = 0 TO LEN(stats) - 1
        IF stats[k]{"name"} = nm$ THEN RETURN "" + stats[k]{"displayValue"}
    NEXT k
    RETURN "-"
ENDFUNC

' generic image cache (player headshots etc.), keyed by a fs-safe key
FUNC IMG(url$, key$)
    IF key$ = "" ORELSE LEN(url$) < 8 THEN RETURN -1
    IF MAP.EXISTS(gImg, key$) THEN RETURN gImg{key$}
    DIM png$ = HTTP.GET$(url$)
    IF LEN(png$) < 100 THEN
        gImg{key$} = -1
        RETURN -1
    ENDIF
    DIM fn$ = "tmp/img_" + key$ + ".png"
    BINWRITER fn$, png$
    DIM sid = SPRITE.LOAD(fn$)
    gImg{key$} = sid
    RETURN sid
ENDFUNC

' player headshot sprite if ESPN has one, else -1 (caller shows no image).
' (ESPN's WC2026 headshots are largely missing - no flag fallback by choice.)
FUNC AVATAR(hs, code$, key$)
    IF ISNONE(hs) THEN RETURN -1
    DIM u$ = TXT$(hs{"href"})
    IF LEN(u$) < 8 THEN RETURN -1
    RETURN IMG(u$, key$)
ENDFUNC

' halftime score computed from goal events with minute <= 45
FUNC HT$(ev)
    DIM cp = ev{"competitions"}[0]
    DIM det = cp{"details"}
    IF ISNONE(det) ORELSE LEN(det) = 0 THEN RETURN ""
    DIM id0$ = TXT$(cp{"competitors"}[0]{"team"}{"id"})
    DIM ha = 0
    DIM hb = 0
    DIM k
    FOR k = 0 TO LEN(det) - 1
        DIM d = det[k]
        IF d{"scoringPlay"} THEN
            IF VAL(TXT$(d{"clock"}{"displayValue"})) <= 45 THEN
                IF TXT$(d{"team"}{"id"}) = id0$ THEN
                    ha = ha + 1
                ELSE
                    hb = hb + 1
                ENDIF
            ENDIF
        ENDIF
    NEXT k
    RETURN "HZ " + FORMAT$("{}", ha) + "-" + FORMAT$("{}", hb)
ENDFUNC

FUNC GET_SQUAD(tid$)
    IF MAP.EXISTS(gRoster, tid$) THEN RETURN gRoster{tid$}
    DIM ath = JSON.PARSE$(HTTP.GET$("https://site.api.espn.com/apis/site/v2/sports/soccer/fifa.world/teams/" + tid$ + "?enable=roster")){"team"}{"athletes"}
    gRoster{tid$} = ath
    RETURN ath
ENDFUNC

FUNC GET_SUMMARY(eid$)
    IF MAP.EXISTS(gSum, eid$) THEN RETURN gSum{eid$}
    DIM sjj = JSON.PARSE$(HTTP.GET$(SUMURL$ + eid$))
    gSum{eid$} = sjj
    RETURN sjj
ENDFUNC

' ── group standings table ─────────────────────────────────────
SUB GROUP_TABLE(grp)
    GUI.SEPARATOR_TEXT(TXT$(grp{"name"}))
    IF GUI.BEGIN_TABLE("t" + TXT$(grp{"name"}), 9) THEN
        GUI.TABLE_SETUP_COLUMN("")
        GUI.TABLE_SETUP_COLUMN("Nation")
        GUI.TABLE_SETUP_COLUMN("Sp")
        GUI.TABLE_SETUP_COLUMN("S")
        GUI.TABLE_SETUP_COLUMN("U")
        GUI.TABLE_SETUP_COLUMN("N")
        GUI.TABLE_SETUP_COLUMN("Tore")
        GUI.TABLE_SETUP_COLUMN("Diff")
        GUI.TABLE_SETUP_COLUMN("Pkt")
        GUI.TABLE_HEADERS_ROW
        DIM ent = grp{"standings"}{"entries"}
        DIM nn = LEN(ent)
        DIM ord = IOTA(nn, 0)
        DIM a, b, tmp
        FOR a = 0 TO nn - 2
            FOR b = a + 1 TO nn - 1
                IF VAL(STATD$(ent[ord[b]]{"stats"}, "rank")) < VAL(STATD$(ent[ord[a]]{"stats"}, "rank")) THEN
                    tmp = ord[a]
                    ord[a] = ord[b]
                    ord[b] = tmp
                ENDIF
            NEXT b
        NEXT a
        DIM j
        FOR j = 0 TO nn - 1
            DIM tm = ent[ord[j]]{"team"}
            DIM code$ = TXT$(tm{"abbreviation"})
            DIM st = ent[ord[j]]{"stats"}
            GUI.TABLE_NEXT_ROW
            GUI.TABLE_NEXT_COLUMN
            DIM fid = FLAG(code$)
            IF fid >= 0 THEN GUI.IMAGE fid, 26, 17
            GUI.TABLE_NEXT_COLUMN
            DIM mk$ = "   "
            IF j < 2 THEN mk$ = "+ "
            GUI.TEXT mk$ + code$ + "  " + TXT$(tm{"displayName"})
            GUI.TABLE_NEXT_COLUMN
            GUI.TEXT STATD$(st, "gamesPlayed")
            GUI.TABLE_NEXT_COLUMN
            GUI.TEXT STATD$(st, "wins")
            GUI.TABLE_NEXT_COLUMN
            GUI.TEXT STATD$(st, "ties")
            GUI.TABLE_NEXT_COLUMN
            GUI.TEXT STATD$(st, "losses")
            GUI.TABLE_NEXT_COLUMN
            GUI.TEXT STATD$(st, "pointsFor") + ":" + STATD$(st, "pointsAgainst")
            GUI.TABLE_NEXT_COLUMN
            GUI.TEXT STATD$(st, "pointDifferential")
            GUI.TABLE_NEXT_COLUMN
            GUI.TEXT STATD$(st, "points")
        NEXT j
        GUI.END_TABLE
    ENDIF
ENDSUB

SUB NATIONS_GRID()
    DIM cols = 6
    IF GUI.BEGIN_TABLE("nat", cols) THEN
        DIM i
        FOR i = 0 TO LEN(gTeams) - 1
            IF i MOD cols = 0 THEN GUI.TABLE_NEXT_ROW
            GUI.TABLE_NEXT_COLUMN
            DIM t = gTeams[i]
            DIM fid = FLAG(TXT$(t{"code"}))
            IF fid >= 0 THEN GUI.IMAGE fid, 60, 40
            IF GUI.SELECTABLE(TXT$(t{"code"}) + " " + TXT$(t{"name"}) + "##n" + FORMAT$("{}", i)) THEN gSelTeam$ = TXT$(t{"code"})
            GUI.TEXT "Gr. " + TXT$(t{"grp"})
        NEXT i
        GUI.END_TABLE
    ENDIF
ENDSUB

' ── team detail page ─────────────────────────────────────────
FUNC FIND_ENTRY(code$)
    DIM g
    FOR g = 0 TO LEN(gStand) - 1
        DIM ent = gStand[g]{"standings"}{"entries"}
        DIM ee
        FOR ee = 0 TO LEN(ent) - 1
            IF TXT$(ent[ee]{"team"}{"abbreviation"}) = code$ THEN RETURN ent[ee]
        NEXT ee
    NEXT g
    DIM empty AS MAP
    RETURN empty
ENDFUNC

SUB TEAM_DETAIL(code$)
    IF GUI.BUTTON("<- Zurueck") THEN gSelTeam$ = ""
    DIM ent = FIND_ENTRY(code$)
    DIM nm$ = code$
    IF NOT ISNONE(ent{"team"}) THEN nm$ = TXT$(ent{"team"}{"displayName"})
    DIM fid = FLAG(code$)
    IF fid >= 0 THEN GUI.IMAGE fid, 120, 80
    GUI.SAME_LINE
    GUI.TEXT "  " + nm$ + "  (" + code$ + ")"
    IF NOT ISNONE(ent{"team"}) THEN
        DIM st = ent{"stats"}
        GUI.TEXT "Bilanz:  Sp " + STATD$(st, "gamesPlayed") + "    S " + STATD$(st, "wins") + "  U " + STATD$(st, "ties") + "  N " + STATD$(st, "losses") + "    Tore " + STATD$(st, "pointsFor") + ":" + STATD$(st, "pointsAgainst") + "    Pkt " + STATD$(st, "points") + "    Rang " + STATD$(st, "rank")
    ENDIF
    GUI.SEPARATOR_TEXT("Spiele")
    IF GUI.BEGIN_TABLE("tm", 4) THEN
        GUI.TABLE_SETUP_COLUMN("Datum")
        GUI.TABLE_SETUP_COLUMN("Gegner")
        GUI.TABLE_SETUP_COLUMN("Ergebnis")
        GUI.TABLE_SETUP_COLUMN("Ort")
        GUI.TABLE_HEADERS_ROW
        DIM i
        FOR i = 0 TO LEN(gSched) - 1
            DIM ev = gSched[i]
            DIM cp = ev{"competitions"}[0]
            DIM co = cp{"competitors"}
            DIM a$ = TXT$(co[0]{"team"}{"abbreviation"})
            DIM b$ = TXT$(co[1]{"team"}{"abbreviation"})
            IF a$ = code$ ORELSE b$ = code$ THEN
                DIM opp$ = b$
                IF a$ <> code$ THEN opp$ = a$
                GUI.TABLE_NEXT_ROW
                GUI.TABLE_NEXT_COLUMN
                GUI.TEXT LEFT$(TXT$(ev{"date"}), 10)
                GUI.TABLE_NEXT_COLUMN
                DIM ofid = FLAG(opp$)
                IF ofid >= 0 THEN GUI.IMAGE ofid, 22, 15
                GUI.SAME_LINE
                GUI.TEXT opp$
                GUI.TABLE_NEXT_COLUMN
                GUI.TEXT TXT$(co[0]{"score"}) + "-" + TXT$(co[1]{"score"}) + "  " + TXT$(cp{"status"}{"type"}{"shortDetail"})
                GUI.TABLE_NEXT_COLUMN
                GUI.TEXT TXT$(cp{"venue"}{"fullName"})
            ENDIF
        NEXT i
        GUI.END_TABLE
    ENDIF
    GUI.SEPARATOR_TEXT("Kader")
    IF NOT ISNONE(ent{"team"}) THEN
        DIM squad = GET_SQUAD(TXT$(ent{"team"}{"id"}))
        IF NOT ISNONE(squad) ANDALSO GUI.BEGIN_TABLE("sq", 4) THEN
            DIM s
            FOR s = 0 TO LEN(squad) - 1
                IF s MOD 4 = 0 THEN GUI.TABLE_NEXT_ROW
                GUI.TABLE_NEXT_COLUMN
                DIM pa = squad[s]
                DIM av = AVATAR(pa{"headshot"}, code$, "p" + TXT$(pa{"id"}))
                IF av >= 0 THEN
                    GUI.IMAGE av, 40, 40
                    GUI.SAME_LINE
                ENDIF
                GUI.TEXT "#" + TXT$(pa{"jersey"}) + " " + TXT$(pa{"position"}{"abbreviation"}) + " " + TXT$(pa{"displayName"})
            NEXT s
            GUI.END_TABLE
        ENDIF
    ENDIF
ENDSUB

' ── match detail ─────────────────────────────────────────────
SUB MATCH_HEADER(ev)
    DIM cp = ev{"competitions"}[0]
    DIM co = cp{"competitors"}
    DIM ta = co[0]{"team"}
    DIM tb = co[1]{"team"}
    DIM fa = FLAG(TXT$(ta{"abbreviation"}))
    IF fa >= 0 THEN GUI.IMAGE fa, 64, 43
    GUI.SAME_LINE
    GUI.TEXT "  " + TXT$(co[0]{"score"}) + " - " + TXT$(co[1]{"score"}) + "  "
    GUI.SAME_LINE
    DIM fb = FLAG(TXT$(tb{"abbreviation"}))
    IF fb >= 0 THEN GUI.IMAGE fb, 64, 43
    GUI.TEXT TXT$(ta{"displayName"}) + "  vs  " + TXT$(tb{"displayName"})
    GUI.TEXT TXT$(cp{"status"}{"type"}{"description"}) + "   @ " + TXT$(cp{"venue"}{"fullName"}) + ", " + TXT$(cp{"venue"}{"address"}{"city"})
ENDSUB

SUB MATCH_EVENTS(ev)
    DIM det = ev{"competitions"}[0]{"details"}
    IF ISNONE(det) ORELSE LEN(det) = 0 THEN
        GUI.TEXT "(noch keine Ereignisse)"
    ELSE
        DIM k
        FOR k = 0 TO LEN(det) - 1
            DIM d = det[k]
            DIM who$ = ""
            DIM ath = d{"athletesInvolved"}
            IF NOT ISNONE(ath) ANDALSO LEN(ath) > 0 THEN who$ = TXT$(ath[0]{"displayName"})
            GUI.TEXT TXT$(d{"clock"}{"displayValue"}) + "  " + TXT$(d{"type"}{"text"}) + "  " + who$
        NEXT k
    ENDIF
ENDSUB

SUB STAT_BAR(label$, sa$, sb$)
    DIM va = VAL(sa$)
    DIM vb = VAL(sb$)
    DIM tot = va + vb
    DIM frac = 0.5
    IF tot > 0 THEN frac = va / tot
    GUI.TEXT sa$ + "   " + label$ + "   " + sb$
    GUI.PROGRESS frac
ENDSUB

SUB MATCH_STATS(eid$)
    DIM su = GET_SUMMARY(eid$)
    DIM bt = su{"boxscore"}{"teams"}
    IF ISNONE(bt) ORELSE LEN(bt) < 2 THEN
        GUI.TEXT "(keine Statistik)"
    ELSE
        DIM sa = bt[0]{"statistics"}
        DIM sb = bt[1]{"statistics"}
        STAT_BAR "Ballbesitz %", STATD$(sa, "possessionPct"), STATD$(sb, "possessionPct")
        STAT_BAR "Schuesse", STATD$(sa, "totalShots"), STATD$(sb, "totalShots")
        STAT_BAR "aufs Tor", STATD$(sa, "shotsOnTarget"), STATD$(sb, "shotsOnTarget")
        STAT_BAR "Ecken", STATD$(sa, "wonCorners"), STATD$(sb, "wonCorners")
        STAT_BAR "Fouls", STATD$(sa, "foulsCommitted"), STATD$(sb, "foulsCommitted")
        STAT_BAR "Gelbe", STATD$(sa, "yellowCards"), STATD$(sb, "yellowCards")
    ENDIF
ENDSUB

SUB PLAYER_ROW(p, code$)
    DIM av = AVATAR(p{"athlete"}{"headshot"}, code$, "p" + TXT$(p{"athlete"}{"id"}))
    IF av >= 0 THEN
        GUI.IMAGE av, 22, 22
        GUI.SAME_LINE
    ENDIF
    GUI.TEXT TXT$(p{"jersey"}) + " " + TXT$(p{"position"}{"abbreviation"}) + "  " + TXT$(p{"athlete"}{"displayName"})
ENDSUB

SUB LINEUP_COL(rost)
    GUI.SEPARATOR_TEXT(TXT$(rost{"team"}{"abbreviation"}))
    DIM code$ = TXT$(rost{"team"}{"abbreviation"})
    DIM pl = rost{"roster"}
    DIM k
    GUI.TEXT "Start-XI:"
    FOR k = 0 TO LEN(pl) - 1
        IF pl[k]{"starter"} THEN PLAYER_ROW pl[k], code$
    NEXT k
    GUI.TEXT "Bank:"
    FOR k = 0 TO LEN(pl) - 1
        IF NOT pl[k]{"starter"} THEN PLAYER_ROW pl[k], code$
    NEXT k
ENDSUB

SUB MATCH_LINEUPS(eid$)
    DIM su = GET_SUMMARY(eid$)
    DIM ro = su{"rosters"}
    IF ISNONE(ro) ORELSE LEN(ro) < 2 THEN
        GUI.TEXT "(keine Aufstellung)"
    ELSE
        IF GUI.BEGIN_TABLE("lu", 2) THEN
            GUI.TABLE_NEXT_ROW
            GUI.TABLE_NEXT_COLUMN
            LINEUP_COL ro[0]
            GUI.TABLE_NEXT_COLUMN
            LINEUP_COL ro[1]
            GUI.END_TABLE
        ENDIF
    ENDIF
ENDSUB

SUB MATCH_DETAIL(ev)
    MATCH_HEADER ev
    DIM eid$ = TXT$(ev{"id"})
    DIM state$ = TXT$(ev{"competitions"}[0]{"status"}{"type"}{"state"})
    DIM ht$ = HT$(ev)
    IF ht$ <> "" THEN GUI.TEXT ht$
    IF state$ <> "pre" THEN
        DIM ginf = GET_SUMMARY(eid$){"gameInfo"}
        DIM ref$ = ""
        IF NOT ISNONE(ginf{"officials"}) ANDALSO LEN(ginf{"officials"}) > 0 THEN ref$ = TXT$(ginf{"officials"}[0]{"displayName"})
        GUI.TEXT "Schiri: " + ref$ + "    Zuschauer: " + TXT$(ginf{"attendance"})
    ENDIF
    IF GUI.BEGIN_TAB_BAR("md") THEN
        IF GUI.BEGIN_TAB_ITEM("Ereignisse") THEN
            MATCH_EVENTS ev
            GUI.END_TAB_ITEM
        ENDIF
        IF state$ <> "pre" THEN
            IF GUI.BEGIN_TAB_ITEM("Statistik") THEN
                MATCH_STATS eid$
                GUI.END_TAB_ITEM
            ENDIF
        ENDIF
        IF GUI.BEGIN_TAB_ITEM("Aufstellungen") THEN
            MATCH_LINEUPS eid$
            GUI.END_TAB_ITEM
        ENDIF
        GUI.END_TAB_BAR
    ENDIF
ENDSUB

SUB SCHEDULE_TAB()
    IF GUI.BEGIN_CHILD("list", 330, 0) THEN
        DIM last$ = ""
        DIM i
        FOR i = 0 TO LEN(gSched) - 1
            DIM ev = gSched[i]
            DIM dk$ = LEFT$(TXT$(ev{"date"}), 10)
            IF dk$ <> last$ THEN
                GUI.SEPARATOR_TEXT(dk$)
                last$ = dk$
            ENDIF
            DIM cp = ev{"competitions"}[0]
            DIM co = cp{"competitors"}
            DIM lbl$ = HHMM$(TXT$(ev{"date"})) + "  " + TXT$(co[0]{"team"}{"abbreviation"}) + " " + TXT$(co[0]{"score"}) + "-" + TXT$(co[1]{"score"}) + " " + TXT$(co[1]{"team"}{"abbreviation"})
            IF GUI.SELECTABLE(lbl$ + "##" + FORMAT$("{}", i), i = gSelIdx) THEN gSelIdx = i
        NEXT i
        GUI.END_CHILD
    ENDIF
    GUI.SAME_LINE
    IF GUI.BEGIN_CHILD("det", 0, 0) THEN
        IF gSelIdx >= 0 ANDALSO gSelIdx < LEN(gSched) THEN
            MATCH_DETAIL gSched[gSelIdx]
        ELSE
            GUI.TEXT "Spiel links waehlen ..."
        ENDIF
        GUI.END_CHILD
    ENDIF
ENDSUB

' open a URL in the system default browser (standalone GFX app, not via MCP)
SUB OPEN_URL(u$)
    IF LEN(u$) > 8 THEN DIM r = OS.EXEC("cmd", ["/c", "start", "", u$])
ENDSUB

SUB NEWS_TAB()
    DIM mx = LEN(gNews)
    IF mx > 10 THEN mx = 10
    IF mx = 0 THEN GUI.TEXT "(keine News)"
    DIM i
    FOR i = 0 TO mx - 1
        DIM a = gNews[i]
        GUI.SEPARATOR
        IF GUI.SELECTABLE(TXT$(a{"headline"}) + "##news" + FORMAT$("{}", i)) THEN OPEN_URL TXT$(a{"links"}{"web"}{"href"})
        DIM im = a{"images"}
        IF NOT ISNONE(im) ANDALSO LEN(im) > 0 THEN
            DIM nid = IMG(TXT$(im[0]{"url"}), "news" + FORMAT$("{}", i))
            IF nid >= 0 THEN GUI.IMAGE nid, 240, 135
        ENDIF
        GUI.TEXT DTSHORT$(TXT$(a{"published"})) + "    [" + TXT$(a{"type"}) + "]   (Titel klicken -> Browser)"
        GUI.TEXT_WRAPPED(TXT$(a{"description"}))
    NEXT i
ENDSUB

' ── load data ────────────────────────────────────────────────
SPLASH "Anpfiff! Verbinde mit der WM 2026 - Daten werden geladen...", 0.15
DIM sj = JSON.PARSE$(HTTP.GET$("https://site.api.espn.com/apis/v2/sports/soccer/fifa.world/standings"))
DIM gStand = sj{"children"}
DIM gi
FOR gi = 0 TO LEN(gStand) - 1
    DIM grp = gStand[gi]
    DIM gn$ = TXT$(grp{"name"})
    DIM ent = grp{"standings"}{"entries"}
    DIM j
    FOR j = 0 TO LEN(ent) - 1
        DIM tm = ent[j]{"team"}
        DIM rec AS MAP
        rec{"code"} = TXT$(tm{"abbreviation"})
        rec{"name"} = TXT$(tm{"displayName"})
        rec{"grp"} = gn$
        gTeams = APPEND(gTeams, rec)
    NEXT j
NEXT gi
SPLASH "Spielplan wird geladen...", 0.3
DIM scj = JSON.PARSE$(HTTP.GET$(SB$ + "?dates=20260611-20260703"))
gSched = scj{"events"}
SPLASH "Nachrichten werden geladen...", 0.32
gNews = JSON.PARSE$(HTTP.GET$("https://site.api.espn.com/apis/site/v2/sports/soccer/fifa.world/news")){"articles"}
DIM pf
FOR pf = 0 TO LEN(gTeams) - 1
    SPLASH "Hole die Flaggen aus aller Welt...  " + FORMAT$("{}", pf + 1) + "/" + FORMAT$("{}", LEN(gTeams)), 0.3 + 0.7 * (pf + 1) / LEN(gTeams)
    DIM ig = FLAG(TXT$(gTeams[pf]{"code"}))
NEXT pf
PRINT "teams: "; LEN(gTeams); "  matches: "; LEN(gSched)

DIM args = OS.ARGS()
DIM testmode = (LEN(args) >= 2 ANDALSO args[1] = "shot")
DIM testtab$ = ""
IF LEN(args) >= 3 THEN testtab$ = args[2]
IF testmode ANDALSO (testtab$ = "match" ORELSE testtab$ = "stats" ORELSE testtab$ = "lineup") THEN
    DIM ti
    FOR ti = 0 TO LEN(gSched) - 1
        IF gSelIdx < 0 ANDALSO TXT$(gSched[ti]{"competitions"}[0]{"status"}{"type"}{"state"}) = "post" THEN gSelIdx = ti
    NEXT ti
ENDIF

DIM frame = 0
DO
    CLS
    IF GUI.BEGIN("FIFA World Cup 2026", 0, 0, 1100, 740) THEN
        IF testmode ANDALSO testtab$ = "nat" THEN
            NATIONS_GRID()
        ELSEIF testmode ANDALSO testtab$ = "match" THEN
            SCHEDULE_TAB()
        ELSEIF testmode ANDALSO testtab$ = "stats" THEN
            MATCH_HEADER gSched[gSelIdx]
            MATCH_STATS TXT$(gSched[gSelIdx]{"id"})
        ELSEIF testmode ANDALSO testtab$ = "lineup" THEN
            MATCH_LINEUPS TXT$(gSched[gSelIdx]{"id"})
        ELSEIF testmode ANDALSO testtab$ = "team" THEN
            TEAM_DETAIL "MEX"
        ELSEIF testmode ANDALSO testtab$ = "news" THEN
            NEWS_TAB()
        ELSE
            IF GUI.BEGIN_TAB_BAR("tabs") THEN
                IF GUI.BEGIN_TAB_ITEM("Gruppen") THEN
                    DIM g2
                    FOR g2 = 0 TO LEN(gStand) - 1
                        GROUP_TABLE gStand[g2]
                    NEXT g2
                    GUI.END_TAB_ITEM
                ENDIF
                IF GUI.BEGIN_TAB_ITEM("Nationen") THEN
                    IF gSelTeam$ = "" THEN
                        NATIONS_GRID()
                    ELSE
                        TEAM_DETAIL gSelTeam$
                    ENDIF
                    GUI.END_TAB_ITEM
                ENDIF
                IF GUI.BEGIN_TAB_ITEM("Spielplan") THEN
                    SCHEDULE_TAB()
                    GUI.END_TAB_ITEM
                ENDIF
                IF GUI.BEGIN_TAB_ITEM("News") THEN
                    NEWS_TAB()
                    GUI.END_TAB_ITEM
                ENDIF
                GUI.END_TAB_BAR
            ENDIF
        ENDIF
        GUI.END
    ENDIF
    frame = frame + 1
    SCREENFLIP
    IF testmode THEN
        IF frame = 6 THEN GFX.SAVE_SCREENSHOT("tmp/dash.png")
        IF frame >= 6 THEN EXITDO
    ELSE
        IF INKEY$() = CHR$(27) THEN EXITDO
    ENDIF
LOOP
GFX.CLOSE
PRINT "done"
