' jdTrakr - a kanban ticket board. A thin app on the JDWEB framework.
' Run from this folder (needs jdweb.jdb + jdtrakr.json alongside):
'   build\jdBasic.exe jdtrakr.jdb
IMPORT JDWEB

' --- config (resolved relative to this script, so it works from any cwd) ---
gAppDir$ = PATH.DIRNAME$(OS.ARGS()[0])
gCfg = JSON.PARSE$(TXTREADER$(PATH.JOIN$(gAppDir$, "jdtrakr.json")))
gApp$ = "" + gCfg{"app"}
gSecure = FALSE
IF TYPEOF(gCfg{"secure"}) <> "NONE" ANDALSO gCfg{"secure"} = TRUE THEN gSecure = TRUE

gDb = SQL.OPEN(gCfg{"db"})
IF gDb = 0 THEN
    PRINT "Cannot open database: " + SQL.ERRMSG$(0)
    END
ENDIF

' JDWEB owns the users + sessions tables; the app owns its domain tables.
JDWEB.AUTH_INIT(gDb)
SQL.EXEC(gDb, "CREATE TABLE IF NOT EXISTS tickets (" + _
    "id INTEGER PRIMARY KEY AUTOINCREMENT, " + _
    "title TEXT NOT NULL, " + _
    "description TEXT, " + _
    "status TEXT NOT NULL DEFAULT 'todo', " + _
    "assignee TEXT, " + _
    "priority TEXT DEFAULT 'medium', " + _
    "created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
SQL.EXEC(gDb, "CREATE TABLE IF NOT EXISTS comments (" + _
    "id INTEGER PRIMARY KEY AUTOINCREMENT, ticket_id INTEGER NOT NULL, " + _
    "author TEXT, body TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
SQL.EXEC(gDb, "CREATE TABLE IF NOT EXISTS history (" + _
    "id INTEGER PRIMARY KEY AUTOINCREMENT, ticket_id INTEGER NOT NULL, " + _
    "actor TEXT, action TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")

' projects + ticket dependencies (predecessor / blocked-by)
SQL.EXEC(gDb, "CREATE TABLE IF NOT EXISTS projects (" + _
    "id INTEGER PRIMARY KEY AUTOINCREMENT, key TEXT UNIQUE NOT NULL, " + _
    "name TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
SQL.EXEC(gDb, "CREATE TABLE IF NOT EXISTS deps (" + _
    "id INTEGER PRIMARY KEY AUTOINCREMENT, ticket_id INTEGER NOT NULL, " + _
    "blocked_by INTEGER NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
SQL.EXEC(gDb, "CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT)")

' add new ticket columns once (SQLite has no IF NOT EXISTS for ADD COLUMN)
IF NOT HAS_COLUMN("tickets", "project_id") THEN
    SQL.EXEC(gDb, "ALTER TABLE tickets ADD COLUMN project_id INTEGER")
ENDIF
IF NOT HAS_COLUMN("tickets", "severity") THEN
    SQL.EXEC(gDb, "ALTER TABLE tickets ADD COLUMN severity TEXT DEFAULT 'minor'")
ENDIF
IF NOT HAS_COLUMN("tickets", "type") THEN
    SQL.EXEC(gDb, "ALTER TABLE tickets ADD COLUMN type TEXT DEFAULT 'task'")
ENDIF

' ensure a default project and adopt any project-less tickets
IF LEN(SQL.QUERY(gDb, "SELECT id FROM projects WHERE key = 'jdbasic'")) = 0 THEN
    SQL.EXEC(gDb, "INSERT INTO projects (key, name) VALUES ('jdbasic', 'jdBasic')")
ENDIF
gDefProj = INT(SQL.QUERY(gDb, "SELECT id FROM projects WHERE key = 'jdbasic'")[0]{"id"})
SQL.EXEC(gDb, "UPDATE tickets SET project_id = " + STR$(gDefProj) + _
    " WHERE project_id IS NULL OR project_id = 0")

gStop = FALSE

' --- app helpers ---

FUNC ESC$(s$)
    RETURN REPLACE$(s$, "'", "''")
ENDFUNC

FUNC SETTING$(key$, default$)
    r = SQL.QUERY(gDb, "SELECT value FROM settings WHERE key = '" + ESC$(key$) + "'")
    IF LEN(r) = 0 THEN RETURN default$
    RETURN "" + r[0]{"value"}
ENDFUNC

FUNC FIELD$(obj, key$)
    v = obj{key$}
    IF TYPEOF(v) = "NONE" THEN RETURN ""
    RETURN TRIM$("" + v)
ENDFUNC

FUNC PARAM$(request, key$)
    p = request{"PARAMS"}
    IF TYPEOF(p) = "NONE" THEN RETURN ""
    v = p{key$}
    IF TYPEOF(v) = "NONE" THEN RETURN ""
    RETURN "" + v
ENDFUNC

FUNC HAS_COLUMN(table$, col$)
    rows = SQL.QUERY(gDb, "PRAGMA table_info(" + table$ + ")")
    FOR i = 0 TO LEN(rows) - 1
        IF ("" + rows[i]{"name"}) = col$ THEN RETURN TRUE
    NEXT
    RETURN FALSE
ENDFUNC

FUNC SLUG$(s$)
    out$ = ""
    FOR i = 0 TO LEN(s$) - 1
        ch$ = MID$(s$, i, 1)
        IF (ch$ >= "A" ANDALSO ch$ <= "Z") ORELSE (ch$ >= "a" ANDALSO ch$ <= "z") ORELSE (ch$ >= "0" ANDALSO ch$ <= "9") THEN
            out$ = out$ + ch$
        ELSEIF ch$ = " " ORELSE ch$ = "-" ORELSE ch$ = "_" THEN
            IF LEN(out$) > 0 ANDALSO RIGHT$(out$, 1) <> "-" THEN out$ = out$ + "-"
        ENDIF
    NEXT
    IF LEN(out$) = 0 THEN out$ = "p"
    RETURN LOWER$(out$)
ENDFUNC

' --- API-key auth: machine clients send the key in a header; humans use cookies ---
FUNC API_KEY$(request)
    h = request{"HEADERS"}
    IF TYPEOF(h) = "NONE" THEN RETURN ""
    v = h{"x-api-key"}
    IF TYPEOF(v) <> "NONE" THEN RETURN TRIM$("" + v)
    a = h{"authorization"}
    IF TYPEOF(a) = "NONE" THEN RETURN ""
    s$ = TRIM$("" + a)
    IF LEFT$(s$, 7) = "Bearer " THEN RETURN TRIM$(MID$(s$, 7, LEN(s$)))
    RETURN s$
ENDFUNC

FUNC API_OK(request)
    expected$ = TRIM$(GETENV$("JDTRAKR_API"))
    IF LEN(expected$) = 0 THEN RETURN FALSE
    RETURN API_KEY$(request) = expected$
ENDFUNC

' acting identity: a logged-in human, else "Kaiku" for a valid API key, else ""
FUNC ACTOR$(request)
    u$ = JDWEB.AUTH_USER$(gDb, request)
    IF LEN(u$) > 0 THEN RETURN u$
    IF API_OK(request) THEN RETURN "Kaiku"
    RETURN ""
ENDFUNC

' resolve a project ref (numeric id or key slug) to an id; -1 if unknown, 0 if blank
FUNC PROJ_ID(ref$)
    s$ = TRIM$(ref$)
    IF LEN(s$) = 0 THEN RETURN 0
    isnum = TRUE
    FOR i = 0 TO LEN(s$) - 1
        ch$ = MID$(s$, i, 1)
        IF ch$ < "0" ORELSE ch$ > "9" THEN isnum = FALSE
    NEXT
    IF isnum THEN RETURN INT(VAL(s$))
    r = SQL.QUERY(gDb, "SELECT id FROM projects WHERE key = '" + ESC$(s$) + "'")
    IF LEN(r) = 0 THEN RETURN -1
    RETURN INT(r[0]{"id"})
ENDFUNC

FUNC VALID_STATUS(st$)
    RETURN st$ = "todo" ORELSE st$ = "blocked" ORELSE st$ = "doing" ORELSE st$ = "review" ORELSE st$ = "done"
ENDFUNC

FUNC STATUS_LABEL$(st$)
    IF st$ = "todo" THEN RETURN "To Do"
    IF st$ = "blocked" THEN RETURN "Blocked"
    IF st$ = "doing" THEN RETURN "In Progress"
    IF st$ = "review" THEN RETURN "Review"
    IF st$ = "done" THEN RETURN "Done"
    RETURN st$
ENDFUNC

FUNC VALID_SEVERITY(s$)
    RETURN s$ = "blocker" ORELSE s$ = "critical" ORELSE s$ = "major" ORELSE s$ = "minor" ORELSE s$ = "trivial"
ENDFUNC

FUNC VALID_TYPE(t$)
    RETURN t$ = "bug" ORELSE t$ = "feature" ORELSE t$ = "chore" ORELSE t$ = "idea" ORELSE t$ = "task"
ENDFUNC

FUNC WHO_LABEL$(w$)
    IF LEN(w$) = 0 THEN RETURN "Unassigned"
    RETURN w$
ENDFUNC

SUB LOG_HIST(ticket_id, actor$, action$)
    a$ = TRIM$(actor$)
    IF LEN(a$) = 0 THEN a$ = "Someone"
    SQL.EXEC(gDb, "INSERT INTO history (ticket_id, actor, action) VALUES (" + _
        STR$(INT(ticket_id)) + ", '" + ESC$(a$) + "', '" + ESC$(action$) + "')")
ENDSUB

' --- auth route wrappers (the server calls handlers by name, so we delegate) ---

FUNC HandleLogin(request)
    RETURN JDWEB.AUTH_LOGIN(gDb, request, gSecure)
ENDFUNC

FUNC HandleLogout(request)
    RETURN JDWEB.AUTH_LOGOUT(gDb, request)
ENDFUNC

FUNC HandleMe(request)
    RETURN JDWEB.AUTH_ME(gDb, request)
ENDFUNC

FUNC HandleLoginPage(request)
    RETURN JDWEB.LOGIN_PAGE$(gCfg)
ENDFUNC

FUNC Handle404(request)
    RETURN JDWEB.NOT_FOUND$(gCfg)
ENDFUNC

' --- ticket API ---

FUNC HandleTickets(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    where$ = "WHERE 1=1"
    pj$ = PARAM$(request, "project")
    IF LEN(pj$) > 0 ANDALSO pj$ <> "all" THEN where$ = where$ + " AND t.project_id = " + STR$(PROJ_ID(pj$))
    as$ = PARAM$(request, "assignee")
    IF LEN(as$) > 0 THEN where$ = where$ + " AND t.assignee = '" + ESC$(as$) + "'"
    st$ = PARAM$(request, "status")
    IF LEN(st$) > 0 THEN where$ = where$ + " AND t.status = '" + ESC$(st$) + "'"
    sv$ = PARAM$(request, "severity")
    IF LEN(sv$) > 0 THEN where$ = where$ + " AND t.severity = '" + ESC$(sv$) + "'"
    ty$ = PARAM$(request, "type")
    IF LEN(ty$) > 0 THEN where$ = where$ + " AND t.type = '" + ESC$(ty$) + "'"
    q$ = PARAM$(request, "q")
    IF LEN(q$) > 0 THEN where$ = where$ + " AND (t.title LIKE '%" + ESC$(q$) + "%' OR t.description LIKE '%" + ESC$(q$) + "%')"
    rows = SQL.QUERY(gDb, "SELECT t.id, t.title, t.description, t.status, t.assignee, t.priority, " + _
        "t.severity, t.type, t.project_id, p.key AS project_key, p.name AS project_name, t.created_at " + _
        "FROM tickets t LEFT JOIN projects p ON p.id = t.project_id " + where$ + " ORDER BY t.id DESC")
    RETURN { "tickets": rows }
ENDFUNC

FUNC HandleTicket(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    id = INT(VAL(PARAM$(request, "id")))
    rows = SQL.QUERY(gDb, "SELECT t.*, p.key AS project_key, p.name AS project_name " + _
        "FROM tickets t LEFT JOIN projects p ON p.id = t.project_id WHERE t.id = " + STR$(id))
    IF LEN(rows) = 0 THEN RETURN { "error": "not found" }
    comments = SQL.QUERY(gDb, "SELECT id, author, body, created_at FROM comments " + _
        "WHERE ticket_id = " + STR$(id) + " ORDER BY id")
    hist = SQL.QUERY(gDb, "SELECT actor, action, created_at FROM history " + _
        "WHERE ticket_id = " + STR$(id) + " ORDER BY id DESC")
    blockers = SQL.QUERY(gDb, "SELECT b.id, b.title, b.status FROM deps d " + _
        "JOIN tickets b ON b.id = d.blocked_by WHERE d.ticket_id = " + STR$(id) + " ORDER BY b.id")
    blocks = SQL.QUERY(gDb, "SELECT b.id, b.title, b.status FROM deps d " + _
        "JOIN tickets b ON b.id = d.ticket_id WHERE d.blocked_by = " + STR$(id) + " ORDER BY b.id")
    RETURN { "ticket": rows[0], "comments": comments, "history": hist, "blockers": blockers, "blocks": blocks }
ENDFUNC

FUNC HandleCreate(request)
    u$ = ACTOR$(request)
    IF LEN(u$) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    title$ = FIELD$(body, "title")
    IF LEN(title$) = 0 THEN RETURN { "error": "title required" }

    desc$ = FIELD$(body, "description")
    who$ = FIELD$(body, "assignee")
    prio$ = FIELD$(body, "priority")
    IF prio$ <> "low" ANDALSO prio$ <> "high" THEN prio$ = "medium"
    sev$ = FIELD$(body, "severity")
    IF NOT VALID_SEVERITY(sev$) THEN sev$ = "minor"
    ty$ = FIELD$(body, "type")
    IF NOT VALID_TYPE(ty$) THEN ty$ = "task"
    pid = PROJ_ID(FIELD$(body, "project"))
    IF pid <= 0 THEN pid = gDefProj

    sql$ = "INSERT INTO tickets (title, description, status, assignee, priority, severity, type, project_id) VALUES ('" + _
        ESC$(title$) + "', '" + ESC$(desc$) + "', 'todo', '" + ESC$(who$) + "', '" + ESC$(prio$) + "', '" + _
        ESC$(sev$) + "', '" + ESC$(ty$) + "', " + STR$(pid) + ")"
    IF SQL.EXEC(gDb, sql$) < 0 THEN RETURN { "error": SQL.ERRMSG$(gDb) }

    r = SQL.QUERY(gDb, "SELECT last_insert_rowid() AS nid")
    nid = INT(r[0]{"nid"})
    LOG_HIST nid, u$, "created the ticket"
    RETURN { "ok": TRUE, "id": nid }
ENDFUNC

FUNC HandleUpdate(request)
    actor$ = ACTOR$(request)
    IF LEN(actor$) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    id = INT(body{"id"})

    rows = SQL.QUERY(gDb, "SELECT * FROM tickets WHERE id = " + STR$(id))
    IF LEN(rows) = 0 THEN RETURN { "error": "not found" }
    cur = rows[0]

    title$ = FIELD$(body, "title")
    IF LEN(title$) = 0 THEN RETURN { "error": "title required" }
    desc$ = FIELD$(body, "description")
    who$ = FIELD$(body, "assignee")
    prio$ = FIELD$(body, "priority")
    IF prio$ <> "low" ANDALSO prio$ <> "high" THEN prio$ = "medium"
    st$ = FIELD$(body, "status")
    IF NOT VALID_STATUS(st$) THEN st$ = "" + cur{"status"}
    sev$ = FIELD$(body, "severity")
    IF NOT VALID_SEVERITY(sev$) THEN sev$ = "" + cur{"severity"}
    ty$ = FIELD$(body, "type")
    IF NOT VALID_TYPE(ty$) THEN ty$ = "" + cur{"type"}
    pid = INT(cur{"project_id"})
    pref$ = FIELD$(body, "project")
    IF LEN(pref$) > 0 THEN
        np = PROJ_ID(pref$)
        IF np > 0 THEN pid = np
    ENDIF

    IF title$ <> ("" + cur{"title"}) THEN LOG_HIST id, actor$, "renamed to: " + title$
    IF desc$ <> ("" + cur{"description"}) THEN LOG_HIST id, actor$, "edited the description"
    IF who$ <> ("" + cur{"assignee"}) THEN LOG_HIST id, actor$, "assigned to " + WHO_LABEL$(who$)
    IF prio$ <> ("" + cur{"priority"}) THEN LOG_HIST id, actor$, "set priority to " + prio$
    IF sev$ <> ("" + cur{"severity"}) THEN LOG_HIST id, actor$, "set severity to " + sev$
    IF ty$ <> ("" + cur{"type"}) THEN LOG_HIST id, actor$, "set type to " + ty$
    IF st$ <> ("" + cur{"status"}) THEN LOG_HIST id, actor$, "moved to " + STATUS_LABEL$(st$)
    IF pid <> INT(cur{"project_id"}) THEN LOG_HIST id, actor$, "moved to another project"

    sql$ = "UPDATE tickets SET title='" + ESC$(title$) + "', description='" + ESC$(desc$) + _
        "', assignee='" + ESC$(who$) + "', priority='" + ESC$(prio$) + "', status='" + ESC$(st$) + _
        "', severity='" + ESC$(sev$) + "', type='" + ESC$(ty$) + "', project_id=" + STR$(pid) + _
        " WHERE id = " + STR$(id)
    IF SQL.EXEC(gDb, sql$) < 0 THEN RETURN { "error": SQL.ERRMSG$(gDb) }
    RETURN { "ok": TRUE }
ENDFUNC

FUNC HandleMove(request)
    actor$ = ACTOR$(request)
    IF LEN(actor$) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    id = INT(body{"id"})
    st$ = FIELD$(body, "status")
    IF NOT VALID_STATUS(st$) THEN RETURN { "error": "bad status" }

    rows = SQL.QUERY(gDb, "SELECT status FROM tickets WHERE id = " + STR$(id))
    IF LEN(rows) = 0 THEN RETURN { "error": "not found" }
    old$ = "" + rows[0]{"status"}

    IF SQL.EXEC(gDb, "UPDATE tickets SET status = '" + ESC$(st$) + "' WHERE id = " + STR$(id)) < 0 THEN
        RETURN { "error": SQL.ERRMSG$(gDb) }
    ENDIF
    IF st$ <> old$ THEN LOG_HIST id, actor$, "moved " + STATUS_LABEL$(old$) + " -> " + STATUS_LABEL$(st$)
    RETURN { "ok": TRUE }
ENDFUNC

FUNC HandleDelete(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    id = INT(body{"id"})
    SQL.EXEC(gDb, "DELETE FROM comments WHERE ticket_id = " + STR$(id))
    SQL.EXEC(gDb, "DELETE FROM history WHERE ticket_id = " + STR$(id))
    SQL.EXEC(gDb, "DELETE FROM deps WHERE ticket_id = " + STR$(id) + " OR blocked_by = " + STR$(id))
    IF SQL.EXEC(gDb, "DELETE FROM tickets WHERE id = " + STR$(id)) < 0 THEN
        RETURN { "error": SQL.ERRMSG$(gDb) }
    ENDIF
    RETURN { "ok": TRUE }
ENDFUNC

FUNC HandleComment(request)
    author$ = ACTOR$(request)
    IF LEN(author$) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    id = INT(body{"ticket_id"})
    text$ = FIELD$(body, "body")
    IF LEN(text$) = 0 THEN RETURN { "error": "comment is empty" }

    IF SQL.EXEC(gDb, "INSERT INTO comments (ticket_id, author, body) VALUES (" + _
        STR$(id) + ", '" + ESC$(author$) + "', '" + ESC$(text$) + "')") < 0 THEN
        RETURN { "error": SQL.ERRMSG$(gDb) }
    ENDIF
    LOG_HIST id, author$, "added a comment"
    RETURN { "ok": TRUE }
ENDFUNC

' --- projects + dependencies + agent helper ---

FUNC HandleProjects(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    rows = SQL.QUERY(gDb, "SELECT p.id, p.key, p.name, p.created_at, " + _
        "(SELECT COUNT(*) FROM tickets t WHERE t.project_id = p.id) AS tickets, " + _
        "(SELECT COUNT(*) FROM tickets t WHERE t.project_id = p.id AND t.status <> 'done') AS open " + _
        "FROM projects p ORDER BY p.name")
    RETURN { "projects": rows }
ENDFUNC

FUNC HandleProjectCreate(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    name$ = FIELD$(body, "name")
    IF LEN(name$) = 0 THEN RETURN { "error": "name required" }
    key$ = FIELD$(body, "key")
    IF LEN(key$) = 0 THEN key$ = name$
    key$ = SLUG$(key$)
    IF SQL.EXEC(gDb, "INSERT INTO projects (key, name) VALUES ('" + ESC$(key$) + "', '" + ESC$(name$) + "')") < 0 THEN
        RETURN { "error": "project key already exists" }
    ENDIF
    r = SQL.QUERY(gDb, "SELECT id, key, name FROM projects WHERE key = '" + ESC$(key$) + "'")
    RETURN { "ok": TRUE, "project": r[0] }
ENDFUNC

FUNC HandleProjectDelete(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    pid = PROJ_ID(FIELD$(body, "project"))
    IF pid <= 0 THEN RETURN { "error": "unknown project" }
    IF pid = gDefProj THEN RETURN { "error": "cannot delete the default project" }
    n = SQL.QUERY(gDb, "SELECT COUNT(*) AS c FROM tickets WHERE project_id = " + STR$(pid))
    IF INT(n[0]{"c"}) > 0 THEN RETURN { "error": "project still has tickets" }
    SQL.EXEC(gDb, "DELETE FROM projects WHERE id = " + STR$(pid))
    RETURN { "ok": TRUE }
ENDFUNC

' the single most important thing to do next: highest-priority unblocked todo
FUNC HandleNext(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    who$ = PARAM$(request, "assignee")
    IF LEN(who$) = 0 THEN who$ = "Kaiku"
    pfilter$ = ""
    pj$ = PARAM$(request, "project")
    IF LEN(pj$) > 0 ANDALSO pj$ <> "all" THEN pfilter$ = " AND t.project_id = " + STR$(PROJ_ID(pj$))
    sql$ = "SELECT t.*, p.key AS project_key, p.name AS project_name " + _
        "FROM tickets t LEFT JOIN projects p ON p.id = t.project_id " + _
        "WHERE t.assignee = '" + ESC$(who$) + "' AND t.status = 'todo'" + pfilter$ + _
        " AND NOT EXISTS (SELECT 1 FROM deps d JOIN tickets b ON b.id = d.blocked_by " + _
        "WHERE d.ticket_id = t.id AND b.status <> 'done') " + _
        "ORDER BY CASE t.priority WHEN 'high' THEN 0 WHEN 'medium' THEN 1 ELSE 2 END, " + _
        "CASE t.severity WHEN 'blocker' THEN 0 WHEN 'critical' THEN 1 WHEN 'major' THEN 2 WHEN 'minor' THEN 3 ELSE 4 END, " + _
        "t.id ASC LIMIT 1"
    rows = SQL.QUERY(gDb, sql$)
    IF LEN(rows) = 0 THEN RETURN { "found": FALSE }
    RETURN { "found": TRUE, "ticket": rows[0] }
ENDFUNC

FUNC HandleDepAdd(request)
    actor$ = ACTOR$(request)
    IF LEN(actor$) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    tid = INT(body{"ticket_id"})
    bb = INT(body{"blocked_by"})
    IF tid = bb THEN RETURN { "error": "a ticket cannot block itself" }
    IF LEN(SQL.QUERY(gDb, "SELECT id FROM tickets WHERE id = " + STR$(tid))) = 0 THEN RETURN { "error": "ticket not found" }
    IF LEN(SQL.QUERY(gDb, "SELECT id FROM tickets WHERE id = " + STR$(bb))) = 0 THEN RETURN { "error": "blocker not found" }
    IF LEN(SQL.QUERY(gDb, "SELECT id FROM deps WHERE ticket_id = " + STR$(tid) + " AND blocked_by = " + STR$(bb))) > 0 THEN RETURN { "ok": TRUE }
    SQL.EXEC(gDb, "INSERT INTO deps (ticket_id, blocked_by) VALUES (" + STR$(tid) + ", " + STR$(bb) + ")")
    LOG_HIST tid, actor$, "marked as blocked by #" + STR$(bb)
    RETURN { "ok": TRUE }
ENDFUNC

FUNC HandleDepDel(request)
    actor$ = ACTOR$(request)
    IF LEN(actor$) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    tid = INT(body{"ticket_id"})
    bb = INT(body{"blocked_by"})
    SQL.EXEC(gDb, "DELETE FROM deps WHERE ticket_id = " + STR$(tid) + " AND blocked_by = " + STR$(bb))
    RETURN { "ok": TRUE }
ENDFUNC

' --- settings ---

FUNC HandleSettings(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    RETURN { "board_rows": INT(VAL(SETTING$("board_rows", "5"))) }
ENDFUNC

FUNC HandleSettingsSave(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    n = INT(body{"board_rows"})
    IF n < 1 THEN n = 1
    IF n > 99 THEN n = 99
    SQL.EXEC(gDb, "INSERT OR REPLACE INTO settings (key, value) VALUES ('board_rows', '" + STR$(n) + "')")
    RETURN { "ok": TRUE, "board_rows": n }
ENDFUNC

' --- user API ---

FUNC HandleUsers(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    rows = SQL.QUERY(gDb, "SELECT id, name FROM users ORDER BY name")
    RETURN { "users": rows }
ENDFUNC

FUNC HandleUserCreate(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    name$ = FIELD$(body, "name")
    IF LEN(name$) = 0 THEN RETURN { "error": "name required" }
    IF SQL.EXEC(gDb, "INSERT INTO users (name) VALUES ('" + ESC$(name$) + "')") < 0 THEN
        RETURN { "error": "user already exists" }
    ENDIF
    RETURN { "ok": TRUE }
ENDFUNC

FUNC HandleUserDelete(request)
    IF LEN(ACTOR$(request)) = 0 THEN RETURN JDWEB.UNAUTH()
    body = JSON.PARSE$(request{"BODY"})
    id = INT(body{"id"})
    IF SQL.EXEC(gDb, "DELETE FROM users WHERE id = " + STR$(id)) < 0 THEN
        RETURN { "error": SQL.ERRMSG$(gDb) }
    ENDIF
    RETURN { "ok": TRUE }
ENDFUNC

' --- page bodies (wrapped by JDWEB.PAGE$; no double quotes inside) ---

FUNC BOARD_BODY$()
    nl$ = CHR$(10)
    h$ = "<style>" + nl$
    h$ = h$ + ".filterbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 12px;}" + nl$
    h$ = h$ + ".filterbar select,.filterbar input{padding:6px 8px;background:var(--bg);color:var(--ink);border:1px solid var(--bd2);border-radius:4px;font-family:inherit;}" + nl$
    h$ = h$ + ".filterbar select:focus,.filterbar input:focus{outline:none;border-color:var(--green);box-shadow:0 0 8px rgba(0,255,65,.25);}" + nl$
    h$ = h$ + ".filterbar select option{background:var(--bg);color:var(--ink);}.filterbar .grow{flex:1;min-width:140px;}" + nl$
    h$ = h$ + ".badges{display:flex;flex-wrap:wrap;gap:5px;margin:5px 0;}" + nl$
    h$ = h$ + ".badge{font-size:11px;padding:1px 7px;border-radius:10px;border:1px solid #2a5c35;color:#bfe;text-transform:capitalize;}" + nl$
    h$ = h$ + ".badge.bug{border-color:#c44;color:#f99;}.badge.feature{border-color:#3b8;color:#9fc;}.badge.chore{border-color:#778;color:#bcd;}.badge.idea{border-color:#b83;color:#fd9;}" + nl$
    h$ = h$ + ".badge.blocker,.badge.critical{border-color:#e44;color:#f99;}.badge.major{border-color:#e93;color:#fc9;}.badge.high{border-color:#e44;color:#f99;}.badge.low{border-color:#567;color:#9ab;}" + nl$
    h$ = h$ + ".ptag{color:#6db;font-size:11px;}" + nl$
    h$ = h$ + ".col-blocked h2{color:#e88;}.col-review h2{color:#dd7;}" + nl$
    h$ = h$ + ".mdprev{background:#0b1410;border:1px solid #1c3a24;border-radius:6px;padding:8px 10px;margin-bottom:6px;font-size:13px;min-height:20px;}" + nl$
    h$ = h$ + ".mdprev pre{background:#000;padding:8px;overflow-x:auto;border-radius:4px;}.mdprev ul{margin:4px 0 4px 18px;}.mdprev code{background:#000;padding:1px 4px;border-radius:3px;}" + nl$
    h$ = h$ + ".deprow{display:flex;align-items:center;gap:8px;margin:4px 0;}.depid{max-width:150px;}" + nl$
    h$ = h$ + ".collink{cursor:pointer;}.collink:hover{color:#9fe;text-decoration:underline;}" + nl$
    h$ = h$ + ".listpanel{margin-top:2px;}.listhd{display:flex;align-items:center;gap:14px;margin-bottom:10px;}.listhd h2{margin:0;}" + nl$
    h$ = h$ + "table.ltbl{width:100%;border-collapse:collapse;font-size:13px;}" + nl$
    h$ = h$ + ".ltbl th{text-align:left;padding:7px 10px;border-bottom:1px solid #2a5c35;color:#9fc;cursor:pointer;user-select:none;white-space:nowrap;}" + nl$
    h$ = h$ + ".ltbl td{padding:7px 10px;border-bottom:1px solid #14241a;vertical-align:top;}" + nl$
    h$ = h$ + ".lrow{cursor:pointer;}.lrow:hover{background:#0e1812;}.ltitle{color:#d6ffe2;}" + nl$
    h$ = h$ + ".ldesc{color:#5fae6f;font-size:11px;max-width:46ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}" + nl$
    h$ = h$ + ".lrow.prio-high td:first-child{border-left:3px solid #e44;}.lrow.prio-low td:first-child{border-left:3px solid #567;}" + nl$
    h$ = h$ + ".card .desc{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;white-space:normal;}" + nl$
    h$ = h$ + ".morelink{cursor:pointer;color:#6db;font-size:12px;margin-top:8px;padding:2px 0;}.morelink:hover{text-decoration:underline;}" + nl$
    h$ = h$ + "</style>" + nl$
    h$ = h$ + "<div class='filterbar'>" + nl$
    h$ = h$ + "  <select id='fproj'></select>" + nl$
    h$ = h$ + "  <select id='fasg'></select>" + nl$
    h$ = h$ + "  <select id='fsev'><option value=''>Any severity</option><option>blocker</option><option>critical</option><option>major</option><option>minor</option><option>trivial</option></select>" + nl$
    h$ = h$ + "  <select id='ftype'><option value=''>Any type</option><option>bug</option><option>feature</option><option>chore</option><option>idea</option><option>task</option></select>" + nl$
    h$ = h$ + "  <input id='fq' class='grow' placeholder='Search...' autocomplete='off'>" + nl$
    h$ = h$ + "</div>" + nl$
    h$ = h$ + "<form class='add' id='addForm'>" + nl$
    h$ = h$ + "  <input class='title' name='title' placeholder='Ticket title' autocomplete='off'>" + nl$
    h$ = h$ + "  <input class='desc' name='description' placeholder='Description (markdown, optional)' autocomplete='off'>" + nl$
    h$ = h$ + "  <select id='addproj' name='project'></select>" + nl$
    h$ = h$ + "  <select id='assignee' name='assignee'></select>" + nl$
    h$ = h$ + "  <select name='priority'><option value='low'>Low</option><option value='medium' selected>Medium</option><option value='high'>High</option></select>" + nl$
    h$ = h$ + "  <select name='severity'><option>minor</option><option>trivial</option><option>major</option><option>critical</option><option>blocker</option></select>" + nl$
    h$ = h$ + "  <select name='type'><option>task</option><option>feature</option><option>bug</option><option>chore</option><option>idea</option></select>" + nl$
    h$ = h$ + "  <button type='submit'>Add ticket</button>" + nl$
    h$ = h$ + "</form>" + nl$
    h$ = h$ + "<div id='board'></div>" + nl$
    h$ = h$ + "<script>" + nl$
    h$ = h$ + "const STATUSES=['todo','blocked','doing','review','done'];" + nl$
    h$ = h$ + "const LABELS={todo:'To Do',blocked:'Blocked',doing:'In Progress',review:'Review',done:'Done'};" + nl$
    h$ = h$ + "async function api(path,data){" + nl$
    h$ = h$ + "  const opt=data?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}:{};" + nl$
    h$ = h$ + "  const r=await fetch(path,opt);if(r.status===401){location='/login';return {};}return r.json();}" + nl$
    h$ = h$ + "function btn(label,cls,fn){const b=document.createElement('button');b.textContent=label;b.className=cls;" + nl$
    h$ = h$ + "  b.addEventListener('click',(e)=>{e.stopPropagation();fn();});return b;}" + nl$
    h$ = h$ + "function fieldEl(label,el){const w=document.createElement('div');const l=document.createElement('label');l.textContent=label;w.appendChild(l);w.appendChild(el);return w;}" + nl$
    h$ = h$ + "function selEl(options,val){const s=document.createElement('select');for(const o of options){const op=document.createElement('option');op.value=o[0];op.textContent=o[1];if(o[0]===val)op.selected=true;s.appendChild(op);}return s;}" + nl$
    h$ = h$ + "function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}" + nl$
    h$ = h$ + "function mdToHtml(src){let s=esc(src);" + nl$
    h$ = h$ + "  s=s.replace(/```([\s\S]*?)```/g,function(m,c){return '<pre>'+c.replace(/^\n/,'').replace(/\n/g,'@@NL@@')+'</pre>';});" + nl$
    h$ = h$ + "  s=s.replace(/`([^`]+)`/g,'<code>$1</code>');" + nl$
    h$ = h$ + "  s=s.replace(/^###\s+(.*)$/gm,'<h5>$1</h5>').replace(/^##\s+(.*)$/gm,'<h4>$1</h4>').replace(/^#\s+(.*)$/gm,'<h3>$1</h3>');" + nl$
    h$ = h$ + "  s=s.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>');" + nl$
    h$ = h$ + "  s=s.replace(/^[\-\*]\s+(.*)$/gm,'<li>$1</li>').replace(/(<li>[\s\S]*?<\/li>(?:\n<li>[\s\S]*?<\/li>)*)/g,function(m){return '<ul>'+m.replace(/\n/g,'')+'</ul>';});" + nl$
    h$ = h$ + "  s=s.replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g,'$1 ($2)');" + nl$
    h$ = h$ + "  return s.replace(/\n/g,'<br>').replace(/@@NL@@/g,'\n');}" + nl$
    h$ = h$ + "function fval(id){return document.getElementById(id).value;}" + nl$
    h$ = h$ + "async function loadProjects(){const res=await api('/api/projects');window.PROJ=res.projects||[];" + nl$
    h$ = h$ + "  const fp=document.getElementById('fproj');const ap=document.getElementById('addproj');fp.innerHTML='';ap.innerHTML='';" + nl$
    h$ = h$ + "  const a0=document.createElement('option');a0.value='all';a0.textContent='Alle Projekte';fp.appendChild(a0);" + nl$
    h$ = h$ + "  for(const p of window.PROJ){const o=document.createElement('option');o.value=p.key;o.textContent=p.name;fp.appendChild(o);" + nl$
    h$ = h$ + "    const o2=document.createElement('option');o2.value=p.key;o2.textContent=p.name;ap.appendChild(o2);}}" + nl$
    h$ = h$ + "async function loadUsers(){const res=await api('/api/users');window.USERS=res.users||[];const names=window.USERS.map(u=>u.name);" + nl$
    h$ = h$ + "  const fa=document.getElementById('fasg');fa.innerHTML='';const a0=document.createElement('option');a0.value='';a0.textContent='Alle Personen';fa.appendChild(a0);" + nl$
    h$ = h$ + "  for(const n of ['Unassigned'].concat(names)){const o=document.createElement('option');o.value=n;o.textContent=n;fa.appendChild(o);}" + nl$
    h$ = h$ + "  const sel=document.getElementById('assignee');sel.innerHTML='';" + nl$
    h$ = h$ + "  for(const n of ['Unassigned'].concat(names)){const o=document.createElement('option');o.value=(n==='Unassigned'?'':n);o.textContent=n;sel.appendChild(o);}}" + nl$
    h$ = h$ + "async function load(){const res=await api('/api/tickets?project='+encodeURIComponent(fval('fproj')));" + nl$
    h$ = h$ + "  let ts=res.tickets||[];const asg=fval('fasg'),sev=fval('fsev'),ty=fval('ftype'),q=fval('fq').toLowerCase();" + nl$
    h$ = h$ + "  ts=ts.filter(t=>{if(asg==='Unassigned'){if(t.assignee)return false;}else if(asg){if(t.assignee!==asg)return false;}" + nl$
    h$ = h$ + "    if(sev&&t.severity!==sev)return false;if(ty&&t.type!==ty)return false;" + nl$
    h$ = h$ + "    if(q&&!((t.title||'').toLowerCase().includes(q)||(t.description||'').toLowerCase().includes(q)))return false;return true;});" + nl$
    h$ = h$ + "  if(LISTST){renderList(ts);}else{render(ts);}}" + nl$
    h$ = h$ + "function badge(cls,txt){const s=document.createElement('span');s.className='badge '+cls;s.textContent=txt;return s;}" + nl$
    h$ = h$ + "function card(t){" + nl$
    h$ = h$ + "  const d=document.createElement('div');d.className='card prio-'+(t.priority||'medium');d.addEventListener('click',()=>openTicket(t.id));" + nl$
    h$ = h$ + "  const ti=document.createElement('div');ti.className='title';ti.textContent='#'+t.id+'  '+t.title;d.appendChild(ti);" + nl$
    h$ = h$ + "  const bg=document.createElement('div');bg.className='badges';bg.appendChild(badge(t.type||'task',t.type||'task'));" + nl$
    h$ = h$ + "  bg.appendChild(badge(t.severity||'minor',t.severity||'minor'));bg.appendChild(badge(t.priority||'medium',t.priority||'medium'));d.appendChild(bg);" + nl$
    h$ = h$ + "  if(t.description){const de=document.createElement('div');de.className='desc';de.textContent=t.description;d.appendChild(de);}" + nl$
    h$ = h$ + "  const me=document.createElement('div');me.className='meta';me.textContent=(t.assignee||'Unassigned');" + nl$
    h$ = h$ + "  if(fval('fproj')==='all'&&t.project_name){const pt=document.createElement('span');pt.className='ptag';pt.textContent='  '+t.project_name;me.appendChild(pt);}d.appendChild(me);" + nl$
    h$ = h$ + "  const bar=document.createElement('div');bar.className='bar';const idx=STATUSES.indexOf(t.status);" + nl$
    h$ = h$ + "  if(idx>0)bar.appendChild(btn('Back','ghost',()=>move(t.id,STATUSES[idx-1])));" + nl$
    h$ = h$ + "  if(idx<STATUSES.length-1)bar.appendChild(btn('Next','ghost',()=>move(t.id,STATUSES[idx+1])));" + nl$
    h$ = h$ + "  bar.appendChild(btn('Edit','ghost',()=>openTicket(t.id)));d.appendChild(bar);return d;}" + nl$
    h$ = h$ + "function render(tickets){const board=document.getElementById('board');board.innerHTML='';" + nl$
    h$ = h$ + "  for(const st of STATUSES){const col=document.createElement('div');col.className='col col-'+st;" + nl$
    h$ = h$ + "    const items=tickets.filter(t=>t.status===st);" + nl$
    h$ = h$ + "    const sorted=items.slice().sort((a,b)=>{const da=a.created_at||'',db=b.created_at||'';return da<db?1:da>db?-1:b.id-a.id;});const shown=sorted.slice(0,window.NROWS||5);" + nl$
    h$ = h$ + "    const head=document.createElement('h2');head.textContent=LABELS[st];head.className='collink';head.title='Open list view';head.addEventListener('click',()=>setList(st));" + nl$
    h$ = h$ + "    const c=document.createElement('span');c.className='count';c.textContent=items.length;head.appendChild(c);col.appendChild(head);" + nl$
    h$ = h$ + "    for(const t of shown)col.appendChild(card(t));" + nl$
    h$ = h$ + "    if(items.length>shown.length){const ml=document.createElement('div');ml.className='morelink';ml.textContent='+ '+(items.length-shown.length)+' weitere →';ml.addEventListener('click',()=>setList(st));col.appendChild(ml);}" + nl$
    h$ = h$ + "    board.appendChild(col);}}" + nl$
    h$ = h$ + "let LISTST=null;let LSORT={key:'id',dir:-1};" + nl$
    h$ = h$ + "function setList(st){LISTST=st;location.hash='#list='+st;load();window.scrollTo(0,0);}" + nl$
    h$ = h$ + "function closeList(){LISTST=null;location.hash='#';load();}" + nl$
    h$ = h$ + "function ageStr(s){if(!s)return '';const d=Math.floor((Date.now()-new Date(s.replace(' ','T')).getTime())/86400000);return d<=0?'today':d+'d';}" + nl$
    h$ = h$ + "function tdt(txt){const td=document.createElement('td');td.textContent=txt;return td;}" + nl$
    h$ = h$ + "function tde(el){const td=document.createElement('td');td.appendChild(el);return td;}" + nl$
    h$ = h$ + "function renderList(allt){const board=document.getElementById('board');board.innerHTML='';const st=LISTST;" + nl$
    h$ = h$ + "  let items=allt.filter(t=>t.status===st);" + nl$
    h$ = h$ + "  const PR={high:0,medium:1,low:2},SV={blocker:0,critical:1,major:2,minor:3,trivial:4};" + nl$
    h$ = h$ + "  const cols=[['id','#'],['title','Title'],['type','Type'],['severity','Severity'],['priority','Priority'],['assignee','Assignee'],['project_name','Project'],['created_at','Age']];" + nl$
    h$ = h$ + "  items.sort((a,b)=>{const k=LSORT.key;let va,vb;if(k==='priority'){va=PR[a.priority];vb=PR[b.priority];}else if(k==='severity'){va=SV[a.severity];vb=SV[b.severity];}else if(k==='id'){va=a.id;vb=b.id;}else{va=(a[k]||'').toString().toLowerCase();vb=(b[k]||'').toString().toLowerCase();}return (va<vb?-1:va>vb?1:0)*LSORT.dir;});" + nl$
    h$ = h$ + "  const panel=document.createElement('div');panel.className='listpanel';" + nl$
    h$ = h$ + "  const hd=document.createElement('div');hd.className='listhd';hd.appendChild(btn('← Board','ghost',()=>closeList()));" + nl$
    h$ = h$ + "  const h=document.createElement('h2');h.textContent=LABELS[st]+'  ('+items.length+')';hd.appendChild(h);panel.appendChild(hd);" + nl$
    h$ = h$ + "  const tbl=document.createElement('table');tbl.className='ltbl';const thr=document.createElement('tr');" + nl$
    h$ = h$ + "  for(const c of cols){const th=document.createElement('th');th.textContent=c[1]+(LSORT.key===c[0]?(LSORT.dir>0?' ▲':' ▼'):'');th.addEventListener('click',()=>{if(LSORT.key===c[0])LSORT.dir*=-1;else{LSORT.key=c[0];LSORT.dir=1;}renderList(allt);});thr.appendChild(th);}" + nl$
    h$ = h$ + "  thr.appendChild(document.createElement('th'));tbl.appendChild(thr);" + nl$
    h$ = h$ + "  for(const t of items){const tr=document.createElement('tr');tr.className='lrow prio-'+(t.priority||'medium');tr.addEventListener('click',()=>openTicket(t.id));" + nl$
    h$ = h$ + "    tr.appendChild(tdt('#'+t.id));" + nl$
    h$ = h$ + "    const tt=document.createElement('td');const tn=document.createElement('div');tn.className='ltitle';tn.textContent=t.title;tt.appendChild(tn);if(t.description){const ds=document.createElement('div');ds.className='ldesc';ds.textContent=t.description;tt.appendChild(ds);}tr.appendChild(tt);" + nl$
    h$ = h$ + "    tr.appendChild(tde(badge(t.type||'task',t.type||'task')));tr.appendChild(tde(badge(t.severity||'minor',t.severity||'minor')));tr.appendChild(tde(badge(t.priority||'medium',t.priority||'medium')));" + nl$
    h$ = h$ + "    tr.appendChild(tdt(t.assignee||'Unassigned'));tr.appendChild(tdt(t.project_name||''));tr.appendChild(tdt(ageStr(t.created_at)));" + nl$
    h$ = h$ + "    const act=document.createElement('td');const idx=STATUSES.indexOf(t.status);" + nl$
    h$ = h$ + "    if(idx>0)act.appendChild(btn('←','ghost',()=>move(t.id,STATUSES[idx-1])));" + nl$
    h$ = h$ + "    if(idx<STATUSES.length-1)act.appendChild(btn('→','ghost',()=>move(t.id,STATUSES[idx+1])));" + nl$
    h$ = h$ + "    tr.appendChild(act);tbl.appendChild(tr);}" + nl$
    h$ = h$ + "  panel.appendChild(tbl);board.appendChild(panel);}" + nl$
    h$ = h$ + "async function move(id,status){await api('/api/move',{id:id,status:status});load();}" + nl$
    h$ = h$ + "async function create(ev){ev.preventDefault();const f=ev.target;" + nl$
    h$ = h$ + "  const data={title:f.title.value.trim(),description:f.description.value.trim(),project:f.project.value,assignee:f.assignee.value,priority:f.priority.value,severity:f.severity.value,type:f.type.value};" + nl$
    h$ = h$ + "  if(!data.title)return;await api('/api/create',data);f.reset();load();}" + nl$
    h$ = h$ + "let MODAL=null;function closeModal(){if(MODAL){MODAL.remove();MODAL=null;}}" + nl$
    h$ = h$ + "async function openTicket(id){const res=await api('/api/ticket?id='+id);if(res.error){alert(res.error);return;}showModal(res.ticket,res.comments||[],res.history||[],res.blockers||[]);}" + nl$
    h$ = h$ + "function showModal(t,comments,history,blockers){closeModal();" + nl$
    h$ = h$ + "  const bd=document.createElement('div');bd.className='backdrop';bd.addEventListener('click',e=>{if(e.target===bd)closeModal();});" + nl$
    h$ = h$ + "  const m=document.createElement('div');m.className='modal';" + nl$
    h$ = h$ + "  const hh=document.createElement('h3');hh.textContent='Ticket #'+t.id;m.appendChild(hh);" + nl$
    h$ = h$ + "  const ti=document.createElement('input');ti.value=t.title;m.appendChild(fieldEl('Title',ti));" + nl$
    h$ = h$ + "  const prev=document.createElement('div');prev.className='mdprev';prev.innerHTML=mdToHtml(t.description||'');" + nl$
    h$ = h$ + "  const de=document.createElement('textarea');de.value=t.description||'';de.addEventListener('input',()=>{prev.innerHTML=mdToHtml(de.value);});" + nl$
    h$ = h$ + "  m.appendChild(fieldEl('Description (markdown)',prev));m.appendChild(de);" + nl$
    h$ = h$ + "  const row=document.createElement('div');row.className='row2';" + nl$
    h$ = h$ + "  const prj=selEl((window.PROJ||[]).map(p=>[p.key,p.name]),t.project_key||'');" + nl$
    h$ = h$ + "  const aopts=[['','Unassigned']].concat((window.USERS||[]).map(u=>[u.name,u.name]));const asg=selEl(aopts,t.assignee||'');" + nl$
    h$ = h$ + "  const sta=selEl([['todo','To Do'],['blocked','Blocked'],['doing','In Progress'],['review','Review'],['done','Done']],t.status);" + nl$
    h$ = h$ + "  row.appendChild(fieldEl('Project',prj));row.appendChild(fieldEl('Assignee',asg));row.appendChild(fieldEl('Status',sta));m.appendChild(row);" + nl$
    h$ = h$ + "  const row2=document.createElement('div');row2.className='row2';" + nl$
    h$ = h$ + "  const pri=selEl([['low','Low'],['medium','Medium'],['high','High']],t.priority||'medium');" + nl$
    h$ = h$ + "  const sev=selEl([['blocker','blocker'],['critical','critical'],['major','major'],['minor','minor'],['trivial','trivial']],t.severity||'minor');" + nl$
    h$ = h$ + "  const typ=selEl([['bug','bug'],['feature','feature'],['chore','chore'],['idea','idea'],['task','task']],t.type||'task');" + nl$
    h$ = h$ + "  row2.appendChild(fieldEl('Priority',pri));row2.appendChild(fieldEl('Severity',sev));row2.appendChild(fieldEl('Type',typ));m.appendChild(row2);" + nl$
    h$ = h$ + "  const act=document.createElement('div');act.className='actions';" + nl$
    h$ = h$ + "  act.appendChild(btn('Save changes','cyan',async()=>{const data={id:t.id,title:ti.value.trim(),description:de.value,project:prj.value,assignee:asg.value,priority:pri.value,severity:sev.value,type:typ.value,status:sta.value};" + nl$
    h$ = h$ + "    if(!data.title){alert('Title required');return;}const r=await api('/api/update',data);if(r.error){alert(r.error);return;}closeModal();load();}));" + nl$
    h$ = h$ + "  act.appendChild(btn('Close','ghost',()=>closeModal()));" + nl$
    h$ = h$ + "  const sp=document.createElement('div');sp.className='spacer';act.appendChild(sp);" + nl$
    h$ = h$ + "  act.appendChild(btn('Delete','danger',async()=>{await api('/api/delete',{id:t.id});closeModal();load();}));m.appendChild(act);" + nl$
    h$ = h$ + "  const ds=document.createElement('div');ds.className='sec';const dh=document.createElement('h4');dh.textContent='Blocked by';ds.appendChild(dh);" + nl$
    h$ = h$ + "  for(const b of blockers){const r=document.createElement('div');r.className='deprow';" + nl$
    h$ = h$ + "    const s2=document.createElement('span');s2.textContent='#'+b.id+' '+b.title+' ['+b.status+']';r.appendChild(s2);" + nl$
    h$ = h$ + "    r.appendChild(btn('remove','ghost',async()=>{await api('/api/dep/del',{ticket_id:t.id,blocked_by:b.id});openTicket(t.id);}));ds.appendChild(r);}" + nl$
    h$ = h$ + "  const drow=document.createElement('div');drow.className='deprow';const din=document.createElement('input');din.placeholder='Blocker ticket id';din.className='depid';drow.appendChild(din);" + nl$
    h$ = h$ + "  drow.appendChild(btn('Add blocker','',async()=>{const bid=parseInt(din.value);if(!bid)return;const r=await api('/api/dep/add',{ticket_id:t.id,blocked_by:bid});if(r.error){alert(r.error);return;}openTicket(t.id);}));ds.appendChild(drow);m.appendChild(ds);" + nl$
    h$ = h$ + "  const cs=document.createElement('div');cs.className='sec';const ch=document.createElement('h4');ch.textContent='Comments ('+comments.length+')';cs.appendChild(ch);" + nl$
    h$ = h$ + "  for(const c of comments){const cc=document.createElement('div');cc.className='cmt';" + nl$
    h$ = h$ + "    const wh=document.createElement('div');const who=document.createElement('span');who.className='who';who.textContent=c.author||'Someone';" + nl$
    h$ = h$ + "    const wn=document.createElement('span');wn.className='when';wn.textContent=c.created_at;wh.appendChild(who);wh.appendChild(wn);cc.appendChild(wh);" + nl$
    h$ = h$ + "    const tx=document.createElement('div');tx.className='txt';tx.innerHTML=mdToHtml(c.body);cc.appendChild(tx);cs.appendChild(cc);}" + nl$
    h$ = h$ + "  const cin=document.createElement('textarea');cin.placeholder='Write a comment (markdown)...';cs.appendChild(cin);" + nl$
    h$ = h$ + "  const cw=document.createElement('div');cw.className='actions';" + nl$
    h$ = h$ + "  cw.appendChild(btn('Add comment','',async()=>{const text=cin.value.trim();if(!text)return;const r=await api('/api/comment',{ticket_id:t.id,body:text});if(r.error){alert(r.error);return;}openTicket(t.id);}));" + nl$
    h$ = h$ + "  cs.appendChild(cw);m.appendChild(cs);" + nl$
    h$ = h$ + "  const hs=document.createElement('div');hs.className='sec';const h4=document.createElement('h4');h4.textContent='History';hs.appendChild(h4);" + nl$
    h$ = h$ + "  const ul=document.createElement('ul');ul.className='hist';" + nl$
    h$ = h$ + "  if(history.length===0){const li=document.createElement('li');li.textContent='No activity yet.';ul.appendChild(li);}" + nl$
    h$ = h$ + "  for(const ev of history){const li=document.createElement('li');const b=document.createElement('b');b.textContent=(ev.actor||'Someone')+' ';" + nl$
    h$ = h$ + "    li.appendChild(b);li.appendChild(document.createTextNode(ev.action+'  '));const wn=document.createElement('span');wn.className='when';wn.textContent=ev.created_at;li.appendChild(wn);ul.appendChild(li);}" + nl$
    h$ = h$ + "  hs.appendChild(ul);m.appendChild(hs);" + nl$
    h$ = h$ + "  bd.appendChild(m);document.body.appendChild(bd);MODAL=bd;}" + nl$
    h$ = h$ + "function checkHash(){const m=location.hash.match(/^#t=(\d+)/);if(m){openTicket(parseInt(m[1]));return;}" + nl$
    h$ = h$ + "  const l=location.hash.match(/^#list=([a-z]+)/);const want=(l&&STATUSES.indexOf(l[1])>=0)?l[1]:null;if(want!==LISTST){LISTST=want;load();}}" + nl$
    h$ = h$ + "window.addEventListener('hashchange',checkHash);" + nl$
    h$ = h$ + "for(const id of ['fproj','fasg','fsev','ftype']){document.getElementById(id).addEventListener('change',load);}" + nl$
    h$ = h$ + "document.getElementById('fq').addEventListener('input',load);" + nl$
    h$ = h$ + "document.getElementById('addForm').addEventListener('submit',create);" + nl$
    h$ = h$ + "async function loadSettings(){const s=await api('/api/settings');window.NROWS=s.board_rows||5;}" + nl$
    h$ = h$ + "loadProjects().then(loadUsers).then(loadSettings).then(()=>{load();checkHash();});" + nl$
    h$ = h$ + "</script>"
    RETURN h$
ENDFUNC

FUNC USERS_BODY$()
    nl$ = CHR$(10)
    h$ = "<form class='add' id='userForm'>" + nl$
    h$ = h$ + "  <input class='grow' name='uname' placeholder='Team member name' autocomplete='off'>" + nl$
    h$ = h$ + "  <button type='submit'>Add user</button>" + nl$
    h$ = h$ + "</form>" + nl$
    h$ = h$ + "<div class='wrap'><div id='ulist'></div></div>" + nl$
    h$ = h$ + "<script>" + nl$
    h$ = h$ + "async function api(path,data){" + nl$
    h$ = h$ + "  const opt=data?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}:{};" + nl$
    h$ = h$ + "  const r=await fetch(path,opt);if(r.status===401){location='/login';return {};}return r.json();}" + nl$
    h$ = h$ + "function btn(label,cls,fn){const b=document.createElement('button');b.textContent=label;b.className=cls;b.addEventListener('click',fn);return b;}" + nl$
    h$ = h$ + "async function loadU(){const res=await api('/api/users');const list=document.getElementById('ulist');list.innerHTML='';" + nl$
    h$ = h$ + "  const users=res.users||[];" + nl$
    h$ = h$ + "  if(users.length===0){const e=document.createElement('div');e.className='empty';e.textContent='No users yet. Add your team above.';list.appendChild(e);return;}" + nl$
    h$ = h$ + "  for(const u of users){const row=document.createElement('div');row.className='urow';" + nl$
    h$ = h$ + "    const nm=document.createElement('span');nm.className='uname';nm.textContent=u.name;row.appendChild(nm);" + nl$
    h$ = h$ + "    row.appendChild(btn('Remove','ghost',()=>delU(u.id)));list.appendChild(row);}}" + nl$
    h$ = h$ + "async function delU(id){await api('/api/users/delete',{id:id});loadU();}" + nl$
    h$ = h$ + "async function addU(ev){ev.preventDefault();const f=ev.target;const name=f.uname.value.trim();if(!name)return;" + nl$
    h$ = h$ + "  const r=await api('/api/users/create',{name:name});if(r.error){alert(r.error);}f.reset();loadU();}" + nl$
    h$ = h$ + "document.getElementById('userForm').addEventListener('submit',addU);loadU();" + nl$
    h$ = h$ + "</script>"
    RETURN h$
ENDFUNC

FUNC SETTINGS_BODY$()
    nl$ = CHR$(10)
    h$ = "<div class='wrap'>" + nl$
    h$ = h$ + "<form class='add' id='setForm'>" + nl$
    h$ = h$ + "  <label style='align-self:center'>Rows shown per board column (top by priority)</label>" + nl$
    h$ = h$ + "  <input name='rows' type='number' min='1' max='99' style='max-width:90px'>" + nl$
    h$ = h$ + "  <button type='submit'>Save</button>" + nl$
    h$ = h$ + "</form>" + nl$
    h$ = h$ + "<div id='msg' class='empty'></div></div>" + nl$
    h$ = h$ + "<script>" + nl$
    h$ = h$ + "async function api(path,data){const opt=data?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}:{};const r=await fetch(path,opt);if(r.status===401){location='/login';return {};}return r.json();}" + nl$
    h$ = h$ + "async function loadS(){const s=await api('/api/settings');document.querySelector('#setForm [name=rows]').value=s.board_rows||5;}" + nl$
    h$ = h$ + "document.getElementById('setForm').addEventListener('submit',async(ev)=>{ev.preventDefault();const inp=ev.target.querySelector('[name=rows]');const n=parseInt(inp.value)||5;const r=await api('/api/settings/save',{board_rows:n});document.getElementById('msg').textContent='Saved: '+r.board_rows+' rows per column. Reload the board to apply.';});" + nl$
    h$ = h$ + "loadS();" + nl$
    h$ = h$ + "</script>"
    RETURN h$
ENDFUNC

FUNC PROJECTS_BODY$()
    nl$ = CHR$(10)
    h$ = "<form class='add' id='projForm'>" + nl$
    h$ = h$ + "  <input class='grow' name='pname' placeholder='Project name' autocomplete='off'>" + nl$
    h$ = h$ + "  <input name='pkey' placeholder='key (optional)' autocomplete='off'>" + nl$
    h$ = h$ + "  <button type='submit'>Add project</button>" + nl$
    h$ = h$ + "</form>" + nl$
    h$ = h$ + "<div class='wrap'><div id='plist'></div></div>" + nl$
    h$ = h$ + "<script>" + nl$
    h$ = h$ + "async function api(path,data){const opt=data?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}:{};const r=await fetch(path,opt);if(r.status===401){location='/login';return {};}return r.json();}" + nl$
    h$ = h$ + "function btn(label,cls,fn){const b=document.createElement('button');b.textContent=label;b.className=cls;b.addEventListener('click',fn);return b;}" + nl$
    h$ = h$ + "async function loadP(){const res=await api('/api/projects');const list=document.getElementById('plist');list.innerHTML='';const ps=res.projects||[];" + nl$
    h$ = h$ + "  if(ps.length===0){const e=document.createElement('div');e.className='empty';e.textContent='No projects yet.';list.appendChild(e);return;}" + nl$
    h$ = h$ + "  for(const p of ps){const row=document.createElement('div');row.className='urow';" + nl$
    h$ = h$ + "    const nm=document.createElement('span');nm.className='uname';nm.textContent=p.name+'  ('+p.key+')   '+p.open+' open / '+p.tickets+' total';row.appendChild(nm);" + nl$
    h$ = h$ + "    if(p.key!=='jdbasic')row.appendChild(btn('Remove','ghost',()=>delP(p.key)));list.appendChild(row);}}" + nl$
    h$ = h$ + "async function delP(key){const r=await api('/api/projects/delete',{project:key});if(r.error){alert(r.error);}loadP();}" + nl$
    h$ = h$ + "async function addP(ev){ev.preventDefault();const f=ev.target;const name=f.pname.value.trim();if(!name)return;" + nl$
    h$ = h$ + "  const r=await api('/api/projects/create',{name:name,key:f.pkey.value.trim()});if(r.error){alert(r.error);}f.reset();loadP();}" + nl$
    h$ = h$ + "document.getElementById('projForm').addEventListener('submit',addP);loadP();" + nl$
    h$ = h$ + "</script>"
    RETURN h$
ENDFUNC

FUNC HandleRoot(request)
    IF LEN(JDWEB.AUTH_USER$(gDb, request)) = 0 THEN RETURN JDWEB.REDIRECT_TO("/login")
    RETURN JDWEB.PAGE$(gCfg, gApp$, JDWEB.NAV_HTML$(gCfg, "/"), BOARD_BODY$())
ENDFUNC

FUNC HandleProjectsPage(request)
    IF LEN(JDWEB.AUTH_USER$(gDb, request)) = 0 THEN RETURN JDWEB.REDIRECT_TO("/login")
    RETURN JDWEB.PAGE$(gCfg, gApp$ + " - Projects", JDWEB.NAV_HTML$(gCfg, "/projects"), PROJECTS_BODY$())
ENDFUNC

FUNC HandleSettingsPage(request)
    IF LEN(JDWEB.AUTH_USER$(gDb, request)) = 0 THEN RETURN JDWEB.REDIRECT_TO("/login")
    RETURN JDWEB.PAGE$(gCfg, gApp$ + " - Settings", JDWEB.NAV_HTML$(gCfg, "/settings"), SETTINGS_BODY$())
ENDFUNC

FUNC HandleUsersPage(request)
    IF LEN(JDWEB.AUTH_USER$(gDb, request)) = 0 THEN RETURN JDWEB.REDIRECT_TO("/login")
    RETURN JDWEB.PAGE$(gCfg, gApp$ + " - Users", JDWEB.NAV_HTML$(gCfg, "/users"), USERS_BODY$())
ENDFUNC

' --- routes + server ---

HTTP.SERVER.ON_GET "/", "HANDLEROOT"
HTTP.SERVER.ON_GET "/projects", "HANDLEPROJECTSPAGE"
HTTP.SERVER.ON_GET "/settings", "HANDLESETTINGSPAGE"
HTTP.SERVER.ON_GET "/users", "HANDLEUSERSPAGE"
HTTP.SERVER.ON_GET "/login", "HANDLELOGINPAGE"
HTTP.SERVER.ON_POST "/api/login", "HANDLELOGIN"
HTTP.SERVER.ON_POST "/api/logout", "HANDLELOGOUT"
HTTP.SERVER.ON_GET "/api/me", "HANDLEME"
HTTP.SERVER.ON_GET "/api/tickets", "HANDLETICKETS"
HTTP.SERVER.ON_GET "/api/ticket", "HANDLETICKET"
HTTP.SERVER.ON_POST "/api/create", "HANDLECREATE"
HTTP.SERVER.ON_POST "/api/update", "HANDLEUPDATE"
HTTP.SERVER.ON_POST "/api/move", "HANDLEMOVE"
HTTP.SERVER.ON_POST "/api/delete", "HANDLEDELETE"
HTTP.SERVER.ON_POST "/api/comment", "HANDLECOMMENT"
HTTP.SERVER.ON_GET "/api/settings", "HANDLESETTINGS"
HTTP.SERVER.ON_POST "/api/settings/save", "HANDLESETTINGSSAVE"
HTTP.SERVER.ON_GET "/api/projects", "HANDLEPROJECTS"
HTTP.SERVER.ON_POST "/api/projects/create", "HANDLEPROJECTCREATE"
HTTP.SERVER.ON_POST "/api/projects/delete", "HANDLEPROJECTDELETE"
HTTP.SERVER.ON_GET "/api/next", "HANDLENEXT"
HTTP.SERVER.ON_POST "/api/dep/add", "HANDLEDEPADD"
HTTP.SERVER.ON_POST "/api/dep/del", "HANDLEDEPDEL"
HTTP.SERVER.ON_GET "/api/users", "HANDLEUSERS"
HTTP.SERVER.ON_POST "/api/users/create", "HANDLEUSERCREATE"
HTTP.SERVER.ON_POST "/api/users/delete", "HANDLEUSERDELETE"
HTTP.SERVER.ON_NOTFOUND "HANDLE404"

gPort = INT(gCfg{"port"})
gHost$ = "127.0.0.1"
IF TYPEOF(gCfg{"host"}) <> "NONE" THEN gHost$ = "" + gCfg{"host"}

IF HTTP.SERVER.START(gPort, gHost$) THEN
    PRINT gApp$ + " running on " + gHost$ + ":" + STR$(gPort)
    PRINT "  Board: /        Users: /users"
    PRINT "DB:   " + gCfg{"db"}
    PRINT "Press Ctrl-C to stop."
    ' Park the main thread inside the server (C++ side). A DO...SLEEP loop would
    ' keep running VM bytecode on this thread and race the handler pool threads
    ' on the shared VM/SQLite -> access violation. WAIT does not touch the VM.
    HTTP.SERVER.WAIT
ELSE
    PRINT "Could not start server on port " + STR$(gPort) + ": " + ERRMSG$
ENDIF

HTTP.SERVER.STOP
SQL.CLOSE(gDb)
PRINT "Stopped."
