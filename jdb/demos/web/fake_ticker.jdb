' Live ticker driven by Python. The embedded interpreter holds a function
' across calls; a background RECUR task pulls a fresh quote every 2 seconds.
' Needs the PYTHON build flag (OS.FEATURE("PYTHON")). jdBasic strings have no
' escapes - lines are joined with CHR$(10).

IF NOT OS.FEATURE("PYTHON") THEN
    PRINT "This demo needs a PYTHON-enabled build."
    END
ENDIF

' 1. Define the data source once. It lives in the persistent namespace, so
'    later calls can just invoke get_market_data().
DIM py_setup$ = "import random" + CHR$(10)
py_setup$ = py_setup$ + "def get_market_data():" + CHR$(10)
py_setup$ = py_setup$ + "    return {'symbol': 'BTC', 'price': round(random.uniform(50000, 52000), 2)}"
DIM ignore$ = PYTHON$(py_setup$)

' 2. A background task: fetch the dict and print it on the top row.
DIM bg_task$ = "ticker = PY.EVAL(""get_market_data()""): "
bg_task$ = bg_task$ + "LOCATE 0, 50: PRINT ticker{""symbol""}; "" Price: $""; ticker{""price""}; ""   "";"

' 3. Update every 2 seconds. Keep using the console while it runs.
DIM TickerID = RECUR(2000, bg_task$)

PRINT "Live ticker started - the quote refreshes every 2s."
