' tmpl_test.jdb - checks for the tmpl.jdb template engine.
' Run:  jdBasic jdb/demos/web/tmpl_test.jdb

IMPORT TMPL

DIM fails = 0

SUB Check(label$, got$, want$)
    IF got$ = want$ THEN
        PRINT "ok   "; label$
    ELSE
        PRINT "FAIL "; label$; "  got=["; got$; "] want=["; want$; "]"
        fails = fails + 1
    ENDIF
ENDSUB

FUNC Excl(vv, a$)
    RETURN "" + vv + "!"
ENDFUNC

DIM m1 AS MAP
m1{"name"} = "<b>Kat</b>"
Check "escape", TMPL.RENDERSTR$("Hi {{ name }}!", m1), "Hi &lt;b&gt;Kat&lt;/b&gt;!"
Check "raw", TMPL.RENDERSTR$("X {{{ name }}} Y", m1), "X <b>Kat</b> Y"

DIM usr AS MAP
usr{"name"} = "Kaiku"
DIM m2 AS MAP
m2{"user"} = usr
Check "dotted", TMPL.RENDERSTR$("{{ user.name }}", m2), "Kaiku"

DIM a0 AS MAP
a0{"title"} = "first"
DIM arr = [a0]
DIM m3 AS MAP
m3{"items"} = arr
Check "bracket", TMPL.RENDERSTR$("[{{ items[0].title }}]", m3), "[first]"

Check "missing", TMPL.RENDERSTR$("a{{ nope.x }}b", m2), "ab"

DIM m4 AS MAP
m4{"q"} = "a & b " + CHR$(34) + "c" + CHR$(34)
Check "amp+quote", TMPL.RENDERSTR$("{{ q }}", m4), "a &amp; b &quot;c&quot;"

DIM literal$ = "no holes here"
Check "literal", TMPL.RENDERSTR$(literal$, m1), literal$

' file render + cache: a second render of the same file must not re-parse
MKDIR "tmp"
DIM tf$ = "tmp/_tmpl_cache_test.html"
TXTWRITER tf$, "Hello {{ name }}"
DIM before = TMPL.COMPILES()
DIM r1$ = TMPL.RENDER$(tf$, m1)
DIM midc = TMPL.COMPILES()
DIM r2$ = TMPL.RENDER$(tf$, m1)
DIM after = TMPL.COMPILES()
Check "file render", r1$, "Hello &lt;b&gt;Kat&lt;/b&gt;"
IF (midc = before + 1) ANDALSO (after = midc) THEN
    PRINT "ok   cache (1 parse for 2 renders)"
ELSE
    PRINT "FAIL cache  before="; before; " midc="; midc; " after="; after
    fails = fails + 1
ENDIF

' --- control tags ---
DIM t1 AS MAP
t1{"title"} = "Alpha"
t1{"done"} = TRUE
DIM t2 AS MAP
t2{"title"} = "Beta & <C>"
t2{"done"} = FALSE
DIM tickets = [t1, t2]
DIM mdl AS MAP
mdl{"tickets"} = tickets
mdl{"title"} = "Board"

Check "for", TMPL.RENDERSTR$("{% for t in tickets %}[{{ t.title }}]{% endfor %}", mdl), "[Alpha][Beta &amp; &lt;C&gt;]"
Check "if-true", TMPL.RENDERSTR$("{% if title %}has{% endif %}", mdl), "has"
Check "if-else", TMPL.RENDERSTR$("{% if missing %}x{% else %}none{% endif %}", mdl), "none"
Check "nested", TMPL.RENDERSTR$("{% for t in tickets %}{% if t.done %}D{% else %}o{% endif %}{% endfor %}", mdl), "Do"

DIM q$ = CHR$(34)
Check "eq", TMPL.RENDERSTR$("{% if title == " + q$ + "Board" + q$ + " %}y{% else %}n{% endif %}", mdl), "y"
Check "neq", TMPL.RENDERSTR$("{% if title != " + q$ + "X" + q$ + " %}y{% else %}n{% endif %}", mdl), "y"
Check "not", TMPL.RENDERSTR$("{% if not missing %}y{% endif %}", mdl), "y"

DIM mst AS MAP
mst{"s"} = "doing"
Check "elseif", TMPL.RENDERSTR$("{% if s == 'todo' %}T{% elseif s == 'doing' %}DO{% else %}?{% endif %}", mst), "DO"

' include resolved next to the parent file
TXTWRITER "tmp/_row.html", "<li>{{ t.title }}</li>"
TXTWRITER "tmp/_list.html", "<ul>{% for t in tickets %}{% include " + q$ + "_row.html" + q$ + " %}{% endfor %}</ul>"
Check "include", TMPL.RENDER$("tmp/_list.html", mdl), "<ul><li>Alpha</li><li>Beta &amp; &lt;C&gt;</li></ul>"

' --- layouts: extends / block ---
Check "block-standalone", TMPL.RENDERSTR$("[{% block x %}inner{% endblock %}]", mdl), "[inner]"

TXTWRITER "tmp/lay.html", "<h1>{% block title %}Default{% endblock %}</h1><main>{% block content %}none{% endblock %}</main>"
TXTWRITER "tmp/pageA.html", "{% extends " + q$ + "lay.html" + q$ + " %}{% block title %}Alpha{% endblock %}{% block content %}Body A{% endblock %}"
TXTWRITER "tmp/pageB.html", "{% extends " + q$ + "lay.html" + q$ + " %}{% block content %}Body B{% endblock %}"
Check "extends-full", TMPL.RENDER$("tmp/pageA.html", mdl), "<h1>Alpha</h1><main>Body A</main>"
Check "extends-fallback", TMPL.RENDER$("tmp/pageB.html", mdl), "<h1>Default</h1><main>Body B</main>"

' --- filters / pipes ---
mdl{"created"} = "2026-06-26 10:11:55"
mdl{"price"} = 3.5
Check "upper", TMPL.RENDERSTR$("{{ title | upper }}", mdl), "BOARD"
Check "chain", TMPL.RENDERSTR$("{{ title | upper | lower }}", mdl), "board"
Check "length", TMPL.RENDERSTR$("{{ tickets | length }}", mdl), "2"
Check "default", TMPL.RENDERSTR$("{{ missing | default:" + q$ + "n/a" + q$ + " }}", mdl), "n/a"
Check "date", TMPL.RENDERSTR$("{{ created | date:" + q$ + "DD.MM.YYYY" + q$ + " }}", mdl), "26.06.2026"
Check "money", TMPL.RENDERSTR$("{{ price | money:" + q$ + "EUR" + q$ + " }}", mdl), "3,50 EUR"

TMPL.ADDFILTER "excl", Excl@
Check "custom", TMPL.RENDERSTR$("{{ title | excl }}", mdl), "Board!"

PRINT ""
IF fails = 0 THEN
    PRINT "ALL TESTS PASSED!"
ELSE
    PRINT fails; " FAILED"
ENDIF
