' jdweb - a generic jdBasic web-app framework (terminal "Hot Phosphor" theme).
' One shared module many apps reuse: the theme CSS, a ##token## template
' renderer, the page chrome (head / nav / login), an EU cookie banner, and a
' full cookie-session auth stack (users + sessions tables).
'
' An app supplies a JSON config (app name, db, nav, flags) plus its own domain
' handlers, and wires pages through JDWEB.PAGE$ / JDWEB.RENDER$.
'
' Tokens understood by RENDER$: ##theme## (the stylesheet) plus one ##key## per
' entry in the vars map.
EXPORT MODULE JDWEB

IMPORT TMPL

' Template files (layout, theme) live next to the app script that imports
' jdweb; resolve them the way the app resolves its own config.
DIM gTplDir$ = PATH.JOIN$(PATH.DIRNAME$(OS.ARGS()[0]), "jdweb_tpl")
DIM gThemeCache$ = ""
DIM gEmptyModel AS MAP

' ---- small internal helpers ----

FUNC ESC$(s$)
    RETURN REPLACE$(s$, "'", "''")
ENDFUNC

FUNC FIELD$(obj, key$)
    v = obj{key$}
    IF TYPEOF(v) = "NONE" THEN RETURN ""
    RETURN TRIM$("" + v)
ENDFUNC

' ---- theme (all design tokens live in :root) ----

EXPORT FUNC THEME$()
    IF LEN(gThemeCache$) = 0 THEN gThemeCache$ = TXTREADER$(PATH.JOIN$(gTplDir$, "theme.html"))
    RETURN gThemeCache$
ENDFUNC

' ---- template rendering ----

EXPORT FUNC RENDER$(tpl$, vars)
    out$ = REPLACE$(tpl$, "##theme##", THEME$())
    keys = MAP.KEYS(vars)
    FOR EACH k IN keys
        out$ = REPLACE$(out$, "##" + k + "##", "" + vars{k})
    NEXT k
    RETURN out$
ENDFUNC

EXPORT FUNC COOKIE_BANNER$()
    RETURN TMPL.RENDER$(PATH.JOIN$(gTplDir$, "cookiebar.html"), gEmptyModel)
ENDFUNC

EXPORT FUNC NAV_HTML$(cfg, active$)
    DIM model AS MAP
    model{"app"} = "" + cfg{"app"}
    model{"sub"} = "" + cfg{"sub"}
    model{"nav"} = cfg{"nav"}
    model{"active"} = active$
    RETURN TMPL.RENDER$(PATH.JOIN$(gTplDir$, "nav.html"), model)
ENDFUNC

' Full HTML document. navHtml$ may be "" (e.g. the login page). The EU cookie
' banner is appended only when the app config has "cookies": true.
EXPORT FUNC PAGE$(cfg, title$, navHtml$, content$)
    bar$ = ""
    ck = cfg{"cookies"}
    IF TYPEOF(ck) <> "NONE" ANDALSO ck = TRUE THEN bar$ = COOKIE_BANNER$()
    DIM model AS MAP
    model{"title"} = title$
    model{"theme"} = THEME$()
    model{"nav"} = navHtml$
    model{"content"} = content$
    model{"cookiebar"} = bar$
    RETURN TMPL.RENDER$(PATH.JOIN$(gTplDir$, "layout.html"), model)
ENDFUNC

' Themed 404. Returns a rich-response map so the server sends status 404.
' Wire it with: HTTP.SERVER.ON_NOTFOUND "HANDLE404" and a thin wrapper that
' returns JDWEB.NOT_FOUND$(cfg).
EXPORT FUNC NOT_FOUND$(cfg)
    app$ = "" + cfg{"app"}
    c$ = TMPL.RENDER$(PATH.JOIN$(gTplDir$, "notfound.html"), gEmptyModel)
    html$ = PAGE$(cfg, app$ + " - 404", "", c$)
    RETURN { "__http_status": 404, "__http_content_type": "text/html", "__http_body": html$ }
ENDFUNC

EXPORT FUNC LOGIN_PAGE$(cfg)
    app$ = "" + cfg{"app"}
    DIM lm AS MAP
    lm{"app"} = app$
    c$ = TMPL.RENDER$(PATH.JOIN$(gTplDir$, "login.html"), lm)
    RETURN PAGE$(cfg, app$ + " - Sign in", "", c$)
ENDFUNC

' ---- cookie-session auth (cookie name: jdwsession) ----

EXPORT FUNC HASH_PW$(salt$, pw$)
    RETURN CODEC.SHA256$(salt$ + ":" + pw$)
ENDFUNC

EXPORT FUNC COOKIE_VAL$(request, name$)
    h = request{"HEADERS"}
    IF TYPEOF(h) = "NONE" THEN RETURN ""
    raw = h{"cookie"}
    IF TYPEOF(raw) = "NONE" THEN RETURN ""
    s$ = "; " + ("" + raw)
    key$ = "; " + name$ + "="
    p = INSTR(s$, key$)
    IF p < 0 THEN RETURN ""
    rest$ = MID$(s$, p + LEN(key$), LEN(s$))
    pos = INSTR(rest$, ";")
    IF pos < 0 THEN RETURN rest$
    RETURN LEFT$(rest$, pos)
ENDFUNC

EXPORT FUNC AUTH_USER$(db, request)
    token$ = COOKIE_VAL$(request, "jdwsession")
    IF LEN(token$) = 0 THEN RETURN ""
    rows = SQL.QUERY(db, "SELECT username FROM sessions WHERE token = '" + ESC$(token$) + "'")
    IF LEN(rows) = 0 THEN RETURN ""
    RETURN "" + rows[0]{"username"}
ENDFUNC

EXPORT FUNC UNAUTH()
    RETURN { "__http_status": 401, "__http_content_type": "application/json", _
        "__http_body": JSON.STRINGIFY$({ "error": "unauthorized" }) }
ENDFUNC

EXPORT FUNC REDIRECT_TO(loc$)
    RETURN { "__http_status": 302, "__http_headers": { "Location": loc$ }, "__http_body": "" }
ENDFUNC

EXPORT SUB AUTH_INIT(db)
    SQL.EXEC(db, "CREATE TABLE IF NOT EXISTS users (" + _
        "id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE, " + _
        "salt TEXT, pass_hash TEXT, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
    SQL.EXEC(db, "CREATE TABLE IF NOT EXISTS sessions (" + _
        "token TEXT PRIMARY KEY, username TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP)")
    SQL.EXEC(db, "ALTER TABLE users ADD COLUMN salt TEXT")
    SQL.EXEC(db, "ALTER TABLE users ADD COLUMN pass_hash TEXT")
ENDSUB

EXPORT FUNC AUTH_LOGIN(db, request, secure)
    body = JSON.PARSE$(request{"BODY"})
    name$ = FIELD$(body, "name")
    pw$ = FIELD$(body, "password")
    IF LEN(name$) = 0 ORELSE LEN(pw$) = 0 THEN RETURN { "error": "name and password required" }

    rows = SQL.QUERY(db, "SELECT id, name, salt, pass_hash FROM users WHERE name = '" + ESC$(name$) + "'")
    IF LEN(rows) = 0 THEN
        cnt = SQL.QUERY(db, "SELECT COUNT(*) AS n FROM users")
        IF INT(cnt[0]{"n"}) > 0 THEN RETURN { "error": "unknown user" }
        SQL.EXEC(db, "INSERT INTO users (name) VALUES ('" + ESC$(name$) + "')")
        rows = SQL.QUERY(db, "SELECT id, name, salt, pass_hash FROM users WHERE name = '" + ESC$(name$) + "'")
    ENDIF
    u = rows[0]

    phv = u{"pass_hash"}
    IF TYPEOF(phv) = "NONE" THEN
        salt$ = CODEC.UUID$()
        SQL.EXEC(db, "UPDATE users SET salt='" + salt$ + "', pass_hash='" + HASH_PW$(salt$, pw$) + _
            "' WHERE id = " + STR$(INT(u{"id"})))
    ELSE
        salt$ = "" + u{"salt"}
        IF HASH_PW$(salt$, pw$) <> ("" + phv) THEN RETURN { "error": "wrong password" }
    ENDIF

    token$ = CODEC.UUID$()
    name2$ = "" + u{"name"}
    SQL.EXEC(db, "INSERT INTO sessions (token, username) VALUES ('" + token$ + "', '" + ESC$(name2$) + "')")

    cookie$ = "jdwsession=" + token$ + "; HttpOnly; Path=/; SameSite=Lax"
    IF secure = TRUE THEN cookie$ = cookie$ + "; Secure"
    RETURN { "__http_status": 200, "__http_headers": { "Set-Cookie": cookie$ }, _
        "__http_content_type": "application/json", _
        "__http_body": JSON.STRINGIFY$({ "ok": TRUE, "name": name2$ }) }
ENDFUNC

EXPORT FUNC AUTH_LOGOUT(db, request)
    token$ = COOKIE_VAL$(request, "jdwsession")
    IF LEN(token$) > 0 THEN SQL.EXEC(db, "DELETE FROM sessions WHERE token = '" + ESC$(token$) + "'")
    RETURN { "__http_status": 200, "__http_headers": { "Set-Cookie": "jdwsession=; Path=/; Max-Age=0" }, _
        "__http_content_type": "application/json", "__http_body": "{}" }
ENDFUNC

EXPORT FUNC AUTH_ME(db, request)
    u$ = AUTH_USER$(db, request)
    IF LEN(u$) = 0 THEN RETURN UNAUTH()
    RETURN { "name": u$ }
ENDFUNC
