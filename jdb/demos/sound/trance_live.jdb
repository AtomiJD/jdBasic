' trance_live.jdb - a trance loop built up layer by layer, the way a
' live-coding set grows: kick, hats, offbeat bass, supersaw arpeggio
' with a filter sweep, chord pad.
'
' Shows the sequencer's mini-notation (<...> chord changes, a*n, euclid),
' SOUND.MOD sweeps locked to the bar, the resonant filter with SOUND.FENV,
' and sidechain pumping. Each new pattern starts on the next bar.

OPTION "EXPLICIT"

DIM BARS_PER_PART AS INTEGER = 4
DIM BAR_MS AS INTEGER = 4 * 60000 / 138

SUB WAIT_BARS(n AS INTEGER)
    SLEEP n * BAR_MS
ENDSUB

SOUND.INIT
SOUND.BPM 138
SOUND.REVERB 0.85, 0.4, 1.0, 0.5
SOUND.DELAY TRUE, 3 * 60000 / 138 / 4, 0.45, 0.35
SOUND.COMPRESSOR 0.5, 4, 5, 120, 1.0

' kick: a short sine thump
SOUND.VOICE 0, "SINE", 0.001, 0.18, 0.0, 0.05
SOUND.GAIN 0, 0.9
' hats: noise through a high-pass
SOUND.VOICE 1, "NOISE", 0.001, 0.04, 0.0, 0.02
SOUND.FILTER 1, 7000, 0.3, "HP"
SOUND.GAIN 1, 0.35
SOUND.PAN 1, 0.6
' bass: saw, low-pass plucked open by the filter envelope
SOUND.VOICE 2, "SAW", 0.002, 0.12, 0.3, 0.05
SOUND.FILTER 2, 180, 0.55
SOUND.FENV 2, 3, 0.002, 0.09
SOUND.SIDECHAIN 2, 0, 0.7
' lead: supersaw arpeggio, cutoff swept over eight bars
SOUND.VOICE 3, "SAW", 0.003, 0.15, 0.4, 0.15
SOUND.UNISON 3, 7, 0.35, 0.8
SOUND.FILTER 3, 1200, 0.45
SOUND.MOD 3, "CUTOFF", "SINE", 500, 6000, 8, 0.75
SOUND.SIDECHAIN 3, 0, 0.6
SOUND.REVERBSEND 3, 0.5
SOUND.DELAYSEND 3, 0.35
SOUND.GAIN 3, 0.5
' pad: slow chords, panned by a slow sine
SOUND.VOICE 4, "SAW", 0.6, 0.5, 0.7, 1.2
SOUND.UNISON 4, 5, 0.25, 1.0
SOUND.FILTER 4, 900, 0.2
SOUND.MOD 4, "PAN", "SINE", 0.3, 0.7, 4
SOUND.SIDECHAIN 4, 0, 0.8
SOUND.REVERBSEND 4, 0.7
SOUND.GAIN 4, 0.35

DIM ARP$ AS STRING = "<[a3 c4 e4 a4]*2 [f3 a3 c4 f4]*2 [c4 e4 g4 c5]*2 [g3 b3 d4 g4]*2>"
DIM PAD$ AS STRING = "<[a3,c4,e4] [f3,a3,c4] [c4,e4,g4] [g3,b3,d4]>"
DIM BASS$ AS STRING = "<[~ a1]*4 [~ f1]*4 [~ c2]*4 [~ g1]*4>"

PRINT "kick"
SOUND.SEQ 0, "c2*4", "VOICE"
WAIT_BARS BARS_PER_PART

PRINT "hats"
SOUND.SEQ 1, "[~ c4]*4, c4(5,16,2)?0.6", "VOICE"
WAIT_BARS BARS_PER_PART

PRINT "bass"
SOUND.SEQ 2, BASS$, "VOICE"
WAIT_BARS BARS_PER_PART

PRINT "arpeggio, filter sweep over 8 bars"
SOUND.SEQ 3, ARP$, "VOICE"
WAIT_BARS 2 * BARS_PER_PART

PRINT "pad"
SOUND.SEQ 4, PAD$, "VOICE"
WAIT_BARS 2 * BARS_PER_PART

PRINT "breakdown"
SOUND.SEQ 0, "", "VOICE"
SOUND.SEQ 2, "", "VOICE"
SOUND.MOD 3, "RESONANCE", "TRI", 0.3, 0.9, 4
WAIT_BARS BARS_PER_PART

PRINT "drop"
SOUND.MOD 3, "RESONANCE", "OFF"
SOUND.SEQ 0, "c2*4", "VOICE"
SOUND.SEQ 2, BASS$, "VOICE"
SOUND.SEQ 3, "<[a3 c4 e4 a4 e5 a4 e4 c4]*2 [f3 a3 c4 f4 c5 f4 c4 a3]*2 [c4 e4 g4 c5 g5 c5 g4 e4]*2 [g3 b3 d4 g4 d5 g4 d4 b3]*2>", "VOICE"
WAIT_BARS 2 * BARS_PER_PART

PRINT "end"
SOUND.RESET
