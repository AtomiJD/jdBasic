' trance_live.jdb - "Kaiku in A minor", a five-minute trance track,
' 184 bars at 138 BPM, played by the sequencer with a show around it.
'
'   0 intro         16 build          32 main          56 breakdown
'  72 drop         104 arp section   120 breakdown 2  136 final drop
' 168 outro        184 end
'
' Usage: jdBasic trance_live.jdb [--window] [--shots dir]
'   F toggles fullscreen, Esc quits.
'
' The file is the sound design and the score. SCORE (score.jdb) queues
' every section for its bar with SOUND.AT, so the whole score is sent
' before the first note and the mixer switches on the exact frame.
' STAGE (stage.jdb) then runs the show until the last bar.
'
' Uses: the built-in drum kit with choke, mini-notation (<> chords,
' euclid, !, @, _, ?), transforms (arp, jux, juxBy, off, add, every,
' iter, palindrome, ply, sometimes, degradeBy, swingBy, rev),
' per-event gain, legato and pan, SOUND.MOD sweeps, a trance gate and
' risers, the resonant filter with FENV, sidechain pumping, two effect
' orbits, SOUND.NUDGE, the FIXED master and the compressor.

OPTION "EXPLICIT"

IMPORT SCORE
IMPORT STAGE

DIM BPM AS DOUBLE = 138

' ── Tracks ───────────────────────────────────────────────────────

DIM KICK AS INTEGER = 0
DIM CLAP AS INTEGER = 1
DIM HATS AS INTEGER = 2
DIM PERC AS INTEGER = 3
DIM BASS AS INTEGER = 4
DIM ARP AS INTEGER = 5
DIM PAD AS INTEGER = 6
DIM LEAD AS INTEGER = 7
DIM RISER AS INTEGER = 8
DIM CRASH AS INTEGER = 9
DIM ROLL AS INTEGER = 10
DIM FILL AS INTEGER = 11
DIM TRACK_NAMES$ = ["KICK", "CLAP", "HATS", "PERC", "BASS", "ARP", "PAD", "LEAD", "RISER", "CRASH", "ROLL", "FILL"]
DIM ti AS INTEGER
FOR ti = 0 TO LEN(TRACK_NAMES$) - 1
    SCORE.TRACK ti, TRACK_NAMES$[ti]
NEXT ti

' ── Instruments ──────────────────────────────────────────────────

SOUND.INIT SCORE.AUDIO_MODE$()
SOUND.MASTER "FIXED", 0.5
SCORE.TEMPO BPM
SOUND.COMPRESSOR 0.55, 3, 5, 150, 1.1

' orbit 0: a tight room and a dotted-eighth echo for the arp
SOUND.REVERB 0.6, 0.6, 0.7, 0.25
SOUND.DELAY TRUE, 3 * 60000 / BPM / 4, 0.4, 0.3
' orbit 1: a long hall and a slow echo for pad, lead and risers
SOUND.REVERB 0.95, 0.3, 1.0, 0.7, 1
SOUND.DELAY TRUE, 3 * 60000 / BPM / 2, 0.35, 0.25, 1

' drums from the built-in kit; the closed hat chokes the open one
SOUND.KIT KICK, "SYNTH"
SOUND.KIT CLAP, "SYNTH"
SOUND.GAIN CLAP, 0.7
SOUND.REVERBSEND CLAP, 0.25
SOUND.KIT HATS, "SYNTH"
SOUND.GAIN HATS, 0.55
SOUND.PAN HATS, 0.58
SOUND.KIT PERC, "SYNTH"
SOUND.GAIN PERC, 0.5
SOUND.NUDGE PERC, 12
SCORE.SWEEP PERC, "PAN", "RAND", 0.25, 0.75, 0.25, 0
SOUND.KIT CRASH, "SYNTH"
SOUND.GAIN CRASH, 0.8
SOUND.REVERBSEND CRASH, 0.4
SOUND.ORBIT CRASH, 1
SOUND.KIT ROLL, "SYNTH"
SOUND.REVERBSEND ROLL, 0.35
SOUND.ORBIT ROLL, 1
SOUND.KIT FILL, "SYNTH"
SOUND.GAIN FILL, 0.6
SOUND.REVERBSEND FILL, 0.3

' bass: rolling saw, plucked by the filter envelope, pumping off the kick
SOUND.VOICE BASS, "SAW", 0.002, 0.1, 0.5, 0.04
SOUND.FILTER BASS, 240, 0.45
SOUND.FENV BASS, 2.5, 0.002, 0.08
SOUND.SIDECHAIN BASS, KICK, 0.75
SOUND.GAIN BASS, 0.75

' arp: plucky supersaw through a resonant low-pass, echoing on orbit 0
SOUND.VOICE ARP, "SAW", 0.002, 0.12, 0.25, 0.12
SOUND.UNISON ARP, 3, 0.25, 0.7
SOUND.FILTER ARP, 1400, 0.55
SOUND.FENV ARP, 1.5, 0.002, 0.1
SOUND.SIDECHAIN ARP, KICK, 0.55
SOUND.DELAYSEND ARP, 0.3
SOUND.REVERBSEND ARP, 0.2
SOUND.GAIN ARP, 0.45

' pad: wide slow chords in the hall
SOUND.VOICE PAD, "SAW", 0.9, 0.5, 0.8, 1.6
SOUND.UNISON PAD, 6, 0.3, 1.0
SOUND.FILTER PAD, 1100, 0.2
SOUND.SIDECHAIN PAD, KICK, 0.8
SOUND.ORBIT PAD, 1
SOUND.REVERBSEND PAD, 0.6
SCORE.SWEEP PAD, "PAN", "SINE", 0.3, 0.7, 8, 0
SOUND.GAIN PAD, 0.32

' lead: big supersaw with drifting detune, echoes and hall
SOUND.VOICE LEAD, "SAW", 0.005, 0.25, 0.6, 0.3
SOUND.UNISON LEAD, 7, 0.3, 0.9
SOUND.FILTER LEAD, 3200, 0.3
SOUND.FENV LEAD, 1, 0.005, 0.2, 0.3
SCORE.SWEEP LEAD, "DETUNE", "PERLIN", 0.22, 0.42, 4, 0
SOUND.SIDECHAIN LEAD, KICK, 0.45
SOUND.ORBIT LEAD, 1
SOUND.REVERBSEND LEAD, 0.4
SOUND.DELAYSEND LEAD, 0.3
SOUND.GAIN LEAD, 0.34

' riser: noise through a high-pass, opened and raised over eight bars
SOUND.VOICE RISER, "NOISE", 0.01, 0.1, 1.0, 0.2
SOUND.FILTER RISER, 400, 0.4, "HP"
SOUND.ORBIT RISER, 1
SOUND.REVERBSEND RISER, 0.3
SOUND.GAIN RISER, 0

' ── Patterns ─────────────────────────────────────────────────────

' Am - F - C - G, one chord per bar
DIM CHORDS$ AS STRING = "<[a3,c4,e4] [f3,a3,c4] [c4,e4,g4] [g3,b3,d4]>"

' The progression with each chord struck n times in its bar, for arp()
FUNC CHORDS_X$(n AS INTEGER) AS STRING
    DIM r$ AS STRING = "*" + STR$(n)
    RETURN "<[a3,c4,e4,a4]" + r$ + " [f3,a3,c4,f4]" + r$ + " [c4,e4,g4,c5]" + r$ + " [g3,b3,d4,g4]" + r$ + ">"
ENDFUNC

FUNC TRIADS_X$(n AS INTEGER) AS STRING
    DIM r$ AS STRING = "*" + STR$(n)
    RETURN "<[a3,c4,e4]" + r$ + " [f3,a3,c4]" + r$ + " [c4,e4,g4]" + r$ + " [g3,b3,d4]" + r$ + ">"
ENDFUNC
DIM BASS_ROLL$ AS STRING = "legato(0.6, <[~ a1 a2 a1]*4 [~ f1 f2 f1]*4 [~ c2 c3 c2]*4 [~ g1 g2 g1]*4>)"
DIM BASS_OFF$ AS STRING = "legato(0.7, <[~ a1]*4 [~ f1]*4 [~ c2]*4 [~ g1]*4>)"
DIM ARP_UP$ AS STRING = "arp(up, <[a3,c4,e4,a4]*4 [f3,a3,c4,f4]*4 [c4,e4,g4,c5]*4 [g3,b3,d4,g4]*4>)"
DIM ARP_WIDE$ AS STRING = "juxBy(0.7, rev, arp(updown, <[a3,c4,e4,a4,e5]*2 [f3,a3,c4,f4,c5]*2 [c4,e4,g4,c5,g5]*2 [g3,b3,d4,g4,d5]*2>))"
DIM MELODY$ AS STRING = "<[a4 ~ e5 ~ d5 c5 ~ b4] [a4 ~ c5 ~ a4 g4 ~ f4] [e4 ~ g4 ~ c5 b4 ~ g4] [d5 ~ b4 ~ g4 d5 ~ b4]>"
DIM MELODY_LONG$ AS STRING = "<[a4 _ _ c5] [a4 _ g4 f4] [e4 _ _ g4] [d5 _ b4 g4]>"
DIM HATS_MAIN$ AS STRING = "[~ oh]*4, gain([0.35 0.6 0.45 0.8]*4, hh*16)"
DIM CRASHES$ AS STRING = "<[cr, bd:1] ~!7>"
DIM FILLS$ AS STRING = "<~!7 [~ ~ ~ ~ ht ht mt [lt lt]]>"
DIM ROLL$ AS STRING = "gain(<0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55>, <sd*4 sd*4 sd*8 sd*8 sd*8 [sd*8 sd*16] sd*16 [sd*14 ~ ~]>)"

' ── 0: intro - kick and a high-passed hat opening up ─────────────

SCORE.SECTION 0, "intro", "groove"
SCORE.PLAY KICK, "bd*4"
SCORE.PLAY HATS, "gain([0.4 0.7]*8, hh*16)"
SOUND.FILTER HATS, 3000, 0.3, "HP"
SCORE.SWEEP HATS, "CUTOFF", "ISAW", 300, 9000, 16, 0
SCORE.PLAY PERC, "degradeBy(0.3, sh*16), rim(3,8,5)"

SCORE.SECTION 8, "intro: clap", "groove"
SCORE.PLAY CLAP, "~ cp ~ cp"

' ── 16: build - rolling bass, open hats, a filtered arp ──────────

SCORE.SECTION 16, "build: bass", "shuffle"
SCORE.PLAY BASS, BASS_ROLL$
SCORE.PLAY HATS, HATS_MAIN$
SCORE.PLAY FILL, FILLS$
SCORE.SWEEP_OFF HATS, "CUTOFF"
SOUND.FILTER HATS, 6000, 0.2, "HP"

SCORE.SECTION 24, "build: arp under the filter", "shuffle"
SCORE.PLAY ARP, ARP_UP$
SCORE.SWEEP ARP, "CUTOFF", "SAW", 300, 2200, 8, 0

' ── 32: main - everything in, pad underneath ─────────────────────

SCORE.SECTION 32, "main", "jump"
SCORE.PLAY CRASH, CRASHES$
SCORE.PLAY PAD, "legato(1, " + CHORDS$ + ")"
SCORE.PLAY CLAP, "every(4, ply(2), ~ cp ~ cp)"
SCORE.PLAY PERC, "sometimes(ply(2), sh(7,16,2)), rim(3,8,5)"
SCORE.SWEEP ARP, "CUTOFF", "SINE", 700, 5000, 8, 0.75

SCORE.SECTION 48, "main: arp goes wide", "jump"
SCORE.PLAY ARP, ARP_WIDE$

' ── 56: breakdown - drums out, pad and melody in the hall ────────

SCORE.SECTION 56, "breakdown", "wave"
SCORE.QUIET KICK
SCORE.QUIET CLAP
SCORE.QUIET BASS
SCORE.QUIET PERC
SCORE.QUIET FILL
SCORE.PLAY HATS, "gain(0.5, [~ hh]*4)"
SCORE.PLAY LEAD, "legato(1.2, " + MELODY_LONG$ + ")"
SCORE.PLAY ARP, "gain(0.6, " + ARP_UP$ + ")"
SCORE.SWEEP ARP, "RESONANCE", "TRI", 0.3, 0.92, 4, 0
SCORE.SWEEP ARP, "CUTOFF", "SINE", 500, 2500, 4, 0
SCORE.SWEEP LEAD, "CUTOFF", "SAW", 600, 3200, 8, 0

SCORE.SECTION 64, "breakdown: riser and snare roll", "rise"
SCORE.QUIET HATS
SCORE.QUIET CRASH
SCORE.PLAY RISER, "legato(1, c4)"
SCORE.PLAY ROLL, ROLL$
SCORE.SWEEP RISER, "CUTOFF", "SAW", 300, 9000, 8, 0
SCORE.SWEEP RISER, "GAIN", "SAW", 0, 0.2, 8, 0

' ── 72: drop - full groove with the melody ───────────────────────

SCORE.SECTION 72, "drop", "jump"
SCORE.QUIET RISER
SCORE.QUIET ROLL
SCORE.PLAY KICK, "bd*4"
SCORE.PLAY CLAP, "every(4, ply(2), ~ cp ~ cp)"
SCORE.PLAY HATS, HATS_MAIN$
SCORE.PLAY PERC, "sometimes(ply(2), sh(7,16,2)), rim(3,8,5)"
SCORE.PLAY BASS, BASS_ROLL$
SCORE.PLAY CRASH, CRASHES$
SCORE.PLAY FILL, FILLS$
SCORE.PLAY ARP, ARP_WIDE$
SCORE.PLAY LEAD, MELODY$
SCORE.SWEEP_OFF RISER, "CUTOFF"
SCORE.SWEEP_OFF RISER, "GAIN"
SCORE.SWEEP_OFF ARP, "RESONANCE"
SCORE.SWEEP ARP, "CUTOFF", "SINE", 900, 5500, 8, 0
SCORE.SWEEP_OFF LEAD, "CUTOFF"

SCORE.SECTION 88, "drop: lead doubled an octave up", "jump"
SCORE.PLAY LEAD, "off(0.1875, add(12), " + MELODY$ + ")"

' ── 104: arp section - stripped groove, the arp takes the lead ───

SCORE.SECTION 104, "arp section: iter", "robot"
SCORE.QUIET LEAD
SCORE.QUIET PAD
SCORE.QUIET BASS
SCORE.QUIET CLAP
SCORE.PLAY HATS, "swingBy(0.12, 8, " + HATS_MAIN$ + ")"
SCORE.PLAY ARP, "iter(4, arp(up, " + CHORDS_X$(4) + "))"
SCORE.SWEEP ARP, "CUTOFF", "SAW", 600, 6000, 4, 0

SCORE.SECTION 108, "arp section: palindrome, bass back", "robot"
SCORE.PLAY ARP, "palindrome(arp(updown, " + CHORDS_X$(2) + "))"
SCORE.PLAY BASS, BASS_OFF$

SCORE.SECTION 112, "arp section: octave echoes", "robot"
SCORE.PLAY ARP, "off(0.125, add(12), arp(up, " + TRIADS_X$(4) + "))"
SCORE.PLAY CLAP, "~ cp ~ cp"

SCORE.SECTION 116, "arp section: ping-pong", "pan"
SCORE.PLAY ARP, "arp(downup, " + CHORDS_X$(2) + ")"
SCORE.SWEEP ARP, "PAN", "SINE", 0.1, 0.9, 1, 0

' ── 120: breakdown 2 - half-time melody, then the second riser ───

SCORE.SECTION 120, "breakdown 2", "wave"
SCORE.QUIET KICK
SCORE.QUIET CLAP
SCORE.QUIET HATS
SCORE.QUIET PERC
SCORE.QUIET BASS
SCORE.QUIET FILL
SCORE.QUIET CRASH
SCORE.PLAY PAD, "legato(1, " + CHORDS$ + ")"
SCORE.PLAY LEAD, "legato(1.2, " + MELODY_LONG$ + ")"
SCORE.PLAY ARP, "degradeBy(0.4, gain(0.5, " + ARP_UP$ + "))"
SCORE.SWEEP_OFF ARP, "PAN"
SCORE.SWEEP ARP, "CUTOFF", "TRI", 400, 1800, 8, 0
SCORE.SWEEP PAD, "CUTOFF", "SINE", 500, 2400, 16, 0

SCORE.SECTION 128, "breakdown 2: riser, roll, gated pad", "rise"
SCORE.PLAY RISER, "legato(1, c4)"
SCORE.PLAY ROLL, ROLL$
SCORE.SWEEP RISER, "CUTOFF", "SAW", 300, 10000, 8, 0
SCORE.SWEEP RISER, "GAIN", "SAW", 0, 0.22, 8, 0
SCORE.SWEEP PAD, "GAIN", "SQUARE", 0.08, 0.38, 0.125, 0

' ── 136: final drop - everything, the lead at full height ────────

SCORE.SECTION 136, "final drop", "jump"
SCORE.QUIET RISER
SCORE.QUIET ROLL
SCORE.PLAY KICK, "bd*4"
SCORE.PLAY CLAP, "every(4, ply(2), ~ cp ~ cp)"
SCORE.PLAY HATS, HATS_MAIN$
SCORE.PLAY PERC, "sometimes(ply(2), sh(7,16,2)), rim(3,8,5)"
SCORE.PLAY BASS, BASS_ROLL$
SCORE.PLAY CRASH, CRASHES$
SCORE.PLAY FILL, FILLS$
SCORE.PLAY ARP, ARP_WIDE$
SCORE.PLAY LEAD, "juxBy(0.4, add(12), off(0.1875, add(12), " + MELODY$ + "))"
SCORE.SWEEP_OFF RISER, "CUTOFF"
SCORE.SWEEP_OFF RISER, "GAIN"
SCORE.SWEEP_OFF PAD, "CUTOFF"
SCORE.SWEEP ARP, "CUTOFF", "SINE", 900, 6000, 8, 0
SOUND.GAIN LEAD, 0.26

SCORE.SECTION 152, "final drop: arp rarely jumps an octave", "jump"
SCORE.PLAY ARP, "rarely(add(12), " + ARP_WIDE$ + ")"

' ── 168: outro - layers leave, the filter closes ─────────────────

SCORE.SECTION 168, "outro", "groove"
SCORE.QUIET LEAD
SCORE.QUIET CRASH
SCORE.QUIET FILL
SCORE.PLAY PAD, "legato(1, " + CHORDS$ + ")"
SCORE.SWEEP_OFF PAD, "GAIN"
SCORE.SWEEP ARP, "CUTOFF", "ISAW", 300, 4000, 8, 0

SCORE.SECTION 172, "outro: bass and arp leave", "groove"
SCORE.QUIET BASS
SCORE.QUIET ARP
SCORE.QUIET CLAP

SCORE.SECTION 176, "outro: kick and hats", "groove"
SCORE.QUIET PAD
SCORE.QUIET PERC
SOUND.FILTER HATS, 6000, 0.2, "LP"
SCORE.SWEEP HATS, "CUTOFF", "ISAW", 400, 8000, 8, 0

SCORE.SECTION 184, "end", "bye"
SCORE.QUIET KICK
SCORE.QUIET HATS
SCORE.FINE 186

STAGE.SUBTITLE "Trance in A minor"
STAGE.RUN "Kaiku in A minor"
