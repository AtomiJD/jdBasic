' ============================================================
' MELODY module: progressions, the hook generator and its rules,
' bass, arp and stab parts
' ============================================================
' Self-checking. Each failure prints [FAIL]; the RESULTS line last.
' Pattern strings only, so it needs no audio device.

OPTION "EXPLICIT"

IMPORT MELODY

DIM PASS_COUNT AS INTEGER = 0
DIM FAIL_COUNT AS INTEGER = 0

SUB CHECK_STR(name$, expected AS STRING, actual AS STRING)
    IF expected = actual THEN
        PASS_COUNT = PASS_COUNT + 1
    ELSE
        FAIL_COUNT = FAIL_COUNT + 1
        PRINT "[FAIL] "; name$; "  expected=["; expected; "]  actual=["; actual; "]"
    ENDIF
ENDSUB

SUB CHECK(name$, cond AS INTEGER, detail$)
    IF cond THEN
        PASS_COUNT = PASS_COUNT + 1
    ELSE
        FAIL_COUNT = FAIL_COUNT + 1
        PRINT "[FAIL] "; name$; "  "; detail$
    ENDIF
ENDSUB

IF NOT OS.FEATURE("SOUND") THEN
    PRINT "SKIP: build has no SOUND sequencer"
    PRINT "RESULTS: 0 passed, 0 failed"
    END
ENDIF

' The bars of a <[...] [...]> pattern, each as its list of step tokens
FUNC BARS$(pat$)
    DIM inner$ = MID$(pat$, 2, LEN(pat$) - 4)
    RETURN SPLIT(inner$, "] [")
ENDFUNC

' ---------- progressions ----------
CHECK_STR "epic", "Am F C G", MELODY.PROG$("epic", "A minor")
CHECK_STR "pop", "C G Am F", MELODY.PROG$("pop", "C major")
CHECK_STR "dark", "Em Am C B", MELODY.PROG$("dark", "E minor")
CHECK_STR "house sevenths", "Gm7 C7 Fmaj7 Fmaj7", MELODY.PROG$("house", "F major")
CHECK_STR "deep dorian", "Dm7 G7 Dm7 G7", MELODY.PROG$("deep", "D dorian")
CHECK_STR "flat key", "Cm Ab Eb Bb", MELODY.PROG$("euphoric", "Eb major")
CHECK_STR "flat minor key", "Fm Bbm Db C", MELODY.PROG$("dark", "F minor")
CHECK_STR "sharp minor key", "F#m D A E", MELODY.PROG$("epic", "F# minor")
CHECK_STR "flat dorian key", "Cm7 F7 Cm7 F7", MELODY.PROG$("deep", "C dorian")
CHECK_STR "outrun", "F G Am Am", MELODY.PROG$("outrun", "A minor")
CHECK_STR "outrun flat key", "Db Eb Fm Fm", MELODY.PROG$("outrun", "F minor")

CHECK_STR "borrowed in major", "F Fm Ab Bb", MELODY.BORROWED$("C major")
CHECK_STR "borrowed in minor", "Dm F G Am", MELODY.BORROWED$("A minor")
CHECK_STR "borrowed in a flat key", "Eb Ebm Gb Ab", MELODY.BORROWED$("Bb major")
CHECK_STR "borrowed in dorian", "Gm Bb C Dm", MELODY.BORROWED$("D dorian")

' ---------- the hook ----------
DIM prog$ = "Am F C G"
DIM hook$ = MELODY.HOOK$(7, prog$, "A minor", "x.x..x.x x.x.x...", 4)
CHECK_STR "same seed, same hook", hook$, MELODY.HOOK$(7, prog$, "A minor", "x.x..x.x x.x.x...", 4)
CHECK "another seed, another hook", hook$ <> MELODY.HOOK$(8, prog$, "A minor", "x.x..x.x x.x.x...", 4), ""

DIM bars$ = BARS$(hook$)
CHECK "one bar per chord", LEN(bars$) = 4, "bars=" + STR$(LEN(bars$))

DIM chord_pcs = [[9, 0, 4], [5, 9, 0], [0, 4, 7], [7, 11, 2]]
DIM scale_pcs = [9, 11, 0, 2, 4, 5, 7]
DIM bi AS INTEGER
DIM in_scale AS INTEGER = TRUE
DIM in_range AS INTEGER = TRUE
DIM firsts_ok AS INTEGER = TRUE
FOR bi = 0 TO 3
    DIM steps$ = SPLIT(bars$[bi], " ")
    CHECK "sixteen steps, bar " + STR$(bi), LEN(steps$) = 16, "steps=" + STR$(LEN(steps$))
    DIM first AS INTEGER = TRUE
    DIM si AS INTEGER
    FOR si = 0 TO LEN(steps$) - 1
        DIM tok$ = steps$[si]
        IF tok$ <> "~" AND tok$ <> "_" THEN
            DIM m AS INTEGER = MELODY.NOTE_MIDI(tok$)
            IF m < 66 OR m > 81 THEN in_range = FALSE
            DIM pc AS INTEGER = m MOD 12
            DIM hit AS INTEGER = FALSE
            DIM k AS INTEGER
            FOR k = 0 TO 6
                IF scale_pcs[k] = pc THEN hit = TRUE
            NEXT k
            IF NOT hit THEN in_scale = FALSE
            IF first THEN
                DIM on_chord AS INTEGER = FALSE
                FOR k = 0 TO 2
                    IF chord_pcs[bi, k] = pc THEN on_chord = TRUE
                NEXT k
                IF NOT on_chord THEN firsts_ok = FALSE
                first = FALSE
            ENDIF
        ENDIF
    NEXT si
NEXT bi
CHECK "every note in A minor", in_scale, hook$
CHECK "range f#4 to a5", in_range, hook$
CHECK "each bar starts on a chord tone", firsts_ok, hook$

DIM last$ = SPLIT(bars$[3], " ")
CHECK_STR "the last bar holds its last note", "_", last$[15]
DIM end_i AS INTEGER = 15
WHILE last$[end_i] = "_" AND end_i > 0
    end_i = end_i - 1
WEND
DIM end_pc AS INTEGER = MELODY.NOTE_MIDI(last$[end_i]) MOD 12
CHECK "the hook ends on the root or third of G", end_pc = 7 OR end_pc = 11, "end=" + last$[end_i]

DIM first_a$ = SPLIT(bars$[0], " ")
DIM first_a2$ = SPLIT(bars$[1], " ")
DIM same_rhythm AS INTEGER = TRUE
FOR bi = 0 TO 15
    IF (first_a$[bi] = "~") <> (first_a2$[bi] = "~") THEN same_rhythm = FALSE
NEXT bi
CHECK "A' keeps the rhythm of A", same_rhythm, bars$[0] + " / " + bars$[1]

' ---------- the answer ----------
DIM counter$ = MELODY.COUNTER$(7, hook$, prog$, "A minor", 3)
CHECK_STR "same seed, same answer", counter$, MELODY.COUNTER$(7, hook$, prog$, "A minor", 3)
DIM cbars$ = BARS$(counter$)
CHECK "an answer bar per hook bar", LEN(cbars$) = 4, "bars=" + STR$(LEN(cbars$))
DIM gaps_ok AS INTEGER = TRUE
DIM few_ok AS INTEGER = TRUE
DIM low_ok AS INTEGER = TRUE
DIM c_notes AS INTEGER = 0
FOR bi = 0 TO 3
    DIM hs$ = SPLIT(bars$[bi], " ")
    DIM cs$ = SPLIT(cbars$[bi], " ")
    DIM in_bar AS INTEGER = 0
    DIM ck AS INTEGER
    FOR ck = 0 TO 15
        IF cs$[ck] <> "~" THEN
            in_bar = in_bar + 1
            c_notes = c_notes + 1
            IF hs$[ck] <> "~" AND hs$[ck] <> "_" THEN gaps_ok = FALSE
            IF ck > 0 ANDALSO hs$[ck - 1] <> "~" AND hs$[ck - 1] <> "_" THEN gaps_ok = FALSE
            IF MELODY.NOTE_MIDI(cs$[ck]) > 66 THEN low_ok = FALSE
        ENDIF
    NEXT ck
    IF in_bar > 4 THEN few_ok = FALSE
NEXT bi
CHECK "the answer has notes", c_notes > 0, counter$
CHECK "the answer never strikes with the hook", gaps_ok, counter$
CHECK "at most four answer notes a bar", few_ok, counter$
CHECK "the answer sits below the hook", low_ok, counter$

' ---------- variations ----------
DIM oct$ = BARS$(MELODY.VARY$(hook$, prog$, "A minor", "octave"))
CHECK_STR "octave keeps the A bar", bars$[0], oct$[0]
DIM h1$ = SPLIT(bars$[1], " ")
DIM o1$ = SPLIT(oct$[1], " ")
DIM oct_ok AS INTEGER = TRUE
FOR bi = 0 TO 15
    IF h1$[bi] = "~" OR h1$[bi] = "_" THEN
        IF o1$[bi] <> h1$[bi] THEN oct_ok = FALSE
    ELSEIF MELODY.NOTE_MIDI(o1$[bi]) <> MELODY.NOTE_MIDI(h1$[bi]) + 12 THEN
        oct_ok = FALSE
    ENDIF
NEXT bi
CHECK "octave lifts the A' bar", oct_ok, oct$[1]
CHECK_STR "octave keeps the B bar", bars$[3], oct$[3]

DIM endb$ = SPLIT(BARS$(MELODY.VARY$(hook$, prog$, "A minor", "ending"))[3], " ")
DIM rise AS INTEGER = MELODY.NOTE_MIDI(endb$[end_i]) - MELODY.NOTE_MIDI(last$[end_i])
DIM rise_pc AS INTEGER = MELODY.NOTE_MIDI(endb$[end_i]) MOD 12
CHECK "ending rises", rise >= 3 AND rise < 12, "rise=" + STR$(rise)
CHECK "ending lands on a G chord tone", rise_pc = 7 OR rise_pc = 11 OR rise_pc = 2, "end=" + endb$[end_i]

DIM dense$ = BARS$(MELODY.VARY$(hook$, prog$, "A minor", "dense"))
DIM d0$ = SPLIT(dense$[0], " ")
DIM h0$ = SPLIT(bars$[0], " ")
DIM kept AS INTEGER = TRUE
DIM more AS INTEGER = 0
FOR bi = 0 TO 15
    IF h0$[bi] <> "~" AND d0$[bi] <> h0$[bi] THEN kept = FALSE
    IF h0$[bi] = "~" AND d0$[bi] <> "~" THEN more = more + 1
NEXT bi
CHECK "dense keeps the hook's notes", kept, dense$[0]
CHECK "dense adds passing notes", more > 0, dense$[0]

' ---------- bass ----------
CHECK_STR "bass offbeat", "<[~ a1 a1 a1]*4 [~ f1 f1 f1]*4 [~ c2 c2 c2]*4 [~ g1 g1 g1]*4>", MELODY.BASS$(prog$, "offbeat", 1)
CHECK_STR "bass octave", "<[a1 a2]*4 [f1 f2]*4 [c2 c3]*4 [g1 g2]*4>", MELODY.BASS$(prog$, "octave", 1)
CHECK_STR "bass sub", "<a1 f1 c2 g1>", MELODY.BASS$(prog$, "sub", 1)
CHECK_STR "bass drive", "<[a1 a1 a1 a1 a1 a1 a2 a1] [f1 f1 f1 f1 f1 f1 f2 f1] [c2 c2 c2 c2 c2 c2 c3 c2] [g1 g1 g1 g1 g1 g1 g2 g1]>", MELODY.BASS$(prog$, "drive", 1)
DIM acid$ = MELODY.BASS$(prog$, "acid", 5)
CHECK_STR "acid is seeded", acid$, MELODY.BASS$(prog$, "acid", 5)
CHECK "acid has slides", INSTR(acid$, "^") >= 0, acid$
DIM acid_bar$ = SPLIT(BARS$(acid$)[0], " ")
DIM acid_ok AS INTEGER = TRUE
FOR bi = 0 TO LEN(acid_bar$) - 1
    DIM at$ = REPLACE$(acid_bar$[bi], "^", "")
    IF at$ <> "~" AND at$ <> "a1" AND at$ <> "a2" AND at$ <> "e2" THEN acid_ok = FALSE
NEXT bi
CHECK "acid plays root, octave and fifth", acid_ok, BARS$(acid$)[0]
CHECK "acid starts on the beat", LEFT$(acid_bar$[0], 1) <> "~", BARS$(acid$)[0]

' ---------- arp and stabs ----------
DIM arp$ = MELODY.ARP$(prog$, "updown", 16, 1)
CHECK_STR "arp updown", "a4 c5 e5 c5 a4 c5 e5 c5 a4 c5 e5 c5 a4 c5 e5 c5", BARS$(arp$)[0]
CHECK_STR "arp down, two octaves", "e6 c6 a5 e5 c5 a4 e6 c6", BARS$(MELODY.ARP$(prog$, "down", 8, 2))[0]
CHECK_STR "arp random is repeatable", MELODY.ARP$(prog$, "random", 16, 1), MELODY.ARP$(prog$, "random", 16, 1)
DIM stabs$ = MELODY.STABS$(prog$, "..x...x...x..x-.")
CHECK_STR "stabs follow the mask", "~ ~ [a3,c4,e4] ~ ~ ~ [a3,c4,e4] ~ ~ ~ [a3,c4,e4] ~ ~ [a3,c4,e4] _ ~", BARS$(stabs$)[0]
CHECK "stabs play voiced chords", INSTR(BARS$(stabs$)[1], "[a3,c4,f4]") >= 0, BARS$(stabs$)[1]

' ---------- rhythms and variety ----------
DIM rh$ = MELODY.RHYTHM$(11, FALSE)
CHECK_STR "same seed, same rhythm", rh$, MELODY.RHYTHM$(11, FALSE)
DIM rhythms_ok AS INTEGER = TRUE
DIM room_ok AS INTEGER = TRUE
DIM rs AS INTEGER
FOR rs = 1 TO 30
    DIM r1$ = REPLACE$(MELODY.RHYTHM$(rs, FALSE), " ", "")
    DIM n_on AS INTEGER = LEN(r1$) - LEN(REPLACE$(r1$, "x", ""))
    IF LEN(r1$) <> 16 OR n_on < 4 OR n_on > 9 THEN rhythms_ok = FALSE
    DIM r2$ = REPLACE$(MELODY.RHYTHM$(rs, TRUE), " ", "")
    IF RIGHT$(r2$, 6) <> "......" OR INSTR(r2$, "x") < 0 THEN room_ok = FALSE
NEXT rs
CHECK "rhythms: sixteen steps, four to nine notes", rhythms_ok, rh$
CHECK "room leaves the last six steps free", room_ok, MELODY.RHYTHM$(3, TRUE)

' the first note (relative to the key) and the first six moves of a hook
FUNC SHAPE$(h$) AS STRING
    DIM toks$ = SPLIT(REPLACE$(REPLACE$(REPLACE$(REPLACE$(h$, "<", ""), ">", ""), "[", ""), "]", ""), " ")
    DIM out$ AS STRING = ""
    DIM prev AS INTEGER = -1
    DIM n AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(toks$) - 1
        IF toks$[i] <> "~" AND toks$[i] <> "_" AND n < 7 THEN
            DIM m AS INTEGER = MELODY.NOTE_MIDI(toks$[i])
            IF prev < 0 THEN
                out$ = STR$((m - 69 + 120) MOD 12) + ":"
            ELSE
                out$ = out$ + MID$("DSU", SGN(m - prev) + 1, 1)
            ENDIF
            prev = m
            n = n + 1
        ENDIF
    NEXT i
    RETURN out$
ENDFUNC

DIM shapes = {}
DIM first_notes = {}
FOR rs = 1 TO 40
    DIM sh$ = SHAPE$(MELODY.HOOK$(rs, prog$, "A minor", "x--.x.x. x.x-x-..", 4))
    shapes{sh$} = 1
    first_notes{LEFT$(sh$, INSTR(sh$, ":"))} = 1
NEXT rs
CHECK "hooks start on the root, the third or the fifth", LEN(MAP.KEYS(first_notes)) >= 3, JOIN(MAP.KEYS(first_notes), " ")
CHECK "forty seeds, thirty shapes or more", LEN(MAP.KEYS(shapes)) >= 30, "shapes=" + STR$(LEN(MAP.KEYS(shapes)))

' the answer to a hook with room plays at the end of every bar
DIM roomy$ = MELODY.HOOK$(1007, prog$, "A minor", MELODY.RHYTHM$(1007, TRUE), 4)
DIM rbars$ = BARS$(MELODY.COUNTER$(1007, roomy$, prog$, "A minor", 4))
DIM late_ok AS INTEGER = TRUE
FOR bi = 0 TO 3
    DIM late AS INTEGER = FALSE
    DIM rsteps$ = SPLIT(rbars$[bi], " ")
    FOR rs = 10 TO 15
        IF rsteps$[rs] <> "~" THEN late = TRUE
    NEXT rs
    IF NOT late THEN late_ok = FALSE
NEXT bi
CHECK "the answer fills the room at the end of each bar", late_ok, JOIN(rbars$, " | ")

PRINT "RESULTS: "; PASS_COUNT; " passed, "; FAIL_COUNT; " failed"
