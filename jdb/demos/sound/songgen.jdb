' songgen.jdb - a whole track from a genre and a seed: the seed picks
' the key, the tempo, the progression, the hook's rhythm and the hook
' itself, the genre the sounds, the bass and the arrangement.
'
'   jdBasic songgen.jdb --genre trance --seed 42
'   jdBasic songgen.jdb --genre house --seed 7 --wav house7.wav
'   jdBasic songgen.jdb --genre synthwave --seed 3 --live
'
' Genres: trance (136-140 BPM, supersaw hook, rolling bass, arp, choir in
' the breakdown), house (122-126, octave bass, organ stabs, Neon hook),
' deep (118-122, dorian, sub bass with glide, a soft Neon hook, a vowel pad),
' acid (128-132, a sliding 303 line, sparse hook), synthwave (102-106,
' straight eighth bass, a gated snare on two and four, arpeggios, tom
' fills, a minor key).
'
' The seed also picks one of three forms for the genre (intro, groove,
' parts, hook, breakdown, build, drop, outro in 8, 16 or 32 bars) and a
' variant of each part: a breakdown with the choir, with pad and hook or
' without the kick; a build with a snare roll, a kick roll or a closing
' filter, perhaps ending on a bar of only pad and riser; a fill (snare,
' toms or a one-beat gap) at each phrase end; the arp or stab figure.
' The last drop is the peak: up a key, the hook varied (MELODY.VARY$)
' and answered (MELODY.COUNTER$).
'
'   --wav file   renders the track offline into a WAV instead of the show
'   --recipe     prints the recipe and the form, and stops
'   --window     the show in a window (see stage.jdb)
'   --live       a mixing desk instead of the show: mute and solo the
'                tracks, jump to a part, reroll a part, change seed and
'                genre while the music plays; a song that ends is followed by
'                one with a new random seed
'   --shot file  with --live: saves the desk as an image after 6 s (or
'                --after s) and ends
'   --stage      with --live: the show follows the desk in a window of its
'                own (stage.jdb --follow); V starts it again after closing
'   --lan        with --live: the desk is on the Node Bus of the whole LAN, so
'                a show on another machine can follow it (key in JDB_NODE_KEY)
' The recipe is printed first, so a good seed can be kept.

OPTION "EXPLICIT"

IMPORT SCORE
IMPORT STAGE
IMPORT MELODY
IMPORT PATCH

DIM GENRES$ = ["trance", "house", "deep", "acid", "synthwave"]
DIM genre$ AS STRING = "trance"
DIM seed AS INTEGER = 1
DIM wav$ AS STRING = ""
DIM recipe_only AS INTEGER = FALSE
DIM live_mode AS INTEGER = FALSE
DIM shot$ AS STRING = ""
DIM shot_after AS DOUBLE = 6
DIM stage_mode AS INTEGER = FALSE
DIM lan_mode AS INTEGER = FALSE
DIM cli = OS.ARGS()
DIM ci AS INTEGER
FOR ci = 1 TO LEN(cli) - 2
    IF cli[ci] = "--genre" THEN genre$ = LCASE$(cli[ci + 1])
    IF cli[ci] = "--seed" THEN seed = CINT(VAL(cli[ci + 1]))
    IF cli[ci] = "--wav" THEN wav$ = cli[ci + 1]
    IF cli[ci] = "--shot" THEN shot$ = cli[ci + 1]
    IF cli[ci] = "--after" THEN shot_after = VAL(cli[ci + 1])
NEXT ci
FOR ci = 1 TO LEN(cli) - 1
    IF cli[ci] = "--recipe" THEN recipe_only = TRUE
    IF cli[ci] = "--live" THEN live_mode = TRUE
    IF cli[ci] = "--stage" THEN stage_mode = TRUE
    IF cli[ci] = "--lan" THEN lan_mode = TRUE
NEXT ci
DIM GENRE_NO AS INTEGER = -1
FOR ci = 0 TO LEN(GENRES$) - 1
    IF GENRES$[ci] = genre$ THEN GENRE_NO = ci
NEXT ci
IF GENRE_NO < 0 THEN
    PRINT "unknown genre "; genre$; " (trance, house, deep, acid, synthwave)"
    END 1
ENDIF

' One of n choices for the k-th decision of this seed
FUNC PICK(k AS INTEGER, n AS INTEGER) AS INTEGER
    DIM m AS DOUBLE = 2147483647
    DIM x AS DOUBLE = (ABS(seed) MOD 100000) * 7919 + (k + 1) * 104729 + 1
    DIM r AS INTEGER
    FOR r = 1 TO 4
        x = x * 48271
        x = x - INT(x / m) * m
        x = (INT(x) BXOR (INT(x) SHR 13)) + 1
    NEXT r
    x = x - INT(x / m) * m
    RETURN INT(x / m * n)
ENDFUNC

' how often each part was rerolled; a reroll gives the part new choices
DIM PART_SALT = RESHAPE([0], [32])

' The k-th decision of part fi
FUNC PICK_PART(fi AS INTEGER, k AS INTEGER, n AS INTEGER) AS INTEGER
    RETURN PICK(k + fi + 1000 * PART_SALT[fi], n)
ENDFUNC

' ── The recipe ───────────────────────────────────────────────────

DIM KEY$ AS STRING = ""
DIM BPM AS DOUBLE = 120
DIM PROG_NAME$ AS STRING = ""
DIM RHYTHM_A$ AS STRING = ""
DIM RHYTHM_B$ AS STRING = ""
DIM OCT AS INTEGER = 4
DIM PROG$ AS STRING = ""
DIM CHORDS$ AS STRING = ""
DIM HOOK$ AS STRING = ""
DIM HOOK_B$ AS STRING = ""
DIM BASS$ AS STRING = ""
' the arp or stab figures; each part's flavour picks one
DIM FIGURES$ = ["", "", ""]
DIM ARP_TEXT$ AS STRING = ""
DIM ARP_PATCH$ AS STRING = "neon_pluck"
DIM BREAK_PROG$ AS STRING = ""
DIM BREAK_CHORDS$ AS STRING = ""
DIM BREAK_LINE$ AS STRING = ""
DIM BREAK_FIGURE$ AS STRING = ""
DIM COUNTER_A$ AS STRING = ""
DIM COUNTER_B$ AS STRING = ""
DIM VARY_NAMES$ = ["dense", "octave", "ending"]
DIM VARY_KIND$ AS STRING = ""
DIM VARIED_A$ AS STRING = ""
DIM VARIED_B$ AS STRING = ""
DIM LIFT AS INTEGER = 1
' semitones the music now plays above the key; drums stay as they are
DIM CUR_LIFT AS INTEGER = 0
DIM TITLE_A$ = ["Neon", "Glass", "Silver", "Midnight", "Velvet", "Electric", "Paper", "Golden", "Crystal", "Static", "Hollow", "Endless", "Quiet", "Burning", "Northern", "Second"]
DIM TITLE_B$ = ["Horizon", "Tide", "Signal", "Garden", "Cathedral", "Engine", "Satellite", "Rain", "Mirror", "Harbour", "Lantern", "Orbit", "Daylight", "Circuit", "Meridian", "Echo"]
DIM TITLE$ AS STRING = ""
DIM INTRO_NAMES$ = ["drums and a filtered teaser", "a pad swell, the kick at bar 4", "drums and a filtered bass"]
DIM INTRO AS INTEGER = 0
' the recipe and the form as printed, a line each
DIM RECIPE$ AS STRING = ""
DIM NL$ AS STRING = CHR$(10)

SUB MAKE_RECIPE()
    DIM keys$ = []
    DIM progs$ = []
    DIM bpm_lo AS INTEGER = 136
    DIM bass_style$ AS STRING = "offbeat"
    IF genre$ = "trance" THEN
        keys$ = ["A minor", "F# minor", "C# minor", "D minor", "E minor", "G minor"]
        progs$ = ["epic", "anthem", "dark"]
        bpm_lo = 136
    ELSEIF genre$ = "house" THEN
        keys$ = ["F major", "Bb major", "Eb major", "C major", "A minor", "D minor"]
        progs$ = ["house", "pop", "euphoric"]
        bpm_lo = 122
        bass_style$ = "octave"
    ELSEIF genre$ = "deep" THEN
        keys$ = ["D dorian", "G dorian", "C dorian", "A dorian", "F dorian"]
        progs$ = ["deep", "deep", "dark"]
        bpm_lo = 118
        bass_style$ = "sub"
    ELSEIF genre$ = "synthwave" THEN
        keys$ = ["A minor", "E minor", "F# minor", "D minor", "C minor", "F minor"]
        progs$ = ["outrun", "epic", "anthem"]
        bpm_lo = 102
        bass_style$ = "drive"
    ELSE
        keys$ = ["A minor", "E minor", "F minor", "G minor"]
        progs$ = ["dark", "epic", "anthem"]
        bpm_lo = 128
        bass_style$ = "acid"
    ENDIF
    KEY$ = keys$[PICK(1, LEN(keys$))]
    BPM = bpm_lo + PICK(2, 5)
    PROG_NAME$ = progs$[PICK(3, LEN(progs$))]
    RHYTHM_A$ = MELODY.RHYTHM$(seed, FALSE)
    ' the second hook leaves the end of each bar to its answer
    RHYTHM_B$ = MELODY.RHYTHM$(seed + 1000, TRUE)
    OCT = 4
    IF genre$ = "deep" OR genre$ = "acid" THEN OCT = 3 + PICK(6, 2)

    PROG$ = MELODY.PROG$(PROG_NAME$, KEY$)
    CHORDS$ = "<" + PROG$ + ">"
    HOOK$ = MELODY.HOOK$(seed, PROG$, KEY$, RHYTHM_A$, OCT)
    HOOK_B$ = MELODY.HOOK$(seed + 1000, PROG$, KEY$, RHYTHM_B$, OCT)
    BASS$ = "legato(0.6, " + MELODY.BASS$(PROG$, bass_style$, seed) + ")"
    IF bass_style$ = "sub" THEN BASS$ = "legato(1, " + MELODY.BASS$(PROG$, "sub", seed) + ")"
    IF bass_style$ = "acid" THEN BASS$ = "legato(0.7, " + MELODY.BASS$(PROG$, "acid", seed) + ")"
    ' the breakdown's progression, with chords borrowed from the parallel key
    BREAK_PROG$ = MELODY.BORROWED$(KEY$)
    BREAK_CHORDS$ = "<" + BREAK_PROG$ + ">"
    BREAK_LINE$ = "legato(1.2, " + MELODY.ARP$(BREAK_PROG$, "down", 4, 1) + ")"
    DIM stab_pool$ = ["..x...x...x..x-.", "x..x..x...x.x...", "..x..x.x..x...x.", "x.-.x.-..x.x-.x.", ".x..x..x.x..x...", "x...x.x...x.x.x."]
    DIM arp_shapes$ = ["up", "down", "updown", "downup", "pedal", "octave", "threes", "random"]
    DIM arp_masks$ = ["", "", "x.xx.x.x..x.x.x.", "xx.xx.x.xx.xx.x.", "x..x..x..x..x.x.", "x.x.x.xxx.x.x.xx"]
    DIM arp_rates = [16, 16, 16, 8, 12]
    DIM arp_lengths = [0.3, 0.5, 0.7]
    DIM moves$ = ["", "", "every(4, rev, ", "iter(4, ", "off(0.125, add(12), "]
    DIM fi AS INTEGER
    ARP_TEXT$ = ""
    FOR fi = 0 TO 2
        IF genre$ = "house" OR genre$ = "deep" THEN
            FIGURES$[fi] = "legato(0.5, " + MELODY.STABS$(PROG$, stab_pool$[PICK(810 + 7 * fi, LEN(stab_pool$))]) + ")"
        ELSE
            DIM shape$ AS STRING = arp_shapes$[PICK(811 + 7 * fi, LEN(arp_shapes$))]
            DIM rate AS INTEGER = arp_rates[PICK(812 + 7 * fi, LEN(arp_rates))]
            DIM span AS INTEGER = 1 + PICK(813 + 7 * fi, 2)
            IF shape$ = "octave" THEN span = 1
            DIM mask$ AS STRING = ""
            IF rate = 16 THEN mask$ = arp_masks$[PICK(814 + 7 * fi, LEN(arp_masks$))]
            DIM len_i AS INTEGER = PICK(815 + 7 * fi, 3)
            DIM fig$ AS STRING = "legato(" + STR$(arp_lengths[len_i]) + ", " + MELODY.GATE$(MELODY.ARP$(PROG$, shape$, rate, span), mask$) + ")"
            DIM move$ AS STRING = moves$[PICK(816 + 7 * fi, LEN(moves$))]
            IF move$ <> "" THEN fig$ = move$ + fig$ + ")"
            ' a figure that is higher, longer or doubled plays softer, so the mix
            ' keeps its loudness
            DIM level AS DOUBLE = 1
            IF span > 1 OR shape$ = "octave" THEN level = level * 0.75
            IF shape$ = "threes" THEN level = level * 0.85
            IF len_i = 2 THEN level = level * 0.85
            IF INSTR(move$, "off(") = 0 THEN level = level * 0.7
            IF level < 1 THEN fig$ = "gain(" + STR$(INT(level * 100) / 100) + ", " + fig$ + ")"
            FIGURES$[fi] = fig$
            IF fi > 0 THEN ARP_TEXT$ = ARP_TEXT$ + ", "
            ARP_TEXT$ = ARP_TEXT$ + shape$ + " " + STR$(rate) + IIF(span > 1, " two octaves", "") + IIF(mask$ <> "", " gated", "") + IIF(move$ <> "", " " + LEFT$(move$, INSTR(move$, "(")), "")
        ENDIF
    NEXT fi
    IF genre$ = "house" OR genre$ = "deep" THEN
        BREAK_FIGURE$ = "legato(0.5, " + MELODY.STABS$(BREAK_PROG$, stab_pool$[0]) + ")"
    ELSE
        BREAK_FIGURE$ = "legato(0.5, " + MELODY.ARP$(BREAK_PROG$, "updown", 16, 1) + ")"
    ENDIF
    ' the answers to each hook, in its register between its notes
    COUNTER_A$ = MELODY.COUNTER$(seed, HOOK$, PROG$, KEY$, OCT)
    COUNTER_B$ = MELODY.COUNTER$(seed + 1000, HOOK_B$, PROG$, KEY$, OCT)
    ' the hooks as the last drop plays them, up a key
    VARY_KIND$ = VARY_NAMES$[PICK(10, 3)]
    VARIED_A$ = MELODY.VARY$(HOOK$, PROG$, KEY$, VARY_KIND$)
    VARIED_B$ = MELODY.VARY$(HOOK_B$, PROG$, KEY$, VARY_KIND$)
    LIFT = 1 + PICK(9, 2)

    TITLE$ = TITLE_A$[PICK(11 + 50 * GENRE_NO, LEN(TITLE_A$))] + " " + TITLE_B$[PICK(12 + 50 * GENRE_NO, LEN(TITLE_B$))]
    INTRO = PICK_PART(0, 7, 3)
    RECIPE$ = "songgen: " + CHR$(34) + TITLE$ + CHR$(34) + ", " + genre$ + ", seed " + STR$(seed) + NL$
    RECIPE$ = RECIPE$ + "  key " + KEY$ + ", " + STR$(BPM) + " BPM, progression " + PROG_NAME$ + ": " + PROG$ + NL$
    RECIPE$ = RECIPE$ + "  hook rhythm " + RHYTHM_A$ + " / " + RHYTHM_B$ + ", octave " + STR$(OCT) + NL$
    RECIPE$ = RECIPE$ + "  intro: " + INTRO_NAMES$[INTRO] + NL$
    RECIPE$ = RECIPE$ + "  hook " + HOOK$ + NL$
    IF ARP_TEXT$ <> "" THEN RECIPE$ = RECIPE$ + "  arps: " + ARP_TEXT$ + NL$
ENDSUB

DIM KICK AS INTEGER = 0
DIM CLAP AS INTEGER = 1
DIM HATS AS INTEGER = 2
DIM OPENHAT AS INTEGER = 3
DIM BASS AS INTEGER = 4
DIM PAD AS INTEGER = 5
DIM ARP AS INTEGER = 6
DIM LEAD AS INTEGER = 7
DIM RISER AS INTEGER = 8
DIM CRASH AS INTEGER = 9
DIM SNARE AS INTEGER = 10
DIM CHOIR AS INTEGER = 11
DIM KEYS AS INTEGER = 12
DIM PERC AS INTEGER = 13
DIM COUNTER AS INTEGER = 14
DIM GATE AS INTEGER = 15
DIM TRACK_NAMES$ = ["KICK", "CLAP", "HATS", "OPENHAT", "BASS", "PAD", "ARP", "LEAD", "RISER", "CRASH", "SNARE", "CHOIR", "KEYS", "PERC", "COUNTER", "GATE"]
DIM N_TRACKS AS INTEGER = LEN(TRACK_NAMES$)
DIM ti AS INTEGER
FOR ti = 0 TO N_TRACKS - 1
    SCORE.TRACK ti, TRACK_NAMES$[ti]
NEXT ti

' ── Instruments ──────────────────────────────────────────────────

' What every genre shares: the kits, the orbits, pans and nudges
SUB INIT_SOUND()
    DIM t AS INTEGER
    FOR t = 0 TO N_TRACKS - 1
        IF t = KICK OR t = CLAP OR t = HATS OR t = OPENHAT OR t = SNARE OR t = CRASH OR t = PERC THEN SOUND.KIT t, "SYNTH"
    NEXT t
    ' the hats and the percussion sit a few milliseconds behind the kick
    SOUND.NUDGE PERC, 7
    SOUND.NUDGE HATS, 4
    SOUND.NUDGE OPENHAT, 4
    SOUND.PAN PERC, 0.35
    SOUND.PAN HATS, 0.6
    SOUND.PAN ARP, 0.4
    SOUND.PAN COUNTER, 0.65
    SOUND.ORBIT CRASH, 1
    SOUND.ORBIT GATE, 1
    SOUND.ORBIT PAD, 1
    SOUND.ORBIT CHOIR, 1
    SOUND.ORBIT LEAD, 1
    SOUND.ORBIT RISER, 1
ENDSUB

DIM BASS_PATCH$ AS STRING = "bass_roll"
DIM LEAD_PATCH$ AS STRING = "neon_lead"
DIM KEYS_PATCH$ AS STRING = "fm_keys"
DIM COUNTER_PATCH$ AS STRING = "neon_voice"
DIM BASS_CUT AS DOUBLE = 700
DIM BASS_RES AS DOUBLE = 0.35
DIM PAD_GAIN AS DOUBLE = 0.18

' The genre's sounds and mix, sent for bar 0: the score that follows
' plays on a clean desk, also when it replaces one that plays
SUB SETUP_SOUND()
    DIM t AS INTEGER
    SCORE.AT 0
    FOR t = 0 TO N_TRACKS - 1
        SOUND.SEQ t, "", "VOICE"
        SOUND.MOD t, "CUTOFF", "OFF"
        SOUND.MOD t, "GAIN", "OFF"
        SOUND.MOD t, "VOWEL", "OFF"
    NEXT t
    SOUND.MASTER "FIXED", 0.42
    SCORE.TEMPO BPM
    SOUND.COMPRESSOR 0.6, 2.5, 6, 160, 1.1
    ' synthwave glues its bus harder, the parts sit closer to the drop
    IF genre$ = "synthwave" THEN SOUND.COMPRESSOR 0.3, 3, 12, 220, 1.5
    ' the limiter's drive lifts each genre's mix onto its loudness target
    ' (-12 LUFS integrated, as --wav reports), peaks stay under -1 dB
    DIM loud_drive AS DOUBLE = 4.2
    IF genre$ = "house" THEN loud_drive = 3.1
    IF genre$ = "deep" THEN loud_drive = 2.6
    IF genre$ = "acid" THEN loud_drive = 4.9
    IF genre$ = "synthwave" THEN loud_drive = 4.4
    SOUND.LIMITER -1, loud_drive

    SOUND.REVERB 0.6, 0.5, 0.9, 0.2
    SOUND.DELAY TRUE, "1/8.", 0.4, 0.28, 0, TRUE
    SOUND.REVERB 0.95, 0.4, 1.0, 0.65, 1
    IF genre$ = "synthwave" THEN SOUND.REVERB 0.97, 0.35, 1.0, 0.75, 1
    SOUND.DELAY TRUE, "1/4", 0.35, 0.25, 1

    SOUND.GAIN KICK, 0.85
    SOUND.GAIN PERC, 0.45
    SOUND.REVERBSEND PERC, 0.25
    SOUND.GAIN CLAP, 0.55
    SOUND.REVERBSEND CLAP, 0.35
    SOUND.GAIN HATS, 0.45
    SOUND.FILTER HATS, 6000, 0.2, "HP"
    SOUND.GAIN OPENHAT, 0.4
    SOUND.GAIN SNARE, 0.5
    SOUND.REVERBSEND SNARE, 0.3
    ' the gated snare's tail: a burst of noise that stops dead
    SOUND.VOICE GATE, "NOISE", 0.001, 0.03, 0.55, 0.004
    SOUND.FILTER GATE, 1800, 0.2, "BP"
    SOUND.GAIN GATE, 0.22
    SOUND.REVERBSEND GATE, 0.35
    IF genre$ = "synthwave" THEN
        SOUND.GAIN KICK, 0.68
        SOUND.GAIN CLAP, 0.6
        SOUND.REVERBSEND CLAP, 0.5
    ENDIF
    SOUND.GAIN CRASH, 0.6
    SOUND.REVERBSEND CRASH, 0.4

    ' the sounds: patches, then the mix (sidechain)
    BASS_PATCH$ = "bass_roll"
    LEAD_PATCH$ = "neon_lead"
    KEYS_PATCH$ = "fm_keys"
    ' the answer has the signature voice in every genre
    COUNTER_PATCH$ = "neon_voice"
    BASS_CUT = 700
    BASS_RES = 0.35
    IF genre$ = "house" THEN
        BASS_PATCH$ = "bass_house"
        KEYS_PATCH$ = "organ"
        BASS_CUT = 600
        BASS_RES = 0.3
    ELSEIF genre$ = "deep" THEN
        BASS_PATCH$ = "sub"
        LEAD_PATCH$ = "neon_soft"
        BASS_CUT = 20000
        BASS_RES = 0
    ELSEIF genre$ = "acid" THEN
        BASS_PATCH$ = "acid"
        BASS_CUT = 500
        BASS_RES = 0.75
    ELSEIF genre$ = "synthwave" THEN
        BASS_PATCH$ = "synth_bass"
        BASS_CUT = PATCH.CUTOFF("synth_bass")
        BASS_RES = PATCH.RESONANCE("synth_bass")
    ENDIF
    DIM arp_patches$ = ["neon_pluck", "neon_pluck", "neon_soft", "fm_keys"]
    ARP_PATCH$ = arp_patches$[PICK(830, LEN(arp_patches$))]
    RECIPE$ = RECIPE$ + "  sounds: " + BASS_PATCH$ + ", " + ARP_PATCH$ + ", " + KEYS_PATCH$ + ", " + LEAD_PATCH$ + ", " + COUNTER_PATCH$ + NL$

    PATCH.APPLY BASS, BASS_PATCH$
    SOUND.SIDECHAIN BASS, KICK, 0.7

    PATCH.APPLY PAD, "pad"
    SOUND.SIDECHAIN PAD, KICK, 0.7
    IF genre$ = "deep" THEN
        SOUND.FORMANT PAD, "oo", 0.8, 0.05
        SOUND.FILTER PAD, 2200, 0.1
    ENDIF

    PATCH.APPLY CHOIR, "choir"

    PATCH.APPLY ARP, ARP_PATCH$
    SOUND.SIDECHAIN ARP, KICK, 0.4

    PATCH.APPLY KEYS, KEYS_PATCH$
    SOUND.SIDECHAIN KEYS, KICK, 0.35

    PATCH.APPLY LEAD, LEAD_PATCH$
    IF genre$ = "deep" THEN SOUND.GAIN LEAD, 0.26
    SOUND.SIDECHAIN LEAD, KICK, 0.35

    PATCH.APPLY COUNTER, COUNTER_PATCH$
    SOUND.SIDECHAIN COUNTER, KICK, 0.2

    SOUND.VOICE RISER, "NOISE", 0.01, 0.1, 1.0, 0.3
    SOUND.FILTER RISER, 400, 0.4, "BP"
    SOUND.REVERBSEND RISER, 0.3
    SOUND.GAIN RISER, 0
ENDSUB

' ── Arrangement ──────────────────────────────────────────────────
' A form is a list of parts on the 8-bar grid. Each part starts from a
' clean slate: the tracks it does not play fall silent, the sweeps of
' the part before stop and their filters return to the patch.

DIM HATS16$ AS STRING = ""
DIM PARTS_TRACK AS INTEGER = ARP
DIM PARTS$ AS STRING = ""

DIM LIVE = IOTA(N_TRACKS, 0) * 0
DIM WANT = IOTA(N_TRACKS, 0) * 0
DIM SWEPT$ = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
DIM BASE_CUT = IOTA(N_TRACKS, 0) * 0 + 20000
DIM BASE_RES = IOTA(N_TRACKS, 0) * 0
DIM BASE_FT$ = ["LP", "LP", "HP", "LP", "LP", "LP", "LP", "LP", "BP", "LP", "LP", "LP", "LP", "LP", "LP", "BP"]

' The arrangement starts with every track silent and every filter at
' its patch
SUB RESET_ARRANGEMENT()
    HATS16$ = "sometimesBy(0.3, gain(0.78), gain([0.4 0.6 0.5 0.75]*4, hh*16))"
    PICK_SONG_GROOVE
    HATS16$ = SWUNG$(HATS16$)
    PARTS_TRACK = ARP
    IF genre$ = "house" OR genre$ = "deep" THEN PARTS_TRACK = KEYS
    PARTS$ = FIGURES$[0]
    CUR_LIFT = 0
    LIVE = IOTA(N_TRACKS, 0) * 0
    WANT = IOTA(N_TRACKS, 0) * 0
    SWEPT$ = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
    BASE_CUT = IOTA(N_TRACKS, 0) * 0 + 20000
    BASE_RES = IOTA(N_TRACKS, 0) * 0
    BASE_CUT[HATS] = 6000
    BASE_RES[HATS] = 0.2
    BASE_CUT[RISER] = 400
    BASE_RES[RISER] = 0.4
    BASE_CUT[GATE] = 1800
    BASE_RES[GATE] = 0.2
    BASE_CUT[BASS] = BASS_CUT
    BASE_RES[BASS] = BASS_RES
    BASE_CUT[PAD] = PATCH.CUTOFF("pad")
    BASE_RES[PAD] = PATCH.RESONANCE("pad")
    IF genre$ = "deep" THEN
        BASE_CUT[PAD] = 2200
        BASE_RES[PAD] = 0.1
    ENDIF
    BASE_CUT[ARP] = PATCH.CUTOFF(ARP_PATCH$)
    BASE_RES[ARP] = PATCH.RESONANCE(ARP_PATCH$)
    BASE_CUT[KEYS] = PATCH.CUTOFF(KEYS_PATCH$)
    BASE_RES[KEYS] = PATCH.RESONANCE(KEYS_PATCH$)
    BASE_CUT[LEAD] = PATCH.CUTOFF(LEAD_PATCH$)
    BASE_RES[LEAD] = PATCH.RESONANCE(LEAD_PATCH$)
    BASE_FT$[LEAD] = PATCH.FILTER_TYPE$(LEAD_PATCH$)
ENDSUB

' the part that follows the one being written
DIM NEXT_PART$ AS STRING = ""

' pat$ moved up by the current lift
FUNC LIFTED$(pat$) AS STRING
    IF CUR_LIFT = 0 THEN RETURN pat$
    RETURN "add(" + TRIM$(STR$(CUR_LIFT)) + ", " + pat$ + ")"
ENDFUNC

SUB TRK_ON(t AS INTEGER, pat$)
    SCORE.PLAY t, pat$
    LIVE[t] = 1
    WANT[t] = 1
ENDSUB

SUB TRK_OFF(t AS INTEGER)
    IF LIVE[t] THEN SCORE.QUIET t
    LIVE[t] = 0
ENDSUB

SUB SW(t AS INTEGER, param$, shape$, lo AS DOUBLE, hi AS DOUBLE, cycles AS DOUBLE, from_bar AS DOUBLE)
    SCORE.SWEEP t, param$, shape$, lo, hi, cycles, -from_bar / cycles
    IF INSTR(" " + SWEPT$[t] + " ", " " + param$ + " ") < 0 THEN SWEPT$[t] = TRIM$(SWEPT$[t] + " " + param$)
ENDSUB

' Stops every running sweep; a filter returns to its patch, a faded
' track (the riser) to silence, the choir to "ooh"
SUB CLEAN()
    DIM t AS INTEGER
    DIM k AS INTEGER
    FOR t = 0 TO N_TRACKS - 1
        IF LEN(SWEPT$[t]) > 0 THEN
            DIM params$ = SPLIT(SWEPT$[t], " ")
            FOR k = 0 TO LEN(params$) - 1
                SCORE.SWEEP_OFF t, params$[k]
                IF params$[k] = "CUTOFF" THEN SOUND.FILTER t, BASE_CUT[t], BASE_RES[t], BASE_FT$[t]
                IF params$[k] = "GAIN" THEN SOUND.GAIN t, 0
            NEXT k
            SWEPT$[t] = ""
        ENDIF
    NEXT t
    SOUND.GAIN PAD, PAD_GAIN
    SOUND.FORMANT CHOIR, "oo", 1.0, 0.08
ENDSUB

SUB BEGIN_PART(b AS INTEGER, name$, mood$)
    SCORE.SECTION b, name$, mood$
    CLEAN
    WANT = IOTA(N_TRACKS, 0) * 0
ENDSUB

' Silences what the new part does not play
SUB COMMIT_PART(b AS INTEGER)
    DIM t AS INTEGER
    SCORE.AT b
    FOR t = 0 TO N_TRACKS - 1
        IF LIVE[t] ANDALSO WANT[t] = 0 THEN TRK_OFF t
    NEXT t
ENDSUB

' The groove: the song picks the kick, the hat style and the swing, each
' part its clap figure, how many claps it scatters and its percussion.
' Scattered hits come from the seed, so a seed always plays the same.
DIM CUR_PART AS INTEGER = 0
DIM KICK_PAT$ AS STRING = "bd*4"
DIM HAT_STYLE AS INTEGER = 0
DIM SWING_AMT AS DOUBLE = 0.1
DIM CLAP_PAT$ AS STRING = "~ cp ~ cp"
DIM CLAP_SCATTER AS DOUBLE = 0
DIM PERC_A$ AS STRING = "rim(3,8,2)"
DIM PERC_B$ AS STRING = "cb(5,16,3)"
DIM BREAK_CLAP$ AS STRING = "~ cp ~ cp"

' a quiet snare scattered around the clap, or "" below level 3
DIM GHOST$ AS STRING = ""

' Some events of p a little softer
FUNC LOOSE$(pat$) AS STRING
    RETURN "sometimesBy(0.35, gain(0.7), " + pat$ + ")"
ENDFUNC

' The k-th groove decision of part fi; parts lie far apart in k, so the
' scattered hits of two parts do not repeat each other
FUNC GPICK(fi AS INTEGER, k AS INTEGER, n AS INTEGER) AS INTEGER
    RETURN PICK(k + 1009 * fi + 50021 * PART_SALT[fi], n)
ENDFUNC

FUNC SWUNG$(pat$) AS STRING
    IF genre$ = "house" OR genre$ = "deep" THEN RETURN "swingBy(" + STR$(SWING_AMT) + ", 4, " + pat$ + ")"
    RETURN pat$
ENDFUNC

' Four bars of sixteenths where snd$ falls on each step with the chance
' density, never on the steps listed in skip$ (" 4 12 "); the seed and
' salt decide where
FUNC SCATTER$(snd$, density AS DOUBLE, salt AS INTEGER, skip$) AS STRING
    DIM out$ AS STRING = "<"
    DIM b AS INTEGER
    DIM s AS INTEGER
    FOR b = 0 TO 3
        DIM bar$ AS STRING = "["
        FOR s = 0 TO 15
            DIM hit AS INTEGER = FALSE
            IF INSTR(skip$, " " + STR$(s) + " ") < 0 THEN hit = GPICK(CUR_PART, salt + b * 16 + s, 1000) < density * 1000
            IF s > 0 THEN bar$ = bar$ + " "
            IF hit THEN
                bar$ = bar$ + snd$
            ELSE
                bar$ = bar$ + "~"
            ENDIF
        NEXT s
        IF b > 0 THEN out$ = out$ + " "
        out$ = out$ + bar$ + "]"
    NEXT b
    RETURN out$ + ">"
ENDFUNC

' The song-wide part of the groove
SUB PICK_SONG_GROOVE()
    DIM kicks$ = ["bd*4", "<bd*4 [bd*4, [~ ~ ~ [~ ~ ~ bd]]]>"]
    IF genre$ = "deep" THEN kicks$ = APPEND(kicks$, "<bd*4 [bd ~ ~ bd ~ ~ bd ~]>")
    IF genre$ = "synthwave" THEN kicks$ = ["bd*4", "gain(0.75, legato(0.9, bd:1*4))", "<bd*4 [bd*4, [~ ~ ~ [~ ~ ~ bd]]]>"]
    KICK_PAT$ = kicks$[PICK(800, LEN(kicks$))]
    HAT_STYLE = PICK(801, 4)
    SWING_AMT = 0.06 + 0.04 * PICK(802, 4)
    DIM hat_names$ = ["sixteenths", "sixteenths on the beat", "eighths and scattered sixteenths", "shaker"]
    RECIPE$ = RECIPE$ + "  groove: kick " + KICK_PAT$ + ", hats " + hat_names$[HAT_STYLE] + NL$
ENDSUB

' The groove of part fi
SUB PICK_GROOVE(fi AS INTEGER)
    CUR_PART = fi
    DIM claps$ = ["~ cp ~ cp", "<[~ cp ~ cp] [~ cp ~ [cp ~ ~ cp]]>", "~ [cp,sd] ~ [cp,sd]", "off(0.008, gain(0.6), ~ cp ~ cp)", "<[~ cp ~ cp]!3 [~ cp [~ ~ ~ cp] cp]>"]
    IF genre$ = "synthwave" THEN claps$ = ["~ sd ~ sd", "off(0.008, gain(0.6), ~ sd ~ sd)", "~ [sd,cp] ~ [sd,cp]", "<[~ sd ~ sd]!3 [~ sd [~ ~ ~ sd] sd]>"]
    CLAP_PAT$ = claps$[GPICK(fi, 901, LEN(claps$))]
    DIM densities = [0, 0.04, 0.07, 0.1]
    CLAP_SCATTER = densities[GPICK(fi, 902, 4)]
    DIM insts$ = ["rim", "cb", "cl", "sh", "lt", "mt"]
    DIM rhythms$ = ["3,8", "5,8", "5,16", "7,16", "3,16", "9,16"]
    DIM ia AS INTEGER = GPICK(fi, 903, LEN(insts$))
    DIM ib AS INTEGER = (ia + 1 + GPICK(fi, 904, LEN(insts$) - 1)) MOD LEN(insts$)
    DIM ra$ AS STRING = rhythms$[GPICK(fi, 905, LEN(rhythms$))]
    DIM rb$ AS STRING = rhythms$[GPICK(fi, 906, LEN(rhythms$))]
    PERC_A$ = insts$[ia] + "(" + ra$ + "," + STR$(GPICK(fi, 907, 8)) + ")"
    PERC_B$ = insts$[ib] + "(" + rb$ + "," + STR$(GPICK(fi, 908, 8)) + ")"
    BREAK_CLAP$ = "~ cp ~ cp"
    IF GPICK(fi, 909, 2) = 1 THEN BREAK_CLAP$ = "~ ~ cp ~"
ENDSUB

FUNC HATS_PAT$(level AS INTEGER) AS STRING
    IF level = 1 THEN RETURN "gain(0.5, [~ hh]*4)"
    IF HAT_STYLE = 1 THEN RETURN SWUNG$("sometimesBy(0.3, gain(0.78), gain([0.75 0.4 0.55 0.4]*4, hh*16))")
    IF HAT_STYLE = 2 THEN RETURN SWUNG$("sometimesBy(0.25, gain(0.8), gain([0.7 0.45]*4, hh*8)), gain(0.35, " + SCATTER$("hh", 0.3, 100, " 0 2 4 6 8 10 12 14 ") + ")")
    IF HAT_STYLE = 3 THEN RETURN SWUNG$("gain([0.45 0.75 0.55 0.85]*4, sh*16), gain(0.5, [~ hh]*4)")
    RETURN HATS16$
ENDFUNC

' The clap figure of the part, with its scattered claps from level 3
FUNC CLAPS_PAT$(level AS INTEGER, snd$) AS STRING
    DIM dens AS DOUBLE = CLAP_SCATTER * (0.4 + 0.3 * (level - 2))
    IF dens <= 0 THEN RETURN CLAP_PAT$
    RETURN CLAP_PAT$ + ", gain(0.5, " + SCATTER$(snd$, dens, 200 + 100 * level, " 4 12 ") + ")"
ENDFUNC

' The synthwave drums: eighth hats, the gated snare on two and four
' from level 3, sixteenths from 4, the open hat at 5
SUB DRUMS_80S(level AS INTEGER)
    TRK_ON KICK, KICK_PAT$
    IF level = 1 THEN
        TRK_ON HATS, "gain(0.5, [~ hh]*4)"
    ELSEIF level < 4 THEN
        TRK_ON HATS, LOOSE$("gain([0.65 0.45]*4, hh*8)")
    ELSE
        TRK_ON HATS, HATS_PAT$(level)
    ENDIF
    IF level >= 3 THEN
        TRK_ON CLAP, CLAPS_PAT$(level, "sd")
        TRK_ON GATE, "legato(0.45, ~ c4 ~ c4)"
    ENDIF
    IF level = 5 THEN TRK_ON OPENHAT, "gain(0.7, [~ oh]*4)"
    GHOST$ = ""
ENDSUB

' The drums at an energy from 1 (kick and light hats) to 5
SUB DRUMS(level AS INTEGER)
    IF genre$ = "synthwave" THEN
        DRUMS_80S level
        RETURN
    ENDIF
    DIM kick$ AS STRING = KICK_PAT$
    IF level >= 4 THEN kick$ = kick$ + ", gain(0.35, " + SCATTER$("bd", 0.03, 200, " 0 4 8 12 ") + ")"
    TRK_ON KICK, kick$
    TRK_ON HATS, HATS_PAT$(level)
    IF level >= 3 THEN
        TRK_ON CLAP, CLAPS_PAT$(level, "cp")
        TRK_ON OPENHAT, "[~ oh]*4"
    ENDIF
    IF level = 2 OR level = 3 THEN TRK_ON PERC, LOOSE$(PERC_A$)
    IF level = 4 THEN TRK_ON PERC, LOOSE$(PERC_A$ + ", " + PERC_B$)
    IF level = 5 THEN TRK_ON PERC, LOOSE$(PERC_A$ + ", sometimes(ply(2), " + PERC_B$ + ")")
    GHOST$ = ""
    IF level >= 3 THEN
        GHOST$ = "gain(0.14, " + SCATTER$("sd", 0.08, 300, " 4 12 ") + ")"
        TRK_ON SNARE, GHOST$
    ENDIF
ENDSUB

SUB CRASH_AT(b AS INTEGER)
    SCORE.AT b
    TRK_ON CRASH, "cr ~ ~ ~"
    SCORE.AT b + 1
    TRK_OFF CRASH
ENDSUB

DIM FILL_NAMES$ = ["snare", "toms", "a one-beat gap"]

' A fill on bar b, the last of a phrase. Inside a part the snare stops
' again on the next bar; the gap silences all but pad and choir for the
' last beat, and the next part brings the tracks back.
SUB FILL(b AS INTEGER, kind AS INTEGER, inside AS INTEGER)
    DIM t AS INTEGER
    SCORE.AT b
    IF kind = 2 THEN
        SCORE.AT b + 0.75
        FOR t = 0 TO N_TRACKS - 1
            IF t <> PAD AND t <> CHOIR AND t <> RISER THEN TRK_OFF t
        NEXT t
        RETURN
    ENDIF
    IF kind = 1 THEN
        TRK_ON SNARE, "~ ~ [ht ht mt mt] [lt lt lt ~]"
    ELSE
        TRK_ON SNARE, "~ ~ [~ sd] [sd sd sd sd]"
    ENDIF
    IF inside THEN
        SCORE.AT b + 1
        IF LEN(GHOST$) > 0 THEN
            TRK_ON SNARE, GHOST$
        ELSE
            TRK_OFF SNARE
        ENDIF
    ENDIF
ENDSUB

SUB PART_INTRO(b AS INTEGER, n AS INTEGER, v AS INTEGER)
    BEGIN_PART b, "intro: " + INTRO_NAMES$[v], "groove"
    IF v = 0 THEN
        DRUMS 2
        TRK_ON PARTS_TRACK, PARTS$
        SW PARTS_TRACK, "CUTOFF", "SAW", 250, 1600, n, b
    ELSEIF v = 1 THEN
        SOUND.GAIN PAD, 0.32
        TRK_ON PAD, "legato(1, " + CHORDS$ + ")"
        SW PAD, "CUTOFF", "SAW", 700, 2400, n, b
        TRK_ON HATS, "gain(0.5, [~ hh]*4)"
    ELSE
        DRUMS 2
        TRK_ON PERC, "rim(3,8,2), cb(5,16,3)"
        TRK_ON BASS, BASS$
        SOUND.FILTER BASS, 180, 0.2, "LP"
        SW BASS, "CUTOFF", "SAW", 180, 600, n, b
    ENDIF
    COMMIT_PART b
    IF v = 1 THEN
        SCORE.SECTION b + 4, "intro: the kick", "groove"
        DRUMS 2
    ENDIF
    IF n >= 16 THEN
        IF v = 0 THEN
            SCORE.SECTION b + 8, "intro: the bass", "groove"
            TRK_ON BASS, BASS$
        ELSEIF v = 1 THEN
            SCORE.SECTION b + 8, "intro: the clap", "groove"
            DRUMS 3
        ELSE
            SCORE.SECTION b + 8, "intro: a teaser", "groove"
            TRK_ON PARTS_TRACK, PARTS$
            SW PARTS_TRACK, "CUTOFF", "SAW", 250, 1600, 8, b + 8
        ENDIF
    ENDIF
ENDSUB

SUB PART_GROOVE(b AS INTEGER, n AS INTEGER)
    BEGIN_PART b, "groove: bass", "shuffle"
    DRUMS 3
    TRK_ON BASS, BASS$
    IF genre$ = "acid" THEN SW BASS, "CUTOFF", "SINE", 300, 2400, 16, b
    COMMIT_PART b
    IF n >= 16 THEN
        SCORE.SECTION b + 8, "groove: the pad", "shuffle"
        TRK_ON PAD, "legato(1, " + CHORDS$ + ")"
        SW PAD, "CUTOFF", "SAW", 500, BASE_CUT[PAD], 8, b + 8
    ENDIF
ENDSUB

SUB PART_PARTS(b AS INTEGER, n AS INTEGER)
    BEGIN_PART b, "parts", "jump"
    DRUMS 3
    TRK_ON BASS, BASS$
    TRK_ON PAD, "legato(1, " + CHORDS$ + ")"
    TRK_ON PARTS_TRACK, PARTS$
    SW PARTS_TRACK, "CUTOFF", "SINE", 900, 3500, 8, b
    IF genre$ = "acid" THEN SW BASS, "CUTOFF", "SINE", 300, 2400, 16, b
    COMMIT_PART b
    CRASH_AT b
    IF n >= 16 THEN
        SCORE.SECTION b + 8, "parts: all the percussion", "jump"
        DRUMS 4
    ENDIF
ENDSUB

SUB PART_HOOK(b AS INTEGER, n AS INTEGER, fill_kind AS INTEGER)
    BEGIN_PART b, "hook", "jump"
    DRUMS 4
    TRK_ON BASS, BASS$
    TRK_ON PAD, "legato(1, " + CHORDS$ + ")"
    TRK_ON PARTS_TRACK, PARTS$
    TRK_ON LEAD, HOOK$
    COMMIT_PART b
    CRASH_AT b
    IF n >= 16 THEN
        FILL b + 7, fill_kind MOD 2, TRUE
        SCORE.SECTION b + 8, "hook, second rhythm, answered", "wave"
        TRK_ON LEAD, HOOK_B$
        TRK_ON COUNTER, COUNTER_B$
    ENDIF
ENDSUB

DIM BREAK_NAMES$ = ["the choir", "pad and hook", "no kick"]

' A breakdown on the borrowed chords; over 16 bars the second half is
' home again on the main progression
SUB PART_BREAK(b AS INTEGER, n AS INTEGER, v AS INTEGER)
    BEGIN_PART b, "breakdown: " + BREAK_NAMES$[v], "wave"
    GHOST$ = ""
    TRK_ON PAD, "legato(1, " + BREAK_CHORDS$ + ")"
    SW PAD, "CUTOFF", "SINE", 600, 2200, 8, b
    IF v = 0 THEN
        TRK_ON HATS, "gain(0.3, [~ hh]*4)"
        TRK_ON LEAD, BREAK_LINE$
        SW LEAD, "CUTOFF", "SINE", 900, 3000, 8, b
        TRK_ON CHOIR, "legato(1, add(12, " + BREAK_CHORDS$ + "))"
        SW CHOIR, "VOWEL", "TRI", 4, 0, 8, b
    ELSEIF v = 1 THEN
        TRK_ON LEAD, BREAK_LINE$
        SW LEAD, "CUTOFF", "SAW", 600, 2400, 8, b
    ELSE
        TRK_ON HATS, HATS16$
        TRK_ON PERC, LOOSE$("rim(3,8,2)")
        TRK_ON CLAP, BREAK_CLAP$
        TRK_ON PARTS_TRACK, BREAK_FIGURE$
        SW PARTS_TRACK, "CUTOFF", "SINE", 500, 2000, 8, b
    ENDIF
    COMMIT_PART b
    IF n >= 16 THEN
        SCORE.SECTION b + 8, "breakdown: home again", "wave"
        TRK_ON PAD, "legato(1, " + CHORDS$ + ")"
        IF v = 0 THEN
            TRK_ON CHOIR, "legato(1, add(12, " + CHORDS$ + "))"
            TRK_ON LEAD, "legato(1.2, " + HOOK$ + ")"
            TRK_ON PARTS_TRACK, PARTS$
            SW PARTS_TRACK, "CUTOFF", "SAW", 300, 1500, 8, b + 8
        ELSEIF v = 1 THEN
            TRK_ON LEAD, "legato(1.2, " + HOOK_B$ + ")"
            SW LEAD, "CUTOFF", "SAW", 600, 2400, 8, b + 8
        ELSE
            TRK_ON PARTS_TRACK, PARTS$
            TRK_ON LEAD, "legato(1.2, " + HOOK_B$ + ")"
            SW LEAD, "CUTOFF", "SAW", 600, 2400, 8, b + 8
        ENDIF
    ENDIF
ENDSUB

DIM BUILD_NAMES$ = ["snare roll", "kick roll", "filter"]

SUB PART_BUILD(b AS INTEGER, n AS INTEGER, v AS INTEGER, dropout AS INTEGER)
    BEGIN_PART b, "build: " + BUILD_NAMES$[v], "rise"
    TRK_ON PAD, "legato(1, " + CHORDS$ + ")"
    TRK_ON PARTS_TRACK, PARTS$
    SW PARTS_TRACK, "CUTOFF", "SAW", 500, 6000, n, b
    TRK_ON RISER, "legato(1, c4)"
    SW RISER, "CUTOFF", "SAW", 400, 7000, n, b
    SW RISER, "GAIN", "SAW", 0, 0.2, n, b
    IF v = 0 THEN
        TRK_ON SNARE, "gain(<0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65>, <sd*4 sd*4 sd*8 sd*8 sd*8 sd*16 sd*16 [sd*16 ~]>)"
        TRK_ON KICK, "<bd*4 bd*4 bd*4 bd*4 bd*8 bd*8 ~ ~>"
    ELSEIF v = 1 THEN
        TRK_ON KICK, "gain(<0.7 0.7 0.75 0.8 0.85 0.9 0.95 1>, <bd*4 bd*4 bd*4 bd*4 bd*8 bd*8 bd*16 [bd*16 ~]>)"
        TRK_ON CLAP, "~ cp ~ cp"
        TRK_ON HATS, HATS16$
    ELSE
        TRK_ON KICK, "bd*4"
        TRK_ON HATS, HATS16$
        TRK_ON CLAP, "<[~ cp ~ cp]!6 cp*8 cp*16>"
        TRK_ON BASS, BASS$
        SW BASS, "CUTOFF", "ISAW", 150, MIN([BASE_CUT[BASS], 2000]), n, b
    ENDIF
    COMMIT_PART b
    SCORE.SECTION b + n - 2, "build: up an octave", "rise"
    TRK_ON PARTS_TRACK, "add(12, " + PARTS$ + ")"
    IF dropout THEN
        SCORE.SECTION b + n - 1, "build: one bar without drums", "rise"
        DIM t AS INTEGER
        FOR t = 0 TO N_TRACKS - 1
            IF t <> RISER AND t <> PAD THEN TRK_OFF t
        NEXT t
    ENDIF
ENDSUB

' A drop in 8-bar blocks that swap the two hooks. The peak (the last
' drop) adds the choir and all the percussion; at its lift the music goes
' up a key, the hook plays its variation and the answer joins. The lift
' comes at the start of a last drop that follows another, half way into
' a lone 16-bar drop and at bar 16 of a double drop.
SUB PART_DROP(b AS INTEGER, n AS INTEGER, v AS INTEGER, peak AS INTEGER, earlier AS INTEGER, fill_kind AS INTEGER)
    DIM hooks$ = [HOOK$, HOOK_B$]
    DIM varied$ = [VARIED_A$, VARIED_B$]
    DIM answers$ = [COUNTER_A$, COUNTER_B$]
    DIM lift_at AS INTEGER = n
    IF peak THEN
        lift_at = 8
        IF n >= 32 THEN
            lift_at = 16
        ELSEIF earlier > 0 THEN
            lift_at = 0
        ENDIF
    ENDIF
    BEGIN_PART b, "drop", "jump"
    DIM k AS INTEGER
    FOR k = 0 TO n - 8 STEP 8
        DIM h AS INTEGER = (v + INT(k / 8)) MOD 2
        IF k > 0 THEN
            FILL b + k - 1, (fill_kind + INT(k / 8)) MOD 2, TRUE
            IF k = lift_at THEN
                SCORE.SECTION b + k, "drop: up a key", "jump"
            ELSEIF k = 16 THEN
                SCORE.SECTION b + k, "drop: the peak", "jump"
            ELSE
                SCORE.SECTION b + k, "drop, the other rhythm", "jump"
            ENDIF
        ELSEIF lift_at = 0 THEN
            SCORE.SECTION b, "drop: up a key", "jump"
        ENDIF
        IF k = lift_at THEN CUR_LIFT = LIFT
        DIM level AS INTEGER = 4
        IF peak AND (n < 32 OR k >= 16) THEN level = 5
        DRUMS level
        TRK_ON BASS, LIFTED$(BASS$)
        TRK_ON PAD, LIFTED$("legato(1, " + CHORDS$ + ")")
        TRK_ON PARTS_TRACK, LIFTED$(PARTS$)
        IF k = 0 THEN SW PARTS_TRACK, "CUTOFF", "SINE", 900, 3500, 8, b
        IF k >= lift_at THEN
            IF VARY_KIND$ = "octave" THEN
                TRK_ON LEAD, LIFTED$(varied$[h])
            ELSE
                TRK_ON LEAD, "juxBy(0.4, add(12), " + LIFTED$(varied$[h]) + ")"
            ENDIF
            TRK_ON COUNTER, LIFTED$(answers$[h])
        ELSE
            TRK_ON LEAD, "juxBy(0.4, add(12), " + LIFTED$(hooks$[h]) + ")"
            ' the second hook comes with its answer in every drop
            IF h = 1 THEN
                TRK_ON COUNTER, LIFTED$(answers$[h])
            ELSE
                TRK_OFF COUNTER
            ENDIF
        ENDIF
        IF level = 5 THEN
            TRK_ON CHOIR, LIFTED$("legato(1, add(12, " + CHORDS$ + "))")
            SOUND.FORMANT CHOIR, "ah", 1.0, 0.08
        ENDIF
        IF k = 0 THEN COMMIT_PART b
        IF k = 0 OR k = 16 OR k = lift_at THEN CRASH_AT b + k
    NEXT k
ENDSUB

SUB PART_OUTRO(b AS INTEGER, n AS INTEGER)
    BEGIN_PART b, "outro", "groove"
    DRUMS 3
    TRK_ON BASS, LIFTED$(BASS$)
    TRK_ON PARTS_TRACK, LIFTED$(PARTS$)
    SW PARTS_TRACK, "CUTOFF", "ISAW", 300, 3000, 8, b
    COMMIT_PART b
    IF n >= 16 THEN
        SCORE.SECTION b + 8, "outro: drums", "groove"
        DRUMS 2
        TRK_OFF PARTS_TRACK
        TRK_OFF BASS
    ENDIF
ENDSUB

SUB PART_END(b AS INTEGER)
    BEGIN_PART b, "end", "bye"
    COMMIT_PART b
ENDSUB

' ── The form ─────────────────────────────────────────────────────
' Three forms per genre; parts are 8, 16 or 32 bars, so every part
' starts on a bar the 4-bar progression starts on

DIM FORM_NO AS INTEGER = 0
DIM N_FORMS AS INTEGER = 3
DIM N_PARTS AS INTEGER = 0
DIM LAST_DROP AS INTEGER = -1
' the parts as the form lays them out: name, first bar, bars, label
DIM PART_NAMES$ = [""]
DIM PART_START = [0]
DIM PART_LEN = [0]
DIM PART_LABEL$ = [""]
DIM SONG_BARS AS INTEGER = 0

SUB ARRANGE()
    DIM forms$ = []
    IF genre$ = "trance" THEN
        forms$ = ["intro:16 groove:8 parts:8 hook:16 break:16 build:8 drop:16 drop:16 outro:16", "intro:8 groove:8 parts:16 hook:16 break:8 build:8 drop:16 break:8 build:8 drop:16 outro:8", "intro:16 parts:16 hook:16 break:16 build:8 drop:32 outro:8"]
    ELSEIF genre$ = "house" THEN
        forms$ = ["intro:16 groove:16 hook:16 break:8 build:8 drop:16 outro:16", "intro:8 groove:8 parts:8 hook:16 break:8 build:8 drop:16 break:8 drop:16 outro:8", "intro:16 groove:8 hook:16 drop:16 break:8 build:8 drop:16 outro:8"]
    ELSEIF genre$ = "deep" THEN
        forms$ = ["intro:16 groove:16 parts:16 hook:16 break:8 drop:16 outro:16", "intro:16 groove:8 parts:8 hook:16 break:16 build:8 drop:16 outro:16", "intro:8 groove:16 hook:16 break:8 hook:16 outro:16"]
    ELSEIF genre$ = "synthwave" THEN
        forms$ = ["intro:8 groove:16 hook:16 break:8 build:8 drop:16 outro:16", "intro:16 groove:8 parts:8 hook:16 break:16 drop:16 drop:16 outro:8", "intro:8 groove:16 hook:16 parts:8 hook:16 break:8 build:8 drop:16 outro:16"]
    ELSE
        forms$ = ["intro:16 groove:16 parts:8 hook:16 break:8 build:8 drop:16 outro:8", "intro:8 groove:16 hook:16 break:8 build:8 drop:32 outro:8", "intro:16 groove:8 parts:8 hook:8 break:8 build:8 drop:16 break:8 build:8 drop:16 outro:8"]
    ENDIF
    N_FORMS = LEN(forms$)
    FORM_NO = PICK(8, N_FORMS)
    DIM form$ = SPLIT(forms$[FORM_NO], " ")
    N_PARTS = LEN(form$)
    PART_NAMES$ = []
    PART_START = []
    PART_LEN = []
    PART_LABEL$ = []
    DIM fi AS INTEGER
    LAST_DROP = -1
    FOR fi = 0 TO N_PARTS - 1
        DIM colon AS INTEGER = INSTR(form$[fi], ":")
        PART_NAMES$ = APPEND(PART_NAMES$, LEFT$(form$[fi], colon))
        PART_LEN = APPEND(PART_LEN, VAL(MID$(form$[fi], colon + 1)))
        IF PART_NAMES$[fi] = "drop" THEN LAST_DROP = fi
    NEXT fi

    DIM bar_at AS INTEGER = 0
    DIM form_lines$ AS STRING = ""
    DIM drops_done AS INTEGER = 0
    FOR fi = 0 TO N_PARTS - 1
        DIM part$ AS STRING = PART_NAMES$[fi]
        DIM nb AS INTEGER = PART_LEN[fi]
        NEXT_PART$ = "end"
        IF fi < N_PARTS - 1 THEN NEXT_PART$ = PART_NAMES$[fi + 1]
        PARTS$ = FIGURES$[PICK_PART(fi, 60, 3)]
        PICK_GROOVE fi
        DIM fill_kind AS INTEGER = PICK_PART(fi, 40, 3)
        ' synthwave fills with toms or a gap, never the snare
        IF genre$ = "synthwave" THEN fill_kind = 1 + PICK_PART(fi, 40, 2)
        DIM label$ AS STRING = part$ + STR$(nb)
        IF part$ = "intro" THEN
            PART_INTRO bar_at, nb, INTRO
        ELSEIF part$ = "groove" THEN
            PART_GROOVE bar_at, nb
        ELSEIF part$ = "parts" THEN
            PART_PARTS bar_at, nb
        ELSEIF part$ = "hook" THEN
            PART_HOOK bar_at, nb, fill_kind
        ELSEIF part$ = "break" THEN
            DIM bv AS INTEGER = 1 + PICK_PART(fi, 20, 2)
            IF nb >= 16 THEN bv = 2 * PICK_PART(fi, 20, 2)
            PART_BREAK bar_at, nb, bv
            label$ = label$ + " (" + BREAK_NAMES$[bv] + ")"
        ELSEIF part$ = "build" THEN
            DIM uv AS INTEGER = PICK_PART(fi, 20, 3)
            IF genre$ = "synthwave" AND uv = 1 THEN uv = 2
            DIM dropout AS INTEGER = PICK_PART(fi, 30, 2)
            PART_BUILD bar_at, nb, uv, dropout
            label$ = label$ + " (" + BUILD_NAMES$[uv]
            IF dropout THEN label$ = label$ + ", a bar without drums"
            label$ = label$ + ")"
        ELSEIF part$ = "drop" THEN
            DIM dv AS INTEGER = PICK_PART(fi, 20, 2)
            PART_DROP bar_at, nb, dv, fi = LAST_DROP, drops_done, fill_kind
            drops_done = drops_done + 1
            IF fi = LAST_DROP THEN label$ = label$ + " (peak, up a key)"
        ELSE
            PART_OUTRO bar_at, nb
        ENDIF
        ' a fill closes every phrase that does not lead into a build
        IF part$ <> "build" AND part$ <> "outro" AND NEXT_PART$ <> "build" THEN
            FILL bar_at + nb - 1, fill_kind, FALSE
            label$ = label$ + " [" + FILL_NAMES$[fill_kind] + "]"
        ENDIF
        IF part$ = "break" THEN label$ = label$ + " {" + BREAK_PROG$ + "}"
        form_lines$ = form_lines$ + "    " + STR$(bar_at) + " " + label$ + NL$
        PART_START = APPEND(PART_START, bar_at)
        PART_LABEL$ = APPEND(PART_LABEL$, label$)
        bar_at = bar_at + nb
    NEXT fi
    PART_END bar_at
    SONG_BARS = bar_at
    SCORE.FINE bar_at + 2

    RECIPE$ = RECIPE$ + "  form " + STR$(FORM_NO + 1) + " of " + STR$(N_FORMS) + ", " + STR$(bar_at) + " bars:" + NL$ + form_lines$
    IF LAST_DROP >= 0 THEN RECIPE$ = RECIPE$ + "  last drop: up " + STR$(LIFT) + " semitone(s), the hook " + VARY_KIND$ + ", answered below" + NL$
ENDSUB

' The whole song for genre$ and seed: recipe, sounds, arrangement
SUB BUILD()
    MAKE_RECIPE
    SETUP_SOUND
    RESET_ARRANGEMENT
    ARRANGE
ENDSUB

' when and from which cycle the song was last written, to tell a clock
' that runs ahead of the wall clock
DIM BUILT_TICK AS DOUBLE = 0
DIM BUILT_CYCLE AS DOUBLE = 0

' Writes the song again while the old one plays: from bar b on, or on
' from where it plays for b below 0
SUB REBUILD(b AS DOUBLE)
    IF b < 0 THEN
        SOUND.SEEK
    ELSE
        SOUND.SEEK b
    ENDIF
    SCORE.CLEAR
    BUILD
    BUILT_TICK = TICK()
    BUILT_CYCLE = SOUND.CYCLE()
    PUBLISH_SCORE
ENDSUB

' ── Live desk ────────────────────────────────────────────────────
' --live: the song plays in a window with a strip per track (meter,
' mute, solo), the form as a row of parts to click, and buttons for the
' seed, the genre and a reroll of the part that plays. Each change
' writes the song again while it plays (REBUILD).

DIM DESK_W AS INTEGER = 1280
DIM DESK_H AS INTEGER = 760
DIM desk_font$ AS STRING = ""
DIM MUTED = RESHAPE([0], [16])
DIM SOLOED = RESHAPE([0], [16])
DIM SHOWN = RESHAPE([0.0], [16])
DIM MX AS DOUBLE = 0
DIM MY AS DOUBLE = 0
DIM CLICKED AS INTEGER = FALSE
DIM mouse_was AS INTEGER = FALSE
DIM desk_closed AS INTEGER = FALSE
DIM KEY_LIST$ = ["Left", "Right", "G", "R", "Escape", "1", "2", "3", "4", "5", "6", "7", "8", "9", "V"]
DIM KEY_PREV = RESHAPE([0], [15])
DIM status$ AS STRING = ""
DIM status_at AS DOUBLE = 0

SUB DESK_FONT(size AS INTEGER)
    IF desk_font$ <> "" THEN SETFONT desk_font$, size
ENDSUB

' TRUE on the frame key i of KEY_LIST$ goes down
FUNC KEY_HIT(i AS INTEGER) AS INTEGER
    DIM down AS INTEGER = GFX.KEYSTATE(KEY_LIST$[i])
    DIM hit AS INTEGER = down ANDALSO KEY_PREV[i] = 0
    KEY_PREV[i] = down
    RETURN hit
ENDFUNC

FUNC INSIDE(x AS DOUBLE, y AS DOUBLE, w AS DOUBLE, h AS DOUBLE) AS INTEGER
    RETURN MX >= x ANDALSO MX < x + w ANDALSO MY >= y ANDALSO MY < y + h
ENDFUNC

' Draws a button; TRUE when it was clicked this frame
FUNC BUTTON(x AS DOUBLE, y AS DOUBLE, w AS DOUBLE, h AS DOUBLE, caption$, lit AS INTEGER) AS INTEGER
    DIM over AS INTEGER = INSIDE(x, y, w, h)
    IF lit THEN
        DRAWCOLOR 240, 190, 60
    ELSEIF over THEN
        DRAWCOLOR 70, 80, 110
    ELSE
        DRAWCOLOR 45, 50, 70
    ENDIF
    RECT x, y, w, h, TRUE
    DRAWCOLOR 90, 100, 140
    RECT x, y, w, h, FALSE
    DIM tsz = GFX.TEXTSIZE(caption$)
    IF lit THEN
        TEXT x + (w - tsz[0]) / 2, y + (h - tsz[1]) / 2, caption$, 20, 20, 30
    ELSE
        TEXT x + (w - tsz[0]) / 2, y + (h - tsz[1]) / 2, caption$, 220, 225, 240
    ENDIF
    RETURN over ANDALSO CLICKED
ENDFUNC

FUNC PART_RGB(name$)
    IF name$ = "intro" THEN RETURN [60, 90, 140]
    IF name$ = "groove" THEN RETURN [50, 120, 115]
    IF name$ = "parts" THEN RETURN [80, 120, 60]
    IF name$ = "hook" THEN RETURN [160, 115, 40]
    IF name$ = "break" THEN RETURN [110, 70, 150]
    IF name$ = "build" THEN RETURN [165, 85, 55]
    IF name$ = "drop" THEN RETURN [190, 50, 95]
    RETURN [70, 80, 110]
ENDFUNC

SUB APPLY_MUTES()
    DIM any_solo AS INTEGER = SUM(SOLOED) > 0
    DIM t AS INTEGER
    FOR t = 0 TO N_TRACKS - 1
        SOUND.MUTE t, (MUTED[t] = 1) OR (any_solo ANDALSO SOLOED[t] = 0)
    NEXT t
ENDSUB

SUB SAY(s$)
    status$ = s$
    status_at = TICK()
    PRINT s$
    IF bus_on THEN CHAN.SEND pub_log, s$
ENDSUB

' A new song (seed or genre changed) from its first bar
SUB NEW_SONG()
    PART_SALT = RESHAPE([0], [32])
    REBUILD 0
    DIM fresh = SOUND.LOUDNESS(TRUE)
    PRINT RECIPE$;
ENDSUB

' The part that plays at cycle cyc
FUNC PART_AT(cyc AS DOUBLE) AS INTEGER
    DIM i AS INTEGER
    DIM found AS INTEGER = 0
    FOR i = 0 TO N_PARTS - 1
        IF PART_START[i] <= cyc THEN found = i
    NEXT i
    RETURN found
ENDFUNC

SUB DRAW_HEADER()
    DESK_FONT 30
    TEXT 20, 14, TITLE$, 255, 230, 250
    DESK_FONT 15
    DIM info$ AS STRING = genre$ + "  |  " + KEY$ + "  |  " + STR$(BPM) + " BPM  |  seed " + STR$(seed) + "  |  " + PROG_NAME$ + ": " + PROG$
    TEXT 20, 56, info$, 170, 180, 210
    DIM meter = SOUND.LOUDNESS()
    DIM loud$ AS STRING = "LUFS  M " + FORMAT$("{:.1f}", meter{"MOMENTARY"}) + "   S " + FORMAT$("{:.1f}", meter{"SHORT"}) + "   I " + FORMAT$("{:.1f}", meter{"INTEGRATED"})
    TEXT 860, 18, loud$, 200, 210, 230
    DIM gr AS DOUBLE = -meter{"REDUCTION"}
    TEXT 860, 46, "LIMITER", 150, 160, 190
    DRAWCOLOR 40, 44, 60
    RECT 940, 48, 300, 12, TRUE
    DRAWCOLOR 240, 120, 60
    RECT 940, 48, 300 * MIN([gr / 8, 1]), 12, TRUE
ENDSUB

' The form as a row of parts; a click jumps to a part
SUB DRAW_FORM(cyc AS DOUBLE, cur AS INTEGER)
    DIM x0 AS DOUBLE = 20
    DIM full AS DOUBLE = DESK_W - 40
    DIM y0 AS DOUBLE = 96
    DIM h AS DOUBLE = 64
    DIM i AS INTEGER
    DIM jump_to AS INTEGER = -1
    DESK_FONT 14
    FOR i = 0 TO N_PARTS - 1
        DIM px AS DOUBLE = x0 + PART_START[i] / SONG_BARS * full
        DIM pw AS DOUBLE = PART_LEN[i] / SONG_BARS * full - 3
        DIM rgb = PART_RGB(PART_NAMES$[i])
        DIM shade AS DOUBLE = 0.75
        IF i = cur THEN shade = 1.15
        IF INSIDE(px, y0, pw, h) THEN
            shade = shade + 0.2
            IF CLICKED THEN jump_to = i
        ENDIF
        DRAWCOLOR MIN([255, INT(rgb[0] * shade)]), MIN([255, INT(rgb[1] * shade)]), MIN([255, INT(rgb[2] * shade)])
        RECT px, y0, pw, h, TRUE
        IF i = cur THEN
            DRAWCOLOR 255, 255, 255
            RECT px, y0, pw, h, FALSE
        ENDIF
        DIM cap$ AS STRING = PART_NAMES$[i]
        DIM cap_size = GFX.TEXTSIZE(cap$)
        IF cap_size[0] < pw - 6 THEN TEXT px + 5, y0 + 6, cap$, 240, 240, 250
        IF i < 9 ANDALSO pw > 24 THEN TEXT px + 5, y0 + h - 22, STR$(i + 1), 200, 200, 220
    NEXT i
    DIM head_x AS DOUBLE = x0 + MIN([cyc, SONG_BARS]) / SONG_BARS * full
    DRAWCOLOR 255, 255, 255
    RECT head_x - 1, y0 - 6, 3, h + 12, TRUE
    DESK_FONT 15
    TEXT 20, y0 + h + 10, "bar " + STR$(INT(cyc)) + " of " + STR$(SONG_BARS) + "   " + PART_LABEL$[cur], 210, 215, 235
    IF jump_to >= 0 THEN
        REBUILD PART_START[jump_to]
        SAY "jump to " + PART_LABEL$[jump_to]
    ENDIF
ENDSUB

' A strip per track: name, meter, mute, solo
SUB DRAW_STRIPS(cyc AS DOUBLE)
    DIM levels = SOUND.LEVELS()
    DIM playing = SCORE.LIVE_AT(cyc)
    DIM changed AS INTEGER = FALSE
    DIM t AS INTEGER
    DESK_FONT 15
    FOR t = 0 TO N_TRACKS - 1
        DIM col AS INTEGER = t \ 8
        DIM row AS INTEGER = t MOD 8
        DIM sx AS DOUBLE = 20 + col * 630
        DIM sy AS DOUBLE = 200 + row * 50
        SHOWN[t] = MAX([levels[t], SHOWN[t] * 0.86])
        DRAWCOLOR 28, 30, 44
        RECT sx, sy, 610, 42, TRUE
        IF playing[t] = 1 THEN
            TEXT sx + 12, sy + 11, TRACK_NAMES$[t], 235, 235, 250
        ELSE
            TEXT sx + 12, sy + 11, TRACK_NAMES$[t], 110, 115, 140
        ENDIF
        DIM db AS DOUBLE = -60
        IF SHOWN[t] > 0.000001 THEN db = 20 * LOG(SHOWN[t]) / LOG(10)
        DIM frac AS DOUBLE = MAX([0, MIN([1, (db + 48) / 48])])
        DRAWCOLOR 40, 44, 60
        RECT sx + 120, sy + 14, 340, 14, TRUE
        IF MUTED[t] = 1 OR (SUM(SOLOED) > 0 ANDALSO SOLOED[t] = 0) THEN
            DRAWCOLOR 90, 95, 110
        ELSEIF frac > 0.9 THEN
            DRAWCOLOR 240, 80, 70
        ELSEIF frac > 0.75 THEN
            DRAWCOLOR 240, 200, 70
        ELSE
            DRAWCOLOR 80, 210, 140
        ENDIF
        RECT sx + 120, sy + 14, 340 * frac, 14, TRUE
        IF BUTTON(sx + 480, sy + 7, 56, 28, "M", MUTED[t] = 1) THEN
            MUTED[t] = 1 - MUTED[t]
            changed = TRUE
        ENDIF
        IF BUTTON(sx + 544, sy + 7, 56, 28, "S", SOLOED[t] = 1) THEN
            SOLOED[t] = 1 - SOLOED[t]
            changed = TRUE
        ENDIF
    NEXT t
    IF changed THEN APPLY_MUTES
ENDSUB

SUB NEXT_SEED(delta AS INTEGER)
    seed = MAX([1, seed + delta])
    NEW_SONG
    SAY "seed " + STR$(seed) + ": " + TITLE$
ENDSUB

SUB NEXT_GENRE()
    GENRE_NO = (GENRE_NO + 1) MOD LEN(GENRES$)
    genre$ = GENRES$[GENRE_NO]
    NEW_SONG
    SAY genre$ + ": " + TITLE$
ENDSUB

SUB REROLL(cur AS INTEGER)
    IF cur >= N_PARTS THEN RETURN
    PART_SALT[cur] = PART_SALT[cur] + 1
    REBUILD -1
    SAY "rerolled " + PART_LABEL$[cur]
ENDSUB

SUB DRAW_CONTROLS(cur AS INTEGER)
    DIM y0 AS DOUBLE = 620
    DIM reroll$ AS STRING = "reroll " + PART_NAMES$[MIN([cur, N_PARTS - 1])]
    DESK_FONT 15
    IF BUTTON(20, y0, 120, 40, "< seed", FALSE) THEN NEXT_SEED -1
    IF BUTTON(150, y0, 120, 40, "seed >", FALSE) THEN NEXT_SEED 1
    IF BUTTON(280, y0, 240, 40, "genre: " + genre$ + " >", FALSE) THEN NEXT_GENRE
    IF BUTTON(530, y0, 200, 40, reroll$, FALSE) THEN REROLL cur
    IF BUTTON(740, y0, 160, 40, "clear mutes", FALSE) THEN
        MUTED = RESHAPE([0], [16])
        SOLOED = RESHAPE([0], [16])
        APPLY_MUTES
    ENDIF
    TEXT 20, y0 + 56, "Left/Right seed   G genre   R reroll the part   1-9 jump to a part   click a part to jump   V show   Esc quit", 140, 150, 180
    IF status$ <> "" ANDALSO TICK() - status_at < 4000 THEN TEXT 20, y0 + 86, status$, 240, 200, 120
ENDSUB

' ── Node Bus ─────────────────────────────────────────────────────
' The desk joins as "songgen" and publishes what a show in another
' process needs: song/score (the structure, after each build), song/clock
' (when which cycle is heard), song/scope, song/levels and song/log. It
' serves JUMP part, REROLL, SEED n, GENRE g$ and MUTE [track, flag].

DIM bus_on AS INTEGER = FALSE
DIM pub_score = NONE
DIM pub_clock = NONE
DIM pub_scope = NONE
DIM pub_levels = NONE
DIM pub_log = NONE
DIM epoch AS INTEGER = 0
DIM show_pid AS INTEGER = 0

FUNC SUBTITLE_OF$() AS STRING
    RETURN UCASE$(LEFT$(genre$, 1)) + MID$(genre$, 1) + " in " + KEY$ + ", seed " + STR$(seed)
ENDFUNC

SUB PUBLISH_CLOCK()
    DIM anchor = SOUND.CLOCK()
    anchor{"EPOCH"} = epoch
    CHAN.SEND pub_clock, anchor
ENDSUB

' A new structure: the show reloads it and jumps to the new clock
SUB PUBLISH_SCORE()
    IF NOT bus_on THEN RETURN
    epoch = epoch + 1
    CHAN.SEND pub_score, {"SCORE": SCORE.SNAPSHOT(), "TITLE": TITLE$, "SUBTITLE": SUBTITLE_OF$(), "GENRE": genre$, "SEED": seed, "KEY": KEY$, "EPOCH": epoch}
    PUBLISH_CLOCK
ENDSUB

' What the show draws from, sent only while someone listens
SUB PUBLISH_FRAME()
    PUBLISH_CLOCK
    IF TOPIC.STATS(pub_scope){"SUBSCRIBERS"} > 0 THEN
        CHAN.SEND pub_scope, {"T": NODE.TIME(), "MASTER": SOUND.GET_WAVE(), "BUS0": SOUND.GET_BUS_WAVE(0)}
    ENDIF
    IF TOPIC.STATS(pub_levels){"SUBSCRIBERS"} > 0 THEN
        CHAN.SEND pub_levels, {"LEVELS": SHOWN, "MUTED": MUTED, "SOLOED": SOLOED, "LOUDNESS": SOUND.LOUDNESS()}
    ENDIF
ENDSUB

FUNC H_JUMP(c)
    DIM part AS INTEGER = CINT(c{"ARG"})
    IF part < 0 OR part >= N_PARTS THEN RETURN "no part " + STR$(part)
    REBUILD PART_START[part]
    SAY "jump to " + PART_LABEL$[part]
    RETURN PART_LABEL$[part]
ENDFUNC

FUNC H_REROLL(c)
    DIM cur AS INTEGER = PART_AT(SOUND.CYCLE())
    REROLL cur
    RETURN PART_LABEL$[cur]
ENDFUNC

FUNC H_SEED(c)
    NEXT_SEED CINT(c{"ARG"}) - seed
    RETURN TITLE$
ENDFUNC

FUNC H_GENRE(c)
    DIM g AS INTEGER
    FOR g = 0 TO LEN(GENRES$) - 1
        IF GENRES$[g] = LCASE$(c{"ARG"}) THEN
            GENRE_NO = (g + LEN(GENRES$) - 1) MOD LEN(GENRES$)
            NEXT_GENRE
            RETURN TITLE$
        ENDIF
    NEXT g
    RETURN "unknown genre " + c{"ARG"}
ENDFUNC

FUNC H_MUTE(c)
    DIM t AS INTEGER = CINT(c{"ARG"}[0])
    IF t < 0 OR t >= N_TRACKS THEN RETURN FALSE
    MUTED[t] = IIF(c{"ARG"}[1], 1, 0)
    APPLY_MUTES
    RETURN TRUE
ENDFUNC

SUB BUS_OPEN()
    IF NOT OS.FEATURE("NET") THEN RETURN
    IF LEN(NODE.PEERS("songgen")) > 0 THEN
        PRINT "songgen: another songgen is on the Node Bus; this desk publishes nothing"
        RETURN
    ENDIF
    DIM self_node = NODE.JOIN("songgen", IIF(lan_mode, "lan", "local"))
    pub_score = TOPIC.OPEN("song/score")
    TOPIC.RETAIN pub_score, TRUE
    pub_clock = TOPIC.OPEN("song/clock")
    TOPIC.RETAIN pub_clock, TRUE
    pub_scope = TOPIC.OPEN("song/scope")
    pub_levels = TOPIC.OPEN("song/levels")
    pub_log = TOPIC.OPEN("song/log")
    NODE.SERVE "JUMP", "H_JUMP"
    NODE.SERVE "REROLL", "H_REROLL"
    NODE.SERVE "SEED", "H_SEED"
    NODE.SERVE "GENRE", "H_GENRE"
    NODE.SERVE "MUTE", "H_MUTE"
    bus_on = TRUE
    PUBLISH_SCORE
ENDSUB

' Starts stage.jdb --follow in a window of its own
SUB START_SHOW()
    IF NOT bus_on THEN RETURN
    IF show_pid > 0 ANDALSO OS.ALIVE(show_pid) THEN RETURN
    IF NOT OS.FEATURE("INTERPRETER") THEN
        SAY "the show needs the interpreter: jdBasic stage.jdb --follow"
        RETURN
    ENDIF
    DIM stage_path$ AS STRING = PATH.JOIN$(PATH.DIRNAME$(PATH.ABS$(cli[0])), "stage.jdb")
    ' fullscreen on the first display the desk is not on, else a window
    DIM show_args = [stage_path$, "--follow", "songgen", "--window"]
    DIM displays = GFX.DISPLAYS()
    DIM di AS INTEGER
    FOR di = 0 TO LEN(displays) - 1
        IF NOT displays[di]{"PRIMARY"} THEN
            show_args = [stage_path$, "--follow", "songgen", "--display", STR$(displays[di]{"INDEX"})]
            EXITFOR
        ENDIF
    NEXT di
    show_pid = OS.SPAWN(OS.SELF$(), show_args)
    SAY "show started"
ENDSUB

SUB DESK_QUIT(info)
    desk_closed = TRUE
ENDSUB

SUB DESK_RUN()
    SCREEN DESK_W, DESK_H, "songgen live"
    ON "QUIT" CALL DESK_QUIT
    DIM font_try$ = ["jdbasic_default.ttf", "/jdbasic_default.ttf", "build/jdbasic_default.ttf", "../../../build/jdbasic_default.ttf"]
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(font_try$) - 1
        IF desk_font$ = "" THEN
            TRY
                SETFONT font_try$[fi], 15
                desk_font$ = font_try$[fi]
            CATCH
            ENDTRY
        ENDIF
    NEXT fi
    DIM fresh = SOUND.LOUDNESS(TRUE)
    BUS_OPEN
    IF stage_mode THEN START_SHOW
    DIM next_frame AS DOUBLE = TICK()
    DIM started AS DOUBLE = TICK()
    DIM n_desk AS INTEGER = 0
    DIM desk_ms AS DOUBLE = 0
    DO
        DIM frame_t0 AS DOUBLE = TICK()
        DIM cyc AS DOUBLE = SOUND.CYCLE()
        IF cyc >= SONG_BARS + 2 THEN
            DIM real_ms AS DOUBLE = TICK() - BUILT_TICK
            DIM song_ms AS DOUBLE = (cyc - BUILT_CYCLE) * 240000 / BPM
            IF real_ms < song_ms / 2 THEN
                PRINT "songgen: the sound clock ran ahead: "; INT(song_ms); " ms of song in "; INT(real_ms); " ms, the song starts again"
                REBUILD 0
            ELSE
                NEXT_SEED 1 + (INT(NOW_EPOCH()) * 7 + INT(TICK())) MOD 99999 - seed
            ENDIF
            cyc = 0
        ENDIF
        MX = GFX.MOUSEX()
        MY = GFX.MOUSEY()
        DIM down AS INTEGER = GFX.MOUSEBUTTON(1)
        CLICKED = down ANDALSO mouse_was = 0
        mouse_was = down
        DIM cur AS INTEGER = PART_AT(cyc)

        DRAWCOLOR 16, 17, 26
        RECT 0, 0, DESK_W, DESK_H, TRUE
        DRAW_HEADER
        DRAW_FORM cyc, cur
        DRAW_STRIPS cyc
        DRAW_CONTROLS cur
        IF shot$ <> "" ANDALSO TICK() - started > shot_after * 1000 THEN
            GFX.SAVE_SCREENSHOT shot$
            EXITDO
        ENDIF
        SCREENFLIP
        IF desk_closed THEN EXITDO

        IF bus_on THEN
            DIM served = NODE.POLL()
            PUBLISH_FRAME
        ENDIF

        IF KEY_HIT(0) THEN NEXT_SEED -1
        IF KEY_HIT(1) THEN NEXT_SEED 1
        IF KEY_HIT(2) THEN NEXT_GENRE
        IF KEY_HIT(3) THEN REROLL cur
        IF KEY_HIT(4) THEN EXITDO
        IF KEY_HIT(14) THEN START_SHOW
        DIM k AS INTEGER
        FOR k = 5 TO 13
            IF KEY_HIT(k) ANDALSO k - 5 < N_PARTS THEN
                REBUILD PART_START[k - 5]
                SAY "jump to " + PART_LABEL$[k - 5]
            ENDIF
        NEXT k

        n_desk = n_desk + 1
        desk_ms = desk_ms + TICK() - frame_t0
        DIM wait_ms AS DOUBLE = next_frame - TICK()
        IF wait_ms > 1 THEN SLEEP INT(wait_ms)
        next_frame = MAX([next_frame + 1000 / 50, TICK()])
    LOOP
    PRINT "desk: "; n_desk; " frames, "; FORMAT$("{:.2f}", desk_ms / MAX([1, n_desk])); " ms of work each"
    IF bus_on THEN NODE.LEAVE
    SOUND.RESET
ENDSUB

' ── Main ─────────────────────────────────────────────────────────

IF LEN(wav$) > 0 OR recipe_only THEN
    SOUND.INIT "PULL"
ELSE
    SOUND.INIT SCORE.AUDIO_MODE$()
ENDIF
INIT_SOUND
BUILD
PRINT RECIPE$;

IF recipe_only THEN
    END
ELSEIF LEN(wav$) > 0 THEN
    SOUND.RECORD wav$
    DIM total AS INTEGER = INT(SCORE.END_BAR() * 4 * 60 / BPM * 44100)
    DIM done AS INTEGER = 0
    WHILE done < total
        DIM buf = SOUND.RENDER(4410)
        done = done + 4410
    WEND
    SOUND.RECORD
    DIM meter = SOUND.LOUDNESS()
    PRINT "wrote "; wav$; ", "; FORMAT$("{:.1f}", meter{"INTEGRATED"}); " LUFS, loudest 3 s ";
    PRINT FORMAT$("{:.1f}", meter{"SHORT_MAX"}); " LUFS, peak "; FORMAT$("{:.1f}", meter{"PEAK"}); " dB, limiter up to "; FORMAT$("{:.1f}", -meter{"REDUCTION_MAX"}); " dB"
ELSEIF live_mode THEN
    DESK_RUN
ELSE
    STAGE.SUBTITLE UCASE$(LEFT$(genre$, 1)) + MID$(genre$, 1) + " in " + KEY$ + ", seed " + STR$(seed)
    STAGE.RUN TITLE$
ENDIF
