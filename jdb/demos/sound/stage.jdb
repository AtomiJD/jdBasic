' stage.jdb - a fullscreen show for a song written with SCORE: two
' neon dancers, the master scope and reverb bus, an FFT skyline, the
' live SOUND.MOD curves, beat-locked effects and a console window.
'
'   STAGE.RUN "Kaiku in A minor"
'
' plays the queued score until SCORE.END_BAR() and returns. Everything
' on screen follows SOUND.CYCLE(), the master scope and the log SCORE
' keeps. The effects look for tracks named KICK, CLAP and CRASH.
'
' Each section's mood picks the dance: groove, shuffle, jump, wave,
' rise, robot, pan, bye. jump also brings the lasers and sparks, wave
' the hearts, rise the strobe towards the end of the section.
'
'   F    toggle fullscreen        Esc  quit        Q  quit with status 3
'   --window       a half-size window instead of fullscreen
'   --display n    opens on display n of GFX.DISPLAYS()
'   --shots dir    a frame of every section saved into dir (implies --window)
'   --render dir   an offline render: an intro with the series title and
'                  3-2-1, then every frame as dir/fNNNNN.jpg at 30 fps and the
'                  sound as dir/audio.wav, starting after the intro
'   --tiktok       portrait 1080x1920 with the girl alone, a new move every
'                  two bars; with --render only the clip around the first
'                  drop (at most 30 s) and no intro
'   --look name    the show: classic (sun; her skirt and ponytail, his cap),
'                  purple (moon and nebula; her gown and tiara, his cape and
'                  crown), neon (digital rain; her glow sticks and headphones,
'                  his hoodie and visor) or rainbow (rainbow and clouds; her
'                  tutu and horn, his party hat and bow tie)
'   --help         the options, as CLI (lib/cli.jdb) lists them
'
' A program that imports STAGE and has options of its own adds the show's
' to its spec with STAGE.OPTIONS and hands the parsed map to
' STAGE.CONFIGURE; a song without any lets STAGE.RUN read the command line.
'
' As a program of its own the show follows a song another process plays:
'
'   jdBasic stage.jdb --follow [node] [--window] [--display n] [--lan]
'
' joins the Node Bus as "stage", takes the score, the clock and the scope
' songgen --live publishes (node "songgen" unless named) and runs until
' that node leaves. The look comes from that node (songgen --look, or L
' on its desk) unless --look is given here. With --lan the node may be on
' another machine (the key in JDB_NODE_KEY). STAGE.FOLLOW does the same
' from a program.

EXPORT MODULE STAGE
IMPORT SCORE
IMPORT CLI

DIM SW AS INTEGER = 1920
DIM SH AS INTEGER = 1080
DIM TWO_PI AS DOUBLE = 2 * MATH.PI
DIM HORIZON AS DOUBLE = 640
DIM FLOOR_Y AS DOUBLE = 905
DIM N_BANDS AS INTEGER = 40
DIM N_LOG AS INTEGER = 9
DIM N_PART AS INTEGER = 200

DIM title$ AS STRING = ""
DIM shots$ AS STRING = ""
DIM font$ AS STRING = ""
DIM kick_t AS INTEGER = -1
DIM clap_t AS INTEGER = -1
DIM crash_t AS INTEGER = -1

DIM live = RESHAPE([0], [16])
DIM log_lines$ = ["", "", "", "", "", "", "", "", ""]
DIM sec_i AS INTEGER = -1
DIM mood$ AS STRING = "groove"
DIM sec_name$ AS STRING = ""
DIM section_bar AS DOUBLE = 0

DIM key_f_was AS INTEGER = FALSE
DIM next_tick AS DOUBLE = 0
DIM last_tick AS DOUBLE = 0
DIM prev_cyc AS DOUBLE = 0
DIM energy AS DOUBLE = 0
DIM flash AS DOUBLE = 0
DIM n_frames AS INTEGER = 0
DIM frame_ms_sum AS DOUBLE = 0
DIM frame_ms_max AS DOUBLE = 0
DIM shot_at AS DOUBLE = -1
DIM shot_name$ AS STRING = ""

' --render: frames at a fixed rate into render_dir$, the intro first
DIM SERIES$ AS STRING = "When Kaiku Dreams Techno"
DIM RENDER_FPS AS INTEGER = 30
DIM INTRO_SECONDS AS DOUBLE = 6
DIM render_dir$ AS STRING = ""
DIM subtitle$ AS STRING = ""
DIM frame_no AS INTEGER = 0
DIM intro_left AS DOUBLE = -1

' --tiktok: a portrait clip around the first drop with the girl alone,
' dancing a new move every two bars
DIM tiktok AS INTEGER = FALSE
DIM MID_X AS DOUBLE = 960
DIM DS AS DOUBLE = 1
DIM SCOPE_W AS DOUBLE = 1440
DIM SCOPE_Y AS DOUBLE = 175
DIM SCOPE_AMP AS DOUBLE = 240
DIM BUS_GAP AS DOUBLE = 155
DIM BUS_AMP AS DOUBLE = 300
DIM FLASH_MAX AS DOUBLE = 1
DIM SUN_SCALE AS DOUBLE = 1
DIM BAND_DX AS DOUBLE = 17
DIM BAND_W AS DOUBLE = 13
DIM TT_MAX_SECONDS AS DOUBLE = 30
DIM TT_BARS_PER_MOVE AS DOUBLE = 2
DIM TT_MOVES$ = ["woah", "floss", "clap", "heart", "dab", "shimmy", "point", "hips", "wave"]
DIM TT_LABELS$ = ["HIT THE WOAH", "FLOSS", "CLAP IT UP", "HEART HANDS", "DAB", "SHIMMY", "DISCO POINT", "HIP ROLL", "ARM WAVE"]
DIM clip_from AS DOUBLE = 0
DIM clip_to AS DOUBLE = 0
DIM tt_offset AS INTEGER = 0
DIM tt_cover_done AS INTEGER = -1

' --look: the show's palette, backdrop and the dancers' outfits, set by SET_LOOK
DIM look$ AS STRING = "classic"
DIM look_pinned AS INTEGER = FALSE

' The command line, taken by CONFIGURE
DIM configured AS INTEGER = FALSE
DIM windowed AS INTEGER = FALSE
DIM display_no AS INTEGER = -1
DIM lan AS INTEGER = FALSE
DIM backdrop$ AS STRING = "sun"
DIM outfit$ AS STRING = "skirt"
DIM girl_r AS DOUBLE = 255
DIM girl_g AS DOUBLE = 90
DIM girl_b AS DOUBLE = 200
DIM boy_r AS DOUBLE = 60
DIM boy_g AS DOUBLE = 210
DIM boy_b AS DOUBLE = 255
DIM blush_r AS INTEGER = 110
DIM blush_g AS INTEGER = 25
DIM blush_b AS INTEGER = 65
DIM sky_r AS DOUBLE = 6
DIM sky_g AS DOUBLE = 3
DIM sky_b AS DOUBLE = 16
DIM acc_r AS DOUBLE = -1
DIM acc_g AS DOUBLE = 0
DIM acc_b AS DOUBLE = 0
DIM sun_top = [230, 200, 60]
DIM sun_bot = [220, 30, 180]
DIM band_lo_rgb = [60, 110, 200]
DIM band_hi_rgb = [255, 30, 140]
DIM grid_rgb = [200, 40, 180]
DIM hline_rgb = [255, 80, 220]
DIM title_rgb = [255, 110, 215]
DIM label_rgb = [255, 235, 120]
DIM laser_mode AS INTEGER = 0
DIM spec = RESHAPE([0.0], [40])
DIM band_lo = RESHAPE([0], [40])
DIM band_hi = RESHAPE([0], [40])
DIM p_x = RESHAPE([0.0], [200])
DIM p_y = RESHAPE([0.0], [200])
DIM p_vx = RESHAPE([0.0], [200])
DIM p_vy = RESHAPE([0.0], [200])
DIM p_life = RESHAPE([0.0], [200])
DIM p_kind = RESHAPE([0], [200])
DIM p_hue = RESHAPE([0.0], [200])
DIM p_next AS INTEGER = 0
DIM star_x = RND(160) * 1920
DIM star_y = RND(160) * 600
DIM star_ph = RND(160) * 6.283

' Where the song comes from: this process's sound engine, or with
' follow$ set the topics of that node. The anchor says cycle a_cycle is
' heard at a_t (NODE.TIME) and the song moves on at a_cps per second.
DIM follow$ AS STRING = ""
DIM src_gone AS INTEGER = FALSE
DIM a_cycle AS DOUBLE = 0
DIM a_t AS DOUBLE = 0
DIM a_cps AS DOUBLE = 0
DIM a_epoch AS INTEGER = -1
DIM src_wave = RESHAPE([0.0], [1024])
DIM src_bus = RESHAPE([0.0], [1024])
DIM sub_clock = NONE
DIM sub_score = NONE
DIM sub_scope = NONE
DIM src_events = NONE

FUNC FRACT(x AS DOUBLE) AS DOUBLE
    RETURN x - INT(x)
ENDFUNC

FUNC CLAMP01(x AS DOUBLE) AS DOUBLE
    IF x < 0 THEN RETURN 0
    IF x > 1 THEN RETURN 1
    RETURN x
ENDFUNC

FUNC CLOCK$(cyc AS DOUBLE) AS STRING
    DIM secs AS INTEGER = INT(cyc * 240 / SCORE.BPM_OF())
    DIM ss$ AS STRING = STR$(secs - 60 * INT(secs / 60))
    IF LEN(ss$) < 2 THEN ss$ = "0" + ss$
    RETURN STR$(INT(secs / 60)) + ":" + ss$
ENDFUNC

FUNC IS_LIVE(t AS INTEGER) AS INTEGER
    IF t < 0 THEN RETURN FALSE
    RETURN live[t]
ENDFUNC

SUB LOG_LINE(s$)
    PRINT s$
    DIM i AS INTEGER
    FOR i = 0 TO N_LOG - 2
        log_lines$[i] = log_lines$[i + 1]
    NEXT i
    log_lines$[N_LOG - 1] = s$
ENDSUB

' The show for --look: classic, purple, neon or rainbow; any other name
' is classic. Every value starts from classic, so a show can change its
' look while it runs.
SUB SET_LOOK(name$)
    look$ = "classic"
    backdrop$ = "sun"
    outfit$ = "skirt"
    girl_r = 255
    girl_g = 90
    girl_b = 200
    boy_r = 60
    boy_g = 210
    boy_b = 255
    blush_r = 110
    blush_g = 25
    blush_b = 65
    sky_r = 6
    sky_g = 3
    sky_b = 16
    acc_r = -1
    acc_g = 0
    acc_b = 0
    sun_top = [230, 200, 60]
    sun_bot = [220, 30, 180]
    band_lo_rgb = [60, 110, 200]
    band_hi_rgb = [255, 30, 140]
    grid_rgb = [200, 40, 180]
    hline_rgb = [255, 80, 220]
    title_rgb = [255, 110, 215]
    label_rgb = [255, 235, 120]
    laser_mode = 0
    IF name$ = "purple" THEN
        look$ = name$
        backdrop$ = "moon"
        outfit$ = "gown"
        girl_r = 190
        girl_g = 120
        girl_b = 255
        boy_r = 130
        boy_g = 150
        boy_b = 255
        blush_r = 80
        blush_g = 30
        blush_b = 110
        sky_r = 8
        sky_g = 3
        sky_b = 22
        acc_r = 150
        acc_g = 80
        acc_b = 255
        sun_top = [240, 230, 255]
        sun_bot = [165, 135, 240]
        band_lo_rgb = [70, 40, 160]
        band_hi_rgb = [225, 120, 255]
        grid_rgb = [120, 50, 210]
        hline_rgb = [190, 110, 255]
        title_rgb = [210, 150, 255]
        label_rgb = [255, 220, 255]
        laser_mode = 1
    ELSEIF name$ = "neon" THEN
        look$ = name$
        backdrop$ = "rain"
        outfit$ = "raver"
        girl_r = 90
        girl_g = 255
        girl_b = 110
        boy_r = 70
        boy_g = 170
        boy_b = 255
        blush_r = 30
        blush_g = 90
        blush_b = 40
        sky_r = 2
        sky_g = 9
        sky_b = 5
        acc_r = 60
        acc_g = 255
        acc_b = 100
        sun_top = [210, 255, 80]
        sun_bot = [20, 200, 150]
        band_lo_rgb = [20, 90, 60]
        band_hi_rgb = [170, 255, 60]
        grid_rgb = [30, 200, 70]
        hline_rgb = [120, 255, 120]
        title_rgb = [120, 255, 140]
        label_rgb = [230, 255, 120]
        laser_mode = 2
    ELSEIF name$ = "rainbow" THEN
        look$ = name$
        backdrop$ = "rainbow"
        outfit$ = "unicorn"
        blush_r = 110
        blush_g = 40
        blush_b = 90
        sky_r = 8
        sky_g = 4
        sky_b = 18
        acc_r = 0
        band_lo_rgb = [0, 0, 0]
        band_hi_rgb = [0, 0, 0]
        title_rgb = [255, 215, 90]
        label_rgb = [255, 245, 200]
    ENDIF
ENDSUB

' A rainbow colour, h in radians
FUNC HUE_R(h AS DOUBLE) AS INTEGER
    RETURN INT(128 + 127 * SIN(h))
ENDFUNC

FUNC HUE_G(h AS DOUBLE) AS INTEGER
    RETURN INT(128 + 127 * SIN(h + 2.1))
ENDFUNC

FUNC HUE_B(h AS DOUBLE) AS INTEGER
    RETURN INT(128 + 127 * SIN(h + 4.2))
ENDFUNC

' 0..1 values of a SOUND.MOD shape at the times x, in periods
FUNC SHAPE_AT(shape$, x)
    DIM fl = FLOOR(x)
    DIM fr = x - fl
    IF shape$ = "SINE" THEN RETURN 0.5 + 0.5 * SIN(TWO_PI * fr)
    IF shape$ = "COSINE" THEN RETURN 0.5 + 0.5 * COS(TWO_PI * fr)
    IF shape$ = "SAW" THEN RETURN fr
    IF shape$ = "ISAW" THEN RETURN 1 - fr
    IF shape$ = "TRI" THEN RETURN 1 - ABS(2 * fr - 1)
    IF shape$ = "SQUARE" THEN RETURN (fr >= 0.5) * 1
    DIM ha = ABS(SIN(fl * 12.9898 + 78.233)) * 43758.5453
    ha = ha - INT(ha)
    IF shape$ = "RAND" THEN RETURN ha
    DIM hb = ABS(SIN((fl + 1) * 12.9898 + 78.233)) * 43758.5453
    hb = hb - INT(hb)
    DIM sm = fr * fr * fr * (fr * (fr * 6 - 15) + 10)
    RETURN ha + (hb - ha) * sm
ENDFUNC

' A glowing line: a wide dim halo under a bright core, drawn additively
SUB NEON(x1 AS DOUBLE, y1 AS DOUBLE, x2 AS DOUBLE, y2 AS DOUBLE, w AS INTEGER, r AS DOUBLE, g AS DOUBLE, b AS DOUBLE)
    DIM dx AS DOUBLE = x2 - x1
    DIM dy AS DOUBLE = y2 - y1
    DIM ln AS DOUBLE = SQR(dx * dx + dy * dy) + 0.001
    DIM nx AS DOUBLE = -dy / ln
    DIM ny AS DOUBLE = dx / ln
    DIM kh = (IOTA(2 * w + 5, 0) - (w + 2)) * 1.6
    DRAWCOLOR INT(r * 0.16), INT(g * 0.16), INT(b * 0.16)
    LINE STACK(1, x1 + nx * kh, y1 + ny * kh, x2 + nx * kh, y2 + ny * kh)
    DIM kc = IOTA(2 * w + 1, 0) - w
    DRAWCOLOR INT(r), INT(g), INT(b)
    LINE STACK(1, x1 + nx * kc, y1 + ny * kc, x2 + nx * kc, y2 + ny * kc)
ENDSUB

SUB NEON_RING(x AS DOUBLE, y AS DOUBLE, rad AS DOUBLE, r AS DOUBLE, g AS DOUBLE, b AS DOUBLE)
    DIM rh = rad + (IOTA(7, 0) - 3) * 1.6
    DRAWCOLOR INT(r * 0.16), INT(g * 0.16), INT(b * 0.16)
    CIRCLE STACK(1, rh * 0 + x, rh * 0 + y, rh)
    DRAWCOLOR INT(r), INT(g), INT(b)
    CIRCLE STACK(1, [x, x, x], [y, y, y], [rad - 1, rad, rad + 1])
ENDSUB

SUB FILL_HEART(x AS DOUBLE, y AS DOUBLE, s AS DOUBLE, r AS INTEGER, g AS INTEGER, b AS INTEGER)
    DRAWCOLOR r, g, b
    CIRCLE x - s * 0.5, y, s * 0.55, TRUE
    CIRCLE x + s * 0.5, y, s * 0.55, TRUE
    DIM ks = IOTA(INT(s * 1.3) + 1, 0)
    DIM half = s * 1.05 * (1 - ks / (s * 1.3))
    LINE STACK(1, x - half, y + ks, x + half, y + ks)
ENDSUB

' kind 0 sparks, 1 hearts, 2 confetti
SUB SPAWN(kind AS INTEGER, x AS DOUBLE, y AS DOUBLE, n AS INTEGER, hue AS DOUBLE)
    DIM i AS INTEGER
    DIM a AS DOUBLE
    DIM sp AS DOUBLE
    FOR i = 1 TO n
        a = RND(1) * TWO_PI
        sp = 120 + RND(1) * 420
        p_x[p_next] = x
        p_y[p_next] = y
        p_vx[p_next] = COS(a) * sp
        p_vy[p_next] = SIN(a) * sp - 260
        p_life[p_next] = 1.2 + RND(1) * 0.8
        p_kind[p_next] = kind
        p_hue[p_next] = hue + RND(1) * 1.5
        IF kind = 1 THEN
            p_vx[p_next] = (RND(1) - 0.5) * 60
            p_vy[p_next] = -60 - RND(1) * 60
            p_life[p_next] = 3 + RND(1)
        ENDIF
        p_next = p_next + 1
        IF p_next >= N_PART THEN p_next = 0
    NEXT i
ENDSUB

' One dancer. Every limb is an angle: 0 points down, +90 degrees right.
FUNC SMOOTH01(x AS DOUBLE) AS DOUBLE
    DIM t AS DOUBLE = CLAMP01(x)
    RETURN t * t * (3 - 2 * t)
ENDFUNC

' The move of the clip at cycle cyc, an index into TT_MOVES$
FUNC TT_MOVE_AT(cyc AS DOUBLE) AS INTEGER
    DIM k AS INTEGER = INT((cyc - clip_from) / TT_BARS_PER_MOVE) + tt_offset
    IF k < tt_offset THEN k = tt_offset
    RETURN k - LEN(TT_MOVES$) * INT(k / LEN(TT_MOVES$))
ENDFUNC

' A pose as [hop, sway, lean, nod, tilt, lua, lfa, rua, rfa, lth, lsh, rth,
' rsh]; angles as in DANCER, 0 down and MATH.PI up, positive to the right
FUNC TT_POSE(move$, cyc AS DOUBLE)
    DIM beat AS DOUBLE = cyc * 4
    DIM bf AS DOUBLE = FRACT(beat)
    DIM bn AS INTEGER = INT(beat)
    DIM odd AS INTEGER = bn - 2 * INT(bn / 2)
    DIM dip AS DOUBLE = 0.5 + 0.5 * COS(TWO_PI * bf)
    DIM s2 AS DOUBLE = SIN(TWO_PI * beat / 2)
    DIM p AS DOUBLE = FRACT(cyc)
    DIM hop AS DOUBLE = 0
    DIM sway AS DOUBLE = 0
    DIM lean AS DOUBLE = 0
    DIM nod AS DOUBLE = 5 * dip
    DIM tilt AS DOUBLE = 0
    DIM lua AS DOUBLE = -0.3
    DIM lfa AS DOUBLE = -0.2
    DIM rua AS DOUBLE = 0.3
    DIM rfa AS DOUBLE = 0.2
    DIM lth AS DOUBLE = -0.12 - 0.2 * dip
    DIM rth AS DOUBLE = 0.12 + 0.2 * dip
    DIM lsh AS DOUBLE = 0.1 * dip
    DIM rsh AS DOUBLE = -0.1 * dip

    IF move$ = "floss" THEN
        ' both arms swing to one side each beat, the hips the other way
        DIM fs AS DOUBLE = COS(MATH.PI * beat)
        lua = 0.65 * fs - 0.15
        rua = 0.65 * fs + 0.15
        lfa = lua + 0.2 * fs
        rfa = rua + 0.2 * fs
        sway = -26 * fs
        lean = 0.06 * fs
    ELSEIF move$ = "woah" THEN
        ' a sweep down from up-right on the one, frozen in a squat
        DIM k AS DOUBLE = SMOOTH01(p / 0.12)
        IF p > 0.85 THEN k = 1 - SMOOTH01((p - 0.85) / 0.15)
        lua = 2.2 + (-1.15 - 2.2) * k
        lfa = 2.3 + (-0.4 - 2.3) * k
        rua = 2.45 + (-0.55 - 2.45) * k
        rfa = 2.5 + (-1.6 - 2.5) * k
        lth = -0.15 - 0.3 * k
        lsh = 0.38 * k
        rth = 0.15 + 0.3 * k
        rsh = -0.38 * k
        lean = -0.1 * k
        tilt = -0.15 * k
        nod = 2 * dip
    ELSEIF move$ = "heart" THEN
        ' the hands meet over the head as a heart
        lua = -2.55
        rua = 2.55
        lfa = 2.3
        rfa = -2.3
        sway = 14 * s2
        tilt = 0.12 * s2
    ELSEIF move$ = "shimmy" THEN
        ' hands on the hips, the shoulders shaking on the eighths
        DIM sh AS DOUBLE = SIN(TWO_PI * beat * 2)
        lua = -0.75
        lfa = 0.95
        rua = 0.75
        rfa = -0.95
        lean = 0.07 * sh
        tilt = -0.1 * sh
        sway = 8 * sh
    ELSEIF move$ = "point" THEN
        ' up to the right on one beat, down across on the next
        lua = -0.75
        lfa = 0.95
        IF odd = 0 THEN
            rua = 2.45
            rfa = 2.5
        ELSE
            rua = -0.45
            rfa = -0.75
        ENDIF
        sway = 18 * (1 - 2 * odd)
        lean = 0.06 * (1 - 2 * odd)
        tilt = 0.1 * (2 * odd - 1)
    ELSEIF move$ = "clap" THEN
        ' a step to the side each beat, a clap over the head on two and four
        DIM c AS DOUBLE = 0.5 - 0.5 * COS(MATH.PI * beat)
        lua = -2.2 - 0.55 * c
        rua = 2.2 + 0.55 * c
        lfa = -2.4 - 1.0 * c
        rfa = 2.4 + 1.0 * c
        sway = 28 * s2
        lth = -0.12 - 0.35 * (s2 < 0) * ABS(s2)
        rth = 0.12 + 0.35 * (s2 > 0) * ABS(s2)
        lsh = lth + 0.1
        rsh = rth - 0.1
    ELSEIF move$ = "dab" THEN
        ' the head into one elbow, the other arm out; the side alternates per bar
        DIM d AS DOUBLE = SMOOTH01(p / 0.05)
        IF p > 0.45 THEN d = 1 - SMOOTH01((p - 0.45) / 0.1)
        lua = -0.3 + (1.9 + 0.3) * d
        lfa = -0.2 + (-2.3 + 0.2) * d
        rua = 0.3 + (2.25 - 0.3) * d
        rfa = 0.2 + (2.25 - 0.2) * d
        tilt = 0.5 * d
        lean = 0.1 * d
        IF INT(cyc) - 2 * INT(INT(cyc) / 2) = 1 THEN
            DIM ta AS DOUBLE = lua
            lua = -rua
            rua = -ta
            ta = lfa
            lfa = -rfa
            rfa = -ta
            tilt = -tilt
            lean = -lean
        ENDIF
    ELSEIF move$ = "hips" THEN
        ' a hip roll, one hand on the hip, the other behind the head
        sway = 28 * s2
        lean = -0.1 * s2
        tilt = 0.1 * COS(TWO_PI * beat / 2)
        lua = -0.75
        lfa = 0.95
        rua = 2.7
        rfa = -2.0
        lth = -0.14 - 0.12 * s2
        rth = 0.14 - 0.12 * s2
    ELSEIF move$ = "wave" THEN
        ' the arms out level, a wave running through them from left to right
        lua = -1.57 + 0.25 * SIN(TWO_PI * beat / 2 + 1.6)
        lfa = -1.57 + 0.6 * SIN(TWO_PI * beat / 2 + 1.0)
        rua = 1.57 + 0.25 * SIN(TWO_PI * beat / 2 - 0.4)
        rfa = 1.57 + 0.6 * SIN(TWO_PI * beat / 2 - 1.0)
        sway = 10 * s2
        tilt = 0.08 * s2
    ENDIF
    RETURN [hop, sway, lean, nod, tilt, lua, lfa, rua, rfa, lth, lsh, rth, rsh]
ENDFUNC

' The pose of the clip at cyc: the current move, faded in from the last
' one over the first beat
FUNC TT_POSE_AT(cyc AS DOUBLE)
    DIM mi AS INTEGER = TT_MOVE_AT(cyc)
    DIM cur = TT_POSE(TT_MOVES$[mi], cyc)
    DIM into AS DOUBLE = cyc - clip_from - TT_BARS_PER_MOVE * INT((cyc - clip_from) / TT_BARS_PER_MOVE)
    IF cyc - clip_from < TT_BARS_PER_MOVE ORELSE into >= 0.25 THEN RETURN cur
    DIM prev_i AS INTEGER = mi - 1
    IF prev_i < 0 THEN prev_i = LEN(TT_MOVES$) - 1
    DIM prev = TT_POSE(TT_MOVES$[prev_i], cyc)
    DIM w AS DOUBLE = SMOOTH01(into / 0.25)
    RETURN prev + (cur - prev) * w
ENDFUNC

' A skirt from the waist at y, top_half wide there, hem wide at its foot
SUB SKIRT(x AS DOUBLE, y AS DOUBLE, top_half AS DOUBLE, hem AS DOUBLE, h AS DOUBLE, cr AS DOUBLE, cg AS DOUBLE, cb AS DOUBLE)
    DIM ks = IOTA(INT(h) + 1, 0)
    DIM half = top_half + (hem - top_half) * ks / h
    DRAWCOLOR INT(cr * 0.3), INT(cg * 0.3), INT(cb * 0.3)
    LINE STACK(1, x - half, y + ks, x + half, y + ks)
    NEON x - top_half, y, x - hem, y + h, 1, cr, cg, cb
    NEON x + top_half, y, x + hem, y + h, 1, cr, cg, cb
    NEON x - hem, y + h, x + hem, y + h, 1, cr, cg, cb
ENDSUB

SUB DANCER(cx AS DOUBLE, girl AS INTEGER, cyc AS DOUBLE, cr AS DOUBLE, cg AS DOUBLE, cb AS DOUBLE)
    DIM beat AS DOUBLE = cyc * 4
    DIM bf AS DOUBLE = FRACT(beat)
    DIM bn AS INTEGER = INT(beat)
    DIM odd AS INTEGER = bn - 2 * INT(bn / 2)
    DIM dip AS DOUBLE = 0.5 + 0.5 * COS(TWO_PI * bf)
    DIM arc AS DOUBLE = SIN(MATH.PI * bf)
    DIM s2 AS DOUBLE = SIN(TWO_PI * cyc / 2)
    DIM side AS DOUBLE = 1
    IF girl THEN side = -1
    DIM hop AS DOUBLE = 0
    DIM sway AS DOUBLE = 0
    DIM lean AS DOUBLE = 0
    DIM nod AS DOUBLE = 0
    DIM tilt AS DOUBLE = 0
    DIM lua AS DOUBLE = -0.3
    DIM lfa AS DOUBLE = -0.2
    DIM rua AS DOUBLE = 0.3
    DIM rfa AS DOUBLE = 0.2
    DIM lth AS DOUBLE = -0.14
    DIM lsh AS DOUBLE = -0.06
    DIM rth AS DOUBLE = 0.14
    DIM rsh AS DOUBLE = 0.06

    IF mood$ = "groove" THEN
        lth = -0.12 - 0.3 * dip
        rth = 0.12 + 0.3 * dip
        lsh = 0.12 * dip
        rsh = -0.12 * dip
        lua = -0.35 - 0.2 * dip
        rua = 0.35 + 0.2 * dip
        lfa = 2.95 - 0.45 * dip
        rfa = -2.95 + 0.45 * dip
        nod = 6 * dip
        sway = 10 * s2 * side
    ELSEIF mood$ = "shuffle" THEN
        IF odd = 0 THEN
            lth = -0.15 - 0.8 * arc
            lsh = lth + 0.5 * arc
        ELSE
            rth = 0.15 + 0.8 * arc
            rsh = rth - 0.5 * arc
        ENDIF
        hop = 10 * arc
        lua = -0.4
        rua = 0.4
        IF odd = 1 THEN lua = -0.4 - 1.3 * arc
        IF odd = 0 THEN rua = 0.4 + 1.3 * arc
        lfa = lua + 1.9
        rfa = rua - 1.9
        nod = 5 * dip
    ELSEIF mood$ = "jump" THEN
        hop = 40 * arc * (0.8 + energy * 1.5)
        lth = -0.15 - 0.35 * arc
        rth = 0.15 + 0.35 * arc
        lsh = 0.25 * arc
        rsh = -0.25 * arc
        IF FRACT(cyc / 4) >= 0.75 THEN
            lua = -2.5
            lfa = -2.75
            rua = 2.5
            rfa = 2.75
        ELSEIF (odd = 0) = (girl = 0) THEN
            rua = 2.75
            rfa = 3.0
            lua = -0.45
            lfa = 2.3
        ELSE
            lua = -2.75
            lfa = -3.0
            rua = 0.45
            rfa = -2.3
        ENDIF
    ELSEIF mood$ = "wave" THEN
        DIM d2 AS DOUBLE = 0.5 + 0.5 * COS(TWO_PI * cyc * 2)
        sway = 34 * s2
        lean = 0.1 * s2
        lua = -2.45 + 0.25 * s2
        rua = 2.45 + 0.25 * s2
        lfa = lua - 0.25 + 0.5 * SIN(TWO_PI * cyc / 2 - 0.9)
        rfa = rua + 0.25 + 0.5 * SIN(TWO_PI * cyc / 2 - 0.9)
        lth = -0.1 - 0.2 * d2
        rth = 0.1 + 0.2 * d2
        lsh = 0.08 * d2
        rsh = -0.08 * d2
        tilt = 0.12 * s2
    ELSEIF mood$ = "rise" THEN
        DIM prog AS DOUBLE = CLAMP01((cyc - section_bar) / 8)
        DIM trem AS DOUBLE = SIN(TWO_PI * cyc * 8) * (0.05 + 0.35 * prog)
        lua = -2.7 + trem
        rua = 2.7 - trem
        lfa = lua - 0.2
        rfa = rua + 0.2
        hop = prog * prog * 28 * ABS(SIN(TWO_PI * cyc * 4))
        nod = 4 * prog * SIN(TWO_PI * cyc * 8)
    ELSEIF mood$ = "robot" THEN
        DIM eighth AS INTEGER = INT(cyc * 8)
        lua = -1.57
        rua = 1.57
        IF eighth - 2 * INT(eighth / 2) = 1 THEN
            lfa = -3.14
            rfa = 0
        ELSE
            lfa = 0
            rfa = 3.14
        ENDIF
        sway = 16 * (2 * odd - 1)
        tilt = 0.18 * (2 * odd - 1)
        lth = -0.2
        rth = 0.2
        lsh = -0.2
        rsh = 0.2
    ELSEIF mood$ = "pan" THEN
        DIM pp AS DOUBLE = SIN(TWO_PI * cyc)
        sway = 90 * pp
        lean = 0.25 * pp
        lua = -1.45 - 0.45 * pp
        rua = 1.45 - 0.45 * pp
        lfa = lua - 0.15
        rfa = rua + 0.15
        lth = -0.12 - 0.25 * dip
        rth = 0.12 + 0.25 * dip
        lsh = 0.1 * dip
        rsh = -0.1 * dip
        tilt = 0.2 * pp
    ELSEIF mood$ = "bye" THEN
        IF girl THEN
            lua = -2.55
            lfa = -2.6 + 0.55 * SIN(TWO_PI * cyc * 2)
        ELSE
            rua = 2.55
            rfa = 2.6 + 0.55 * SIN(TWO_PI * cyc * 2)
        ENDIF
    ENDIF

    IF tiktok THEN
        DIM pose = TT_POSE_AT(cyc)
        hop = pose[0]
        sway = pose[1]
        lean = pose[2]
        nod = pose[3]
        tilt = pose[4]
        lua = pose[5]
        lfa = pose[6]
        rua = pose[7]
        rfa = pose[8]
        lth = pose[9]
        lsh = pose[10]
        rth = pose[11]
        rsh = pose[12]
    ENDIF
    hop = hop * DS
    sway = sway * DS
    nod = nod * DS

    DIM THIGH AS DOUBLE = 88 * DS
    DIM SHIN AS DOUBLE = 86 * DS
    DIM TORSO AS DOUBLE = 122 * DS
    DIM UARM AS DOUBLE = 70 * DS
    DIM FARM AS DOUBLE = 64 * DS
    DIM HEAD_R AS DOUBLE = 30 * DS
    DIM nw AS INTEGER = INT(2 * DS + 0.5)
    DIM legv AS DOUBLE = MAX([THIGH * COS(lth) + SHIN * COS(lsh), THIGH * COS(rth) + SHIN * COS(rsh)])
    DIM hx AS DOUBLE = cx + sway
    DIM hy AS DOUBLE = FLOOR_Y - legv - hop
    DIM lkx AS DOUBLE = hx + THIGH * SIN(lth)
    DIM lky AS DOUBLE = hy + THIGH * COS(lth)
    DIM rkx AS DOUBLE = hx + THIGH * SIN(rth)
    DIM rky AS DOUBLE = hy + THIGH * COS(rth)
    DIM shx AS DOUBLE = hx + (TORSO - 14 * DS) * SIN(lean)
    DIM shy AS DOUBLE = hy - (TORSO - 14 * DS) * COS(lean)
    DIM nkx AS DOUBLE = hx + TORSO * SIN(lean)
    DIM nky AS DOUBLE = hy - TORSO * COS(lean)
    DIM hdx AS DOUBLE = nkx + (HEAD_R + 8 * DS) * SIN(lean + tilt)
    DIM hdy AS DOUBLE = nky - (HEAD_R + 8 * DS) * COS(lean + tilt) + nod
    DIM lex AS DOUBLE = shx + UARM * SIN(lua)
    DIM ley AS DOUBLE = shy + UARM * COS(lua)
    DIM rex AS DOUBLE = shx + UARM * SIN(rua)
    DIM rey AS DOUBLE = shy + UARM * COS(rua)

    ' shadow, shrinking as the dancer leaves the floor
    DRAWCOLOR INT(cr * 0.14), INT(cg * 0.14), INT(cb * 0.14)
    ELLIPSE hx, FLOOR_Y + 6 * DS, (70 - hop * 0.5 / DS) * DS, 12 * DS, TRUE

    IF girl THEN
        DIM wy AS DOUBLE = hy - 16 * DS
        DIM flare AS DOUBLE = 0.12 * ABS(sway / DS) + 10 * arc
        IF outfit$ = "gown" THEN
            DIM ghem AS DOUBLE = (72 + 1.4 * flare) * DS
            DIM gown_h AS DOUBLE = 150 * DS
            SKIRT hx, wy, 14 * DS, ghem, gown_h, cr, cg, cb
            ' stars woven into the gown, twinkling on the beat
            DIM gfx = [-0.55, 0.3, -0.1, 0.6, -0.4, 0.15, 0.45]
            DIM gfy = [0.35, 0.28, 0.55, 0.62, 0.82, 0.88, 0.45]
            DIM gtw = 0.5 + 0.5 * SIN(TWO_PI * beat / 2 + IOTA(7, 0) * 1.7)
            DIM gsx = hx + gfx * (14 * DS + (ghem - 14 * DS) * gfy)
            DIM gsy = wy + gfy * gown_h
            DIM gc = INT(120 + 135 * gtw)
            CIRCLE STACK(1, gsx, gsy, gtw * 0 + 3 * DS), TRUE, STACK(1, gc, gc, gc)
        ELSEIF outfit$ = "raver" THEN
            SKIRT hx, wy, 16 * DS, (46 + flare) * DS, 34 * DS, cr, cg, cb
        ELSEIF outfit$ = "unicorn" THEN
            ' a tutu of three layers, the longest and widest at the back
            DIM tk AS INTEGER
            FOR tk = 0 TO 2
                DIM th AS DOUBLE = tk * 2.1 + cyc
                SKIRT hx, wy, 16 * DS, (92 - tk * 16 + 1.3 * flare) * DS, (36 - tk * 9) * DS, HUE_R(th), HUE_G(th), HUE_B(th)
            NEXT tk
        ELSE
            SKIRT hx, wy, 16 * DS, (58 + flare) * DS, 55 * DS, cr, cg, cb
        ENDIF
    ELSEIF outfit$ = "gown" THEN
        ' a cape from the shoulders, trailing the sway and flaring with the hop
        DIM cape_h AS DOUBLE = TORSO + 30 * DS
        DIM cape_half AS DOUBLE = (34 + 0.25 * hop / DS) * DS
        DIM cape_x AS DOUBLE = shx - sway * 0.4
        DIM cks = IOTA(INT(cape_h) + 1, 0)
        DIM ct = cks / cape_h
        DIM cpl = shx - 14 * DS + (cape_x - cape_half - shx + 14 * DS) * ct
        DIM cpr = shx + 14 * DS + (cape_x + cape_half - shx - 14 * DS) * ct
        DRAWCOLOR INT(cr * 0.22), INT(cg * 0.22), INT(cb * 0.22)
        LINE STACK(1, cpl, shy + cks, cpr, shy + cks)
        NEON shx - 14 * DS, shy, cape_x - cape_half, shy + cape_h, 1, cr, cg, cb
        NEON shx + 14 * DS, shy, cape_x + cape_half, shy + cape_h, 1, cr, cg, cb
        NEON cape_x - cape_half, shy + cape_h, cape_x + cape_half, shy + cape_h, 1, cr, cg, cb
    ENDIF

    NEON hx, hy, nkx, nky, nw, cr, cg, cb
    NEON hx, hy, lkx, lky, nw, cr, cg, cb
    NEON lkx, lky, lkx + SHIN * SIN(lsh), lky + SHIN * COS(lsh), nw, cr, cg, cb
    NEON hx, hy, rkx, rky, nw, cr, cg, cb
    NEON rkx, rky, rkx + SHIN * SIN(rsh), rky + SHIN * COS(rsh), nw, cr, cg, cb
    NEON shx, shy, lex, ley, nw, cr, cg, cb
    NEON lex, ley, lex + FARM * SIN(lfa), ley + FARM * COS(lfa), nw, cr, cg, cb
    NEON shx, shy, rex, rey, nw, cr, cg, cb
    NEON rex, rey, rex + FARM * SIN(rfa), rey + FARM * COS(rfa), nw, cr, cg, cb
    NEON_RING hdx, hdy, HEAD_R, cr, cg, cb

    IF girl ANDALSO outfit$ = "raver" THEN
        ' glow sticks, held along the forearms
        DIM lhx AS DOUBLE = lex + FARM * SIN(lfa)
        DIM lhy AS DOUBLE = ley + FARM * COS(lfa)
        DIM rhx AS DOUBLE = rex + FARM * SIN(rfa)
        DIM rhy AS DOUBLE = rey + FARM * COS(rfa)
        NEON lhx, lhy, lhx + 44 * DS * SIN(lfa), lhy + 44 * DS * COS(lfa), nw + 1, 255, 60, 200
        NEON rhx, rhy, rhx + 44 * DS * SIN(rfa), rhy + 44 * DS * COS(rfa), nw + 1, 60, 220, 255
    ENDIF

    DIM ex AS DOUBLE = 10 * DS
    DIM visor AS INTEGER = (NOT girl) ANDALSO outfit$ = "raver"
    IF NOT visor THEN
        DRAWCOLOR 255, 255, 255
        CIRCLE hdx - ex, hdy - 4 * DS, 4 * DS, TRUE
        CIRCLE hdx + ex, hdy - 4 * DS, 4 * DS, TRUE
    ENDIF
    DIM sa = 0.6 + IOTA(9, 0) * 0.243
    DIM smx = hdx + 13 * DS * COS(sa)
    DIM smy = hdy + 2 * DS + 11 * DS * SIN(sa)
    DRAWCOLOR INT(cr), INT(cg), INT(cb)
    LINE STACK(1, TAKE(8, smx), TAKE(8, smy), DROP(1, smx), DROP(1, smy))

    IF girl THEN
        ' lashes and blush, then the hair and headwear of the outfit
        LINE STACK(1, [hdx - ex - 4 * DS, hdx + ex + 4 * DS], [hdy - 7 * DS, hdy - 7 * DS], [hdx - ex - 9 * DS, hdx + ex + 9 * DS], [hdy - 12 * DS, hdy - 12 * DS])
        DRAWCOLOR blush_r, blush_g, blush_b
        CIRCLE hdx - 18 * DS, hdy + 6 * DS, 6 * DS, TRUE
        CIRCLE hdx + 18 * DS, hdy + 6 * DS, 6 * DS, TRUE
        IF outfit$ = "gown" THEN
            ' space buns and a tiara
            DRAWCOLOR INT(cr * 0.55), INT(cg * 0.55), INT(cb * 0.55)
            CIRCLE hdx - HEAD_R * 0.85, hdy - HEAD_R * 0.75, 14 * DS, TRUE
            CIRCLE hdx + HEAD_R * 0.85, hdy - HEAD_R * 0.75, 14 * DS, TRUE
            NEON_RING hdx - HEAD_R * 0.85, hdy - HEAD_R * 0.75, 14 * DS, cr, cg, cb
            NEON_RING hdx + HEAD_R * 0.85, hdy - HEAD_R * 0.75, 14 * DS, cr, cg, cb
            DIM crx = hdx + [-16, -10, -5, 0, 5, 10, 16] * DS
            DIM cry = hdy - HEAD_R - 2 * DS + [0, -13, -4, -20, -4, -13, 0] * DS
            DRAWCOLOR 255, 220, 120
            LINE STACK(1, TAKE(6, crx), TAKE(6, cry), DROP(1, crx), DROP(1, cry))
            LINE STACK(1, TAKE(6, crx), TAKE(6, cry) + 1, DROP(1, crx), DROP(1, cry) + 1)
            DRAWCOLOR 255, 255, 255
            CIRCLE hdx, hdy - HEAD_R - 22 * DS, 3 * DS, TRUE
        ELSEIF outfit$ = "raver" THEN
            ' pigtails either side, swinging against each other, and headphones
            DIM rk = IOTA(6, 1)
            DIM swing = 0.35 * SIN(TWO_PI * beat / 2 - rk * 0.5) - hop / DS * 0.006 * rk
            DIM qlx = hdx - HEAD_R * 0.9 - rk * 10 * DS * SIN(0.5 + swing)
            DIM qly = hdy - HEAD_R * 0.3 + rk * 10 * DS * COS(0.5 + swing)
            DIM qrx = hdx + HEAD_R * 0.9 + rk * 10 * DS * SIN(0.5 - swing)
            DIM qry = hdy - HEAD_R * 0.3 + rk * 10 * DS * COS(0.5 - swing)
            DRAWCOLOR INT(cr * 0.5), INT(cg * 0.5), INT(cb * 0.5)
            CIRCLE STACK(1, qlx, qly, (10 - rk) * DS), TRUE
            CIRCLE STACK(1, qrx, qry, (10 - rk) * DS), TRUE
            DIM ha = MATH.PI + 0.35 + IOTA(13, 0) * (MATH.PI - 0.7) / 12
            DIM hpx = hdx + (HEAD_R + 6 * DS) * COS(ha)
            DIM hpy = hdy + (HEAD_R + 6 * DS) * SIN(ha)
            DRAWCOLOR 255, 60, 200
            LINE STACK(1, TAKE(12, hpx), TAKE(12, hpy), DROP(1, hpx), DROP(1, hpy))
            LINE STACK(1, TAKE(12, hpx), TAKE(12, hpy) + 2, DROP(1, hpx), DROP(1, hpy) + 2)
            CIRCLE hdx - HEAD_R - 3 * DS, hdy - 2 * DS, 9 * DS, TRUE
            CIRCLE hdx + HEAD_R + 3 * DS, hdy - 2 * DS, 9 * DS, TRUE
        ELSEIF outfit$ = "unicorn" THEN
            ' long rainbow hair and a striped horn
            DIM uk = IOTA(10, 1)
            DIM ua = 0.5 + 0.3 * SIN(TWO_PI * beat / 2 - uk * 0.4) - sway / DS * 0.004 - hop / DS * 0.006 * uk
            DIM ux = hdx + HEAD_R * 0.7 + uk * 11 * DS * SIN(ua)
            DIM uy = hdy - HEAD_R * 0.6 + uk * 11 * DS * COS(ua)
            DIM uh = uk * 0.6 + cyc * 2
            CIRCLE STACK(1, ux, uy, (13 - uk * 0.8) * DS), TRUE, STACK(1, INT((128 + 127 * SIN(uh)) * 0.7), INT((128 + 127 * SIN(uh + 2.1)) * 0.7), INT((128 + 127 * SIN(uh + 4.2)) * 0.7))
            DIM hk = IOTA(INT(42 * DS), 0)
            DIM hw = 7 * DS * (1 - hk / (42 * DS))
            DIM stripe = (hk - 12 * INT(hk / 12)) < 6
            LINE STACK(1, hdx - hw, hdy - HEAD_R - hk, hdx + hw, hdy - HEAD_R - hk), STACK(1, 255 + hk * 0, INT(200 + 55 * stripe), INT(90 + 150 * stripe))
        ELSE
            ' a ponytail swinging behind the beat, a bow
            DIM pax AS DOUBLE = hdx + HEAD_R * 0.75
            DIM pay AS DOUBLE = hdy - HEAD_R * 0.7
            DIM pk = IOTA(7, 1)
            DIM pa = 0.55 + 0.35 * SIN(TWO_PI * beat / 2 - pk * 0.45) - sway / DS * 0.004 - hop / DS * 0.008 * pk
            DIM ppx = pax + pk * 11 * DS * SIN(pa) + 6 * DS
            DIM ppy = pay + pk * 11 * DS * COS(pa) - 8 * DS
            DRAWCOLOR INT(cr * 0.5), INT(cg * 0.5), INT(cb * 0.5)
            CIRCLE STACK(1, ppx, ppy, (11 - pk) * DS), TRUE
            DRAWCOLOR 255, 60, 110
            CIRCLE pax - 7 * DS, pay - 3 * DS, 8 * DS, TRUE
            CIRCLE pax + 9 * DS, pay - 9 * DS, 8 * DS, TRUE
            CIRCLE pax + 1 * DS, pay - 6 * DS, 4 * DS, TRUE
        ENDIF
    ELSEIF outfit$ = "gown" THEN
        ' a crown of three points, a jewel on each
        DIM kx = hdx + [-18, -12, -6, 0, 6, 12, 18] * DS
        DIM ky = hdy - HEAD_R + [2, -16, -6, -22, -6, -16, 2] * DS
        DRAWCOLOR 255, 220, 120
        LINE STACK(1, TAKE(6, kx), TAKE(6, ky), DROP(1, kx), DROP(1, ky))
        LINE STACK(1, TAKE(6, kx), TAKE(6, ky) + 1, DROP(1, kx), DROP(1, ky) + 1)
        LINE hdx - 18 * DS, hdy - HEAD_R + 2 * DS, hdx + 18 * DS, hdy - HEAD_R + 2 * DS
        LINE hdx - 18 * DS, hdy - HEAD_R + 5 * DS, hdx + 18 * DS, hdy - HEAD_R + 5 * DS
        DRAWCOLOR 230, 160, 255
        CIRCLE STACK(1, hdx + [-12, 0, 12] * DS, hdy - HEAD_R + [-16, -22, -16] * DS, [3, 3, 3] * DS), TRUE
    ELSEIF outfit$ = "raver" THEN
        ' a hood around the head, down to the shoulders, and a visor
        DIM hda = MATH.PI + 0.2 + IOTA(13, 0) * (MATH.PI - 0.4) / 12
        DRAWCOLOR INT(cr * 0.5), INT(cg * 0.5), INT(cb * 0.5)
        CIRCLE STACK(1, hdx + (HEAD_R + 7 * DS) * COS(hda), hdy + (HEAD_R + 7 * DS) * SIN(hda), hda * 0 + 7 * DS), TRUE
        NEON hdx - HEAD_R - 9 * DS, hdy + 2 * DS, shx - 18 * DS, shy, nw, cr * 0.6, cg * 0.6, cb * 0.6
        NEON hdx + HEAD_R + 9 * DS, hdy + 2 * DS, shx + 18 * DS, shy, nw, cr * 0.6, cg * 0.6, cb * 0.6
        NEON hdx - ex - 9 * DS, hdy - 4 * DS, hdx + ex + 9 * DS, hdy - 4 * DS, nw + 2, 255, 60, 200
    ELSEIF outfit$ = "unicorn" THEN
        ' a striped party hat with a pompom, a bow tie at the neck
        DIM hpk = IOTA(INT(46 * DS), 0)
        DIM hpw = 20 * DS * (1 - hpk / (46 * DS))
        DIM hph = hpk * 0.09 + cyc * 2
        LINE STACK(1, hdx - hpw, hdy - HEAD_R - hpk, hdx + hpw, hdy - HEAD_R - hpk), STACK(1, INT(128 + 127 * SIN(hph)), INT(128 + 127 * SIN(hph + 2.1)), INT(128 + 127 * SIN(hph + 4.2)))
        DRAWCOLOR 255, 255, 255
        CIRCLE hdx, hdy - HEAD_R - 46 * DS, 6 * DS, TRUE
        DRAWCOLOR 255, 215, 90
        CIRCLE nkx - 9 * DS, nky + 5 * DS, 6 * DS, TRUE
        CIRCLE nkx + 9 * DS, nky + 5 * DS, 6 * DS, TRUE
        CIRCLE nkx, nky + 5 * DS, 3 * DS, TRUE
    ELSE
        ' a cap, the brim towards her
        DIM ck = IOTA(16, 0)
        DIM cw = SQR(HEAD_R * HEAD_R - (HEAD_R - ck - 2) ^ 2 + 0.1)
        DRAWCOLOR 255, 170, 40
        LINE STACK(1, hdx - cw, hdy - HEAD_R + ck, hdx + cw, hdy - HEAD_R + ck)
        NEON hdx - HEAD_R, hdy - HEAD_R + 16, hdx + HEAD_R + 26, hdy - HEAD_R + 16, 1, 255, 170, 40
    ENDIF
ENDSUB

' Purple nebula clouds drifting through the sky, a shooting star every two bars
SUB DRAW_NEBULA(cyc AS DOUBLE)
    DIM sc AS DOUBLE = SW / 1080
    DIM nx = [0.18, 0.8, 0.48, 0.9, 0.28] * SW + 40 * sc * SIN(cyc * 0.2 + IOTA(5, 0))
    DIM ny = [0.22, 0.34, 0.1, 0.62, 0.58] * (HORIZON - 100)
    DIM nr = [260, 220, 300, 180, 210] * sc
    DIM ncol = STACK(1, [6, 9, 4, 8, 5], [2, 1, 3, 2, 2], [10, 8, 11, 9, 10])
    DIM k AS INTEGER
    FOR k = 1 TO 9
        CIRCLE STACK(1, nx, ny, nr * (1.12 - k * 0.11)), TRUE, ncol
    NEXT k
    DIM sp AS DOUBLE = FRACT(cyc / 2)
    IF sp < 0.3 THEN
        DIM which AS INTEGER = INT(cyc / 2)
        DIM prog AS DOUBLE = sp / 0.3
        DIM sx AS DOUBLE = SW * (0.12 + 0.45 * FRACT(which * 0.618)) + prog * 420 * sc
        DIM sy AS DOUBLE = HORIZON * (0.08 + 0.25 * FRACT(which * 0.381)) + prog * 170 * sc
        DIM fade AS DOUBLE = 1 - prog
        NEON sx - 150 * sc, sy - 60 * sc, sx, sy, 1, 120 * fade, 90 * fade, 200 * fade
        NEON_RING sx, sy, 3 * sc, 255 * fade, 240 * fade, 255 * fade
    ENDIF
ENDSUB

' Green digital rain falling down to the horizon
SUB DRAW_RAIN(cyc AS DOUBLE)
    DIM n AS INTEGER = 36
    DIM ix = IOTA(n, 0)
    DIM rx = ix * (SW / n) + SW / n / 2
    DIM speed = 0.6 + (ix * 0.618 - INT(ix * 0.618)) * 0.9
    DIM fall = cyc * speed / 2 + ix * 0.377
    DIM head = (fall - INT(fall)) * (HORIZON + 300) - 100
    DIM j AS INTEGER
    FOR j = 0 TO 9
        DIM lev AS DOUBLE = 1 - j / 10
        DIM yy = head - j * 26
        yy = yy + (yy > HORIZON - 16) * 9999
        IF j = 0 THEN
            DRAWCOLOR 190, 255, 200
        ELSE
            DRAWCOLOR INT(30 * lev), INT(210 * lev), INT(80 * lev)
        ENDIF
        LINE STACK(1, rx, yy, rx, yy + 14)
        LINE STACK(1, rx + 1, yy, rx + 1, yy + 14)
    NEXT j
ENDSUB

' Soft clouds drifting across the sky
SUB DRAW_CLOUDS(cyc AS DOUBLE)
    DIM sc AS DOUBLE = SW / 1080
    GFX.BLEND "BLEND"
    DRAWCOLOR 200, 190, 235, 40
    DIM k AS INTEGER
    FOR k = 0 TO 3
        DIM drift AS DOUBLE = FRACT(k * 0.29 + cyc * 0.02 * (1 + k * 0.3))
        DIM cx AS DOUBLE = drift * (SW + 400 * sc) - 200 * sc
        DIM cy AS DOUBLE = HORIZON * (0.14 + k * 0.17)
        DIM s AS DOUBLE = (50 + k * 8) * sc
        CIRCLE STACK(1, cx + [-1.2, -0.4, 0.4, 1.2, 0] * s, cy + [0.2, -0.1, -0.2, 0.2, -0.6] * s, [0.6, 0.8, 0.8, 0.6, 0.7] * s), TRUE
    NEXT k
    GFX.BLEND "ADD"
ENDSUB

' A full moon off to the side of the dancer, r as wide as the sun would be
SUB DRAW_MOON(r AS DOUBLE)
    DIM mr AS DOUBLE = r * 0.62
    DIM mx AS DOUBLE = MID_X + SW * 0.27
    DIM my AS DOUBLE = HORIZON - r * 2
    DIM ry = IOTA(INT(2 * mr), 0)
    DIM half = SQR(ry * (2 * mr - ry))
    DIM t = ry / (2 * mr)
    GFX.BLEND "BLEND"
    LINE STACK(1, mx - half, my - mr + ry, mx + half, my - mr + ry), STACK(1, INT(sun_top[0] + (sun_bot[0] - sun_top[0]) * t), INT(sun_top[1] + (sun_bot[1] - sun_top[1]) * t), INT(sun_top[2] + (sun_bot[2] - sun_top[2]) * t))
    DRAWCOLOR INT(sun_bot[0] * 0.75), INT(sun_bot[1] * 0.75), INT(sun_bot[2] * 0.8)
    CIRCLE STACK(1, mx + [-0.4, 0.32, 0.05, -0.12, 0.5] * mr, my + [-0.25, 0.18, -0.5, 0.45, -0.3] * mr, [0.17, 0.23, 0.1, 0.12, 0.07] * mr), TRUE
    GFX.BLEND "ADD"
    NEON_RING mx, my, mr + 10, 110, 70, 190
    NEON_RING mx, my, mr + 28, 50, 30, 100
ENDSUB

' A rainbow of seven bands standing on the horizon, brighter on the kick
SUB DRAW_RAINBOW(r AS DOUBLE, glow AS DOUBLE)
    DIM br = [255, 255, 255, 70, 40, 100, 180]
    DIM bg = [50, 140, 230, 220, 150, 70, 60]
    DIM bb = [70, 40, 60, 90, 255, 255, 230]
    DIM d = IOTA(INT(r), 0)
    DIM lev AS DOUBLE = 0.7 + 0.3 * glow
    DIM k AS INTEGER
    FOR k = 0 TO 6
        DIM ro AS DOUBLE = r * (1 - k * 0.065)
        DIM ri AS DOUBLE = r * (1 - (k + 1) * 0.065)
        DIM qo = ro * ro - d * d
        DIM qi = ri * ri - d * d
        DIM ring_out = SQR(qo * (qo > 0))
        DIM ring_in = SQR(qi * (qi > 0))
        DIM off = (qo <= 0) * 9999
        DRAWCOLOR INT(br[k] * lev), INT(bg[k] * lev), INT(bb[k] * lev)
        LINE STACK(1, MID_X - ring_out - off, HORIZON - d, MID_X - ring_in - off, HORIZON - d)
        LINE STACK(1, MID_X + ring_in + off, HORIZON - d, MID_X + ring_out + off, HORIZON - d)
    NEXT k
ENDSUB

' The running sweeps of tracks that play, newest on top
SUB DRAW_MODS(cyc AS DOUBLE)
    DIM px AS DOUBLE = 1530
    DIM pw AS DOUBLE = 360
    DIM ph AS DOUBLE = 96
    DIM shown AS INTEGER = 0
    DIM n AS INTEGER = 90
    DIM i AS INTEGER
    FOR i = SCORE.SWEEPS() - 1 TO 0 STEP -1
        IF shown >= 5 THEN EXITFOR
        DIM st AS INTEGER = SCORE.SWEEP_TRACK(i)
        IF NOT SCORE.SWEEP_ON(i, cyc) ORELSE NOT live[st] THEN CONTINUEFOR
        DIM shape$ AS STRING = SCORE.SWEEP_SHAPE$(i)
        DIM per AS DOUBLE = SCORE.SWEEP_CYCLES(i)
        DIM off AS DOUBLE = SCORE.SWEEP_OFFSET(i)
        DIM y0 AS DOUBLE = 28 + shown * (ph + 14)
        GFX.BLEND "BLEND"
        DRAWCOLOR 8, 6, 24, 190
        RECT px, y0, pw, ph, TRUE
        GFX.BLEND "ADD"
        DRAWCOLOR 70, 50, 140
        RECT px, y0, pw, ph, FALSE
        ' two periods, the playhead at three quarters
        DIM ts = cyc + (IOTA(n, 0) / (n - 1) - 0.75) * 2 * per
        ts = ts * (ts > 0)
        DIM vals = SHAPE_AT(shape$, ts / per + off)
        DIM xs = px + 10 + IOTA(n, 0) * ((pw - 20) / (n - 1))
        DIM ys = y0 + ph - 10 - vals * (ph - 36)
        DIM hue AS DOUBLE = st * 0.9
        DIM r AS INTEGER = INT(140 + 115 * SIN(hue))
        DIM g AS INTEGER = INT(140 + 115 * SIN(hue + 2.1))
        DIM b AS INTEGER = INT(140 + 115 * SIN(hue + 4.2))
        DRAWCOLOR INT(r * 0.3), INT(g * 0.3), INT(b * 0.3)
        LINE STACK(1, TAKE(n - 1, xs), TAKE(n - 1, ys) + 2, DROP(1, xs), DROP(1, ys) + 2)
        LINE STACK(1, TAKE(n - 1, xs), TAKE(n - 1, ys) - 2, DROP(1, xs), DROP(1, ys) - 2)
        DRAWCOLOR r, g, b
        LINE STACK(1, TAKE(n - 1, xs), TAKE(n - 1, ys), DROP(1, xs), DROP(1, ys))
        DIM phx AS DOUBLE = px + 10 + 0.75 * (pw - 20)
        DIM nowa = SHAPE_AT(shape$, [cyc / per + off])
        DIM nowv AS DOUBLE = nowa[0]
        DRAWCOLOR 60, 60, 90
        LINE phx, y0 + 26, phx, y0 + ph - 6
        NEON_RING phx, y0 + ph - 10 - nowv * (ph - 36), 5, r, g, b
        DIM lo AS DOUBLE = SCORE.SWEEP_LO(i)
        DIM hi AS DOUBLE = SCORE.SWEEP_HI(i)
        DIM mval AS DOUBLE = lo + (hi - lo) * nowv
        DIM mtxt$ AS STRING = STR$(INT(mval))
        IF ABS(hi) < 10 THEN mtxt$ = STR$(INT(mval * 100) / 100)
        TEXT px + 10, y0 + 5, SCORE.TRACK_NAME$(st) + " " + SCORE.SWEEP_PARAM$(i) + "  " + shape$, r, g, b
        TEXT px + pw - 70, y0 + 5, mtxt$, 220, 220, 240
        shown = shown + 1
    NEXT i
ENDSUB

SUB DRAW_CONSOLE(cyc AS DOUBLE)
    DIM x0 AS DOUBLE = 28
    DIM y0 AS DOUBLE = 812
    DIM w AS DOUBLE = 560
    DIM h AS DOUBLE = 244
    GFX.BLEND "BLEND"
    DRAWCOLOR 6, 6, 18, 205
    RECT x0, y0, w, h, TRUE
    DRAWCOLOR 40, 30, 90, 230
    RECT x0, y0, w, 26, TRUE
    GFX.BLEND "ADD"
    DRAWCOLOR 90, 70, 180
    RECT x0, y0, w, h, FALSE
    TEXT x0 + 10, y0 + 3, "console   " + title$ + "   " + STR$(SCORE.BPM_OF()) + " BPM", 200, 190, 255
    TEXT x0 + w - 130, y0 + 3, CLOCK$(cyc) + "  bar " + STR$(INT(cyc)), 255, 220, 120
    DIM i AS INTEGER
    FOR i = 0 TO N_LOG - 1
        IF log_lines$[i] <> "" THEN
            IF i = N_LOG - 1 THEN
                TEXT x0 + 12, y0 + 32 + i * 23, "> " + log_lines$[i], 140, 255, 200
            ELSE
                TEXT x0 + 12, y0 + 32 + i * 23, "  " + log_lines$[i], 110, 120, 165
            ENDIF
        ENDIF
    NEXT i
ENDSUB

SUB CENTER_TEXT(y AS DOUBLE, size AS INTEGER, s$, r AS INTEGER, g AS INTEGER, b AS INTEGER)
    IF font$ <> "" THEN SETFONT font$, size
    DIM tsz = GFX.TEXTSIZE(s$)
    TEXT MID_X - tsz[0] / 2, y, s$, r, g, b
ENDSUB

' The intro of a rendered video: the series, the song, then 3-2-1
SUB DRAW_INTRO()
    GFX.BLEND "BLEND"
    DRAWCOLOR 4, 2, 12, 175
    RECT 0, 0, SW, SH, TRUE
    GFX.BLEND "ADD"
    DIM fade AS DOUBLE = CLAMP01((INTRO_SECONDS - intro_left) / 0.8)
    CENTER_TEXT 250, 34, SERIES$, INT(150 * fade), INT(190 * fade), INT(255 * fade)
    CENTER_TEXT 310, 110, title$, INT(title_rgb[0] * fade), INT(title_rgb[1] * fade), INT(title_rgb[2] * fade)
    DIM info$ AS STRING = STR$(SCORE.BPM_OF()) + " BPM"
    IF subtitle$ <> "" THEN info$ = subtitle$ + "   -   " + info$
    CENTER_TEXT 470, 30, info$, INT(200 * fade), INT(200 * fade), INT(230 * fade)
    IF intro_left < 3 THEN
        DIM digit AS INTEGER = INT(intro_left) + 1
        DIM part AS DOUBLE = intro_left - INT(intro_left)
        DIM ring AS DOUBLE = 70 + (1 - part) * 160
        NEON_RING 960, 740, ring, 255 * part, 120 * part, 230 * part
        CENTER_TEXT 640, INT(120 + 80 * part), STR$(digit), 255, 230, 255
    ENDIF
    IF font$ <> "" THEN SETFONT font$, 17
ENDSUB

' The words over a TikTok clip: the series always, the song for its
' first seconds, the name of each move as it starts. TikTok draws its own
' buttons over the top, the right and the bottom, so all of it stays in
' the middle band.
SUB DRAW_TIKTOK(cyc AS DOUBLE)
    DIM secs AS DOUBLE = (cyc - clip_from) * 240 / SCORE.BPM_OF()
    CENTER_TEXT 250, 34, SERIES$, 150, 190, 255
    DIM tf AS DOUBLE = 1 - CLAMP01((secs - 2.5) / 1)
    IF tf > 0 THEN
        CENTER_TEXT 300, 76, title$, INT(title_rgb[0] * tf), INT(title_rgb[1] * tf), INT(title_rgb[2] * tf)
        IF subtitle$ <> "" THEN CENTER_TEXT 400, 30, subtitle$, INT(200 * tf), INT(200 * tf), INT(230 * tf)
    ENDIF
    DIM into AS DOUBLE = cyc - clip_from - TT_BARS_PER_MOVE * INT((cyc - clip_from) / TT_BARS_PER_MOVE)
    DIM la AS DOUBLE = 1 - CLAMP01((into - 0.5) / 0.75)
    IF cyc >= clip_from ANDALSO la > 0 ANDALSO secs > 1.5 THEN
        DIM pop AS INTEGER = INT(64 + 16 * (1 - CLAMP01(into * 4)))
        CENTER_TEXT 590, pop, TT_LABELS$[TT_MOVE_AT(cyc)], INT(label_rgb[0] * la), INT(label_rgb[1] * la), INT(label_rgb[2] * la)
    ENDIF
    IF font$ <> "" THEN SETFONT font$, 17
ENDSUB

' ── The source of the song ──────────────────────────────────────

FUNC SRC_CYCLE() AS DOUBLE
    IF follow$ = "" THEN RETURN SOUND.CYCLE()
    IF a_cps <= 0 THEN RETURN a_cycle
    RETURN a_cycle + (NODE.TIME() - a_t) / 1000000000 * a_cps
ENDFUNC

FUNC SRC_WAVE()
    IF follow$ = "" THEN RETURN SOUND.GET_WAVE()
    RETURN src_wave
ENDFUNC

FUNC SRC_BUS()
    IF follow$ = "" THEN RETURN SOUND.GET_BUS_WAVE(0)
    RETURN src_bus
ENDFUNC

FUNC GOT(v) AS INTEGER
    RETURN NOT CHAN.IS_TIMEOUT(v) ANDALSO NOT CHAN.IS_EOF(v)
ENDFUNC

SUB TAKE_SCORE(m)
    SCORE.LOAD m{"SCORE"}
    title$ = m{"TITLE"}
    subtitle$ = m{"SUBTITLE"}
    IF NOT look_pinned ANDALSO MAP.EXISTS(m, "LOOK") THEN
        IF LCASE$(m{"LOOK"}) <> look$ THEN SET_LOOK LCASE$(m{"LOOK"})
    ENDIF
    kick_t = SCORE.TRACK_OF("KICK")
    clap_t = SCORE.TRACK_OF("CLAP")
    crash_t = SCORE.TRACK_OF("CRASH")
    sec_i = -1
    LOG_LINE "score: " + title$ + ", " + subtitle$
ENDSUB

SUB TAKE_CLOCK(m)
    a_cycle = m{"CYCLE"}
    a_t = NODE.TIME_OF(follow$, m{"T"})
    a_cps = m{"CPS"}
    a_epoch = m{"EPOCH"}
ENDSUB

' Takes what the followed node sent since the last frame
SUB SRC_POLL()
    DIM m = CHAN.TRY_RECV(sub_score)
    DO WHILE GOT(m)
        TAKE_SCORE m
        m = CHAN.TRY_RECV(sub_score)
    LOOP
    m = CHAN.TRY_RECV(sub_clock)
    IF GOT(m) THEN TAKE_CLOCK m
    m = CHAN.TRY_RECV(sub_scope)
    IF GOT(m) THEN
        src_wave = m{"MASTER"}
        src_bus = m{"BUS0"}
    ENDIF
    m = CHAN.TRY_RECV(src_events)
    DO WHILE GOT(m)
        IF m{"EVENT"} = "LEAVE" ANDALSO m{"ADDR"} = follow$ THEN src_gone = TRUE
        m = CHAN.TRY_RECV(src_events)
    LOOP
ENDSUB

SUB QUIT_SHOW(code AS INTEGER)
    IF follow$ = "" THEN SOUND.RESET
    END code
ENDSUB

SUB FRAME()
    DIM t0 AS DOUBLE = TICK()
    DIM dt AS DOUBLE = CLAMP01((t0 - last_tick) / 1000)
    IF dt > 0.1 THEN dt = 0.1
    IF render_dir$ <> "" THEN dt = 1 / RENDER_FPS
    last_tick = t0
    DIM cyc AS DOUBLE = SRC_CYCLE()
    DIM beat AS DOUBLE = cyc * 4
    DIM bf AS DOUBLE = FRACT(beat)
    DIM bar AS INTEGER = INT(cyc)
    DIM i AS INTEGER

    live = SCORE.LIVE_AT(cyc)
    DIM si AS INTEGER = SCORE.SECTION_AT(cyc)
    IF si <> sec_i ANDALSO si >= 0 ANDALSO intro_left < 0 THEN
        sec_i = si
        section_bar = SCORE.SECTION_BAR(si)
        sec_name$ = SCORE.SECTION_NAME$(si)
        mood$ = SCORE.SECTION_MOOD$(si)
        LOG_LINE CLOCK$(section_bar) + "  bar " + STR$(section_bar) + "  " + sec_name$
        IF shots$ <> "" THEN
            shot_at = section_bar + 1.6
            shot_name$ = "bar" + STR$(section_bar)
        ENDIF
    ENDIF

    DIM kick_on AS INTEGER = IS_LIVE(kick_t) ANDALSO intro_left < 0
    DIM kick_env AS DOUBLE = 0
    IF kick_on THEN kick_env = EXP(-bf * 6)
    DIM drop_on AS INTEGER = (mood$ = "jump")

    ' beat and bar events
    IF INT(beat) > INT(prev_cyc * 4) THEN
        DIM bib AS INTEGER = INT(beat) - 4 * INT(INT(beat) / 4)
        IF drop_on ANDALSO kick_on THEN
            SPAWN 0, MID_X - 200 * DS, FLOOR_Y, 5, 3.6
            SPAWN 0, MID_X + 200 * DS, FLOOR_Y, 5, 5.2
        ENDIF
        IF mood$ = "wave" ANDALSO (bib = 0 OR bib = 2) ANDALSO NOT tiktok THEN SPAWN 1, MID_X + (RND(1) - 0.5) * 260, HORIZON + 60, 1, 0
        IF tiktok ANDALSO TT_MOVES$[TT_MOVE_AT(cyc)] = "heart" THEN SPAWN 1, MID_X + (RND(1) - 0.5) * 140 * DS, FLOOR_Y - 470 * DS, 1, 0
        IF IS_LIVE(clap_t) ANDALSO (bib = 1 OR bib = 3) THEN flash = MAX([flash, 0.1])
    ENDIF
    IF bar > INT(prev_cyc) ANDALSO IS_LIVE(crash_t) ANDALSO bar - 8 * INT(bar / 8) = 0 THEN
        flash = 0.85
        SPAWN 2, MID_X, HORIZON - 80, 70, RND(1) * 6
    ENDIF
    IF mood$ = "rise" THEN
        DIM prog AS DOUBLE = CLAMP01((cyc - section_bar) / 8)
        IF prog > 0.75 ANDALSO INT(cyc * 16) > INT(prev_cyc * 16) THEN flash = MAX([flash, (prog - 0.6) * 1.1])
    ENDIF
    prev_cyc = cyc

    ' level and spectrum of the master
    DIM wave = SRC_WAVE()
    DIM nw AS INTEGER = LEN(wave)
    energy = energy * 0.9 + SQR(SUM(wave * wave) / nw) * 0.1
    DIM fq = FFT(wave)
    DIM re = SLICE(fq, 1, 0)
    DIM im = SLICE(fq, 1, 1)
    DIM mag = SQR(re * re + im * im)
    FOR i = 0 TO N_BANDS - 1
        DIM bv AS DOUBLE = MAX(TAKE(band_hi[i] - band_lo[i], DROP(band_lo[i], mag)))
        bv = CLAMP01(LOG(1 + bv * (0.3 + i * 0.04)) / 3.4)
        IF bv > spec[i] THEN
            spec[i] = bv
        ELSE
            spec[i] = spec[i] * 0.9
        ENDIF
    NEXT i

    ' sky, tinted per section, brightening on the kick
    DIM hue AS DOUBLE = section_bar * 0.11
    DIM sr AS DOUBLE = 0.5 + 0.5 * SIN(hue)
    DIM sg AS DOUBLE = 0.5 + 0.5 * SIN(hue + 2.1)
    DIM sb AS DOUBLE = 0.5 + 0.5 * SIN(hue + 4.2)
    IF look$ = "rainbow" THEN
        sr = 0.5 + 0.5 * SIN(cyc)
        sg = 0.5 + 0.5 * SIN(cyc + 2.1)
        sb = 0.5 + 0.5 * SIN(cyc + 4.2)
    ELSEIF look$ <> "classic" THEN
        sr = acc_r / 255
        sg = acc_g / 255
        sb = acc_b / 255
    ENDIF
    IF look$ = "classic" THEN
        CLS INT(6 + 34 * kick_env * sr), INT(3 + 16 * kick_env * sg), INT(16 + 38 * kick_env * sb)
    ELSEIF look$ = "rainbow" THEN
        CLS INT(sky_r + 12 * kick_env * sr), INT(sky_g + 12 * kick_env * sg), INT(sky_b + 20 * kick_env)
    ELSE
        CLS INT(sky_r + 30 * kick_env * sr), INT(sky_g + 30 * kick_env * sg), INT(sky_b + 30 * kick_env * sb)
    ENDIF
    GFX.BLEND "ADD"
    IF backdrop$ = "moon" THEN DRAW_NEBULA cyc
    IF backdrop$ = "rain" THEN
        DRAW_RAIN cyc
    ELSE
        DIM tw = INT(30 + 150 * (0.5 + 0.5 * SIN(star_ph + cyc * 3)))
        CIRCLE STACK(1, star_x, star_y, star_x * 0 + 1.5), TRUE, STACK(1, tw, tw, tw + 30)
    ENDIF
    IF backdrop$ = "rainbow" THEN DRAW_CLOUDS cyc

    ' on the horizon a striped sun, a moon or a rainbow, swelling with the kick
    DIM sun_r AS DOUBLE = (230 + 22 * kick_env + 70 * energy) * SUN_SCALE
    IF backdrop$ = "moon" THEN
        DRAW_MOON sun_r
    ELSEIF backdrop$ = "rainbow" THEN
        DRAW_RAINBOW sun_r * 1.25, kick_env
    ELSE
        DIM sy = IOTA(INT(sun_r), 0)
        DIM scroll = sy + INT(FRACT(cyc) * 24)
        DIM cut = (sy > sun_r * 0.5) * ((scroll - 24 * INT(scroll / 24)) < 3 + 7 * sy / sun_r)
        DIM shalf = SQR(sun_r * sun_r - (sun_r - sy) ^ 2) * (1 - cut)
        DIM tcol = sy / sun_r
        LINE STACK(1, MID_X - shalf, HORIZON - sun_r + sy, MID_X + shalf, HORIZON - sun_r + sy), STACK(1, INT(sun_top[0] + (sun_bot[0] - sun_top[0]) * tcol), INT(sun_top[1] + (sun_bot[1] - sun_top[1]) * tcol), INT(sun_top[2] + (sun_bot[2] - sun_top[2]) * tcol))
    ENDIF

    ' spectrum skyline either side of the sun
    DIM bx = IOTA(N_BANDS, 0) * BAND_DX
    DIM bh = spec * 300 + 3
    DIM bcols = STACK(1, INT(band_lo_rgb[0] + (band_hi_rgb[0] - band_lo_rgb[0]) * spec), INT(band_lo_rgb[1] + (band_hi_rgb[1] - band_lo_rgb[1]) * spec), INT(band_lo_rgb[2] + (band_hi_rgb[2] - band_lo_rgb[2]) * spec))
    IF look$ = "rainbow" THEN
        DIM bhue = IOTA(N_BANDS, 0) * 0.16 + cyc
        DIM blev = 0.45 + 0.55 * spec
        bcols = STACK(1, INT((128 + 127 * SIN(bhue)) * blev), INT((128 + 127 * SIN(bhue + 2.1)) * blev), INT((128 + 127 * SIN(bhue + 4.2)) * blev))
    ENDIF
    RECT STACK(1, MID_X + 254 * BAND_DX / 17 + bx, HORIZON - bh, bx * 0 + BAND_W, bh), TRUE, bcols
    RECT STACK(1, MID_X - 267 * BAND_DX / 17 - bx, HORIZON - bh, bx * 0 + BAND_W, bh), TRUE, bcols

    ' the floor grid races towards the viewer, a line every two beats
    DIM gb AS DOUBLE = 0.35 + 0.65 * kick_env
    DIM gz = IOTA(18, 1) - FRACT(beat * 0.5)
    DIM gy = HORIZON + (SH - HORIZON) * 0.9 / gz
    DIM vx = IOTA(25, 0) - 12
    IF look$ = "rainbow" THEN
        DIM gh = IOTA(18, 1) * 0.7 - cyc
        LINE STACK(1, gy * 0, gy, gy * 0 + SW, gy), STACK(1, INT((128 + 127 * SIN(gh)) * gb), INT((128 + 127 * SIN(gh + 2.1)) * gb), INT((128 + 127 * SIN(gh + 4.2)) * gb))
        DIM vh = vx * 0.26 + cyc
        LINE STACK(1, MID_X + vx * 14, vx * 0 + HORIZON, MID_X + vx * 240, vx * 0 + SH), STACK(1, INT((128 + 127 * SIN(vh)) * gb), INT((128 + 127 * SIN(vh + 2.1)) * gb), INT((128 + 127 * SIN(vh + 4.2)) * gb))
        DRAWCOLOR INT(255 * gb), INT(255 * gb), INT(255 * gb)
    ELSE
        DRAWCOLOR INT(grid_rgb[0] * gb), INT(grid_rgb[1] * gb), INT(grid_rgb[2] * gb)
        LINE STACK(1, gy * 0, gy, gy * 0 + SW, gy)
        LINE STACK(1, MID_X + vx * 14, vx * 0 + HORIZON, MID_X + vx * 240, vx * 0 + SH)
        DRAWCOLOR INT(hline_rgb[0] * gb), INT(hline_rgb[1] * gb), INT(hline_rgb[2] * gb)
    ENDIF
    LINE 0, HORIZON, SW, HORIZON

    ' the master scope across the sky, the reverb bus beneath it
    DIM scope_gain AS DOUBLE = 1
    IF tiktok THEN scope_gain = CLAMP01(((cyc - clip_from) * 240 / SCORE.BPM_OF() - 2.5) / 1)
    DIM wx = 40 + IOTA(nw, 0) * (SCOPE_W / nw)
    DIM wy = SCOPE_Y + wave * SCOPE_AMP * scope_gain
    DIM bus = SRC_BUS()
    DIM by = SCOPE_Y + BUS_GAP + bus * BUS_AMP * scope_gain
    DRAWCOLOR INT(40 + 60 * sb), INT(30 + 60 * sg), INT(50 + 80 * sr)
    LINE STACK(1, TAKE(nw - 1, wx), TAKE(nw - 1, by), DROP(1, wx), DROP(1, by))
    DRAWCOLOR INT(40 * sr), INT(80 * sg), INT(90 * sb)
    LINE STACK(1, TAKE(nw - 1, wx), TAKE(nw - 1, wy) + 3, DROP(1, wx), DROP(1, wy) + 3)
    LINE STACK(1, TAKE(nw - 1, wx), TAKE(nw - 1, wy) - 3, DROP(1, wx), DROP(1, wy) - 3)
    DRAWCOLOR INT(120 + 135 * sr), INT(120 + 135 * sg), INT(120 + 135 * sb)
    LINE STACK(1, TAKE(nw - 1, wx), TAKE(nw - 1, wy), DROP(1, wx), DROP(1, wy))
    IF NOT tiktok THEN
        TEXT 44, 34, "MASTER", 150, 150, 200
        TEXT 44, 296, "REVERB BUS", 110, 110, 150
    ENDIF

    ' a shock ring on the floor with every kick
    IF kick_on THEN
        DIM rr AS DOUBLE = 60 + bf * 900
        DIM rl AS DOUBLE = (1 - bf) * (1 - bf)
        DRAWCOLOR INT(255 * rl * sr), INT(200 * rl * sg), INT(255 * rl * sb)
        ELLIPSE MID_X, FLOOR_Y + 10, rr, rr * 0.18, FALSE
        ELLIPSE MID_X, FLOOR_Y + 10, rr + 2, rr * 0.18 + 1, FALSE
    ENDIF

    ' lasers sweep the floor in the drops
    IF drop_on THEN
        DIM k AS INTEGER
        FOR k = 0 TO 5
            DIM lx AS DOUBLE = SW * 0.0625
            IF k >= 3 THEN lx = SW * 0.9375
            DIM tx AS DOUBLE = MID_X + SW * 0.427 * SIN(cyc * TWO_PI / 4 + k * 1.1)
            DIM lh AS DOUBLE = k * 1.05 + cyc
            IF laser_mode = 1 THEN
                NEON lx, -10, tx, FLOOR_Y + 120, 0, 190 + 60 * SIN(lh), 70 + 50 * SIN(lh + 2.1), 255
            ELSEIF laser_mode = 2 THEN
                NEON lx, -10, tx, FLOOR_Y + 120, 0, 90 + 90 * SIN(lh), 255, 90 + 60 * SIN(lh + 2.1)
            ELSE
                NEON lx, -10, tx, FLOOR_Y + 120, 0, 120 + 120 * SIN(lh), 120 + 120 * SIN(lh + 2.1), 120 + 120 * SIN(lh + 4.2)
            ENDIF
        NEXT k
    ENDIF

    IF look$ = "rainbow" THEN
        girl_r = HUE_R(cyc * 0.5)
        girl_g = HUE_G(cyc * 0.5)
        girl_b = HUE_B(cyc * 0.5)
        boy_r = HUE_R(cyc * 0.5 + MATH.PI)
        boy_g = HUE_G(cyc * 0.5 + MATH.PI)
        boy_b = HUE_B(cyc * 0.5 + MATH.PI)
    ENDIF
    IF tiktok THEN
        DANCER MID_X, TRUE, cyc, girl_r, girl_g, girl_b
    ELSE
        DANCER 760, FALSE, cyc, boy_r, boy_g, boy_b
        DANCER 1160, TRUE, cyc, girl_r, girl_g, girl_b
    ENDIF

    ' particles; confetti and sparks fall, hearts float
    p_x = p_x + p_vx * dt
    p_y = p_y + p_vy * dt
    p_vy = p_vy + (p_kind <> 1) * 700 * dt
    p_life = p_life - dt
    DIM alive = (p_life > 0) * 1
    DIM dots = alive * (p_kind <> 1)
    DIM pfade = alive * (p_life > 0.5) + alive * (p_life <= 0.5) * p_life * 2
    DIM pcol = STACK(1, INT((128 + 127 * SIN(p_hue)) * pfade), INT((128 + 127 * SIN(p_hue + 2.1)) * pfade), INT((128 + 127 * SIN(p_hue + 4.2)) * pfade))
    CIRCLE STACK(1, p_x + (1 - dots) * 9999, p_y, 2 + (p_kind = 2) * 3), TRUE, pcol
    FOR i = 0 TO N_PART - 1
        IF p_kind[i] = 1 ANDALSO p_life[i] > 0 THEN
            DIM hl AS DOUBLE = CLAMP01(p_life[i] / 2)
            FILL_HEART p_x[i], p_y[i], 14 * DS, INT(255 * hl), INT(60 * hl), INT(140 * hl)
        ENDIF
    NEXT i

    ' white flashes: crash, clap, the end of a riser
    IF flash > 0.01 THEN
        DIM fw AS INTEGER = INT(255 * CLAMP01(flash) * FLASH_MAX)
        DRAWCOLOR fw, fw, fw
        RECT 0, 0, SW, SH, TRUE
    ENDIF
    flash = flash * 0.86

    IF tiktok THEN
        DRAW_TIKTOK cyc
    ELSE
        DRAW_MODS cyc
        DRAW_CONSOLE cyc
    ENDIF

    ' the section title, fading over two bars
    DIM ta AS DOUBLE = 1 - CLAMP01((cyc - section_bar) / 2)
    IF ta > 0 ANDALSO sec_name$ <> "" ANDALSO NOT tiktok THEN
        IF font$ <> "" THEN SETFONT font$, 44
        DIM tsz = GFX.TEXTSIZE(sec_name$)
        TEXT MID_X - tsz[0] / 2, 440, sec_name$, INT(255 * ta), INT(230 * ta), INT(255 * ta)
        IF font$ <> "" THEN SETFONT font$, 17
    ENDIF
    IF intro_left >= 0 THEN DRAW_INTRO
    GFX.BLEND "NONE"

    IF shot_at >= 0 ANDALSO cyc >= shot_at THEN
        GFX.SAVE_SCREENSHOT shots$ + "/" + shot_name$ + ".png"
        shot_at = -1
    ENDIF
    IF render_dir$ <> "" THEN
        GFX.SAVE_SCREENSHOT render_dir$ + "/f" + FORMAT$("{:0>5}", frame_no) + ".jpg"
        ' a still of each move once its name has faded, for the cover
        IF tiktok ANDALSO (cyc - clip_from) * 240 / SCORE.BPM_OF() >= 4 THEN
            DIM cover_k AS INTEGER = INT((cyc - clip_from) / TT_BARS_PER_MOVE)
            IF cover_k > tt_cover_done ANDALSO cyc - clip_from - TT_BARS_PER_MOVE * cover_k >= 1.5 THEN
                GFX.SAVE_SCREENSHOT render_dir$ + "/cover_" + STR$(cover_k) + "_" + TT_MOVES$[TT_MOVE_AT(cyc)] + ".png"
                tt_cover_done = cover_k
            ENDIF
        ENDIF
        frame_no = frame_no + 1
    ENDIF
    SCREENFLIP

    IF GFX.KEYSTATE("Escape") THEN QUIT_SHOW 0
    ' Q ends with status 3, which run_party.bat takes as "stop the party"
    IF GFX.KEYSTATE("Q") THEN QUIT_SHOW 3
    DIM key_f AS INTEGER = GFX.KEYSTATE("F")
    IF key_f ANDALSO NOT key_f_was THEN TOGGLE_FULLSCREEN
    key_f_was = key_f

    DIM spent AS DOUBLE = TICK() - t0
    n_frames = n_frames + 1
    frame_ms_sum = frame_ms_sum + spent
    IF spent > frame_ms_max THEN frame_ms_max = spent
    IF render_dir$ = "" THEN
        DIM wait_ms AS DOUBLE = next_tick - TICK()
        IF wait_ms > 1 THEN SLEEP INT(wait_ms)
        next_tick = MAX([next_tick + 1000 / 60, TICK()])
    ENDIF
ENDSUB

' A line under the title on the intro of a rendered video
EXPORT SUB SUBTITLE(s$)
    subtitle$ = s$
ENDSUB

' The show's options, added to the spec of the program that imports STAGE
EXPORT SUB OPTIONS(cli_spec)
    CLI.FLAG(cli_spec, "window", "", "a half-size window instead of fullscreen")
    CLI.OPT(cli_spec, "display", "", "the display to open on, of GFX.DISPLAYS()", "")
    CLI.OPT(cli_spec, "shots", "", "a frame of every section saved into this folder", "")
    CLI.OPT(cli_spec, "render", "", "an offline render into this folder: frames at 30 fps and audio.wav", "")
    CLI.FLAG(cli_spec, "tiktok", "", "portrait 1080x1920, the girl alone, a new move every two bars")
    CLI.OPT(cli_spec, "look", "", "the show: classic, purple, neon or rainbow", "")
    CLI.FLAG(cli_spec, "lan", "", "the Node Bus of the whole LAN, key in JDB_NODE_KEY")
ENDSUB

' Takes the parsed command line; a look given here stays, whatever a
' followed node publishes
EXPORT SUB CONFIGURE(parsed)
    windowed = parsed{"window"}
    IF parsed{"display"} <> "" THEN display_no = CINT(VAL(parsed{"display"}))
    shots$ = parsed{"shots"}
    render_dir$ = parsed{"render"}
    tiktok = parsed{"tiktok"}
    lan = parsed{"lan"}
    IF parsed{"look"} <> "" THEN
        SET_LOOK LCASE$(parsed{"look"})
        look_pinned = TRUE
    ENDIF
    configured = TRUE
ENDSUB

' The spec of the show on its own, for a song without options and for
' stage.jdb --follow
FUNC OWN_SPEC()
    DIM own = CLI.NEW("stage", "the show for a song: two dancers, the scope and the skyline")
    OPTIONS own
    CLI.FLAG(own, "follow", "", "follow the song another node plays, until that node leaves")
    CLI.ARG(own, "node", "the node to follow, songgen unless named", FALSE)
    RETURN own
ENDFUNC

' Opens the window and loads the font; reads the command line first when
' nobody did
SUB OPEN_SHOW()
    IF NOT configured THEN
        DIM spec = OWN_SPEC()
        DIM got = CLI.PARSE(spec, CLI.ARGV())
        IF CLI.DONE(spec, got) THEN END CLI.STATUS(got)
        CONFIGURE got
    ENDIF
    IF display_no >= 0 THEN GFX.DISPLAY display_no
    IF tiktok THEN
        SW = 1080
        SH = 1920
        MID_X = 540
        HORIZON = 1150
        FLOOR_Y = 1560
        DS = 2.05
        SCOPE_W = SW - 80
        SCOPE_Y = 340
        SCOPE_AMP = 110
        BUS_GAP = 150
        BUS_AMP = 130
        FLASH_MAX = 0.55
        SUN_SCALE = 0.68
        BAND_DX = 7
        BAND_W = 5
        star_x = RND(160) * SW
        star_y = RND(160) * (HORIZON - 60)
    ENDIF
    IF shots$ <> "" THEN windowed = TRUE
    ' the browser shows the canvas inside the page; fullscreen needs a gesture
    IF OS.GETOS$() = "WEB" THEN windowed = TRUE

    ' FFT bands, spaced logarithmically from 86 Hz to 7.7 kHz
    DIM bi AS INTEGER
    FOR bi = 0 TO N_BANDS - 1
        band_lo[bi] = INT(2 * 90 ^ (bi / N_BANDS))
        band_hi[bi] = MAX([band_lo[bi] + 1, INT(2 * 90 ^ ((bi + 1) / N_BANDS))])
    NEXT bi

    kick_t = SCORE.TRACK_OF("KICK")
    clap_t = SCORE.TRACK_OF("CLAP")
    crash_t = SCORE.TRACK_OF("CRASH")

    IF render_dir$ <> "" THEN
        SCREEN SW, SH, title$
    ELSEIF windowed THEN
        SCREEN SW, SH, title$, 0.5
    ELSE
        SCREEN SW, SH, title$
        TOGGLE_FULLSCREEN
    ENDIF
    DIM font_try$ = ["jdbasic_default.ttf", "/jdbasic_default.ttf", "build/jdbasic_default.ttf", "../../../build/jdbasic_default.ttf"]
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(font_try$) - 1
        IF font$ = "" THEN
            TRY
                SETFONT font_try$[fi], 17
                font$ = font_try$[fi]
            CATCH
            ENDTRY
        ENDIF
    NEXT fi
    last_tick = TICK()
ENDSUB

' Opens the window and plays the queued score to its last bar
' The clip a TikTok render keeps: a bar of run-up, then the first drop for
' as many whole four-bar phrases as fit into TT_MAX_SECONDS
SUB TT_CLIP()
    DIM drop_bar AS DOUBLE = -1
    DIM i AS INTEGER
    FOR i = 0 TO SCORE.SECTIONS() - 1
        IF drop_bar < 0 ANDALSO LEFT$(SCORE.SECTION_NAME$(i), 4) = "drop" THEN drop_bar = SCORE.SECTION_BAR(i)
    NEXT i
    FOR i = 0 TO SCORE.SECTIONS() - 1
        IF drop_bar < 0 ANDALSO SCORE.SECTION_MOOD$(i) = "jump" THEN drop_bar = SCORE.SECTION_BAR(i)
    NEXT i
    IF drop_bar < 1 THEN drop_bar = 8
    DIM bars_fit AS DOUBLE = TT_MAX_SECONDS * SCORE.BPM_OF() / 240 - 1
    DIM body AS DOUBLE = 4 * INT(bars_fit / 4)
    IF body < 4 THEN body = 4
    clip_from = drop_bar - 1
    clip_to = drop_bar + body
    IF clip_to > SCORE.END_BAR() THEN clip_to = SCORE.END_BAR()
    ' each song starts at another move of the list
    DIM spin AS INTEGER = INT(drop_bar * 7 + SCORE.BPM_OF())
    tt_offset = spin - LEN(TT_MOVES$) * INT(spin / LEN(TT_MOVES$))
ENDSUB

EXPORT SUB RUN(name$)
    title$ = name$
    OPEN_SHOW
    IF tiktok THEN TT_CLIP
    IF render_dir$ <> "" ANDALSO tiktok THEN
        ' the song up to the clip is mixed but not filmed
        DO WHILE SOUND.CYCLE() < clip_from
            DIM skipped = SOUND.RENDER(4410)
        LOOP
        SOUND.RECORD render_dir$ + "/audio.wav"
        DIM tslice AS INTEGER = INT(44100 / RENDER_FPS)
        DO WHILE SOUND.CYCLE() < clip_to
            FRAME
            DIM trendered = SOUND.RENDER(tslice)
        LOOP
        SOUND.RECORD
        PRINT "rendered "; frame_no; " frames, avg "; INT(frame_ms_sum / n_frames); " ms, bars "; clip_from; " to "; clip_to
    ELSEIF render_dir$ <> "" THEN
        ' the mixer runs offline: each frame draws, then renders its
        ' slice of audio into the WAV the video gets
        DIM f AS INTEGER
        FOR f = 0 TO INT(INTRO_SECONDS * RENDER_FPS) - 1
            intro_left = INTRO_SECONDS - f / RENDER_FPS
            FRAME
        NEXT f
        intro_left = -1
        SOUND.RECORD render_dir$ + "/audio.wav"
        DIM slice AS INTEGER = INT(44100 / RENDER_FPS)
        DO WHILE SOUND.CYCLE() < SCORE.END_BAR()
            FRAME
            DIM rendered = SOUND.RENDER(slice)
        LOOP
        SOUND.RECORD
        PRINT "rendered "; frame_no; " frames, avg "; INT(frame_ms_sum / n_frames); " ms"
    ELSE
        DO WHILE SOUND.CYCLE() < SCORE.END_BAR()
            FRAME
        LOOP
    ENDIF
    SOUND.RESET
    IF shots$ <> "" THEN PRINT "frames: "; n_frames; "  avg ms: "; INT(frame_ms_sum / n_frames * 10) / 10; "  max ms: "; INT(frame_ms_max)
ENDSUB

' Follows the song node source$ publishes (song/score, song/clock,
' song/scope) until that node leaves
EXPORT SUB FOLLOW(source$)
    follow$ = source$
    DIM at_sign AS INTEGER = INSTR(follow$, "@")
    IF at_sign >= 0 THEN follow$ = LEFT$(follow$, at_sign)
    DIM me$ AS STRING = "stage"
    IF LEN(NODE.PEERS(me$)) > 0 THEN me$ = "stage-" + STR$(OS.PID())
    DIM scope$ AS STRING = "local"
    IF lan THEN scope$ = "lan"
    DIM self_node = NODE.JOIN(me$, scope$)
    src_events = NODE.EVENTS()
    sub_score = TOPIC.SUBSCRIBE("song/score", "queue:4")
    sub_clock = TOPIC.SUBSCRIBE("song/clock", "latest")
    sub_scope = TOPIC.SUBSCRIBE("song/scope", "latest")
    IF NOT NODE.FIND(follow$, 10000) THEN
        PRINT "stage: no node "; follow$
        END 1
    ENDIF
    DIM first = CHAN.RECV(sub_score, 10000)
    IF NOT GOT(first) THEN
        PRINT "stage: "; follow$; " publishes no song/score"
        END 1
    ENDIF
    TAKE_SCORE first
    DIM first_clock = CHAN.RECV(sub_clock, 5000)
    IF GOT(first_clock) THEN TAKE_CLOCK first_clock
    OPEN_SHOW
    DO WHILE NOT src_gone
        SRC_POLL
        FRAME
    LOOP
    NODE.LEAVE
ENDSUB

' Run as a program: jdBasic stage.jdb --follow [node]
DIM stage_cli = OS.ARGS()
IF LEN(stage_cli) > 1 ANDALSO INSTR(LCASE$(stage_cli[0]), "stage.jdb") >= 0 THEN
    DIM own_spec = OWN_SPEC()
    DIM own_got = CLI.PARSE(own_spec, CLI.ARGV())
    IF CLI.DONE(own_spec, own_got) THEN END CLI.STATUS(own_got)
    CONFIGURE own_got
    IF own_got{"follow"} THEN
        DIM follow_node$ AS STRING = "songgen"
        IF LEN(own_got{"args"}) > 0 THEN follow_node$ = own_got{"args"}[0]
        FOLLOW follow_node$
    ENDIF
ENDIF
