' boot_sequence.jdb - "Boot Sequence", techno in A minor, 48 bars at
' 124 BPM (about a minute and a half), with the BOOTLOG scene.
'
'   0 power on    8 kernel     16 userland   24 build    28 drop
'  40 shutdown   48 end
'
' Usage: jdBasic boot_sequence.jdb [--window] [--render dir]
'   Esc quits.

OPTION "EXPLICIT"

IMPORT SCORE
IMPORT BOOTLOG

DIM BPM AS DOUBLE = 124

DIM KICK AS INTEGER = 0
DIM CLAP AS INTEGER = 1
DIM HATS AS INTEGER = 2
DIM BASS AS INTEGER = 3
DIM ARP AS INTEGER = 4
DIM PAD AS INTEGER = 5
DIM LEAD AS INTEGER = 6
DIM RISER AS INTEGER = 7
DIM CRASH AS INTEGER = 8
DIM TRACK_NAMES$ = ["KICK", "CLAP", "HATS", "BASS", "ARP", "PAD", "LEAD", "RISER", "CRASH"]
DIM ti AS INTEGER
FOR ti = 0 TO LEN(TRACK_NAMES$) - 1
    SCORE.TRACK ti, TRACK_NAMES$[ti]
NEXT ti

' ── Instruments ──────────────────────────────────────────────────

SOUND.INIT SCORE.AUDIO_MODE$()
SOUND.MASTER "FIXED", 0.5
SCORE.TEMPO BPM
SOUND.COMPRESSOR 0.6, 2.5, 6, 160, 1.1

SOUND.REVERB 0.75, 0.3, 0.9, 0.25
SOUND.DELAY TRUE, 3 * 60000 / BPM / 4, 0.4, 0.28

SOUND.KIT KICK, "SYNTH"
SOUND.KIT CLAP, "SYNTH"
SOUND.GAIN CLAP, 0.45
SOUND.REVERBSEND CLAP, 0.4
SOUND.KIT HATS, "SYNTH"
SOUND.GAIN HATS, 0.3
SOUND.PAN HATS, 0.6
SOUND.KIT CRASH, "SYNTH"
SOUND.GAIN CRASH, 0.5
SOUND.REVERBSEND CRASH, 0.4

SOUND.VOICE BASS, "SAW", 0.002, 0.1, 0.3, 0.05
SOUND.FILTER BASS, 600, 0.45
SOUND.FENV BASS, 1.8, 0.002, 0.08
SOUND.SIDECHAIN BASS, KICK, 0.55
SOUND.GAIN BASS, 0.5

SOUND.VOICE ARP, "SQUARE", 0.002, 0.08, 0.15, 0.06
SOUND.FILTER ARP, 2200, 0.35
SOUND.DELAYSEND ARP, 0.4
SOUND.REVERBSEND ARP, 0.2
SOUND.GAIN ARP, 0.2

SOUND.VOICE PAD, "SAW", 1.2, 0.6, 0.85, 2.5
SOUND.UNISON PAD, 6, 0.25, 1.0
SOUND.FILTER PAD, 1100, 0.2
SOUND.REVERBSEND PAD, 0.5
SOUND.GAIN PAD, 0.22

SOUND.VOICE LEAD, "SAW", 0.01, 0.2, 0.6, 0.3
SOUND.UNISON LEAD, 3, 0.1, 0.6
SOUND.FILTER LEAD, 2800, 0.3
SOUND.DELAYSEND LEAD, 0.3
SOUND.REVERBSEND LEAD, 0.3
SOUND.GAIN LEAD, 0.26

SOUND.VOICE RISER, "NOISE", 0.01, 0.1, 1.0, 0.3
SOUND.FILTER RISER, 400, 0.4, "BP"
SOUND.REVERBSEND RISER, 0.3
SOUND.GAIN RISER, 0

' ── Patterns ─────────────────────────────────────────────────────

' Am - F - C - G, one chord a bar
DIM CHORDS$ AS STRING = "<[a3,c4,e4] [f3,a3,c4] [c4,e4,g4] [g3,b3,d4]>"
DIM ARPS$ AS STRING = "arp(up, <[a4,c5,e5]*4 [f4,a4,c5]*4 [c5,e5,g5]*4 [g4,b4,d5]*4>)"
DIM BASS$ AS STRING = "legato(0.5, <[~ a1]*4 [~ f1]*4 [~ c2]*4 [~ g1]*4>)"
DIM LEAD$ AS STRING = "<[e5 _ c5 _ a4 _ c5 e5] [f5 _ e5 _ c5 _ a4 _] [g5 _ e5 _ c5 _ e5 g5] [d5 _ _ _ b4 _ g4 _]>"

' ── Score ────────────────────────────────────────────────────────

SCORE.SECTION 0, "power on", "wave"
SCORE.PLAY PAD, "legato(1, " + CHORDS$ + ")"
SCORE.SWEEP PAD, "CUTOFF", "SAW", 300, 1600, 8, 0

SCORE.SECTION 8, "kernel", "groove"
SCORE.SWEEP_OFF PAD, "CUTOFF"
SCORE.PLAY KICK, "bd*4"
SCORE.PLAY HATS, "gain(0.6, [~ hh]*4)"
SCORE.PLAY BASS, BASS$

SCORE.SECTION 16, "userland", "shuffle"
SCORE.PLAY ARP, ARPS$
SCORE.PLAY CLAP, "~ cp ~ cp"
SCORE.PLAY HATS, "gain([0.4 0.7]*8, hh*16)"

SCORE.SECTION 24, "build", "rise"
SCORE.QUIET KICK
SCORE.QUIET BASS
SCORE.PLAY RISER, "legato(1, c4)"
SCORE.SWEEP RISER, "CUTOFF", "SAW", 400, 6000, 4, 0
SCORE.SWEEP RISER, "GAIN", "SAW", 0, 0.18, 4, 0

SCORE.SECTION 28, "drop", "jump"
SCORE.QUIET RISER
SCORE.SWEEP_OFF RISER, "CUTOFF"
SCORE.SWEEP_OFF RISER, "GAIN"
SCORE.PLAY KICK, "bd*4"
SCORE.PLAY BASS, BASS$
SCORE.PLAY LEAD, "legato(1, " + LEAD$ + ")"
SCORE.PLAY CRASH, "<cr ~!7>"

SCORE.SECTION 40, "shutdown", "bye"
SCORE.QUIET KICK
SCORE.QUIET CLAP
SCORE.QUIET HATS
SCORE.QUIET BASS
SCORE.QUIET LEAD
SCORE.QUIET CRASH
SCORE.QUIET ARP
SCORE.SWEEP PAD, "CUTOFF", "ISAW", 200, 1400, 8, 0

SCORE.SECTION 48, "end", "bye"
SCORE.QUIET PAD

SCORE.FINE 49

BOOTLOG.RUN "Boot Sequence"
