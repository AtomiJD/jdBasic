' dnb_nightbus.jdb - "Night Bus", liquid drum and bass in F minor,
' 216 bars at 174 BPM (just under five minutes), with the STAGE show.
'
'   0 intro     16 beat in    32 bass       64 first drop   96 breakdown
' 120 build    128 second drop 160 rollers  184 outro       208 end
'
' Usage: jdBasic dnb_nightbus.jdb [--window] [--shots dir]
'   F toggles fullscreen, Esc quits.

OPTION "EXPLICIT"

IMPORT SCORE
IMPORT STAGE

DIM BPM AS DOUBLE = 174

DIM KICK AS INTEGER = 0
DIM CLAP AS INTEGER = 1
DIM HATS AS INTEGER = 2
DIM GHOST AS INTEGER = 3
DIM SUB_BASS AS INTEGER = 4
DIM REESE AS INTEGER = 5
DIM PAD AS INTEGER = 6
DIM KEYS AS INTEGER = 7
DIM RISER AS INTEGER = 8
DIM CRASH AS INTEGER = 9
DIM SHAKER AS INTEGER = 10
DIM BELL AS INTEGER = 11
DIM TRACK_NAMES$ = ["KICK", "CLAP", "HATS", "GHOST", "SUB", "REESE", "PAD", "KEYS", "RISER", "CRASH", "SHAKER", "BELL"]
DIM ti AS INTEGER
FOR ti = 0 TO LEN(TRACK_NAMES$) - 1
    SCORE.TRACK ti, TRACK_NAMES$[ti]
NEXT ti

' ── Instruments ──────────────────────────────────────────────────

SOUND.INIT SCORE.AUDIO_MODE$()
SOUND.MASTER "FIXED", 0.5
SCORE.TEMPO BPM
SOUND.COMPRESSOR 0.55, 3, 3, 100, 1.15

' orbit 0: a tight room; orbit 1: a long dark hall and a slow echo
SOUND.REVERB 0.45, 0.5, 0.7, 0.2
SOUND.DELAY TRUE, 3 * 60000 / BPM / 4, 0.4, 0.25
SOUND.REVERB 0.95, 0.55, 1.0, 0.7, 1
SOUND.DELAY TRUE, 3 * 60000 / BPM / 2, 0.45, 0.3, 1

' the snare plays the CLAP role, so the show flashes on the backbeat
SOUND.KIT KICK, "SYNTH"
SOUND.KIT CLAP, "SYNTH"
SOUND.GAIN CLAP, 0.85
SOUND.REVERBSEND CLAP, 0.25
SOUND.KIT GHOST, "SYNTH"
SOUND.GAIN GHOST, 0.3
SOUND.REVERBSEND GHOST, 0.2
SOUND.KIT HATS, "SYNTH"
SOUND.GAIN HATS, 0.38
SOUND.PAN HATS, 0.6
SOUND.KIT SHAKER, "SYNTH"
SOUND.GAIN SHAKER, 0.3
SOUND.PAN SHAKER, 0.4
SOUND.KIT CRASH, "SYNTH"
SOUND.GAIN CRASH, 0.5
SOUND.ORBIT CRASH, 1
SOUND.REVERBSEND CRASH, 0.4

' sub: a clean sine under everything
SOUND.VOICE SUB_BASS, "SINE", 0.005, 0.4, 0.7, 0.12
SOUND.SIDECHAIN SUB_BASS, KICK, 0.5
SOUND.GAIN SUB_BASS, 0.42

' reese: detuned saws growling through a moving low-pass
SOUND.VOICE REESE, "SAW", 0.01, 0.3, 0.8, 0.15
SOUND.UNISON REESE, 4, 0.35, 0.6
SOUND.FILTER REESE, 600, 0.45
SOUND.SIDECHAIN REESE, KICK, 0.45
SOUND.GAIN REESE, 0.3

' pad: soft strings in the hall
SOUND.VOICE PAD, "SAW", 1.4, 0.6, 0.85, 2.5
SOUND.UNISON PAD, 5, 0.25, 1.0
SOUND.FILTER PAD, 1100, 0.2
SOUND.ORBIT PAD, 1
SOUND.REVERBSEND PAD, 0.6
SOUND.GAIN PAD, 0.22

' keys: an FM piano for the liquid chords
SOUND.VOICE KEYS, "SINE", 0.003, 0.6, 0.2, 0.5
SOUND.FM KEYS, 1.1, 2
SOUND.FILTER KEYS, 3000, 0.1
SOUND.ORBIT KEYS, 1
SOUND.REVERBSEND KEYS, 0.35
SOUND.DELAYSEND KEYS, 0.2
SOUND.GAIN KEYS, 0.32

' bell: a glassy FM tone for the hook
SOUND.VOICE BELL, "SINE", 0.003, 0.4, 0.15, 0.5
SOUND.FM BELL, 0.7, 2
SOUND.FILTER BELL, 2600, 0.15
SOUND.ORBIT BELL, 1
SOUND.DELAYSEND BELL, 0.3
SOUND.REVERBSEND BELL, 0.45
SOUND.GAIN BELL, 0.28

SOUND.VOICE RISER, "NOISE", 0.01, 0.1, 1.0, 0.25
SOUND.FILTER RISER, 400, 0.4, "BP"
SOUND.ORBIT RISER, 1
SOUND.REVERBSEND RISER, 0.3
SOUND.GAIN RISER, 0

' ── Patterns ─────────────────────────────────────────────────────

' Fm9 - Dbmaj7 - Ab - Eb, two bars each
DIM CHORDS$ AS STRING = "<[f3,g#3,c4,d#4,g4] [f3,g#3,c4,d#4,g4] [c#3,f3,g#3,c4] [c#3,f3,g#3,c4] [g#2,c3,d#3,g#3] [g#2,c3,d#3,g#3] [d#3,g3,a#3,d4] [d#3,g3,a#3,d4]>"
DIM BEAT$ AS STRING = "[bd ~ ~ ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~]"
DIM SNARE$ AS STRING = "[~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~]"
DIM GHOSTS$ AS STRING = "degradeBy(0.4, [~ ~ ~ sd ~ ~ sd ~ ~ sd ~ ~ ~ ~ ~ sd])"
DIM HATS8$ AS STRING = "gain([0.5 0.8]*4, [~ hh]*4)"
DIM SUB$ AS STRING = "legato(0.95, <f1 f1 c#1 c#1 g#1 g#1 d#1 [d#1 _ _ f1]>)"
DIM REESE$ AS STRING = "legato(1, <[f1 _ _ _ _ _ g#1 _] [f1 _ _ _ c2 _ a#1 _] [c#1 _ _ _ _ _ f1 _] [c#1 _ _ _ g#1 _ f1 _] [g#1 _ _ _ _ _ c2 _] [g#1 _ _ _ d#2 _ c2 _] [d#1 _ _ _ _ _ g1 _] [d#1 _ _ _ a#1 _ g1 _]>)"
DIM HOOK$ AS STRING = "<[c5 ~ g#4 ~ f4 ~ g#4 ~] [g4 ~ ~ ~ f4 ~ ~ ~] [f4 ~ g#4 ~ c5 ~ g#4 ~] [c#5 ~ ~ ~ c5 ~ ~ ~] [d#4 ~ g#4 ~ c5 ~ g#4 ~] [c5 ~ ~ ~ a#4 ~ ~ ~] [g4 ~ a#4 ~ d#5 ~ a#4 ~] [d5 ~ ~ ~ a#4 ~ ~ ~]>"
DIM HOOK_SOFT$ AS STRING = "legato(2, <[c5 ~ ~ ~ f4 ~ ~ ~] [g4 ~ ~ ~ ~ ~ ~ ~] [f4 ~ ~ ~ c5 ~ ~ ~] [c#5 ~ ~ ~ ~ ~ ~ ~] [d#4 ~ ~ ~ c5 ~ ~ ~] [c5 ~ ~ ~ ~ ~ ~ ~] [g4 ~ ~ ~ d#5 ~ ~ ~] [d5 ~ ~ ~ ~ ~ ~ ~]>)"
DIM KEYS$ AS STRING = "legato(0.6, sometimes(off(0.125, add(12)), <[[f3,g#3,c4,d#4] ~ ~ [f3,g#3,c4,d#4] ~ ~ ~ ~] [~ ~ ~ ~ [f3,g#3,c4,d#4] ~ ~ ~] [[c#3,f3,g#3,c4] ~ ~ [c#3,f3,g#3,c4] ~ ~ ~ ~] [~ ~ ~ ~ [c#3,f3,g#3,c4] ~ ~ ~] [[g#2,c3,d#3,g#3] ~ ~ [g#2,c3,d#3,g#3] ~ ~ ~ ~] [~ ~ ~ ~ [g#2,c3,d#3,g#3] ~ ~ ~] [[d#3,g3,a#3,d4] ~ ~ [d#3,g3,a#3,d4] ~ ~ ~ ~] [~ ~ ~ ~ [d#3,g3,a#3,d4] ~ ~ ~]>))"

' ── Score ────────────────────────────────────────────────────────

SCORE.SECTION 0, "intro", "wave"
SCORE.PLAY PAD, "legato(1, " + CHORDS$ + ")"
SCORE.SWEEP PAD, "CUTOFF", "SAW", 400, 1800, 16, 0
SCORE.PLAY BELL, HOOK_SOFT$

SCORE.SECTION 16, "beat in", "groove"
SCORE.SWEEP_OFF PAD, "CUTOFF"
SCORE.PLAY HATS, HATS8$
SCORE.PLAY SHAKER, "degradeBy(0.3, sh*16)"
SCORE.PLAY CLAP, SNARE$
SCORE.PLAY KICK, BEAT$
SOUND.FILTER CLAP, 2000, 0.2, "HP"
SCORE.SWEEP CLAP, "CUTOFF", "ISAW", 200, 3000, 16, 0

SCORE.SECTION 32, "bass", "shuffle"
SCORE.SWEEP_OFF CLAP, "CUTOFF"
SOUND.FILTER CLAP, 150, 0.1, "HP"
SCORE.PLAY SUB_BASS, SUB$
SCORE.PLAY GHOST, GHOSTS$
SCORE.PLAY KEYS, KEYS$
SCORE.QUIET BELL

SCORE.SECTION 56, "build", "rise"
SCORE.PLAY RISER, "legato(1, c4)"
SCORE.SWEEP RISER, "CUTOFF", "SAW", 400, 7000, 8, 0
SCORE.SWEEP RISER, "GAIN", "SAW", 0, 0.18, 8, 0
SCORE.PLAY CLAP, "<" + SNARE$ + " " + SNARE$ + " " + SNARE$ + " " + SNARE$ + " sd*8 sd*8 sd*16 [sd*12 ~ ~ ~ ~]>"
SCORE.QUIET KICK

SCORE.SECTION 64, "first drop", "jump"
SCORE.QUIET RISER
SCORE.SWEEP_OFF RISER, "CUTOFF"
SCORE.SWEEP_OFF RISER, "GAIN"
SCORE.PLAY KICK, BEAT$
SCORE.PLAY CLAP, SNARE$
SCORE.PLAY HATS, "gain([0.4 0.6 0.8 0.6]*4, hh*16)"
SCORE.PLAY REESE, REESE$
SCORE.SWEEP REESE, "CUTOFF", "SINE", 300, 1600, 2, 0
SCORE.PLAY BELL, HOOK$
SCORE.PLAY CRASH, "<cr ~!15>"

SCORE.SECTION 80, "first drop: keys back", "jump"
SCORE.PLAY KEYS, KEYS$
SCORE.PLAY GHOST, GHOSTS$

SCORE.SECTION 96, "breakdown", "wave"
SCORE.QUIET SUB_BASS
SCORE.QUIET KICK
SCORE.QUIET CLAP
SCORE.QUIET GHOST
SCORE.QUIET HATS
SCORE.QUIET REESE
SCORE.QUIET CRASH
SCORE.PLAY SHAKER, "gain(0.5, degradeBy(0.5, sh*16))"
SCORE.PLAY KEYS, "legato(1.5, " + CHORDS$ + ")"
SCORE.PLAY BELL, HOOK_SOFT$
SCORE.SWEEP PAD, "CUTOFF", "SINE", 600, 2400, 16, 0

SCORE.SECTION 120, "build: riser and snare roll", "rise"
SCORE.PLAY RISER, "legato(1, c4)"
SCORE.SWEEP RISER, "CUTOFF", "SAW", 400, 7000, 8, 0
SCORE.SWEEP RISER, "GAIN", "SAW", 0, 0.2, 8, 0
SCORE.PLAY CLAP, "gain(<0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.8>, <sd*4 sd*4 sd*8 sd*8 sd*8 sd*16 sd*16 [sd*12 ~ ~ ~ ~]>)"

SCORE.SECTION 128, "second drop", "jump"
SCORE.PLAY SUB_BASS, SUB$
SCORE.QUIET RISER
SCORE.SWEEP_OFF RISER, "CUTOFF"
SCORE.SWEEP_OFF RISER, "GAIN"
SCORE.SWEEP_OFF PAD, "CUTOFF"
SCORE.PLAY KICK, BEAT$
SCORE.PLAY CLAP, SNARE$
SCORE.PLAY GHOST, GHOSTS$
SCORE.PLAY HATS, "gain([0.4 0.6 0.8 0.6]*4, hh*16)"
SCORE.PLAY SHAKER, "sh*16"
SCORE.PLAY REESE, REESE$
SCORE.SWEEP REESE, "CUTOFF", "SINE", 400, 2200, 1, 0
SCORE.PLAY KEYS, KEYS$
SCORE.PLAY BELL, "legato(1.5, " + HOOK$ + ")"
SCORE.PLAY CRASH, "<cr ~!15>"

SCORE.SECTION 160, "rollers", "robot"
SCORE.QUIET BELL
SCORE.QUIET KEYS
SCORE.PLAY KICK, "[bd ~ ~ ~ ~ ~ ~ ~ ~ ~ bd ~ ~ bd ~ ~]"
SCORE.PLAY GHOST, "degradeBy(0.2, [~ sd ~ sd ~ ~ sd ~ ~ sd ~ sd ~ ~ sd sd])"
SCORE.SWEEP REESE, "CUTOFF", "SAW", 300, 2600, 4, 0

SCORE.SECTION 172, "rollers: ping-pong hook", "pan"
SCORE.PLAY BELL, HOOK$
SCORE.SWEEP BELL, "PAN", "SINE", 0.1, 0.9, 1, 0

SCORE.SECTION 184, "outro", "groove"
SCORE.QUIET REESE
SCORE.QUIET GHOST
SCORE.QUIET CRASH
SCORE.SWEEP_OFF BELL, "PAN"
SCORE.PLAY KICK, BEAT$
SCORE.PLAY KEYS, KEYS$
SCORE.SWEEP PAD, "CUTOFF", "ISAW", 300, 1800, 16, 0

SCORE.SECTION 200, "outro: pads", "wave"
SCORE.QUIET KICK
SCORE.QUIET CLAP
SCORE.QUIET HATS
SCORE.QUIET SHAKER
SCORE.QUIET SUB_BASS
SCORE.QUIET KEYS

SCORE.SECTION 208, "end", "bye"
SCORE.QUIET PAD
SCORE.QUIET BELL

SCORE.FINE 212

STAGE.SUBTITLE "Liquid drum and bass in F minor"
STAGE.RUN "Night Bus"
