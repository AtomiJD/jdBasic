' melody.jdb - chord progressions and a seeded hook generator for the
' sequencer, in pattern strings that SOUND.SEQ and SCORE.PLAY take.
'
'   DIM prog$ = MELODY.PROG$("epic", "A minor")           ' "Am F C G"
'   DIM hook$ = MELODY.HOOK$(7, prog$, "A minor", "x.x..x.x x.x.x...", 4)
'   SCORE.PLAY LEAD, hook$
'   SCORE.PLAY PAD, "<" + prog$ + ">"
'
' PROG$ names: epic (i VI III VII), anthem (i VII VI VII), dark
' (i iv VI V, the V major), pop (I V vi IV), euphoric (vi IV I V), house (ii7 V7
' I7 I7), deep (i7 iv7 i7 iv7). The key is a note name and a mode:
' major, minor, dorian, phrygian, lydian, mixolydian.
'
' HOOK$ writes one bar per chord, sixteen steps a bar. The rhythm mask
' has x for a note, - to hold it and . for a rest (spaces are ignored).
' The rules: chord tones on the beats and on the first note of a bar,
' scale steps between them, a leap now and then and a step back the
' other way after it, a range of about a ninth, rising over the first
' part of the hook and falling to the end. A note on the last two
' steps of a bar already takes the next chord. The bars follow the
' form A A' A B: every A bar makes the same choices on its own chord,
' A' changes its second half, and B ends on the root or the third and
' holds it. The same seed always gives the same hook.
'
' The parts under a hook, one bar per chord as well:
'   BASS$(prog$, style$, seed)   offbeat (the trance roll), octave (house
'                                eighths), sub (one long root), acid
'                                (sixteenths with ^ slides for
'                                SOUND.GLIDE track, ms, "SLIDE")
'   ARP$(prog$, shape$, rate, octaves)  the chord's voicing an octave up:
'                                up, down, updown, random; rate notes a
'                                bar (8, 12, 16), over 1 or 2 octaves
'   STABS$(prog$, rhythm$)       the voiced chord on a rhythm mask (x - .)
'
'   BORROWED$(key$)              a breakdown progression with chords
'                                from the parallel key
'
' Around a hook:
'   COUNTER$(seed, hook$, prog$, key$, octave)  an answer between the
'                                hook's notes, at most four a bar
'   VARY$(hook$, prog$, key$, kind$)  the hook changed but still the
'                                hook: dense, octave, ending

EXPORT MODULE MELODY

DIM MODE_NAMES$ = ["MAJOR", "MINOR", "DORIAN", "PHRYGIAN", "LYDIAN", "MIXOLYDIAN"]
DIM MODE_STEPS = [[0, 2, 4, 5, 7, 9, 11], [0, 2, 3, 5, 7, 8, 10], [0, 2, 3, 5, 7, 9, 10], [0, 1, 3, 5, 7, 8, 10], [0, 2, 4, 6, 7, 9, 11], [0, 2, 4, 5, 7, 9, 10]]
DIM PC_SHARPS$ = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
DIM PC_FLATS$ = ["C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B"]
DIM MODE_OFFSETS = [0, 9, 2, 4, 5, 7]
DIM rng = [1.0]

' ── pitch helpers ────────────────────────────────────────────────

' The pitch class of a note name: "A", "Bb", "f#3" (an octave is ignored)
EXPORT FUNC PC_OF(name$) AS INTEGER
    DIM letters$ = "CDEFGAB"
    DIM base_pc = [0, 2, 4, 5, 7, 9, 11]
    DIM up$ = UCASE$(LEFT$(name$, 1))
    DIM li AS INTEGER = INSTR(letters$, up$)
    IF li < 0 THEN RETURN -1
    DIM pc AS INTEGER = base_pc[li]
    IF LEN(name$) > 1 THEN
        DIM acc$ = MID$(name$, 1, 1)
        IF acc$ = "#" THEN pc = pc + 1
        IF acc$ = "b" THEN pc = pc - 1
    ENDIF
    RETURN (pc + 12) MOD 12
ENDFUNC

' MIDI number of a lower-case note name as the sequencer writes it: a#3
EXPORT FUNC NOTE_MIDI(name$) AS INTEGER
    DIM pc AS INTEGER = PC_OF(name$)
    DIM octave AS INTEGER = VAL(RIGHT$(name$, 1))
    RETURN (octave + 1) * 12 + pc
ENDFUNC

EXPORT FUNC MIDI_NAME$(m AS INTEGER) AS STRING
    DIM names$ = ["c", "c#", "d", "d#", "e", "f", "f#", "g", "g#", "a", "a#", "b"]
    RETURN names$[m MOD 12] + STR$(INT(m / 12) - 1)
ENDFUNC

' The key's root pitch class and the seven steps of its mode
FUNC KEY_ROOT(key$) AS INTEGER
    RETURN PC_OF(TRIM$(key$))
ENDFUNC

' TRUE when the key is written with flats: its major key is F, Bb, Eb, Ab,
' Db or Gb (C major and the sharp keys are written with sharps)
FUNC KEY_FLATS(key$) AS INTEGER
    DIM parts = SPLIT(TRIM$(key$), " ")
    DIM want$ = "MAJOR"
    IF LEN(parts) > 1 THEN want$ = UCASE$(TRIM$(parts[LEN(parts) - 1]))
    DIM offset AS INTEGER = 0
    DIM mi AS INTEGER
    FOR mi = 0 TO LEN(MODE_NAMES$) - 1
        IF MODE_NAMES$[mi] = want$ THEN offset = MODE_OFFSETS[mi]
    NEXT mi
    DIM major_pc AS INTEGER = (KEY_ROOT(key$) - offset + 12) MOD 12
    RETURN major_pc = 5 OR major_pc = 10 OR major_pc = 3 OR major_pc = 8 OR major_pc = 1 OR major_pc = 6
ENDFUNC

FUNC KEY_STEPS(key$)
    DIM parts = SPLIT(TRIM$(key$), " ")
    DIM want$ = "MAJOR"
    IF LEN(parts) > 1 THEN want$ = UCASE$(TRIM$(parts[LEN(parts) - 1]))
    DIM mi AS INTEGER
    FOR mi = 0 TO LEN(MODE_NAMES$) - 1
        IF MODE_NAMES$[mi] = want$ THEN RETURN MODE_STEPS[mi]
    NEXT mi
    RETURN MODE_STEPS[0]
ENDFUNC

' ── progressions ─────────────────────────────────────────────────

' The chord symbol of the triad (or seventh) on scale degree deg
FUNC DEGREE_CHORD$(root_pc AS INTEGER, steps, deg AS INTEGER, seventh AS INTEGER, flats AS INTEGER) AS STRING
    DIM r AS INTEGER = steps[deg MOD 7]
    DIM third AS INTEGER = (steps[(deg + 2) MOD 7] - r + 12) MOD 12
    DIM fifth AS INTEGER = (steps[(deg + 4) MOD 7] - r + 12) MOD 12
    DIM sev AS INTEGER = (steps[(deg + 6) MOD 7] - r + 12) MOD 12
    DIM q$ = ""
    IF third = 3 AND fifth = 6 THEN
        q$ = "dim"
        IF seventh THEN q$ = "m7b5"
    ELSEIF third = 3 THEN
        q$ = "m"
        IF seventh THEN q$ = "m7"
    ELSEIF seventh AND sev = 11 THEN
        q$ = "maj7"
    ELSEIF seventh THEN
        q$ = "7"
    ENDIF
    IF flats THEN RETURN PC_FLATS$[(root_pc + r) MOD 12] + q$
    RETURN PC_SHARPS$[(root_pc + r) MOD 12] + q$
ENDFUNC

' A named progression in a key, as chord symbols, one per bar
EXPORT FUNC PROG$(name$, key$) AS STRING
    DIM degs = [0, 5, 2, 6]
    DIM sevenths AS INTEGER = FALSE
    DIM n$ = LCASE$(name$)
    IF n$ = "anthem" THEN degs = [0, 6, 5, 6]
    IF n$ = "dark" THEN degs = [0, 3, 5, 4]
    IF n$ = "pop" THEN degs = [0, 4, 5, 3]
    IF n$ = "euphoric" THEN degs = [5, 3, 0, 4]
    IF n$ = "house" THEN
        degs = [1, 4, 0, 0]
        sevenths = TRUE
    ENDIF
    IF n$ = "deep" THEN
        degs = [0, 3, 0, 3]
        sevenths = TRUE
    ENDIF
    DIM root_pc AS INTEGER = KEY_ROOT(key$)
    DIM steps = KEY_STEPS(key$)
    DIM flats AS INTEGER = KEY_FLATS(key$)
    DIM out$ = ""
    DIM di AS INTEGER
    FOR di = 0 TO LEN(degs) - 1
        IF di > 0 THEN out$ = out$ + " "
        IF n$ = "dark" AND di = 3 THEN
            ' the major V of harmonic minor, the pull back to i
            DIM v_pc AS INTEGER = (root_pc + steps[4]) MOD 12
            IF flats THEN out$ = out$ + PC_FLATS$[v_pc] ELSE out$ = out$ + PC_SHARPS$[v_pc]
        ELSE
            out$ = out$ + DEGREE_CHORD$(root_pc, steps, degs[di], sevenths, flats)
        ENDIF
    NEXT di
    RETURN out$
ENDFUNC

' A breakdown progression with chords borrowed from the parallel key:
' IV iv bVI bVII in a major key (F Fm Ab Bb in C), iv bVI bVII i in a
' minor one (Dm F G Am in A minor). It ends a step below or on the
' tonic, so the main progression returns from it.
EXPORT FUNC BORROWED$(key$) AS STRING
    DIM root_pc AS INTEGER = KEY_ROOT(key$)
    DIM steps = KEY_STEPS(key$)
    DIM names$ = PC_SHARPS$
    IF KEY_FLATS(key$) THEN names$ = PC_FLATS$
    DIM offs = [5, 8, 10, 0]
    DIM quals$ = ["m", "", "", "m"]
    IF steps[2] = 4 THEN
        offs = [5, 5, 8, 10]
        quals$ = ["", "m", "", ""]
    ENDIF
    DIM out$ = ""
    DIM ci AS INTEGER
    FOR ci = 0 TO 3
        DIM pc AS INTEGER = (root_pc + offs[ci]) MOD 12
        DIM nm$ = names$[pc]
        IF offs[ci] = 8 OR offs[ci] = 10 THEN nm$ = PC_FLATS$[pc]
        IF ci > 0 THEN out$ = out$ + " "
        out$ = out$ + nm$ + quals$[ci]
    NEXT ci
    RETURN out$
ENDFUNC

' ── the hook ─────────────────────────────────────────────────────

FUNC RAND01() AS DOUBLE
    DIM m AS DOUBLE = 2147483647
    DIM x AS DOUBLE = rng[0] * 48271
    rng[0] = x - INT(x / m) * m
    RETURN rng[0] / m
ENDFUNC

FUNC RESEED(s AS INTEGER) AS INTEGER
    rng[0] = ((ABS(s) + 1) * 2654435761 MOD 2147483646) + 1
    DIM w AS DOUBLE = RAND01()
    RETURN 0
ENDFUNC

' The pitch classes of a chord symbol, read back from the sequencer
FUNC CHORD_PCS(chd$)
    DIM evs = SPLIT(SOUND.EVENTS$(chd$, 1), CHR$(10))
    DIM pcs = []
    DIM ei AS INTEGER
    FOR ei = 0 TO LEN(evs) - 1
        DIM cols = SPLIT(TRIM$(evs[ei]), " ")
        IF LEN(cols) >= 3 THEN pcs = APPEND(pcs, PC_OF(cols[2]))
    NEXT ei
    RETURN pcs
ENDFUNC

FUNC HAS_PC(pcs, m AS INTEGER) AS INTEGER
    DIM pi_ AS INTEGER
    FOR pi_ = 0 TO LEN(pcs) - 1
        IF pcs[pi_] = m MOD 12 THEN RETURN TRUE
    NEXT pi_
    RETURN FALSE
ENDFUNC

' The scale notes from lo to hi, as MIDI numbers
FUNC POOL(root_pc AS INTEGER, steps, lo AS INTEGER, hi AS INTEGER)
    DIM out = []
    DIM m AS INTEGER
    FOR m = lo TO hi
        DIM rel AS INTEGER = (m - root_pc + 120) MOD 12
        DIM si AS INTEGER
        FOR si = 0 TO 6
            IF steps[si] = rel THEN out = APPEND(out, m)
        NEXT si
    NEXT m
    RETURN out
ENDFUNC

' A chord tone of pcs from the pool: near prev, in the heading, or a
' leap of a fourth to a sixth when leap is set
FUNC CHORD_TONE(pool, pcs, prev AS INTEGER, heading AS INTEGER, leap AS INTEGER) AS INTEGER
    DIM best AS INTEGER = -1
    DIM best_cost AS DOUBLE = 1000000
    DIM pi_ AS INTEGER
    FOR pi_ = 0 TO LEN(pool) - 1
        DIM m AS INTEGER = pool[pi_]
        IF HAS_PC(pcs, m) THEN
            DIM d AS INTEGER = m - prev
            DIM cost AS DOUBLE = ABS(d)
            IF leap THEN cost = ABS(ABS(d) - 7)
            IF heading <> 0 AND d * heading < 0 THEN cost = cost + 4
            IF d = 0 THEN cost = cost + 3.5
            cost = cost + RAND01() * 2.5
            IF cost < best_cost THEN
                best_cost = cost
                best = m
            ENDIF
        ENDIF
    NEXT pi_
    RETURN best
ENDFUNC

' A scale step (or two) from prev in the heading, held in the pool
FUNC SCALE_STEP(pool, prev AS INTEGER, heading AS INTEGER, stride AS INTEGER) AS INTEGER
    DIM near_i AS INTEGER = 0
    DIM pi_ AS INTEGER
    FOR pi_ = 0 TO LEN(pool) - 1
        IF ABS(pool[pi_] - prev) < ABS(pool[near_i] - prev) THEN near_i = pi_
    NEXT pi_
    DIM h AS INTEGER = heading
    IF h = 0 THEN h = 1
    DIM target AS INTEGER = near_i + h * stride
    IF target < 0 OR target > LEN(pool) - 1 THEN target = near_i - h * stride
    IF target < 0 THEN target = 0
    IF target > LEN(pool) - 1 THEN target = LEN(pool) - 1
    RETURN pool[target]
ENDFUNC

' One bar of the hook as sixteen pattern steps. kind$ is A, A2 or B.
FUNC HOOK_BAR$(mask$, pool, pcs, next_pcs, start AS INTEGER, seed AS INTEGER, kind$, progress AS DOUBLE, span AS DOUBLE) AS STRING
    DIM w AS INTEGER = RESEED(seed)
    DIM last_onset AS INTEGER = -1
    DIM k AS INTEGER
    FOR k = 0 TO 15
        IF MID$(mask$, k, 1) = "x" THEN last_onset = k
    NEXT k
    DIM out$ = ""
    DIM prev AS INTEGER = start
    DIM leapt AS INTEGER = 0
    DIM first AS INTEGER = TRUE
    DIM sound_on AS INTEGER = FALSE
    FOR k = 0 TO 15
        IF kind$ = "A2" AND k = 8 THEN w = RESEED(seed + 101)
        DIM c$ = MID$(mask$, k, 1)
        DIM tok$ = "~"
        IF kind$ = "B" AND k > last_onset AND last_onset >= 0 THEN c$ = "-"
        IF c$ = "x" THEN
            DIM t AS DOUBLE = progress + span * k / 16
            DIM heading AS INTEGER = 1
            IF t > 0.6 THEN heading = -1
            IF RAND01() < 0.3 THEN heading = -heading
            DIM nt AS INTEGER = prev
            IF kind$ = "B" AND k = last_onset THEN
                DIM ends = [pcs[0]]
                IF LEN(pcs) > 1 THEN ends = APPEND(ends, pcs[1])
                nt = CHORD_TONE(pool, ends, prev, -1, FALSE)
            ELSEIF k >= 14 AND k = last_onset THEN
                nt = CHORD_TONE(pool, next_pcs, prev, 0, FALSE)
            ELSEIF first THEN
                nt = CHORD_TONE(pool, pcs, start, 0, FALSE)
            ELSEIF leapt <> 0 THEN
                nt = SCALE_STEP(pool, prev, -leapt, 1)
                leapt = 0
            ELSEIF k MOD 4 = 0 THEN
                DIM jump AS INTEGER = RAND01() < 0.2
                nt = CHORD_TONE(pool, pcs, prev, heading, jump)
                IF jump AND ABS(nt - prev) >= 5 THEN leapt = SGN(nt - prev)
            ELSE
                DIM r AS DOUBLE = RAND01()
                IF r < 0.07 THEN
                    nt = prev
                ELSEIF r < 0.85 THEN
                    nt = SCALE_STEP(pool, prev, heading, 1)
                ELSE
                    nt = SCALE_STEP(pool, prev, heading, 2)
                ENDIF
            ENDIF
            IF nt < 0 THEN nt = prev
            prev = nt
            first = FALSE
            sound_on = TRUE
            tok$ = MIDI_NAME$(nt)
        ELSEIF c$ = "-" AND sound_on THEN
            tok$ = "_"
        ELSE
            sound_on = FALSE
        ENDIF
        IF k > 0 THEN out$ = out$ + " "
        out$ = out$ + tok$
    NEXT k
    RETURN "[" + out$ + "]"
ENDFUNC

' A hook over prog$ (chord symbols, one bar each) in key$, on the rhythm
' mask, around the key's root in the given octave
EXPORT FUNC HOOK$(seed AS INTEGER, prog$, key$, rhythm$, octave AS INTEGER) AS STRING
    DIM mask$ = REPLACE$(rhythm$, " ", "")
    WHILE LEN(mask$) < 16
        mask$ = mask$ + "."
    WEND
    DIM chords$ = SPLIT(TRIM$(prog$), " ")
    DIM n_bars AS INTEGER = LEN(chords$)
    DIM root_pc AS INTEGER = KEY_ROOT(key$)
    DIM centre AS INTEGER = (octave + 1) * 12 + root_pc
    DIM pool = POOL(root_pc, KEY_STEPS(key$), centre - 3, centre + 11)
    DIM out$ = ""
    DIM bi AS INTEGER
    FOR bi = 0 TO n_bars - 1
        DIM kind$ = "A"
        IF bi = n_bars - 1 AND n_bars > 1 THEN
            kind$ = "B"
        ELSEIF bi MOD 2 = 1 THEN
            kind$ = "A2"
        ENDIF
        DIM next_i AS INTEGER = (bi + 1) MOD n_bars
        DIM bar$ = HOOK_BAR$(mask$, pool, CHORD_PCS(chords$[bi]), CHORD_PCS(chords$[next_i]), centre + 4, seed, kind$, bi / n_bars, 1 / n_bars)
        IF bi > 0 THEN out$ = out$ + " "
        out$ = out$ + bar$
    NEXT bi
    RETURN "<" + out$ + ">"
ENDFUNC

' The bars of a "<[...] [...]>" line, each as its list of step tokens
FUNC BARS_OF(pat$)
    DIM inner$ = MID$(pat$, 2, LEN(pat$) - 4)
    RETURN SPLIT(inner$, "] [")
ENDFUNC

FUNC LINE_OF$(bars$) AS STRING
    RETURN "<[" + JOIN(bars$, "] [") + "]>"
ENDFUNC

FUNC ONSET(tok$) AS INTEGER
    RETURN tok$ <> "~" AND tok$ <> "_"
ENDFUNC

' The direction of a bar's notes: 1 up, -1 down, 0 level or empty
FUNC BAR_HEADING(steps$) AS INTEGER
    DIM first AS INTEGER = -1
    DIM last AS INTEGER = -1
    DIM k AS INTEGER
    FOR k = 0 TO LEN(steps$) - 1
        IF steps$[k] <> "~" AND steps$[k] <> "_" THEN
            IF first < 0 THEN first = NOTE_MIDI(steps$[k])
            last = NOTE_MIDI(steps$[k])
        ENDIF
    NEXT k
    RETURN SGN(last - first)
ENDFUNC

' An answer between the notes of hook$: eighth notes on the steps where
' the hook does not strike (nor on the step before), at most four a bar
' and the latest ones, in the other direction from the hook's bar,
' starting and ending on a chord tone. octave places the answer like
' HOOK$ does; one below the hook sits under it.
EXPORT FUNC COUNTER$(seed AS INTEGER, hook$, prog$, key$, octave AS INTEGER) AS STRING
    DIM bars$ = BARS_OF(hook$)
    DIM chords$ = SPLIT(TRIM$(prog$), " ")
    DIM root_pc AS INTEGER = KEY_ROOT(key$)
    DIM centre AS INTEGER = (octave + 1) * 12 + root_pc
    DIM pool = POOL(root_pc, KEY_STEPS(key$), centre - 3, centre + 9)
    DIM w AS INTEGER = RESEED(seed + 7777)
    DIM prev AS INTEGER = centre + 4
    DIM out$ = []
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(bars$) - 1
        DIM steps$ = SPLIT(bars$[bi], " ")
        DIM pcs = CHORD_PCS(chords$[bi MOD LEN(chords$)])
        DIM heading AS INTEGER = -BAR_HEADING(steps$)
        IF heading = 0 THEN heading = -1
        DIM answer$ = []
        DIM k AS INTEGER
        FOR k = 0 TO 15
            answer$ = APPEND(answer$, "~")
        NEXT k
        DIM prev_bar$ = SPLIT(bars$[(bi + LEN(bars$) - 1) MOD LEN(bars$)], " ")
        DIM prev_last$ = prev_bar$[15]
        DIM slots = []
        FOR k = 0 TO 14 STEP 2
            DIM before$ = prev_last$
            IF k > 0 THEN before$ = steps$[k - 1]
            IF NOT ONSET(steps$[k]) AND NOT ONSET(before$) THEN slots = APPEND(slots, k)
        NEXT k
        DIM first_s AS INTEGER = LEN(slots) - 4
        IF first_s < 0 THEN first_s = 0
        DIM si AS INTEGER
        FOR si = first_s TO LEN(slots) - 1
            DIM nt AS INTEGER
            IF si = first_s OR si = LEN(slots) - 1 THEN
                nt = CHORD_TONE(pool, pcs, prev, heading, FALSE)
            ELSE
                nt = SCALE_STEP(pool, prev, heading, 1)
            ENDIF
            IF nt < 0 THEN nt = prev
            IF si > first_s AND nt = prev THEN nt = SCALE_STEP(pool, prev, heading, 2)
            prev = nt
            answer$[slots[si]] = MIDI_NAME$(nt)
        NEXT si
        out$ = APPEND(out$, JOIN(answer$, " "))
    NEXT bi
    RETURN LINE_OF$(out$)
ENDFUNC

' hook$ changed so it is still the hook:
'   dense    a passing note between notes three or more steps apart
'   octave   the A' bars (the second and fourth) an octave up
'   ending   the last note rises to a chord tone above instead of falling
EXPORT FUNC VARY$(hook$, prog$, key$, kind$) AS STRING
    DIM bars$ = BARS_OF(hook$)
    DIM chords$ = SPLIT(TRIM$(prog$), " ")
    DIM root_pc AS INTEGER = KEY_ROOT(key$)
    DIM pool = POOL(root_pc, KEY_STEPS(key$), 36, 96)
    DIM kd$ = LCASE$(kind$)
    DIM bi AS INTEGER
    DIM k AS INTEGER
    FOR bi = 0 TO LEN(bars$) - 1
        DIM steps$ = SPLIT(bars$[bi], " ")
        IF kd$ = "dense" THEN
            DIM prev_k AS INTEGER = -1
            FOR k = 0 TO 15
                IF steps$[k] <> "~" AND steps$[k] <> "_" THEN
                    IF prev_k >= 0 ANDALSO k - prev_k >= 3 ANDALSO steps$[prev_k + 2] = "~" THEN
                        DIM a AS INTEGER = NOTE_MIDI(steps$[prev_k])
                        DIM z AS INTEGER = NOTE_MIDI(steps$[k])
                        DIM h AS INTEGER = SGN(z - a)
                        IF h = 0 THEN h = 1
                        steps$[prev_k + 2] = MIDI_NAME$(SCALE_STEP(pool, a, h, 1))
                    ENDIF
                    prev_k = k
                ENDIF
            NEXT k
        ELSEIF kd$ = "octave" AND bi MOD 2 = 1 AND bi < LEN(bars$) - 1 THEN
            FOR k = 0 TO 15
                IF steps$[k] <> "~" AND steps$[k] <> "_" THEN steps$[k] = MIDI_NAME$(NOTE_MIDI(steps$[k]) + 12)
            NEXT k
        ELSEIF kd$ = "ending" AND bi = LEN(bars$) - 1 THEN
            DIM pcs = CHORD_PCS(chords$[bi MOD LEN(chords$)])
            DIM last_k AS INTEGER = -1
            FOR k = 0 TO 15
                IF steps$[k] <> "~" AND steps$[k] <> "_" THEN last_k = k
            NEXT k
            IF last_k >= 0 THEN
                DIM m AS INTEGER = NOTE_MIDI(steps$[last_k])
                DIM up AS INTEGER = m + 3
                WHILE NOT HAS_PC(pcs, up) AND up < m + 12
                    up = up + 1
                WEND
                steps$[last_k] = MIDI_NAME$(up)
            ENDIF
        ENDIF
        bars$[bi] = JOIN(steps$, " ")
    NEXT bi
    RETURN LINE_OF$(bars$)
ENDFUNC

' ── the parts under the hook ─────────────────────────────────────

' Each bar's voicing of prog$ as the sequencer leads it, "a3,c4,e4"
FUNC VOICINGS$(prog$)
    DIM n_bars AS INTEGER = LEN(SPLIT(TRIM$(prog$), " "))
    DIM evs = SPLIT(SOUND.EVENTS$("<" + TRIM$(prog$) + ">", n_bars), CHR$(10))
    DIM out$ = []
    DIM b AS INTEGER
    FOR b = 0 TO n_bars - 1
        DIM v$ = ""
        DIM ei AS INTEGER
        FOR ei = 0 TO LEN(evs) - 1
            DIM cols = SPLIT(TRIM$(evs[ei]), " ")
            IF LEN(cols) >= 3 ANDALSO VAL(cols[0]) = b THEN
                IF LEN(v$) > 0 THEN v$ = v$ + ","
                v$ = v$ + cols[2]
            ENDIF
        NEXT ei
        out$ = APPEND(out$, v$)
    NEXT b
    RETURN out$
ENDFUNC

' The bass register of a chord's root: f1 to e2
FUNC BASS_ROOT(chd$) AS INTEGER
    DIM m AS INTEGER = 36 + PC_OF(chd$)
    IF m > 40 THEN m = m - 12
    RETURN m
ENDFUNC

EXPORT FUNC BASS$(prog$, style$, seed AS INTEGER) AS STRING
    DIM chords$ = SPLIT(TRIM$(prog$), " ")
    DIM st$ = LCASE$(style$)
    DIM w AS INTEGER = RESEED(seed)
    DIM out$ = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(chords$) - 1
        DIM r AS INTEGER = BASS_ROOT(chords$[i])
        DIM r$ = MIDI_NAME$(r)
        DIM o$ = MIDI_NAME$(r + 12)
        DIM bar$ = ""
        IF st$ = "octave" THEN
            bar$ = "[" + r$ + " " + o$ + "]*4"
        ELSEIF st$ = "sub" THEN
            bar$ = r$
        ELSEIF st$ = "acid" THEN
            DIM fifth$ = MIDI_NAME$(r + 7)
            DIM k AS INTEGER
            DIM sounding AS INTEGER = FALSE
            bar$ = "["
            FOR k = 0 TO 15
                DIM x AS DOUBLE = RAND01()
                DIM tok$ = r$
                IF k MOD 4 <> 0 AND x < 0.2 THEN
                    tok$ = "~"
                ELSEIF x > 0.85 THEN
                    tok$ = fifth$
                ELSEIF x > 0.6 THEN
                    tok$ = o$
                ENDIF
                IF tok$ <> "~" AND sounding AND RAND01() < 0.25 THEN tok$ = tok$ + "^"
                sounding = tok$ <> "~"
                IF k > 0 THEN bar$ = bar$ + " "
                bar$ = bar$ + tok$
            NEXT k
            bar$ = bar$ + "]"
        ELSE
            bar$ = "[~ " + r$ + " " + r$ + " " + r$ + "]*4"
        ENDIF
        IF i > 0 THEN out$ = out$ + " "
        out$ = out$ + bar$
    NEXT i
    RETURN "<" + out$ + ">"
ENDFUNC

EXPORT FUNC ARP$(prog$, shape$, rate AS INTEGER, octaves AS INTEGER) AS STRING
    DIM voicings$ = VOICINGS$(prog$)
    DIM sh$ = LCASE$(shape$)
    DIM w AS INTEGER = RESEED(LEN(prog$))
    DIM out$ = ""
    DIM b AS INTEGER
    FOR b = 0 TO LEN(voicings$) - 1
        DIM names$ = SPLIT(voicings$[b], ",")
        DIM tones = []
        DIM oc AS INTEGER
        DIM ni AS INTEGER
        FOR oc = 1 TO MAX([1, octaves])
            FOR ni = 0 TO LEN(names$) - 1
                tones = APPEND(tones, NOTE_MIDI(names$[ni]) + 12 * oc)
            NEXT ni
        NEXT oc
        DIM walk = []
        DIM wi AS INTEGER
        IF sh$ = "down" THEN
            FOR wi = LEN(tones) - 1 TO 0 STEP -1
                walk = APPEND(walk, tones[wi])
            NEXT wi
        ELSEIF sh$ = "updown" THEN
            walk = tones + 0
            FOR wi = LEN(tones) - 2 TO 1 STEP -1
                walk = APPEND(walk, tones[wi])
            NEXT wi
        ELSE
            walk = tones + 0
        ENDIF
        DIM bar$ = ""
        DIM stp AS INTEGER
        FOR stp = 0 TO rate - 1
            DIM m AS INTEGER = walk[stp MOD LEN(walk)]
            IF sh$ = "random" THEN m = walk[INT(RAND01() * LEN(walk))]
            IF stp > 0 THEN bar$ = bar$ + " "
            bar$ = bar$ + MIDI_NAME$(m)
        NEXT stp
        IF b > 0 THEN out$ = out$ + " "
        out$ = out$ + "[" + bar$ + "]"
    NEXT b
    RETURN "<" + out$ + ">"
ENDFUNC

EXPORT FUNC STABS$(prog$, rhythm$) AS STRING
    DIM voicings$ = VOICINGS$(prog$)
    DIM mask$ = REPLACE$(rhythm$, " ", "")
    DIM out$ = ""
    DIM b AS INTEGER
    FOR b = 0 TO LEN(voicings$) - 1
        DIM chd$ = "[" + voicings$[b] + "]"
        DIM bar$ = ""
        DIM sounding AS INTEGER = FALSE
        DIM k AS INTEGER
        FOR k = 0 TO LEN(mask$) - 1
            DIM c$ = MID$(mask$, k, 1)
            DIM tok$ = "~"
            IF c$ = "x" THEN
                tok$ = chd$
                sounding = TRUE
            ELSEIF c$ = "-" AND sounding THEN
                tok$ = "_"
            ELSE
                sounding = FALSE
            ENDIF
            IF k > 0 THEN bar$ = bar$ + " "
            bar$ = bar$ + tok$
        NEXT k
        IF b > 0 THEN out$ = out$ + " "
        out$ = out$ + "[" + bar$ + "]"
    NEXT b
    RETURN "<" + out$ + ">"
ENDFUNC
