' Live session - edit, then Ctrl+Enter plays it from the next bar.
' Ctrl+. stops every track, Ctrl+S saves this buffer.

SOUND.MASTER "FIXED", 0.5
SOUND.BPM 128
SOUND.REVERB 0.8, 0.5, 1.0, 0.4

' drums: kick, clap, swung hats with accents
SOUND.KIT 0, "SYNTH"
SOUND.SEQ 0, "bd*4, ~ cp ~ cp, gain([0.45 1]*8, swing(4, hh*16))", "VOICE"

' bass on the offbeat, plucked by the filter envelope
SOUND.VOICE 1, "SAW", 0.002, 0.12, 0.3, 0.05
SOUND.FILTER 1, 200, 0.5
SOUND.FENV 1, 3, 0.002, 0.1
SOUND.SIDECHAIN 1, 0, 0.6
SOUND.SEQ 1, "<[~ a1]*4 [~ f1]*4 [~ c2]*4 [~ g1]*4>", "VOICE"

' arpeggio in stereo, cutoff sweeping over eight bars
SOUND.VOICE 2, "SAW", 0.003, 0.15, 0.4, 0.15
SOUND.UNISON 2, 5, 0.3, 0.8
SOUND.FILTER 2, 1200, 0.5
SOUND.MOD 2, "CUTOFF", "SINE", 500, 5000, 8
SOUND.REVERBSEND 2, 0.4
SOUND.GAIN 2, 0.4
SOUND.SEQ 2, "juxBy(0.6, rev, arp(updown, <[a3,c4,e4] [f3,a3,c4] [c4,e4,g4] [g3,b3,d4]>*2))", "VOICE"
