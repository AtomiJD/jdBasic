' lyrics.jdb - lyrics made to measure for a melody: every line has
' exactly as many syllables as its bar has notes, lines rhyme in pairs,
' the chorus turns on a hook that becomes the song's title, and a line
' too short for its notes stutters its hook word or holds its last
' vowel. Each line comes with its sung spelling for SOUND.SING, the word
' under every note, and the NEON elements its words call up.
'
'   IMPORT LYRICS
'   LYRICS.INIT "neon", 7
'   DIM verse = LYRICS.VERSE([5, 4, 5, 3])
'   DIM chorus = LYRICS.CHORUS([5, 4, 5, 3])
'   SOUND.SING 6, LYRICS.SUNG$(verse)
'   PRINT LYRICS.TEXT$(verse[0])
'
' Lines are numbers; TEXT$, SING$, WORD$, ELEMENTS$ read them. Themes:
' neon, space, love, code. LYRICS.SPELL$ spells any English text for
' SOUND.SING by rule.
'
' Words come in classes of meaning, so that any word of a class makes
' sense in its slot: GLOW things shine and GLOWV says how, a SOUND
' does SOUNDV, a HEART does HEARTV, a TV verb names the classes it
' takes as object. A verse tells a small scene in four steps, SET the
' place, IMG an image, ACT what we do, FEEL how it feels, in one place
' and one person (we or I) throughout.

EXPORT MODULE LYRICS

' ── The words ───────────────────────────────────────────────────
' "CLASS: word=spelling ... | CLASS: ...", syllables split by "." in
' the sung spelling, "_" in a word stands for a space, a TV verb ends
' on ">" and its object classes joined by "+"

DIM CORE_WORDS$ AS STRING = "GLOW: light=lait fire=fai.er spark=spark star=star moon=mun flame=fleim sun=suhn | GLOWS: lights=laits stars=starz sparks=sparks flames=fleimz colors=kuh.lerz | GLOWV: shine=shain glow=glou burn=bern flash=flaesh glitter=glih.ter blaze=bleiz sparkle=spar.kuhl | SEE: golden=goul.den bright=brait silver=sihl.ver burning=ber.nihng shining=shai.nihng glowing=glou.ihng endless=end.les | SOUND: beat=bit bass=beis rhythm=rih.dhuhm music=myu.zihk song=sawng drum=druhm | SOUNDV: play=plei call=kawl pound=paund roll=roul drop=drawp ring=rihng | HEART: heart=hart soul=soul body=baw.di mind=maind | HEARTV: beat=bit burn=bern race=reis shake=sheik sing=sihng | IN: night=nait dark=dark crowd=kraud rain=rein light=lait | ON: street=strit floor=flor edge=ej road=roud | UNDER: stars=starz moon=mun sky=skai lights=laits | SKY: sky=skai moon=mun stars=starz sun=suhn | DREAM: dream=drim night=nait light=lait sun=suhn feeling=fi.lihng | MOVE: dance=daens move=muv run=ruhn fly=flai spin=spihn jump=juhmp rise=raiz shine=shain | TV: chase=cheis>DREAM+GLOW feel=fil>SOUND touch=tuhch>SKY follow=faw.lou>SOUND+GLOW hear=hir>SOUND catch=kaech>GLOW reach=rich>SKY | FEEL: alive=uh.laiv free=fri wild=waild young=yuhng high=hai awake=uh.weik on_fire=awn.fai.er | TIME: tonight=tu.nait forever=fer.e.ver right_now=rait.nau all_night=awl.nait again=uh.gen till_the_dawn=tihl.dhuh.dawn | INT: oh=ou yeah=yae hey=hei ooh=u whoa=wou"

DIM THEME_NAMES$ = ["neon", "space", "love", "code"]
DIM THEME_WORDS$ = ["GLOW: neon=ni.awn laser=lei.zer screen=skrin signal=sihg.nuhl | GLOWS: lasers=lei.zerz screens=skrinz signs=sainz neon_lights=ni.awn.laits | GLOWV: flicker=flih.ker pulse=puhls | SEE: neon=ni.awn electric=ih.lek.trihk midnight=mihd.nait violet=vai.uh.let | SOUND: synth=sihnth pulse=puhls | IN: city=sih.ti club=kluhb zone=zoun | ON: highway=hai.wei skyline=skai.lain | UNDER: neon_lights=ni.awn.laits city_lights=sih.ti.laits | FEEL: electric=ih.lek.trihk wired=wai.erd", "GLOW: comet=kaw.met nova=nou.vuh starlight=star.lait moonlight=mun.lait | GLOWS: comets=kaw.mets planets=plae.nets galaxies=gae.luhk.siz | SEE: cosmic=kawz.mihk distant=dihs.tuhnt stellar=ste.ler lunar=lu.ner solar=sou.ler | IN: void=void silence=sai.luhns | UNDER: planets=plae.nets galaxy=gae.luhk.si | SKY: planets=plae.nets galaxy=gae.luhk.si horizon=huh.rai.zuhn | MOVE: float=flout drift=drihft orbit=awr.biht launch=lawnch | FEEL: weightless=weit.les infinite=ihn.fih.niht", "GLOW: moonlight=mun.lait sunshine=suhn.shain | DEAR: angel=ein.jel star=star sunshine=suhn.shain everything=ev.ri.thihng light=lait | SEE: tender=ten.der gentle=jen.tuhl secret=si.kret precious=pre.shuhs | IN: summer=suh.mer moonlight=mun.lait | UNDER: moonlight=mun.lait summer_sky=suh.mer.skai | LOVEV: love=luhv need=nid miss=mihs want=wawnt | FEEL: in_love=ihn.luhv", "GLOW: pixel=pihk.suhl screen=skrin cursor=ker.ser | GLOWS: pixels=pihk.suhlz screens=skrinz numbers=nuhm.berz | SEE: digital=dih.jih.tuhl binary=bai.nuh.ri virtual=ver.chu.uhl electric=ih.lek.trihk | SOUND: signal=sihg.nuhl | IN: machine=muh.shin system=sihs.tuhm grid=grihd code=koud network=net.werk | DATA: data=dei.tuh code=koud signal=sihg.nuhl current=ker.ent | DATAV: flow=flou run=ruhn loop=lup glow=glou | TV: compile=kuhm.pail>CODE boot=but>SYS hack=haek>SYS run=ruhn>CODE | CODE: code=koud program=prou.graem data=dei.tuh | SYS: system=sihs.tuhm machine=muh.shin grid=grihd mainframe=mein.freim | FEEL: online=awn.lain digital=dih.jih.tuhl electric=ih.lek.trihk"]

' ── The lines ───────────────────────────────────────────────────
' "STAGE: template; template | STAGE: ...". A slot {CLASS} takes a
' word of the class, {CLASS:s} and {CLASS:ing} an inflected one, {OBJ}
' an object of the last TV verb, {=} the slot word before it again;
' {we} {we_are} {our} {us} follow the section's person

DIM CORE_LINES$ AS STRING = "SET: {TIME} in the {IN}; in the {IN}; out in the {IN}; on the {ON}; under the {UNDER}; under {SEE} {GLOWS}; the {GLOW} {GLOWV:s}; the {GLOWS} {GLOWV} | IMG: the {GLOWS} are {GLOWV:ing}; {SEE} {GLOWS}; {SEE} {GLOW}; the {SOUND} {SOUNDV:s}; feel the {SOUND}; {our} {HEART} {HEARTV:s}; the {GLOW} {GLOWV:s} on {us}; the {GLOW} is {GLOWV:ing}; {GLOWS} in {our} eyes | ACT: {we} {MOVE} {TIME}; {we} {MOVE} in the {IN}; {we} {TV} the {OBJ}; {TV} the {OBJ}; {MOVE} with me; {MOVE} with me {TIME}; come and {MOVE}; come and {MOVE} {TIME}; {we_are} {TV:ing} the {OBJ}; {we_are} {MOVE:ing}; let's {MOVE} {TIME} | FEEL: {we_are} {FEEL}; {we_are} {FEEL} {TIME}; {FEEL} {TIME}; {we} feel {FEEL}; {we} feel so {FEEL}; {our} {HEART} on fire; never let it go; never let the {GLOW} go; {MOVE} {TIME} | CHORUS: {MOVE} with me {TIME}; {we} {MOVE} {TIME}; never let the {GLOW} go; light it up {TIME}; {we_are} {FEEL}; {FEEL} {TIME}; {MOVE} {=} {=}; {MOVE} {TIME}; {TV} the {OBJ}; {INT} {=} {FEEL} | HOOK: {TITLE}; oh {TITLE}; {TITLE} {TIME}; my {TITLE}; {TITLE} {INT}; {INT} {=} {TITLE}"
DIM THEME_LINES$ = ["SET: the {IN} never sleeps; {TIME} on the {ON} | IMG: {SEE} signs {GLOWV}; the {SOUND} is {SEE} | ACT: {we} {MOVE} on the {ON}; {we} drive into the {IN}", "SET: far beyond the {SKY}; {TIME} in {IN} | IMG: {GLOWS} pass {us} by; the {SKY} is calling | ACT: {we} {MOVE} to the {SKY}; {we} {MOVE} through the {IN} | FEEL: lost in space; {we_are} {FEEL} in space", "SET: in your arms {TIME}; kiss me under the {UNDER} | IMG: your eyes are {SEE}; {our} {HEART} {HEARTV:s} for you | ACT: hold me {TIME}; I {LOVEV} you {TIME}; stay with me {TIME} | FEEL: you are my {DEAR}; {we_are} {FEEL}", "SET: deep in the {SYS}; {TIME} in the {IN} | IMG: the {DATA} {DATAV:s}; {SEE} {GLOWS} | ACT: {we} {TV} the {OBJ}; {TV} the {OBJ} {TIME} | FEEL: {we_are} {FEEL}; ghost in the machine"]

' words the templates spell out
DIM FUNCTION_WORDS$ AS STRING = "i=ai you=yu we=wi me=mi my=mai the=dhuh a=uh in=ihn to=tu and=aend of=uhv with=wihdh like=laik all=awl is=ihz are=ar am=aem through=thru under=uhn.der every=ev.ri never=nev.er let=let let's=lets up=uhp come=kuhm hold=hould on=awn go=gou it=iht heart=hart light=lait so=sou out=aut feel=fil far=far beyond=bih.yawnd sleeps=slips lost=lawst us=uhs eyes=aiz by=bai pass=paes calling=kaw.lihng drive=draiv into=ihn.tu kiss=kihs stay=stei for=for deep=dip ghost=goust fire=fai.er signs=sainz"

' common words English does not spell the way it sounds
DIM IRREGULAR$ AS STRING = "one=wuhn two=tu three=thri four=for five=faiv six=sihks seven=se.vuhn eight=eit nine=nain ten=ten hello=huh.lou basic=bei.sihk do=du does=duhz done=duhn what=wuht who=hu where=wer there=dher their=dher they=dhei said=sed says=sez some=suhm come=kuhm love=luhv gone=gawn have=haev give=gihv live=lihv was=wuhz were=wer been=bihn your=yor our=aur hour=aur eye=ai eyes=aiz people=pi.puhl heart=hart night=nait light=lait want=wawnt water=waw.ter money=muh.ni only=oun.li once=wuhns friend=frend friends=frendz could=kud would=wud should=shud again=uh.gen away=uh.wei above=uh.buhv because=bih.kuhz many=me.ni any=e.ni every=ev.ri very=ve.ri city=sih.ti music=myu.zihk kaiku=kai.ku jd=jei.di"

' the NEON element a word calls up
DIM ELEMENT_OF$ AS STRING = "moon=moon moonlight=moon night=moon midnight=moon star=stars stars=stars starlight=stars sky=stars space=stars comet=stars comets=stars nova=stars rocket=stars earth=earth world=earth planet=orbits planets=orbits orbit=orbits horizon=earth galaxy=points galaxies=points universe=points void=tunnel city=city cities=city skyline=city street=city streets=city club=city highway=floor road=floor floor=floor rain=terrain heart=polar soul=polar love=polar angel=polar pulse=ecg beat=ecg body=ecg drum=ecg signal=scope voice=scope song=scope music=spectrum bass=spectrum rhythm=spectrum synth=spectrum frequency=radar code=hex data=hex pixel=hex pixels=hex program=hex numbers=hex machine=hypercube system=hypercube grid=hypercube mainframe=hypercube network=hypercube current=dial cursor=counter tonight=counter forever=counter fire=knot flame=knot flames=knot spark=knot sparks=knot dream=tunnel laser=tunnel lasers=tunnel neon=tunnel light=points lights=points sun=points sunshine=points colors=rings screen=hex screens=hex signs=city"

' the word table: shown word, sung spelling, syllables, rhyme, theme
' flag, object classes of a TV verb
DIM WORD_TXT$ = [""]
DIM WORD_SP$ = [""]
DIM WORD_SYL = [0]
DIM WORD_RHY$ = [""]
DIM WORD_TH = [0]
DIM WORD_OBJ$ = [""]
DIM n_words AS INTEGER = 0
DIM POOL = {}
DIM RPOOL = {}
DIM RCOUNT = {}
DIM TPL = {}
DIM FW = {}
DIM ELEM = {}
DIM USED = {}
DIM USED_T = {}

' the lines made so far
DIM L_TEXT$ = [""]
DIM L_SING$ = [""]
DIM L_WORDS$ = [""]
DIM L_RHYME$ = [""]
DIM L_LAST$ = [""]
DIM L_ELEMS$ = [""]
DIM n_lines AS INTEGER = 0

DIM title_words$ AS STRING = ""
DIM title_phons$ AS STRING = ""
DIM CHORUS_CACHE = {}

' the section being written: its person and its place
DIM sec_person$ AS STRING = "we"
DIM sec_place$ AS STRING = ""
' the last syllable the rhyming line should not repeat
DIM avoid_syl$ AS STRING = ""
DIM fallback_depth AS INTEGER = 0

' the template being filled
DIM c_ok AS INTEGER = TRUE
DIM c_words$ AS STRING = ""
DIM c_phons$ AS STRING = ""
DIM c_slots$ AS STRING = ""
DIM c_syl AS INTEGER = 0
DIM c_bonus AS DOUBLE = 0

DIM VOWEL_PHONES$ = ["ai", "ei", "oi", "au", "ou", "ae", "uh", "ih", "er", "aw", "ee", "oo", "ah", "eh", "oh", "a", "e", "i", "o", "u"]

FUNC PICK(n AS INTEGER) AS INTEGER
    RETURN INT(RND() * n) MOD n
ENDFUNC

FUNC SYLS(p$) AS INTEGER
    RETURN LEN(p$) - LEN(REPLACE$(REPLACE$(p$, ".", ""), "|", "")) + 1
ENDFUNC

FUNC IS_VOWEL_CH(c$) AS INTEGER
    RETURN INSTR("aeiou", c$) >= 0
ENDFUNC

' The rhyme of a spelling: its last syllable from the first vowel on
FUNC KEY$(p$) AS STRING
    DIM parts$ = SPLIT(REPLACE$(p$, "|", "."), ".")
    DIM last$ AS STRING = parts$[LEN(parts$) - 1]
    DIM i AS INTEGER
    FOR i = 0 TO LEN(last$) - 1
        IF IS_VOWEL_CH(MID$(last$, i, 1)) THEN RETURN MID$(last$, i, LEN(last$) - i)
    NEXT i
    RETURN last$
ENDFUNC

' The vowel a rhyme starts on: "ai" of "ait", lines on the same vowel
' rhyme loosely
FUNC NUC$(k$) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(VOWEL_PHONES$) - 1
        IF LEFT$(k$, LEN(VOWEL_PHONES$[i])) = VOWEL_PHONES$[i] THEN RETURN VOWEL_PHONES$[i]
    NEXT i
    RETURN k$
ENDFUNC

FUNC LAST_SYL$(p$) AS STRING
    DIM parts$ = SPLIT(REPLACE$(p$, "|", "."), ".")
    RETURN parts$[LEN(parts$) - 1]
ENDFUNC

' Whether a word shares its first four letters (or all of a shorter
' one) with one of the words, given split by "|"
FUNC SAME_STEM(w$, words$) AS INTEGER
    IF words$ = "" THEN RETURN FALSE
    DIM ws$ = SPLIT(words$, "|")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(ws$) - 1
        DIM k AS INTEGER = MIN([4, LEN(w$), LEN(ws$[i])])
        IF k >= 3 ANDALSO LEFT$(LCASE$(w$), k) = LEFT$(LCASE$(ws$[i]), k) THEN RETURN TRUE
    NEXT i
    RETURN FALSE
ENDFUNC

' ── Inflection ──────────────────────────────────────────────────

' A spelling with one more syllable, tail$, that takes the last
' consonant along as its onset: "shain" + "ihng" = "shai.nihng"
FUNC ADD_SYL$(p$, tail$) AS STRING
    DIM n AS INTEGER = LEN(p$)
    DIM last2$ AS STRING = RIGHT$(p$, 2)
    IF INSTR(" sh ch zh th dh ", " " + last2$ + " ") >= 0 THEN RETURN LEFT$(p$, n - 2) + "." + last2$ + tail$
    IF last2$ = "ng" ORELSE last2$ = "er" THEN RETURN p$ + "." + tail$
    DIM last1$ AS STRING = RIGHT$(p$, 1)
    IF n >= 2 ANDALSO INSTR("aeiouwy.", last1$) < 0 ANDALSO MID$(p$, n - 2, 1) <> "." THEN RETURN LEFT$(p$, n - 1) + "." + last1$ + tail$
    RETURN p$ + "." + tail$
ENDFUNC

' A verb in the third person or with -ing, as shown and as sung
FUNC INFL_TXT$(w$, sfx$, syl AS INTEGER) AS STRING
    DIM n AS INTEGER = LEN(w$)
    DIM last$ AS STRING = RIGHT$(w$, 1)
    IF sfx$ = "s" THEN
        IF INSTR("sxz", last$) >= 0 ORELSE RIGHT$(w$, 2) = "sh" ORELSE RIGHT$(w$, 2) = "ch" THEN RETURN w$ + "es"
        IF last$ = "y" ANDALSO NOT IS_VOWEL_CH(MID$(w$, n - 2, 1)) THEN RETURN LEFT$(w$, n - 1) + "ies"
        RETURN w$ + "s"
    ENDIF
    IF last$ = "e" ANDALSO RIGHT$(w$, 2) <> "ee" THEN RETURN LEFT$(w$, n - 1) + "ing"
    ' one syllable ending on one vowel and one consonant doubles it
    IF syl = 1 ANDALSO n >= 3 ANDALSO INSTR("aeiouwxy", last$) < 0 ANDALSO IS_VOWEL_CH(MID$(w$, n - 2, 1)) ANDALSO NOT IS_VOWEL_CH(MID$(w$, n - 3, 1)) THEN RETURN w$ + last$ + "ing"
    RETURN w$ + "ing"
ENDFUNC

FUNC INFL_SP$(p$, sfx$) AS STRING
    IF sfx$ = "ing" THEN RETURN ADD_SYL$(p$, "ihng")
    DIM last$ AS STRING = RIGHT$(p$, 1)
    DIM last2$ AS STRING = RIGHT$(p$, 2)
    IF INSTR("szj", last$) >= 0 ORELSE last2$ = "sh" ORELSE last2$ = "ch" ORELSE last2$ = "zh" THEN RETURN ADD_SYL$(p$, "ihz")
    IF INSTR("ptkf", last$) >= 0 ORELSE last2$ = "th" THEN RETURN p$ + "s"
    RETURN p$ + "z"
ENDFUNC

' ── Loading ─────────────────────────────────────────────────────

SUB ADD_POOL(m, key$, idx AS INTEGER)
    IF TYPEOF(m{key$}) = "NONE" THEN
        m{key$} = [idx]
    ELSE
        m{key$} = APPEND(m{key$}, idx)
    ENDIF
ENDSUB

SUB ADD_WORDS(cat$, list$, themed AS INTEGER)
    IF list$ = "" THEN RETURN
    DIM items$ = SPLIT(list$, " ")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items$) - 1
        DIM eq AS INTEGER = INSTR(items$[i], "=")
        IF eq < 0 THEN CONTINUEFOR
        DIM w$ AS STRING = REPLACE$(LEFT$(items$[i], eq), "_", " ")
        DIM p$ AS STRING = MID$(items$[i], eq + 1, LEN(items$[i]) - eq - 1)
        DIM obj$ AS STRING = ""
        DIM gt AS INTEGER = INSTR(p$, ">")
        IF gt >= 0 THEN
            obj$ = MID$(p$, gt + 1, LEN(p$) - gt - 1)
            p$ = LEFT$(p$, gt)
        ENDIF
        IF n_words = 0 THEN
            WORD_TXT$[0] = w$
            WORD_SP$[0] = p$
            WORD_SYL[0] = SYLS(p$)
            WORD_RHY$[0] = KEY$(p$)
            WORD_TH[0] = themed
            WORD_OBJ$[0] = obj$
        ELSE
            WORD_TXT$ = APPEND(WORD_TXT$, w$)
            WORD_SP$ = APPEND(WORD_SP$, p$)
            WORD_SYL = APPEND(WORD_SYL, SYLS(p$))
            WORD_RHY$ = APPEND(WORD_RHY$, KEY$(p$))
            WORD_TH = APPEND(WORD_TH, themed)
            WORD_OBJ$ = APPEND(WORD_OBJ$, obj$)
        ENDIF
        DIM nuc$ AS STRING = NUC$(KEY$(p$))
        ADD_POOL POOL, cat$, n_words
        ADD_POOL RPOOL, cat$ + ":" + nuc$, n_words
        IF TYPEOF(RCOUNT{nuc$}) = "NONE" THEN RCOUNT{nuc$} = 0
        RCOUNT{nuc$} = RCOUNT{nuc$} + 1
        n_words = n_words + 1
    NEXT i
ENDSUB

SUB ADD_TPL(key$, t$)
    IF TYPEOF(TPL{key$}) = "NONE" THEN
        TPL{key$} = [t$]
    ELSE
        TPL{key$} = APPEND(TPL{key$}, t$)
    ENDIF
ENDSUB

' Splits "CLASS: ... | CLASS: ..." and hands each part on as words, or
' as templates split by ";"
SUB LOAD_SECTIONS(spec$, themed AS INTEGER, as_lines AS INTEGER)
    DIM parts$ = SPLIT(spec$, "|")
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO LEN(parts$) - 1
        DIM colon AS INTEGER = INSTR(parts$[i], ":")
        IF colon < 0 THEN CONTINUEFOR
        DIM cat$ AS STRING = TRIM$(LEFT$(parts$[i], colon))
        DIM body$ AS STRING = TRIM$(MID$(parts$[i], colon + 1, LEN(parts$[i]) - colon - 1))
        IF as_lines THEN
            DIM tpls$ = SPLIT(body$, ";")
            FOR k = 0 TO LEN(tpls$) - 1
                DIM t$ AS STRING = TRIM$(tpls$[k])
                IF t$ = "" THEN CONTINUEFOR
                ADD_TPL cat$, t$
                IF cat$ <> "CHORUS" ANDALSO cat$ <> "HOOK" THEN ADD_TPL "ALL", t$
            NEXT k
        ELSE
            ADD_WORDS cat$, body$, themed
        ENDIF
    NEXT i
ENDSUB

SUB LOAD_MAP(m, list$)
    DIM items$ = SPLIT(list$, " ")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items$) - 1
        DIM eq AS INTEGER = INSTR(items$[i], "=")
        IF eq >= 0 THEN m{LEFT$(items$[i], eq)} = MID$(items$[i], eq + 1, LEN(items$[i]) - eq - 1)
    NEXT i
ENDSUB

' Starts over with a theme's words; the same seed writes the same song
EXPORT SUB INIT(theme$, seed AS INTEGER)
    RANDOMSEED(seed)
    n_words = 0
    n_lines = 0
    WORD_TXT$ = [""]
    WORD_SP$ = [""]
    WORD_SYL = [0]
    WORD_RHY$ = [""]
    WORD_TH = [0]
    WORD_OBJ$ = [""]
    L_TEXT$ = [""]
    L_SING$ = [""]
    L_WORDS$ = [""]
    L_RHYME$ = [""]
    L_LAST$ = [""]
    L_ELEMS$ = [""]
    POOL = {}
    RPOOL = {}
    RCOUNT = {}
    TPL = {}
    FW = {}
    ELEM = {}
    USED = {}
    USED_T = {}
    CHORUS_CACHE = {}
    DIM th AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(THEME_NAMES$) - 1
        IF THEME_NAMES$[i] = LCASE$(theme$) THEN th = i
    NEXT i
    LOAD_SECTIONS CORE_WORDS$, 0, FALSE
    LOAD_SECTIONS THEME_WORDS$[th], 1, FALSE
    LOAD_SECTIONS CORE_LINES$, 0, TRUE
    LOAD_SECTIONS THEME_LINES$[th], 1, TRUE
    LOAD_MAP FW, IRREGULAR$
    LOAD_MAP FW, FUNCTION_WORDS$
    LOAD_MAP ELEM, ELEMENT_OF$
    MAKE_TITLE
ENDSUB

' The hook: an adjective and a noun that shines or is a place, three to
' five syllables, alike in their first sound if it can be had
SUB MAKE_TITLE()
    DIM nouns = APPEND(APPEND(POOL{"GLOW"}, POOL{"IN"}), POOL{"SKY"})
    DIM best AS DOUBLE = -1E9
    DIM t AS INTEGER
    FOR t = 1 TO 300
        DIM a AS INTEGER = POOL{"SEE"}[PICK(LEN(POOL{"SEE"}))]
        DIM nn AS INTEGER = nouns[PICK(LEN(nouns))]
        IF SAME_STEM(WORD_TXT$[a], WORD_TXT$[nn]) THEN CONTINUEFOR
        DIM s AS INTEGER = WORD_SYL[a] + WORD_SYL[nn]
        IF s < 3 ORELSE s > 5 THEN CONTINUEFOR
        DIM sc AS DOUBLE = WORD_TH[a] + 1.5 * WORD_TH[nn] + RND() * 0.8
        IF s = 5 THEN sc = sc - 0.6
        IF LEFT$(WORD_TXT$[a], 1) = LEFT$(WORD_TXT$[nn], 1) THEN sc = sc + 1.0
        IF sc > best THEN
            best = sc
            title_words$ = WORD_TXT$[a] + "|" + WORD_TXT$[nn]
            title_phons$ = WORD_SP$[a] + "|" + WORD_SP$[nn]
        ENDIF
    NEXT t
ENDSUB

EXPORT FUNC TITLE$() AS STRING
    RETURN UCASE$(REPLACE$(title_words$, "|", " "))
ENDFUNC

' ── Writing lines ───────────────────────────────────────────────

' A template in the section's person
FUNC IN_PERSON$(tpl$) AS STRING
    DIM t$ AS STRING = tpl$
    IF sec_person$ = "I" THEN
        t$ = REPLACE$(t$, "{we_are}", "I am")
        t$ = REPLACE$(t$, "{we}", "I")
        t$ = REPLACE$(t$, "{our}", "my")
        t$ = REPLACE$(t$, "{us}", "me")
    ELSE
        t$ = REPLACE$(t$, "{we_are}", "we are")
        t$ = REPLACE$(t$, "{we}", "we")
        t$ = REPLACE$(t$, "{our}", "our")
        t$ = REPLACE$(t$, "{us}", "us")
    ENDIF
    RETURN t$
ENDFUNC

' Fills a template with words: c_words$ and c_phons$ ("|" between
' words), c_syl, c_bonus; c_ok FALSE when the rhyme cannot be had
SUB FILL(tpl$, rhyme$, avoid$)
    c_ok = TRUE
    c_words$ = ""
    c_phons$ = ""
    c_slots$ = ""
    c_bonus = 0
    DIM toks$ = SPLIT(IN_PERSON$(tpl$), " ")
    DIM n AS INTEGER = LEN(toks$)
    DIM prev_first$ AS STRING = ""
    DIM prev_w$ AS STRING = ""
    DIM prev_p$ AS STRING = ""
    DIM tv AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM tk$ AS STRING = toks$[i]
        DIM w$ AS STRING = ""
        DIM p$ AS STRING = ""
        IF tk$ = "{TITLE}" THEN
            w$ = title_words$
            p$ = title_phons$
            c_bonus = c_bonus + 0.5
        ELSEIF tk$ = "{=}" THEN
            w$ = prev_w$
            p$ = prev_p$
        ELSEIF LEFT$(tk$, 1) = "{" THEN
            DIM cat$ AS STRING = MID$(tk$, 1, LEN(tk$) - 2)
            DIM sfx$ AS STRING = ""
            DIM colon AS INTEGER = INSTR(cat$, ":")
            IF colon >= 0 THEN
                sfx$ = MID$(cat$, colon + 1, LEN(cat$) - colon - 1)
                cat$ = LEFT$(cat$, colon)
            ENDIF
            IF cat$ = "OBJ" THEN
                IF tv < 0 THEN
                    c_ok = FALSE
                    RETURN
                ENDIF
                DIM objs$ = SPLIT(WORD_OBJ$[tv], "+")
                cat$ = objs$[PICK(LEN(objs$))]
            ENDIF
            DIM idx AS INTEGER = 0
            IF i = n - 1 ANDALSO rhyme$ <> "" ANDALSO sfx$ = "" THEN
                DIM rp = RPOOL{cat$ + ":" + NUC$(rhyme$)}
                IF TYPEOF(rp) = "NONE" THEN
                    c_ok = FALSE
                    RETURN
                ENDIF
                idx = rp[PICK(LEN(rp))]
                IF WORD_TXT$[idx] = avoid$ THEN
                    c_ok = FALSE
                    RETURN
                ENDIF
            ELSE
                DIM pl = POOL{cat$}
                IF TYPEOF(pl) = "NONE" THEN
                    c_ok = FALSE
                    RETURN
                ENDIF
                idx = pl[PICK(LEN(pl))]
            ENDIF
            DIM base$ AS STRING = WORD_TXT$[idx]
            IF cat$ = "TV" THEN tv = idx
            IF sfx$ = "" THEN
                w$ = base$
                p$ = WORD_SP$[idx]
            ELSE
                w$ = INFL_TXT$(base$, sfx$, WORD_SYL[idx])
                p$ = INFL_SP$(WORD_SP$[idx], sfx$)
            ENDIF
            c_bonus = c_bonus + 0.5 * WORD_TH[idx]
            IF cat$ = "INT" THEN c_bonus = c_bonus - 0.8
            IF base$ = sec_place$ THEN
                c_bonus = c_bonus + 1.2
            ELSEIF TYPEOF(USED{base$}) <> "NONE" THEN
                c_bonus = c_bonus - 1.5 * USED{base$}
            ENDIF
            IF INSTR("|" + c_slots$ + "|", "|" + base$ + "|") >= 0 THEN c_bonus = c_bonus - 3
            IF prev_first$ <> "" ANDALSO LEFT$(w$, 1) = prev_first$ THEN c_bonus = c_bonus + 0.6
            IF SAME_STEM(w$, c_words$) THEN c_bonus = c_bonus - 2.5
            prev_first$ = LEFT$(w$, 1)
            c_slots$ = c_slots$ + "|" + base$
        ELSE
            w$ = tk$
            IF TYPEOF(FW{LCASE$(tk$)}) = "NONE" THEN
                p$ = SPELL_WORD$(tk$)
            ELSE
                p$ = FW{LCASE$(tk$)}
            ENDIF
            prev_first$ = ""
        ENDIF
        prev_w$ = w$
        prev_p$ = p$
        IF c_words$ = "" THEN
            c_words$ = w$
            c_phons$ = p$
        ELSE
            c_words$ = c_words$ + "|" + w$
            c_phons$ = c_phons$ + "|" + p$
        ENDIF
    NEXT i
    c_syl = SYLS(c_phons$)
ENDSUB

' The letters of a word up to its first vowel sound: "to" of tonight
FUNC STUTTER$(w$) AS STRING
    DIM i AS INTEGER = 0
    DO WHILE i < LEN(w$) ANDALSO NOT IS_VOWEL_CH(LCASE$(MID$(w$, i, 1)))
        i = i + 1
    LOOP
    DO WHILE i < LEN(w$) ANDALSO IS_VOWEL_CH(LCASE$(MID$(w$, i, 1)))
        i = i + 1
    LOOP
    RETURN LEFT$(w$, MAX([1, i]))
ENDFUNC

' Writes a line of n syllables from the templates, rhyming on rhyme$
' when it is given (and not ending on avoid$); answers its number
FUNC MAKE_LINE(n AS INTEGER, rhyme$, avoid$, templates$, chorus AS INTEGER) AS INTEGER
    DIM best AS DOUBLE = -1E9
    DIM b_words$ AS STRING = ""
    DIM b_phons$ AS STRING = ""
    DIM b_slots$ AS STRING = ""
    DIM b_tpl$ AS STRING = ""
    DIM max_hold AS INTEGER = 2
    IF chorus THEN max_hold = 3
    DIM t AS INTEGER
    FOR t = 1 TO 400
        DIM tpl$ AS STRING = templates$[PICK(LEN(templates$))]
        FILL tpl$, rhyme$, avoid$
        IF NOT c_ok THEN CONTINUEFOR
        IF c_syl > n ORELSE n - c_syl > max_hold THEN CONTINUEFOR
        DIM ws$ = SPLIT(c_words$, "|")
        DIM k$ AS STRING = KEY$(c_phons$)
        IF rhyme$ <> "" THEN
            IF NUC$(k$) <> NUC$(rhyme$) THEN CONTINUEFOR
            IF SAME_STEM(ws$[LEN(ws$) - 1], avoid$) THEN CONTINUEFOR
        ENDIF
        DIM sc AS DOUBLE = c_bonus - (n - c_syl) * 1.1 + RND() * 0.4
        IF chorus THEN sc = sc + (n - c_syl) * 0.5
        IF TYPEOF(USED_T{tpl$}) <> "NONE" THEN sc = sc - 1.4 * USED_T{tpl$}
        IF rhyme$ <> "" THEN
            IF k$ = rhyme$ THEN sc = sc + 1.5
            IF LAST_SYL$(c_phons$) = avoid_syl$ THEN sc = sc - 2.5
        ELSEIF TYPEOF(RCOUNT{NUC$(k$)}) <> "NONE" THEN
            sc = sc + 0.3 * MIN([RCOUNT{NUC$(k$)}, 8])
        ENDIF
        IF sc > best THEN
            best = sc
            b_words$ = c_words$
            b_phons$ = c_phons$
            b_slots$ = c_slots$
            b_tpl$ = tpl$
        ENDIF
    NEXT t
    IF best < -1E8 ANDALSO fallback_depth < 2 THEN
        fallback_depth = fallback_depth + 1
        DIM id AS INTEGER
        IF rhyme$ <> "" THEN
            id = MAKE_LINE(n, "", "", templates$, chorus)
        ELSE
            id = MAKE_LINE(n, "", "", TPL{"ALL"}, chorus)
        ENDIF
        fallback_depth = fallback_depth - 1
        RETURN id
    ENDIF
    IF best < -1E8 THEN
        b_words$ = "oh"
        b_phons$ = "ou"
    ENDIF
    IF b_tpl$ <> "" THEN
        IF TYPEOF(USED_T{b_tpl$}) = "NONE" THEN USED_T{b_tpl$} = 0
        USED_T{b_tpl$} = USED_T{b_tpl$} + 1
    ENDIF
    RETURN STORE_LINE(n, b_words$, b_phons$, b_slots$, chorus)
ENDFUNC

' Lays the chosen words on n notes and keeps the line
FUNC STORE_LINE(n AS INTEGER, words$, phons$, slots$, chorus AS INTEGER) AS INTEGER
    DIM ws$ = SPLIT(words$, "|")
    DIM ps$ = SPLIT(phons$, "|")
    DIM last AS INTEGER = LEN(ws$) - 1
    DIM holds AS INTEGER = n - SYLS(phons$)
    DIM stutter AS INTEGER = FALSE
    IF holds > 0 ANDALSO chorus ANDALSO SYLS(ps$[last]) >= 2 ANDALSO RND() < 0.7 THEN stutter = TRUE
    DIM sing$ AS STRING = ""
    DIM under$ AS STRING = ""
    DIM shown$ AS STRING = ""
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO last
        DIM syl$ = SPLIT(ps$[i], ".")
        DIM w$ AS STRING = ws$[i]
        IF i = last ANDALSO stutter THEN
            DIM st$ AS STRING = STUTTER$(w$)
            FOR k = 1 TO holds
                sing$ = sing$ + " " + syl$[0]
                under$ = under$ + "|" + w$
                shown$ = shown$ + " " + st$ + "-"
            NEXT k
            shown$ = RTRIM$(shown$)
            IF RIGHT$(shown$, 1) = "-" THEN
                shown$ = shown$ + w$
            ELSE
                shown$ = shown$ + " " + w$
            ENDIF
        ELSE
            shown$ = shown$ + " " + w$
        ENDIF
        FOR k = 0 TO LEN(syl$) - 1
            sing$ = sing$ + " " + syl$[k]
            under$ = under$ + "|" + w$
        NEXT k
    NEXT i
    IF NOT stutter THEN
        FOR k = 1 TO holds
            sing$ = sing$ + " -"
            under$ = under$ + "|" + ws$[last]
        NEXT k
    ENDIF
    ' the slot words count as used, so later lines pick others
    DIM sl$ = SPLIT(slots$, "|")
    FOR i = 0 TO LEN(sl$) - 1
        IF sl$[i] <> "" THEN
            IF TYPEOF(USED{sl$[i]}) = "NONE" THEN USED{sl$[i]} = 0
            USED{sl$[i]} = USED{sl$[i]} + 1
        ENDIF
    NEXT i
    DIM elems$ AS STRING = ""
    FOR i = 0 TO last
        DIM el$ = ELEM{LCASE$(ws$[i])}
        IF TYPEOF(el$) <> "NONE" ANDALSO INSTR("," + elems$ + ",", "," + el$ + ",") < 0 THEN
            IF elems$ = "" THEN
                elems$ = el$
            ELSE
                elems$ = elems$ + "," + el$
            ENDIF
        ENDIF
    NEXT i
    shown$ = LTRIM$(shown$)
    shown$ = UCASE$(LEFT$(shown$, 1)) + MID$(shown$, 1, LEN(shown$) - 1)
    IF n_lines = 0 THEN
        L_TEXT$[0] = shown$
        L_SING$[0] = LTRIM$(sing$)
        L_WORDS$[0] = MID$(under$, 1, LEN(under$) - 1)
        L_RHYME$[0] = KEY$(ps$[last])
        L_LAST$[0] = ws$[last]
        L_ELEMS$[0] = elems$
    ELSE
        L_TEXT$ = APPEND(L_TEXT$, shown$)
        L_SING$ = APPEND(L_SING$, LTRIM$(sing$))
        L_WORDS$ = APPEND(L_WORDS$, MID$(under$, 1, LEN(under$) - 1))
        L_RHYME$ = APPEND(L_RHYME$, KEY$(ps$[last]))
        L_LAST$ = APPEND(L_LAST$, ws$[last])
        L_ELEMS$ = APPEND(L_ELEMS$, elems$)
    ENDIF
    n_lines = n_lines + 1
    RETURN n_lines - 1
ENDFUNC

' A verse: one line per entry of counts (syllables = notes), rhymed in
' pairs, first with second, third with fourth. Its lines walk through
' the four stages SET, IMG, ACT, FEEL, in one place and one person.
EXPORT FUNC VERSE(counts)
    DIM stages$ = ["SET", "IMG", "ACT", "FEEL"]
    DIM n AS INTEGER = LEN(counts)
    sec_person$ = "we"
    IF RND() < 0.4 THEN sec_person$ = "I"
    PICK_PLACE
    DIM ids = ZEROS(n)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1 STEP 2
        DIM st_a$ AS STRING = stages$[INT(i * 4 / n)]
        IF i + 1 < n THEN
            PAIR counts[i], counts[i + 1], TPL{st_a$}, TPL{stages$[INT((i + 1) * 4 / n)]}, FALSE
            ids[i] = pair_a
            ids[i + 1] = pair_b
        ELSE
            ids[i] = MAKE_LINE(counts[i], "", "", TPL{st_a$}, FALSE)
        ENDIF
    NEXT i
    RETURN ids
ENDFUNC

' The section's place: a word of class IN, of the theme when it can be,
' and one not used for a place before
SUB PICK_PLACE()
    DIM pl = POOL{"IN"}
    DIM best AS DOUBLE = -1E9
    DIM t AS INTEGER
    FOR t = 1 TO 40
        DIM idx AS INTEGER = pl[PICK(LEN(pl))]
        DIM sc AS DOUBLE = 1.5 * WORD_TH[idx] + RND()
        IF TYPEOF(USED{WORD_TXT$[idx]}) <> "NONE" THEN sc = sc - 2 * USED{WORD_TXT$[idx]}
        IF sc > best THEN
            best = sc
            sec_place$ = WORD_TXT$[idx]
        ENDIF
    NEXT t
ENDSUB

DIM pair_a AS INTEGER = 0
DIM pair_b AS INTEGER = 0

' Two lines that rhyme; when the second cannot rhyme on the first, both
' are written again
SUB PAIR(n1 AS INTEGER, n2 AS INTEGER, templates_a$, templates_b$, chorus AS INTEGER)
    DIM attempt AS INTEGER
    FOR attempt = 1 TO 6
        pair_a = MAKE_LINE(n1, "", "", templates_a$, chorus)
        avoid_syl$ = LAST_SYL$(REPLACE$(REPLACE$(L_SING$[pair_a], " -", ""), " ", "."))
        pair_b = MAKE_LINE(n2, L_RHYME$[pair_a], L_LAST$[pair_a], templates_b$, chorus)
        avoid_syl$ = ""
        IF NUC$(L_RHYME$[pair_b]) = NUC$(L_RHYME$[pair_a]) THEN RETURN
    NEXT attempt
ENDSUB

' The chorus: the hook on every other line, the lines between rhymed in
' pairs, sung as we. The same counts give the same chorus again.
EXPORT FUNC CHORUS(counts)
    DIM key$ AS STRING = JOIN(counts, ",")
    IF TYPEOF(CHORUS_CACHE{key$}) <> "NONE" THEN RETURN CHORUS_CACHE{key$}
    sec_person$ = "we"
    sec_place$ = ""
    DIM ids = ZEROS(LEN(counts)) - 1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(counts) - 1
        IF ids[i] >= 0 THEN CONTINUEFOR
        IF i MOD 2 = 0 THEN
            ids[i] = MAKE_LINE(counts[i], "", "", TPL{"HOOK"}, TRUE)
        ELSEIF i + 2 < LEN(counts) THEN
            PAIR counts[i], counts[i + 2], TPL{"CHORUS"}, TPL{"CHORUS"}, TRUE
            ids[i] = pair_a
            ids[i + 2] = pair_b
        ELSE
            ids[i] = MAKE_LINE(counts[i], "", "", TPL{"CHORUS"}, TRUE)
        ENDIF
    NEXT i
    CHORUS_CACHE{key$} = ids
    RETURN ids
ENDFUNC

' The sung spelling of lines, for SOUND.SING
EXPORT FUNC SUNG$(ids) AS STRING
    DIM s$ AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(ids) - 1
        s$ = s$ + " " + L_SING$[ids[i]]
    NEXT i
    RETURN LTRIM$(s$)
ENDFUNC

EXPORT FUNC TEXT$(id AS INTEGER) AS STRING
    RETURN L_TEXT$[id]
ENDFUNC

EXPORT FUNC SING$(id AS INTEGER) AS STRING
    RETURN L_SING$[id]
ENDFUNC

' The word under note k of a line
EXPORT FUNC WORD$(id AS INTEGER, k AS INTEGER) AS STRING
    DIM ws$ = SPLIT(L_WORDS$[id], "|")
    IF k < 0 ORELSE k >= LEN(ws$) THEN RETURN ""
    RETURN ws$[k]
ENDFUNC

EXPORT FUNC SYLLABLES(id AS INTEGER) AS INTEGER
    RETURN LEN(SPLIT(L_SING$[id], " "))
ENDFUNC

' The NEON elements the words of a line call up, "moon,stars"
EXPORT FUNC ELEMENTS$(id AS INTEGER) AS STRING
    RETURN L_ELEMS$[id]
ENDFUNC

' The notes in one bar of a pattern: every step that is no rest
EXPORT FUNC NOTES_IN(bar$) AS INTEGER
    DIM s$ AS STRING = REPLACE$(REPLACE$(REPLACE$(REPLACE$(bar$, "[", " "), "]", " "), "<", " "), ">", " ")
    DIM toks$ = SPLIT(s$, " ")
    DIM n AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(toks$) - 1
        IF toks$[i] <> "" ANDALSO toks$[i] <> "~" ANDALSO toks$[i] <> "_" THEN n = n + 1
    NEXT i
    RETURN n
ENDFUNC

' ── Spelling English by rule ────────────────────────────────────

DIM g2p_out$ AS STRING = ""
DIM g2p_vow = [0]
DIM g2p_nvow AS INTEGER = 0

SUB EMIT(p$, vowel AS INTEGER)
    g2p_nvow = g2p_nvow + vowel
    IF g2p_out$ = "" THEN
        g2p_out$ = p$
        g2p_vow[0] = vowel
    ELSE
        g2p_out$ = g2p_out$ + "," + p$
        g2p_vow = APPEND(g2p_vow, vowel)
    ENDIF
ENDSUB

' One word in the sung spelling, its syllables split by "."
FUNC SPELL_WORD$(word$) AS STRING
    DIM w$ AS STRING = LCASE$(word$)
    IF TYPEOF(FW{w$}) <> "NONE" THEN RETURN FW{w$}
    DIM i AS INTEGER
    FOR i = 0 TO n_words - 1
        IF WORD_TXT$[i] = w$ THEN RETURN WORD_SP$[i]
    NEXT i
    g2p_out$ = ""
    g2p_vow = [0]
    DIM n AS INTEGER = LEN(w$)
    g2p_nvow = 0
    i = 0
    DO WHILE i < n
        DIM c$ AS STRING = MID$(w$, i, 1)
        DIM rest$ AS STRING = MID$(w$, i, n - i)
        DIM nxt$ AS STRING = ""
        IF i + 1 < n THEN nxt$ = MID$(w$, i + 1, 1)
        IF LEFT$(rest$, 4) = "tion" THEN
            EMIT "sh", 0
            EMIT "uh", 1
            EMIT "n", 0
            i = i + 4
        ELSEIF LEFT$(rest$, 3) = "igh" THEN
            EMIT "ai", 1
            i = i + 3
        ELSEIF LEFT$(rest$, 2) = "ee" ORELSE LEFT$(rest$, 2) = "ea" THEN
            EMIT "i", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "oo" THEN
            EMIT "u", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "ai" ORELSE LEFT$(rest$, 2) = "ay" ORELSE LEFT$(rest$, 2) = "ey" THEN
            EMIT "ei", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "oa" THEN
            EMIT "ou", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "oi" ORELSE LEFT$(rest$, 2) = "oy" THEN
            EMIT "oi", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "au" ORELSE LEFT$(rest$, 2) = "aw" THEN
            EMIT "aw", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "ou" THEN
            EMIT "au", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "ow" THEN
            IF i + 2 = n ANDALSO n > 3 THEN
                EMIT "ou", 1
            ELSE
                EMIT "au", 1
            ENDIF
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "ew" ORELSE LEFT$(rest$, 2) = "ue" THEN
            EMIT "u", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "ar" ANDALSO NOT IS_VOWEL_CH(MID$(rest$, 2, 1)) THEN
            EMIT "a", 1
            EMIT "r", 0
            i = i + 2
        ELSEIF (LEFT$(rest$, 2) = "er" ORELSE LEFT$(rest$, 2) = "ir" ORELSE LEFT$(rest$, 2) = "ur") ANDALSO NOT IS_VOWEL_CH(MID$(rest$, 2, 1)) THEN
            EMIT "er", 1
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "or" ANDALSO NOT IS_VOWEL_CH(MID$(rest$, 2, 1)) THEN
            EMIT "aw", 1
            EMIT "r", 0
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "sh" ORELSE LEFT$(rest$, 2) = "ch" ORELSE LEFT$(rest$, 2) = "ng" THEN
            EMIT LEFT$(rest$, 2), 0
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "th" THEN
            IF i = 0 ANDALSO INSTR(" the this that they them there than then those these ", " " + w$ + " ") >= 0 THEN
                EMIT "dh", 0
            ELSE
                EMIT "th", 0
            ENDIF
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "ph" THEN
            EMIT "f", 0
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "wh" ORELSE (i = 0 ANDALSO LEFT$(rest$, 2) = "wr") THEN
            EMIT MID$(rest$, 1, 1), 0
            i = i + 2
        ELSEIF i = 0 ANDALSO LEFT$(rest$, 2) = "kn" THEN
            EMIT "n", 0
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "ck" ORELSE LEFT$(rest$, 2) = "qu" THEN
            EMIT "k", 0
            IF LEFT$(rest$, 2) = "qu" THEN EMIT "w", 0
            i = i + 2
        ELSEIF LEFT$(rest$, 2) = "gh" THEN
            i = i + 2
        ELSEIF i > 0 ANDALSO c$ = MID$(w$, i - 1, 1) ANDALSO NOT IS_VOWEL_CH(c$) THEN
            i = i + 1
        ELSEIF IS_VOWEL_CH(c$) THEN
            ' a vowel, long before one consonant and a final e
            DIM long_v AS INTEGER = FALSE
            IF i + 2 = n - 1 ANDALSO MID$(w$, n - 1, 1) = "e" ANDALSO NOT IS_VOWEL_CH(nxt$) THEN long_v = TRUE
            IF c$ = "e" ANDALSO i = n - 1 ANDALSO g2p_nvow > 0 THEN
                i = i + 1
                CONTINUEDO
            ENDIF
            DIM v$ AS STRING = ""
            IF c$ = "a" THEN v$ = "ae"
            IF c$ = "e" THEN v$ = "e"
            IF c$ = "i" THEN v$ = "ih"
            IF c$ = "o" THEN v$ = "aw"
            IF c$ = "u" THEN v$ = "uh"
            IF long_v THEN
                IF c$ = "a" THEN v$ = "ei"
                IF c$ = "e" THEN v$ = "i"
                IF c$ = "i" THEN v$ = "ai"
                IF c$ = "o" THEN v$ = "ou"
                IF c$ = "u" THEN v$ = "u"
            ENDIF
            IF i = n - 1 ANDALSO c$ = "o" THEN v$ = "ou"
            IF i = n - 1 ANDALSO c$ = "e" THEN v$ = "i"
            EMIT v$, 1
            i = i + 1
        ELSEIF c$ = "y" THEN
            IF i = 0 ORELSE (IS_VOWEL_CH(nxt$) ANDALSO IS_VOWEL_CH(MID$(w$, i - 1, 1))) THEN
                EMIT "y", 0
            ELSEIF g2p_nvow > 0 THEN
                EMIT "i", 1
            ELSE
                EMIT "ai", 1
            ENDIF
            i = i + 1
        ELSEIF c$ = "c" THEN
            IF nxt$ = "e" ORELSE nxt$ = "i" ORELSE nxt$ = "y" THEN
                EMIT "s", 0
            ELSE
                EMIT "k", 0
            ENDIF
            i = i + 1
        ELSEIF c$ = "s" ANDALSO i = n - 1 ANDALSO i > 0 ANDALSO INSTR("ptkf", MID$(w$, i - 1, 1)) < 0 THEN
            EMIT "z", 0
            i = i + 1
        ELSEIF c$ = "x" THEN
            EMIT "k", 0
            EMIT "s", 0
            i = i + 1
        ELSEIF INSTR("bdfghjklmnprstvwz", c$) >= 0 THEN
            EMIT c$, 0
            i = i + 1
        ELSE
            i = i + 1
        ENDIF
    LOOP
    IF g2p_out$ = "" THEN RETURN "uh"
    ' syllables: a consonant before a vowel starts one, of a run of
    ' consonants between vowels the first stays behind
    DIM ph$ = SPLIT(g2p_out$, ",")
    DIM np AS INTEGER = LEN(ph$)
    DIM out$ AS STRING = ""
    DIM seen_v AS INTEGER = FALSE
    DIM j AS INTEGER
    FOR j = 0 TO np - 1
        DIM cut AS INTEGER = FALSE
        IF seen_v ANDALSO g2p_vow[j] = 0 THEN
            DIM k AS INTEGER = j
            DO WHILE k < np ANDALSO g2p_vow[k] = 0
                k = k + 1
            LOOP
            IF k < np THEN
                IF k - j = 1 THEN cut = TRUE
                IF k - j >= 2 ANDALSO j > 0 ANDALSO g2p_vow[j - 1] = 0 THEN cut = TRUE
            ENDIF
        ENDIF
        IF seen_v ANDALSO g2p_vow[j] = 1 ANDALSO j > 0 ANDALSO g2p_vow[j - 1] = 1 THEN cut = TRUE
        IF cut THEN
            out$ = out$ + "." + ph$[j]
            seen_v = FALSE
        ELSE
            out$ = out$ + ph$[j]
        ENDIF
        IF g2p_vow[j] = 1 THEN seen_v = TRUE
    NEXT j
    RETURN out$
ENDFUNC

' Any English text in the sung spelling: words by the table or by rule,
' a syllable a note
EXPORT FUNC SPELL$(text$) AS STRING
    DIM clean$ AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(text$) - 1
        DIM c$ AS STRING = LCASE$(MID$(text$, i, 1))
        IF (c$ >= "a" ANDALSO c$ <= "z") ORELSE c$ = " " THEN
            clean$ = clean$ + c$
        ELSE
            clean$ = clean$ + " "
        ENDIF
    NEXT i
    DIM ws$ = SPLIT(clean$, " ")
    DIM out$ AS STRING = ""
    FOR i = 0 TO LEN(ws$) - 1
        IF ws$[i] = "" THEN CONTINUEFOR
        out$ = out$ + " " + REPLACE$(SPELL_WORD$(ws$[i]), ".", " ")
    NEXT i
    RETURN LTRIM$(out$)
ENDFUNC
