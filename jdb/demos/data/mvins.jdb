' ============================================================
' MVINS - insert a row or column into a matrix (non-mutating).
'   MVINS(matrix, dim, index, value)
'     dim 1 = column, dim 0 = row
'     index == count  -> append at the end
'     value = vector (one per row/col) or scalar (broadcast)
' ============================================================

PRINT "=== MVINS: insert rows / columns into a matrix ==="
PRINT ""

DIM grid = [[1, 2, 3], [4, 5, 6]]
PRINT "Start matrix:"
PRINT FRMV$(grid, "  {:>3} {:>3} {:>3}")

' --- append a computed 'row total' column at the end (idx == width) ---
DIM totals  = SELECT(LAMBDA r -> SUM(r), grid)
DIM withtot = MVINS(grid, 1, 3, totals)
PRINT ""
PRINT "+ row-total column at the end:"
PRINT FRMV$(withtot, "  {:>3} {:>3} {:>3} | {:>4}")

' --- insert an id column at the front (idx 0) ---
DIM withid = MVINS(grid, 1, 0, [10, 20])
PRINT ""
PRINT "+ id column at the front:"
PRINT FRMV$(withid, "  {:>3} | {:>3} {:>3} {:>3}")

' --- scalar broadcast: a zero column in the middle (idx 1) ---
DIM withzero = MVINS(grid, 1, 1, 0)
PRINT ""
PRINT "+ zero column in the middle (scalar broadcast):"
PRINT FRMV$(withzero, "  {:>3} {:>3} {:>3} {:>3}")

' --- append a data row at the bottom (dim 0, idx == height) ---
DIM withrow = MVINS(grid, 0, 2, [7, 8, 9])
PRINT ""
PRINT "+ row [7,8,9] at the bottom:"
PRINT FRMV$(withrow, "  {:>3} {:>3} {:>3}")

' --- insert a separator row in the middle, scalar broadcast ---
DIM withmid = MVINS(grid, 0, 1, -1)
PRINT ""
PRINT "+ [-1,-1,-1] row in the middle (scalar broadcast):"
PRINT FRMV$(withmid, "  {:>3} {:>3} {:>3}")

' --- non-mutating: the original is untouched ---
PRINT ""
PRINT "Original matrix is unchanged:"
PRINT FRMV$(grid, "  {:>3} {:>3} {:>3}")

PRINT ""
PRINT "Done."
