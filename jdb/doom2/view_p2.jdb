' Flies a camera through a level, through walls and all: the renderer alone,
' with the things of the level standing where they were spawned.
'
'   build/jdBasic.exe -c jdb/doom2/view_p2.jdb
'   jdb/doom2/view_p2.exe [episode] [map] [folder for screenshots]
'
' Arrow keys turn and move, A and D step sideways, Shift runs, PageUp and
' PageDown change the view size, Escape quits. With a folder, the view from
' every player and deathmatch start is saved there and the program ends.

OPTION "EXPLICIT"
OPTION "NOPAUSE"

IMPORT D_MAIN
IMPORT DOOMDEF
IMPORT DOOMSTAT
IMPORT D_PLAYER
IMPORT M_FIXED
IMPORT TABLES
IMPORT W_WAD
IMPORT P_SETUP
IMPORT P_MOBJ
IMPORT P_MAPUTL
IMPORT V_VIDEO
IMPORT I_VIDEO
IMPORT R_MAIN
IMPORT G_GAME
IMPORT INFO

DIM episode AS INTEGER = 1
DIM map_num AS INTEGER = 1
DIM shot_dir$ AS STRING = ""
DIM cmd_args AS ARRAY = OS.ARGS()
IF LEN(cmd_args) > 1 THEN episode = CLNG(VAL(cmd_args[1]))
IF LEN(cmd_args) > 2 THEN map_num = CLNG(VAL(cmd_args[2]))
IF LEN(cmd_args) > 3 THEN shot_dir$ = cmd_args[3]
DIM level$ AS STRING = "E" + STR$(episode) + "M" + STR$(map_num)

DIM running AS INTEGER = 1
DIM view_x AS INTEGER = 0
DIM view_y AS INTEGER = 0
DIM view_angle AS INTEGER = 0
DIM screenblocks AS INTEGER = 10

SUB HandleQuit(quit_data)
    running = 0
ENDSUB

SUB HandleKey(key_data)
    DIM code AS INTEGER = CLNG(key_data[0]{"keycode"})
    IF code = 27 THEN running = 0
ENDSUB

' Moves the thing of player 1, who is the camera, to the view point; his
' eye is 41 units above the floor there.
SUB PlaceCamera()
    DIM mo AS INTEGER = CLNG(D_PLAYER.player_mo[0])
    P_MAPUTL.P_UnsetThingPosition(mo)
    P_MOBJ.mobj_x[mo] = view_x
    P_MOBJ.mobj_y[mo] = view_y
    P_MOBJ.mobj_angle[mo] = view_angle
    P_MAPUTL.P_SetThingPosition(mo)
    DIM sector AS INTEGER = CLNG(P_SETUP.subsector_sector[CLNG(P_MOBJ.mobj_subsector[mo])])
    P_MOBJ.mobj_z[mo] = P_SETUP.sector_floorheight[sector]
    D_PLAYER.player_viewz[0] = CLNG(P_SETUP.sector_floorheight[sector]) + 41 * M_FIXED.FRACUNIT
ENDSUB

SUB DrawFrame()
    IF R_MAIN.setsizeneeded <> 0 THEN
        R_MAIN.R_ExecuteSetViewSize()
        V_VIDEO.V_Init()
    ENDIF
    PlaceCamera()
    R_MAIN.R_RenderPlayerView(0)
ENDSUB

W_WAD.W_Init(D_MAIN.IdentifyVersion$())
R_MAIN.R_Init(screenblocks, 0)
P_SETUP.P_Init()
DOOMSTAT.playeringame[0] = 1
G_GAME.G_InitNew(DOOMDEF.SK_MEDIUM, episode, map_num)

DIM start_mo AS INTEGER = CLNG(D_PLAYER.player_mo[0])
view_x = CLNG(P_MOBJ.mobj_x[start_mo])
view_y = CLNG(P_MOBJ.mobj_y[start_mo])
view_angle = CLNG(P_MOBJ.mobj_angle[start_mo])

V_VIDEO.V_Init()
I_VIDEO.I_InitGraphics(3)
I_VIDEO.I_SetPalette(W_WAD.W_CacheLumpName("PLAYPAL"))
ON "QUIT" CALL HandleQuit@
ON "KEYDOWN" CALL HandleKey@

DIM i AS INTEGER
IF LEN(shot_dir$) > 0 THEN
    DrawFrame()
    I_VIDEO.I_Screenshot(shot_dir$ + "/" + level$ + "_blocks10.png")
    R_MAIN.R_SetViewSize(11, 0)
    DrawFrame()
    I_VIDEO.I_Screenshot(shot_dir$ + "/" + level$ + "_blocks11.png")

    ' The view from every player and deathmatch start, and the time a frame
    ' takes there.
    DIM shot_t0 AS DOUBLE
    DIM k AS INTEGER
    DIM start_type AS INTEGER
    FOR i = 0 TO P_SETUP.nummapthings - 1
        start_type = CLNG(P_SETUP.mapthing_type[i])
        IF (start_type >= 1 AND start_type <= 4) OR start_type = 11 THEN
            view_x = CLNG(P_SETUP.mapthing_x[i]) * M_FIXED.FRACUNIT
            view_y = CLNG(P_SETUP.mapthing_y[i]) * M_FIXED.FRACUNIT
            view_angle = (M_FIXED.ANG45 * (CLNG(P_SETUP.mapthing_angle[i]) \ 45)) BAND M_FIXED.ANGLE_MASK
            shot_t0 = TICK()
            FOR k = 1 TO 20
                DrawFrame()
            NEXT k
            PRINT "thing " + STR$(i) + " type " + STR$(start_type) + " at " + STR$(view_x \ 65536) + "," + STR$(view_y \ 65536) + ": " + STR$((TICK() - shot_t0) / 20) + " ms per frame"
            I_VIDEO.I_Screenshot(shot_dir$ + "/" + level$ + "_thing" + STR$(i) + ".png")
        ENDIF
    NEXT i

    ' The player's start again, with the pistol in his hand, and then with
    ' every thing drawn as a shadow.
    view_x = CLNG(P_MOBJ.mobj_x[start_mo])
    view_y = CLNG(P_MOBJ.mobj_y[start_mo])
    view_angle = CLNG(P_MOBJ.mobj_angle[start_mo])
    D_PLAYER.player_psprite_state[0] = INFO.S_PISTOL
    D_PLAYER.player_psprite_sx[0] = M_FIXED.FRACUNIT
    D_PLAYER.player_psprite_sy[0] = 32 * M_FIXED.FRACUNIT
    R_MAIN.R_SetViewSize(10, 0)
    DrawFrame()
    I_VIDEO.I_Screenshot(shot_dir$ + "/" + level$ + "_pistol.png")
    FOR i = 0 TO P_MOBJ.MAXMOBJS - 1
        P_MOBJ.mobj_flags[i] = CLNG(P_MOBJ.mobj_flags[i]) BOR INFO.MF_SHADOW
    NEXT i
    DrawFrame()
    I_VIDEO.I_Screenshot(shot_dir$ + "/" + level$ + "_shadow.png")
    I_VIDEO.I_ShutdownGraphics()
    END
ENDIF

DIM turn AS INTEGER = M_FIXED.ANG90 \ 40
DIM speed AS INTEGER
DIM fine AS INTEGER
DIM forward AS INTEGER
DIM sideways AS INTEGER
DIM frame_start AS DOUBLE
DIM size_key_down AS INTEGER = 0

DO WHILE running = 1
    frame_start = TICK()
    speed = 8 * M_FIXED.FRACUNIT
    IF GFX.KEYSTATE("Left Shift") THEN speed = 20 * M_FIXED.FRACUNIT
    IF GFX.KEYSTATE("Left") THEN view_angle = (view_angle + turn) BAND M_FIXED.ANGLE_MASK
    IF GFX.KEYSTATE("Right") THEN view_angle = (view_angle - turn) BAND M_FIXED.ANGLE_MASK
    forward = 0
    sideways = 0
    IF GFX.KEYSTATE("Up") THEN forward = speed
    IF GFX.KEYSTATE("Down") THEN forward = -speed
    IF GFX.KEYSTATE("D") THEN sideways = speed
    IF GFX.KEYSTATE("A") THEN sideways = -speed
    fine = view_angle SHR TABLES.ANGLETOFINESHIFT
    view_x = view_x + M_FIXED.FixedMul(forward, CLNG(TABLES.finesine[TABLES.FINEANGLES \ 4 + fine])) + M_FIXED.FixedMul(sideways, CLNG(TABLES.finesine[fine]))
    view_y = view_y + M_FIXED.FixedMul(forward, CLNG(TABLES.finesine[fine])) - M_FIXED.FixedMul(sideways, CLNG(TABLES.finesine[TABLES.FINEANGLES \ 4 + fine]))

    IF GFX.KEYSTATE("PageUp") OR GFX.KEYSTATE("PageDown") THEN
        IF size_key_down = 0 THEN
            IF GFX.KEYSTATE("PageUp") AND screenblocks < 11 THEN screenblocks = screenblocks + 1
            IF GFX.KEYSTATE("PageDown") AND screenblocks > 3 THEN screenblocks = screenblocks - 1
            R_MAIN.R_SetViewSize(screenblocks, 0)
        ENDIF
        size_key_down = 1
    ELSE
        size_key_down = 0
    ENDIF

    DrawFrame()
    I_VIDEO.I_FinishUpdate()

    ' 35 frames a second.
    DO WHILE TICK() - frame_start < 28.0
        SLEEP 1
    LOOP
LOOP

I_VIDEO.I_ShutdownGraphics()
