' Plays a demo lump of the WAD: the recorded ticcmds drive the play
' simulation, and what the player is doing at the end tells whether the
' simulation went the way the recording did.
'
'   build/jdBasic.exe -c jdb/doom2/playdemo.jdb
'   jdb/doom2/playdemo.exe [lump] [show | folder for screenshots] [trace every n tics]
'
' The WAD is the one D_MAIN.IdentifyVersion$ finds: set DOOMWADDIR to a
' folder with doom2.wad for the demos of DOOM II.
'
' Without a second argument nothing is drawn. With "show" the demo plays in
' a window at 35 tics a second, Escape quits. With a folder a picture is
' saved there every 175 tics and at the end.

OPTION "EXPLICIT"
OPTION "NOPAUSE"

IMPORT D_MAIN
IMPORT DOOMDEF
IMPORT DOOMSTAT
IMPORT D_PLAYER
IMPORT M_RANDOM
IMPORT W_WAD
IMPORT V_VIDEO
IMPORT I_VIDEO
IMPORT R_MAIN
IMPORT P_SETUP
IMPORT P_TICK
IMPORT P_MOBJ
IMPORT G_GAME

DIM lump$ AS STRING = "DEMO1"
DIM mode$ AS STRING = ""
DIM trace_every AS INTEGER = 0
DIM cmd_args AS ARRAY = OS.ARGS()
IF LEN(cmd_args) > 1 THEN lump$ = UCASE$(cmd_args[1])
IF LEN(cmd_args) > 2 THEN mode$ = cmd_args[2]
IF LEN(cmd_args) > 3 THEN trace_every = CLNG(VAL(cmd_args[3]))
DIM drawing AS INTEGER = 0
IF LEN(mode$) > 0 AND mode$ <> "-" THEN drawing = 1
DIM showing AS INTEGER = 0
IF mode$ = "show" THEN showing = 1

DIM running AS INTEGER = 1

SUB HandleQuit(quit_data)
    running = 0
ENDSUB

SUB HandleKey(key_data)
    DIM code AS INTEGER = CLNG(key_data[0]{"keycode"})
    IF code = 27 THEN running = 0
ENDSUB

FUNC State$() AS STRING
    DIM mo AS INTEGER = CLNG(D_PLAYER.player_mo[0])
    RETURN "tic " + STR$(DOOMSTAT.gametic) + " leveltime " + STR$(P_TICK.leveltime) + " x " + STR$(CLNG(P_MOBJ.mobj_x[mo])) + " y " + STR$(CLNG(P_MOBJ.mobj_y[mo])) + " z " + STR$(CLNG(P_MOBJ.mobj_z[mo])) + " angle " + STR$(CLNG(P_MOBJ.mobj_angle[mo])) + " health " + STR$(CLNG(D_PLAYER.player_health[0])) + " armor " + STR$(CLNG(D_PLAYER.player_armorpoints[0])) + " kills " + STR$(CLNG(D_PLAYER.player_killcount[0])) + "/" + STR$(DOOMSTAT.totalkills) + " items " + STR$(CLNG(D_PLAYER.player_itemcount[0])) + "/" + STR$(DOOMSTAT.totalitems) + " secrets " + STR$(CLNG(D_PLAYER.player_secretcount[0])) + "/" + STR$(DOOMSTAT.totalsecret) + " weapon " + STR$(CLNG(D_PLAYER.player_readyweapon[0])) + " random " + STR$(M_RANDOM.prndindex)
ENDFUNC

W_WAD.W_Init(D_MAIN.IdentifyVersion$())
D_MAIN.D_IdentifyGame()
R_MAIN.R_Init(10, 0)
P_SETUP.P_Init()

IF drawing <> 0 THEN
    V_VIDEO.V_Init()
    I_VIDEO.I_InitGraphics(3)
    I_VIDEO.I_SetPalette(W_WAD.W_CacheLumpName("PLAYPAL"))
    ON "QUIT" CALL HandleQuit@
    ON "KEYDOWN" CALL HandleKey@
ENDIF

G_GAME.G_DeferedPlayDemo(lump$)

DIM tic_start AS DOUBLE
DIM started AS DOUBLE = TICK()
DIM n_tics AS INTEGER = 0
DIM deaths AS INTEGER = 0
DIM was_dead AS INTEGER = 0

DO WHILE running = 1
    tic_start = TICK()
    G_GAME.G_Ticker()
    IF G_GAME.demoended <> 0 THEN EXITDO
    n_tics = n_tics + 1

    IF n_tics = 1 THEN PRINT lump$ + ": episode " + STR$(DOOMSTAT.gameepisode) + " map " + STR$(DOOMSTAT.gamemap) + ", skill " + STR$(DOOMSTAT.gameskill)

    IF CLNG(D_PLAYER.player_playerstate[0]) = DOOMDEF.PST_DEAD THEN
        IF was_dead = 0 THEN
            deaths = deaths + 1
            PRINT "player died: " + State$()
        ENDIF
        was_dead = 1
    ELSE
        was_dead = 0
    ENDIF

    IF G_GAME.gameaction = G_GAME.GA_COMPLETED THEN
        PRINT "level completed: " + State$()
        EXITDO
    ENDIF

    IF trace_every > 0 ANDALSO n_tics MOD trace_every = 0 THEN PRINT State$()

    IF drawing <> 0 THEN
        IF R_MAIN.setsizeneeded <> 0 THEN R_MAIN.R_ExecuteSetViewSize()
        IF showing <> 0 THEN
            R_MAIN.R_RenderPlayerView(DOOMSTAT.displayplayer)
            I_VIDEO.I_FinishUpdate()
            ' One tic lasts a 35th of a second.
            DO WHILE TICK() - tic_start < 1000.0 / 35.0
                SLEEP 1
            LOOP
        ELSEIF n_tics MOD 175 = 0 THEN
            R_MAIN.R_RenderPlayerView(DOOMSTAT.displayplayer)
            I_VIDEO.I_FinishUpdate()
            I_VIDEO.I_Screenshot(mode$ + "/" + lump$ + "_" + RIGHT$("00000" + STR$(n_tics), 5) + ".png")
        ENDIF
    ENDIF
LOOP

PRINT "end: " + State$()
PRINT lump$ + ": " + STR$(n_tics) + " tics in " + STR$(CLNG(TICK() - started)) + " ms, " + STR$(deaths) + " deaths"
IF drawing <> 0 THEN I_VIDEO.I_ShutdownGraphics()
