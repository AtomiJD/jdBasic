' Walks player 1 through a level with the game's own controls: the keys make
' a ticcmd, the play simulation moves the player, the renderer shows his
' view. Monsters fight, things are picked up, doors, lifts and switches
' work; an exit leads to the next map. There is no status bar yet: pickup
' messages and the health after each hit are printed.
'
'   build/jdBasic.exe -c jdb/doom2/view_p4.jdb
'   jdb/doom2/view_p4.exe [episode] [map]
'
' Arrow keys turn and move (W and S move too), A and D or comma and full stop
' step sideways, Alt with left or right steps too, Shift runs, Ctrl fires,
' 1 to 7 pick a weapon, Space
' uses and brings a dead player back, Escape quits.

OPTION "EXPLICIT"
OPTION "NOPAUSE"

IMPORT D_MAIN
IMPORT DOOMDEF
IMPORT DOOMSTAT
IMPORT D_PLAYER
IMPORT W_WAD
IMPORT V_VIDEO
IMPORT I_VIDEO
IMPORT R_MAIN
IMPORT P_MOBJ
IMPORT P_SETUP
IMPORT P_TICK
IMPORT G_GAME

DIM episode AS INTEGER = 1
DIM map_num AS INTEGER = 1
DIM cmd_args AS ARRAY = OS.ARGS()
IF LEN(cmd_args) > 1 THEN episode = CLNG(VAL(cmd_args[1]))
IF LEN(cmd_args) > 2 THEN map_num = CLNG(VAL(cmd_args[2]))

DIM running AS INTEGER = 1

SUB HandleQuit(quit_data)
    running = 0
ENDSUB

SUB HandleKey(key_data)
    DIM code AS INTEGER = CLNG(key_data[0]{"keycode"})
    IF code = 27 THEN running = 0
ENDSUB

SUB KeyTo(key_name$ AS STRING, doom_key AS INTEGER)
    IF GFX.KEYSTATE(key_name$) THEN G_GAME.gamekeydown[doom_key] = 1
ENDSUB

' Copies the state of the keyboard into the game's key table.
SUB ReadKeys()
    FILLV G_GAME.gamekeydown, 0
    KeyTo "Left", G_GAME.KEY_LEFTARROW
    KeyTo "Right", G_GAME.KEY_RIGHTARROW
    KeyTo "Up", G_GAME.KEY_UPARROW
    KeyTo "Down", G_GAME.KEY_DOWNARROW
    KeyTo "Left Shift", G_GAME.KEY_RSHIFT
    KeyTo "Right Shift", G_GAME.KEY_RSHIFT
    KeyTo "Left Ctrl", G_GAME.KEY_RCTRL
    KeyTo "Right Ctrl", G_GAME.KEY_RCTRL
    KeyTo "Left Alt", G_GAME.KEY_RALT
    KeyTo "Right Alt", G_GAME.KEY_RALT
    KeyTo "Space", 32
    KeyTo ",", 44
    KeyTo ".", 46
    KeyTo "A", 44
    KeyTo "D", 46
    KeyTo "W", G_GAME.KEY_UPARROW
    KeyTo "S", G_GAME.KEY_DOWNARROW
    DIM digit AS INTEGER
    FOR digit = 1 TO 7
        KeyTo STR$(digit), 48 + digit
    NEXT digit
ENDSUB

W_WAD.W_Init(D_MAIN.IdentifyVersion$())
R_MAIN.R_Init(10, 0)
P_SETUP.P_Init()
DOOMSTAT.playeringame[0] = 1
G_GAME.G_InitNew(DOOMDEF.SK_MEDIUM, episode, map_num)

V_VIDEO.V_Init()
I_VIDEO.I_InitGraphics(3)
I_VIDEO.I_SetPalette(W_WAD.W_CacheLumpName("PLAYPAL"))
ON "QUIT" CALL HandleQuit@
ON "KEYDOWN" CALL HandleKey@

DIM tic_start AS DOUBLE
DIM n_frames AS INTEGER = 0
DIM work_ms AS DOUBLE = 0.0
DIM health_shown AS INTEGER = 100

DO WHILE running = 1
    tic_start = TICK()
    ReadKeys()
    G_GAME.G_BuildTiccmd()
    G_GAME.G_Ticker()

    IF LEN(D_PLAYER.player_message$[0]) > 0 THEN
        PRINT D_PLAYER.player_message$[0]
        D_PLAYER.player_message$[0] = ""
    ENDIF
    IF CLNG(D_PLAYER.player_health[0]) <> health_shown THEN
        health_shown = CLNG(D_PLAYER.player_health[0])
        PRINT "health " + STR$(health_shown) + ", armor " + STR$(CLNG(D_PLAYER.player_armorpoints[0]))
    ENDIF

    IF G_GAME.gameaction = G_GAME.GA_COMPLETED THEN
        PRINT "E" + STR$(episode) + "M" + STR$(map_num) + " completed after " + STR$(P_TICK.leveltime \ 35) + " seconds, " + STR$(CLNG(D_PLAYER.player_secretcount[0])) + " of " + STR$(DOOMSTAT.totalsecret) + " secrets"
        map_num = map_num + 1
        IF G_GAME.secretexit <> 0 THEN map_num = 9
        IF map_num > 9 THEN map_num = 1
        G_GAME.G_InitNew(DOOMDEF.SK_MEDIUM, episode, map_num)
    ENDIF

    IF R_MAIN.setsizeneeded <> 0 THEN R_MAIN.R_ExecuteSetViewSize()
    R_MAIN.R_RenderPlayerView(DOOMSTAT.displayplayer)
    work_ms = work_ms + (TICK() - tic_start)
    I_VIDEO.I_FinishUpdate()

    n_frames = n_frames + 1
    IF n_frames = 175 THEN
        PRINT "tic and frame: " + STR$(work_ms / n_frames) + " ms"
        n_frames = 0
        work_ms = 0.0
    ENDIF

    ' One tic lasts a 35th of a second.
    DO WHILE TICK() - tic_start < 1000.0 / 35.0
        SLEEP 1
    LOOP
LOOP

I_VIDEO.I_ShutdownGraphics()
