' WAD directory and lump cache (w_wad.c, z_zone.c).
'
' A cached lump lives in `pool`, one byte per cell, and the place of its first
' byte is what the C source calls the lump pointer. Everything that reads
' graphics (patches, flats, colormaps, composite textures) reads the pool.
' Level lumps are read once through W_ReadShorts / W_ReadBytes and not cached.

EXPORT MODULE W_WAD

OPTION "EXPLICIT"
OPTION "STRICT"
OPTION "NOPAUSE"

IMPORT I_SYSTEM

EXPORT CONST W_MAX_LUMPS = 8192
EXPORT CONST POOL_SIZE = 8000000

EXPORT DIM pool[POOL_SIZE] AS INTEGER
EXPORT DIM pool_used AS INTEGER = 0

DIM wad_buf$ AS STRING = ""
DIM numlumps AS INTEGER = 0
DIM lump_pos[W_MAX_LUMPS] AS INTEGER
DIM lump_size[W_MAX_LUMPS] AS INTEGER
DIM lump_name$[W_MAX_LUMPS] AS STRING
DIM lump_cache[W_MAX_LUMPS] AS INTEGER
DIM lump_by_name AS MAP = {}

FUNC CleanName$(raw$ AS STRING) AS STRING
    DIM p_nul AS INTEGER = INSTR(raw$, CHR$(0))
    IF p_nul >= 0 THEN RETURN UCASE$(LEFT$(raw$, p_nul))
    RETURN UCASE$(raw$)
ENDFUNC

EXPORT SUB W_Init(path$ AS STRING)
    wad_buf$ = BINREADER$(path$)
    DIM magic$ AS STRING = LEFT$(wad_buf$, 4)
    IF magic$ <> "IWAD" AND magic$ <> "PWAD" THEN I_SYSTEM.I_Error("W_Init: " + path$ + " is not a WAD")

    DIM header AS ARRAY = UNPACK("<2n", wad_buf$, 4)
    numlumps = CLNG(header[0])
    DIM infotable AS INTEGER = CLNG(header[1])
    IF numlumps > W_MAX_LUMPS THEN I_SYSTEM.I_Error("W_Init: " + STR$(numlumps) + " lumps, limit is " + STR$(W_MAX_LUMPS))

    lump_by_name = {}
    pool_used = 0
    FILLV lump_cache, -1

    ' A later lump of the same name replaces an earlier one, as the backward
    ' scan of W_CheckNumForName does.
    DIM directory$ AS STRING = MID$(wad_buf$, infotable, numlumps * 16)
    DIM i AS INTEGER
    DIM entry AS ARRAY = []
    FOR i = 0 TO numlumps - 1
        entry = UNPACK("<2n", directory$, i * 16)
        lump_pos[i] = entry[0]
        lump_size[i] = entry[1]
        IF entry[0] < 0 OR entry[1] < 0 OR entry[0] + entry[1] > LEN(wad_buf$) THEN I_SYSTEM.I_Error("W_Init: lump " + STR$(i) + " lies outside the file")
        lump_name$[i] = CleanName$(MID$(directory$, i * 16 + 8, 8))
        lump_by_name{lump_name$[i]} = i
    NEXT i
ENDSUB

EXPORT FUNC W_NumLumps() AS INTEGER
    RETURN numlumps
ENDFUNC

EXPORT FUNC W_CheckNumForName(name$ AS STRING) AS INTEGER
    DIM key$ AS STRING = UCASE$(name$)
    IF MAP.EXISTS(lump_by_name, key$) THEN RETURN lump_by_name{key$}
    RETURN -1
ENDFUNC

EXPORT FUNC W_GetNumForName(name$ AS STRING) AS INTEGER
    DIM lump AS INTEGER = W_CheckNumForName(name$)
    IF lump < 0 THEN I_SYSTEM.I_Error("W_GetNumForName: " + name$ + " not found!")
    RETURN lump
ENDFUNC

EXPORT FUNC W_LumpLength(lump AS INTEGER) AS INTEGER
    IF lump < 0 OR lump >= numlumps THEN I_SYSTEM.I_Error("W_LumpLength: " + STR$(lump) + " >= numlumps")
    RETURN lump_size[lump]
ENDFUNC

EXPORT FUNC W_LumpName$(lump AS INTEGER) AS STRING
    IF lump < 0 OR lump >= numlumps THEN RETURN ""
    RETURN lump_name$[lump]
ENDFUNC

' The raw bytes of a lump as a string, for the 8-character names in it.
EXPORT FUNC W_LumpString$(lump AS INTEGER) AS STRING
    IF lump < 0 OR lump >= numlumps THEN I_SYSTEM.I_Error("W_LumpString$: " + STR$(lump) + " >= numlumps")
    RETURN MID$(wad_buf$, lump_pos[lump], lump_size[lump])
ENDFUNC

' The lump as an array of its bytes (0..255).
EXPORT FUNC W_ReadBytes(lump AS INTEGER) AS ARRAY
    DIM n_bytes AS INTEGER = W_LumpLength(lump)
    IF n_bytes = 0 THEN RETURN []
    RETURN UNPACK("<" + STR$(n_bytes) + "b", wad_buf$, lump_pos[lump])
ENDFUNC

' The lump as an array of signed 16-bit values.
EXPORT FUNC W_ReadShorts(lump AS INTEGER) AS ARRAY
    DIM n_shorts AS INTEGER = W_LumpLength(lump) \ 2
    IF n_shorts = 0 THEN RETURN []
    RETURN UNPACK("<" + STR$(n_shorts) + "h", wad_buf$, lump_pos[lump])
ENDFUNC

' Reserves n_cells of the pool and answers the place of the first one.
EXPORT FUNC W_Alloc(n_cells AS INTEGER) AS INTEGER
    IF n_cells < 0 THEN I_SYSTEM.I_Error("W_Alloc: negative size")
    IF pool_used + n_cells > POOL_SIZE THEN I_SYSTEM.I_Error("W_Alloc: pool of " + STR$(POOL_SIZE) + " cells is full")
    DIM start AS INTEGER = pool_used
    pool_used = pool_used + n_cells
    RETURN start
ENDFUNC

' The place of the lump's bytes in the pool; the first call copies them there.
EXPORT FUNC W_CacheLumpNum(lump AS INTEGER) AS INTEGER
    IF lump < 0 OR lump >= numlumps THEN I_SYSTEM.I_Error("W_CacheLumpNum: " + STR$(lump) + " >= numlumps")
    IF lump_cache[lump] >= 0 THEN RETURN lump_cache[lump]
    DIM n_bytes AS INTEGER = CLNG(lump_size[lump])
    DIM start AS INTEGER = W_Alloc(n_bytes)
    DIM i AS INTEGER
    DIM file_pos AS INTEGER = CLNG(lump_pos[lump])
    FOR i = 0 TO n_bytes - 1
        pool[start + i] = BYTEAT(wad_buf$, file_pos + i)
    NEXT i
    lump_cache[lump] = start
    RETURN start
ENDFUNC

EXPORT FUNC W_CacheLumpName(name$ AS STRING) AS INTEGER
    RETURN W_CacheLumpNum(W_GetNumForName(name$))
ENDFUNC

' Little-endian values out of the pool, as SHORT() and LONG() read a lump.
EXPORT FUNC PoolShort(ofs AS INTEGER) AS INTEGER
    DIM v AS INTEGER = pool[ofs] BOR (pool[ofs + 1] SHL 8)
    IF v >= 32768 THEN RETURN v - 65536
    RETURN v
ENDFUNC

EXPORT FUNC PoolLong(ofs AS INTEGER) AS INTEGER
    DIM v AS INTEGER = pool[ofs] BOR (pool[ofs + 1] SHL 8) BOR (pool[ofs + 2] SHL 16) BOR (pool[ofs + 3] SHL 24)
    IF v >= $80000000 THEN RETURN v - $100000000
    RETURN v
ENDFUNC

' n_shorts signed 16-bit values from byte_ofs of the lump, without caching it.
EXPORT FUNC W_ReadShortsAt(lump AS INTEGER, byte_ofs AS INTEGER, n_shorts AS INTEGER) AS ARRAY
    IF byte_ofs + n_shorts * 2 > W_LumpLength(lump) THEN I_SYSTEM.I_Error("W_ReadShortsAt: past the end of lump " + STR$(lump))
    DIM file_pos AS INTEGER = CLNG(lump_pos[lump]) + byte_ofs
    DIM shorts[n_shorts] AS INTEGER
    DIM i AS INTEGER
    DIM v AS INTEGER
    FOR i = 0 TO n_shorts - 1
        v = BYTEAT(wad_buf$, file_pos + i * 2) BOR (BYTEAT(wad_buf$, file_pos + i * 2 + 1) SHL 8)
        IF v >= 32768 THEN v = v - 65536
        shorts[i] = v
    NEXT i
    RETURN shorts
ENDFUNC
