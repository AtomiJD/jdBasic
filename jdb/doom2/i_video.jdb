' Window and frame output (i_video.c).

EXPORT MODULE I_VIDEO

OPTION "EXPLICIT"
OPTION "STRICT"

IMPORT DOOMDEF
IMPORT TABLES
IMPORT W_WAD
IMPORT V_VIDEO

' Window pixels per screen pixel.
EXPORT DIM window_scale AS INTEGER = 1

' 1 while the window fills the display.
EXPORT DIM fullscreen AS INTEGER = 0

' Packed RGB of each palette index, after gamma.
DIM pal_rgb[256] AS INTEGER

' The largest whole number of window pixels per screen pixel at which the
' screen fits the primary display.
EXPORT FUNC I_DisplayScale() AS INTEGER
    DIM displays AS ARRAY = GFX.DISPLAYS()
    DIM fit AS INTEGER = 3
    DIM i AS INTEGER
    DIM across AS INTEGER
    DIM down AS INTEGER
    FOR i = 0 TO LEN(displays) - 1
        IF displays[i]{"primary"} THEN
            across = CLNG(displays[i]{"w"}) \ DOOMDEF.SCREENWIDTH
            down = CLNG(displays[i]{"h"}) \ DOOMDEF.SCREENHEIGHT
            fit = across
            IF down < fit THEN fit = down
        ENDIF
    NEXT i
    IF fit < 1 THEN fit = 1
    RETURN fit
ENDFUNC

' Opens the window; one screen pixel is scale x scale window pixels.
EXPORT SUB I_InitGraphics(scale AS INTEGER)
    window_scale = scale
    SCREEN DOOMDEF.SCREENWIDTH * scale, DOOMDEF.SCREENHEIGHT * scale, "DOOM"
ENDSUB

' Switches between a window and the whole display.
EXPORT SUB I_ToggleFullscreen()
    TOGGLE_FULLSCREEN
    fullscreen = 1 - fullscreen
ENDSUB

EXPORT SUB I_ShutdownGraphics()
    GFX.CLOSE
ENDSUB

' palette is the place in the pool of 256 RGB triples (one of the 14 palettes
' of the PLAYPAL lump).
EXPORT SUB I_SetPalette(palette AS INTEGER)
    DIM gamma_row AS INTEGER = V_VIDEO.usegamma * 256
    DIM i AS INTEGER
    DIM r AS INTEGER
    DIM g AS INTEGER
    DIM b AS INTEGER
    FOR i = 0 TO 255
        r = CLNG(TABLES.gammatable[gamma_row + W_WAD.pool[palette + i * 3]])
        g = CLNG(TABLES.gammatable[gamma_row + W_WAD.pool[palette + i * 3 + 1]])
        b = CLNG(TABLES.gammatable[gamma_row + W_WAD.pool[palette + i * 3 + 2]])
        pal_rgb[i] = (r SHL 16) BOR (g SHL 8) BOR b
    NEXT i
ENDSUB

SUB BlitScreen()
    PLOTRAW 0, 0, RESHAPE(pal_rgb[TAKE(V_VIDEO.SCREENSIZE, V_VIDEO.screens)], [DOOMDEF.SCREENHEIGHT, DOOMDEF.SCREENWIDTH]), window_scale, window_scale
ENDSUB

' Shows screen 0.
EXPORT SUB I_FinishUpdate()
    BlitScreen()
    SCREENFLIP
ENDSUB

' Shows screen 0 and saves the window to a PNG.
EXPORT SUB I_Screenshot(path$ AS STRING)
    BlitScreen()
    GFX.SAVE_SCREENSHOT path$
    SCREENFLIP
ENDSUB
