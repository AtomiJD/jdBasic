' Column and span drawing into the view window of screen 0 (r_draw.c).
'
' The caller fills the dc_ variables and calls R_DrawColumn, or the ds_
' variables and calls R_DrawSpan. Sources and colormaps are places in
' W_WAD.pool. Only high detail is drawn (detailshift 0).

EXPORT MODULE R_DRAW

OPTION "EXPLICIT"
OPTION "STRICT"

IMPORT I_SYSTEM
IMPORT DOOMDEF
IMPORT DOOMSTAT
IMPORT W_WAD
IMPORT V_VIDEO
IMPORT R_MAIN
IMPORT R_DATA

EXPORT CONST SBARHEIGHT = 32

' The view window on the screen.
EXPORT DIM viewwidth AS INTEGER = 0
EXPORT DIM scaledviewwidth AS INTEGER = 0
EXPORT DIM viewheight AS INTEGER = 0
EXPORT DIM viewwindowx AS INTEGER = 0
EXPORT DIM viewwindowy AS INTEGER = 0
' Place in V_VIDEO.screens of the first pixel of each view row, and the
' screen column of each view column.
EXPORT DIM ylookup[DOOMDEF.SCREENHEIGHT] AS INTEGER
EXPORT DIM columnofs[DOOMDEF.SCREENWIDTH] AS INTEGER

' ---- R_DrawColumn -----------------------------------------------------------
EXPORT DIM dc_colormap AS INTEGER = 0
EXPORT DIM dc_x AS INTEGER = 0
EXPORT DIM dc_yl AS INTEGER = 0
EXPORT DIM dc_yh AS INTEGER = 0
EXPORT DIM dc_iscale AS INTEGER = 0
EXPORT DIM dc_texturemid AS INTEGER = 0
' First pixel of the column to draw, 128 pixels high.
EXPORT DIM dc_source AS INTEGER = 0

' ---- R_DrawSpan -------------------------------------------------------------
EXPORT DIM ds_y AS INTEGER = 0
EXPORT DIM ds_x1 AS INTEGER = 0
EXPORT DIM ds_x2 AS INTEGER = 0
EXPORT DIM ds_colormap AS INTEGER = 0
EXPORT DIM ds_xfrac AS INTEGER = 0
EXPORT DIM ds_yfrac AS INTEGER = 0
EXPORT DIM ds_xstep AS INTEGER = 0
EXPORT DIM ds_ystep AS INTEGER = 0
' First pixel of the 64 x 64 flat to draw.
EXPORT DIM ds_source AS INTEGER = 0

' Draws a vertical run of a wall or sprite column, scaled, through a colormap.
EXPORT SUB R_DrawColumn()
    DIM n_more AS INTEGER = dc_yh - dc_yl
    IF n_more < 0 THEN RETURN
    IF dc_x < 0 OR dc_x >= DOOMDEF.SCREENWIDTH OR dc_yl < 0 OR dc_yh >= DOOMDEF.SCREENHEIGHT THEN
        I_SYSTEM.I_Error("R_DrawColumn: " + STR$(dc_yl) + " to " + STR$(dc_yh) + " at " + STR$(dc_x))
    ENDIF
    DIM dest AS INTEGER = CLNG(ylookup[dc_yl]) + CLNG(columnofs[dc_x])
    DIM fracstep AS INTEGER = dc_iscale
    DIM frac AS INTEGER = dc_texturemid + (dc_yl - R_MAIN.centery) * fracstep
    DIM source AS INTEGER = dc_source
    DIM colormap AS INTEGER = dc_colormap
    DIM i AS INTEGER
    FOR i = 0 TO n_more
        V_VIDEO.screens[dest] = W_WAD.pool[colormap + W_WAD.pool[source + ((frac SHR 16) BAND 127)]]
        dest = dest + DOOMDEF.SCREENWIDTH
        frac = frac + fracstep
    NEXT i
ENDSUB

' Draws a horizontal run of a floor or ceiling through a colormap.
EXPORT SUB R_DrawSpan()
    IF ds_x2 < ds_x1 OR ds_x1 < 0 OR ds_x2 >= DOOMDEF.SCREENWIDTH OR ds_y < 0 OR ds_y >= DOOMDEF.SCREENHEIGHT THEN
        I_SYSTEM.I_Error("R_DrawSpan: " + STR$(ds_x1) + " to " + STR$(ds_x2) + " at " + STR$(ds_y))
    ENDIF
    DIM xfrac AS INTEGER = ds_xfrac
    DIM yfrac AS INTEGER = ds_yfrac
    DIM xstep AS INTEGER = ds_xstep
    DIM ystep AS INTEGER = ds_ystep
    DIM dest AS INTEGER = CLNG(ylookup[ds_y]) + CLNG(columnofs[ds_x1])
    DIM source AS INTEGER = ds_source
    DIM colormap AS INTEGER = ds_colormap
    DIM i AS INTEGER
    FOR i = 0 TO ds_x2 - ds_x1
        V_VIDEO.screens[dest] = W_WAD.pool[colormap + W_WAD.pool[source + ((yfrac SHR 10) BAND 4032) + ((xfrac SHR 16) BAND 63)]]
        dest = dest + 1
        xfrac = xfrac + xstep
        yfrac = yfrac + ystep
    NEXT i
ENDSUB

' Places the view window of width x height on the screen.
EXPORT SUB R_InitBuffer(width AS INTEGER, height AS INTEGER)
    DIM i AS INTEGER
    viewwindowx = (DOOMDEF.SCREENWIDTH - width) SHR 1
    FOR i = 0 TO width - 1
        columnofs[i] = viewwindowx + i
    NEXT i
    IF width = DOOMDEF.SCREENWIDTH THEN
        viewwindowy = 0
    ELSE
        viewwindowy = (DOOMDEF.SCREENHEIGHT - SBARHEIGHT - height) SHR 1
    ENDIF
    FOR i = 0 TO height - 1
        ylookup[i] = (i + viewwindowy) * DOOMDEF.SCREENWIDTH
    NEXT i
ENDSUB

' ---- column functions of the masked pass -----------------------------------------

' Which function R_ColFunc calls: sprites are drawn plain, as a shadow
' (fuzz) or with their colours translated.
EXPORT CONST COLFUNC_BASE = 0
EXPORT CONST COLFUNC_FUZZ = 1
EXPORT CONST COLFUNC_TRANSLATED = 2
EXPORT DIM colfunc AS INTEGER = 0

' Offsets to the pixel above or below, in an order that looks random.
CONST FUZZTABLE = 50
DIM fuzzoffset AS ARRAY = [ _
    320, -320, 320, -320, 320, 320, -320, _
    320, 320, -320, 320, 320, 320, -320, _
    320, 320, 320, -320, -320, -320, -320, _
    320, -320, -320, 320, 320, 320, 320, -320, _
    320, -320, 320, 320, -320, -320, 320, _
    320, -320, -320, -320, -320, 320, 320, _
    320, 320, -320, 320, 320, -320, 320 _
]
DIM fuzzpos AS INTEGER = 0

' Three tables of 256 palette indices in the pool: the green of the
' player's suit turned to gray, brown and red, for players 2 to 4.
EXPORT DIM translationtables AS INTEGER = 0
' The table R_DrawTranslatedColumn draws through.
EXPORT DIM dc_translation AS INTEGER = 0

' Draws a column of a shadow: each pixel becomes a darkened copy of the
' pixel above or below it, so the shape shimmers.
EXPORT SUB R_DrawFuzzColumn()
    ' Adjust the borders: the neighbours of the first and of the last row
    ' lie outside the view.
    IF dc_yl = 0 THEN dc_yl = 1
    IF dc_yh = viewheight - 1 THEN dc_yh = viewheight - 2

    DIM n_more AS INTEGER = dc_yh - dc_yl
    IF n_more < 0 THEN RETURN
    IF dc_x < 0 OR dc_x >= DOOMDEF.SCREENWIDTH OR dc_yl < 0 OR dc_yh >= DOOMDEF.SCREENHEIGHT THEN
        I_SYSTEM.I_Error("R_DrawFuzzColumn: " + STR$(dc_yl) + " to " + STR$(dc_yh) + " at " + STR$(dc_x))
    ENDIF
    DIM dest AS INTEGER = CLNG(ylookup[dc_yl]) + CLNG(columnofs[dc_x])
    ' Colormap 6 of the light tables, a little darker than full bright.
    DIM dark AS INTEGER = R_DATA.colormaps + 6 * 256
    DIM i AS INTEGER
    FOR i = 0 TO n_more
        V_VIDEO.screens[dest] = W_WAD.pool[dark + V_VIDEO.screens[dest + CLNG(fuzzoffset[fuzzpos])]]
        fuzzpos = fuzzpos + 1
        IF fuzzpos = FUZZTABLE THEN fuzzpos = 0
        dest = dest + DOOMDEF.SCREENWIDTH
    NEXT i
ENDSUB

' Draws a column through dc_translation and then the colormap. Used for the
' other players, so one set of sprites serves four suit colours.
EXPORT SUB R_DrawTranslatedColumn()
    DIM n_more AS INTEGER = dc_yh - dc_yl
    IF n_more < 0 THEN RETURN
    IF dc_x < 0 OR dc_x >= DOOMDEF.SCREENWIDTH OR dc_yl < 0 OR dc_yh >= DOOMDEF.SCREENHEIGHT THEN
        I_SYSTEM.I_Error("R_DrawColumn: " + STR$(dc_yl) + " to " + STR$(dc_yh) + " at " + STR$(dc_x))
    ENDIF
    DIM dest AS INTEGER = CLNG(ylookup[dc_yl]) + CLNG(columnofs[dc_x])
    DIM fracstep AS INTEGER = dc_iscale
    DIM frac AS INTEGER = dc_texturemid + (dc_yl - R_MAIN.centery) * fracstep
    DIM source AS INTEGER = dc_source
    DIM colormap AS INTEGER = dc_colormap
    DIM translation AS INTEGER = dc_translation
    DIM i AS INTEGER
    FOR i = 0 TO n_more
        V_VIDEO.screens[dest] = W_WAD.pool[colormap + W_WAD.pool[translation + W_WAD.pool[source + (frac SHR 16)]]]
        dest = dest + DOOMDEF.SCREENWIDTH
        frac = frac + fracstep
    NEXT i
ENDSUB

' Draws the column with the function colfunc names.
EXPORT SUB R_ColFunc()
    IF colfunc = COLFUNC_BASE THEN
        R_DrawColumn()
    ELSEIF colfunc = COLFUNC_FUZZ THEN
        R_DrawFuzzColumn()
    ELSE
        R_DrawTranslatedColumn()
    ENDIF
ENDSUB

' Makes the three translation tables: the 16 greens $70 to $7F become the
' grays from $60, the browns from $40 and the reds from $20.
EXPORT SUB R_InitTranslationTables()
    translationtables = W_WAD.W_Alloc(256 * 3)
    DIM i AS INTEGER
    FOR i = 0 TO 255
        IF i >= $70 AND i <= $7F THEN
            W_WAD.pool[translationtables + i] = $60 + (i BAND 15)
            W_WAD.pool[translationtables + i + 256] = $40 + (i BAND 15)
            W_WAD.pool[translationtables + i + 512] = $20 + (i BAND 15)
        ELSE
            ' Keep all other colours as they are.
            W_WAD.pool[translationtables + i] = i
            W_WAD.pool[translationtables + i + 256] = i
            W_WAD.pool[translationtables + i + 512] = i
        ENDIF
    NEXT i
ENDSUB

' ---- the border around a view that is smaller than the screen ---------------

' Fills the back screen with a pattern for variable screen sizes, and
' draws the beveled edge around the view.
EXPORT SUB R_FillBackScreen()
    IF scaledviewwidth = 320 THEN RETURN

    DIM src AS INTEGER
    IF DOOMSTAT.commercial <> 0 THEN
        src = W_WAD.W_CacheLumpName("GRNROCK")
    ELSE
        src = W_WAD.W_CacheLumpName("FLOOR7_2")
    ENDIF

    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM dest AS INTEGER = V_VIDEO.SCREENSIZE
    DIM row AS INTEGER
    FOR y = 0 TO DOOMDEF.SCREENHEIGHT - 32 - 1
        row = src + (y BAND 63) * 64
        FOR x = 0 TO DOOMDEF.SCREENWIDTH - 1
            V_VIDEO.screens[dest] = W_WAD.pool[row + (x BAND 63)]
            dest = dest + 1
        NEXT x
    NEXT y

    DIM patch AS INTEGER = W_WAD.W_CacheLumpName("BRDR_T")
    FOR x = 0 TO scaledviewwidth - 1 STEP 8
        V_VIDEO.V_DrawPatch(viewwindowx + x, viewwindowy - 8, 1, patch)
    NEXT x
    patch = W_WAD.W_CacheLumpName("BRDR_B")
    FOR x = 0 TO scaledviewwidth - 1 STEP 8
        V_VIDEO.V_DrawPatch(viewwindowx + x, viewwindowy + viewheight, 1, patch)
    NEXT x
    patch = W_WAD.W_CacheLumpName("BRDR_L")
    FOR y = 0 TO viewheight - 1 STEP 8
        V_VIDEO.V_DrawPatch(viewwindowx - 8, viewwindowy + y, 1, patch)
    NEXT y
    patch = W_WAD.W_CacheLumpName("BRDR_R")
    FOR y = 0 TO viewheight - 1 STEP 8
        V_VIDEO.V_DrawPatch(viewwindowx + scaledviewwidth, viewwindowy + y, 1, patch)
    NEXT y

    ' Draw beveled edge.
    V_VIDEO.V_DrawPatch(viewwindowx - 8, viewwindowy - 8, 1, W_WAD.W_CacheLumpName("BRDR_TL"))
    V_VIDEO.V_DrawPatch(viewwindowx + scaledviewwidth, viewwindowy - 8, 1, W_WAD.W_CacheLumpName("BRDR_TR"))
    V_VIDEO.V_DrawPatch(viewwindowx - 8, viewwindowy + viewheight, 1, W_WAD.W_CacheLumpName("BRDR_BL"))
    V_VIDEO.V_DrawPatch(viewwindowx + scaledviewwidth, viewwindowy + viewheight, 1, W_WAD.W_CacheLumpName("BRDR_BR"))
ENDSUB

' Copy a screen buffer.
EXPORT SUB R_VideoErase(ofs AS INTEGER, n_pixels AS INTEGER)
    DIM i AS INTEGER
    FOR i = ofs TO ofs + n_pixels - 1
        V_VIDEO.screens[i] = V_VIDEO.screens[V_VIDEO.SCREENSIZE + i]
    NEXT i
ENDSUB

' Draws the border around the view for different size windows.
EXPORT SUB R_DrawViewBorder()
    IF scaledviewwidth = DOOMDEF.SCREENWIDTH THEN RETURN

    DIM top AS INTEGER = ((DOOMDEF.SCREENHEIGHT - 32) - viewheight) \ 2
    DIM side AS INTEGER = (DOOMDEF.SCREENWIDTH - scaledviewwidth) \ 2
    DIM i AS INTEGER

    ' Copy top and one line of left side.
    R_VideoErase(0, top * DOOMDEF.SCREENWIDTH + side)

    ' Copy one line of right side and bottom.
    DIM ofs AS INTEGER = (viewheight + top) * DOOMDEF.SCREENWIDTH - side
    R_VideoErase(ofs, top * DOOMDEF.SCREENWIDTH + side)

    ' Copy sides using wraparound.
    ofs = top * DOOMDEF.SCREENWIDTH + DOOMDEF.SCREENWIDTH - side
    side = side * 2
    FOR i = 1 TO viewheight - 1
        R_VideoErase(ofs, side)
        ofs = ofs + DOOMDEF.SCREENWIDTH
    NEXT i
ENDSUB
