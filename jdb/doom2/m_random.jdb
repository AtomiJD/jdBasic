' Table-driven random numbers (m_random.c).
'
' P_Random drives the play simulation and has to stay in step with a demo;
' M_Random is for everything that may not disturb it (menus, screen wipe).

EXPORT MODULE M_RANDOM

OPTION "EXPLICIT"
OPTION "STRICT"

DIM rndtable AS ARRAY = [ _
    0,   8, 109, 220, 222, 241, 149, 107,  75, 248, 254, 140,  16,  66, _
    74,  21, 211,  47,  80, 242, 154,  27, 205, 128, 161,  89,  77,  36, _
    95, 110,  85,  48, 212, 140, 211, 249,  22,  79, 200,  50,  28, 188, _
    52, 140, 202, 120,  68, 145,  62,  70, 184, 190,  91, 197, 152, 224, _
    149, 104,  25, 178, 252, 182, 202, 182, 141, 197,   4,  81, 181, 242, _
    145,  42,  39, 227, 156, 198, 225, 193, 219,  93, 122, 175, 249,   0, _
    175, 143,  70, 239,  46, 246, 163,  53, 163, 109, 168, 135,   2, 235, _
    25,  92,  20, 145, 138,  77,  69, 166,  78, 176, 173, 212, 166, 113, _
    94, 161,  41,  50, 239,  49, 111, 164,  70,  60,   2,  37, 171,  75, _
    136, 156,  11,  56,  42, 146, 138, 229,  73, 146,  77,  61,  98, 196, _
    135, 106,  63, 197, 195,  86,  96, 203, 113, 101, 170, 247, 181, 113, _
    80, 250, 108,   7, 255, 237, 129, 226,  79, 107, 112, 166, 103, 241, _
    24, 223, 239, 120, 198,  58,  60,  82, 128,   3, 184,  66, 143, 224, _
    145, 224,  81, 206, 163,  45,  63,  90, 168, 114,  59,  33, 159,  95, _
    28, 139, 123,  98, 125, 196,  15,  70, 194, 253,  54,  14, 109, 226, _
    71,  17, 161,  93, 186,  87, 244, 138,  20,  52, 123, 251,  26,  36, _
    17,  46,  52, 231, 232,  76,  31, 221,  84,  37, 216, 165, 212, 106, _
    197, 242,  98,  43,  39, 175, 254, 145, 190,  84, 118, 222, 187, 136, _
    120, 163, 236, 249 _
]

EXPORT DIM rndindex AS INTEGER = 0
EXPORT DIM prndindex AS INTEGER = 0

EXPORT FUNC P_Random() AS INTEGER
    prndindex = (prndindex + 1) BAND 255
    RETURN rndtable[prndindex]
ENDFUNC

EXPORT FUNC M_Random() AS INTEGER
    rndindex = (rndindex + 1) BAND 255
    RETURN rndtable[rndindex]
ENDFUNC

EXPORT SUB M_ClearRandom()
    rndindex = 0
    prndindex = 0
ENDSUB
