' The weapons: the ammunition each takes and the states of its sprite
' (d_items.c). One array per field of weaponinfo_t, indexed by a WP_ number.

EXPORT MODULE D_ITEMS

OPTION "EXPLICIT"
OPTION "STRICT"

IMPORT DOOMDEF
IMPORT INFO

EXPORT DIM weaponinfo_ammo AS ARRAY = [DOOMDEF.AM_NOAMMO, DOOMDEF.AM_CLIP, DOOMDEF.AM_SHELL, DOOMDEF.AM_CLIP, DOOMDEF.AM_MISL, DOOMDEF.AM_CELL, DOOMDEF.AM_CELL, DOOMDEF.AM_NOAMMO, DOOMDEF.AM_SHELL]
EXPORT DIM weaponinfo_upstate AS ARRAY = [INFO.S_PUNCHUP, INFO.S_PISTOLUP, INFO.S_SGUNUP, INFO.S_CHAINUP, INFO.S_MISSILEUP, INFO.S_PLASMAUP, INFO.S_BFGUP, INFO.S_SAWUP, INFO.S_DSGUNUP]
EXPORT DIM weaponinfo_downstate AS ARRAY = [INFO.S_PUNCHDOWN, INFO.S_PISTOLDOWN, INFO.S_SGUNDOWN, INFO.S_CHAINDOWN, INFO.S_MISSILEDOWN, INFO.S_PLASMADOWN, INFO.S_BFGDOWN, INFO.S_SAWDOWN, INFO.S_DSGUNDOWN]
EXPORT DIM weaponinfo_readystate AS ARRAY = [INFO.S_PUNCH, INFO.S_PISTOL, INFO.S_SGUN, INFO.S_CHAIN, INFO.S_MISSILE, INFO.S_PLASMA, INFO.S_BFG, INFO.S_SAW, INFO.S_DSGUN]
EXPORT DIM weaponinfo_atkstate AS ARRAY = [INFO.S_PUNCH1, INFO.S_PISTOL1, INFO.S_SGUN1, INFO.S_CHAIN1, INFO.S_MISSILE1, INFO.S_PLASMA1, INFO.S_BFG1, INFO.S_SAW1, INFO.S_DSGUN1]
EXPORT DIM weaponinfo_flashstate AS ARRAY = [INFO.S_NULL, INFO.S_PISTOLFLASH, INFO.S_SGUNFLASH1, INFO.S_CHAINFLASH1, INFO.S_MISSILEFLASH1, INFO.S_PLASMAFLASH1, INFO.S_BFGFLASH1, INFO.S_NULL, INFO.S_DSGUNFLASH1]
