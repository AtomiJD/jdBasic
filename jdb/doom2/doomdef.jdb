' Global constants (doomdef.h, doomdata.h, m_bbox.h, p_local.h).

EXPORT MODULE DOOMDEF

EXPORT CONST SCREENWIDTH = 320
EXPORT CONST SCREENHEIGHT = 200

' Lump order of a level, counted from its marker lump.
EXPORT CONST ML_LABEL = 0
EXPORT CONST ML_THINGS = 1
EXPORT CONST ML_LINEDEFS = 2
EXPORT CONST ML_SIDEDEFS = 3
EXPORT CONST ML_VERTEXES = 4
EXPORT CONST ML_SEGS = 5
EXPORT CONST ML_SSECTORS = 6
EXPORT CONST ML_NODES = 7
EXPORT CONST ML_SECTORS = 8
EXPORT CONST ML_REJECT = 9
EXPORT CONST ML_BLOCKMAP = 10

' Linedef flags.
EXPORT CONST ML_BLOCKING = 1
EXPORT CONST ML_BLOCKMONSTERS = 2
EXPORT CONST ML_TWOSIDED = 4
EXPORT CONST ML_DONTPEGTOP = 8
EXPORT CONST ML_DONTPEGBOTTOM = 16
EXPORT CONST ML_SECRET = 32
EXPORT CONST ML_SOUNDBLOCK = 64
EXPORT CONST ML_DONTDRAW = 128
EXPORT CONST ML_MAPPED = 256

' A BSP child with this bit set is a subsector.
EXPORT CONST NF_SUBSECTOR = $8000

' Places of the four sides in a bounding box.
EXPORT CONST BOXTOP = 0
EXPORT CONST BOXBOTTOM = 1
EXPORT CONST BOXLEFT = 2
EXPORT CONST BOXRIGHT = 3

' slopetype of a line.
EXPORT CONST ST_HORIZONTAL = 0
EXPORT CONST ST_VERTICAL = 1
EXPORT CONST ST_POSITIVE = 2
EXPORT CONST ST_NEGATIVE = 3

EXPORT CONST MAPBLOCKUNITS = 128
EXPORT CONST MAPBLOCKSIZE = 8388608
EXPORT CONST MAPBLOCKSHIFT = 23
EXPORT CONST MAPBMASK = 8388607
EXPORT CONST MAPBTOFRAC = 7
EXPORT CONST MAXRADIUS = 2097152

EXPORT CONST MAXPLAYERS = 4
' Tics a second.
EXPORT CONST TICRATE = 35

' skill_t
EXPORT CONST SK_BABY = 0
EXPORT CONST SK_EASY = 1
EXPORT CONST SK_MEDIUM = 2
EXPORT CONST SK_HARD = 3
EXPORT CONST SK_NIGHTMARE = 4

' Option flag of a map thing: the monster waits in ambush.
EXPORT CONST MTF_AMBUSH = 8

' card_t
EXPORT CONST IT_BLUECARD = 0
EXPORT CONST IT_YELLOWCARD = 1
EXPORT CONST IT_REDCARD = 2
EXPORT CONST IT_BLUESKULL = 3
EXPORT CONST IT_YELLOWSKULL = 4
EXPORT CONST IT_REDSKULL = 5
EXPORT CONST NUMCARDS = 6

' weapontype_t
EXPORT CONST WP_FIST = 0
EXPORT CONST WP_PISTOL = 1
EXPORT CONST WP_SHOTGUN = 2
EXPORT CONST WP_CHAINGUN = 3
EXPORT CONST WP_MISSILE = 4
EXPORT CONST WP_PLASMA = 5
EXPORT CONST WP_BFG = 6
EXPORT CONST WP_CHAINSAW = 7
EXPORT CONST WP_SUPERSHOTGUN = 8
EXPORT CONST NUMWEAPONS = 9
EXPORT CONST WP_NOCHANGE = 10

' ammotype_t
EXPORT CONST AM_CLIP = 0
EXPORT CONST AM_SHELL = 1
EXPORT CONST AM_CELL = 2
EXPORT CONST AM_MISL = 3
EXPORT CONST NUMAMMO = 4
EXPORT CONST AM_NOAMMO = 5

' powertype_t
EXPORT CONST PW_INVULNERABILITY = 0
EXPORT CONST PW_STRENGTH = 1
EXPORT CONST PW_INVISIBILITY = 2
EXPORT CONST PW_IRONFEET = 3
EXPORT CONST PW_ALLMAP = 4
EXPORT CONST PW_INFRARED = 5
EXPORT CONST NUMPOWERS = 6

' Button bits of a ticcmd (d_event.h).
EXPORT CONST BT_ATTACK = 1
EXPORT CONST BT_USE = 2
EXPORT CONST BT_SPECIAL = 128
EXPORT CONST BT_SPECIALMASK = 3
EXPORT CONST BTS_SAVEGAME = 2
EXPORT CONST BTS_SAVEMASK = 28
EXPORT CONST BTS_SAVESHIFT = 2
EXPORT CONST BT_CHANGE = 4
EXPORT CONST BT_WEAPONMASK = 56
EXPORT CONST BT_WEAPONSHIFT = 3

' playerstate_t and cheat_t (d_player.h).
EXPORT CONST PST_LIVE = 0
EXPORT CONST PST_DEAD = 1
EXPORT CONST PST_REBORN = 2
EXPORT CONST CF_NOCLIP = 1
EXPORT CONST CF_GODMODE = 2
EXPORT CONST CF_NOMOMENTUM = 4

' Frame flags of a state (p_pspr.h).
EXPORT CONST FF_FULLBRIGHT = $8000
EXPORT CONST FF_FRAMEMASK = $7FFF

' Play simulation (p_local.h).
EXPORT CONST FLOATSPEED = 262144
EXPORT CONST MAXHEALTH = 100
EXPORT CONST VIEWHEIGHT = 2686976
EXPORT CONST GRAVITY = 65536
EXPORT CONST MAXMOVE = 1966080
EXPORT CONST USERANGE = 4194304
EXPORT CONST MELEERANGE = 4194304
EXPORT CONST MISSILERANGE = 134217728
EXPORT CONST ONFLOORZ = -2147483648
EXPORT CONST ONCEILINGZ = 2147483647
EXPORT CONST ITEMQUESIZE = 128
EXPORT CONST PT_ADDLINES = 1
EXPORT CONST PT_ADDTHINGS = 2
EXPORT CONST PT_EARLYOUT = 4

' The most thinkers a level can have at one time.
EXPORT CONST MAXTHINKERS = 8192

' Tics a monster keeps after the thing that hurt it (p_local.h).
EXPORT CONST BASETHRESHOLD = 100

' psprnum_t (p_pspr.h)
EXPORT CONST PS_WEAPON = 0
EXPORT CONST PS_FLASH = 1
