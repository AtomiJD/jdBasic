' Converts the sound and music tables of linuxdoom-1.10 (sounds.c) into
' the module ../sounds.jdb.
'
' Run from the repository root with the interpreter:
'   build/jdBasic.exe jdb/doom2/tools/gen_sounds.jdb

OPTION "NOPAUSE"

DIM NL$ = CHR$(10)
DIM Q$ = CHR$(34)
DIM src$ = REPLACE$(TXTREADER$("jdb/doom/linuxdoom-1.10/sounds.c"), CHR$(13), "")
DIM lines = SPLIT(src$, NL$)

DIM mus_names$ = ""
DIM sfx_names$ = ""
DIM sfx_priority$ = ""
DIM sfx_link$ = ""
DIM sfx_pitch$ = ""
DIM sfx_volume$ = ""
DIM n_mus = 0
DIM n_sfx = 0
DIM in_sfx = 0
DIM in_mus = 0
DIM i = 0
DIM l$ = ""
DIM f = 0
DIM name$ = ""

FOR i = 0 TO LEN(lines) - 1
    l$ = TRIM$(lines[i])
    IF INSTR(l$, "musicinfo_t S_music") >= 0 THEN in_mus = 1
    IF INSTR(l$, "sfxinfo_t S_sfx") >= 0 THEN
        in_mus = 0
        in_sfx = 1
    ENDIF
    IF in_mus = 1 AND LEFT$(l$, 1) = "{" AND LEN(l$) > 1 THEN
        name$ = ""
        IF INSTR(l$, Q$) >= 0 THEN name$ = SPLIT(l$, Q$)[1]
        IF n_mus > 0 THEN mus_names$ = mus_names$ + ", "
        mus_names$ = mus_names$ + Q$ + UCASE$(name$) + Q$
        n_mus = n_mus + 1
    ENDIF
    IF in_sfx = 1 AND LEFT$(l$, 3) = "{ " + Q$ THEN
        name$ = SPLIT(l$, Q$)[1]
        f = SPLIT(REPLACE$(REPLACE$(SPLIT(l$, Q$)[2], "}", ""), " ", ""), ",")
        IF n_sfx > 0 THEN
            sfx_names$ = sfx_names$ + ", "
            sfx_priority$ = sfx_priority$ + ", "
            sfx_link$ = sfx_link$ + ", "
            sfx_pitch$ = sfx_pitch$ + ", "
            sfx_volume$ = sfx_volume$ + ", "
        ENDIF
        sfx_names$ = sfx_names$ + Q$ + UCASE$(name$) + Q$
        sfx_priority$ = sfx_priority$ + f[2]
        ' The one sound that plays another one's data is the chaingun,
        ' which is the pistol at another pitch.
        IF f[3] = "0" THEN sfx_link$ = sfx_link$ + "-1" ELSE sfx_link$ = sfx_link$ + "1"
        sfx_pitch$ = sfx_pitch$ + f[4]
        sfx_volume$ = sfx_volume$ + f[5]
        n_sfx = n_sfx + 1
    ENDIF
NEXT i

DIM out$ = "' The sounds and the music of the game (sounds.c): for each sound the name" + NL$
out$ = out$ + "' of its lump without the DS in front, its priority, the sound whose data" + NL$
out$ = out$ + "' it plays instead of its own (-1 for none) with the pitch and the volume" + NL$
out$ = out$ + "' change that go with it; for each piece of music the name of its lump" + NL$
out$ = out$ + "' without the D_ in front. Entry 0 of both is not used." + NL$
out$ = out$ + "'" + NL$
out$ = out$ + "' Generated by tools/gen_sounds.jdb from linuxdoom-1.10. Not edited by hand." + NL$ + NL$
out$ = out$ + "EXPORT MODULE SOUNDS" + NL$ + NL$
out$ = out$ + "OPTION " + Q$ + "EXPLICIT" + Q$ + NL$ + "OPTION " + Q$ + "STRICT" + Q$ + NL$ + NL$
out$ = out$ + "EXPORT DIM sfx_name$ AS ARRAY = [" + sfx_names$ + "]" + NL$
out$ = out$ + "EXPORT DIM sfx_priority AS ARRAY = [" + sfx_priority$ + "]" + NL$
out$ = out$ + "EXPORT DIM sfx_link AS ARRAY = [" + sfx_link$ + "]" + NL$
out$ = out$ + "EXPORT DIM sfx_pitch AS ARRAY = [" + sfx_pitch$ + "]" + NL$
out$ = out$ + "EXPORT DIM sfx_volume AS ARRAY = [" + sfx_volume$ + "]" + NL$
out$ = out$ + "EXPORT DIM mus_name$ AS ARRAY = [" + mus_names$ + "]" + NL$
TXTWRITER "jdb/doom2/sounds.jdb", out$
PRINT "sounds.jdb written: " + STR$(n_sfx) + " sounds, " + STR$(n_mus) + " pieces of music"
