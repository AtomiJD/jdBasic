' Converts the data tables of linuxdoom-1.10 into jdBasic modules.
'
'   tables.c, v_video.c -> ../tables.jdb (finetangent, finesine, tantoangle, gammatable)
'   info.c, info.h,
'   sounds.h, p_mobj.h -> ../info.jdb    (states, mobjinfo, sprite names, enums)
'
' Run from the repository root with the interpreter:
'   build/jdBasic.exe jdb/doom2/tools/gen_data.jdb [c_source_dir] [out_dir]

OPTION "NOPAUSE"

DIM c_dir$ = "jdb/doom/linuxdoom-1.10/"
DIM out_dir$ = "jdb/doom2/"
DIM cmd_args = OS.ARGS()
IF LEN(cmd_args) > 1 THEN c_dir$ = cmd_args[1]
IF LEN(cmd_args) > 2 THEN out_dir$ = cmd_args[2]

DIM NL$ = CHR$(10)
DIM sym = {}
sym{"FRACUNIT"} = 65536

SUB Fail(msg$)
    PRINT "gen_data: " + msg$
    END
ENDSUB

FUNC ReadSource$(file_name$)
    DIM path$ = c_dir$ + file_name$
    IF NOT FILE.EXISTS(path$) THEN Fail("missing " + path$)
    DIM raw$ = TXTREADER$(path$)
    raw$ = REGEX.REPLACE$("/\*[\s\S]*?\*/", raw$, "")
    RETURN REGEX.REPLACE$("//[^\n]*", raw$, "")
ENDFUNC

' The text inside the braces that follow head$, up to tail$.
FUNC Body$(src$, head$, tail$)
    DIM p_head = INSTR(src$, head$)
    IF p_head < 0 THEN Fail("marker not found: " + head$)
    DIM rest$ = MID$(src$, p_head + LEN(head$))
    DIM p_open = INSTR(rest$, "{")
    DIM p_tail = INSTR(rest$, tail$)
    IF p_open < 0 OR p_tail < p_open THEN Fail("no body after: " + head$)
    RETURN MID$(rest$, p_open + 1, p_tail - p_open - 1)
ENDFUNC

FUNC Squeeze$(s$)
    RETURN REGEX.REPLACE$("\s+", s$, "")
ENDFUNC

FUNC Atom(a$)
    IF REGEX.MATCH("-?[0-9]+", a$) THEN RETURN CLNG(a$)
    IF STARTSWITH(a$, "0x") THEN RETURN VAL(a$)
    IF NOT MAP.EXISTS(sym, a$) THEN Fail("unknown symbol: " + a$)
    RETURN sym{a$}
ENDFUNC

' Evaluates the constant expressions info.c uses: products joined by "|".
FUNC EvalExpr(e$)
    DIM acc = 0
    DIM term$
    DIM factor$
    DIM prod
    FOR EACH term$ IN SPLIT(e$, "|")
        prod = 1
        FOR EACH factor$ IN SPLIT(term$, "*")
            prod = prod * Atom(factor$)
        NEXT
        acc = acc BOR prod
    NEXT
    RETURN acc
ENDFUNC

' Reads a C enum body into sym and returns its names in order.
FUNC EnumNames(body$)
    DIM names = []
    DIM item$
    DIM next_value = 0
    DIM p_eq
    DIM nm$
    FOR EACH item$ IN SPLIT(Squeeze$(body$), ",")
        IF LEN(item$) > 0 THEN
            p_eq = INSTR(item$, "=")
            IF p_eq >= 0 THEN
                nm$ = LEFT$(item$, p_eq)
                next_value = EvalExpr(MID$(item$, p_eq + 1))
            ELSE
                nm$ = item$
            ENDIF
            sym{nm$} = next_value
            names = APPEND(names, nm$)
            next_value = next_value + 1
        ENDIF
    NEXT
    RETURN names
ENDFUNC

FUNC ConstLines$(names)
    DIM out_lines = []
    DIM nm$
    FOR EACH nm$ IN names
        out_lines = APPEND(out_lines, "EXPORT CONST " + UCASE$(nm$) + " = " + STR$(sym{nm$}))
    NEXT
    RETURN JOIN(out_lines, NL$) + NL$
ENDFUNC

FUNC ArrayLiteral$(array_name$, cells, per_row)
    DIM out_lines = ["EXPORT DIM " + array_name$ + " AS ARRAY = [ _"]
    DIM n_cells = LEN(cells)
    DIM i = 0
    DIM row_end
    DIM row$
    DO WHILE i < n_cells
        row_end = i + per_row
        IF row_end > n_cells THEN row_end = n_cells
        row$ = "    " + JOIN(TAKE(row_end - i, DROP(i, cells)), ", ")
        IF row_end < n_cells THEN row$ = row$ + ","
        out_lines = APPEND(out_lines, row$ + " _")
        i = row_end
    LOOP
    out_lines = APPEND(out_lines, "]")
    RETURN JOIN(out_lines, NL$) + NL$
ENDFUNC

FUNC NumberTable(src$, head$, expected)
    DIM cells = REGEX.FINDALL("-?[0-9]+", Body$(src$, head$, "};"))
    IF LEN(cells) <> expected THEN Fail(head$ + ": " + STR$(LEN(cells)) + " cells, expected " + STR$(expected))
    RETURN cells
ENDFUNC

FUNC Header$(module_name$, sources$)
    DIM h$ = "' Generated by tools/gen_data.jdb from linuxdoom-1.10 (" + sources$ + ")." + NL$
    h$ = h$ + "' Do not edit; change the generator and run it again." + NL$ + NL$
    RETURN h$ + "EXPORT MODULE " + module_name$ + NL$ + NL$
ENDFUNC

' ---- tables.c ---------------------------------------------------------------

DIM tab_src$ = ReadSource$("tables.c")
DIM tab_out$ = Header$("TABLES", "tables.c, v_video.c")
tab_out$ = tab_out$ + "EXPORT CONST FINEANGLES = 8192" + NL$
tab_out$ = tab_out$ + "EXPORT CONST FINEMASK = 8191" + NL$
tab_out$ = tab_out$ + "EXPORT CONST ANGLETOFINESHIFT = 19" + NL$
tab_out$ = tab_out$ + "EXPORT CONST SLOPERANGE = 2048" + NL$
tab_out$ = tab_out$ + "EXPORT CONST SLOPEBITS = 11" + NL$
tab_out$ = tab_out$ + "EXPORT CONST DBITS = 5" + NL$ + NL$
tab_out$ = tab_out$ + "' finecosine[i] is finesine[i + FINEANGLES / 4]." + NL$
tab_out$ = tab_out$ + ArrayLiteral$("finetangent", NumberTable(tab_src$, "finetangent[4096]", 4096), 8) + NL$
tab_out$ = tab_out$ + ArrayLiteral$("finesine", NumberTable(tab_src$, "finesine[10240]", 10240), 8) + NL$
tab_out$ = tab_out$ + ArrayLiteral$("tantoangle", NumberTable(tab_src$, "tantoangle[2049]", 2049), 8) + NL$
tab_out$ = tab_out$ + "' Five gamma curves of 256 entries; gammatable[usegamma * 256 + level]." + NL$
tab_out$ = tab_out$ + ArrayLiteral$("gammatable", NumberTable(ReadSource$("v_video.c"), "gammatable[5][256]", 1280), 16)
TXTWRITER out_dir$ + "tables.jdb", tab_out$
PRINT "tables.jdb written"

' ---- info.h / sounds.h / p_mobj.h enums ------------------------------------

DIM info_h$ = ReadSource$("info.h")
DIM enum_bodies = REGEX.FINDALL("typedef\s+enum\s*\{([^}]*)\}", info_h$)
IF LEN(enum_bodies) <> 3 THEN Fail("info.h: expected 3 enums")
DIM spr_names = EnumNames(enum_bodies[0, 0])
DIM state_names = EnumNames(enum_bodies[1, 0])
DIM mobj_names = EnumNames(enum_bodies[2, 0])

DIM sounds_h$ = ReadSource$("sounds.h")
DIM sound_bodies = REGEX.FINDALL("typedef\s+enum\s*\{([^}]*)\}", sounds_h$)
IF LEN(sound_bodies) <> 2 THEN Fail("sounds.h: expected 2 enums")
DIM mus_names = EnumNames(sound_bodies[0, 0])
DIM sfx_names = EnumNames(sound_bodies[1, 0])

DIM flag_names = EnumNames(Body$(ReadSource$("p_mobj.h"), "typedef enum", "} mobjflag_t"))

' ---- info.c -----------------------------------------------------------------

DIM info_c$ = ReadSource$("info.c")

DIM spr_text = REGEX.FINDALL(CHR$(34) + "[A-Z0-9]{4}" + CHR$(34), Body$(info_c$, "sprnames[NUMSPRITES]", "};"))
IF LEN(spr_text) <> sym{"NUMSPRITES"} THEN Fail("sprnames: " + STR$(LEN(spr_text)))

DIM st_rows = REGEX.FINDALL("\{(SPR_[A-Z0-9]+),([0-9]+),(-?[0-9]+),\{([A-Za-z_0-9]+)\},(S_[A-Z0-9_]+),([0-9]+),([0-9]+)\}", Squeeze$(Body$(info_c$, "states[NUMSTATES]", "};")))
DIM n_states = sym{"NUMSTATES"}
IF LEN(st_rows) <> n_states THEN Fail("states: " + STR$(LEN(st_rows)) + " rows, expected " + STR$(n_states))

DIM action_names = []
DIM st_sprite = []
DIM st_frame = []
DIM st_tics = []
DIM st_action = []
DIM st_next = []
DIM st_misc1 = []
DIM st_misc2 = []
DIM si
DIM act$
sym{"NULL"} = 0
FOR si = 0 TO n_states - 1
    act$ = st_rows[si, 3]
    IF NOT MAP.EXISTS(sym, act$) THEN
        action_names = APPEND(action_names, act$)
        sym{act$} = LEN(action_names)
    ENDIF
    st_sprite = APPEND(st_sprite, STR$(Atom(st_rows[si, 0])))
    st_frame  = APPEND(st_frame, st_rows[si, 1])
    st_tics   = APPEND(st_tics, st_rows[si, 2])
    st_action = APPEND(st_action, STR$(sym{act$}))
    st_next   = APPEND(st_next, STR$(Atom(st_rows[si, 4])))
    st_misc1  = APPEND(st_misc1, st_rows[si, 5])
    st_misc2  = APPEND(st_misc2, st_rows[si, 6])
NEXT si

DIM mi_fields = ["doomednum", "spawnstate", "spawnhealth", "seestate", "seesound", "reactiontime", "attacksound", "painstate", "painchance", "painsound", "meleestate", "missilestate", "deathstate", "xdeathstate", "deathsound", "speed", "radius", "height", "mass", "damage", "activesound", "flags", "raisestate"]
DIM n_fields = LEN(mi_fields)
DIM mi_rows = REGEX.FINDALL("\{([^{}]*)\}", Squeeze$(Body$(info_c$, "mobjinfo[NUMMOBJTYPES] = ", "};")))
DIM n_mobj = sym{"NUMMOBJTYPES"}
IF LEN(mi_rows) <> n_mobj THEN Fail("mobjinfo: " + STR$(LEN(mi_rows)) + " rows, expected " + STR$(n_mobj))

DIM mi_cols = {}
DIM fi
FOR fi = 0 TO n_fields - 1
    mi_cols{mi_fields[fi]} = []
NEXT fi
DIM mi
DIM exprs
FOR mi = 0 TO n_mobj - 1
    exprs = SPLIT(mi_rows[mi, 0], ",")
    IF LEN(exprs) <> n_fields THEN Fail("mobjinfo row " + STR$(mi) + ": " + STR$(LEN(exprs)) + " fields")
    FOR fi = 0 TO n_fields - 1
        mi_cols{mi_fields[fi]} = APPEND(mi_cols{mi_fields[fi]}, STR$(EvalExpr(exprs[fi])))
    NEXT fi
NEXT mi

DIM info_out$ = Header$("INFO", "info.c, info.h, sounds.h, p_mobj.h")
info_out$ = info_out$ + "' Sprite numbers (spritenum_t)" + NL$ + ConstLines$(spr_names) + NL$
info_out$ = info_out$ + "' State numbers (statenum_t)" + NL$ + ConstLines$(state_names) + NL$
info_out$ = info_out$ + "' Thing types (mobjtype_t)" + NL$ + ConstLines$(mobj_names) + NL$
info_out$ = info_out$ + "' Music numbers (musicenum_t)" + NL$ + ConstLines$(mus_names) + NL$
info_out$ = info_out$ + "' Sound numbers (sfxenum_t)" + NL$ + ConstLines$(sfx_names) + NL$
info_out$ = info_out$ + "' Thing flags (mobjflag_t)" + NL$ + ConstLines$(flag_names) + NL$
info_out$ = info_out$ + "' Action functions a state can call; 0 is none." + NL$ + ConstLines$(action_names) + NL$
info_out$ = info_out$ + ArrayLiteral$("spr_names", spr_text, 10) + NL$
info_out$ = info_out$ + "' states[]: one array per field of state_t" + NL$
info_out$ = info_out$ + ArrayLiteral$("st_sprite", st_sprite, 16)
info_out$ = info_out$ + ArrayLiteral$("st_frame", st_frame, 16)
info_out$ = info_out$ + ArrayLiteral$("st_tics", st_tics, 16)
info_out$ = info_out$ + ArrayLiteral$("st_action", st_action, 16)
info_out$ = info_out$ + ArrayLiteral$("st_next", st_next, 16)
info_out$ = info_out$ + ArrayLiteral$("st_misc1", st_misc1, 16)
info_out$ = info_out$ + ArrayLiteral$("st_misc2", st_misc2, 16) + NL$
info_out$ = info_out$ + "' mobjinfo[]: one array per field of mobjinfo_t" + NL$
FOR fi = 0 TO n_fields - 1
    info_out$ = info_out$ + ArrayLiteral$("mi_" + mi_fields[fi], mi_cols{mi_fields[fi]}, 12)
NEXT fi
TXTWRITER out_dir$ + "info.jdb", info_out$
PRINT "info.jdb written: " + STR$(n_states) + " states, " + STR$(n_mobj) + " thing types, " + STR$(LEN(action_names)) + " actions, " + STR$(LEN(sfx_names) - 1) + " sounds"
