' Game flow (g_game.c): the keys that are down become a ticcmd once a tic, a
' new game is set up, a level is loaded, the tic is run, a demo is played.
' Level completion, savegames and recording are not here.

EXPORT MODULE G_GAME

OPTION "EXPLICIT"
OPTION "STRICT"

IMPORT I_SYSTEM
IMPORT DOOMDEF
IMPORT DOOMSTAT
IMPORT D_PLAYER
IMPORT M_RANDOM
IMPORT INFO
IMPORT W_WAD
IMPORT R_DATA
IMPORT R_SKY
IMPORT P_SETUP
IMPORT P_TICK
IMPORT P_MOBJ
IMPORT ST_STUFF
IMPORT HU_STUFF
IMPORT AM_MAP
IMPORT WI_STUFF
IMPORT F_FINALE
IMPORT M_MENU
IMPORT D_MAIN
IMPORT S_SOUND

' Key codes of doomdef.h; letters and digits are their ASCII codes.
EXPORT CONST KEY_RIGHTARROW = $AE
EXPORT CONST KEY_LEFTARROW = $AC
EXPORT CONST KEY_UPARROW = $AD
EXPORT CONST KEY_DOWNARROW = $AF
EXPORT CONST KEY_ESCAPE = 27
EXPORT CONST KEY_ENTER = 13
EXPORT CONST KEY_TAB = 9
EXPORT CONST KEY_RSHIFT = $B6
EXPORT CONST KEY_RCTRL = $9D
EXPORT CONST KEY_RALT = $B8

' The controls, as the defaults of m_misc.c set them.
EXPORT DIM key_right AS INTEGER = KEY_RIGHTARROW
EXPORT DIM key_left AS INTEGER = KEY_LEFTARROW
EXPORT DIM key_up AS INTEGER = KEY_UPARROW
EXPORT DIM key_down AS INTEGER = KEY_DOWNARROW
EXPORT DIM key_strafeleft AS INTEGER = 44
EXPORT DIM key_straferight AS INTEGER = 46
EXPORT DIM key_fire AS INTEGER = KEY_RCTRL
EXPORT DIM key_use AS INTEGER = 32
EXPORT DIM key_strafe AS INTEGER = KEY_RALT
EXPORT DIM key_speed AS INTEGER = KEY_RSHIFT

EXPORT DIM mousebfire AS INTEGER = 0
EXPORT DIM mousebstrafe AS INTEGER = 1
EXPORT DIM mousebforward AS INTEGER = 2
EXPORT DIM joybfire AS INTEGER = 0
EXPORT DIM joybstrafe AS INTEGER = 1
EXPORT DIM joybuse AS INTEGER = 3
EXPORT DIM joybspeed AS INTEGER = 2

' Input state, written by the event handling.
EXPORT CONST NUMKEYS = 256
EXPORT DIM gamekeydown[NUMKEYS] AS INTEGER
EXPORT DIM mousebuttons[3] AS INTEGER
EXPORT DIM joybuttons[4] AS INTEGER
' Mouse movement since the last tic, joystick position.
EXPORT DIM mousex AS INTEGER = 0
EXPORT DIM mousey AS INTEGER = 0
EXPORT DIM joyxmove AS INTEGER = 0
EXPORT DIM joyymove AS INTEGER = 0

' Walking and running speed of the three moves; the third turn speed is
' the slow turn of the first tics a turn key is held.
DIM forwardmove AS ARRAY = [$19, $32]
DIM sidemove AS ARRAY = [$18, $28]
DIM angleturn AS ARRAY = [640, 1280, 320]
CONST SLOWTURNTICS = 6
CONST MAXPLMOVE = $32

' For accelerative turning.
DIM turnheld AS INTEGER = 0
' Double clicks of the forward and the strafe button count as use.
DIM dclicktime AS INTEGER = 0
DIM dclickstate AS INTEGER = 0
DIM dclicks AS INTEGER = 0
DIM dclicktime2 AS INTEGER = 0
DIM dclickstate2 AS INTEGER = 0
DIM dclicks2 AS INTEGER = 0

' The ticcmd G_BuildTiccmd makes.
EXPORT DIM cmd_forwardmove AS INTEGER = 0
EXPORT DIM cmd_sidemove AS INTEGER = 0
EXPORT DIM cmd_angleturn AS INTEGER = 0
EXPORT DIM cmd_consistancy AS INTEGER = 0
EXPORT DIM cmd_chatchar AS INTEGER = 0
EXPORT DIM cmd_buttons AS INTEGER = 0

EXPORT DIM levelstarttic AS INTEGER = 0
' Send a pause event next tic.
DIM sendpause AS INTEGER = 0

' 0 to 9, set in the options menu.
EXPORT DIM mouseSensitivity AS INTEGER = 5

DIM maxammo AS ARRAY = [200, 50, 300, 50]

' Builds a ticcmd from all of the available inputs.
EXPORT SUB G_BuildTiccmd()
    DIM i AS INTEGER
    DIM strafe AS INTEGER = 0
    DIM bstrafe AS INTEGER = 0
    DIM speed AS INTEGER = 0
    DIM tspeed AS INTEGER
    DIM forward AS INTEGER = 0
    DIM side AS INTEGER = 0
    DIM right_down AS INTEGER = CLNG(gamekeydown[key_right])
    DIM left_down AS INTEGER = CLNG(gamekeydown[key_left])
    DIM forward_button AS INTEGER = CLNG(mousebuttons[mousebforward])

    cmd_forwardmove = 0
    cmd_sidemove = 0
    cmd_angleturn = 0
    cmd_consistancy = 0
    cmd_chatchar = 0
    cmd_buttons = 0

    IF CLNG(gamekeydown[key_strafe]) <> 0 OR CLNG(mousebuttons[mousebstrafe]) <> 0 OR CLNG(joybuttons[joybstrafe]) <> 0 THEN strafe = 1
    IF CLNG(gamekeydown[key_speed]) <> 0 OR CLNG(joybuttons[joybspeed]) <> 0 THEN speed = 1

    ' Two stage accelerative turning on the keyboard and joystick.
    IF joyxmove < 0 OR joyxmove > 0 OR right_down <> 0 OR left_down <> 0 THEN
        turnheld = turnheld + 1
    ELSE
        turnheld = 0
    ENDIF
    IF turnheld < SLOWTURNTICS THEN tspeed = 2 ELSE tspeed = speed

    ' Let movement keys cancel each other out.
    IF strafe <> 0 THEN
        IF right_down <> 0 THEN side = side + CLNG(sidemove[speed])
        IF left_down <> 0 THEN side = side - CLNG(sidemove[speed])
        IF joyxmove > 0 THEN side = side + CLNG(sidemove[speed])
        IF joyxmove < 0 THEN side = side - CLNG(sidemove[speed])
    ELSE
        IF right_down <> 0 THEN cmd_angleturn = cmd_angleturn - CLNG(angleturn[tspeed])
        IF left_down <> 0 THEN cmd_angleturn = cmd_angleturn + CLNG(angleturn[tspeed])
        IF joyxmove > 0 THEN cmd_angleturn = cmd_angleturn - CLNG(angleturn[tspeed])
        IF joyxmove < 0 THEN cmd_angleturn = cmd_angleturn + CLNG(angleturn[tspeed])
    ENDIF

    IF CLNG(gamekeydown[key_up]) <> 0 THEN forward = forward + CLNG(forwardmove[speed])
    IF CLNG(gamekeydown[key_down]) <> 0 THEN forward = forward - CLNG(forwardmove[speed])
    IF joyymove < 0 THEN forward = forward + CLNG(forwardmove[speed])
    IF joyymove > 0 THEN forward = forward - CLNG(forwardmove[speed])
    IF CLNG(gamekeydown[key_straferight]) <> 0 THEN side = side + CLNG(sidemove[speed])
    IF CLNG(gamekeydown[key_strafeleft]) <> 0 THEN side = side - CLNG(sidemove[speed])

    ' Buttons.
    IF CLNG(gamekeydown[key_fire]) <> 0 OR CLNG(mousebuttons[mousebfire]) <> 0 OR CLNG(joybuttons[joybfire]) <> 0 THEN cmd_buttons = cmd_buttons BOR DOOMDEF.BT_ATTACK
    IF CLNG(gamekeydown[key_use]) <> 0 OR CLNG(joybuttons[joybuse]) <> 0 THEN
        cmd_buttons = cmd_buttons BOR DOOMDEF.BT_USE
        ' Clear double clicks if hit use button.
        dclicks = 0
    ENDIF

    ' The number keys pick a weapon; the chainsaw has no key of its own.
    FOR i = 0 TO DOOMDEF.NUMWEAPONS - 2
        IF CLNG(gamekeydown[49 + i]) <> 0 THEN
            cmd_buttons = cmd_buttons BOR DOOMDEF.BT_CHANGE
            cmd_buttons = cmd_buttons BOR (i SHL DOOMDEF.BT_WEAPONSHIFT)
            EXITFOR
        ENDIF
    NEXT i

    ' Mouse.
    IF forward_button <> 0 THEN forward = forward + CLNG(forwardmove[speed])

    ' Forward double click.
    IF forward_button <> dclickstate AND dclicktime > 1 THEN
        dclickstate = forward_button
        IF dclickstate <> 0 THEN dclicks = dclicks + 1
        IF dclicks = 2 THEN
            cmd_buttons = cmd_buttons BOR DOOMDEF.BT_USE
            dclicks = 0
        ELSE
            dclicktime = 0
        ENDIF
    ELSE
        dclicktime = dclicktime + 1
        IF dclicktime > 20 THEN
            dclicks = 0
            dclickstate = 0
        ENDIF
    ENDIF

    ' Strafe double click.
    IF CLNG(mousebuttons[mousebstrafe]) <> 0 OR CLNG(joybuttons[joybstrafe]) <> 0 THEN bstrafe = 1
    IF bstrafe <> dclickstate2 AND dclicktime2 > 1 THEN
        dclickstate2 = bstrafe
        IF dclickstate2 <> 0 THEN dclicks2 = dclicks2 + 1
        IF dclicks2 = 2 THEN
            cmd_buttons = cmd_buttons BOR DOOMDEF.BT_USE
            dclicks2 = 0
        ELSE
            dclicktime2 = 0
        ENDIF
    ELSE
        dclicktime2 = dclicktime2 + 1
        IF dclicktime2 > 20 THEN
            dclicks2 = 0
            dclickstate2 = 0
        ENDIF
    ENDIF

    forward = forward + mousey
    IF strafe <> 0 THEN
        side = side + mousex * 2
    ELSE
        cmd_angleturn = cmd_angleturn - mousex * 8
    ENDIF
    mousex = 0
    mousey = 0

    IF forward > MAXPLMOVE THEN
        forward = MAXPLMOVE
    ELSEIF forward < -MAXPLMOVE THEN
        forward = -MAXPLMOVE
    ENDIF
    IF side > MAXPLMOVE THEN
        side = MAXPLMOVE
    ELSEIF side < -MAXPLMOVE THEN
        side = -MAXPLMOVE
    ENDIF

    cmd_forwardmove = cmd_forwardmove + forward
    cmd_sidemove = cmd_sidemove + side

    ' Special buttons.
    IF sendpause <> 0 THEN
        sendpause = 0
        cmd_buttons = DOOMDEF.BT_SPECIAL BOR 1
    ENDIF
ENDSUB

' Called at the start of a game and after a death: everything except the
' frags and the counts of the intermission is reset.
EXPORT SUB G_PlayerReborn(player AS INTEGER)
    DIM i AS INTEGER
    D_PLAYER.player_mo[player] = -1
    D_PLAYER.player_cmd_forwardmove[player] = 0
    D_PLAYER.player_cmd_sidemove[player] = 0
    D_PLAYER.player_cmd_angleturn[player] = 0
    D_PLAYER.player_cmd_consistancy[player] = 0
    D_PLAYER.player_cmd_chatchar[player] = 0
    D_PLAYER.player_cmd_buttons[player] = 0
    D_PLAYER.player_viewz[player] = 0
    D_PLAYER.player_viewheight[player] = 0
    D_PLAYER.player_deltaviewheight[player] = 0
    D_PLAYER.player_bob[player] = 0
    D_PLAYER.player_armorpoints[player] = 0
    D_PLAYER.player_armortype[player] = 0
    FOR i = 0 TO DOOMDEF.NUMPOWERS - 1
        D_PLAYER.player_powers[player * DOOMDEF.NUMPOWERS + i] = 0
    NEXT i
    FOR i = 0 TO DOOMDEF.NUMCARDS - 1
        D_PLAYER.player_cards[player * DOOMDEF.NUMCARDS + i] = 0
    NEXT i
    D_PLAYER.player_backpack[player] = 0
    FOR i = 0 TO DOOMDEF.NUMWEAPONS - 1
        D_PLAYER.player_weaponowned[player * DOOMDEF.NUMWEAPONS + i] = 0
    NEXT i
    FOR i = 0 TO DOOMDEF.NUMAMMO - 1
        D_PLAYER.player_ammo[player * DOOMDEF.NUMAMMO + i] = 0
        D_PLAYER.player_maxammo[player * DOOMDEF.NUMAMMO + i] = maxammo[i]
    NEXT i
    D_PLAYER.player_cheats[player] = 0
    D_PLAYER.player_refire[player] = 0
    D_PLAYER.player_message$[player] = ""
    D_PLAYER.player_damagecount[player] = 0
    D_PLAYER.player_bonuscount[player] = 0
    D_PLAYER.player_attacker[player] = -1
    D_PLAYER.player_extralight[player] = 0
    D_PLAYER.player_fixedcolormap[player] = 0
    D_PLAYER.player_colormap[player] = 0
    FOR i = 0 TO 1
        D_PLAYER.player_psprite_state[player * 2 + i] = 0
        D_PLAYER.player_psprite_tics[player * 2 + i] = 0
        D_PLAYER.player_psprite_sx[player * 2 + i] = 0
        D_PLAYER.player_psprite_sy[player * 2 + i] = 0
    NEXT i
    D_PLAYER.player_didsecret[player] = 0

    ' Don't do anything immediately.
    D_PLAYER.player_usedown[player] = 1
    D_PLAYER.player_attackdown[player] = 1
    D_PLAYER.player_playerstate[player] = DOOMDEF.PST_LIVE
    D_PLAYER.player_health[player] = DOOMDEF.MAXHEALTH
    D_PLAYER.player_readyweapon[player] = DOOMDEF.WP_PISTOL
    D_PLAYER.player_pendingweapon[player] = DOOMDEF.WP_PISTOL
    D_PLAYER.player_weaponowned[player * DOOMDEF.NUMWEAPONS + DOOMDEF.WP_FIST] = 1
    D_PLAYER.player_weaponowned[player * DOOMDEF.NUMWEAPONS + DOOMDEF.WP_PISTOL] = 1
    D_PLAYER.player_ammo[player * DOOMDEF.NUMAMMO + DOOMDEF.AM_CLIP] = 50
ENDSUB

' gameaction_t: what the game loop is asked to do after the tic.
EXPORT CONST GA_NOTHING = 0
EXPORT CONST GA_LOADLEVEL = 1
EXPORT CONST GA_NEWGAME = 2
EXPORT CONST GA_LOADGAME = 3
EXPORT CONST GA_SAVEGAME = 4
EXPORT CONST GA_PLAYDEMO = 5
EXPORT CONST GA_COMPLETED = 6
EXPORT CONST GA_VICTORY = 7
EXPORT CONST GA_WORLDDONE = 8
EXPORT CONST GA_SCREENSHOT = 9
EXPORT DIM gameaction AS INTEGER = GA_NOTHING
' The level was left through its secret exit.
EXPORT DIM secretexit AS INTEGER = 0

EXPORT SUB G_ExitLevel()
    secretexit = 0
    gameaction = GA_COMPLETED
ENDSUB

EXPORT SUB G_SecretExitLevel()
    ' Doom 2 without the secret levels has none to go to.
    secretexit = 1
    IF DOOMSTAT.commercial <> 0 AND W_WAD.W_CheckNumForName("map31") < 0 THEN secretexit = 0
    gameaction = GA_COMPLETED
ENDSUB

EXPORT SUB G_DoLoadLevel()
    DIM i AS INTEGER
    DIM j AS INTEGER

    ' Force a wipe.
    IF DOOMSTAT.wipegamestate = DOOMSTAT.GS_LEVEL THEN DOOMSTAT.wipegamestate = -1
    DOOMSTAT.gamestate = DOOMSTAT.GS_LEVEL

    ' Set the sky map. The episode's sky was picked in G_InitNew.
    R_SKY.skyflatnum = R_DATA.R_FlatNumForName("F_SKY1")
    IF DOOMSTAT.commercial <> 0 THEN
        R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY3")
        IF DOOMSTAT.gamemap < 12 THEN
            R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY1")
        ELSEIF DOOMSTAT.gamemap < 21 THEN
            R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY2")
        ENDIF
    ENDIF

    ' For time calculation.
    levelstarttic = DOOMSTAT.gametic

    FOR i = 0 TO DOOMDEF.MAXPLAYERS - 1
        IF CLNG(DOOMSTAT.playeringame[i]) <> 0 AND CLNG(D_PLAYER.player_playerstate[i]) = DOOMDEF.PST_DEAD THEN D_PLAYER.player_playerstate[i] = DOOMDEF.PST_REBORN
        FOR j = 0 TO DOOMDEF.MAXPLAYERS - 1
            D_PLAYER.player_frags[i * DOOMDEF.MAXPLAYERS + j] = 0
        NEXT j
    NEXT i

    P_SETUP.P_SetupLevel(DOOMSTAT.gameepisode, DOOMSTAT.gamemap, 0, DOOMSTAT.gameskill)
    ' View the guy you are playing.
    DOOMSTAT.displayplayer = DOOMSTAT.consoleplayer

    ' Clear the command building state.
    FILLV gamekeydown, 0
    FILLV mousebuttons, 0
    FILLV joybuttons, 0
    joyxmove = 0
    joyymove = 0
    mousex = 0
    mousey = 0
    DOOMSTAT.paused = 0
    gameaction = GA_NOTHING
ENDSUB

' Starts a new game on the given skill, episode and map. The players in
' the game are the ones DOOMSTAT.playeringame names.
EXPORT SUB G_InitNew(skill_in AS INTEGER, episode_in AS INTEGER, map_in AS INTEGER)
    DIM skill AS INTEGER = skill_in
    DIM episode AS INTEGER = episode_in
    DIM map_num AS INTEGER = map_in
    DIM i AS INTEGER

    DOOMSTAT.paused = 0

    IF skill > DOOMDEF.SK_NIGHTMARE THEN skill = DOOMDEF.SK_NIGHTMARE
    ' This port plays the retail game: four episodes.
    IF episode < 1 THEN episode = 1
    IF episode > 4 THEN episode = 4
    IF map_num < 1 THEN map_num = 1
    IF map_num > 9 AND DOOMSTAT.commercial = 0 THEN map_num = 9

    M_RANDOM.M_ClearRandom()

    IF skill = DOOMDEF.SK_NIGHTMARE OR DOOMSTAT.respawnparm <> 0 THEN
        DOOMSTAT.respawnmonsters = 1
    ELSE
        DOOMSTAT.respawnmonsters = 0
    ENDIF

    ' Fast monsters: the demon's states run at double rate and three
    ' missiles fly faster. Going back from nightmare undoes it.
    IF DOOMSTAT.fastparm <> 0 OR (skill = DOOMDEF.SK_NIGHTMARE AND DOOMSTAT.gameskill <> DOOMDEF.SK_NIGHTMARE) THEN
        FOR i = INFO.S_SARG_RUN1 TO INFO.S_SARG_PAIN2
            INFO.st_tics[i] = CLNG(INFO.st_tics[i]) SHR 1
        NEXT i
        INFO.mi_speed[INFO.MT_BRUISERSHOT] = 20 * 65536
        INFO.mi_speed[INFO.MT_HEADSHOT] = 20 * 65536
        INFO.mi_speed[INFO.MT_TROOPSHOT] = 20 * 65536
    ELSEIF skill <> DOOMDEF.SK_NIGHTMARE AND DOOMSTAT.gameskill = DOOMDEF.SK_NIGHTMARE THEN
        FOR i = INFO.S_SARG_RUN1 TO INFO.S_SARG_PAIN2
            INFO.st_tics[i] = CLNG(INFO.st_tics[i]) SHL 1
        NEXT i
        INFO.mi_speed[INFO.MT_BRUISERSHOT] = 15 * 65536
        INFO.mi_speed[INFO.MT_HEADSHOT] = 10 * 65536
        INFO.mi_speed[INFO.MT_TROOPSHOT] = 10 * 65536
    ENDIF

    ' Force players to be initialized upon first level load.
    FOR i = 0 TO DOOMDEF.MAXPLAYERS - 1
        D_PLAYER.player_playerstate[i] = DOOMDEF.PST_REBORN
    NEXT i

    DOOMSTAT.paused = 0
    DOOMSTAT.demoplayback = 0
    DOOMSTAT.automapactive = 0
    DOOMSTAT.viewactive = 1
    ' Will be set false if a demo.
    DOOMSTAT.usergame = 1
    DOOMSTAT.gameepisode = episode
    DOOMSTAT.gamemap = map_num
    DOOMSTAT.gameskill = skill

    ' Set the sky map for the episode.
    IF DOOMSTAT.commercial <> 0 THEN
        R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY3")
        IF DOOMSTAT.gamemap < 12 THEN
            R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY1")
        ELSEIF DOOMSTAT.gamemap < 21 THEN
            R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY2")
        ENDIF
    ELSEIF episode = 1 THEN
        R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY1")
    ELSEIF episode = 2 THEN
        R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY2")
    ELSEIF episode = 3 THEN
        R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY3")
    ELSE
        R_SKY.skytexture = R_DATA.R_TextureNumForName("SKY4")
    ENDIF

    G_DoLoadLevel()
ENDSUB

' Runs one tic of the game: the ticcmd built for this tic goes to the
' console player, then the play simulation runs.
' ---- level completion ----------------------------------------------------------

' Par times of the levels of the first three episodes, in seconds.
DIM pars AS ARRAY = [30, 75, 120, 90, 165, 180, 180, 30, 165, 90, 90, 90, 120, 90, 360, 240, 30, 170, 90, 45, 90, 150, 90, 90, 165, 30, 135]

' Called when a player completes a level: take away cards and stuff.
SUB G_PlayerFinishLevel(player AS INTEGER)
    DIM i AS INTEGER
    DIM mo AS INTEGER = D_PLAYER.player_mo[player]
    FOR i = 0 TO DOOMDEF.NUMPOWERS - 1
        D_PLAYER.player_powers[player * DOOMDEF.NUMPOWERS + i] = 0
    NEXT i
    FOR i = 0 TO DOOMDEF.NUMCARDS - 1
        D_PLAYER.player_cards[player * DOOMDEF.NUMCARDS + i] = 0
    NEXT i
    ' Cancel invisibility, gun flashes, ir goggles and palette changes.
    P_MOBJ.mobj_flags[mo] = CLNG(P_MOBJ.mobj_flags[mo]) BAND (BNOT INFO.MF_SHADOW)
    D_PLAYER.player_extralight[player] = 0
    D_PLAYER.player_fixedcolormap[player] = 0
    D_PLAYER.player_damagecount[player] = 0
    D_PLAYER.player_bonuscount[player] = 0
ENDSUB

SUB G_DoCompleted()
    DIM i AS INTEGER
    DIM p AS INTEGER = DOOMSTAT.consoleplayer
    gameaction = GA_NOTHING

    FOR i = 0 TO DOOMDEF.MAXPLAYERS - 1
        IF CLNG(DOOMSTAT.playeringame[i]) <> 0 THEN G_PlayerFinishLevel(i)
    NEXT i

    IF DOOMSTAT.automapactive <> 0 THEN AM_MAP.AM_Stop()

    IF DOOMSTAT.commercial = 0 THEN
        IF DOOMSTAT.gamemap = 8 THEN
            gameaction = GA_VICTORY
            RETURN
        ENDIF
        IF DOOMSTAT.gamemap = 9 THEN
            FOR i = 0 TO DOOMDEF.MAXPLAYERS - 1
                D_PLAYER.player_didsecret[i] = 1
            NEXT i
        ENDIF
    ENDIF

    WI_STUFF.wm_didsecret = CLNG(D_PLAYER.player_didsecret[p])
    WI_STUFF.wm_epsd = DOOMSTAT.gameepisode - 1
    WI_STUFF.wm_last = DOOMSTAT.gamemap - 1

    ' wm_next is 0 biased, unlike gamemap.
    IF DOOMSTAT.commercial <> 0 THEN
        I_SYSTEM.I_Error("G_DoCompleted: DOOM II is not ported")
    ELSEIF secretexit <> 0 THEN
        ' Go to secret level.
        WI_STUFF.wm_next = 8
    ELSEIF DOOMSTAT.gamemap = 9 THEN
        ' Returning from secret level.
        IF DOOMSTAT.gameepisode = 1 THEN
            WI_STUFF.wm_next = 3
        ELSEIF DOOMSTAT.gameepisode = 2 THEN
            WI_STUFF.wm_next = 5
        ELSEIF DOOMSTAT.gameepisode = 3 THEN
            WI_STUFF.wm_next = 6
        ELSE
            WI_STUFF.wm_next = 2
        ENDIF
    ELSE
        ' Go to next level.
        WI_STUFF.wm_next = DOOMSTAT.gamemap
    ENDIF

    WI_STUFF.wm_maxkills = DOOMSTAT.totalkills
    WI_STUFF.wm_maxitems = DOOMSTAT.totalitems
    WI_STUFF.wm_maxsecret = DOOMSTAT.totalsecret
    ' The fourth episode has no par times.
    WI_STUFF.wm_partime = 0
    IF DOOMSTAT.gameepisode <= 3 THEN WI_STUFF.wm_partime = 35 * CLNG(pars[(DOOMSTAT.gameepisode - 1) * 9 + DOOMSTAT.gamemap - 1])
    WI_STUFF.wm_pnum = p
    WI_STUFF.wm_skills = CLNG(D_PLAYER.player_killcount[p])
    WI_STUFF.wm_sitems = CLNG(D_PLAYER.player_itemcount[p])
    WI_STUFF.wm_ssecret = CLNG(D_PLAYER.player_secretcount[p])
    WI_STUFF.wm_stime = P_TICK.leveltime

    DOOMSTAT.gamestate = DOOMSTAT.GS_INTERMISSION
    DOOMSTAT.viewactive = 0
    DOOMSTAT.automapactive = 0

    WI_STUFF.WI_Start()
ENDSUB

' The intermission is over.
EXPORT SUB G_WorldDone()
    gameaction = GA_WORLDDONE
    IF secretexit <> 0 THEN D_PLAYER.player_didsecret[DOOMSTAT.consoleplayer] = 1
ENDSUB

SUB G_DoWorldDone()
    DOOMSTAT.gamestate = DOOMSTAT.GS_LEVEL
    DOOMSTAT.gamemap = WI_STUFF.wm_next + 1
    G_DoLoadLevel()
    gameaction = GA_NOTHING
    DOOMSTAT.viewactive = 1
ENDSUB

' ---- events ---------------------------------------------------------------------

' evtype_t
EXPORT CONST EV_KEYDOWN = 0
EXPORT CONST EV_KEYUP = 1
EXPORT CONST EV_MOUSE = 2
EXPORT CONST EV_JOYSTICK = 3

EXPORT CONST KEY_PAUSE = $FF

' Gets an event of the keyboard or the mouse; TRUE if the game used it.
EXPORT FUNC G_Responder(ev_type AS INTEGER, data1 AS INTEGER, data2 AS INTEGER, data3 AS INTEGER) AS INTEGER
    ' Any other key pops up the menu if in demos.
    IF gameaction = GA_NOTHING AND (DOOMSTAT.demoplayback <> 0 OR DOOMSTAT.gamestate = DOOMSTAT.GS_DEMOSCREEN) THEN
        IF ev_type = EV_KEYDOWN OR (ev_type = EV_MOUSE AND data1 <> 0) THEN
            M_MENU.M_StartControlPanel()
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF

    IF DOOMSTAT.gamestate = DOOMSTAT.GS_LEVEL THEN
        ' The status bar and the automap may eat the event.
        IF ST_STUFF.ST_Responder(ev_type, data1) <> 0 THEN RETURN 1
        IF AM_MAP.AM_Responder(ev_type, data1) <> 0 THEN RETURN 1
    ENDIF

    IF DOOMSTAT.gamestate = DOOMSTAT.GS_FINALE THEN
        IF F_FINALE.F_Responder(ev_type, data1) <> 0 THEN RETURN 1
    ENDIF

    IF ev_type = EV_KEYDOWN THEN
        IF data1 = KEY_PAUSE THEN
            sendpause = 1
            RETURN 1
        ENDIF
        IF data1 >= 0 AND data1 < NUMKEYS THEN gamekeydown[data1] = 1
        ' Eat key down events.
        RETURN 1
    ELSEIF ev_type = EV_KEYUP THEN
        IF data1 >= 0 AND data1 < NUMKEYS THEN gamekeydown[data1] = 0
        ' Always let key up events filter down.
        RETURN 0
    ELSEIF ev_type = EV_MOUSE THEN
        mousebuttons[0] = data1 BAND 1
        mousebuttons[1] = data1 BAND 2
        mousebuttons[2] = data1 BAND 4
        mousex = data2 * (mouseSensitivity + 5) \ 10
        mousey = data3 * (mouseSensitivity + 5) \ 10
        ' Eat events.
        RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

' ---- demos ------------------------------------------------------------------------

CONST DEMOMARKER = $80
' Demos of DOOM 1.9 carry this number.
CONST DEMO_VERSION = 109

' Where the next ticcmd of the demo is read, an offset into W_WAD.pool.
DIM demo_p AS INTEGER = 0
' The first offset behind the demo lump.
DIM demoend AS INTEGER = 0
' The demo that is playing reached its end mark.
EXPORT DIM demoended AS INTEGER = 0
DIM defdemoname$ AS STRING = ""

' Called when a demo reaches its end; clears what the demo set.
EXPORT SUB G_CheckDemoStatus()
    IF DOOMSTAT.demoplayback <> 0 THEN
        DOOMSTAT.demoplayback = 0
        DOOMSTAT.netgame = 0
        DOOMSTAT.deathmatch = 0
        DOOMSTAT.playeringame[1] = 0
        DOOMSTAT.playeringame[2] = 0
        DOOMSTAT.playeringame[3] = 0
        DOOMSTAT.respawnparm = 0
        DOOMSTAT.fastparm = 0
        DOOMSTAT.nomonsters = 0
        DOOMSTAT.consoleplayer = 0
        demoended = 1
        D_MAIN.D_AdvanceDemo()
    ENDIF
ENDSUB

' The next ticcmd of the demo becomes the player's.
SUB G_ReadDemoTiccmd(player AS INTEGER)
    IF demo_p + 4 > demoend ORELSE CLNG(W_WAD.pool[demo_p]) = DEMOMARKER THEN
        ' End of demo data stream.
        G_CheckDemoStatus()
        RETURN
    ENDIF
    DIM forward AS INTEGER = W_WAD.pool[demo_p]
    DIM sideways AS INTEGER = W_WAD.pool[demo_p + 1]
    IF forward > 127 THEN forward = forward - 256
    IF sideways > 127 THEN sideways = sideways - 256
    D_PLAYER.player_cmd_forwardmove[player] = forward
    D_PLAYER.player_cmd_sidemove[player] = sideways
    D_PLAYER.player_cmd_angleturn[player] = CLNG(W_WAD.pool[demo_p + 2]) * 256
    D_PLAYER.player_cmd_buttons[player] = W_WAD.pool[demo_p + 3]
    demo_p = demo_p + 4
ENDSUB

' The demo lump of that name starts to play at the next tic.
EXPORT SUB G_DeferedPlayDemo(name$ AS STRING)
    defdemoname$ = name$
    gameaction = GA_PLAYDEMO
ENDSUB

SUB G_DoPlayDemo()
    gameaction = GA_NOTHING
    DIM lump AS INTEGER = W_WAD.W_GetNumForName(defdemoname$)
    demo_p = W_WAD.W_CacheLumpNum(lump)
    demoend = demo_p + W_WAD.W_LumpLength(lump)
    IF demoend - demo_p < 13 ORELSE CLNG(W_WAD.pool[demo_p]) <> DEMO_VERSION THEN
        PRINT "Demo is from a different game version!"
        demoended = 1
        RETURN
    ENDIF
    IF CLNG(W_WAD.pool[demo_p + 8]) >= DOOMDEF.MAXPLAYERS THEN I_SYSTEM.I_Error("G_DoPlayDemo: console player " + STR$(CLNG(W_WAD.pool[demo_p + 8])))

    DIM skill AS INTEGER = W_WAD.pool[demo_p + 1]
    DIM episode AS INTEGER = W_WAD.pool[demo_p + 2]
    DIM map_num AS INTEGER = W_WAD.pool[demo_p + 3]
    DOOMSTAT.deathmatch = CLNG(W_WAD.pool[demo_p + 4])
    DOOMSTAT.respawnparm = CLNG(W_WAD.pool[demo_p + 5])
    DOOMSTAT.fastparm = CLNG(W_WAD.pool[demo_p + 6])
    DOOMSTAT.nomonsters = CLNG(W_WAD.pool[demo_p + 7])
    DOOMSTAT.consoleplayer = CLNG(W_WAD.pool[demo_p + 8])
    DIM i AS INTEGER
    FOR i = 0 TO DOOMDEF.MAXPLAYERS - 1
        DOOMSTAT.playeringame[i] = W_WAD.pool[demo_p + 9 + i]
    NEXT i
    demo_p = demo_p + 9 + DOOMDEF.MAXPLAYERS
    IF CLNG(DOOMSTAT.playeringame[1]) <> 0 THEN DOOMSTAT.netgame = 1

    G_InitNew(skill, episode, map_num)
    demoended = 0
    DOOMSTAT.usergame = 0
    DOOMSTAT.demoplayback = 1
ENDSUB

' The game the menu asked for: skill, episode and map.
DIM d_skill AS INTEGER = 0
DIM d_episode AS INTEGER = 0
DIM d_map AS INTEGER = 0

' Can be called by the startup code or the menu task; the game starts
' at the next tic.
EXPORT SUB G_DeferedInitNew(skill AS INTEGER, episode AS INTEGER, map_num AS INTEGER)
    d_skill = skill
    d_episode = episode
    d_map = map_num
    gameaction = GA_NEWGAME
ENDSUB

SUB G_DoNewGame()
    DOOMSTAT.demoplayback = 0
    DOOMSTAT.netgame = 0
    DOOMSTAT.deathmatch = 0
    DOOMSTAT.playeringame[0] = 1
    DOOMSTAT.playeringame[1] = 0
    DOOMSTAT.playeringame[2] = 0
    DOOMSTAT.playeringame[3] = 0
    DOOMSTAT.respawnparm = 0
    DOOMSTAT.fastparm = 0
    DOOMSTAT.nomonsters = 0
    DOOMSTAT.consoleplayer = 0
    G_InitNew(d_skill, d_episode, d_map)
    gameaction = GA_NOTHING
ENDSUB

' A player who died starts the level again; in a net game he would come
' back at a start spot, which is not ported.
SUB G_DoReborn(player AS INTEGER)
    IF DOOMSTAT.netgame <> 0 THEN I_SYSTEM.I_Error("G_DoReborn: net games are not ported")
    ' Reload the level from scratch.
    gameaction = GA_LOADLEVEL
ENDSUB

' Runs one tic of the game. A level that was completed in this tic is
' still in gameaction when the tic is over; the next tic starts the
' intermission or the finale.
EXPORT SUB G_Ticker()
    DIM i AS INTEGER

    ' Do player reborns if needed.
    FOR i = 0 TO DOOMDEF.MAXPLAYERS - 1
        IF CLNG(DOOMSTAT.playeringame[i]) <> 0 AND CLNG(D_PLAYER.player_playerstate[i]) = DOOMDEF.PST_REBORN THEN G_DoReborn(i)
    NEXT i

    ' Do things to change the game state.
    DO WHILE gameaction <> GA_NOTHING
        IF gameaction = GA_LOADLEVEL THEN
            G_DoLoadLevel()
        ELSEIF gameaction = GA_NEWGAME THEN
            G_DoNewGame()
        ELSEIF gameaction = GA_PLAYDEMO THEN
            G_DoPlayDemo()
        ELSEIF gameaction = GA_COMPLETED THEN
            G_DoCompleted()
        ELSEIF gameaction = GA_VICTORY THEN
            F_FINALE.F_StartFinale()
        ELSEIF gameaction = GA_WORLDDONE THEN
            G_DoWorldDone()
        ELSE
            I_SYSTEM.I_Error("G_Ticker: game action " + STR$(gameaction) + " is not ported")
        ENDIF
    LOOP

    DIM p AS INTEGER = DOOMSTAT.consoleplayer
    IF CLNG(DOOMSTAT.playeringame[p]) <> 0 THEN
        D_PLAYER.player_cmd_forwardmove[p] = cmd_forwardmove
        D_PLAYER.player_cmd_sidemove[p] = cmd_sidemove
        D_PLAYER.player_cmd_angleturn[p] = cmd_angleturn
        D_PLAYER.player_cmd_consistancy[p] = cmd_consistancy
        D_PLAYER.player_cmd_chatchar[p] = cmd_chatchar
        D_PLAYER.player_cmd_buttons[p] = cmd_buttons
    ENDIF

    DIM buttons AS INTEGER
    FOR i = 0 TO DOOMDEF.MAXPLAYERS - 1
        IF CLNG(DOOMSTAT.playeringame[i]) <> 0 THEN
            IF DOOMSTAT.demoplayback <> 0 THEN G_ReadDemoTiccmd(i)

            ' Check for special buttons; saving a game is not ported.
            buttons = CLNG(D_PLAYER.player_cmd_buttons[i])
            IF (buttons BAND DOOMDEF.BT_SPECIAL) <> 0 AND (buttons BAND DOOMDEF.BT_SPECIALMASK) = 1 THEN
                DOOMSTAT.paused = DOOMSTAT.paused BXOR 1
                IF DOOMSTAT.paused <> 0 THEN
                    S_SOUND.S_PauseSound()
                ELSE
                    S_SOUND.S_ResumeSound()
                ENDIF
            ENDIF
        ENDIF
    NEXT i

    ' Do main actions.
    IF DOOMSTAT.gamestate = DOOMSTAT.GS_LEVEL THEN
        P_TICK.P_Ticker()
        ST_STUFF.ST_Ticker()
        AM_MAP.AM_Ticker()
        HU_STUFF.HU_Ticker()
    ELSEIF DOOMSTAT.gamestate = DOOMSTAT.GS_INTERMISSION THEN
        WI_STUFF.WI_Ticker()
    ELSEIF DOOMSTAT.gamestate = DOOMSTAT.GS_FINALE THEN
        F_FINALE.F_Ticker()
    ELSEIF DOOMSTAT.gamestate = DOOMSTAT.GS_DEMOSCREEN THEN
        D_MAIN.D_PageTicker()
    ENDIF
    DOOMSTAT.gametic = DOOMSTAT.gametic + 1
ENDSUB
