' Savegame I/O (p_saveg.c): the players, the world, the things and the
' moving sectors are written to and read from a string of bytes.
'
' The sections and their order are those of the original, and so is what
' a savegame leaves out: who a thing is after, the sound targets of the
' sectors, flickering fire lights, platforms in stasis, the buttons that
' are waiting to pop back and the random number index. Heights and
' texture offsets are written as whole numbers. The records hold the
' fields of this port, 32 bits each, not the structures of DOOM.EXE.

EXPORT MODULE P_SAVEG

OPTION "EXPLICIT"
OPTION "STRICT"

IMPORT I_SYSTEM
IMPORT DOOMDEF
IMPORT DOOMSTAT
IMPORT D_PLAYER
IMPORT INFO
IMPORT P_SETUP
IMPORT P_TICK
IMPORT P_MOBJ
IMPORT P_MAPUTL
IMPORT P_DOORS
IMPORT P_PLATS
IMPORT P_FLOOR
IMPORT P_CEILNG
IMPORT P_LIGHTS

' The savegame being written or read, and the place the next byte is
' read from.
EXPORT DIM save_buf$ AS STRING = ""
EXPORT DIM save_p AS INTEGER = 0

' thinkerclass_t
CONST TC_END = 0
CONST TC_MOBJ = 1

' specials_e
CONST TC_CEILING = 0
CONST TC_DOOR = 1
CONST TC_FLOOR = 2
CONST TC_PLAT = 3
CONST TC_FLASH = 4
CONST TC_STROBE = 5
CONST TC_GLOW = 6
CONST TC_ENDSPECIALS = 7

CONST PLAYER_FIELDS = 71
CONST MOBJ_FIELDS = 29

EXPORT SUB PutByte(value AS INTEGER)
    save_buf$ = save_buf$ + CHR$(value BAND 255)
ENDSUB

EXPORT FUNC GetByte() AS INTEGER
    IF save_p >= LEN(save_buf$) THEN I_SYSTEM.I_Error("Bad savegame: it ends too early")
    DIM value AS INTEGER = ASC(MID$(save_buf$, save_p, 1))
    save_p = save_p + 1
    RETURN value
ENDFUNC

' The next n 32 bit numbers.
FUNC GetInts(n AS INTEGER) AS ARRAY
    IF save_p + n * 4 > LEN(save_buf$) THEN I_SYSTEM.I_Error("Bad savegame: it ends too early")
    DIM values AS ARRAY = UNPACK("<" + STR$(n) + "n", save_buf$, save_p)
    save_p = save_p + n * 4
    RETURN values
ENDFUNC

' The next n signed 16 bit numbers.
FUNC GetShorts(n AS INTEGER) AS ARRAY
    IF save_p + n * 2 > LEN(save_buf$) THEN I_SYSTEM.I_Error("Bad savegame: it ends too early")
    DIM values AS ARRAY = UNPACK("<" + STR$(n) + "h", save_buf$, save_p)
    save_p = save_p + n * 2
    RETURN values
ENDFUNC

' The low 16 bits as a signed number.
FUNC ToS16(value AS INTEGER) AS INTEGER
    DIM v AS INTEGER = value BAND $FFFF
    IF v > 32767 THEN v = v - 65536
    RETURN v
ENDFUNC

FUNC Ints$(values AS ARRAY) AS STRING
    DIM text$ AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(values) - 1
        text$ = text$ + PACK$("<n", CLNG(values[i]))
    NEXT i
    RETURN text$
ENDFUNC

' ---- players --------------------------------------------------------------------

EXPORT SUB P_ArchivePlayers()
    DIM p AS INTEGER
    DIM j AS INTEGER
    DIM f AS ARRAY = []
    FOR p = 0 TO DOOMDEF.MAXPLAYERS - 1
        IF CLNG(DOOMSTAT.playeringame[p]) = 0 THEN CONTINUEFOR
        f = [CLNG(D_PLAYER.player_playerstate[p]), CLNG(D_PLAYER.player_cmd_forwardmove[p]), CLNG(D_PLAYER.player_cmd_sidemove[p]), CLNG(D_PLAYER.player_cmd_angleturn[p]), CLNG(D_PLAYER.player_cmd_consistancy[p]), CLNG(D_PLAYER.player_cmd_chatchar[p]), CLNG(D_PLAYER.player_cmd_buttons[p])]
        f = APPEND(f, [CLNG(D_PLAYER.player_viewz[p]), CLNG(D_PLAYER.player_viewheight[p]), CLNG(D_PLAYER.player_deltaviewheight[p]), CLNG(D_PLAYER.player_bob[p]), CLNG(D_PLAYER.player_health[p]), CLNG(D_PLAYER.player_armorpoints[p]), CLNG(D_PLAYER.player_armortype[p])])
        FOR j = 0 TO DOOMDEF.NUMPOWERS - 1
            f = APPEND(f, CLNG(D_PLAYER.player_powers[p * DOOMDEF.NUMPOWERS + j]))
        NEXT j
        FOR j = 0 TO DOOMDEF.NUMCARDS - 1
            f = APPEND(f, CLNG(D_PLAYER.player_cards[p * DOOMDEF.NUMCARDS + j]))
        NEXT j
        f = APPEND(f, CLNG(D_PLAYER.player_backpack[p]))
        FOR j = 0 TO DOOMDEF.MAXPLAYERS - 1
            f = APPEND(f, CLNG(D_PLAYER.player_frags[p * DOOMDEF.MAXPLAYERS + j]))
        NEXT j
        f = APPEND(f, [CLNG(D_PLAYER.player_readyweapon[p]), CLNG(D_PLAYER.player_pendingweapon[p])])
        FOR j = 0 TO DOOMDEF.NUMWEAPONS - 1
            f = APPEND(f, CLNG(D_PLAYER.player_weaponowned[p * DOOMDEF.NUMWEAPONS + j]))
        NEXT j
        FOR j = 0 TO DOOMDEF.NUMAMMO - 1
            f = APPEND(f, CLNG(D_PLAYER.player_ammo[p * DOOMDEF.NUMAMMO + j]))
        NEXT j
        FOR j = 0 TO DOOMDEF.NUMAMMO - 1
            f = APPEND(f, CLNG(D_PLAYER.player_maxammo[p * DOOMDEF.NUMAMMO + j]))
        NEXT j
        f = APPEND(f, [CLNG(D_PLAYER.player_attackdown[p]), CLNG(D_PLAYER.player_usedown[p]), CLNG(D_PLAYER.player_cheats[p]), CLNG(D_PLAYER.player_refire[p]), CLNG(D_PLAYER.player_killcount[p]), CLNG(D_PLAYER.player_itemcount[p]), CLNG(D_PLAYER.player_secretcount[p])])
        f = APPEND(f, [CLNG(D_PLAYER.player_damagecount[p]), CLNG(D_PLAYER.player_bonuscount[p]), CLNG(D_PLAYER.player_extralight[p]), CLNG(D_PLAYER.player_fixedcolormap[p]), CLNG(D_PLAYER.player_colormap[p])])
        FOR j = 0 TO 1
            f = APPEND(f, [CLNG(D_PLAYER.player_psprite_state[p * 2 + j]), CLNG(D_PLAYER.player_psprite_tics[p * 2 + j]), CLNG(D_PLAYER.player_psprite_sx[p * 2 + j]), CLNG(D_PLAYER.player_psprite_sy[p * 2 + j])])
        NEXT j
        f = APPEND(f, CLNG(D_PLAYER.player_didsecret[p]))
        IF LEN(f) <> PLAYER_FIELDS THEN I_SYSTEM.I_Error("P_ArchivePlayers: " + STR$(LEN(f)) + " fields")
        save_buf$ = save_buf$ + Ints$(f)
    NEXT p
ENDSUB

EXPORT SUB P_UnArchivePlayers()
    DIM p AS INTEGER
    DIM j AS INTEGER
    DIM n AS INTEGER
    DIM f AS ARRAY = []
    FOR p = 0 TO DOOMDEF.MAXPLAYERS - 1
        IF CLNG(DOOMSTAT.playeringame[p]) = 0 THEN CONTINUEFOR
        f = GetInts(PLAYER_FIELDS)
        D_PLAYER.player_playerstate[p] = CLNG(f[0])
        D_PLAYER.player_cmd_forwardmove[p] = CLNG(f[1])
        D_PLAYER.player_cmd_sidemove[p] = CLNG(f[2])
        D_PLAYER.player_cmd_angleturn[p] = CLNG(f[3])
        D_PLAYER.player_cmd_consistancy[p] = CLNG(f[4])
        D_PLAYER.player_cmd_chatchar[p] = CLNG(f[5])
        D_PLAYER.player_cmd_buttons[p] = CLNG(f[6])
        D_PLAYER.player_viewz[p] = CLNG(f[7])
        D_PLAYER.player_viewheight[p] = CLNG(f[8])
        D_PLAYER.player_deltaviewheight[p] = CLNG(f[9])
        D_PLAYER.player_bob[p] = CLNG(f[10])
        D_PLAYER.player_health[p] = CLNG(f[11])
        D_PLAYER.player_armorpoints[p] = CLNG(f[12])
        D_PLAYER.player_armortype[p] = CLNG(f[13])
        n = 14
        FOR j = 0 TO DOOMDEF.NUMPOWERS - 1
            D_PLAYER.player_powers[p * DOOMDEF.NUMPOWERS + j] = CLNG(f[n + j])
        NEXT j
        n = n + DOOMDEF.NUMPOWERS
        FOR j = 0 TO DOOMDEF.NUMCARDS - 1
            D_PLAYER.player_cards[p * DOOMDEF.NUMCARDS + j] = CLNG(f[n + j])
        NEXT j
        n = n + DOOMDEF.NUMCARDS
        D_PLAYER.player_backpack[p] = CLNG(f[n])
        n = n + 1
        FOR j = 0 TO DOOMDEF.MAXPLAYERS - 1
            D_PLAYER.player_frags[p * DOOMDEF.MAXPLAYERS + j] = CLNG(f[n + j])
        NEXT j
        n = n + DOOMDEF.MAXPLAYERS
        D_PLAYER.player_readyweapon[p] = CLNG(f[n])
        D_PLAYER.player_pendingweapon[p] = CLNG(f[n + 1])
        n = n + 2
        FOR j = 0 TO DOOMDEF.NUMWEAPONS - 1
            D_PLAYER.player_weaponowned[p * DOOMDEF.NUMWEAPONS + j] = CLNG(f[n + j])
        NEXT j
        n = n + DOOMDEF.NUMWEAPONS
        FOR j = 0 TO DOOMDEF.NUMAMMO - 1
            D_PLAYER.player_ammo[p * DOOMDEF.NUMAMMO + j] = CLNG(f[n + j])
        NEXT j
        n = n + DOOMDEF.NUMAMMO
        FOR j = 0 TO DOOMDEF.NUMAMMO - 1
            D_PLAYER.player_maxammo[p * DOOMDEF.NUMAMMO + j] = CLNG(f[n + j])
        NEXT j
        n = n + DOOMDEF.NUMAMMO
        D_PLAYER.player_attackdown[p] = CLNG(f[n])
        D_PLAYER.player_usedown[p] = CLNG(f[n + 1])
        D_PLAYER.player_cheats[p] = CLNG(f[n + 2])
        D_PLAYER.player_refire[p] = CLNG(f[n + 3])
        D_PLAYER.player_killcount[p] = CLNG(f[n + 4])
        D_PLAYER.player_itemcount[p] = CLNG(f[n + 5])
        D_PLAYER.player_secretcount[p] = CLNG(f[n + 6])
        D_PLAYER.player_damagecount[p] = CLNG(f[n + 7])
        D_PLAYER.player_bonuscount[p] = CLNG(f[n + 8])
        D_PLAYER.player_extralight[p] = CLNG(f[n + 9])
        D_PLAYER.player_fixedcolormap[p] = CLNG(f[n + 10])
        D_PLAYER.player_colormap[p] = CLNG(f[n + 11])
        n = n + 12
        FOR j = 0 TO 1
            D_PLAYER.player_psprite_state[p * 2 + j] = CLNG(f[n + j * 4])
            D_PLAYER.player_psprite_tics[p * 2 + j] = CLNG(f[n + j * 4 + 1])
            D_PLAYER.player_psprite_sx[p * 2 + j] = CLNG(f[n + j * 4 + 2])
            D_PLAYER.player_psprite_sy[p * 2 + j] = CLNG(f[n + j * 4 + 3])
        NEXT j
        n = n + 8
        D_PLAYER.player_didsecret[p] = CLNG(f[n])

        ' What the game uses as an index has to be one.
        IF CLNG(D_PLAYER.player_readyweapon[p]) < 0 OR CLNG(D_PLAYER.player_readyweapon[p]) >= DOOMDEF.NUMWEAPONS OR CLNG(D_PLAYER.player_pendingweapon[p]) < 0 OR CLNG(D_PLAYER.player_pendingweapon[p]) > DOOMDEF.WP_NOCHANGE THEN I_SYSTEM.I_Error("Bad savegame: the weapon of a player")
        FOR j = 0 TO 1
            IF CLNG(D_PLAYER.player_psprite_state[p * 2 + j]) < 0 OR CLNG(D_PLAYER.player_psprite_state[p * 2 + j]) >= INFO.NUMSTATES THEN I_SYSTEM.I_Error("Bad savegame: the weapon sprite of a player")
        NEXT j

        ' Will be set when the things are read.
        D_PLAYER.player_mo[p] = -1
        D_PLAYER.player_message$[p] = ""
        D_PLAYER.player_attacker[p] = -1
    NEXT p
ENDSUB

' ---- world ----------------------------------------------------------------------

EXPORT SUB P_ArchiveWorld()
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM si AS INTEGER
    DIM text$ AS STRING = ""

    ' Do sectors.
    FOR i = 0 TO P_SETUP.numsectors - 1
        text$ = text$ + PACK$("<7h", ToS16(CLNG(P_SETUP.sector_floorheight[i]) SHR 16), ToS16(CLNG(P_SETUP.sector_ceilingheight[i]) SHR 16), ToS16(CLNG(P_SETUP.sector_floorpic[i])), ToS16(CLNG(P_SETUP.sector_ceilingpic[i])), ToS16(CLNG(P_SETUP.sector_lightlevel[i])), ToS16(CLNG(P_SETUP.sector_special[i])), ToS16(CLNG(P_SETUP.sector_tag[i])))
    NEXT i
    save_buf$ = save_buf$ + text$

    ' Do lines.
    text$ = ""
    FOR i = 0 TO P_SETUP.numlines - 1
        text$ = text$ + PACK$("<3h", ToS16(CLNG(P_SETUP.line_flags[i])), ToS16(CLNG(P_SETUP.line_special[i])), ToS16(CLNG(P_SETUP.line_tag[i])))
        FOR j = 0 TO 1
            IF j = 0 THEN si = CLNG(P_SETUP.line_sidenum0[i]) ELSE si = CLNG(P_SETUP.line_sidenum1[i])
            IF si = -1 THEN CONTINUEFOR
            text$ = text$ + PACK$("<5h", ToS16(CLNG(P_SETUP.side_textureoffset[si]) SHR 16), ToS16(CLNG(P_SETUP.side_rowoffset[si]) SHR 16), ToS16(CLNG(P_SETUP.side_toptexture[si])), ToS16(CLNG(P_SETUP.side_bottomtexture[si])), ToS16(CLNG(P_SETUP.side_midtexture[si])))
        NEXT j
        ' Long strings are slow to add to.
        IF LEN(text$) > 4096 THEN
            save_buf$ = save_buf$ + text$
            text$ = ""
        ENDIF
    NEXT i
    save_buf$ = save_buf$ + text$
ENDSUB

EXPORT SUB P_UnArchiveWorld()
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM si AS INTEGER
    DIM f AS ARRAY = []

    ' Do sectors.
    FOR i = 0 TO P_SETUP.numsectors - 1
        f = GetShorts(7)
        P_SETUP.sector_floorheight[i] = CLNG(f[0]) SHL 16
        P_SETUP.sector_ceilingheight[i] = CLNG(f[1]) SHL 16
        P_SETUP.sector_floorpic[i] = CLNG(f[2])
        P_SETUP.sector_ceilingpic[i] = CLNG(f[3])
        P_SETUP.sector_lightlevel[i] = CLNG(f[4])
        P_SETUP.sector_special[i] = CLNG(f[5])
        P_SETUP.sector_tag[i] = CLNG(f[6])
        P_SETUP.sector_specialdata[i] = -1
        P_SETUP.sector_soundtarget[i] = -1
    NEXT i

    ' Do lines.
    FOR i = 0 TO P_SETUP.numlines - 1
        f = GetShorts(3)
        P_SETUP.line_flags[i] = CLNG(f[0])
        P_SETUP.line_special[i] = CLNG(f[1])
        P_SETUP.line_tag[i] = CLNG(f[2])
        FOR j = 0 TO 1
            IF j = 0 THEN si = CLNG(P_SETUP.line_sidenum0[i]) ELSE si = CLNG(P_SETUP.line_sidenum1[i])
            IF si = -1 THEN CONTINUEFOR
            f = GetShorts(5)
            P_SETUP.side_textureoffset[si] = CLNG(f[0]) SHL 16
            P_SETUP.side_rowoffset[si] = CLNG(f[1]) SHL 16
            P_SETUP.side_toptexture[si] = CLNG(f[2])
            P_SETUP.side_bottomtexture[si] = CLNG(f[3])
            P_SETUP.side_midtexture[si] = CLNG(f[4])
        NEXT j
    NEXT i
ENDSUB

' ---- things ---------------------------------------------------------------------

EXPORT SUB P_ArchiveThinkers()
    DIM th AS INTEGER = CLNG(P_TICK.th_next[0])
    DIM m AS INTEGER
    DIM f AS ARRAY = []
    DIM text$ AS STRING = ""

    ' Save off the current thinkers.
    DO WHILE th <> 0
        IF CLNG(P_TICK.th_function[th]) = P_TICK.TF_MOBJ THEN
            m = CLNG(P_TICK.th_object[th])
            f = [CLNG(P_MOBJ.mobj_x[m]), CLNG(P_MOBJ.mobj_y[m]), CLNG(P_MOBJ.mobj_z[m]), CLNG(P_MOBJ.mobj_angle[m]), CLNG(P_MOBJ.mobj_sprite[m]), CLNG(P_MOBJ.mobj_frame[m]), CLNG(P_MOBJ.mobj_radius[m]), CLNG(P_MOBJ.mobj_height[m])]
            f = APPEND(f, [CLNG(P_MOBJ.mobj_momx[m]), CLNG(P_MOBJ.mobj_momy[m]), CLNG(P_MOBJ.mobj_momz[m]), CLNG(P_MOBJ.mobj_validcount[m]), CLNG(P_MOBJ.mobj_type[m]), CLNG(P_MOBJ.mobj_tics[m]), CLNG(P_MOBJ.mobj_state[m]), CLNG(P_MOBJ.mobj_flags[m]), CLNG(P_MOBJ.mobj_health[m])])
            f = APPEND(f, [CLNG(P_MOBJ.mobj_movedir[m]), CLNG(P_MOBJ.mobj_movecount[m]), CLNG(P_MOBJ.mobj_reactiontime[m]), CLNG(P_MOBJ.mobj_threshold[m]), CLNG(P_MOBJ.mobj_player[m]) + 1, CLNG(P_MOBJ.mobj_lastlook[m])])
            f = APPEND(f, [CLNG(P_MOBJ.mobj_spawnpoint_x[m]), CLNG(P_MOBJ.mobj_spawnpoint_y[m]), CLNG(P_MOBJ.mobj_spawnpoint_angle[m]), CLNG(P_MOBJ.mobj_spawnpoint_type[m]), CLNG(P_MOBJ.mobj_spawnpoint_options[m]), 0])
            text$ = text$ + CHR$(TC_MOBJ) + Ints$(f)
            IF LEN(text$) > 4096 THEN
                save_buf$ = save_buf$ + text$
                text$ = ""
            ENDIF
        ENDIF
        th = CLNG(P_TICK.th_next[th])
    LOOP

    ' Add a terminating marker.
    save_buf$ = save_buf$ + text$ + CHR$(TC_END)
ENDSUB

EXPORT SUB P_UnArchiveThinkers()
    DIM th AS INTEGER = CLNG(P_TICK.th_next[0])
    DIM following AS INTEGER
    DIM tclass AS INTEGER
    DIM m AS INTEGER
    DIM sector AS INTEGER
    DIM player AS INTEGER
    DIM f AS ARRAY = []

    ' Remove all the current thinkers.
    DO WHILE th <> 0
        following = CLNG(P_TICK.th_next[th])
        IF CLNG(P_TICK.th_function[th]) = P_TICK.TF_MOBJ THEN P_MOBJ.P_RemoveMobj(CLNG(P_TICK.th_object[th]))
        th = following
    LOOP
    P_TICK.P_InitThinkers()

    ' Read in saved thinkers.
    DO
        tclass = GetByte()
        IF tclass = TC_END THEN RETURN
        IF tclass <> TC_MOBJ THEN I_SYSTEM.I_Error("Unknown tclass " + STR$(tclass) + " in savegame")

        f = GetInts(MOBJ_FIELDS)
        IF CLNG(f[12]) < 0 OR CLNG(f[12]) >= INFO.NUMMOBJTYPES OR CLNG(f[14]) < 0 OR CLNG(f[14]) >= INFO.NUMSTATES OR CLNG(f[21]) < 0 OR CLNG(f[21]) > DOOMDEF.MAXPLAYERS OR CLNG(f[4]) < 0 OR CLNG(f[4]) >= INFO.NUMSPRITES THEN I_SYSTEM.I_Error("Bad savegame: a thing of type " + STR$(CLNG(f[12])) + " in state " + STR$(CLNG(f[14])))
        m = P_MOBJ.P_AllocMobj()
        P_MOBJ.mobj_x[m] = CLNG(f[0])
        P_MOBJ.mobj_y[m] = CLNG(f[1])
        P_MOBJ.mobj_z[m] = CLNG(f[2])
        P_MOBJ.mobj_angle[m] = CLNG(f[3])
        P_MOBJ.mobj_sprite[m] = CLNG(f[4])
        P_MOBJ.mobj_frame[m] = CLNG(f[5])
        P_MOBJ.mobj_radius[m] = CLNG(f[6])
        P_MOBJ.mobj_height[m] = CLNG(f[7])
        P_MOBJ.mobj_momx[m] = CLNG(f[8])
        P_MOBJ.mobj_momy[m] = CLNG(f[9])
        P_MOBJ.mobj_momz[m] = CLNG(f[10])
        P_MOBJ.mobj_validcount[m] = CLNG(f[11])
        P_MOBJ.mobj_type[m] = CLNG(f[12])
        P_MOBJ.mobj_tics[m] = CLNG(f[13])
        P_MOBJ.mobj_state[m] = CLNG(f[14])
        P_MOBJ.mobj_flags[m] = CLNG(f[15])
        P_MOBJ.mobj_health[m] = CLNG(f[16])
        P_MOBJ.mobj_movedir[m] = CLNG(f[17])
        P_MOBJ.mobj_movecount[m] = CLNG(f[18])
        P_MOBJ.mobj_reactiontime[m] = CLNG(f[19])
        P_MOBJ.mobj_threshold[m] = CLNG(f[20])
        P_MOBJ.mobj_lastlook[m] = CLNG(f[22])
        P_MOBJ.mobj_spawnpoint_x[m] = CLNG(f[23])
        P_MOBJ.mobj_spawnpoint_y[m] = CLNG(f[24])
        P_MOBJ.mobj_spawnpoint_angle[m] = CLNG(f[25])
        P_MOBJ.mobj_spawnpoint_type[m] = CLNG(f[26])
        P_MOBJ.mobj_spawnpoint_options[m] = CLNG(f[27])
        P_MOBJ.mobj_target[m] = -1
        P_MOBJ.mobj_tracer[m] = -1
        player = CLNG(f[21]) - 1
        P_MOBJ.mobj_player[m] = player
        IF player >= 0 THEN D_PLAYER.player_mo[player] = m

        P_MAPUTL.P_SetThingPosition(m)
        sector = CLNG(P_SETUP.subsector_sector[CLNG(P_MOBJ.mobj_subsector[m])])
        P_MOBJ.mobj_floorz[m] = P_SETUP.sector_floorheight[sector]
        P_MOBJ.mobj_ceilingz[m] = P_SETUP.sector_ceilingheight[sector]
        P_MOBJ.mobj_thinker[m] = P_TICK.P_AddThinker(P_TICK.TF_MOBJ, m)
    LOOP
ENDSUB

' ---- moving sectors and lights --------------------------------------------------

' TRUE if the thinker is one of the active ceilings.
FUNC IsActiveCeiling(th AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO P_CEILNG.MAXCEILINGS - 1
        IF CLNG(P_CEILNG.activeceilings[i]) = th THEN RETURN 1
    NEXT i
    RETURN 0
ENDFUNC

' The record of a ceiling; alive is 0 for one in stasis.
FUNC Ceiling$(th AS INTEGER, alive AS INTEGER) AS STRING
    RETURN CHR$(TC_CEILING) + Ints$([alive, CLNG(P_CEILNG.ceiling_type[th]), CLNG(P_CEILNG.ceiling_sector[th]), CLNG(P_CEILNG.ceiling_bottomheight[th]), CLNG(P_CEILNG.ceiling_topheight[th]), CLNG(P_CEILNG.ceiling_speed[th]), CLNG(P_CEILNG.ceiling_crush[th]), CLNG(P_CEILNG.ceiling_direction[th]), CLNG(P_CEILNG.ceiling_tag[th]), CLNG(P_CEILNG.ceiling_olddirection[th])])
ENDFUNC

EXPORT SUB P_ArchiveSpecials()
    DIM th AS INTEGER = CLNG(P_TICK.th_next[0])
    DIM callee AS INTEGER
    DIM text$ AS STRING = ""

    ' Save off the current thinkers.
    DO WHILE th <> 0
        callee = CLNG(P_TICK.th_function[th])
        IF callee = P_TICK.TF_NONE THEN
            ' Of the movers in stasis only the ceilings are written.
            IF IsActiveCeiling(th) <> 0 THEN text$ = text$ + Ceiling$(th, 0)
        ELSEIF callee = P_TICK.TF_CEILING THEN
            text$ = text$ + Ceiling$(th, 1)
        ELSEIF callee = P_TICK.TF_DOOR THEN
            text$ = text$ + CHR$(TC_DOOR) + Ints$([CLNG(P_DOORS.door_type[th]), CLNG(P_DOORS.door_sector[th]), CLNG(P_DOORS.door_topheight[th]), CLNG(P_DOORS.door_speed[th]), CLNG(P_DOORS.door_direction[th]), CLNG(P_DOORS.door_topwait[th]), CLNG(P_DOORS.door_topcountdown[th])])
        ELSEIF callee = P_TICK.TF_FLOOR THEN
            text$ = text$ + CHR$(TC_FLOOR) + Ints$([CLNG(P_FLOOR.floor_type[th]), CLNG(P_FLOOR.floor_crush[th]), CLNG(P_FLOOR.floor_sector[th]), CLNG(P_FLOOR.floor_direction[th]), CLNG(P_FLOOR.floor_newspecial[th]), CLNG(P_FLOOR.floor_texture[th]), CLNG(P_FLOOR.floor_floordestheight[th]), CLNG(P_FLOOR.floor_speed[th])])
        ELSEIF callee = P_TICK.TF_PLAT THEN
            text$ = text$ + CHR$(TC_PLAT) + Ints$([CLNG(P_PLATS.plat_sector[th]), CLNG(P_PLATS.plat_speed[th]), CLNG(P_PLATS.plat_low[th]), CLNG(P_PLATS.plat_high[th]), CLNG(P_PLATS.plat_wait[th]), CLNG(P_PLATS.plat_count[th]), CLNG(P_PLATS.plat_status[th]), CLNG(P_PLATS.plat_oldstatus[th]), CLNG(P_PLATS.plat_crush[th]), CLNG(P_PLATS.plat_tag[th]), CLNG(P_PLATS.plat_type[th])])
        ELSEIF callee = P_TICK.TF_LIGHTFLASH THEN
            text$ = text$ + CHR$(TC_FLASH) + Ints$([CLNG(P_LIGHTS.light_sector[th]), CLNG(P_LIGHTS.light_count[th]), CLNG(P_LIGHTS.light_maxlight[th]), CLNG(P_LIGHTS.light_minlight[th]), CLNG(P_LIGHTS.light_maxtime[th]), CLNG(P_LIGHTS.light_mintime[th])])
        ELSEIF callee = P_TICK.TF_STROBE THEN
            text$ = text$ + CHR$(TC_STROBE) + Ints$([CLNG(P_LIGHTS.light_sector[th]), CLNG(P_LIGHTS.light_count[th]), CLNG(P_LIGHTS.light_minlight[th]), CLNG(P_LIGHTS.light_maxlight[th]), CLNG(P_LIGHTS.light_mintime[th]), CLNG(P_LIGHTS.light_maxtime[th])])
        ELSEIF callee = P_TICK.TF_GLOW THEN
            text$ = text$ + CHR$(TC_GLOW) + Ints$([CLNG(P_LIGHTS.light_sector[th]), CLNG(P_LIGHTS.light_minlight[th]), CLNG(P_LIGHTS.light_maxlight[th]), CLNG(P_LIGHTS.light_direction[th])])
        ENDIF
        th = CLNG(P_TICK.th_next[th])
    LOOP

    ' Add a terminating marker.
    save_buf$ = save_buf$ + text$ + CHR$(TC_ENDSPECIALS)
ENDSUB

' The sector a record names.
FUNC SavedSector(sector AS INTEGER) AS INTEGER
    IF sector < 0 OR sector >= P_SETUP.numsectors THEN I_SYSTEM.I_Error("Bad savegame: sector " + STR$(sector))
    RETURN sector
ENDFUNC

EXPORT SUB P_UnArchiveSpecials()
    DIM tclass AS INTEGER
    DIM th AS INTEGER
    DIM sector AS INTEGER
    DIM f AS ARRAY = []

    ' Read in saved thinkers.
    DO
        tclass = GetByte()
        IF tclass = TC_ENDSPECIALS THEN RETURN

        IF tclass = TC_CEILING THEN
            f = GetInts(10)
            sector = SavedSector(CLNG(f[2]))
            th = P_TICK.P_AddThinker(P_TICK.TF_CEILING, -1)
            IF CLNG(f[0]) = 0 THEN P_TICK.th_function[th] = P_TICK.TF_NONE
            P_CEILNG.ceiling_type[th] = CLNG(f[1])
            P_CEILNG.ceiling_sector[th] = sector
            P_CEILNG.ceiling_bottomheight[th] = CLNG(f[3])
            P_CEILNG.ceiling_topheight[th] = CLNG(f[4])
            P_CEILNG.ceiling_speed[th] = CLNG(f[5])
            P_CEILNG.ceiling_crush[th] = CLNG(f[6])
            P_CEILNG.ceiling_direction[th] = CLNG(f[7])
            P_CEILNG.ceiling_tag[th] = CLNG(f[8])
            P_CEILNG.ceiling_olddirection[th] = CLNG(f[9])
            P_SETUP.sector_specialdata[sector] = th
            P_CEILNG.P_AddActiveCeiling(th)
        ELSEIF tclass = TC_DOOR THEN
            f = GetInts(7)
            sector = SavedSector(CLNG(f[1]))
            th = P_TICK.P_AddThinker(P_TICK.TF_DOOR, -1)
            P_DOORS.door_type[th] = CLNG(f[0])
            P_DOORS.door_sector[th] = sector
            P_DOORS.door_topheight[th] = CLNG(f[2])
            P_DOORS.door_speed[th] = CLNG(f[3])
            P_DOORS.door_direction[th] = CLNG(f[4])
            P_DOORS.door_topwait[th] = CLNG(f[5])
            P_DOORS.door_topcountdown[th] = CLNG(f[6])
            P_SETUP.sector_specialdata[sector] = th
        ELSEIF tclass = TC_FLOOR THEN
            f = GetInts(8)
            sector = SavedSector(CLNG(f[2]))
            th = P_TICK.P_AddThinker(P_TICK.TF_FLOOR, -1)
            P_FLOOR.floor_type[th] = CLNG(f[0])
            P_FLOOR.floor_crush[th] = CLNG(f[1])
            P_FLOOR.floor_sector[th] = sector
            P_FLOOR.floor_direction[th] = CLNG(f[3])
            P_FLOOR.floor_newspecial[th] = CLNG(f[4])
            P_FLOOR.floor_texture[th] = CLNG(f[5])
            P_FLOOR.floor_floordestheight[th] = CLNG(f[6])
            P_FLOOR.floor_speed[th] = CLNG(f[7])
            P_SETUP.sector_specialdata[sector] = th
        ELSEIF tclass = TC_PLAT THEN
            f = GetInts(11)
            sector = SavedSector(CLNG(f[0]))
            th = P_TICK.P_AddThinker(P_TICK.TF_PLAT, -1)
            P_PLATS.plat_sector[th] = sector
            P_PLATS.plat_speed[th] = CLNG(f[1])
            P_PLATS.plat_low[th] = CLNG(f[2])
            P_PLATS.plat_high[th] = CLNG(f[3])
            P_PLATS.plat_wait[th] = CLNG(f[4])
            P_PLATS.plat_count[th] = CLNG(f[5])
            P_PLATS.plat_status[th] = CLNG(f[6])
            P_PLATS.plat_oldstatus[th] = CLNG(f[7])
            P_PLATS.plat_crush[th] = CLNG(f[8])
            P_PLATS.plat_tag[th] = CLNG(f[9])
            P_PLATS.plat_type[th] = CLNG(f[10])
            P_SETUP.sector_specialdata[sector] = th
            P_PLATS.P_AddActivePlat(th)
        ELSEIF tclass = TC_FLASH THEN
            f = GetInts(6)
            th = P_TICK.P_AddThinker(P_TICK.TF_LIGHTFLASH, -1)
            P_LIGHTS.light_sector[th] = SavedSector(CLNG(f[0]))
            P_LIGHTS.light_count[th] = CLNG(f[1])
            P_LIGHTS.light_maxlight[th] = CLNG(f[2])
            P_LIGHTS.light_minlight[th] = CLNG(f[3])
            P_LIGHTS.light_maxtime[th] = CLNG(f[4])
            P_LIGHTS.light_mintime[th] = CLNG(f[5])
        ELSEIF tclass = TC_STROBE THEN
            f = GetInts(6)
            th = P_TICK.P_AddThinker(P_TICK.TF_STROBE, -1)
            P_LIGHTS.light_sector[th] = SavedSector(CLNG(f[0]))
            P_LIGHTS.light_count[th] = CLNG(f[1])
            P_LIGHTS.light_minlight[th] = CLNG(f[2])
            P_LIGHTS.light_maxlight[th] = CLNG(f[3])
            P_LIGHTS.light_mintime[th] = CLNG(f[4])
            P_LIGHTS.light_maxtime[th] = CLNG(f[5])
        ELSEIF tclass = TC_GLOW THEN
            f = GetInts(4)
            th = P_TICK.P_AddThinker(P_TICK.TF_GLOW, -1)
            P_LIGHTS.light_sector[th] = SavedSector(CLNG(f[0]))
            P_LIGHTS.light_minlight[th] = CLNG(f[1])
            P_LIGHTS.light_maxlight[th] = CLNG(f[2])
            P_LIGHTS.light_direction[th] = CLNG(f[3])
        ELSE
            I_SYSTEM.I_Error("P_UnarchiveSpecials: Unknown tclass " + STR$(tclass) + " in savegame")
        ENDIF
    LOOP
ENDSUB
