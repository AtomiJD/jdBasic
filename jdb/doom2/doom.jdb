' DOOM. The title loop with its demos, the menu, the game.
'
'   build/jdBasic.exe -c jdb/doom2/doom.jdb
'   jdb/doom2/doom.exe [-window] [-iwad file] [episode map [skill]]
'
' Without arguments the title loop starts; any key opens the menu. With an
' episode and a map the game starts there, on skill 0 to 4 (2 if left out);
' the levels of DOOM II are in episode 1. -iwad names the WAD to play;
' without it D_MAIN.IdentifyVersion$ looks for one.
'
' The game fills the primary display; Alt with Enter switches between that
' and a window, -window starts in a window.
'
' Arrow keys turn and move, Shift runs, Ctrl fires, Space uses, 1 to 7 pick
' a weapon, Alt with left or right steps sideways and so do comma and full
' stop. W, A, S and D move and step as well. Tab shows the map, Escape the
' menu, F1 help, F2 saves, F3 loads, F4 sound volume, F5 detail, F6 quick
' save, F7 ends the game, F8 messages, F9 quick load, F10 quits, F11 gamma,
' minus and equals change the view size, Pause pauses.
'
' The settings are kept in default.cfg in the working directory. With
' use_mouse 1 there the mouse turns and, moved up and down, walks; its
' left button fires, the right one makes it step sideways, the middle one
' walks. The pointer is not held in the window.

OPTION "EXPLICIT"
OPTION "NOPAUSE"

IMPORT DOOMDEF
IMPORT DOOMSTAT
IMPORT I_VIDEO
IMPORT G_GAME
IMPORT D_MAIN
IMPORT M_MENU
IMPORT D_PLAYER
IMPORT S_SOUND
IMPORT M_MISC

DIM running AS INTEGER = 1

SUB HandleQuit(quit_data)
    running = 0
ENDSUB

' The key code DOOM knows a key by, -1 for a key it has no use for.
FUNC DoomKey(key_name$ AS STRING, keycode AS INTEGER) AS INTEGER
    SWITCH key_name$
        CASE "Left"
            RETURN G_GAME.KEY_LEFTARROW
        CASE "Right"
            RETURN G_GAME.KEY_RIGHTARROW
        CASE "Up"
            RETURN G_GAME.KEY_UPARROW
        CASE "Down"
            RETURN G_GAME.KEY_DOWNARROW
        CASE "Left Shift", "Right Shift"
            RETURN G_GAME.KEY_RSHIFT
        CASE "Left Ctrl", "Right Ctrl"
            RETURN G_GAME.KEY_RCTRL
        CASE "Left Alt", "Right Alt"
            RETURN G_GAME.KEY_RALT
        CASE "Escape"
            RETURN G_GAME.KEY_ESCAPE
        CASE "Return", "Keypad Enter"
            RETURN G_GAME.KEY_ENTER
        CASE "Tab"
            RETURN G_GAME.KEY_TAB
        CASE "Backspace"
            RETURN M_MENU.KEY_BACKSPACE
        CASE "Space"
            RETURN 32
        CASE "Pause"
            RETURN G_GAME.KEY_PAUSE
        CASE "F1"
            RETURN M_MENU.KEY_F1
        CASE "F2"
            RETURN M_MENU.KEY_F2
        CASE "F3"
            RETURN M_MENU.KEY_F3
        CASE "F4"
            RETURN M_MENU.KEY_F4
        CASE "F6"
            RETURN M_MENU.KEY_F6
        CASE "F7"
            RETURN M_MENU.KEY_F7
        CASE "F9"
            RETURN M_MENU.KEY_F9
        CASE "F5"
            RETURN M_MENU.KEY_F5
        CASE "F8"
            RETURN M_MENU.KEY_F8
        CASE "F10"
            RETURN M_MENU.KEY_F10
        CASE "F11"
            RETURN M_MENU.KEY_F11
    ENDSWITCH
    ' Letters, digits and signs are their character codes.
    IF keycode >= 32 AND keycode < 127 THEN RETURN keycode
    RETURN -1
ENDFUNC

' W, A, S and D stand in for the arrow and the step keys while a level is
' played; the letters themselves still reach the game, for the cheats.
SUB MoveKey(key AS INTEGER, down AS INTEGER)
    IF DOOMSTAT.menuactive <> 0 OR DOOMSTAT.gamestate <> DOOMSTAT.GS_LEVEL THEN RETURN
    IF key = 119 THEN G_GAME.gamekeydown[G_GAME.KEY_UPARROW] = down
    IF key = 115 THEN G_GAME.gamekeydown[G_GAME.KEY_DOWNARROW] = down
    IF key = 97 THEN G_GAME.gamekeydown[44] = down
    IF key = 100 THEN G_GAME.gamekeydown[46] = down
ENDSUB

DIM alt_down AS INTEGER = 0

' TRUE for one of the two Alt keys.
FUNC IsAlt(key_name$ AS STRING) AS INTEGER
    IF key_name$ = "Left Alt" OR key_name$ = "Right Alt" THEN RETURN 1
    RETURN 0
ENDFUNC

SUB HandleKeyDown(key_data)
    IF key_data[0]{"repeat"} THEN RETURN
    DIM key_name$ AS STRING = key_data[0]{"key"}
    IF IsAlt(key_name$) <> 0 THEN alt_down = 1
    IF alt_down <> 0 AND (key_name$ = "Return" OR key_name$ = "Keypad Enter") THEN
        I_VIDEO.I_ToggleFullscreen()
        RETURN
    ENDIF
    DIM key AS INTEGER = DoomKey(key_data[0]{"key"}, CLNG(key_data[0]{"keycode"}))
    IF key < 0 THEN RETURN
    D_MAIN.D_PostEvent(G_GAME.EV_KEYDOWN, key, 0, 0)
    MoveKey(key, 1)
ENDSUB

SUB HandleKeyUp(key_data)
    IF IsAlt(key_data[0]{"key"}) <> 0 THEN alt_down = 0
    DIM key AS INTEGER = DoomKey(key_data[0]{"key"}, CLNG(key_data[0]{"keycode"}))
    IF key < 0 THEN RETURN
    D_MAIN.D_PostEvent(G_GAME.EV_KEYUP, key, 0, 0)
    MoveKey(key, 0)
ENDSUB

' Where the pointer is and which buttons are down (1 left, 2 right,
' 4 middle), and what the game was told last.
DIM mouse_x AS INTEGER = 0
DIM mouse_y AS INTEGER = 0
DIM mouse_buttons AS INTEGER = 0
DIM mouse_seen AS INTEGER = 0
DIM mouse_lastx AS INTEGER = 0
DIM mouse_lasty AS INTEGER = 0
DIM mouse_lastbuttons AS INTEGER = 0

SUB MouseAt(x AS INTEGER, y AS INTEGER)
    mouse_x = x
    mouse_y = y
    IF mouse_seen = 0 THEN
        mouse_lastx = x
        mouse_lasty = y
        mouse_seen = 1
    ENDIF
ENDSUB

' The bit of DOOM for a button of the window: left, middle, right.
FUNC ButtonBit(button AS INTEGER) AS INTEGER
    IF button = 1 THEN RETURN 1
    IF button = 3 THEN RETURN 2
    IF button = 2 THEN RETURN 4
    RETURN 0
ENDFUNC

SUB HandleMouseMove(mouse_data)
    MouseAt(CLNG(mouse_data[0]{"x"}), CLNG(mouse_data[0]{"y"}))
ENDSUB

SUB HandleMouseDown(mouse_data)
    MouseAt(CLNG(mouse_data[0]{"x"}), CLNG(mouse_data[0]{"y"}))
    mouse_buttons = mouse_buttons BOR ButtonBit(CLNG(mouse_data[0]{"button"}))
ENDSUB

SUB HandleMouseUp(mouse_data)
    MouseAt(CLNG(mouse_data[0]{"x"}), CLNG(mouse_data[0]{"y"}))
    mouse_buttons = mouse_buttons BAND (BNOT ButtonBit(CLNG(mouse_data[0]{"button"})))
ENDSUB

' Tells the game how the mouse moved since the last tic and which of its
' buttons are down; up the screen is forward.
SUB PostMouse()
    IF M_MISC.usemouse = 0 OR mouse_seen = 0 THEN RETURN
    IF mouse_x = mouse_lastx AND mouse_y = mouse_lasty AND mouse_buttons = mouse_lastbuttons THEN RETURN
    D_MAIN.D_PostEvent(G_GAME.EV_MOUSE, mouse_buttons, (mouse_x - mouse_lastx) * 4, (mouse_lasty - mouse_y) * 4)
    mouse_lastx = mouse_x
    mouse_lasty = mouse_y
    mouse_lastbuttons = mouse_buttons
ENDSUB

DIM cmd_args AS ARRAY = OS.ARGS()
DIM start_windowed AS INTEGER = 0
IF LEN(cmd_args) > 1 ANDALSO LCASE$(cmd_args[1]) = "-window" THEN
    start_windowed = 1
    cmd_args = APPEND(TAKE(1, cmd_args), DROP(2, cmd_args))
ENDIF
IF LEN(cmd_args) > 2 ANDALSO LCASE$(cmd_args[1]) = "-iwad" THEN
    D_MAIN.wadfile$ = cmd_args[2]
    cmd_args = APPEND(TAKE(1, cmd_args), DROP(3, cmd_args))
ENDIF
DIM start_episode AS INTEGER = 0
DIM start_map AS INTEGER = 1
DIM start_skill AS INTEGER = DOOMDEF.SK_MEDIUM
IF LEN(cmd_args) > 2 THEN
    start_episode = CLNG(VAL(cmd_args[1]))
    start_map = CLNG(VAL(cmd_args[2]))
ENDIF
IF LEN(cmd_args) > 3 THEN start_skill = CLNG(VAL(cmd_args[3]))

M_MISC.M_LoadDefaults()
I_VIDEO.I_InitGraphics(I_VIDEO.I_DisplayScale())
IF start_windowed = 0 THEN I_VIDEO.I_ToggleFullscreen()
D_MAIN.D_DoomMain()
S_SOUND.S_Init(S_SOUND.snd_SfxVolume, S_SOUND.snd_MusicVolume)
ON "QUIT" CALL HandleQuit@
ON "KEYDOWN" CALL HandleKeyDown@
ON "KEYUP" CALL HandleKeyUp@
ON "MOUSEMOVE" CALL HandleMouseMove@
ON "MOUSEDOWN" CALL HandleMouseDown@
ON "MOUSEUP" CALL HandleMouseUp@

IF start_episode > 0 THEN
    G_GAME.G_DeferedInitNew(start_skill, start_episode, start_map)
ELSE
    D_MAIN.D_StartTitle()
ENDIF

DIM tic_start AS DOUBLE

DO WHILE running = 1 AND M_MENU.quit_requested = 0
    tic_start = TICK()

    ' Process one tic.
    PostMouse()
    D_MAIN.D_ProcessEvents()
    G_GAME.G_BuildTiccmd()
    IF DOOMSTAT.advancedemo <> 0 THEN D_MAIN.D_DoAdvanceDemo()
    M_MENU.M_Ticker()
    G_GAME.G_Ticker()

    ' Move positional sounds.
    S_SOUND.S_UpdateSounds(CLNG(D_PLAYER.player_mo[DOOMSTAT.consoleplayer]))

    ' Update display, next frame, with current state.
    D_MAIN.D_Display()

    ' One tic lasts a 35th of a second.
    DO WHILE TICK() - tic_start < 1000.0 / 35.0
        SLEEP 1
    LOOP
LOOP

M_MISC.M_SaveDefaults()
I_VIDEO.I_ShutdownGraphics()
