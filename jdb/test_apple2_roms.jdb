' Smoke-test ROM loading. No CPU run yet — just verify the bytes
' arrive at the right addresses.

IMPORT APPLE2

DIM tests_pass = 0
DIM tests_fail = 0

SUB ASSERT(cond, label$)
    IF cond THEN
        tests_pass = tests_pass + 1
        PRINT "  PASS  " + label$
    ELSE
        tests_fail = tests_fail + 1
        PRINT "  FAIL  " + label$
    ENDIF
ENDSUB

PRINT
PRINT "── Loading Apple II ROM set ──"
APPLE2.INIT()
DIM total = APPLE2.LOAD_APPLE2_ROMS("thingsforyou")
PRINT "  Loaded " + STR$(total) + " bytes"

ASSERT(total = 10240, "10 KB total (5 ROM banks * 2 KB)")

' Reset vector at $FFFC/$FFFD points at the Monitor cold-start.
DIM rst_lo = CPU6502.READ($FFFC)
DIM rst_hi = CPU6502.READ($FFFD)
DIM rst_pc = rst_lo BOR (rst_hi SHL 8)
PRINT "  Reset vector = $" + HEX$(rst_pc)
ASSERT(rst_pc >= $F800 AND rst_pc <= $FFFF, "Reset vector lands in Monitor ROM page")

' Spot-check known bytes — Monitor ROM page boundary.
ASSERT(CPU6502.READ($F800) <> 0, "Monitor ROM at $F800 is non-zero")
ASSERT(CPU6502.READ($FFFF) <> 0, "Monitor ROM end ($FFFF) is non-zero")
ASSERT(CPU6502.READ($E000) <> 0, "Integer BASIC at $E000 is non-zero")

' Character ROM into side buffer.
PRINT
PRINT "── Loading character ROM ──"
DIM char_n = APPLE2.LOAD_CHAR_ROM("thingsforyou/Apple II Character ROM - 341-0036.bin")
PRINT "  Char ROM = " + STR$(char_n) + " bytes"
ASSERT(char_n = 2048, "Character ROM is 2048 bytes")

' Glyph rows of 'A' ($C1 in Apple II text encoding, but the char ROM
' is indexed by the raw screen code which is just 'A' = $41 ANDed with $7F
' depending on the dump). Both lookups should give SOME non-zero data.
DIM row_top = APPLE2.CHAR_GLYPH_ROW(ASC("A"), 0)
DIM row_mid = APPLE2.CHAR_GLYPH_ROW(ASC("A"), 3)
PRINT "  'A' row 0 = $" + HEX$(row_top) + ", row 3 = $" + HEX$(row_mid)
ASSERT(row_top <> 0 OR row_mid <> 0, "'A' glyph has non-empty rows")

PRINT
PRINT "════════════════════════════════════"
PRINT "  ROM-load test: PASS = " + STR$(tests_pass) + ", FAIL = " + STR$(tests_fail)
PRINT "════════════════════════════════════"
