' =========================================================
' capture_demo.jdb - screen / window capture via the built-in OS.SCREENSHOT.
'
'   OS.SCREENSHOT(path$, [mode$], [caption$]) -> INTEGER   (0 = ok, <0 = error)
'     mode$    : "screen" (default) | "window" (frame) | "client" (content only)
'     caption$ : optional FindWindow title; empty => the foreground window
'     format   : chosen from the file extension (.png .jpg .bmp .tif .gif)
'
' Windows only. No external bridge/DLL needed - OS.SCREENSHOT is a core
' builtin (GDI capture + WIC encode).
' =========================================================

IF OS.GETOS$() <> "WINDOWS" THEN
    PRINT "OS.SCREENSHOT is Windows-only."
    END
ENDIF

DIM dir$ = PWD()

PRINT "jdBasic Screenshot Demo (OS.SCREENSHOT)"
PRINT "======================================="

' 1) FULL SCREEN -> PNG
PRINT "[1] Full (virtual) desktop -> shot_fullscreen.png ..."
DIM rc1 = OS.SCREENSHOT(PATH.JOIN$(dir$, "shot_fullscreen.png"))
PRINT "    rc=" + STR$(rc1)

' 2) FOREGROUND WINDOW including its frame -> JPG
PRINT "[2] Foreground window (frame) -> shot_window.jpg ..."
DIM rc2 = OS.SCREENSHOT(PATH.JOIN$(dir$, "shot_window.jpg"), "window")
PRINT "    rc=" + STR$(rc2)

' 3) A NAMED WINDOW's CLIENT AREA (content only) -> BMP.
'    Change "Calculator" to a window that is open right now.
PRINT "[3] Client area of 'Calculator' -> shot_client.bmp ..."
DIM rc3 = OS.SCREENSHOT(PATH.JOIN$(dir$, "shot_client.bmp"), "client", "Calculator")
IF rc3 = 0 THEN
    PRINT "    rc=0"
ELSE
    PRINT "    skipped (window not found): rc=" + STR$(rc3)
ENDIF

PRINT "Done."
