' emu_run.jdb — graphical front-end for the 6502 emulator.
'
' Two modes (pick by setting MODE$ below):
'   "demo" — load a tiny 6502 program that paints HELLO into the text
'            page. Runs in milliseconds, proves the whole stack
'            (CPU + bus hooks + Apple II text-page layout + render).
'   "boot" — load Atomi's original Apple II ROMs and let the CPU run
'            until you press ESC. Slow (~760 cyc/sec on this machine),
'            so reaching the ">" prompt takes minutes — but it does
'            advance, and you can see the text page update live.
'
' Controls (boot mode): any printable key → keyboard buffer; ESC quits.

IMPORT APPLE2

CD "D:\usr\dev\cc\jdb"

' ─── Host-side IO dispatch ─────────────────────────────────────
' The CPU's bus_read / bus_write call IO_READ / IO_WRITE by name when
' an access falls in the configured soft-switch range — we forward to
' the platform module. Funcref-via-module-state would be more elegant
' but the native compiler can't lower indirect calls today.
FUNC IO_READ(addr)
    RETURN APPLE2.IO_READ_DISPATCH(addr)
ENDFUNC

SUB IO_WRITE(addr, val)
    APPLE2.IO_WRITE_DISPATCH(addr, val)
ENDSUB

' ─── Configuration ─────────────────────────────────────────────
DIM MODE$ = "applesoft"      ' "demo" | "boot" | "applesoft"

' Frame budget. The interpreter manages ~760 cyc/sec on this machine,
' so 1500 cyc/frame would block the UI for >2 sec; native does >100M
' cyc/sec, so we can afford a much fatter slice and still hit 60 fps.
DIM CYCLES_PER_FRAME = 1500
IF OS.FEATURE("NATIVEC") THEN CYCLES_PER_FRAME = 50000
OPTION "NOPAUSE"        ' Skip the per-iteration ESC/Space break check.

' ─── Initialise emulator + load program/ROM ────────────────────
APPLE2.INIT()
DIM char_rom$ = ""

IF MODE$ = "demo" THEN
    PRINT "Mode: demo (HELLO splash)"
    ' Tiny 6502 program at $0300 that writes "HELLO  WORLD" to the
    ' top-left corner of the text page, then loops on itself.
    DIM msg = [ $C8, $C5, $CC, $CC, $CF, $A0, $A0, $D7, $CF, $D2, $CC, $C4 ]
    DIM prog = [ $A2, $00, $BD, $40, $03, $9D, $00, $04, $E8, $E0, $0C, $D0, $F5, $4C, $0D, $03 ]
    '   $0300: LDX #$00          A2 00
    '   $0302: LDA $0340,X       BD 40 03
    '   $0305: STA $0400,X       9D 00 04
    '   $0308: INX               E8
    '   $0309: CPX #$0C          E0 0C
    '   $030B: BNE $0302         D0 F5
    '   $030D: JMP $030D         4C 0D 03
    CPU6502.LOAD($0300, prog)
    CPU6502.LOAD($0340, msg)
    CPU6502.SET_PC($0300)
ELSEIF MODE$ = "applesoft" THEN
    PRINT "Mode: applesoft (Apple II+ ROM set — Applesoft + AutoStart)"
    DIM rom_n = APPLE2.LOAD_APPLE2P_ROMS("thingsforyou")
    IF rom_n <= 0 THEN
        PRINT "ROM load failed — make sure the Apple II+ ROMs (341-001x, 341-0020) are in thingsforyou/."
        END
    ENDIF
    char_rom$ = APPLE2.LOAD_CHAR_ROM$("thingsforyou/Apple II Character ROM - 341-0036.bin")
    APPLE2.INIT_GLYPH_CACHE(char_rom$)
    APPLE2.INSTALL_TAPE_HOOKS()
    CPU6502.RESET()
    PRINT "ROMs loaded (" + STR$(rom_n) + " bytes), reset to $" + HEX$(CPU6502.GET_PC())
    PRINT "Cassette LOAD/SAVE goes through: " + APPLE2.GET_TAPE_PATH$()
ELSE
    PRINT "Mode: boot (loading Apple II ROMs from thingsforyou/)"
    DIM rom_n = APPLE2.LOAD_APPLE2_ROMS("thingsforyou")
    IF rom_n <= 0 THEN
        PRINT "ROM load failed — make sure thingsforyou/ contains the dumps."
        END
    ENDIF
    char_rom$ = APPLE2.LOAD_CHAR_ROM$("thingsforyou/Apple II Character ROM - 341-0036.bin")
    APPLE2.INIT_GLYPH_CACHE(char_rom$)
    APPLE2.INSTALL_TAPE_HOOKS()
    CPU6502.RESET()
    PRINT "ROMs loaded (" + STR$(rom_n) + " bytes), reset to $" + HEX$(CPU6502.GET_PC())
    PRINT "Cassette LOAD/SAVE goes through: " + APPLE2.GET_TAPE_PATH$()
ENDIF

DIM running = 1
DIM frame_count = 0

' ─── Keyboard via ON handler (same as gui_sql.jdb) ─────────────
'
' GFX.POLLEVENT runs through the ImGui-capture filter. The
' ON "KEYDOWN" path receives events from the VM's event_poll() which
' drains a shared queue that SCREENFLIP populates — works reliably
' in interpreter mode.
'
' Translate one SDL keycode (raw, no shift applied yet) into the ASCII
' byte the Apple II expects. Honours the German QWERTZ layout: SDL
' returns the *unshifted* symbol on the key cap, so we have to shift
' it manually for things like  Shift-1 → "!"  or  Shift-ß → "?".
FUNC german_to_appleii(kc, shift)
    ' Shifted variants on a German QWERTZ keyboard — most of the
    ' punctuation the Apple II actually cares about lives here.
    ' SDL returns the *unshifted* keycap symbol; we shift it manually.
    IF shift THEN
        SWITCH kc
            CASE ASC("1") : RETURN ASC("!")
            CASE ASC("2") : RETURN ASC(CHR$(34))     ' "
            CASE ASC("3") : RETURN ASC("#")          ' shift-3 prints § on DE; map to # for Apple II
            CASE ASC("4") : RETURN ASC("$")
            CASE ASC("5") : RETURN ASC("%")
            CASE ASC("6") : RETURN ASC("&")
            CASE ASC("7") : RETURN ASC("/")
            CASE ASC("8") : RETURN ASC("(")
            CASE ASC("9") : RETURN ASC(")")
            CASE ASC("0") : RETURN ASC("=")
            CASE ASC("+") : RETURN ASC("*")          ' DE: + key shifts to *
            CASE ASC(",") : RETURN ASC(";")
            CASE ASC(".") : RETURN ASC(":")
            CASE ASC("-") : RETURN ASC("_")
            CASE ASC("<") : RETURN ASC(">")          ' DE has a separate < > key left of Y
            CASE 223      : RETURN ASC("?")          ' shift-ß (DE) → ?
            CASE ASC("'") : RETURN ASC(CHR$(34))     ' shift-' → "
        ENDSWITCH
    ENDIF
    ' Unshifted German keys we want to forward as-is.
    IF kc = 223 THEN RETURN ASC(CHR$(39))            ' ß → '
    ' Letters: Apple II is uppercase-only.
    IF kc >= ASC("a") AND kc <= ASC("z") THEN RETURN kc - 32
    RETURN kc
ENDFUNC

' SDL3 keycodes for the four arrow keys (SDLK_xxx = scancode | $40000000).
DIM SDLK_RIGHT = $4000004F
DIM SDLK_LEFT  = $40000050
DIM SDLK_DOWN  = $40000051
DIM SDLK_UP    = $40000052

SUB HandleKey(KeyData)
    DIM kc = KeyData[0]{"keycode"}
    DIM shift = GFX.KEYSTATE("Left Shift") OR GFX.KEYSTATE("Right Shift")
    DIM ctrl = GFX.KEYSTATE("Left Ctrl") OR GFX.KEYSTATE("Right Ctrl")
    IF ctrl AND kc = ASC("v") THEN
        APPLE2.ARM_PASTE(CLIPBOARD.GET$())
    ELSEIF ctrl AND kc >= ASC("a") AND kc <= ASC("z") THEN
        ' Ctrl+letter → ASCII control code. CTRL+G=$07 BELL,
        ' CTRL+H=$08 BS, CTRL+M=$0D CR, CTRL+J=$0A LF, etc.
        APPLE2.PUSH_KEY(kc - 96)
    ELSEIF kc = SDLK_LEFT THEN
        APPLE2.PUSH_KEY($08)              ' Apple II left = CTRL-H
    ELSEIF kc = SDLK_RIGHT THEN
        APPLE2.PUSH_KEY($15)              ' Apple II right = CTRL-U
    ELSEIF kc = SDLK_UP THEN
        APPLE2.PUSH_KEY($0B)              ' Apple II up = CTRL-K
    ELSEIF kc = SDLK_DOWN THEN
        APPLE2.PUSH_KEY($0A)              ' Apple II down = CTRL-J
    ELSEIF kc = 27 THEN
        running = 0
    ELSEIF kc = 13 THEN
        APPLE2.PUSH_KEY($0D)
    ELSEIF kc = 8 THEN
        APPLE2.PUSH_KEY($08)
    ELSE
        DIM out = german_to_appleii(kc, shift)
        IF out >= 32 AND out < 128 THEN
            APPLE2.PUSH_KEY(out)
        ENDIF
    ENDIF
ENDSUB

SUB HandleQuit(QuitData)
    running = 0
ENDSUB

ON "KEYDOWN" CALL HandleKey
ON "QUIT"    CALL HandleQuit

' ─── Open the SCREEN window ───────────────────────────────────
' Order matters: SCREEN before SETFONT — SDL_ttf needs the SDL
' renderer to exist before TTF_OpenFont, otherwise it can crash on
' some drivers.
SCREEN APPLE2.WINDOW_W, APPLE2.WINDOW_H, "jdBasic 6502 / Apple II", 2
SETFONT "C:/Windows/Fonts/consola.ttf", 14
'TOGGLE_FULLSCREEN
' Speaker emulation — must come after SCREEN so SDL audio can attach
' to the same default device.
APPLE2.ARM_AUDIO()

DO
    ' Capture cycle count, run CPU for one frame, then flush any
    ' speaker toggles that happened during this frame to the PCM
    ' stream. Order matters: BEGIN before RUN, END after RUN.
    APPLE2.AUDIO_FRAME_BEGIN()
    CPU6502.RUN(CYCLES_PER_FRAME)
    APPLE2.AUDIO_FRAME_END()

    ' Closing the window dispatches ON "QUIT" → running=0. SCREEN has
    ' already been torn down; skip the paint to avoid TEXT-no-screen.
    IF running = 1 THEN
        CLS 0, 0, 0
        APPLE2.RENDER_FRAME(char_rom$)
        SCREENFLIP
    ENDIF
    frame_count = frame_count + 1
LOOP WHILE running = 1

PRINT "Done. " + STR$(frame_count) + " frames. PC=$" + HEX$(CPU6502.GET_PC()) + " A=$" + HEX$(CPU6502.GET_A())
