PRINT "Nested Foor Test"

FUNC LALL(A)
    PRINT "A: "; A
    FOR I = 1 TO 3
        PRINT "Inner I: ";I
    NEXT I
    RETURN  A*I
ENDFUNC

FOR I = 1 TO 10
    PRINT "Outer I: "; I
    PRINT "LALL: "; LALL(I)
NEXT i

K = -1

FOR I = 0 to K STEP 1
    Print "This should never happens!"; i
NEXT i

Print "Ausgeflupped"
