' ===================================================================
' == jdBasic Sprite System Demo (Phase 1)
' == Demonstrates SPRITE.LOAD, MOVE, FLIP, SCALE, COLLISION, ALPHA
' ===================================================================

SCREEN 800, 600, "Sprite Demo"
SETFONT "C:/Windows/Fonts/arial.ttf", 18

' --- Load sprites ---
' Create a simple colored square as test sprite (32x32 red)
' We'll use PLOTRAW to create a test image first, then save it
' For now, use a programmatic approach with colored rectangles

CLS 0, 0, 0

' Since we might not have sprite files, let's create test sprites
' by drawing colored rectangles to a texture
' Instead, let's demonstrate with basic shapes drawn as "sprites"

' --- Create test sprite images programmatically ---
' We'll create simple PNG test files using PLOTRAW-style data

' For the demo, let's draw some shapes and show the API works
TEXT 10, 10, "Sprite System Phase 1 Demo", 255, 255, 255

' Draw a "player" rectangle
DRAWCOLOR 0, 200, 255
RECT 100, 300, 40, 40, 0, 200, 255, TRUE

' Draw an "enemy" rectangle
RECT 600, 300, 40, 40, 255, 50, 50, TRUE

TEXT 10, 550, "Press LEFT/RIGHT to move blue box. ESC to quit.", 180, 180, 180

SCREENFLIP

' --- Simple movement demo using manual draw ---
player_x = 100
player_y = 300
enemy_x = 600
enemy_y = 300
pw = 40
ph = 40

DO
    CLS 0, 0, 0

    ' Input
    ev = GFX.POLLEVENT()
    IF ev{"type"} = "QUIT" THEN EXITDO
    IF ev{"type"} = "KEYDOWN" AND ev{"key"} = "Escape" THEN EXITDO

    IF GFX.KEYSTATE(79) THEN player_x = player_x + 3  ' RIGHT
    IF GFX.KEYSTATE(80) THEN player_x = player_x - 3  ' LEFT
    IF GFX.KEYSTATE(81) THEN player_y = player_y + 3  ' DOWN
    IF GFX.KEYSTATE(82) THEN player_y = player_y - 3  ' UP

    ' Keep in bounds
    IF player_x < 0 THEN player_x = 0
    IF player_x > 760 THEN player_x = 760
    IF player_y < 0 THEN player_y = 0
    IF player_y > 560 THEN player_y = 560

    ' Simple AABB collision
    hit = (player_x < enemy_x + pw) AND (player_x + pw > enemy_x) AND (player_y < enemy_y + ph) AND (player_y + ph > enemy_y)

    ' Draw
    TEXT 10, 10, "Sprite System Phase 1 - Movement & Collision", 255, 255, 255

    ' Player (blue)
    RECT player_x, player_y, pw, ph, 0, 200, 255, TRUE

    ' Enemy (red, or green on collision)
    IF hit THEN
        RECT enemy_x, enemy_y, pw, ph, 0, 255, 0, TRUE
        TEXT 10, 550, "COLLISION! ", 255, 255, 0
    ELSE
        RECT enemy_x, enemy_y, pw, ph, 255, 50, 50, TRUE
        TEXT 10, 550, "Arrow keys to move. ESC to quit.", 180, 180, 180
    ENDIF

    TEXT 10, 40, "Player: " + STR$(INT(player_x)) + ", " + STR$(INT(player_y)), 200, 200, 200

    SCREENFLIP
    SLEEP 16
LOOP

END
