' deusexmachina / persist - SQLite event log + RAG hook.
'
' Storage runs on the built-in SQL.* natives (SQLITE build flag).
' The RAG layer is optional and attached via init_rag - tests that
' load no LLM skip the hook and only exercise the SQL functions.
'
' SQL string escaping is primitive (single-quote doubling). External
' input paths get parameterisation when the SQL.* natives grow bind
' support.

EXPORT MODULE PERSIST

DIM g_db = 0
DIM g_rag = 0
DIM g_llm_id = 0

' ── Lifecycle ────────────────────────────────────────────────────

EXPORT SUB init_db(path$)
    IF g_db = 0 THEN
        g_db = SQL.OPEN(path$)
        IF g_db = 0 THEN
            THROW "PERSIST.init_db: SQL.OPEN failed: " + SQL.ERRMSG$(0)
        ENDIF
        DIM rc = SQL.EXEC(g_db, _
            "CREATE TABLE IF NOT EXISTS events (" + _
            "  id INTEGER PRIMARY KEY AUTOINCREMENT," + _
            "  ts INTEGER," + _
            "  topic TEXT," + _
            "  payload TEXT)")
        IF rc < 0 THEN
            THROW "PERSIST.init_db: schema failed: " + SQL.ERRMSG$(g_db)
        ENDIF
    ENDIF
ENDSUB

EXPORT FUNC is_open() AS BOOLEAN
    RETURN g_db <> 0
ENDFUNC

EXPORT SUB close()
    IF g_db <> 0 THEN
        DIM rc = SQL.CLOSE(g_db)
        g_db = 0
    ENDIF
    g_rag = 0
ENDSUB

' ── Event log ────────────────────────────────────────────────────

EXPORT SUB log_event(topic$, payload$)
    ' Wallclock epoch seconds - comparable across runs and hosts.
    DIM ts = INT(NOW_EPOCH())
    DIM tp$ = REPLACE$(topic$, "'", "''")
    DIM pl$ = REPLACE$(payload$, "'", "''")
    DIM rc = SQL.EXEC(g_db, _
        "INSERT INTO events (ts, topic, payload) VALUES (" + _
        STR$(ts) + ", '" + tp$ + "', '" + pl$ + "')")
    IF rc < 0 THEN
        THROW "PERSIST.log_event failed: " + SQL.ERRMSG$(g_db)
    ENDIF
ENDSUB

EXPORT FUNC recent_events(n AS INTEGER) AS ARRAY
    RETURN SQL.QUERY(g_db, _
        "SELECT id, ts, topic, payload FROM events " + _
        "ORDER BY id LIMIT " + STR$(n))
ENDFUNC

EXPORT FUNC events_by_topic(topic$, n AS INTEGER) AS ARRAY
    DIM tp$ = REPLACE$(topic$, "'", "''")
    RETURN SQL.QUERY(g_db, _
        "SELECT id, ts, topic, payload FROM events " + _
        "WHERE topic = '" + tp$ + "' " + _
        "ORDER BY id LIMIT " + STR$(n))
ENDFUNC

' ── Generic exec / query passthrough ─────────────────────────────

EXPORT FUNC exec(sql$) AS INTEGER
    DIM rc = SQL.EXEC(g_db, sql$)
    IF rc < 0 THEN
        THROW "PERSIST.exec failed: " + SQL.ERRMSG$(g_db) + " - SQL: " + sql$
    ENDIF
    RETURN rc
ENDFUNC

EXPORT FUNC query(sql$) AS ARRAY
    RETURN SQL.QUERY(g_db, sql$)
ENDFUNC

' ── Optional RAG layer ───────────────────────────────────────────
' Pass an existing AI.LOAD_LLM id (or AI.LOAD_EMBEDDINGS id used
' purely for embeddings). Without init_rag the remember/recall
' functions throw - callers should check rag_ready() first.

EXPORT SUB init_rag(llm_id AS INTEGER)
    g_llm_id = llm_id
    g_rag = AI.RAG_CREATE(llm_id)
ENDSUB

EXPORT FUNC rag_ready() AS BOOLEAN
    RETURN g_rag <> 0
ENDFUNC

EXPORT SUB remember(text$, source$)
    IF g_rag = 0 THEN
        THROW "PERSIST.remember: RAG not initialised - call init_rag first"
    ENDIF
    DIM rc = AI.RAG_ADD(g_rag, text$, source$)
ENDSUB

EXPORT FUNC recall(query$, top_k AS INTEGER) AS ARRAY
    IF g_rag = 0 THEN
        THROW "PERSIST.recall: RAG not initialised - call init_rag first"
    ENDIF
    RETURN AI.RAG_SEARCH(g_rag, query$, top_k)
ENDFUNC
