' deusexmachina / tools - handler FUNCs for the MCP tools.
'
' Each FUNC receives the args as a JSON string from the MCP dispatcher
' and returns a string (rendered as the tool output). Schema validation
' lives in the .json manifests and is done by the MCP layer already -
' only the logic lives here.

EXPORT MODULE TOOLS

' deus_echo - connectivity smoke test, parses args, returns the message.
EXPORT FUNC tool_echo(args_json$) AS STRING
    DIM args = JSON.PARSE$(args_json$)
    DIM msg$ = "(no message)"
    IF MAP.EXISTS(args, "message") THEN msg$ = args{"message"}
    RETURN "echo from deusexmachina: " + msg$
ENDFUNC

' deus_health - compact runtime status. No args.
EXPORT FUNC tool_health(args_json$) AS STRING
    DIM out AS MAP
    out{"server"} = "deusexmachina"
    out{"phase"} = "A"
    out{"sprint"} = 4
    out{"build"} = "GFX IMGUI NATIVEC LLM ONNX HTTP MCPSERVER SQLITE"
    out{"tick_ms"} = TICK()
    RETURN JSON.STRINGIFY$(out)
ENDFUNC

' deus_now - current timestamp + locale.
EXPORT FUNC tool_now(args_json$) AS STRING
    DIM out AS MAP
    out{"date"} = DATE$()
    out{"time"} = TIME$()
    out{"epoch"} = INT(NOW_EPOCH())
    out{"tick_ms"} = TICK()
    RETURN JSON.STRINGIFY$(out)
ENDFUNC
