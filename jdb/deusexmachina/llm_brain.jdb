' deusexmachina / llm_brain - wrapper around the LLM layer.
'
' Hosts a loaded local LLM session and offers four call styles:
'   * ask(id, prompt)             - synchronous, full answer
'   * ask_streaming(id, prompt)   - channel with token stream (for UIs)
'   * ask_rag(id, rag, q, k)      - RAG-augmented synchronous
'   * ask_remote(url, model, ...) - OpenAI-compatible HTTP backend
'
' The channel path uses AI.CHAT_TOKENS - producer is the LLM generation
' thread, the consumer can stream live into Telegram, ImGui or TTS.

EXPORT MODULE LLM_BRAIN

DIM g_llm_id = 0           ' current main session
DIM g_model_path AS STRING = ""

' ── Lifecycle ───────────────────────────────────────────────────

EXPORT FUNC init(model_path$, n_ctx AS INTEGER, n_gpu_layers AS INTEGER) AS INTEGER
    g_model_path = model_path$
    g_llm_id = AI.LOAD_LLM(model_path$, n_ctx, n_gpu_layers)
    DIM rc = AI.SET(g_llm_id, "TEMPERATURE", 0.7)
    rc = AI.SET(g_llm_id, "TOP_P", 0.95)
    rc = AI.SET(g_llm_id, "MAX_TOKENS", 512)
    RETURN g_llm_id
ENDFUNC

EXPORT SUB set_system(llm_id AS INTEGER, system$)
    DIM rc = AI.SET(llm_id, "SYSTEM", system$)
ENDSUB

EXPORT SUB set_temperature(llm_id AS INTEGER, t AS DOUBLE)
    DIM rc = AI.SET(llm_id, "TEMPERATURE", t)
ENDSUB

EXPORT SUB set_max_tokens(llm_id AS INTEGER, n AS INTEGER)
    DIM rc = AI.SET(llm_id, "MAX_TOKENS", n)
ENDSUB

EXPORT FUNC is_loaded() AS BOOLEAN
    RETURN g_llm_id <> 0
ENDFUNC

EXPORT SUB clear_history(llm_id AS INTEGER)
    DIM rc = AI.CLEAR_HISTORY(llm_id)
ENDSUB

EXPORT SUB free(llm_id AS INTEGER)
    DIM rc = AI.FREE_LLM(llm_id)
    IF llm_id = g_llm_id THEN
        g_llm_id = 0
    ENDIF
ENDSUB

' ── Synchronous ────────────────────────────────────────────────

EXPORT FUNC ask(llm_id AS INTEGER, prompt$) AS STRING
    RETURN AI.CHAT(llm_id, prompt$)
ENDFUNC

' ── Streaming via channel ──────────────────────────────────────
'
' Returns a CHAN handle. Consumers drain with:
'   FOR EACH tok$ IN ch
'     PRINT tok$;
'   NEXT
' Or explicitly:
'   DO
'     DIM t$ = CHAN.RECV(ch)
'     IF CHAN.IS_EOF(t$) THEN EXITDO
'     ...
'   LOOP
'
' Buffer capacity 64 is the default - it produces back-pressure on the
' LLM generation thread when the consumer is slower (Telegram rate
' limit, GUI render).

EXPORT FUNC ask_streaming(llm_id AS INTEGER, prompt$, capacity AS INTEGER) AS INTEGER
    RETURN AI.CHAT_TOKENS(llm_id, prompt$, capacity)
ENDFUNC

' ── RAG-augmented ───────────────────────────────────────────────
'
' Fetches top-k chunks from the RAG index and prefixes the prompt with
' the context. Synchronous - for streaming RAG call ask_streaming after
' the RAG lookup.

FUNC rag_prompt$(rag_id AS INTEGER, question$, top_k AS INTEGER) AS STRING
    DIM ctx = AI.RAG_SEARCH(rag_id, question$, top_k)
    DIM ctx_str$ = ""
    FOR EACH chunk IN ctx
        ctx_str$ = ctx_str$ + chunk{"text"} + CHR$(10) + "---" + CHR$(10)
    NEXT
    RETURN "Beantworte die Frage gestützt auf den folgenden Kontext. " + _
           "Wenn der Kontext nicht ausreicht, sag das ehrlich." + CHR$(10) + _
           CHR$(10) + "Kontext:" + CHR$(10) + ctx_str$ + _
           CHR$(10) + "Frage: " + question$
ENDFUNC

EXPORT FUNC ask_rag(llm_id AS INTEGER, rag_id AS INTEGER, question$, top_k AS INTEGER) AS STRING
    RETURN AI.CHAT(llm_id, rag_prompt$(rag_id, question$, top_k))
ENDFUNC

EXPORT FUNC ask_rag_streaming(llm_id AS INTEGER, rag_id AS INTEGER, question$, top_k AS INTEGER, capacity AS INTEGER) AS INTEGER
    RETURN AI.CHAT_TOKENS(llm_id, rag_prompt$(rag_id, question$, top_k), capacity)
ENDFUNC

' ── Remote backend (OpenAI-compatible chat/completions) ─────────
'
' Talks to any llama-server / vLLM / OpenAI-style endpoint. The JSON
' body goes through a temp file (curl -d @file) so prompt content never
' touches the shell. curl instead of HTTP.POST$ because generation
' regularly exceeds the built-in client's socket timeout.

EXPORT FUNC ask_remote(base_url$, model$, system$, prompt$, max_tokens AS INTEGER) AS STRING
    DIM messages = []
    IF LEN(system$) > 0 THEN
        messages = APPEND(messages, {"role": "system", "content": system$})
    ENDIF
    messages = APPEND(messages, {"role": "user", "content": prompt$})
    DIM body AS MAP
    body{"model"} = model$
    body{"messages"} = messages
    body{"max_tokens"} = max_tokens
    DIM body_file$ = MKTEMP$("deusllm")
    TXTWRITER body_file$, JSON.STRINGIFY$(body)
    DIM r = OS.EXEC("curl", ["-s", "-m", "300", _
        "-H", "Content-Type: application/json", _
        "-d", "@" + body_file$, _
        base_url$ + "/v1/chat/completions"])
    KILL body_file$
    IF r{"EXIT_CODE"} <> 0 THEN
        THROW "LLM_BRAIN.ask_remote: curl exit " + STR$(r{"EXIT_CODE"})
    ENDIF
    DIM resp = JSON.PARSE$(r{"OUTPUT"})
    IF TYPEOF(resp) <> "OBJECT" ORELSE NOT MAP.EXISTS(resp, "choices") THEN
        THROW "LLM_BRAIN.ask_remote: unexpected response: " + LEFT$(r{"OUTPUT"}, 200)
    ENDIF
    RETURN resp{"choices"}[0]{"message"}{"content"}
ENDFUNC
