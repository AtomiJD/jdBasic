' Wunschwelt world server: the kernel.
'
'   jdBasic jdb/wunschwelt/server.jdb [port] [seconds]
'
' The kernel holds the world, speaks HTTP, keeps the list of patches and
' carries questions to the language model. It knows no game rule. The game
' arrives as patches: jdBasic source whose top-level SUBs and FUNCs take the
' world as a parameter, so a later patch can define any of them again while
' players are connected. The files under game/ are the first patches, taken
' in the order of their names.
'
' A patch file has parts, each opened by a marker line:
'   '@server   rules, run here
'   '@client   code every client fetches and runs
'
' Entry points the kernel calls (a patch may redefine each):
'   RuleMakeWorld(w)                 once after the first patches
'   RuleWake(w)                      on every start, once the world is in place
'   RuleJoin(w, name$) -> player     a new or returning player
'   RuleSync(w, player, msg) -> map  one message of a client, the answer
'   RuleTick(w, now_ms)              every TICK_MS
'   RuleNpcPrompt(w, npc, player$, text$) -> messages for the model
'   RuleNpcReply(w, npc_id$, player$, text$)
'   RuleNpcFailed(w, npc_id$, player$)   the model gave no usable answer
'   RuleAnswer(w, kind$, data, text$)    the answer to a question a rule put with KAsk$
'   RuleAnswerFailed(w, kind$, data)     that question got no usable answer
'   RuleAdmin(w, name$, args) -> map     a call of the keeper of the world
'
' What rules may call here: KNow(), KEmit(w, event), KAskNpc(w, npc_id$, player$, text$),
' KAsk$(w, kind$, who$, data, messages, options).
'
' The server listens on the loopback address only; a web server in front of
' it is what the outside reaches. Patches are source code that runs here, so
' the patch entry is closed unless a key is set, and it is meant to be
' reached from the machine itself.
'
' Environment:
'   WW_PATCH_KEY   key a POST /patch must carry; empty = no patches over HTTP
'   WW_LLM_URL     chat completions URL; empty = NPCs answer a fixed line
'   WW_GAME_DIR    folder of the first patches (default: game/ beside this file)
'   WW_STATE_DIR   folder that keeps the world and the patches that came over
'                  HTTP across a restart; empty = every start is a fresh world
'
' HTTP (bodies are JSON sent as text/plain, so a browser needs no preflight):
'   POST /join  {"name", "pin"}             -> {"ok", "token", "version", "name"} or
'                                              {"ok": false, "error": name|pin|full|wrong_pin|locked}
'   POST /rule  {"key","name": "pin_reset","args": {"name"}}  frees a name
'   POST /sync  {"token", ...}              -> what RuleSync answers
'   GET  /code?since=N                      -> {"version", "patches": [client code]}
'   POST /patch {"key","title","server","client"} -> {"ok", "version"} or {"ok": false, "error"}
'   POST /rule  {"key","name","args"}           -> what RuleAdmin answers (needs the patch key)
'   GET  /stats

OPTION "EXPLICIT"

DIM TICK_MS AS INTEGER = 50
DIM MAX_EVENTS AS INTEGER = 200
DIM MAX_PLAYERS AS INTEGER = 40
' questions the model may hold at once, and the pause one player keeps between two
DIM MAX_PENDING AS INTEGER = 6
DIM ASK_PAUSE_MS AS INTEGER = 2500

DIM cli = OS.ARGS()
DIM port AS INTEGER = 8100
DIM run_seconds AS INTEGER = 0
IF LEN(cli) > 1 THEN port = VAL(cli[1])
IF LEN(cli) > 2 THEN run_seconds = VAL(cli[2])

DIM patch_key$ AS STRING = GETENV$("WW_PATCH_KEY")
DIM llm_url$ AS STRING = GETENV$("WW_LLM_URL")
DIM game_dir$ AS STRING = GETENV$("WW_GAME_DIR")
IF game_dir$ = "" THEN game_dir$ = PATH.DIRNAME$(cli[0]) + "/game"

DIM state_dir$ AS STRING = GETENV$("WW_STATE_DIR")
DIM SAVE_MS AS INTEGER = 3000

DIM nl$ AS STRING = CHR$(10)
DIM started_ms AS DOUBLE = TICK()

' The world. Everything a rule reads or writes is in here.
DIM W = {"players": {}, "tokens": {}, "npcs": {}, "map": {}, "events": [], "seq": 0, "version": 0, "patch_titles": [], "errors": 0, "last_error": "", "served": 0, "restarts": 0}
DIM client_patches = []
' code_ids[v] names the client code of the versions 1 to v, so a client can
' tell whether what it runs is what the server would hand out
DIM code_ids = [""]
' the patches that came over HTTP, as kept in the state folder: {"title", "server", "client"}
DIM stored = []
' Questions on their way to the model: {"task", "kind", "data", "asked"}
DIM pending = []
' when each player last asked the model
DIM last_ask = {}
' who owns a name: lower-case name -> {"name", "salt", "hash", "tries", "locked"}
DIM accounts = {}
DIM PIN_TRIES AS INTEGER = 5
DIM PIN_LOCK_MS AS INTEGER = 60000

' ---- services for rules ----

FUNC KNow()
    RETURN INT(TICK() - started_ms)
ENDFUNC

SUB KEmit(w, event)
    w{"seq"} = w{"seq"} + 1
    event{"seq"} = w{"seq"}
    DIM events = APPEND(w{"events"}, event)
    IF LEN(events) > MAX_EVENTS THEN events = DROP(LEN(events) - MAX_EVENTS, events)
    w{"events"} = events
ENDSUB

SUB KAskNpc(w, npc_id$ AS STRING, player$ AS STRING, text$ AS STRING)
    DIM npcs = w{"npcs"}
    IF NOT MAP.EXISTS(npcs, npc_id$) THEN RETURN
    IF KBusy("npc", player$) THEN RETURN
    DIM messages = RuleNpcPrompt(w, npcs{npc_id$}, player$, text$)
    IF llm_url$ = "" THEN
        last_ask{"npc " + player$} = KNow()
        RuleNpcReply(w, npc_id$, player$, "(" + npcs{npc_id$}{"name"} + " nickt dir freundlich zu.)")
        RETURN
    ENDIF
    DIM sent$ AS STRING = KAsk$(w, "npc", player$, {"npc": npc_id$, "player": player$}, messages, {"max_tokens": 90, "temperature": 0.7})
ENDSUB

' TRUE while the model has enough to do or this player asked a question of this kind a moment ago
FUNC KBusy(kind$ AS STRING, who$ AS STRING)
    RETURN LEN(pending) >= MAX_PENDING ORELSE KNow() - (last_ask{kind$ + " " + who$} ?? -ASK_PAUSE_MS) < ASK_PAUSE_MS
ENDFUNC

' Puts a question of the rules to the model. The answer comes back later
' through RuleAnswer(w, kind$, data, text$), a failure through
' RuleAnswerFailed(w, kind$, data); data is handed back as it was given.
' options are fields of the request such as max_tokens or temperature.
' Answers "sent", "busy" (asked too soon or the model is busy) or "none"
' (the server has no model).
FUNC KAsk$(w, kind$ AS STRING, who$ AS STRING, data, messages, options)
    IF llm_url$ = "" THEN RETURN "none"
    IF KBusy(kind$, who$) THEN RETURN "busy"
    last_ask{kind$ + " " + who$} = KNow()
    DIM request = {"model": "npc", "max_tokens": 90, "temperature": 0.7, "messages": messages}
    FOR EACH field$ IN MAP.KEYS(options)
        request{field$} = options{field$}
    NEXT
    DIM task = HTTP.POST_ASYNC(llm_url$, JSON.STRINGIFY$(request), "application/json")
    pending = APPEND(pending, {"task": task, "kind": kind$, "data": data, "asked": KNow()})
    RETURN "sent"
ENDFUNC

' A failure of a rule; a model that gives no usable answer is counted apart.
SUB KFail(what$ AS STRING, message$ AS STRING)
    IF what$ = "model" THEN
        W{"model_errors"} = (W{"model_errors"} ?? 0) + 1
    ELSE
        W{"errors"} = W{"errors"} + 1
    ENDIF
    W{"last_error"} = what$ + ": " + message$
ENDSUB

' ---- patches ----

' The parts of a patch file by their marker lines: {"server", "client"}
FUNC SplitPatch(source$ AS STRING)
    DIM parts = {"server": "", "client": ""}
    DIM part$ AS STRING = ""
    DIM rows = SPLIT(REPLACE$(source$, CHR$(13), ""), nl$)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(rows) - 1
        DIM mark$ AS STRING = TRIM$(rows[i])
        IF mark$ = "'@server" THEN
            part$ = "server"
        ELSEIF mark$ = "'@client" THEN
            part$ = "client"
        ELSEIF part$ <> "" THEN
            parts{part$} = parts{part$} + rows[i] + nl$
        ENDIF
    NEXT i
    RETURN parts
ENDFUNC

' Runs the server part and hands the client part to the clients; "" or the error
FUNC ApplyPatch$(title$ AS STRING, server_code$ AS STRING, client_code$ AS STRING)
    IF TRIM$(server_code$) <> "" THEN
        TRY
            EXECUTE server_code$
        CATCH
            RETURN ERRMSG$
        ENDTRY
    ENDIF
    client_patches = APPEND(client_patches, client_code$)
    W{"version"} = W{"version"} + 1
    W{"patch_titles"} = APPEND(W{"patch_titles"}, title$)
    code_ids = APPEND(code_ids, LEFT$(CODEC.SHA256$(code_ids[LEN(code_ids) - 1] + client_code$), 16))
    RETURN ""
ENDFUNC

' ---- the state folder ----

SUB WriteState(name$ AS STRING, text$ AS STRING)
    TXTWRITER state_dir$ + "/" + name$ + ".tmp", text$
    DIM moved = FILE.MOVE(state_dir$ + "/" + name$ + ".tmp", state_dir$ + "/" + name$, TRUE)
ENDSUB

SUB SaveWorld()
    IF state_dir$ = "" THEN RETURN
    TRY
        WriteState("world.json", JSON.STRINGIFY$({"clock": KNow(), "world": W}))
    CATCH
        KFail("save", ERRMSG$)
    ENDTRY
ENDSUB

SUB SavePatches()
    IF state_dir$ = "" THEN RETURN
    TRY
        WriteState("patches.json", JSON.STRINGIFY$({"patches": stored}))
    CATCH
        KFail("save", ERRMSG$)
    ENDTRY
ENDSUB

' Brings back what an earlier run left: its patches run again in their order,
' then the saved world takes the place of the fresh one and its clock goes on.
SUB LoadState()
    IF state_dir$ = "" THEN RETURN
    IF FILE.EXISTS(state_dir$ + "/patches.json") THEN
        DIM kept = []
        TRY
            DIM kept_file = JSON.PARSE(TXTREADER$(state_dir$ + "/patches.json"))
            IF NOT ISMAP(kept_file) ORELSE NOT MAP.EXISTS(kept_file, "patches") THEN THROW "not a patch list"
            kept = kept_file{"patches"}
        CATCH
            PRINT "the stored patches could not be read: "; ERRMSG$
            DIM put_aside = FILE.MOVE(state_dir$ + "/patches.json", state_dir$ + "/patches.unreadable.json", TRUE)
        ENDTRY
        DIM i AS INTEGER
        FOR i = 0 TO LEN(kept) - 1
            DIM failed$ AS STRING = ApplyPatch$(kept[i]{"title"}, kept[i]{"server"}, kept[i]{"client"})
            IF failed$ = "" THEN
                stored = APPEND(stored, kept[i])
            ELSE
                PRINT "stored patch "; kept[i]{"title"}; " refused: "; failed$
            ENDIF
        NEXT i
    ENDIF
    IF NOT FILE.EXISTS(state_dir$ + "/world.json") THEN RETURN
    TRY
        DIM snap = JSON.PARSE(TXTREADER$(state_dir$ + "/world.json"))
        IF NOT ISMAP(snap) ORELSE NOT MAP.EXISTS(snap, "world") ORELSE NOT MAP.EXISTS(snap, "clock") THEN THROW "not a saved world"
        DIM old = snap{"world"}
        IF NOT ISMAP(old) ORELSE NOT MAP.EXISTS(old, "map") THEN THROW "not a saved world"
        FOR EACH part$ IN MAP.KEYS(old)
            IF part$ <> "version" ANDALSO part$ <> "patch_titles" ANDALSO part$ <> "errors" ANDALSO part$ <> "last_error" THEN W{part$} = old{part$}
        NEXT
        started_ms = TICK() - snap{"clock"}
        W{"restarts"} = W{"restarts"} + 1
        ' whoever was playing gets the time of a fresh arrival to come back
        FOR EACH name$ IN MAP.KEYS(W{"players"})
            W{"players"}{name$}{"last_seen"} = KNow()
        NEXT
    CATCH
        PRINT "the saved world could not be read: "; ERRMSG$
        DIM aside = FILE.MOVE(state_dir$ + "/world.json", state_dir$ + "/world.unreadable.json", TRUE)
    ENDTRY
ENDSUB

' ---- HTTP ----

FUNC BodyOf(request)
    DIM parsed = {}
    TRY
        parsed = JSON.PARSE(request{"body"})
    CATCH
        parsed = {}
    ENDTRY
    IF NOT ISMAP(parsed) THEN parsed = {}
    RETURN parsed
ENDFUNC

' Forgets the tokens of one player, and those of players who left once the list grows long.
SUB DropTokens(name$ AS STRING)
    DIM tokens = W{"tokens"}
    DIM sweep AS BOOLEAN = MAP.SIZE(tokens) > 4 * MAX_PLAYERS
    FOR EACH held$ IN MAP.KEYS(tokens)
        IF tokens{held$} = name$ ORELSE (sweep ANDALSO NOT MAP.EXISTS(W{"players"}, tokens{held$})) THEN MAP.DELETE(tokens, held$)
    NEXT
ENDSUB

' ---- accounts ----
' A name belongs to whoever first joins with it and a PIN of 4 to 8 digits;
' every later join has to bring the same PIN, and five wrong ones lock the
' name for a minute. Names are claimed without regard to case. Only a salted
' hash of the PIN is kept, in accounts.json of the state folder, apart from
' the world, so no rule and no patch can read it.

FUNC PinHash$(salt$ AS STRING, pin$ AS STRING) AS STRING
    RETURN CODEC.PBKDF2$(pin$, salt$, 20000, 32)
ENDFUNC

SUB SaveAccounts()
    IF state_dir$ = "" THEN RETURN
    TRY
        WriteState("accounts.json", JSON.STRINGIFY$({"accounts": accounts}))
    CATCH
        KFail("save", ERRMSG$)
    ENDTRY
ENDSUB

SUB LoadAccounts()
    IF state_dir$ = "" ORELSE NOT FILE.EXISTS(state_dir$ + "/accounts.json") THEN RETURN
    TRY
        DIM kept = JSON.PARSE(TXTREADER$(state_dir$ + "/accounts.json"))
        IF NOT ISMAP(kept) ORELSE NOT ISMAP(kept{"accounts"} ?? "") THEN THROW "not an account list"
        accounts = kept{"accounts"}
    CATCH
        PRINT "the accounts could not be read: "; ERRMSG$
        DIM aside = FILE.MOVE(state_dir$ + "/accounts.json", state_dir$ + "/accounts.unreadable.json", TRUE)
    ENDTRY
ENDSUB

' {"ok", "name"} with the name as it was first claimed, or {"ok": false, "error"}.
FUNC CheckPin(name$ AS STRING, pin$ AS STRING)
    DIM key$ AS STRING = LCASE$(name$)
    IF NOT MAP.EXISTS(accounts, key$) THEN
        DIM salt$ AS STRING = CODEC.UUID$()
        accounts{key$} = {"name": name$, "salt": salt$, "hash": PinHash$(salt$, pin$), "tries": 0, "locked": 0}
        SaveAccounts()
        RETURN {"ok": TRUE, "name": name$}
    ENDIF
    DIM a = accounts{key$}
    IF a{"locked"} > KNow() THEN RETURN {"ok": FALSE, "error": "locked"}
    IF PinHash$(a{"salt"}, pin$) <> a{"hash"} THEN
        a{"tries"} = a{"tries"} + 1
        IF a{"tries"} >= PIN_TRIES THEN
            a{"locked"} = KNow() + PIN_LOCK_MS
            a{"tries"} = 0
        ENDIF
        SaveAccounts()
        RETURN {"ok": FALSE, "error": "wrong_pin"}
    ENDIF
    IF a{"tries"} > 0 THEN
        a{"tries"} = 0
        SaveAccounts()
    ENDIF
    RETURN {"ok": TRUE, "name": a{"name"}}
ENDFUNC

FUNC HANDLEJOIN(request)
    DIM b = BodyOf(request)
    W{"served"} = W{"served"} + 1
    DIM name$ AS STRING = TRIM$("" + (b{"name"} ?? ""))
    DIM pin$ AS STRING = TRIM$("" + (b{"pin"} ?? ""))
    IF NOT REGEX.MATCH("^[A-Za-z0-9_]{1,16}$", name$) THEN RETURN {"ok": FALSE, "error": "name"}
    IF NOT REGEX.MATCH("^[0-9]{4,8}$", pin$) THEN RETURN {"ok": FALSE, "error": "pin"}
    IF MAP.EXISTS(accounts, LCASE$(name$)) THEN name$ = accounts{LCASE$(name$)}{"name"}
    IF NOT MAP.EXISTS(W{"players"}, name$) ANDALSO MAP.SIZE(W{"players"}) >= MAX_PLAYERS THEN RETURN {"ok": FALSE, "error": "full"}
    DIM owner = CheckPin(name$, pin$)
    IF NOT owner{"ok"} THEN RETURN owner
    DIM answer = {"ok": FALSE}
    TRY
        DIM p = RuleJoin(W, name$)
        DIM token$ AS STRING = CODEC.UUID$()
        DropTokens(name$)
        W{"tokens"}{token$} = name$
        answer = {"ok": TRUE, "token": token$, "version": W{"version"}, "name": name$}
    CATCH
        KFail("RuleJoin", ERRMSG$)
        answer = {"ok": FALSE, "error": "the world could not take you in"}
    ENDTRY
    RETURN answer
ENDFUNC

FUNC HANDLESYNC(request)
    DIM b = BodyOf(request)
    W{"served"} = W{"served"} + 1
    DIM token$ AS STRING = "" + (b{"token"} ?? "")
    DIM tokens = W{"tokens"}
    IF NOT MAP.EXISTS(tokens, token$) THEN RETURN {"ok": FALSE, "error": "join"}
    DIM players = W{"players"}
    DIM name$ AS STRING = tokens{token$}
    IF NOT MAP.EXISTS(players, name$) THEN RETURN {"ok": FALSE, "error": "join"}
    DIM answer = {"ok": FALSE}
    TRY
        answer = RuleSync(W, players{name$}, b)
        answer{"ok"} = TRUE
        answer{"version"} = W{"version"}
        answer{"code_id"} = code_ids[W{"version"}]
        answer{"restarts"} = W{"restarts"}
    CATCH
        KFail("RuleSync", ERRMSG$)
        answer = {"ok": FALSE, "error": "rule", "version": W{"version"}}
    ENDTRY
    RETURN answer
ENDFUNC

FUNC HANDLECODE(request)
    W{"served"} = W{"served"} + 1
    DIM since AS INTEGER = VAL("" + (request{"params"}{"since"} ?? "0"))
    DIM fresh = []
    DIM i AS INTEGER
    FOR i = MAX([since, 0]) TO LEN(client_patches) - 1
        fresh = APPEND(fresh, client_patches[i])
    NEXT i
    since = CLAMP(since, 0, LEN(code_ids) - 1)
    RETURN {"version": W{"version"}, "patches": fresh, "code_id": code_ids[W{"version"}], "since_id": code_ids[since]}
ENDFUNC

FUNC HANDLEPATCH(request)
    DIM b = BodyOf(request)
    IF patch_key$ = "" ORELSE "" + (b{"key"} ?? "") <> patch_key$ THEN RETURN {"__http_status": 403}
    DIM title$ AS STRING = "" + (b{"title"} ?? "patch")
    DIM failed$ AS STRING = ApplyPatch$(title$, "" + (b{"server"} ?? ""), "" + (b{"client"} ?? ""))
    IF failed$ <> "" THEN RETURN {"ok": FALSE, "error": failed$, "version": W{"version"}}
    stored = APPEND(stored, {"title": title$, "server": "" + (b{"server"} ?? ""), "client": "" + (b{"client"} ?? "")})
    SavePatches()
    KEmit(W, {"type": "patch", "title": title$, "version": W{"version"}})
    RETURN {"ok": TRUE, "version": W{"version"}}
ENDFUNC

' A call of the keeper of the world, handed to the rules; it needs the patch key.
FUNC HANDLERULE(request)
    DIM b = BodyOf(request)
    IF patch_key$ = "" ORELSE "" + (b{"key"} ?? "") <> patch_key$ THEN RETURN {"__http_status": 403}
    ' the keeper frees a name, so its owner can claim it again with a new PIN
    IF "" + (b{"name"} ?? "") = "pin_reset" THEN
        DIM freed$ AS STRING = LCASE$("" + ((b{"args"} ?? {}){"name"} ?? ""))
        IF NOT MAP.EXISTS(accounts, freed$) THEN RETURN {"ok": FALSE, "error": "no such name"}
        DropTokens(accounts{freed$}{"name"})
        MAP.DELETE(accounts, freed$)
        SaveAccounts()
        RETURN {"ok": TRUE}
    ENDIF
    DIM answer = {"ok": FALSE}
    TRY
        answer = RuleAdmin(W, "" + (b{"name"} ?? ""), b{"args"} ?? {})
    CATCH
        KFail("RuleAdmin", ERRMSG$)
        answer = {"ok": FALSE, "error": ERRMSG$}
    ENDTRY
    RETURN answer
ENDFUNC

FUNC HANDLESTATS(request)
    RETURN {"version": W{"version"}, "players": MAP.SIZE(W{"players"}), "served": W{"served"}, "errors": W{"errors"}, "last_error": W{"last_error"}, "uptime_s": KNow() \ 1000, "pending": LEN(pending), "model_errors": W{"model_errors"} ?? 0, "patches": W{"patch_titles"}, "restarts": W{"restarts"}, "stored": LEN(stored)}
ENDFUNC

' ---- start ----

DIM files = SORT(FILE.LIST(game_dir$ + "/*.jdb"))
DIM f AS INTEGER
FOR f = 0 TO LEN(files) - 1
    DIM file$ AS STRING = game_dir$ + "/" + PATH.BASENAME$(files[f])
    DIM parts = SplitPatch(TXTREADER$(file$))
    DIM failed$ AS STRING = ApplyPatch$(PATH.BASENAME$(files[f]), parts{"server"}, parts{"client"})
    IF failed$ <> "" THEN
        PRINT "patch "; files[f]; " refused: "; failed$
        END 1
    ENDIF
NEXT f
IF LEN(files) = 0 THEN
    PRINT "no game in "; game_dir$
    END 1
ENDIF
RuleMakeWorld(W)
LoadState()
LoadAccounts()
TRY
    RuleWake(W)
CATCH
    KFail("RuleWake", ERRMSG$)
ENDTRY

HTTP.SERVER.ON_POST "/join", HANDLEJOIN@
HTTP.SERVER.ON_POST "/sync", HANDLESYNC@
HTTP.SERVER.ON_GET "/code", HANDLECODE@
HTTP.SERVER.ON_POST "/patch", HANDLEPATCH@
HTTP.SERVER.ON_POST "/rule", HANDLERULE@
HTTP.SERVER.ON_GET "/stats", HANDLESTATS@
IF NOT HTTP.SERVER.START(port, "127.0.0.1") THEN
    PRINT "the server did not start on port "; port
    END 1
ENDIF
PRINT "Wunschwelt on 127.0.0.1:"; port; ", "; W{"version"}; " patches, model: "; IIF(llm_url$ = "", "none", llm_url$); ", patches over HTTP: "; IIF(patch_key$ = "", "closed", "with key")

DIM next_tick AS DOUBLE = TICK()
DIM next_save AS DOUBLE = TICK() + SAVE_MS
DIM process_start AS DOUBLE = TICK()
DO WHILE run_seconds = 0 ORELSE TICK() - process_start < run_seconds * 1000
    IF TICK() >= next_save THEN
        next_save = TICK() + SAVE_MS
        SaveWorld()
    ENDIF
    IF TICK() >= next_tick THEN
        next_tick = next_tick + TICK_MS
        TRY
            RuleTick(W, KNow())
        CATCH
            KFail("RuleTick", ERRMSG$)
        ENDTRY
        DIM waiting = []
        DIM q AS INTEGER
        FOR q = 0 TO LEN(pending) - 1
            DIM ask = pending[q]
            IF NOT THREAD.ISDONE(ask{"task"}) THEN
                IF KNow() - ask{"asked"} < 30000 THEN waiting = APPEND(waiting, ask)
                CONTINUEFOR
            ENDIF
            DIM said$ AS STRING = ""
            DIM usable AS BOOLEAN = FALSE
            TRY
                DIM reply = JSON.PARSE(THREAD.GETRESULT(ask{"task"}))
                said$ = TRIM$("" + reply{"choices"}[0]{"message"}{"content"})
                usable = TRUE
            CATCH
                KFail("model", ERRMSG$)
            ENDTRY
            TRY
                IF ask{"kind"} = "npc" ANDALSO usable THEN
                    RuleNpcReply(W, ask{"data"}{"npc"}, ask{"data"}{"player"}, said$)
                ELSEIF ask{"kind"} = "npc" THEN
                    RuleNpcFailed(W, ask{"data"}{"npc"}, ask{"data"}{"player"})
                ELSEIF usable THEN
                    RuleAnswer(W, ask{"kind"}, ask{"data"}, said$)
                ELSE
                    RuleAnswerFailed(W, ask{"kind"}, ask{"data"})
                ENDIF
            CATCH
                KFail("answer of kind " + ask{"kind"}, ERRMSG$)
            ENDTRY
        NEXT q
        pending = waiting
    ELSE
        SLEEP 5
    ENDIF
LOOP
SaveWorld()
HTTP.SERVER.STOP
PRINT "served "; W{"served"}; ", version "; W{"version"}; ", errors "; W{"errors"}; " "; W{"last_error"}
