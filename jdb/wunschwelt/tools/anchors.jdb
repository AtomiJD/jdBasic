' Where a hat, glasses and a scarf sit on the animals of assets/animal_*.png,
' for each of the 18 frames of a sheet, written to assets/anchors.json.
'
' Every frame is measured: the top of the head and the eyes (dark pixels
' inside the figure in its upper part). assets/anchors_fix.json sets by hand
' what the measure gets wrong, per sort and view ("front", "left", "right",
' "back"; "right" alone also sets "left", mirrored; "left": "mirror" takes
' the frames facing right, mirrored) or per frame ("row,col", taken as it
' is). A fix of a view sets its standing frame; the other frames of the view
' (steps, sitting, happy) take it, moved as far as the head moved. So does a
' frame where no eyes were found.
'
' anchors.json: {"frame": 48, "sorts": {sort: {"row,col": {"top", "hat":
' [x, y], "eye": [x, y] or absent from behind, "gap" seen from the front,
' "neck": [x, y], "view"}}}}, in the pixels of the frame as drawn.
'
'   build/jdBasic.exe jdb/wunschwelt/tools/anchors.jdb [check folder]
'
' With a folder it also draws each sheet there with its anchors marked:
' hat red, eyes blue, neck green, top magenta.

IMPORT IMG

DIM folder$ = PATH.DIRNAME$(OS.ARGS()[0]) + "/../assets"
DIM check$ = ""
IF LEN(OS.ARGS()) > 1 THEN check$ = OS.ARGS()[1]

' The view of each frame and the standing frame it follows.
FUNC Views()
    RETURN {"0,0": "front", "0,1": "front", "0,2": "front", "1,0": "left", "1,1": "left", "1,2": "left", "2,0": "right", "2,1": "right", "2,2": "right", "3,0": "back", "3,1": "back", "3,2": "back", "4,0": "left", "4,1": "front", "4,2": "right", "5,0": "front", "5,1": "front", "5,2": "front"}
ENDFUNC

FUNC Stands()
    RETURN {"front": "0,1", "left": "1,1", "right": "2,1", "back": "3,1"}
ENDFUNC

' [top, bottom, head x] of a frame: the head x is the middle of what is
' opaque in the six rows under the top.
FUNC Outline(px, sw, fx0, fy0)
    DIM top = -1
    DIM bottom = -1
    DIM y = 0
    DIM x = 0
    FOR y = 0 TO 47
        FOR x = 0 TO 47
            IF px[((fy0 + y) * sw + fx0 + x) * 4 + 3] > 60 THEN
                IF top < 0 THEN top = y
                bottom = y
            ENDIF
        NEXT x
    NEXT y
    IF top < 0 THEN RETURN [8, 40, 24]
    DIM xs = []
    FOR y = top TO MIN([47, top + 5])
        FOR x = 0 TO 47
            IF px[((fy0 + y) * sw + fx0 + x) * 4 + 3] > 60 THEN xs = APPEND(xs, x)
        NEXT x
    NEXT y
    RETURN [top, bottom, INT((MIN(xs) + MAX(xs)) / 2)]
ENDFUNC

' The dark pixels inside the figure in the upper part of a frame: [xs, ys].
FUNC DarkSpots(px, sw, fx0, fy0, top, bottom)
    DIM xs = []
    DIM ys = []
    DIM y = 0
    DIM x = 0
    FOR y = top + 1 TO top + INT((bottom - top) * 0.6)
        FOR x = 1 TO 46
            DIM at = ((fy0 + y) * sw + fx0 + x) * 4
            DIM lum = 0.299 * px[at] + 0.587 * px[at + 1] + 0.114 * px[at + 2]
            IF px[at + 3] > 200 ANDALSO lum < 70 THEN
                DIM inside = TRUE
                FOR EACH d IN [-4, 4, -4 * sw, 4 * sw]
                    IF px[at + d + 3] < 200 THEN inside = FALSE
                NEXT
                IF inside THEN
                    xs = APPEND(xs, x)
                    ys = APPEND(ys, y)
                ENDIF
            ENDIF
        NEXT x
    NEXT y
    RETURN [xs, ys]
ENDFUNC

' The anchors of a standing frame of the view.
FUNC MeasureStand(px, sw, fx0, fy0, view$)
    DIM o = Outline(px, sw, fx0, fy0)
    DIM top = o[0]
    DIM up = INT((o[1] - top) * 0.25)
    IF view$ = "back" THEN RETURN {"top": top, "hat": [o[2], top + 3], "neck": [o[2], top + up + 8], "found": TRUE}
    DIM spots = DarkSpots(px, sw, fx0, fy0, top, o[1])
    DIM xs = spots[0]
    DIM ys = spots[1]
    IF LEN(xs) = 0 THEN RETURN {"top": top, "hat": [o[2], top + 3], "eye": [o[2], top + 10], "gap": 5, "neck": [o[2], top + 20], "found": FALSE}
    IF view$ = "front" THEN
        DIM mid = (MIN(xs) + MAX(xs)) / 2
        DIM left = []
        DIM right = []
        FOR EACH v IN xs
            IF v < mid THEN
                left = APPEND(left, v)
            ELSE
                right = APPEND(right, v)
            ENDIF
        NEXT
        DIM lx = IIF(LEN(left) > 0, MEAN(left), mid - 5)
        DIM rx = IIF(LEN(right) > 0, MEAN(right), mid + 5)
        DIM cx = INT((lx + rx) / 2)
        DIM ey = INT(MEAN(ys))
        RETURN {"top": top, "hat": [cx, top + 3], "eye": [cx, ey], "gap": MAX([3, INT((rx - lx) / 2)]), "neck": [cx, ey + INT((ey - top) * 0.5) + 2], "found": TRUE}
    ENDIF
    ' seen from the side the eye is the dark spot furthest toward the nose
    DIM far = IIF(view$ = "right", MAX(xs), MIN(xs))
    DIM ex = []
    DIM ey_s = []
    DIM i = 0
    FOR i = 0 TO LEN(xs) - 1
        IF ABS(xs[i] - far) <= 4 THEN
            ex = APPEND(ex, xs[i])
            ey_s = APPEND(ey_s, ys[i])
        ENDIF
    NEXT i
    DIM sx = INT(MEAN(ex))
    DIM sy = INT(MEAN(ey_s))
    DIM back_way = IIF(view$ = "right", -1, 1)
    RETURN {"top": top, "hat": [sx + 4 * back_way, top + 3], "eye": [sx, sy], "neck": [sx + 5 * back_way, sy + INT((sy - top) * 0.5) + 2], "found": TRUE}
ENDFUNC

FUNC Mirror(a)
    DIM out = {}
    FOR EACH k$ IN MAP.KEYS(a)
        IF ISARR(a{k$}) THEN
            out{k$} = [47 - a{k$}[0], a{k$}[1]]
        ELSE
            out{k$} = a{k$}
        ENDIF
    NEXT
    RETURN out
ENDFUNC

' a with the fields of fix laid over it.
FUNC Over(a, fix)
    DIM out = {}
    FOR EACH k$ IN MAP.KEYS(a)
        out{k$} = a{k$}
    NEXT
    FOR EACH k$ IN MAP.KEYS(fix)
        out{k$} = fix{k$}
    NEXT
    RETURN out
ENDFUNC

' The anchors a, moved by dx and dy.
FUNC Moved(a, dx, dy)
    DIM out = {}
    FOR EACH k$ IN MAP.KEYS(a)
        IF ISARR(a{k$}) THEN
            out{k$} = [a{k$}[0] + dx, a{k$}[1] + dy]
        ELSEIF k$ = "top" THEN
            out{k$} = a{k$} + dy
        ELSE
            out{k$} = a{k$}
        ENDIF
    NEXT
    RETURN out
ENDFUNC

FUNC Mark(img, x, y, col, scale)
    IF x < 0 ORELSE y < 0 ORELSE x > 47 ORELSE y > 47 THEN RETURN img
    DIM dot = IMG.FROMPIXELS(scale, scale, 4, FLATTEN(RESHAPE([col[0], col[1], col[2], 255], [scale * scale, 4])))
    RETURN IMG.PASTE(img, dot, x * scale, y * scale)
ENDFUNC

' The sheet with each frame's anchors marked, three times as big.
SUB DrawCheck(img, frames, path$)
    DIM scale = 3
    DIM out = IMG.BLANK(3 * 48 * scale, 6 * 48 * scale, 4, 255)
    DIM fr_row = 0
    DIM fr_col = 0
    FOR fr_row = 0 TO 5
        FOR fr_col = 0 TO 2
            DIM a = frames{STR$(fr_row) + "," + STR$(fr_col)}
            DIM fr = IMG.RESIZE(IMG.CROP(img, fr_col * 48, fr_row * 48, 48, 48), 48 * scale, 48 * scale, "nearest")
            fr = Mark(fr, 0, a{"top"}, [255, 0, 255], scale)
            fr = Mark(fr, a{"hat"}[0], a{"hat"}[1], [255, 0, 0], scale)
            fr = Mark(fr, a{"neck"}[0], a{"neck"}[1], [0, 200, 0], scale)
            IF MAP.EXISTS(a, "eye") THEN
                IF a{"view"} = "front" THEN
                    fr = Mark(fr, a{"eye"}[0] - a{"gap"}, a{"eye"}[1], [0, 0, 255], scale)
                    fr = Mark(fr, a{"eye"}[0] + a{"gap"}, a{"eye"}[1], [0, 0, 255], scale)
                ELSE
                    fr = Mark(fr, a{"eye"}[0], a{"eye"}[1], [0, 0, 255], scale)
                ENDIF
            ENDIF
            out = IMG.PASTE(out, IMG.COMPOSITE(IMG.BLANK(48 * scale, 48 * scale, 4, 200), fr, 0, 0), fr_col * 48 * scale, fr_row * 48 * scale)
        NEXT fr_col
    NEXT fr_row
    IMG.WRITEPNG(out, path$)
ENDSUB

DIM fixes = {}
IF FILE.EXISTS(folder$ + "/anchors_fix.json") THEN fixes = JSON.PARSE(TXTREADER$(folder$ + "/anchors_fix.json"))
DIM views = Views()
DIM stands = Stands()
DIM sorts = {}
FOR EACH file$ IN SORT(FILE.LIST(folder$ + "/animal_*.png"))
    DIM base$ = PATH.BASENAME$(file$)
    DIM what$ = MID$(base$, 7, LEN(base$) - 11)
    DIM img = IMG.TOCHANNELS(IMG.READPNG(folder$ + "/" + base$), 4)
    DIM px = IMG.PIXELS(img)
    DIM sw = IMG.WIDTH(img)
    IF IMG.HEIGHT(img) >= 6 * 48 ANDALSO sw >= 3 * 48 THEN
        DIM fix = fixes{what$} ?? {}
        IF MAP.EXISTS(fix, "right") ANDALSO NOT MAP.EXISTS(fix, "left") THEN fix{"left"} = Mirror(fix{"right"})
        DIM measured = {}
        FOR EACH key$ IN MAP.KEYS(views)
            DIM fr_rc = SPLIT(key$, ",")
            measured{key$} = MeasureStand(px, sw, VAL(fr_rc[1]) * 48, VAL(fr_rc[0]) * 48, views{key$})
        NEXT
        DIM frames = {}
        FOR EACH key$ IN MAP.KEYS(views)
            DIM view_of$ = views{key$}
            DIM stand_key$ = stands{view_of$}
            DIM stand = Over(measured{stand_key$}, {})
            DIM fixed = ISMAP(fix{view_of$} ?? 0)
            IF fixed THEN stand = Over(stand, fix{view_of$})
            IF key$ = stand_key$ ANDALSO NOT stand{"found"} ANDALSO NOT fixed THEN PRINT "no eyes found for "; what$; " "; view_of$; ", set it in anchors_fix.json"
            ' a measured frame stands as it is; a frame of a fixed view, or one
            ' without eyes, takes its standing frame, moved as far as the head moved
            DIM f = Over(measured{key$}, {})
            IF key$ = stand_key$ THEN
                f = stand
            ELSEIF fixed ORELSE NOT f{"found"} THEN
                DIM fr_xy = SPLIT(key$, ",")
                DIM st_xy = SPLIT(stand_key$, ",")
                DIM here = Outline(px, sw, VAL(fr_xy[1]) * 48, VAL(fr_xy[0]) * 48)
                DIM there = Outline(px, sw, VAL(st_xy[1]) * 48, VAL(st_xy[0]) * 48)
                f = Moved(stand, here[2] - there[2], here[0] - there[0])
            ENDIF
            IF MAP.EXISTS(fix, key$) THEN f = Over(f, fix{key$})
            MAP.DELETE(f, "found")
            f{"view"} = view_of$
            frames{key$} = f
        NEXT
        ' "left": "mirror" takes the frames facing right, mirrored
        IF (fix{"left"} ?? "") = "mirror" THEN
            FOR EACH pair IN [["1,0", "2,0"], ["1,1", "2,1"], ["1,2", "2,2"], ["4,0", "4,2"]]
                DIM mirrored = Mirror(frames{pair[1]})
                mirrored{"view"} = "left"
                frames{pair[0]} = mirrored
            NEXT
        ENDIF
        sorts{what$} = frames
        IF check$ <> "" THEN DrawCheck(img, frames, check$ + "/anchors_" + what$ + ".png")
    ENDIF
NEXT
TXTWRITER folder$ + "/anchors.json", JSON.STRINGIFY$({"frame": 48, "sorts": sorts})
PRINT "anchors.json: "; MAP.SIZE(sorts); " sorts"
