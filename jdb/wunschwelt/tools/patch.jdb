' Sends one patch file to a running Wunschwelt server, or takes the stored
' patches of a title back.
'
'   jdBasic jdb/wunschwelt/tools/patch.jdb file.jdb "title" [server]
'   jdBasic jdb/wunschwelt/tools/patch.jdb --revoke "title" [server]
'
' The key comes from the environment variable WW_PATCH_KEY. The file has the
' parts '@server and '@client, as the files under game/ do; both must keep
' the contract of patchcheck.jdb. A revoked patch keeps running until the
' server starts again. Exit 0 when the server did it, 1 when it refused (the
' error is printed).

OPTION "EXPLICIT"

DIM cli = OS.ARGS()
IF LEN(cli) < 3 THEN
    PRINT "usage: patch.jdb file.jdb title [server]   or   patch.jdb --revoke title [server]"
    END 1
ENDIF
DIM srv$ AS STRING = "http://127.0.0.1:8100"
IF LEN(cli) > 3 THEN srv$ = cli[3]
DIM nl$ AS STRING = CHR$(10)
DIM t0 AS DOUBLE = TICK()
DIM body = {"key": GETENV$("WW_PATCH_KEY")}
IF cli[1] = "--revoke" THEN
    body{"revoke"} = cli[2]
ELSE
    DIM parts = {"server": "", "client": ""}
    DIM part$ AS STRING = ""
    DIM rows = SPLIT(REPLACE$(TXTREADER$(cli[1]), CHR$(13), ""), nl$)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(rows) - 1
        DIM mark$ AS STRING = TRIM$(rows[i])
        IF mark$ = "'@server" THEN
            part$ = "server"
        ELSEIF mark$ = "'@client" THEN
            part$ = "client"
        ELSEIF part$ <> "" THEN
            parts{part$} = parts{part$} + rows[i] + nl$
        ENDIF
    NEXT i
    body{"title"} = cli[2]
    body{"server"} = parts{"server"}
    body{"client"} = parts{"client"}
ENDIF
DIM answer$ AS STRING = HTTP.POST$(srv$ + "/patch", JSON.STRINGIFY$(body), "text/plain")
IF HTTP.STATUSCODE() <> 200 THEN
    PRINT "refused: HTTP "; HTTP.STATUSCODE()
    END 1
ENDIF
DIM r = JSON.PARSE(answer$)
IF MAP.EXISTS(body, "revoke") THEN
    IF r{"ok"} THEN
        PRINT "revoked "; r{"revoked"}; " stored patch(es); "; r{"stored"}; " left; gone after the next start"
    ELSE
        PRINT "refused: no stored patch with that title"
        END 1
    ENDIF
ELSEIF r{"ok"} THEN
    PRINT "in the world as version "; r{"version"}; " after "; INT(TICK() - t0); " ms"
ELSE
    PRINT "refused: "; r{"error"}
    END 1
ENDIF
