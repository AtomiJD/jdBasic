' The patch contract: what code that runs in the world may use. Code only
' touches the game world: it defines and calls rules, computes, draws and
' plays sound. It reaches no file, no network, no process, runs no code it
' builds as text, and leaves the kernel's own names alone. The world's files
' come through the kernel's services (K...).
'
' The check works by what is allowed, so a builtin it does not know is
' refused: every call and every statement names something defined in the
' code itself or in the code that ran before it, a kernel service, a
' keyword, or a builtin of the lists below. The server checks the game and
' every patch before it runs them; the client checks every piece of code it
' is handed, game and patches alike, so a client protects its machine by
' itself whatever server it is pointed at.
'
'   IMPORT PATCHCHECK
'   known = {}                                      names defined so far
'   why$ = PATCHCHECK.CHECK$(source$, known)        "" when the code may run
'   PATCHCHECK.LEARN(source$, known)                after it ran
'
' Names are compared in capitals, as jdBasic does.

EXPORT MODULE PATCHCHECK

' Namespaces code may use with all their members.
EXPORT FUNC OPEN_SPACES()
    RETURN ["MAP", "JSON", "MATH", "REGEX", "RNG", "MELODY", "DATE"]
ENDFUNC

' Single members of other namespaces code may use.
EXPORT FUNC OPEN_MEMBERS()
    RETURN ["GFX.TEXTSIZE", "GFX.TARGET", "GFX.NEWTARGET", "GFX.DRAWIMAGE", "GFX.DRAWIMAGE_REGION", "GFX.FREEIMAGE", "GFX.KEYSTATE", "CODEC.CRC32", "CODEC.SHA256$", "CODEC.UUID$", "SPRITE.CREATE", "SPRITE.SETBUFFER", "SPRITE.POS", "SPRITE.DRAW", "SPRITE.DELETE", "TILEMAP.CREATE", "TILEMAP.DRAW", "SOUND.INIT", "SOUND.RESET", "SOUND.VOICE", "SOUND.GAIN", "SOUND.FILTER", "SOUND.UNISON", "SOUND.BPM", "SOUND.SEQ", "SOUND.SIDECHAIN", "SOUND.OSC2", "SOUND.GLIDE", "SOUND.DELAY", "SOUND.DELAYSEND", "SOUND.REVERB", "SOUND.REVERBSEND", "SOUND.PLAY", "SOUND.MUTE", "SOUND.MASTER", "SOUND.LFO", "SOUND.CYCLE", "SOUND.EVENTS$"]
ENDFUNC

' The words of the language itself.
EXPORT FUNC KEYWORDS()
    RETURN ["DIM", "AS", "IF", "THEN", "ELSE", "ELSEIF", "ENDIF", "FOR", "EACH", "IN", "TO", "STEP", "NEXT", "DO", "LOOP", "WHILE", "UNTIL", "WEND", "SWITCH", "CASE", "DEFAULT", "ENDSWITCH", "EXITSWITCH", "RETURN", "SUB", "FUNC", "ENDSUB", "ENDFUNC", "TRY", "CATCH", "FINALLY", "ENDTRY", "THROW", "EXITFOR", "EXITDO", "EXITFUNC", "EXITSUB", "CONTINUEFOR", "CONTINUEDO", "AND", "OR", "NOT", "ANDALSO", "ORELSE", "XOR", "MOD", "BAND", "BOR", "BXOR", "SHL", "SHR", "TRUE", "FALSE", "NONE", "INTEGER", "DOUBLE", "STRING", "BOOLEAN", "ARRAY", "MAP", "ERR", "ERL", "ERRMSG$", "STACK$", "PRINT", "CONST"]
ENDFUNC

' Builtins code may call: computing, text, arrays, maps, time and chance.
EXPORT FUNC SAFE_CALLS()
    RETURN ["ABS", "ACOS", "ALL", "ANY", "APPEND", "ASC", "ASIN", "ATAN", "ATAN2", "BYTEAT", "CBOOL", "CDBL", "CEIL", "CHR$", "CINT", "CLAMP", "CLNG", "COS", "COUNT", "CUMSUM", "DATE$", "DEGREES", "DIFF", "DISTANCE", "DROP", "ENDSWITH", "ENUMERATE", "EXP", "FILTER", "FIND_IN_ARRAY", "FLATTEN", "FLOOR", "FORMAT$", "GRADE", "HEX$", "IIF", "INDEXOF", "INSTR", "INT", "IOTA", "ISARR", "ISBOOL", "ISMAP", "ISNONE", "ISNULL", "ISNUM", "ISSTR", "JOIN", "LCASE$", "LEFT$", "LEN", "LERP", "LOG", "LOG10", "LOWER$", "LPAD$", "LTRIM$", "MAX", "MEAN", "MEDIAN", "MID$", "MIN", "NOW", "NOW_EPOCH", "ONES", "PACK$", "POP", "POW", "PRODUCT", "PUSH", "RADIANS", "RANDOM", "RANGE", "REDUCE", "REPEAT$", "REPLACE$", "RESHAPE", "REVERSE", "REVERSE$", "RIGHT$", "RND", "ROTATE", "ROUND", "RPAD$", "RTRIM$", "SCAN", "SELECT", "SGN", "SHIFT", "SHUFFLE", "SIGN", "SIN", "SORT", "SPACE$", "SPLIT", "SQR", "STARTSWITH", "STR$", "SUM", "TAKE", "TALLY", "TAN", "TICK", "TIME$", "TONUM", "TRIM$", "TRUNC", "TYPEOF", "UCASE$", "UNIQUE", "UNPACK", "UPPER$", "VAL", "XSORT", "ZEROS", "ZIP", "TRANSPOSE", "OUTER", "CONVOLVE", "STACK", "SLICE", "PLACE", "MVLET", "MVINS", "CUMPROD", "HISTOGRAM", "MATMUL", "DOT", "CROSS", "NORMALIZE", "LINSPACE", "AGG", "GROUPBY", "TAKE_WHILE", "DROP_WHILE", "CHUNK", "FILLV", "COPYV", "VARIANCE", "STDEV", "GCD", "LCM", "FAC", "SINH", "COSH", "TANH", "CVDATE", "CDATE", "EOMONTH", "YEAR", "MONTH", "DAY", "HOUR", "MINUTE", "SECOND", "WEEKDAY", "DATEADD", "DATEDIFF", "FORMAT_DATE$"]
ENDFUNC

' Builtin statements code may use: drawing.
EXPORT FUNC SAFE_STATEMENTS()
    RETURN ["CLS", "RECT", "FILLRECT", "ROUNDED_RECT", "TEXT", "CIRCLE", "ELLIPSE", "LINE", "PSET", "TRIANGLE", "POLYGON", "DRAWCOLOR", "SPRITE.SETBUFFER", "SPRITE.POS", "SPRITE.DRAW", "SPRITE.DELETE", "GFX.TARGET", "MAP.DELETE", "MAP.CLEAR", "MAP.MERGE", "SOUND.INIT", "SOUND.RESET"]
ENDFUNC

' Words refused wherever they stand, also without brackets: input that
' waits, and introspection.
EXPORT FUNC SHUT_WORDS()
    RETURN ["INKEY$", "WAITKEY$", "INPUT", "INPUT_HIDDEN$", "VARS", "FUNCS", "HELP", "HELP$", "END", "STOP", "SLEEP", "EXECUTE", "EVAL", "IMPORT", "EXPORT", "DECLARE", "LIB", "ALIAS", "ASYNC", "AWAIT", "YIELD", "ON", "GOTO"]
ENDFUNC

' The kernels' own names (server.jdb and client.jdb) code may neither use
' nor define: their state, their secrets and their machinery.
EXPORT FUNC KERNEL_NAMES()
    RETURN ["TICK_MS", "MAX_EVENTS", "MAX_PLAYERS", "MAX_PENDING", "ASK_PAUSE_MS", "CLI", "PORT", "RUN_SECONDS", "PATCH_KEY$", "LLM_URL$", "GAME_DIR$", "STATE_DIR$", "SAVE_MS", "SESSIONS", "PATCHCONTRACT$", "STARTED_MS", "CLIENT_PATCHES", "CODE_IDS", "STORED", "PENDING", "LAST_ASK", "ACCOUNTS", "PIN_TRIES", "PIN_LOCK_S", "MAX_ACCOUNTS", "NEW_PER_MIN", "HASH_PER_S", "HASH_ALL_PER_S", "SENDERS", "ALL_HASHES", "NEXT_TICK", "NEXT_SAVE", "PROCESS_START", "PATCH_KNOWN", "PATCH_KNOWN_CLIENT", "SPLITPATCH", "APPLYPATCH$", "WRITESTATE", "SAVEWORLD", "SAVEPATCHES", "LOADCONFIG", "LOADSTATE", "BODYOF", "DROPTOKENS", "PINHASH$", "SAVEACCOUNTS", "LOADACCOUNTS", "SENDEROF", "HASHALLOWED", "FREEFORGOTTEN", "CHECKPIN", "HANDLEJOIN", "HANDLEVIEW", "HANDLESYNC", "HANDLECODE", "HANDLEPATCH", "HANDLERULE", "HANDLESTATS", "PIN$", "MY_TOKEN$", "MY_NAME$", "SRV_URL$", "ASSET_DIR$", "ONKEYDOWN", "ONTEXT", "ONQUIT", "PULLCODE", "JOINWORLD", "VIEWSCALE", "ASSETNAME$", "PATCHCHECK"]
ENDFUNC

' Kernel services code may call but not define again.
EXPORT FUNC KERNEL_CALLS()
    RETURN ["KNOW", "KEMIT", "KASKNPC", "KBUSY", "KASK$", "KFAIL", "KASSET$", "KASSETIMAGE", "KPOST", "KFONT", "KKIT"]
ENDFUNC

' Top-level names of the kernels that are no harm to code: loop counters
' and the like. The kernels' world maps W and C are the game's to change.
EXPORT FUNC KERNEL_FREE()
    RETURN ["F", "FILES", "FILE$", "PARTS", "FAILED$", "NL$", "STARTED", "W", "C"]
ENDFUNC

