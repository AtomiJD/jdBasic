' Every builtin name, between commas: the written list and what the running
' jdBasic lists itself.
FUNC BUILTINS$() AS STRING
    DIM listed$ AS STRING = ""
    TRY
        listed$ = UCASE$(JOIN(HELP$(), ","))
    CATCH
        listed$ = ""
    ENDTRY
    RETURN STATIC_BUILTINS$() + listed$ + ","
ENDFUNC

' Where the word REM stands in t$ from start on (as INSTR), not as a part
' of a longer word; -1 when nowhere.
FUNC REM_AT(t$, start)
    DIM at = INSTR(start, t$, "REM")
    DO WHILE at >= 0
        DIM before$ = IIF(at = 0, " ", MID$(t$, at - 1, 1))
        DIM after$ = MID$(t$, at + 3, 1)
        IF INSTR("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$", before$) < 0 ANDALSO (after$ = "" ORELSE INSTR("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$", after$) < 0) THEN RETURN at
        at = INSTR(at + 3, t$, "REM")
    LOOP
    RETURN -1
ENDFUNC

' The source in capitals with its strings and comments taken out, read from
' left to right as the lexer reads it: whichever of a quote, ' and the word
' REM comes first decides; a comment runs to the end of the line, a string
' to the next quote, across lines too ("" inside it is two strings side by
' side, which covers the same text). A string or a comment becomes a space,
' so no two words close up where it was; a string holding just W or C stays,
' and JDB.GLOBAL_GET("W") or ("C") outside strings becomes the word
' PATCH_WORLD. What is left of an interpolated string $"..." is a lone $.
FUNC BARE$(source$) AS STRING
    DIM q$ = CHR$(34)
    DIM t$ = REPLACE$(UCASE$(source$), CHR$(13), "")
    DIM pieces = []
    DIM read_at = 0
    ' the next quote, apostrophe and REM, looked for again only once passed
    DIM at_q = -2
    DIM at_c = -2
    DIM at_r = -2
    DO WHILE read_at < LEN(t$)
        IF at_q <> -1 ANDALSO at_q < read_at THEN at_q = INSTR(read_at, t$, q$)
        IF at_c <> -1 ANDALSO at_c < read_at THEN at_c = INSTR(read_at, t$, "'")
        IF at_r <> -1 ANDALSO at_r < read_at THEN at_r = REM_AT(t$, read_at)
        DIM first = -1
        FOR EACH cand IN [at_q, at_c, at_r]
            IF cand >= 0 ANDALSO (first < 0 ORELSE cand < first) THEN first = cand
        NEXT
        IF first < 0 THEN
            PUSH(pieces, MID$(t$, read_at))
            EXITDO
        ENDIF
        PUSH(pieces, MID$(t$, read_at, first - read_at))
        IF first = at_q THEN
            DIM end_at = INSTR(first + 1, t$, q$)
            IF end_at < 0 THEN end_at = LEN(t$) - 1
            DIM inner$ = MID$(t$, first + 1, end_at - first - 1)
            PUSH(pieces, IIF(inner$ = "W" ORELSE inner$ = "C", q$ + inner$ + q$, " "))
            read_at = end_at + 1
        ELSE
            DIM eol = INSTR(first, t$, CHR$(10))
            PUSH(pieces, " ")
            read_at = IIF(eol < 0, LEN(t$), eol)
        ENDIF
    LOOP
    DIM code$ = JOIN(pieces, "")
    ' a lone _ at the end of a line joins it with the next one
    code$ = REGEX.REPLACE$("(^|[^A-Z0-9_$.])_[ \t]*\n", code$, "$1 ")
    RETURN REGEX.REPLACE$("JDB\.GLOBAL_GET[ \t]*\([ \t]*" + q$ + "[WC]" + q$ + "[ \t]*\)", code$, " PATCH_WORLD ")
ENDFUNC

' The names the source defines.
EXPORT FUNC DEFINES(source$)
    RETURN DEFINED(BARE$(source$))
ENDFUNC

' The names a bare source (BARE$) defines.
FUNC DEFINED(code$)
    DIM names = []
    FOR EACH pair IN REGEX.FINDALL("(?:^|\n)[ \t]*(?:ASYNC[ \t]+)?(?:SUB|FUNC)[ \t]+([A-Z_][A-Z0-9_]*[$]?)", code$)
        names = APPEND(names, pair[0])
    NEXT
    RETURN names
ENDFUNC

' Adds the names the source defines to known; a builtin's name never: the
' definition would fail, and a call of the name would reach the builtin.
' Read from the raw text: a name taken from a string or a comment is no
' builtin, so a call of it reaches nothing.
EXPORT SUB LEARN(source$, known)
    DIM builtin$ AS STRING = BUILTINS$()
    FOR EACH name$ IN DEFINED(UCASE$(source$))
        IF INSTR(builtin$, "," + name$ + ",") < 0 ANDALSO LEFT$(name$, 2) <> "__" THEN known{name$} = TRUE
    NEXT
ENDSUB

' The statements of a line: split at a colon outside brackets and after
' THEN and ELSE.
FUNC STATEMENTS(row$)
    DIM out = []
    DIM depth = 0
    DIM begin = 0
    DIM k = 0
    DIM last = IIF(INSTR(row$, ":") < 0, -1, LEN(row$) - 1)
    FOR k = 0 TO last
        DIM ch$ = MID$(row$, k, 1)
        IF ch$ = "(" ORELSE ch$ = "[" ORELSE ch$ = "{" THEN depth = depth + 1
        IF ch$ = ")" ORELSE ch$ = "]" ORELSE ch$ = "}" THEN depth = depth - 1
        IF ch$ = ":" ANDALSO depth = 0 THEN
            out = APPEND(out, MID$(row$, begin, k - begin))
            begin = k + 1
        ENDIF
    NEXT k
    out = APPEND(out, MID$(row$, begin))
    DIM parts = []
    FOR EACH one$ IN out
        FOR EACH piece$ IN SPLIT(REGEX.REPLACE$("(^|[^A-Z0-9_$])(THEN|ELSE)([^A-Z0-9_$]|$)", one$, "$1" + CHR$(1) + "$3"), CHR$(1))
            parts = APPEND(parts, piece$)
        NEXT
    NEXT
    RETURN parts
ENDFUNC

' "" when the source keeps the contract, given the names known before it;
' else why not.
EXPORT FUNC CHECK$(source$, known) AS STRING
    IF LEN(source$) > 65536 THEN RETURN "longer than 64 KB"
    DIM code$ = BARE$(source$)
    ' the session tokens stay with the kernel
    IF LEN(REGEX.FINDALL("(^|[^_A-Z])TOKEN", UCASE$(source$))) > 0 THEN RETURN "touches a session token"
    ' JDB.GLOBAL_GET("W") and ("C") became PATCH_WORLD; any other form is left as a refused name
    IF INSTR(code$, "JDB.GLOBAL_GET") >= 0 THEN RETURN "reads a global other than W or C"
    ' an interpolated string runs the code inside its braces
    IF LEN(REGEX.FINDALL("(^|[^A-Z0-9_])[$]", code$)) > 0 THEN RETURN "uses an interpolated string"
    DIM kernel = KERNEL_NAMES()
    DIM services = KERNEL_CALLS()
    DIM own = DEFINED(code$)
    DIM builtin_set = {}
    FOR EACH one$ IN SPLIT(BUILTINS$(), ",")
        IF one$ <> "" THEN builtin_set{one$} = TRUE
    NEXT
    FOR EACH name$ IN own
        IF INDEXOF(kernel, name$) >= 0 ORELSE INDEXOF(services, name$) >= 0 THEN RETURN "defines the kernel's " + name$
        IF MAP.EXISTS(builtin_set, name$) THEN RETURN "defines the builtin " + name$
    NEXT
    DIM spaces = OPEN_SPACES()
    DIM members = OPEN_MEMBERS()
    DIM shut = SHUT_WORDS()
    DIM seen = {}
    FOR EACH word$ IN REGEX.FINDALL("[A-Z_][A-Z0-9_.$]*", code$)
        IF MAP.EXISTS(seen, word$) THEN CONTINUEFOR
        seen{word$} = TRUE
        DIM dot = INSTR(word$, ".")
        IF LEFT$(word$, 2) = "__" THEN RETURN "uses " + word$
        IF dot >= 0 THEN
            IF INDEXOF(spaces, LEFT$(word$, dot)) < 0 ANDALSO INDEXOF(members, word$) < 0 THEN RETURN "uses " + word$
        ELSEIF INDEXOF(shut, word$) >= 0 THEN
            RETURN "uses " + word$
        ELSEIF INDEXOF(kernel, word$) >= 0 THEN
            RETURN "touches the kernel's " + word$
        ENDIF
    NEXT
    ' what a statement may begin with, and what may be called
    DIM may_begin = {}
    FOR EACH one$ IN APPEND(APPEND(APPEND(KEYWORDS(), SAFE_STATEMENTS()), services), own)
        may_begin{one$} = TRUE
    NEXT
    DIM may_call = {}
    FOR EACH one$ IN MAP.KEYS(may_begin)
        may_call{one$} = TRUE
    NEXT
    FOR EACH one$ IN SAFE_CALLS()
        may_call{one$} = TRUE
    NEXT
    ' a variable that holds a function is called only by a name ending in _FN:
    ' a builtin of the same name would win over any other variable
    FOR EACH hit IN REGEX.FINDALL("DIM[ \t]+([A-Z_][A-Z0-9_]*_FN)(?=[^A-Z0-9_$])", code$)
        may_call{hit[0]} = TRUE
    NEXT
    ' every call names something known
    ' (a dotted name was judged with the words above)
    DIM asked = {}
    FOR EACH hit$ IN REGEX.FINDALL("[A-Z_][A-Z0-9_.$]*[ \t]*[(@]", code$)
        DIM called$ = TRIM$(LEFT$(hit$, LEN(hit$) - 1))
        IF INSTR(called$, ".") < 0 ANDALSO NOT MAP.EXISTS(asked, called$) THEN
            asked{called$} = TRUE
            IF NOT MAP.EXISTS(may_call, called$) ANDALSO NOT MAP.EXISTS(known, called$) THEN RETURN "calls " + called$
        ENDIF
    NEXT
    ' every statement is a keyword, an assignment, a known call or a drawing;
    ' each statement goes on a line of its own first
    DIM lines$ AS STRING = REGEX.REPLACE$("(^|[^A-Z0-9_$])(THEN|ELSE)(?=[^A-Z0-9_$]|$)", code$, "$1$2" + CHR$(10))
    IF INSTR(lines$, ":") >= 0 THEN
        DIM rows = SPLIT(lines$, CHR$(10))
        DIM r = 0
        FOR r = 0 TO LEN(rows) - 1
            IF INSTR(rows[r], ":") >= 0 THEN rows[r] = JOIN(STATEMENTS(rows[r]), CHR$(10))
        NEXT r
        lines$ = JOIN(rows, CHR$(10))
    ENDIF
    FOR EACH head$ IN REGEX.FINDALL("\n[ \t]*[A-Z_][A-Z0-9_.$]*[ \t]*[^\n]?", CHR$(10) + lines$)
        DIM bare$ = TRIM$(head$)
        DIM first$ = REGEX.REPLACE$("[^A-Z0-9_.$].*$", bare$, "")
        DIM after$ = LEFT$(TRIM$(MID$(bare$, LEN(first$))), 1)
        ' a builtin that begins a statement is one of the lists, whatever follows it
        ' (a dotted one was judged with the words above)
        IF NOT MAP.EXISTS(may_begin, first$) ANDALSO INSTR(first$, ".") < 0 ANDALSO MAP.EXISTS(builtin_set, first$) THEN RETURN "statement " + first$
        DIM assigns = after$ = "=" ORELSE after$ = "{" ORELSE after$ = "[" ORELSE after$ = "+" ORELSE after$ = "-" ORELSE after$ = "*" ORELSE after$ = "/"
        ' a member of an open namespace, as a statement
        DIM at_dot = INSTR(first$, ".")
        IF at_dot >= 0 THEN assigns = assigns ORELSE INDEXOF(spaces, LEFT$(first$, at_dot)) >= 0 ORELSE INDEXOF(members, first$) >= 0
        IF NOT assigns ANDALSO NOT MAP.EXISTS(may_begin, first$) ANDALSO NOT MAP.EXISTS(known, first$) THEN
            ' a call with brackets was judged above
            IF after$ <> "(" THEN RETURN "statement " + first$
        ENDIF
    NEXT
    RETURN ""
ENDFUNC
