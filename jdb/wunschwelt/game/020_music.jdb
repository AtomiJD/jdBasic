' Music of the village. The world holds the style everyone hears; a wish
' ("spiel ein bisschen Techno") changes it at once for four minutes, then
' the village theme comes back. A sentence that asks for music is granted
' wherever it is said, without the model. Every client plays the style with
' the sequencer: a soft village theme, tavern and fest in the chiptune
' manner of fluppi's themes, evening calm, techno in the manner of
' jdb/demos/sound/trance_live. Hip-hop, 80s pop, synthwave, house, trance,
' disco, lo-fi, rock and techno are made from a seed by the module MELODY of
' jdb/demos/sound, so every wish brings a new piece: the seed picks key,
' chords, tempo, hook, bass, arp or chord stabs, the sounds, the groove of
' the drums with a fill every fourth bar, a percussion rhythm and one of
' three forms; the second main part plays the hook varied with an answer.
' M mutes and unmutes. A browser lets sound start only after a key press, so
' the music starts with the first key.

'@server

FUNC RuleMusicStyles()
    RETURN {"village": "Dorfmusik", "tavern": "Tavernenmusik", "evening": "Abendmusik", "fest": "Festmusik", "techno": "Techno", "hiphop": "Hip-Hop", "pop80": "80er-Pop", "synthwave": "Synthwave", "house": "House", "trance": "Trance", "disco": "Disco", "lofi": "Lo-Fi", "rock": "Rock"}
ENDFUNC

FUNC RuleApplyMusic(w, who$, verdict)
    DIM style$ = LCASE$(TRIM$("" + (verdict{"music"} ?? "")))
    DIM styles = RuleMusicStyles()
    IF NOT MAP.EXISTS(styles, style$) THEN style$ = RuleMusicGuess$(style$ + " " + ("" + (verdict{"text"} ?? "")) + " " + ("" + (verdict{"said"} ?? "")))
    IF NOT MAP.EXISTS(styles, style$) THEN RETURN FALSE
    DIM now_m = w{"music"} ?? {}
    IF ISMAP(now_m) ANDALSO (now_m{"style"} ?? "") = style$ ANDALSO (now_m{"until"} ?? 0) - KNow() > 230000 THEN RETURN TRUE
    ' each wish a new piece: the seed picks key, chords, hook and bass
    w{"music"} = {"style": style$, "seed": 1 + (KNow() \ 7) MOD 9973, "by": who$, "until": KNow() + 240000}
    KEmit(w, {"type": "music", "who": who$, "text": who$ + RuleDe$(" w{u}nscht sich ") + styles{style$}})
    RETURN TRUE
ENDFUNC

' The style a sentence speaks of, when the judge did not name it.
FUNC RuleMusicGuess$(text$)
    DIM low$ = LCASE$(text$)
    DIM words = [["hip hop", "hiphop"], ["hip-hop", "hiphop"], ["hiphop", "hiphop"], ["rap", "hiphop"], ["80er", "pop80"], ["achtziger", "pop80"], ["80s", "pop80"], ["synthwave", "synthwave"], ["retro", "synthwave"], ["house", "house"], ["trance", "trance"], ["disco", "disco"], ["lofi", "lofi"], ["lo-fi", "lofi"], ["chill", "lofi"], ["rock", "rock"], ["pop", "pop80"], ["techno", "techno"], ["elektro", "techno"], ["rave", "techno"], ["beat", "techno"], ["tavern", "tavern"], ["kneipe", "tavern"], ["wirtshaus", "tavern"], ["abend", "evening"], ["ruhig", "evening"], ["leise", "evening"], ["entspann", "evening"], ["fest", "fest"], ["party", "fest"], ["tanz", "fest"], ["feier", "fest"], ["dorf", "village"], ["village", "village"], ["evening", "evening"]]
    DIM i = 0
    FOR i = 0 TO LEN(words) - 1
        IF INSTR(low$, words[i][0]) >= 0 THEN RETURN words[i][1]
    NEXT i
    RETURN ""
ENDFUNC

' The style a sentence asks to be played, or "": it must speak of music
' and ask for it, so a wish for a village fest stays a wish for the board.
FUNC RuleMusicAsked$(said$)
    DIM low$ = RuleLookColorKey$(said$)
    DIM speaks = FALSE
    DIM asks = FALSE
    FOR EACH word$ IN ["musik", "lied", "song", "melodie", "techno", "beat", "sound", "hip hop", "hip-hop", "hiphop", "disco", "trance", "synthwave", "80er", "lofi", "lo-fi"]
        IF INSTR(low$, word$) >= 0 THEN speaks = TRUE
    NEXT
    ' words that also mean a skirt, a field or a house count only with play
    IF LEN(REGEX.FINDALL("(^|[^a-z])(rock|rap|pop|house|chill)([^a-z]|$)", low$)) > 0 ANDALSO INSTR(low$, "spiel") >= 0 THEN speaks = TRUE
    FOR EACH word$ IN ["spiel", "mach", "leg ", "lass", "will", "moecht", "wuensch", "haett", "bitte", "gib", "dreh", "kannst", "lieber"]
        IF INSTR(low$, word$) >= 0 THEN asks = TRUE
    NEXT
    IF NOT speaks ORELSE NOT asks THEN RETURN ""
    RETURN RuleMusicGuess$(low$)
ENDFUNC

' A request for music is granted wherever it is said, without the model.
SUB RuleHeard(w, p, said$)
    DIM style$ = RuleMusicAsked$(said$)
    IF style$ <> "" THEN RuleApplyMusic(w, p{"name"}, {"music": style$})
    ' a name, something to wear or a call for an animal is done at once and is no wish
    DIM handled = RuleBuildRename(w, p, said$)
    IF NOT handled THEN handled = RuleBasketSaid(w, p, said$)
    IF NOT handled THEN handled = RuleAnimalDress(w, p, said$)
    IF NOT handled THEN handled = RuleAnimalCall(w, p, said$)
    IF NOT handled THEN handled = RuleLookAsked(w, p, said$)
    p{"renamed"} = IIF(handled, said$, "")
ENDSUB

FUNC RuleMusicNow$(w)
    DIM m = w{"music"} ?? {}
    IF NOT ISMAP(m) ORELSE NOT MAP.EXISTS(m, "style") THEN RETURN "village:1"
    IF KNow() > (m{"until"} ?? 0) THEN RETURN "village:1"
    RETURN m{"style"} + ":" + STR$(m{"seed"} ?? 1)
ENDFUNC

'@client

' The music a style has when MELODY makes it; the seed picks one of each
' list: the tempo between bpm[0] and bpm[1], key, progression, bass figure,
' arp shape ("stabs:" and a rhythm mask for chord stabs, "" none), kick,
' snare or clap and hats (one bar each), the fill that ends every fourth
' bar, the sounds of lead and pad [wave, attack, decay, sustain, release,
' cutoff], and keys [wave, cutoff] for arp and stabs. oct is the octave of
' the hook, room leaves the end of each bar free for an answer. fallback is
' the style played when MELODY is not there.
FUNC ClientGenre(style$)
    DIM g = {}
    g{"hiphop"} = {"bpm": [84, 94], "keys": ["A minor", "D minor", "E minor", "C minor", "G minor", "F minor"], "progs": ["deep", "dark", "epic"], "bass": ["sub"], "arps": ["stabs:x..x....x.x.....", "stabs:x.....x...x.x...", "stabs:x...x.....x....."], "oct": 4, "room": TRUE, "kicks": ["bd ~ ~ ~ ~ ~ ~ bd ~ ~ bd ~ ~ ~ ~ ~", "bd ~ ~ bd ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~", "bd ~ ~ ~ ~ ~ bd ~ ~ bd ~ ~ ~ ~ bd ~"], "snares": ["~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~", "~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ sd"], "fills": ["~ ~ ~ ~ sd ~ ~ ~ ~ ~ sd ~ sd sd sd sd", "~ ~ ~ ~ sd ~ ~ sd ~ ~ ~ ~ sd ~ sd sd"], "hats": ["swing(4, hh*8)", "swing(4, gain([0.8 0.45]*4, hh*8))", "swing(4, gain([0.7 0.4 0.55 0.4]*4, hh*16))"], "leads": [["TRIANGLE", 0.02, 0.4, 0.6, 0.5, 1500], ["SINE", 0.03, 0.4, 0.7, 0.6, 1300], ["SAW", 0.02, 0.3, 0.6, 0.4, 900]], "pads": [["SINE", 0.6, 0.5, 0.7, 1.2, 1200]], "keys_voice": ["SQUARE", 850], "fallback": "evening"}
    g{"lofi"} = {"bpm": [72, 82], "keys": ["D dorian", "A minor", "E dorian", "C major", "F major", "G dorian"], "progs": ["deep", "euphoric", "pop"], "bass": ["sub"], "arps": ["stabs:x.......x.......", "up", ""], "oct": 4, "room": TRUE, "kicks": ["bd ~ ~ ~ ~ ~ bd ~ ~ ~ bd ~ ~ ~ ~ ~", "bd ~ ~ ~ ~ ~ ~ ~ bd ~ bd ~ ~ ~ ~ ~"], "snares": ["~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~"], "fills": ["~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ sd sd"], "hats": ["swing(4, gain(0.5, hh*8))", "swing(4, gain([0.5 0.3]*4, hh*8))"], "leads": [["TRIANGLE", 0.02, 0.4, 0.6, 0.6, 1400], ["SINE", 0.03, 0.5, 0.7, 0.8, 1200]], "pads": [["SINE", 0.8, 0.5, 0.8, 1.6, 1000], ["TRIANGLE", 0.8, 0.5, 0.8, 1.6, 900]], "keys_voice": ["TRIANGLE", 1000], "fallback": "evening"}
    g{"pop80"} = {"bpm": [112, 122], "keys": ["C major", "G major", "D major", "A major", "F major", "E major"], "progs": ["pop", "euphoric"], "bass": ["drive", "octave"], "arps": ["up", "updown", "octave"], "oct": 5, "room": FALSE, "kicks": ["bd ~ bd ~", "bd ~ [~ bd] ~", "bd ~ bd [~ bd]"], "snares": ["~ sd ~ sd"], "fills": ["~ sd [~ sd] [sd sd sd sd]", "~ sd [ht ht mt mt] [lt lt lt ~]"], "hats": ["hh*8", "[~ hh]*4", "gain([0.7 0.4]*4, hh*8)"], "leads": [["SQUARE", 0.01, 0.25, 0.6, 0.3, 3000], ["SAW", 0.02, 0.3, 0.6, 0.3, 2600]], "pads": [["SAW", 0.3, 0.4, 0.7, 0.8, 1600]], "keys_voice": ["SQUARE", 1800], "fallback": "fest"}
    g{"synthwave"} = {"bpm": [100, 108], "keys": ["A minor", "F# minor", "E minor", "D minor", "C minor", "B minor"], "progs": ["outrun", "epic", "anthem"], "bass": ["drive"], "arps": ["updown", "up", "threes"], "oct": 5, "room": FALSE, "kicks": ["bd ~ ~ ~ bd ~ ~ ~", "bd ~ ~ bd bd ~ ~ ~", "bd*4"], "snares": ["~ sd ~ sd"], "fills": ["~ sd [ht ht mt mt] [lt lt lt ~]", "~ sd [~ sd] [sd sd sd sd]"], "hats": ["[~ hh]*4", "gain([0.7 0.45]*4, hh*8)", "hh*8"], "leads": [["SAW", 0.02, 0.3, 0.7, 0.4, 2400], ["SQUARE", 0.02, 0.3, 0.6, 0.4, 2000]], "pads": [["SAW", 0.6, 0.5, 0.8, 1.4, 1400]], "keys_voice": ["SQUARE", 1800], "fallback": "evening"}
    g{"house"} = {"bpm": [120, 126], "keys": ["A minor", "G minor", "C minor", "D minor", "F minor", "E minor"], "progs": ["house", "deep"], "bass": ["octave", "offbeat"], "arps": ["stabs:x.x..x.x x.x.x...", "stabs:..x...x...x...x.", "stabs:x..x..x...x..x.."], "oct": 5, "room": FALSE, "kicks": ["bd*4"], "snares": ["~ cp ~ cp", "~ cp ~ [cp ~ ~ cp]"], "fills": ["~ cp [~ cp] [cp cp cp cp]"], "hats": ["[~ oh]*4", "[~ oh]*4, gain(0.35, hh*16)", "swing(4, [~ hh]*4), [~ oh]*4"], "leads": [["SQUARE", 0.01, 0.2, 0.6, 0.3, 2600], ["SAW", 0.01, 0.25, 0.6, 0.3, 2200]], "pads": [["SAW", 0.4, 0.4, 0.7, 1.0, 1500]], "keys_voice": ["SQUARE", 1600], "fallback": "fest"}
    g{"trance"} = {"bpm": [134, 140], "keys": ["A minor", "F minor", "C# minor", "D minor", "G minor", "E minor"], "progs": ["epic", "anthem", "euphoric"], "bass": ["offbeat"], "arps": ["updown", "threes", "pedal"], "oct": 5, "room": FALSE, "kicks": ["bd*4"], "snares": ["~ cp ~ cp"], "fills": ["~ cp [~ cp] [cp cp cp cp]", "~ cp [cp cp] [cp cp cp cp]"], "hats": ["[~ oh]*4", "[~ oh]*4, gain([0.5 0.3]*8, hh*16)"], "leads": [["SAW", 0.01, 0.3, 0.7, 0.3, 3800], ["SQUARE", 0.01, 0.3, 0.6, 0.3, 3200]], "pads": [["SAW", 0.8, 0.5, 0.8, 1.6, 1800]], "keys_voice": ["SAW", 2200], "fallback": "techno"}
    g{"disco"} = {"bpm": [114, 122], "keys": ["A minor", "D minor", "E minor", "G minor", "C major", "F major"], "progs": ["euphoric", "pop", "house"], "bass": ["octave"], "arps": ["octave", "stabs:x.x...x.x.x...x.", "up"], "oct": 5, "room": FALSE, "kicks": ["bd*4"], "snares": ["~ cp ~ cp", "~ [cp,sd] ~ [cp,sd]"], "fills": ["~ cp [~ cp] [cp cp cp cp]"], "hats": ["[~ oh]*4", "[~ oh]*4, gain(0.4, hh*16)"], "leads": [["SQUARE", 0.01, 0.25, 0.6, 0.3, 3000], ["SAW", 0.01, 0.25, 0.6, 0.3, 2600]], "pads": [["SAW", 0.3, 0.4, 0.8, 0.8, 2200]], "keys_voice": ["SQUARE", 2000], "fallback": "fest"}
    g{"rock"} = {"bpm": [120, 136], "keys": ["E minor", "A minor", "D minor", "G major", "D major", "A major"], "progs": ["anthem", "epic", "pop"], "bass": ["drive"], "arps": ["", "stabs:x.x.x.x.x.x.x.x."], "oct": 5, "room": FALSE, "kicks": ["bd ~ ~ bd ~ ~ bd ~", "bd ~ bd ~ ~ ~ bd ~", "bd ~ ~ ~ bd bd ~ ~"], "snares": ["~ sd ~ sd"], "fills": ["~ sd [ht ht mt mt] [lt lt lt ~]", "~ sd [sd sd] [sd sd sd sd]"], "hats": ["hh*8", "[hh oh]*4"], "leads": [["SAW", 0.005, 0.2, 0.7, 0.2, 3000], ["SQUARE", 0.005, 0.2, 0.7, 0.2, 2600]], "pads": [["SQUARE", 0.01, 0.3, 0.7, 0.3, 1200]], "keys_voice": ["SAW", 1600], "fallback": "fest"}
    g{"techno"} = {"bpm": [128, 134], "keys": ["A minor", "F minor", "D minor", "G minor", "C minor", "E minor"], "progs": ["dark", "deep", "epic"], "bass": ["offbeat", "acid"], "arps": ["up", "pedal", "threes"], "oct": 5, "room": TRUE, "kicks": ["bd*4"], "snares": ["~ cp ~ cp", "~ ~ cp ~"], "fills": ["~ cp [~ cp] [cp cp cp cp]"], "hats": ["[~ oh]*4, gain([0.35 0.6 0.45 0.8]*4, hh*16)", "[~ oh]*4", "gain([0.4 0.7]*8, hh*16)"], "leads": [["SAW", 0.01, 0.3, 0.6, 0.3, 2400], ["SQUARE", 0.01, 0.25, 0.6, 0.3, 1800]], "pads": [["SAW", 0.9, 0.5, 0.8, 1.6, 1100]], "keys_voice": ["SAW", 1400], "fallback": "techno"}
    RETURN g{style$} ?? {}
ENDFUNC

' The k-th choice of a seed among n, the same for the same seed and k.
FUNC ClientPick(seed, k, n)
    RETURN CODEC.CRC32(STR$(seed) + ":" + STR$(k)) MOD MAX([1, n])
ENDFUNC

' TRUE once the module MELODY is loaded; it lies beside client.jdb.
FUNC ClientMelodyReady()
    DIM cs = JDB.GLOBAL_GET("C")
    IF NOT MAP.EXISTS(cs, "melody_ok") THEN
        cs{"melody_ok"} = FALSE
        TRY
            EXECUTE("IMPORT MELODY")
            cs{"melody_ok"} = TRUE
        CATCH
            cs{"last_error"} = "music: no MELODY, " + ERRMSG$
        ENDTRY
    ENDIF
    RETURN cs{"melody_ok"}
ENDFUNC

' The melody voice of track 0, full rather than plucked: the wave of the
' style with three detuned voices, a second oscillator (a sine an octave
' down under the soft waves, a saw a few cents off under the bright ones),
' a gentle vibrato, notes that sing on, and a dotted-eighth echo.
SUB ClientLead(wave$, attack, decay, sustain, release, cutoff)
    SOUND.VOICE 0, wave$, MAX([attack, 0.015]), MAX([decay, 0.3]), MAX([sustain, 0.6]), MAX([release, 0.35])
    SOUND.UNISON 0, 3, 0.12, 0.6
    IF wave$ = "TRIANGLE" ORELSE wave$ = "SINE" THEN
        SOUND.OSC2 0, "SINE", -12, 0.35
    ELSE
        SOUND.OSC2 0, "SAW", 0, 0.3, 7
    ENDIF
    SOUND.FILTER 0, cutoff
    SOUND.LFO 0, 5.2, 0.12
    SOUND.DELAY TRUE, "1/8.", 0.3, 0.22
    SOUND.DELAYSEND 0, 0.22
    SOUND.REVERBSEND 0, 0.3
ENDSUB

' A piece of a style from its seed: sets the sounds and returns the
' patterns [lead, bass, pad, arp, kick, snare, hats, percussion], the
' varied hook and the answer for the second main part, and the form.
FUNC ClientMusicMake(g, seed)
    DIM keys = g{"keys"}
    DIM key$ = keys[ClientPick(seed, 1, LEN(keys))]
    DIM progs = g{"progs"}
    DIM prog$ = MELODY.PROG$(progs[ClientPick(seed, 2, LEN(progs))], key$)
    DIM hook$ = MELODY.HOOK$(seed, prog$, key$, MELODY.RHYTHM$(seed, g{"room"}), g{"oct"})
    DIM vary$ = MELODY.VARY$(hook$, prog$, key$, IIF(ClientPick(seed, 3, 2) = 0, "octave", "dense"))
    DIM answer$ = MELODY.COUNTER$(seed, hook$, prog$, key$, g{"oct"})
    DIM bass_kind$ = g{"bass"}[ClientPick(seed, 4, LEN(g{"bass"}))]
    DIM bass$ = "legato(" + IIF(bass_kind$ = "sub", "1", "0.7") + ", " + MELODY.BASS$(prog$, bass_kind$, seed) + ")"
    DIM arp_kind$ = g{"arps"}[ClientPick(seed, 5, LEN(g{"arps"}))]
    DIM arp$ = ""
    IF STARTSWITH(arp_kind$, "stabs:") THEN
        arp$ = MELODY.STABS$(prog$, MID$(arp_kind$, 6))
    ELSEIF arp_kind$ <> "" THEN
        arp$ = "legato(0.5, " + MELODY.ARP$(prog$, arp_kind$, IIF(g{"room"}, 8, 16), 1) + ")"
    ENDIF
    DIM pad$ = "<" + prog$ + ">"
    DIM bpm = g{"bpm"}[0] + ClientPick(seed, 6, g{"bpm"}[1] - g{"bpm"}[0] + 1)
    SOUND.BPM bpm
    DIM lead = g{"leads"}[ClientPick(seed, 7, LEN(g{"leads"}))]
    ClientLead(lead[0], lead[1], lead[2], lead[3], lead[4], lead[5])
    SOUND.VOICE 1, IIF(bass_kind$ = "sub", "SINE", "SAW"), 0.005, 0.15, 0.6, 0.1
    SOUND.FILTER 1, IIF(bass_kind$ = "sub", 400, IIF(bass_kind$ = "acid", 900, 700))
    IF bass_kind$ = "sub" THEN SOUND.GLIDE 1, 50
    IF bass_kind$ = "acid" THEN SOUND.GLIDE 1, 60, "SLIDE"
    DIM pad = g{"pads"}[ClientPick(seed, 8, LEN(g{"pads"}))]
    SOUND.VOICE 2, pad[0], pad[1], pad[2], pad[3], pad[4]
    SOUND.FILTER 2, pad[5]
    SOUND.UNISON 2, 3, 0.2, 0.8
    SOUND.REVERBSEND 2, 0.5
    DIM kv = g{"keys_voice"}
    IF STARTSWITH(arp_kind$, "stabs:") THEN
        SOUND.VOICE 3, kv[0], 0.005, 0.3, 0.35, 0.3
        SOUND.UNISON 3, 2, 0.08, 0.5
    ELSE
        SOUND.VOICE 3, kv[0], 0.002, 0.12, 0.3, 0.1
    ENDIF
    SOUND.FILTER 3, kv[1]
    SOUND.REVERBSEND 3, 0.25
    SOUND.DELAYSEND 3, 0.15
    ' drums: a groove for the piece, a fill at the end of every fourth bar
    DIM kick$ = g{"kicks"}[ClientPick(seed, 9, LEN(g{"kicks"}))]
    DIM snare_bar$ = g{"snares"}[ClientPick(seed, 10, LEN(g{"snares"}))]
    DIM fill$ = g{"fills"}[ClientPick(seed, 11, LEN(g{"fills"}))]
    DIM snare$ = "<[" + snare_bar$ + "] [" + snare_bar$ + "] [" + snare_bar$ + "] [" + fill$ + "]>"
    DIM hats$ = g{"hats"}[ClientPick(seed, 12, LEN(g{"hats"}))]
    DIM perc_sounds = ["rim", "cb", "sh", "cl"]
    DIM perc_steps = ["3,8", "5,8", "5,16", "7,16", "3,16"]
    DIM perc$ = "gain(0.45, " + perc_sounds[ClientPick(seed, 13, LEN(perc_sounds))] + "(" + perc_steps[ClientPick(seed, 14, LEN(perc_steps))] + "," + STR$(ClientPick(seed, 15, 8)) + "))"
    SOUND.REVERBSEND 5, IIF(INSTR(snare_bar$, "sd") >= 0, 0.35, 0.15)
    RETURN [hook$, bass$, pad$, arp$, kick$, snare$, hats$, perc$, vary$, "legato(0.9, " + answer$ + ")", ClientForm(ClientPick(seed, 16, 3))]
ENDFUNC

' The forms a piece walks through: scenes of a name, bars and the tracks
' that play (0 lead, 1 bass, 2 pad, 3 arp, 4 kick, 5 snare, 6 hats, 7
' percussion); every form lasts a multiple of four bars, so the fills end
' its phrases. The second main part plays the varied hook and its answer.
FUNC ClientForm(n)
    DIM forms = [[["intro", 4, [2, 6]], ["rising", 4, [1, 2, 3, 6]], ["main", 8, [0, 1, 2, 3, 4, 5, 6, 7]], ["chill", 4, [0, 1, 2]], ["main2", 8, [0, 1, 2, 3, 4, 5, 6, 7]], ["outro", 4, [1, 2, 4]]], [["intro", 8, [2, 3, 4]], ["main", 8, [0, 1, 2, 4, 5, 6]], ["break", 4, [2, 3]], ["rising", 4, [1, 2, 3, 4, 6]], ["main2", 8, [0, 1, 2, 3, 4, 5, 6, 7]]], [["intro", 4, [1, 4, 6]], ["rising", 4, [1, 2, 3, 4, 6, 7]], ["main", 8, [0, 1, 2, 3, 4, 5, 6, 7]], ["chill", 4, [0, 2, 3]], ["rising", 4, [1, 2, 3, 4, 6]], ["main2", 8, [0, 1, 2, 3, 4, 5, 6, 7]], ["outro", 4, [2, 3]]]]
    RETURN forms[CLAMP(n, 0, LEN(forms) - 1)]
ENDFUNC

' Keeps the scene of the bar that plays: mutes the tracks it leaves out,
' swaps the hook for the varied one and the arp for the answer in the
' second main part.
SUB ClientMusicScene(c)
    IF (c{"music_on"} ?? "off") = "off" ORELSE NOT (c{"sound_up"} ?? FALSE) THEN RETURN
    DIM scenes = c{"music_form"} ?? ClientForm(0)
    DIM total = 0
    FOR EACH sc IN scenes
        total = total + sc[1]
    NEXT
    DIM bar = INT(SOUND.CYCLE()) MOD MAX([1, total])
    DIM at = 0
    DIM pick = 0
    DIM i = 0
    FOR i = 0 TO LEN(scenes) - 1
        IF bar >= at THEN pick = i
        at = at + scenes[i][1]
    NEXT i
    IF pick = (c{"music_scene"} ?? -1) THEN RETURN
    c{"music_scene"} = pick
    DIM names = {"village": "Dorfmusik", "tavern": "Tavernenmusik", "evening": "Abendmusik", "fest": "Festmusik", "techno": "Techno", "hiphop": "Hip-Hop", "pop80": "80er-Pop", "synthwave": "Synthwave", "house": "House", "trance": "Trance", "disco": "Disco", "lofi": "Lo-Fi", "rock": "Rock"}
    DIM parts_de = {"intro": "Intro", "rising": "Aufbau", "main": "Refrain", "chill": "Chill", "break": "Pause", "main2": "Refrain 2", "outro": "Outro"}
    c{"music_label"} = (names{c{"music_style"} ?? ""} ?? "") + " - " + (parts_de{scenes[pick][0]} ?? "")
    DIM plays = scenes[pick][2] + 0
    ' a scene whose tones this piece does not have keeps the melody
    DIM has = c{"music_has"} ?? []
    DIM tones = FALSE
    FOR i = 0 TO 3
        IF INDEXOF(plays, i) >= 0 ANDALSO INDEXOF(has, i) >= 0 THEN tones = TRUE
    NEXT i
    IF NOT tones THEN plays = APPEND(plays, 0)
    DIM t = 0
    FOR t = 0 TO 7
        SOUND.MUTE t, INDEXOF(plays, t) < 0 ORELSE INDEXOF(has, t) < 0
    NEXT t
    IF (c{"music_vary"} ?? "") <> "" THEN
        IF scenes[pick][0] = "main2" THEN
            SOUND.SEQ 0, c{"music_vary"}, "VOICE"
            IF (c{"music_answer"} ?? "") <> "" THEN SOUND.SEQ 3, c{"music_answer"}, "VOICE"
        ELSE
            SOUND.SEQ 0, c{"music_hook"}, "VOICE"
            IF (c{"music_arp"} ?? "") <> "" THEN SOUND.SEQ 3, c{"music_arp"}, "VOICE"
        ENDIF
    ENDIF
ENDSUB

' Plays want$, a style and its seed ("hiphop:42"). Tracks: 0 melody, 1 bass, 2 pad,
' 3 arp, 4 kick, 5 clap, 6 hats, 7 percussion.
SUB ClientMusicPlay(want$)
    DIM cs = JDB.GLOBAL_GET("C")
    DIM parts = SPLIT(want$ + ":1", ":")
    DIM style$ = parts[0]
    DIM seed = MAX([1, INT(VAL(parts[1]))])
    DIM g = ClientGenre(style$)
    DIM made = []
    IF MAP.SIZE(g) > 0 THEN
        IF NOT ClientMelodyReady() THEN style$ = g{"fallback"}
    ENDIF
    cs{"music_vary"} = ""
    cs{"music_answer"} = ""
    cs{"music_arp"} = ""
    cs{"music_form"} = ClientForm(0)
    cs{"music_scene"} = -1
    cs{"music_style"} = style$
    SOUND.RESET
    SOUND.MASTER "FIXED", 0.32
    SOUND.REVERB 0.7, 0.4, 0.8, 0.3
    DIM mel$ = ""
    DIM bass$ = ""
    DIM pad$ = ""
    DIM arp$ = ""
    DIM kick$ = ""
    DIM clap$ = ""
    DIM hats$ = ""
    DIM perc$ = ""
    IF MAP.SIZE(g) > 0 ANDALSO (cs{"melody_ok"} ?? FALSE) THEN
        made = ClientMusicMake(g, seed)
        mel$ = made[0]
        bass$ = made[1]
        pad$ = made[2]
        arp$ = made[3]
        kick$ = made[4]
        clap$ = made[5]
        hats$ = made[6]
        perc$ = made[7]
        cs{"music_answer"} = made[9]
        cs{"music_arp"} = made[3]
        cs{"music_form"} = made[10]
        cs{"music_hook"} = made[0]
        cs{"music_vary"} = made[8]
    ELSEIF style$ = "tavern" THEN
        SOUND.BPM 120
        ClientLead("TRIANGLE", 0.01, 0.2, 0.5, 0.2, 2600)
        SOUND.VOICE 1, "SQUARE", 0.005, 0.1, 0.4, 0.08
        SOUND.FILTER 1, 700
        mel$ = "<[d5 f5 a5 d6 a5 f5] [c5 e5 g5 c6 g5 e5] [bb4 d5 f5 bb5 f5 d5] [a4 c#5 e5 a5 g5 e5]>"
        bass$ = "<[d2 ~ ~ a2 ~ ~] [c2 ~ ~ g2 ~ ~] [bb1 ~ ~ f2 ~ ~] [a1 ~ ~ e2 ~ ~]>"
        perc$ = "[rim ~ ~ rim ~ rim]"
        hats$ = "[~ ~ hh ~ ~ hh]"
    ELSEIF style$ = "evening" THEN
        SOUND.BPM 76
        ClientLead("TRIANGLE", 0.05, 0.4, 0.6, 0.8, 2000)
        SOUND.VOICE 2, "SINE", 0.8, 0.5, 0.8, 1.6
        SOUND.UNISON 2, 3, 0.2, 0.8
        SOUND.REVERBSEND 0, 0.5
        SOUND.REVERBSEND 2, 0.6
        mel$ = "<[e5 ~ ~ c5] [a4 ~ ~ ~] [g4 ~ e5 ~] [d5 ~ ~ ~]>"
        pad$ = "<[a3,c4,e4] [f3,a3,c4] [c4,e4,g4] [g3,b3,d4]>"
        bass$ = "<a1 f1 c2 g1>"
        SOUND.VOICE 1, "SINE", 0.05, 0.3, 0.7, 0.6
    ELSEIF style$ = "fest" THEN
        SOUND.BPM 128
        ClientLead("SQUARE", 0.01, 0.25, 0.55, 0.3, 2600)
        SOUND.VOICE 1, "SAW", 0.005, 0.1, 0.5, 0.1
        SOUND.FILTER 1, 600
        mel$ = "[[d5 [f5 a5] d6 ~] [c5 [e5 g5] c6 ~] [b4 [d5 g5] b5 [a5 g5]] [a4 ~ [d5 f5] ~] [g5 [f5 e5] d5 [e5 f5]] [a5 [g5 f5] e5 c5] [d5 [f5 a5] d6 [c6 b5]] [a5 ~ ~ ~]]/2"
        bass$ = "<[d2 d3]*4 [c2 c3]*4 [g1 g2]*4 [a1 a2]*4>"
        kick$ = "bd*4"
        clap$ = "~ cp ~ cp"
        hats$ = "[~ hh]*4"
    ELSEIF style$ = "techno" THEN
        SOUND.BPM 132
        SOUND.VOICE 1, "SAW", 0.002, 0.1, 0.5, 0.04
        SOUND.FILTER 1, 260, 0.45
        SOUND.SIDECHAIN 1, 4, 0.75
        SOUND.VOICE 3, "SAW", 0.002, 0.12, 0.25, 0.12
        SOUND.UNISON 3, 3, 0.25, 0.7
        SOUND.FILTER 3, 1400, 0.55
        SOUND.SIDECHAIN 3, 4, 0.55
        SOUND.REVERBSEND 3, 0.25
        SOUND.VOICE 2, "SAW", 0.9, 0.5, 0.8, 1.6
        SOUND.UNISON 2, 5, 0.3, 1.0
        SOUND.FILTER 2, 1100, 0.2
        SOUND.SIDECHAIN 2, 4, 0.8
        SOUND.REVERBSEND 2, 0.5
        bass$ = "legato(0.7, <[~ a1]*4 [~ f1]*4 [~ c2]*4 [~ g1]*4>)"
        arp$ = "arp(up, <[a3,c4,e4,a4]*4 [f3,a3,c4,f4]*4 [c4,e4,g4,c5]*4 [g3,b3,d4,g4]*4>)"
        pad$ = "<[a3,c4,e4] [f3,a3,c4] [c4,e4,g4] [g3,b3,d4]>"
        kick$ = "bd*4"
        clap$ = "~ cp ~ cp"
        hats$ = "[~ oh]*4, gain([0.35 0.6 0.45 0.8]*4, hh*16)"
    ELSE
        ' the village: a tune of sixteen bars in C major that walks through
        ' the tones of its chords, a question of eight bars and its answer
        SOUND.BPM 96
        ClientLead("TRIANGLE", 0.02, 0.35, 0.6, 0.5, 2200)
        SOUND.REVERBSEND 0, 0.4
        SOUND.VOICE 1, "SINE", 0.01, 0.25, 0.5, 0.3
        SOUND.VOICE 2, "SINE", 1.2, 0.5, 0.8, 2.0
        SOUND.UNISON 2, 3, 0.15, 0.8
        SOUND.REVERBSEND 2, 0.6
        mel$ = "[[e5 ~ [g5 e5] c5] [a4 ~ c5 e5] [f5 ~ [e5 d5] c5] [d5 ~ ~ [g4 b4]] [c5 ~ [e5 g5] c6] [b5 a5 ~ e5] [f5 [e5 d5] g5 b4] [c5 ~ ~ ~] [a5 ~ [g5 f5] a5] [g5 ~ e5 c5] [d5 [e5 f5] a5 f5] [g5 ~ ~ [d5 e5]] [c6 ~ [b5 a5] e5] [f5 ~ a5 c6] [b5 [a5 g5] d5 [e5 f5]] [e5 ~ c5 ~]]/8"
        bass$ = "<[[c2 g2] [a1 e2]] [[f1 c2] [g1 d2]] [[c2 g2] [a1 e2]] [[f1 g1] [c2 g2]] [[f1 c2] [c2 g2]] [[d2 a2] [g1 d2]] [[a1 e2] [f1 c2]] [[g1 d2] [c2 g2]]>"
        pad$ = "<[[c4,e4,g4] [a3,c4,e4]] [[f3,a3,c4] [g3,b3,d4]] [[c4,e4,g4] [a3,c4,e4]] [[f3,a3,c4] [c4,e4,g4]] [[f3,a3,c4] [c4,e4,g4]] [[d4,f4,a4] [g3,b3,d4]] [[a3,c4,e4] [f3,a3,c4]] [[g3,b3,d4] [c4,e4,g4]]>"
        perc$ = "[~ ~ rim ~]*2"
    ENDIF
    SOUND.KIT 4, "SYNTH"
    SOUND.KIT 5, "SYNTH"
    SOUND.KIT 6, "SYNTH"
    SOUND.KIT 7, "SYNTH"
    SOUND.GAIN 0, 0.3
    SOUND.GAIN 1, 0.4
    SOUND.GAIN 2, 0.18
    SOUND.GAIN 3, 0.22
    SOUND.GAIN 4, 0.55
    SOUND.GAIN 5, 0.35
    SOUND.GAIN 6, 0.25
    SOUND.GAIN 7, 0.3
    IF LEN(made) > 0 THEN
        SOUND.GAIN 0, 0.26
        SOUND.GAIN 2, 0.12
        SOUND.GAIN 3, 0.16
    ENDIF
    DIM pats = [mel$, bass$, pad$, arp$, kick$, clap$, hats$, perc$]
    DIM has = []
    DIM h = 0
    FOR h = 0 TO 7
        IF pats[h] <> "" THEN has = APPEND(has, h)
    NEXT h
    cs{"music_has"} = has
    DIM t = 0
    FOR t = 0 TO 7
        IF pats[t] <> "" THEN SOUND.SEQ t, pats[t], "VOICE"
    NEXT t
ENDSUB

' Called first in every frame: the first key opens the sound, M mutes, and
' the style the world wants is played when it changed.
SUB ClientMusicFrame(c)
    DIM keys = c{"keyq"} ?? []
    DIM i = 0
    FOR i = 0 TO LEN(keys) - 1
        c{"music_armed"} = TRUE
        IF NOT (c{"typing"} ?? FALSE) ANDALSO UCASE$("" + (keys[i]{"key"} ?? "")) = "M" THEN
            c{"muted"} = NOT (c{"muted"} ?? FALSE)
            c{"music_on"} = ""
            c{"banner"} = IIF(c{"muted"}, "Musik aus (M)", "Musik an (M)")
            c{"banner_until"} = TICK() + 1500
        ENDIF
    NEXT i
    IF NOT (c{"music_armed"} ?? FALSE) THEN RETURN
    DIM want$ = c{"music_want"} ?? "village:1"
    IF c{"muted"} ?? FALSE THEN want$ = "off"
    IF want$ = (c{"music_on"} ?? "") THEN
        TRY
            ClientMusicScene(c)
        CATCH
            c{"last_error"} = "music: " + ERRMSG$
        ENDTRY
        RETURN
    ENDIF
    TRY
        IF NOT (c{"sound_up"} ?? FALSE) THEN
            SOUND.INIT
            c{"sound_up"} = TRUE
        ENDIF
        IF want$ = "off" THEN
            SOUND.RESET
            c{"music_label"} = ""
        ELSE
            ClientMusicPlay(want$)
        ENDIF
    CATCH
        c{"last_error"} = "music: " + ERRMSG$
    ENDTRY
    c{"music_on"} = want$
    TRY
        ClientMusicScene(c)
    CATCH
        c{"last_error"} = "music: " + ERRMSG$
    ENDTRY
ENDSUB
