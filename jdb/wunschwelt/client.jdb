' Wunschwelt client: the kernel.
'
'   jdBasic jdb/wunschwelt/client.jdb [name] [server] [seconds]
'
' The PIN of the name comes from WW_PIN; in the browser the start page
' hands it over with the page parameters, never in the address.
'
' The kernel opens the window, joins the world, fetches the client code the
' server hands out and calls ClientFrame(c) once per frame. It knows nothing
' of the game: tiles, figures, keys and the talk with the server are all in
' the fetched code. When the server reports a newer version the kernel
' fetches what is new and runs it; the window, the frame counter and the
' state in c live on.
'
' c is the client's whole state. The kernel keeps in it:
'   name, srv, token   who we are and where the world is
'   assets             the folder of the pictures
'   version            the last patch that was run here
'   code_id            the server's name for the code of the versions 1 to version
'   frames             frames drawn since the start
'   keyq               key presses since the last frame, each {"key", "keycode"}
'   textq              text typed since the last frame, as the keyboard layout gives it
'   has_text           TRUE once the runtime has sent typed text; an older one never does
'   need_code          set by the client code when the server is ahead
'   need_join          set when the server no longer knows the token
'   join_error         why the server did not let us in; no join is tried again
'   errors, last_error what went wrong in the client code
'   quit               ends the program

OPTION "EXPLICIT"

DIM cli = OS.ARGS()
DIM C = {"name": "Gast", "srv": "http://127.0.0.1:8100", "token": "", "version": 0, "code_id": "", "error_at": 0,"frames": 0, "keyq": [], "textq": "", "has_text": FALSE,"need_code": FALSE, "need_join": FALSE, "errors": 0, "last_error": "", "quit": FALSE}
DIM run_seconds AS INTEGER = 0
DIM pin$ AS STRING = GETENV$("WW_PIN")
IF LEN(cli) > 1 THEN C{"name"} = cli[1]
IF LEN(cli) > 2 THEN C{"srv"} = cli[2]
IF LEN(cli) > 3 THEN run_seconds = VAL(cli[3])
' pictures beside this file; in the browser the page puts them under /assets
C{"assets"} = "assets"
IF LEN(cli) > 0 THEN C{"assets"} = PATH.JOIN$(PATH.DIRNAME$(cli[0]), "assets")
IF FILE.ISDIR("/assets") THEN C{"assets"} = "/assets"

' In the browser the page hands over its query parameters and its own origin:
' the name comes from ?name=, the world sits behind <origin>/wunschwelt/api.
TRY
    DIM page = JSON.PARSE(TXTREADER$("/url_params.json"))
    IF MAP.EXISTS(page, "name") THEN C{"name"} = page{"name"}
    IF MAP.EXISTS(page, "pin") THEN pin$ = "" + page{"pin"}
    IF MAP.EXISTS(page, "__origin") THEN C{"srv"} = page{"__origin"} + "/wunschwelt/api"
CATCH
ENDTRY

SUB OnKeyDown(info)
    C{"keyq"} = APPEND(C{"keyq"}, {"key": info[0]{"key"}, "keycode": info[0]{"keycode"}})
ENDSUB

SUB OnText(info)
    C{"textq"} = C{"textq"} + info[0]{"text"}
    C{"has_text"} = TRUE
ENDSUB

SUB OnQuit(info)
    C{"quit"} = TRUE
ENDSUB

' Fetches and runs the client code after the version we have.
SUB PullCode()
    DIM code = JSON.PARSE(HTTP.GET$(C{"srv"} + "/code?since=" + STR$(C{"version"})))
    ' The server names the code it expects us to have. When that is not what
    ' ran here (the game changed under a restart), everything is fetched anew
    ' and the client code starts over.
    IF C{"version"} > 0 ANDALSO "" + (code{"since_id"} ?? "") <> C{"code_id"} THEN
        C{"version"} = 0
        C{"ready"} = FALSE
        code = JSON.PARSE(HTTP.GET$(C{"srv"} + "/code?since=0"))
    ENDIF
    DIM patches = code{"patches"}
    DIM i AS INTEGER
    FOR i = 0 TO LEN(patches) - 1
        IF TRIM$(patches[i]) <> "" THEN
            TRY
                EXECUTE patches[i]
            CATCH
                C{"errors"} = C{"errors"} + 1
                C{"last_error"} = "patch " + STR$(C{"version"} + i + 1) + ": " + ERRMSG$
                C{"error_at"} = TICK()
            ENDTRY
        ENDIF
    NEXT i
    C{"version"} = code{"version"}
    C{"code_id"} = "" + (code{"code_id"} ?? "")
    C{"need_code"} = FALSE
ENDSUB

SUB JoinWorld()
    C{"need_join"} = FALSE
    IF (C{"join_error"} ?? "") <> "" THEN RETURN
    DIM r = JSON.PARSE(HTTP.POST$(C{"srv"} + "/join", JSON.STRINGIFY$({"name": C{"name"}, "pin": pin$}), "text/plain"))
    IF r{"ok"} THEN
        C{"token"} = r{"token"}
        C{"name"} = r{"name"} ?? C{"name"}
    ELSEIF INDEXOF(["name", "pin", "wrong_pin", "locked"], "" + (r{"error"} ?? "")) >= 0 THEN
        C{"join_error"} = r{"error"}
    ENDIF
ENDSUB

' The largest whole scale at which the 640 x 384 view fits the primary display.
FUNC ViewScale() AS INTEGER
    DIM fit AS INTEGER = 1
    TRY
        DIM displays AS ARRAY = GFX.DISPLAYS()
        DIM i AS INTEGER
        FOR i = 0 TO LEN(displays) - 1
            IF displays[i]{"primary"} THEN fit = MIN([INT(displays[i]{"w"}) \ 700, INT(displays[i]{"h"}) \ 460])
        NEXT i
    CATCH
        fit = 1
    ENDTRY
    IF fit < 1 THEN fit = 1
    RETURN fit
ENDFUNC

IF OS.FEATURE("HTTP") THEN HTTP.SETTIMEOUT(5)
SCREEN 640, 384, "Wunschwelt - " + C{"name"}, ViewScale()
ON "KEYDOWN" CALL OnKeyDown@
ON "TEXTINPUT" CALL OnText@
ON "QUIT" CALL OnQuit@

PullCode()
JoinWorld()

DIM started AS DOUBLE = TICK()
DO WHILE NOT C{"quit"}
    C{"frames"} = C{"frames"} + 1
    TRY
        IF C{"need_join"} THEN JoinWorld()
        IF C{"need_code"} THEN PullCode()
        ClientFrame(C)
    CATCH
        C{"errors"} = C{"errors"} + 1
        C{"last_error"} = ERRMSG$
        C{"error_at"} = TICK()
    ENDTRY
    IF (C{"join_error"} ?? "") <> "" THEN TEXT 4, 30, "Kein Einlass: " + IIF(C{"join_error"} = "locked", "der Name ist eine Minute gesperrt", "Name oder PIN passen nicht") + ". Bitte auf der Startseite neu anmelden.", 255, 200, 120
    IF C{"last_error"} <> "" ANDALSO TICK() - C{"error_at"} < 5000 THEN TEXT 4, 16, LEFT$(C{"last_error"}, 100), 255, 120, 120
    SCREENFLIP
    IF run_seconds > 0 ANDALSO TICK() - started > run_seconds * 1000 THEN C{"quit"} = TRUE
    SLEEP 4
LOOP
GFX.CLOSE
PRINT "frames "; C{"frames"}; ", version "; C{"version"}; ", errors "; C{"errors"}; " "; C{"last_error"}
