{
    "source_code": [
        "IMPORT PLOTTER",
        "",
        "FUNC CALCULATE_PROFIT(ROW)",
        "    UNITS_SOLD = ROW[1]",
        "    PRICE_PER_UNIT = ROW[2]",
        "    ",
        "    REVENUE = UNITS_SOLD * PRICE_PER_UNIT",
        "    PROFIT = REVENUE * 0.40",
        "    ",
        "    RETURN PROFIT",
        "ENDFUNC",
        ""
    ],
