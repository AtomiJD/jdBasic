' UDT-Lifecycle-Demo: INIT als Konstruktor + DISPOSE als Destruktor.
' Zeigt:
'   * Skalar-DIM mit Konstruktor-Args                  -> SUB INIT(p AS STRING)
'   * Array-DIM mit Vektor-Args                        -> DIM x[3] AS T(vec1, vec2)
'   * Automatisches DISPOSE beim Verlassen des Scopes  -> SUB DISPOSE()
'
' Im Interpreter feuert DISPOSE wenn die letzte Referenz verschwindet
' (Refcount). Im Native-Compiler wird DISPOSE fuer Locals am Funktions-
' ende und am Programmende gerufen.

TYPE T_LOG
    Tag AS STRING

    SUB INIT(t AS STRING)
        THIS.Tag = t
        PRINT "[open ] " + t
    ENDSUB

    SUB DISPOSE()
        PRINT "[close] " + THIS.Tag
    ENDSUB

    FUNC LABEL$()
        RETURN THIS.Tag
    ENDFUNC
ENDTYPE

SUB single_scope()
    DIM net AS T_LOG("net")
    PRINT "[" + net.LABEL$() + "] connect 127.0.0.1"
    PRINT "[" + net.LABEL$() + "] send heartbeat"
ENDSUB

SUB many_workers()
    DIM workers[3] AS T_LOG(["w1", "w2", "w3"])
    FOR i = 0 TO 2
        w = workers[i]
        PRINT "[" + w.LABEL$() + "] tick"
    NEXT i
ENDSUB

PRINT "--- single_scope ---"
single_scope()
PRINT
PRINT "--- many_workers ---"
many_workers()
PRINT
PRINT "--- end of program ---"
