' --- SWITCH...CASE...ENDSWITCH ---
FOREVER = TRUE
DO
    INPUT "Enter a command (start, stop, pause, exit): ", command$

    SWITCH UCASE$(command$)
        CASE "START"
            PRINT "Starting process..."
            ' ... code to start ...

        CASE "STOP"
            PRINT "Stopping process..."
            ' ... code to stop ...

        CASE "PAUSE"
            PRINT "Pausing process."

        CASE "EXIT"
            PRINT "Exit program."
            FOREVER = FALSE
        DEFAULT
            PRINT "Unknown command: " + command$
    ENDSWITCH

LOOP WHILE FOREVER

PRINT "Switch block test finished."
