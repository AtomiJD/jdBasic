' The player of the Christmas story cards: the story code of a link, the
' cast, the room, the speech bubbles and the music. Everything draws in a
' portrait frame of 720 x 1280 on the current target.
EXPORT MODULE XMASPLAY

IMPORT RASTER

EXPORT DIM FW = 720
EXPORT DIM FH = 1280
EXPORT DIM MAX_CODE = 2048
EXPORT DIM MAX_LINES = 12
EXPORT DIM MAX_LINE = 80
EXPORT DIM MAX_NAME = 30
EXPORT DIM PER_LINE = 5.5

' ---------------------------------------------------------------- story code

FUNC B64Url$(raw$)
    DIM s$ = REPLACE$(REPLACE$(CODEC.BASE64_ENCODE$(raw$), "+", "-"), "/", "_")
    DO WHILE ENDSWITH(s$, "=")
        s$ = LEFT$(s$, LEN(s$) - 1)
    LOOP
    RETURN s$
ENDFUNC

FUNC UnB64Url$(code$)
    DIM s$ = REPLACE$(REPLACE$(code$, "-", "+"), "_", "/")
    DO WHILE LEN(s$) MOD 4 <> 0
        s$ = s$ + "="
    LOOP
    RETURN CODEC.BASE64_DECODE$(s$)
ENDFUNC

' A link code: "2", then base64url of the CRC32 of the packed story (four
' bytes, little-endian) and the story as JSON in raw deflate.
EXPORT FUNC ENCODE$(story)
    DIM packed$ = CODEC.DEFLATE$(JSON.STRINGIFY$(story), 9, "raw")
    RETURN "2" + B64Url$(PACK$("<I", CODEC.CRC32(packed$)) + packed$)
ENDFUNC

EXPORT DIM MAX_JSON = 8192
EXPORT DIM MAX_NEST = 64

' The JSON of a link code once its checks pass, else "".
FUNC Unpack$(code$)
    DIM bytes$ = UnB64Url$(MID$(code$, 1))
    DIM packed$ = bytes$
    IF LEFT$(code$, 1) = "2" THEN
        IF LEN(bytes$) < 5 THEN RETURN ""
        IF UNPACK("<I", bytes$)[0] <> CODEC.CRC32(MID$(bytes$, 4)) THEN RETURN ""
        packed$ = MID$(bytes$, 4)
    ENDIF
    DIM json$ = CODEC.INFLATE$(packed$, "raw")
    IF LEN(json$) > MAX_JSON THEN RETURN ""
    IF Depth(json$) > MAX_NEST THEN RETURN ""
    RETURN json$
ENDFUNC

' How deep the brackets of a JSON text nest, outside its strings.
FUNC Depth(json$)
    DIM deepest = 0
    DIM level = 0
    DIM in_str = FALSE
    DIM i = 0
    FOR i = 0 TO LEN(json$) - 1
        DIM c = BYTEAT(json$, i)
        IF in_str THEN
            IF c = 92 THEN
                i = i + 1
            ELSEIF c = 34 THEN
                in_str = FALSE
            ENDIF
        ELSEIF c = 34 THEN
            in_str = TRUE
        ELSEIF c = 91 ORELSE c = 123 THEN
            level = level + 1
            IF level > deepest THEN deepest = level
        ELSEIF c = 93 ORELSE c = 125 THEN
            level = level - 1
        ENDIF
    NEXT i
    RETURN deepest
ENDFUNC

' A text of at most n characters from a decoded value, "" for anything but a text.
EXPORT FUNC CLEANTEXT$(v, n)
    IF NOT ISSTR(v) THEN RETURN ""
    RETURN LEFTW$(TRIM$(v), n)
ENDFUNC

' ---------------------------------------------------------------- catalog

' What a story may name, with its German and English label.
EXPORT FUNC BACKGROUNDS()
    RETURN [["room", "Kaminzimmer", "Fireside room"], ["snow", "Winternacht im Dorf", "Winter night in the village"], ["workshop", "Weihnachtswerkstatt", "Santa's workshop"], ["forest", "Winterwald", "Winter forest"]]
ENDFUNC

EXPORT FUNC CASTS()
    RETURN [["santa", "Weihnachtsmann", "Santa"], ["lina", "Lina", "Lina"], ["rudi", "Rudi (Rentier)", "Rudi (reindeer)"], ["pip", "Pip (Wichtel)", "Pip (elf)"], ["pino", "Pino (Pinguin)", "Pino (penguin)"]]
ENDFUNC

EXPORT FUNC ACTIONS()
    RETURN [["laugh", "Lachen", "Laugh"], ["dance", "Tanzen", "Dance"], ["gift", "Geschenk geben", "Give a present"], ["hug", "Umarmen", "Hug"], ["snowball", "Schneeballschlacht", "Snowball fight"], ["kiss", "Luftkuss", "Blow a kiss"], ["wave", "Winken", "Wave"], ["surprise", "Staunen", "Surprise"]]
ENDFUNC

' TRUE for an action that goes from one figure to another.
EXPORT FUNC DIRECTED(a$)
    RETURN FIND_IN_ARRAY(["gift", "hug", "snowball", "kiss"], a$) >= 0
ENDFUNC

EXPORT FUNC MUSICS()
    RETURN [["silent", "Stille Nacht", "Silent Night"], ["jingle", "Jingle Bells", "Jingle Bells"], ["wish", "We Wish You a Merry Christmas", "We Wish You a Merry Christmas"]]
ENDFUNC

EXPORT DIM MAX_SCENES = 3
EXPORT DIM MAX_CAST = 3
EXPORT DIM MAX_SCENE_LINES = 4
EXPORT DIM MAX_SCENE_ACTIONS = 4
EXPORT DIM ACTION_LEN = 4.5

FUNC Ids(table)
    RETURN SELECT(LAMBDA row -> row[0], table)
ENDFUNC

' ---------------------------------------------------------------- the story

' A story: from, to, music, and up to three scenes, each with a background,
' a cast of one to three, up to four bubbles [speaker, text] and an action.
'   {"f": "...", "t": "...", "m": 0, "s": [{"b": "room", "c": ["santa", "lina"], "l": [[0, "..."]], "a": "gift"}]}

FUNC CleanScene(sc)
    IF NOT ISMAP(sc) THEN RETURN NONE
    DIM b$ = CLEANTEXT$(sc{"b"} ?? "", 16)
    IF FIND_IN_ARRAY(Ids(BACKGROUNDS()), b$) < 0 THEN b$ = "room"
    DIM known = Ids(CASTS())
    DIM cast = []
    IF ISARR(sc{"c"} ?? NONE) THEN
        DIM member = NONE
        FOR EACH member IN sc{"c"}
            IF ISSTR(member) ANDALSO LEN(cast) < MAX_CAST THEN
                IF FIND_IN_ARRAY(known, member) >= 0 ANDALSO FIND_IN_ARRAY(cast, member) < 0 THEN cast = APPEND(cast, member)
            ENDIF
        NEXT member
    ENDIF
    IF LEN(cast) = 0 THEN cast = ["santa", "lina"]
    ' the steps: bubbles [speaker, text] and actions [action, by, to]
    DIM steps = []
    DIM n_lines = 0
    DIM n_acts = 0
    DIM acts = Ids(ACTIONS())
    IF ISARR(sc{"l"} ?? NONE) THEN
        DIM item = NONE
        FOR EACH item IN TAKE(2 * (MAX_SCENE_LINES + MAX_SCENE_ACTIONS), sc{"l"})
            IF ISARR(item) ANDALSO LEN(item) >= 2 THEN
                IF ISSTR(item[0]) THEN
                    IF FIND_IN_ARRAY(acts, item[0]) >= 0 ANDALSO n_acts < MAX_SCENE_ACTIONS THEN
                        DIM by = 0
                        DIM onto = MIN([1, LEN(cast) - 1])
                        IF ISNUM(item[1]) THEN by = CLAMP(INT(item[1]), 0, LEN(cast) - 1)
                        IF LEN(item) >= 3 THEN
                            IF ISNUM(item[2]) THEN onto = CLAMP(INT(item[2]), 0, LEN(cast) - 1)
                        ENDIF
                        steps = APPEND(steps, [[item[0], by, onto]])
                        n_acts = n_acts + 1
                    ENDIF
                ELSEIF n_lines < MAX_SCENE_LINES THEN
                    DIM text$ = CLEANTEXT$(item[1], MAX_LINE)
                    DIM who = 0
                    IF ISNUM(item[0]) THEN who = CLAMP(INT(item[0]), 0, LEN(cast) - 1)
                    IF text$ <> "" THEN
                        steps = APPEND(steps, [[who, text$]])
                        n_lines = n_lines + 1
                    ENDIF
                ENDIF
            ENDIF
        NEXT item
    ENDIF
    ' a scene of the earlier format names one action for its end
    IF n_acts = 0 ANDALSO ISSTR(sc{"a"} ?? NONE) THEN
        IF FIND_IN_ARRAY(acts, sc{"a"}) >= 0 THEN steps = APPEND(steps, [[sc{"a"}, 0, MIN([1, LEN(cast) - 1])]])
    ENDIF
    RETURN {"b": b$, "c": cast, "l": steps}
ENDFUNC

' TRUE for an action step, FALSE for a bubble.
EXPORT FUNC ISACT(st)
    RETURN ISSTR(st[0])
ENDFUNC

' Seconds a step lasts: a bubble as long as its text takes to type and read.
EXPORT FUNC STEPLEN(st)
    IF ISSTR(st[0]) THEN RETURN ACTION_LEN
    RETURN MAX([3.2, LENW(st[1]) / 22 + 2.4])
ENDFUNC

' A decoded value held to the editor's limits, or NONE.
EXPORT FUNC CLEAN(raw)
    IF NOT ISMAP(raw) ORELSE NOT ISARR(raw{"s"} ?? NONE) THEN RETURN NONE
    DIM scenes = []
    DIM sc = NONE
    FOR EACH sc IN TAKE(MAX_SCENES, raw{"s"})
        DIM clean = CleanScene(sc)
        IF NOT ISNONE(clean) THEN
            IF LEN(clean{"l"}) > 0 THEN scenes = APPEND(scenes, clean)
        ENDIF
    NEXT sc
    IF LEN(scenes) = 0 THEN RETURN NONE
    DIM m = 0
    IF ISNUM(raw{"m"} ?? NONE) THEN m = INT(raw{"m"})
    IF m < 0 ORELSE m >= LEN(MUSICS()) THEN m = 0
    DIM g = 0
    IF ISNUM(raw{"g"} ?? NONE) THEN g = INT(raw{"g"})
    IF g < 0 ORELSE g >= LEN(GENRES()) THEN g = 0
    RETURN {"f": CLEANTEXT$(raw{"f"} ?? "", MAX_NAME), "t": CLEANTEXT$(raw{"t"} ?? "", MAX_NAME), "m": m, "g": g, "s": scenes}
ENDFUNC

' A story of the first link format: lines said in turn by Santa and Lina in the room.
FUNC FromV1(raw)
    IF NOT ISMAP(raw) ORELSE NOT ISARR(raw{"lines"} ?? NONE) THEN RETURN NONE
    DIM lines = []
    DIM i = 0
    DIM v = NONE
    FOR EACH v IN TAKE(MAX_SCENE_LINES, raw{"lines"})
        lines = APPEND(lines, [[i MOD 2, v]])
        i = i + 1
    NEXT v
    RETURN {"f": raw{"from"} ?? "", "t": raw{"to"} ?? "", "m": 0, "g": 0, "s": [{"b": "room", "c": ["santa", "lina"], "l": lines, "a": "dance"}]}
ENDFUNC

' The story a link carries, held to the editor's limits, or NONE.
EXPORT FUNC DECODE(code$)
    DIM ver$ = LEFT$(code$, 1)
    IF (ver$ <> "1" ANDALSO ver$ <> "2") ORELSE LEN(code$) > MAX_CODE THEN RETURN NONE
    DIM raw = NONE
    TRY
        DIM json$ = Unpack$(code$)
        IF json$ = "" THEN RETURN NONE
        raw = JSON.PARSE(json$)
        IF ver$ = "1" THEN raw = FromV1(raw)
        RETURN CLEAN(raw)
    CATCH
        RETURN NONE
    ENDTRY
ENDFUNC

' The demo story in the viewer's language.
EXPORT FUNC DEMOFOR(lang$)
    IF lang$ <> "en" THEN RETURN DEMO()
    RETURN {"f": "Santa and Lina", "t": "you", "m": 1, "g": 0, "s": [{"b": "room", "c": ["santa", "lina"], "l": [[0, "Ho ho ho! Merry Christmas, so glad you are here!"], [1, "Oh, Santa! Did you bring cookies?"], [0, "Even better: a present, just for you!"], ["gift", 0, 1], [1, "Hihi, thank you! It is beautiful!"], ["hug", 1, 0]]}, {"b": "forest", "c": ["rudi", "pino"], "l": [[0, "Snow! Finally snow!"], ["snowball", 1, 0], [0, "Hey! Just you wait..."], ["kiss", 1, 0], [1, "Hehe, Merry Christmas, Rudi!"]]}]}
ENDFUNC

EXPORT FUNC DEMO()
    RETURN {"f": "Santa und Lina", "t": "dich", "m": 0, "g": 0, "s": [{"b": "room", "c": ["santa", "lina"], "l": [[0, "Ho ho ho! Frohe Weihnachten, schön, dass du da bist!"], [1, "Oh, der Weihnachtsmann! Hast du Kekse mitgebracht?"], [0, "Viel besser: ein Geschenk, nur für dich!"], ["gift", 0, 1], [1, "Hihi, danke! Das ist ja wunderschön!"], ["hug", 1, 0]]}, {"b": "forest", "c": ["rudi", "pino"], "l": [[0, "Schnee! Endlich Schnee!"], ["snowball", 1, 0], [0, "Hey! Na warte..."], ["kiss", 1, 0], [1, "Hehe, frohe Weihnachten, Rudi!"]]}]}
ENDFUNC

' Seconds a scene lasts: its bubbles, then its action.
EXPORT FUNC SCENELEN(sc)
    DIM total = 0
    DIM one = NONE
    FOR EACH one IN sc{"l"}
        total = total + STEPLEN(one)
    NEXT one
    RETURN total
ENDFUNC

' Seconds from the first bubble to the end card.
EXPORT FUNC LENGTH(story)
    RETURN SUM(SELECT(LAMBDA s -> SCENELEN(s), story{"s"}))
ENDFUNC

' ---------------------------------------------------------------- pictures

' A picture as a smooth GFX image, from its baked .rgbz (tools/bake.jdb) or
' else from its SVG; [image, width, height].
FUNC LoadPart(art_dir$, name$)
    DIM w = 0
    DIM h = 0
    DIM pixels = []
    IF FILE.EXISTS(art_dir$ + name$ + ".rgbz") THEN
        DIM raw$ = CODEC.INFLATE$(BINREADER$(art_dir$ + name$ + ".rgbz"), "raw")
        DIM size = UNPACK("<II", raw$)
        w = size[0]
        h = size[1]
        pixels = UNPACK(STR$(w * h * 4) + "B", raw$, 8)
    ELSE
        DIM px = RASTER.RENDER(TXTREADER$(art_dir$ + name$ + ".svg"), {"scale": 1, "background": "none"})
        w = px{"width"}
        h = px{"height"}
        pixels = px{"pixels"}
    ENDIF
    DIM spr = SPRITE.CREATE(w, h)
    SPRITE.SETBUFFER spr, pixels
    DIM img = GFX.NEWTARGET(w, h, TRUE)
    GFX.TARGET img, TRUE
    SPRITE.POS spr, 0, 0
    SPRITE.DRAW spr
    GFX.TARGET
    SPRITE.DELETE spr
    RETURN [img, w, h]
ENDFUNC

' A painted background: the RGBA the runtime page decoded beside the JPEG
' (bg_<id>.jpg.rgba, in the browser) or the JPEG itself (on the desktop);
' NONE when there is neither.
FUNC LoadBg(art_dir$, id$)
    DIM path$ = art_dir$ + "bg_" + id$ + ".jpg"
    TRY
        IF FILE.EXISTS(path$ + ".rgba") THEN
            DIM raw$ = BINREADER$(path$ + ".rgba")
            IF LEN(raw$) < 8 THEN RETURN NONE
            DIM size = UNPACK("<II", raw$)
            IF size[0] < 1 ORELSE size[1] < 1 ORELSE size[0] > 4096 ORELSE size[1] > 4096 THEN RETURN NONE
            IF LEN(raw$) < 8 + size[0] * size[1] * 4 THEN RETURN NONE
            DIM spr = SPRITE.CREATE(size[0], size[1])
            SPRITE.SETBUFFER spr, UNPACK(STR$(size[0] * size[1] * 4) + "B", raw$, 8)
            DIM img = GFX.NEWTARGET(size[0], size[1], TRUE)
            GFX.TARGET img, TRUE
            SPRITE.POS spr, 0, 0
            SPRITE.DRAW spr
            GFX.TARGET
            SPRITE.DELETE spr
            RETURN [img, size[0], size[1]]
        ENDIF
        IF FILE.EXISTS(path$) THEN
            DIM wh = JpegSize(path$)
            IF ISNONE(wh) THEN RETURN NONE
            RETURN [GFX.LOADIMAGE(path$), wh[0], wh[1]]
        ENDIF
    CATCH
        RETURN NONE
    ENDTRY
    RETURN NONE
ENDFUNC

' [width, height] from the frame header of a JPEG, NONE when there is none.
FUNC JpegSize(path$)
    DIM b$ = BINREADER$(path$)
    DIM at = 2
    DO WHILE at + 9 < LEN(b$)
        IF BYTEAT(b$, at) <> 255 THEN RETURN NONE
        DIM kind = BYTEAT(b$, at + 1)
        IF kind >= 192 ANDALSO kind <= 195 THEN RETURN [BYTEAT(b$, at + 7) * 256 + BYTEAT(b$, at + 8), BYTEAT(b$, at + 5) * 256 + BYTEAT(b$, at + 6)]
        at = at + 2 + BYTEAT(b$, at + 2) * 256 + BYTEAT(b$, at + 3)
    LOOP
    RETURN NONE
ENDFUNC

' The rig of a figure: pivots of its parts, joints in the torso's own
' coordinates, eyes, mouth and pigtails in the head's.
FUNC CastDef(name$)
    IF name$ = "rudi" THEN
        RETURN {"piv": {"torso": [85, 158], "head": [130, 252], "arm": [22, 12], "leg": [26, 6]}, "joint": {"head": [85, 14], "arm_l": [34, 46], "arm_r": [136, 46], "leg_l": [60, 156], "leg_r": [110, 156]}, "eyes": [[100, 165], [160, 165]], "eye": [15, 20], "iris": [90, 55, 30], "mouth": [130, 240], "tails": [], "nose": [130, 204]}
    ENDIF
    IF name$ = "pip" THEN
        RETURN {"piv": {"torso": [85, 156], "head": [130, 238], "arm": [22, 12], "leg": [26, 6]}, "joint": {"head": [85, 12], "arm_l": [42, 40], "arm_r": [128, 40], "leg_l": [62, 156], "leg_r": [108, 156]}, "eyes": [[100, 168], [160, 168]], "eye": [15, 21], "iris": [60, 170, 90], "mouth": [130, 214], "tails": []}
    ENDIF
    IF name$ = "pino" THEN
        RETURN {"piv": {"torso": [85, 166], "head": [125, 226], "arm": [21, 10], "leg": [30, 8]}, "joint": {"head": [85, 16], "arm_l": [24, 62], "arm_r": [146, 62], "leg_l": [60, 166], "leg_r": [110, 166]}, "eyes": [[98, 156], [152, 156]], "eye": [15, 20], "iris": [70, 110, 190], "mouth": [125, 203], "tails": []}
    ENDIF
    IF name$ = "lina" THEN
        RETURN {"piv": {"torso": [85, 160], "head": [130, 228], "arm": [23, 14], "leg": [26, 6], "tail": [36, 13]}, "joint": {"head": [85, 12], "arm_l": [40, 40], "arm_r": [130, 40], "leg_l": [62, 158], "leg_r": [108, 158]}, "eyes": [[100, 160], [160, 160]], "eye": [17, 23], "iris": [40, 160, 165], "mouth": [130, 207], "tails": [[42, 116], [218, 116]]}
    ENDIF
    RETURN {"piv": {"torso": [90, 160], "head": [120, 214], "arm": [28, 16], "leg": [32, 8]}, "joint": {"head": [90, 14], "arm_l": [30, 42], "arm_r": [150, 42], "leg_l": [62, 158], "leg_r": [118, 158]}, "eyes": [[90, 140], [150, 140]], "eye": [14, 19], "iris": [110, 70, 50], "mouth": [120, 202], "tails": []}
ENDFUNC

' The cast, the room's pictures and the effects; needs an open SCREEN.
EXPORT FUNC LOADPARTS(art_dir$)
    DIM cast = {}
    cast{"santa"} = LoadFigure(art_dir$, "santa")
    cast{"lina"} = LoadFigure(art_dir$, "lina")
    DIM room = {}
    room{"tree"} = LoadPart(art_dir$, "room_tree")
    room{"fireplace"} = LoadPart(art_dir$, "room_fireplace")
    room{"presents"} = LoadPart(art_dir$, "room_presents")
    room{"cat"} = LoadPart(art_dir$, "room_cat")
    room{"heart"} = LoadPart(art_dir$, "fx_heart")
    RETURN {"cast": cast, "room": room, "art": art_dir$}
ENDFUNC

' The parts with the painted backgrounds the story's scenes use loaded; a
' background is loaded once, the first time a story asks for it.
EXPORT FUNC PREPARE(parts, story)
    DIM room = parts{"room"}
    DIM cast = parts{"cast"}
    DIM sc = NONE
    FOR EACH sc IN story{"s"}
        DIM key$ = "bg_" + sc{"b"}
        IF NOT MAP.EXISTS(room, key$) THEN room{key$} = LoadBg(parts{"art"}, sc{"b"})
        DIM who$ = ""
        FOR EACH who$ IN sc{"c"}
            IF NOT MAP.EXISTS(cast, who$) THEN cast{who$} = LoadFigure(parts{"art"}, who$)
        NEXT who$
    NEXT sc
    parts{"room"} = room
    parts{"cast"} = cast
    RETURN parts
ENDFUNC

' A figure's rig with its pictures.
FUNC LoadFigure(art_dir$, name$)
    DIM c = CastDef(name$)
    DIM img = {}
    img{"torso"} = LoadPart(art_dir$, name$ + "_torso")
    img{"head"} = LoadPart(art_dir$, name$ + "_head")
    img{"arm"} = LoadPart(art_dir$, name$ + "_arm")
    img{"leg"} = LoadPart(art_dir$, name$ + "_leg")
    IF LEN(c{"tails"}) > 0 THEN img{"tail"} = LoadPart(art_dir$, name$ + "_tail")
    c{"img"} = img
    RETURN c
ENDFUNC

' ---------------------------------------------------------------- the figures

' A point of the torso in frame coordinates.
FUNC TorsoPoint(c, pose, p)
    DIM r = RADIANS(pose{"tilt"})
    DIM piv = c{"piv"}{"torso"}
    DIM dx = (p[0] - piv[0]) * pose{"scale"}
    DIM dy = (p[1] - piv[1]) * pose{"scale"}
    RETURN [pose{"x"} + dx * COS(r) - dy * SIN(r), pose{"y"} + dx * SIN(r) + dy * COS(r)]
ENDFUNC

' A local point of a part turned by ang around its pivot at the joint.
FUNC PartPoint(jx, jy, piv, ang, sc, p)
    DIM r = RADIANS(ang)
    DIM dx = (p[0] - piv[0]) * sc
    DIM dy = (p[1] - piv[1]) * sc
    RETURN [jx + dx * COS(r) - dy * SIN(r), jy + dx * SIN(r) + dy * COS(r)]
ENDFUNC

SUB DrawPart(part, piv, jx, jy, ang, sc)
    DIM w = part[1] * sc
    DIM h = part[2] * sc
    DIM c = PartPoint(jx, jy, piv, ang, sc, [part[1] / 2, part[2] / 2])
    GFX.DRAWIMAGE_EX(part[0], c[0] - w / 2, c[1] - h / 2, w, h, ang)
ENDSUB

' An anime eye: open, closed in a blink, or a happy ^.
SUB DrawEye(x, y, rx, ry, iris, state$)
    IF state$ = "blink" THEN
        GFX.STROKE x - rx, y, x, y + rx * 0.3, rx * 0.4, 60, 36, 40
        GFX.STROKE x, y + rx * 0.3, x + rx, y, rx * 0.4, 60, 36, 40
        RETURN
    ENDIF
    IF state$ = "happy" THEN
        GFX.STROKE x - rx, y + ry * 0.3, x, y - ry * 0.35, rx * 0.45, 60, 36, 40
        GFX.STROKE x, y - ry * 0.35, x + rx, y + ry * 0.3, rx * 0.45, 60, 36, 40
        RETURN
    ENDIF
    DRAWCOLOR 44, 26, 34
    ELLIPSE x, y, rx, ry, TRUE
    DRAWCOLOR iris[0], iris[1], iris[2]
    ELLIPSE x, y + ry * 0.14, rx * 0.76, ry * 0.7, TRUE
    DRAWCOLOR iris[0] / 2, iris[1] / 2, iris[2] / 2
    ELLIPSE x, y + ry * 0.22, rx * 0.4, ry * 0.4, TRUE
    CIRCLE x - rx * 0.3, y - ry * 0.36, rx * 0.42, TRUE, 255, 255, 255
    CIRCLE x + rx * 0.34, y + ry * 0.38, rx * 0.2, TRUE, 255, 255, 255
ENDSUB

' The mouth: a small smile, talking (open 0..1) or a big laugh.
SUB DrawMouth(x, y, sc, open, laugh)
    IF laugh THEN
        DRAWCOLOR 150, 40, 56
        ELLIPSE x, y, 15 * sc, 12 * sc, TRUE
        DRAWCOLOR 255, 130, 150
        ELLIPSE x, y + 5 * sc, 9 * sc, 5 * sc, TRUE
        RETURN
    ENDIF
    IF open > 0.05 THEN
        DRAWCOLOR 150, 40, 56
        ELLIPSE x, y, 10 * sc, MAX([3, 11 * open]) * sc, TRUE
        DRAWCOLOR 255, 130, 150
        ELLIPSE x, y + 4 * open * sc, 6 * sc, 3 * open * sc, TRUE
        RETURN
    ENDIF
    GFX.STROKE x - 9 * sc, y - 2 * sc, x, y + 4 * sc, 4 * sc, 120, 50, 60
    GFX.STROKE x, y + 4 * sc, x + 9 * sc, y - 2 * sc, 4 * sc, 120, 50, 60
ENDSUB

SUB DrawFigure(c, pose)
    DIM img = c{"img"}
    DIM piv = c{"piv"}
    DIM jt = c{"joint"}
    DIM sc = pose{"scale"}
    DIM tilt = pose{"tilt"}
    DIM j = TorsoPoint(c, pose, jt{"leg_l"})
    DrawPart(img{"leg"}, piv{"leg"}, j[0], j[1], tilt + pose{"leg_l"}, sc)
    j = TorsoPoint(c, pose, jt{"leg_r"})
    DrawPart(img{"leg"}, piv{"leg"}, j[0], j[1], tilt + pose{"leg_r"}, sc)
    DIM hj = TorsoPoint(c, pose, jt{"head"})
    DIM head_ang = tilt + pose{"head"}
    DIM i = 0
    FOR i = 0 TO LEN(c{"tails"}) - 1
        DIM tp = PartPoint(hj[0], hj[1], piv{"head"}, head_ang, sc, c{"tails"}[i])
        DIM swing = pose{"tail"} * IIF(i = 0, 1, -1)
        DrawPart(img{"tail"}, piv{"tail"}, tp[0], tp[1], head_ang + swing + IIF(i = 0, 14, -14), sc)
    NEXT i
    j = TorsoPoint(c, pose, piv{"torso"})
    DrawPart(img{"torso"}, piv{"torso"}, j[0], j[1], tilt, sc)
    DrawPart(img{"head"}, piv{"head"}, hj[0], hj[1], head_ang, sc)
    IF MAP.EXISTS(c, "nose") THEN
        DIM np = PartPoint(hj[0], hj[1], piv{"head"}, head_ang, sc, c{"nose"})
        DIM glow = 0.5 + 0.5 * SIN((pose{"t"} ?? 0) * 4)
        CIRCLE np[0], np[1], (16 + 3 * glow) * sc, TRUE, 232 + 23 * glow, 52 + 70 * glow, 74 + 50 * glow
        CIRCLE np[0] - 5 * sc, np[1] - 5 * sc, 5 * sc, TRUE, 255, 255, 255
        IF glow > 0.92 THEN Sparkle(np[0] + 18 * sc, np[1] - 16 * sc, 9 * sc, 3)
    ENDIF
    FOR i = 0 TO 1
        DIM ep = PartPoint(hj[0], hj[1], piv{"head"}, head_ang, sc, c{"eyes"}[i])
        DrawEye(ep[0], ep[1], c{"eye"}[0] * sc, c{"eye"}[1] * sc, c{"iris"}, pose{"eyes"})
    NEXT i
    DIM mp = PartPoint(hj[0], hj[1], piv{"head"}, head_ang, sc, c{"mouth"})
    DrawMouth(mp[0], mp[1], sc, pose{"mouth"}, pose{"laugh"})
    j = TorsoPoint(c, pose, jt{"arm_l"})
    DrawPart(img{"arm"}, piv{"arm"}, j[0], j[1], tilt + pose{"arm_l"}, sc)
    j = TorsoPoint(c, pose, jt{"arm_r"})
    DrawPart(img{"arm"}, piv{"arm"}, j[0], j[1], tilt + pose{"arm_r"}, sc)
ENDSUB

' The point above a figure's head where a bubble's tail ends.
FUNC HeadTop(c, pose)
    DIM hj = TorsoPoint(c, pose, c{"joint"}{"head"})
    RETURN [hj[0], hj[1] - (c{"piv"}{"head"}[1] + 10) * pose{"scale"}]
ENDFUNC

' ---------------------------------------------------------------- the room

FUNC Bulb(k)
    DIM colors = [[255, 70, 90], [255, 214, 70], [80, 170, 255], [90, 230, 140], [255, 130, 220]]
    RETURN colors[k MOD 5]
ENDFUNC

SUB DrawLight(x, y, k, t)
    DIM col = Bulb(k)
    IF (INT(t * 2.5) + k) MOD 3 = 0 THEN
        CIRCLE x, y, 5, TRUE, col[0] / 3, col[1] / 3, col[2] / 3
        RETURN
    ENDIF
    CIRCLE x, y, 10, TRUE, (col[0] + 255) / 3, (col[1] + 120) / 3, (col[2] + 120) / 3
    CIRCLE x, y, 6, TRUE, col[0], col[1], col[2]
    CIRCLE x - 2, y - 2, 2, TRUE, 255, 255, 255
ENDSUB

SUB DrawPic(pic, x, y, s)
    GFX.DRAWIMAGE_EX(pic[0], x, y, pic[1] * s, pic[2] * s, 0)
ENDSUB

' A background filling the frame, cut at the sides or the top and bottom.
SUB DrawBg(pic)
    DIM s = MAX([FW / pic[1], FH / pic[2]])
    GFX.DRAWIMAGE_EX(pic[0], (FW - pic[1] * s) / 2, (FH - pic[2] * s) / 2, pic[1] * s, pic[2] * s, 0)
ENDSUB

' The room drawn in shapes, when its painted picture is missing.
SUB RoomShell(t)
    ' wall, wainscot, floor and rug
    RECT 0, 0, FW, 900, TRUE, 96, 42, 56
    DIM i = 0
    FOR i = 0 TO 11
        RECT i * 60 + 20, 0, 20, 760, TRUE, 104, 48, 62
    NEXT i
    RECT 0, 760, FW, 140, TRUE, 120, 70, 48
    RECT 0, 752, FW, 12, TRUE, 150, 96, 64
    RECT 0, 900, FW, FH - 900, TRUE, 160, 104, 66
    FOR i = 0 TO 7
        RECT 0, 900 + i * 48, FW, 3, TRUE, 136, 86, 52
    NEXT i
    DRAWCOLOR 200, 64, 76
    ELLIPSE 360, 1120, 340, 96, TRUE
    DRAWCOLOR 230, 96, 106
    ELLIPSE 360, 1120, 300, 76, TRUE
    DRAWCOLOR 200, 64, 76
    ELLIPSE 360, 1120, 250, 58, TRUE
    ' the window: night sky, moon, snow, curtains
    RECT 38, 112, 236, 290, TRUE, 246, 236, 220
    RECT 50, 124, 212, 266, TRUE, 26, 34, 84
    RECT 50, 300, 212, 90, TRUE, 34, 46, 104
    CIRCLE 110, 178, 26, TRUE, 255, 240, 170
    CIRCLE 122, 170, 22, TRUE, 26, 34, 84
    DIM f = 0
    FOR f = 0 TO 27
        DIM fx = 50 + (f * 97 + INT(t * 18 * (1 + f MOD 3) + SIN(t + f) * 6)) MOD 212
        DIM fy = 124 + (f * 53 + INT(t * 36 * (1 + f MOD 2))) MOD 250
        CIRCLE fx, fy, 2 + f MOD 2, TRUE, 255, 255, 255
    NEXT f
    ROUNDED_RECT 50, 370, 212, 22, 10, TRUE, 255, 255, 255
    RECT 153, 124, 6, 266, TRUE, 246, 236, 220
    ROUNDED_RECT 22, 100, 44, 310, 16, TRUE, 236, 90, 110
    ROUNDED_RECT 246, 100, 44, 310, 16, TRUE, 236, 90, 110
    RECT 12, 92, 288, 18, TRUE, 150, 96, 64
ENDSUB

SUB DrawRoom(room, t)
    DIM i = 0
    DIM painted = NOT ISNONE(room{"bg_room"} ?? NONE)
    IF painted THEN
        DrawBg(room{"bg_room"})
        ' snow falling past the painted window
        FOR i = 0 TO 17
            DIM wx = 54 + (i * 97 + INT(t * 14 * (1 + i MOD 3) + SIN(t + i) * 5)) MOD 190
            DIM wy = 170 + (i * 53 + INT(t * 30 * (1 + i MOD 2))) MOD 290
            CIRCLE wx, wy, 1.5 + i MOD 2, TRUE, 255, 255, 255
        NEXT i
    ELSE
        RoomShell(t)
    ENDIF
    ' where the back wall meets the floor
    DIM dy = IIF(painted, -130, 0)
    ' the fireplace with candles, fire and sparks
    DrawPic(room{"fireplace"}, 456, 644 + dy, 0.8)
    DIM fl = SIN(t * 11) * 3
    DRAWCOLOR 255, 170, 60
    ELLIPSE 549, 645 + dy + fl, 5, 8 - fl, TRUE
    ELLIPSE 619, 651 + dy - fl, 5, 8 + fl, TRUE
    DRAWCOLOR 255, 240, 170
    ELLIPSE 549, 648 + dy + fl, 2, 4, TRUE
    ELLIPSE 619, 654 + dy - fl, 2, 4, TRUE
    ROUNDED_RECT 530, 868 + dy, 56, 15, 7, TRUE, 110, 64, 38
    ROUNDED_RECT 568, 863 + dy, 56, 15, 7, TRUE, 96, 56, 32
    DIM flick = SIN(t * 9) * 6
    DIM flick2 = SIN(t * 13 + 1) * 5
    DRAWCOLOR 240, 100, 30
    ELLIPSE 584 + flick2 / 2, 836 + dy - flick, 40, 36 + flick, TRUE
    DRAWCOLOR 255, 160, 40
    ELLIPSE 574 - flick2, 843 + dy, 24, 24 + flick2, TRUE
    ELLIPSE 596 + flick2, 845 + dy, 21, 21 - flick2, TRUE
    DRAWCOLOR 255, 230, 120
    ELLIPSE 584, 853 + dy, 14, 14 - flick / 2, TRUE
    FOR i = 0 TO 7
        DIM ph = (t * 0.7 + i / 8) - INT(t * 0.7 + i / 8)
        CIRCLE 584 + SIN(i * 3 + t * 2) * 22 * ph, 846 + dy - ph * 90, MAX([1, 4 * (1 - ph)]), TRUE, 255, 220, 120
    NEXT i
    ' the tree in the middle, its star glowing and its lights blinking
    DIM tx0 = 245
    DIM ty0 = 520 + dy
    DIM ts = 0.85
    DIM glow = 26 + SIN(t * 3) * 7
    CIRCLE tx0 + 140 * ts, ty0 + 40 * ts, glow + 14, TRUE, 120, 70, 70
    CIRCLE tx0 + 140 * ts, ty0 + 40 * ts, glow, TRUE, 170, 120, 80
    DrawPic(room{"tree"}, tx0, ty0, ts)
    DIM lights = [[70, 398], [110, 384], [150, 378], [190, 382], [225, 390], [78, 306], [115, 296], [150, 292], [185, 294], [210, 300], [98, 208], [130, 200], [162, 199], [188, 204]]
    FOR i = 0 TO LEN(lights) - 1
        DrawLight(tx0 + lights[i][0] * ts, ty0 + lights[i][1] * ts, i, t)
    NEXT i
    DIM sx = tx0 + 140 * ts + COS(t * 2) * 40
    DIM sy = ty0 + 40 * ts + SIN(t * 2) * 40
    GFX.STROKE sx, sy - 8, sx, sy + 8, 3, 255, 250, 200
    GFX.STROKE sx - 8, sy, sx + 8, sy, 3, 255, 250, 200
    DrawPic(room{"presents"}, 266, 826 + dy, 0.8)
    ' the garland along the ceiling
    FOR i = 0 TO 30
        DIM gx = i * 24
        DIM gy = 30 + SIN(gx / FW * MATH.PI) * 34
        CIRCLE gx, gy, 13, TRUE, 40, 140, 80
    NEXT i
    FOR i = 0 TO 14
        DIM bx = 24 + i * 48
        DrawLight(bx, 44 + SIN(bx / FW * MATH.PI) * 34, i + 2, t)
    NEXT i
    ' the cat, asleep and breathing, dreaming in Zs
    DIM cat = room{"cat"}
    DIM breath = 1 + SIN(t * 2.2) * 0.03
    GFX.DRAWIMAGE_EX(cat[0], 528, 1136 + cat[2] * (1 - breath), cat[1], cat[2] * breath, 0)
    FOR i = 0 TO 2
        DIM zp = (t * 0.35 + i / 3) - INT(t * 0.35 + i / 3)
        TEXT 624 + zp * 40 + SIN(t * 2 + i) * 6, 1130 - zp * 80, IIF(i = 1, "Z", "z"), 255, 255, 255
    NEXT i
ENDSUB

' A roof: a triangle of width w and height h with its tip at (cx, top), in strips.
SUB Roof(cx, top, w, h, r, g, b)
    DIM k = 0
    FOR k = 0 TO h STEP 3
        DIM rw = w * k / h
        RECT cx - rw / 2, top + k, rw, 3, TRUE, r, g, b
    NEXT k
ENDSUB

SUB House(x, y, w, h, wall, t, seed)
    RECT x, y, w, h, TRUE, wall[0], wall[1], wall[2]
    Roof(x + w / 2, y - h * 0.6, w + 40, h * 0.6, 150, 70, 70)
    Roof(x + w / 2, y - h * 0.6 - 6, w + 44, 26, 250, 250, 255)
    DIM lit = 0.85 + SIN(t * 3 + seed) * 0.15
    RECT x + w * 0.18, y + h * 0.3, w * 0.24, h * 0.3, TRUE, 255 * lit, 210 * lit, 110 * lit
    RECT x + w * 0.58, y + h * 0.3, w * 0.24, h * 0.3, TRUE, 255 * lit, 200 * lit, 100 * lit
    RECT x + w * 0.4, y + h * 0.55, w * 0.2, h * 0.45, TRUE, 110, 66, 44
ENDSUB

SUB Snowman(x, y, t)
    CIRCLE x, y, 62, TRUE, 236, 242, 252
    CIRCLE x, y - 88, 44, TRUE, 246, 250, 255
    CIRCLE x, y - 152, 34, TRUE, 252, 253, 255
    DIM wave = SIN(t * 3) * 18
    GFX.STROKE x - 40, y - 96, x - 92, y - 130 - wave, 6, 110, 70, 40
    GFX.STROKE x + 40, y - 96, x + 90, y - 112, 6, 110, 70, 40
    RECT x - 46, y - 124, 92, 16, TRUE, 216, 40, 60
    RECT x + 12, y - 124, 18, 46, TRUE, 216, 40, 60
    ROUNDED_RECT x - 30, y - 222, 60, 46, 6, TRUE, 40, 36, 44
    RECT x - 44, y - 182, 88, 10, TRUE, 40, 36, 44
    RECT x - 30, y - 192, 60, 8, TRUE, 216, 40, 60
    CIRCLE x - 12, y - 160, 5, TRUE, 40, 36, 44
    CIRCLE x + 12, y - 160, 5, TRUE, 40, 36, 44
    GFX.STROKE x, y - 150, x + 26, y - 146, 9, 255, 140, 40
    GFX.STROKE x + 26, y - 146, x + 38, y - 144, 4, 255, 140, 40
    DRAWCOLOR 255, 140, 160
    ELLIPSE x - 22, y - 140, 7, 4, TRUE
    ELLIPSE x + 22, y - 140, 7, 4, TRUE
    CIRCLE x, y - 70, 6, TRUE, 40, 36, 44
    CIRCLE x, y - 98, 6, TRUE, 40, 36, 44
ENDSUB

SUB Lantern(x, y, t)
    RECT x - 5, y, 10, 220, TRUE, 50, 50, 64
    DIM glow = 34 + SIN(t * 2.4 + x) * 5
    CIRCLE x, y - 6, glow, TRUE, 90, 90, 110
    CIRCLE x, y - 6, glow * 0.6, TRUE, 170, 150, 110
    ROUNDED_RECT x - 16, y - 30, 32, 40, 6, TRUE, 255, 220, 140
    RECT x - 20, y - 36, 40, 8, TRUE, 50, 50, 64
ENDSUB

SUB DrawSnowland(room, t)
    IF NOT ISNONE(room{"bg_snow"} ?? NONE) THEN
        DrawBg(room{"bg_snow"})
        DIM s = 0
        FOR s = 0 TO 11
            DIM tw = (t * 0.9 + s * 0.37) - INT(t * 0.9 + s * 0.37)
            IF tw < 0.5 THEN Sparkle((s * 173 + 40) MOD FW, 40 + (s * 97) MOD 340, 12 * SIN(tw * MATH.PI * 2), 3)
        NEXT s
        FOR s = 0 TO 19
            IF (INT(t * 4) + s * 3) MOD 7 = 0 THEN Sparkle((s * 89 + 20) MOD FW, 800 + (s * 61) MOD 440, 7, 2)
        NEXT s
        FOR s = 0 TO 59
            DIM fx = (s * 97 + INT(t * 20 * (1 + s MOD 3) + SIN(t + s) * 12)) MOD FW
            DIM fy = (s * 53 + INT(t * 50 * (1 + s MOD 2))) MOD FH
            CIRCLE fx, fy, 2 + s MOD 3, TRUE, 255, 255, 255
        NEXT s
        RETURN
    ENDIF
    RECT 0, 0, FW, 300, TRUE, 18, 24, 60
    RECT 0, 300, FW, 300, TRUE, 28, 38, 88
    RECT 0, 600, FW, 300, TRUE, 46, 62, 120
    DIM i = 0
    FOR i = 0 TO 39
        DIM tw = (INT(t * 3) + i) MOD 7
        CIRCLE (i * 131) MOD FW, (i * 71) MOD 560 + 20, IIF(tw = 0, 3, 1.5), TRUE, 255, 255, 230
    NEXT i
    CIRCLE 590, 150, 46, TRUE, 255, 244, 200
    CIRCLE 574, 140, 10, TRUE, 238, 226, 186
    CIRCLE 604, 168, 7, TRUE, 238, 226, 186
    DRAWCOLOR 206, 222, 246
    ELLIPSE 140, 760, 300, 150, TRUE
    DRAWCOLOR 222, 234, 252
    ELLIPSE 600, 780, 340, 160, TRUE
    House(40, 650, 130, 110, [200, 120, 90], t, 1)
    House(470, 640, 150, 120, [120, 150, 200], t, 2)
    DIM trees = [[180, 610, 0.42], [380, 560, 0.5], [620, 620, 0.4]]
    FOR i = 0 TO LEN(trees) - 1
        DrawPic(room{"tree"}, trees[i][0], trees[i][1], trees[i][2])
    NEXT i
    RECT 0, 880, FW, FH - 880, TRUE, 236, 242, 252
    DRAWCOLOR 214, 226, 246
    ELLIPSE 360, 890, 420, 30, TRUE
    FOR i = 0 TO 24
        DIM sp = (INT(t * 4) + i * 3) MOD 9
        IF sp = 0 THEN CIRCLE (i * 89) MOD FW, 920 + (i * 37) MOD 340, 3, TRUE, 255, 255, 255
    NEXT i
    Lantern(30, 690, t)
    Lantern(690, 700, t)
    Snowman(360, 860, t)
    FOR i = 0 TO 59
        DIM fx = (i * 97 + INT(t * 20 * (1 + i MOD 3) + SIN(t + i) * 12)) MOD FW
        DIM fy = (i * 53 + INT(t * 50 * (1 + i MOD 2))) MOD FH
        CIRCLE fx, fy, 2 + i MOD 3, TRUE, 255, 255, 255
    NEXT i
ENDSUB

' ---------------------------------------------------------------- bubble and effects

FUNC Wrap(text$, max_w)
    DIM words = SPLIT(text$, " ")
    DIM rows = []
    DIM cur$ = ""
    DIM i = 0
    FOR i = 0 TO LEN(words) - 1
        DIM probe$ = IIF(cur$ = "", words[i], cur$ + " " + words[i])
        IF GFX.TEXTSIZE(probe$)[0] > max_w ANDALSO cur$ <> "" THEN
            rows = APPEND(rows, cur$)
            cur$ = words[i]
        ELSE
            cur$ = probe$
        ENDIF
    NEXT i
    IF cur$ <> "" THEN rows = APPEND(rows, cur$)
    RETURN rows
ENDFUNC

' A bubble whose text has typed n_chars characters, its tail towards (tx, ty).
SUB DrawBubble(text$, n_chars, tx, ty)
    DIM bw = 560
    DIM rows = Wrap(text$, bw - 60)
    DIM bh = 40 + LEN(rows) * 44
    DIM bx = CLAMP(tx - bw / 2, 16, FW - bw - 16)
    DIM by = MAX([40, ty - 110 - bh])
    DIM root_x = CLAMP(tx + IIF(tx < FW / 2, 40, -40), bx + 60, bx + bw - 60)
    DIM root_y = by + bh - 12
    DIM seg = 0
    FOR seg = 0 TO 9
        DIM f0 = seg / 10
        DIM f1 = (seg + 1) / 10
        GFX.STROKE LERP(root_x, tx, f0), LERP(root_y, ty, f0), LERP(root_x, tx, f1), LERP(root_y, ty, f1), 34 - seg * 3, 255, 255, 255
    NEXT seg
    ROUNDED_RECT bx, by + 6, bw, bh, 28, TRUE, 60, 30, 40
    ROUNDED_RECT bx, by, bw, bh, 28, TRUE, 255, 255, 255
    DIM remaining = n_chars
    DIM i = 0
    FOR i = 0 TO LEN(rows) - 1
        IF remaining <= 0 THEN EXITFOR
        DIM shown$ = LEFTW$(rows[i], remaining)
        TEXT bx + 30, by + 22 + i * 44, shown$, 50, 30, 40
        remaining = remaining - LENW(rows[i]) - 1
    NEXT i
ENDSUB

SUB DrawConfetti(t)
    DIM i = 0
    FOR i = 0 TO 44
        DIM col = Bulb(i)
        DIM cx = (i * 97) MOD FW + SIN(t * 2 + i) * 24
        DIM cy = (t * (140 + (i MOD 5) * 40) + i * 53) - INT((t * (140 + (i MOD 5) * 40) + i * 53) / 1300) * 1300 - 20
        DIM wob = ABS(SIN(t * 6 + i)) * 10 + 2
        RECT cx, cy, 12, wob, TRUE, col[0], col[1], col[2]
    NEXT i
ENDSUB

SUB DrawHearts(heart, t, x, y)
    DIM i = 0
    FOR i = 0 TO 5
        DIM ph = (t * 0.5 + i / 6) - INT(t * 0.5 + i / 6)
        DIM s = 0.5 + ph * 0.8
        GFX.DRAWIMAGE_EX(heart[0], x + SIN(t * 3 + i * 2) * 60 - 24 * s, y - ph * 360, heart[1] * s, heart[2] * s, SIN(t * 4 + i) * 15)
    NEXT i
ENDSUB

' ---------------------------------------------------------------- one frame

FUNC IdlePose(x, y, sc, t, seed)
    DIM bob = ABS(SIN(t * 2.6 + seed)) * 6
    RETURN {"x": x, "y": y - bob, "scale": sc, "tilt": SIN(t * 1.5 + seed) * 2, "head": SIN(t * 1.9 + seed) * 4, "arm_l": 14 + SIN(t * 1.3 + seed) * 4, "arm_r": -14 - SIN(t * 1.4 + seed) * 4, "leg_l": 0, "leg_r": 0, "mouth": 0, "laugh": FALSE, "eyes": IIF(((INT(t * 1000) + INT(seed * 977)) MOD 3400) < 130, "blink", "open"), "tail": SIN(t * 2.4 + seed) * 6, "t": t}
ENDFUNC

FUNC BaseScale(name$)
    IF name$ = "lina" THEN RETURN 0.88
    IF name$ = "rudi" THEN RETURN 0.9
    IF name$ = "pip" ORELSE name$ = "pino" THEN RETURN 0.84
    RETURN 0.95
ENDFUNC

' How far a figure with short legs stands lower, so its feet reach the floor.
FUNC Sink(name$)
    IF name$ = "pino" THEN RETURN 44
    RETURN 0
ENDFUNC

' Where the figures of a scene stand: [x, y, scale factor] for one to three.
FUNC Slots(n)
    IF n = 1 THEN RETURN [[360, 1070, 1.0]]
    IF n = 2 THEN RETURN [[168, 1070, 1.0], [548, 1074, 1.0]]
    RETURN [[120, 1074, 0.8], [360, 1086, 0.8], [600, 1074, 0.8]]
ENDFUNC

SUB Backdrop(room, b$, t)
    IF b$ = "snow" THEN
        DrawSnowland(room, t)
    ELSEIF b$ = "workshop" ANDALSO NOT ISNONE(room{"bg_workshop"} ?? NONE) THEN
        DrawWorkshop(room, t)
    ELSEIF b$ = "forest" ANDALSO NOT ISNONE(room{"bg_forest"} ?? NONE) THEN
        DrawForest(room, t)
    ELSEIF b$ = "forest" THEN
        DrawSnowland(room, t)
    ELSE
        DrawRoom(room, t)
    ENDIF
ENDSUB

' The toy workshop: snow in the round window, the garland's lights blink,
' the toys on the shelves sparkle.
SUB DrawWorkshop(room, t)
    DrawBg(room{"bg_workshop"})
    DIM i = 0
    FOR i = 0 TO 15
        DIM a = i * 2.39
        DIM d = ((i * 37 + INT(t * 30 * (1 + i MOD 3))) MOD 170) - 85
        DIM wx = 592 + COS(a) * (i MOD 5) * 14 + SIN(t + i) * 4
        DIM wy = 208 + d
        IF (wx - 592) * (wx - 592) + (wy - 208) * (wy - 208) < 78 * 78 THEN CIRCLE wx, wy, 1.5 + i MOD 2, TRUE, 255, 255, 255
    NEXT i
    FOR i = 0 TO 13
        DrawLight(26 + i * 50, 92 + SIN(i * 1.3) * 6, i, t)
    NEXT i
    FOR i = 0 TO 9
        DIM tw = (t * 0.8 + i * 0.29) - INT(t * 0.8 + i * 0.29)
        IF tw < 0.4 THEN Sparkle((i * 151 + 60) MOD FW, 150 + (i * 89) MOD 400, 11 * SIN(tw / 0.4 * MATH.PI), 3)
    NEXT i
ENDSUB

' The forest clearing: stars twinkle, the lanterns glimmer, now and then a
' shooting star, and snow falls.
SUB DrawForest(room, t)
    DrawBg(room{"bg_forest"})
    DIM i = 0
    FOR i = 0 TO 9
        DIM tw = (t * 0.9 + i * 0.31) - INT(t * 0.9 + i * 0.31)
        IF tw < 0.5 THEN Sparkle(170 + (i * 137) MOD 420, 30 + (i * 71) MOD 300, 10 * SIN(tw * MATH.PI * 2), 2)
    NEXT i
    DIM lanterns = [[99, 337], [47, 546], [659, 554], [550, 467]]
    FOR i = 0 TO LEN(lanterns) - 1
        IF (INT(t * 3) + i * 2) MOD 5 = 0 THEN Sparkle(lanterns[i][0] + 16, lanterns[i][1] - 18, 8, 2)
    NEXT i
    DIM fly = t / 7 - INT(t / 7)
    IF fly < 0.12 THEN
        DIM sx = 560 - fly / 0.12 * 380
        DIM sy = 60 + fly / 0.12 * 140
        GFX.STROKE sx, sy, sx + 60, sy - 22, 3, 255, 250, 220
        CIRCLE sx, sy, 3, TRUE, 255, 255, 255
    ENDIF
    FOR i = 0 TO 59
        DIM fx = (i * 97 + INT(t * 20 * (1 + i MOD 3) + SIN(t + i) * 12)) MOD FW
        DIM fy = (i * 53 + INT(t * 50 * (1 + i MOD 2))) MOD FH
        CIRCLE fx, fy, 2 + i MOD 3, TRUE, 255, 255, 255
    NEXT i
ENDSUB

FUNC Dance(p, beat)
    p{"y"} = p{"y"} - ABS(SIN(beat)) * 50
    p{"tilt"} = SIN(beat / 2) * 8
    p{"arm_l"} = 140 + SIN(beat) * 25
    p{"arm_r"} = -140 + SIN(beat) * 25
    p{"leg_l"} = SIN(beat) * 14
    p{"leg_r"} = -SIN(beat) * 14
    p{"laugh"} = TRUE
    p{"eyes"} = "happy"
    p{"tail"} = SIN(beat) * 22
    RETURN p
ENDFUNC

FUNC Cheer(p, at, k)
    p{"arm_l"} = 150 + SIN(at * 8 + k) * 15
    p{"arm_r"} = -150 - SIN(at * 8 + k) * 15
    p{"eyes"} = "happy"
    p{"laugh"} = TRUE
    p{"y"} = p{"y"} - ABS(SIN(at * 7 + k)) * 20
    RETURN p
ENDFUNC

' An arm stretched out towards x.
FUNC Reach(p, x, amount)
    IF x >= p{"x"} THEN
        p{"arm_r"} = -amount
    ELSE
        p{"arm_l"} = amount
    ENDIF
    RETURN p
ENDFUNC

' Two figures walked together for a hug, by the share f of the way.
FUNC HugShift(poses, by, onto, f)
    IF by = onto THEN RETURN poses
    DIM near = by
    DIM far = onto
    IF poses[by]{"x"} > poses[onto]{"x"} THEN
        near = onto
        far = by
    ENDIF
    DIM cx = (poses[near]{"x"} + poses[far]{"x"}) / 2
    poses[near]{"x"} = LERP(poses[near]{"x"}, cx - 92, f)
    poses[far]{"x"} = LERP(poses[far]{"x"}, cx + 92, f)
    RETURN poses
ENDFUNC

' Who throws the snowball at time at: by first, then back and forth.
FUNC Thrower(by, onto, at)
    IF INT(at / 1.2) MOD 2 = 0 THEN RETURN by
    RETURN onto
ENDFUNC

' The poses of action a$ of figure by towards figure onto at its time at.
FUNC ActionPoses(a$, poses, at, by, onto)
    DIM n = LEN(poses)
    DIM k = 0
    IF a$ = "dance" THEN
        FOR k = 0 TO n - 1
            poses[k] = Dance(poses[k], at * 6 + k * MATH.PI)
        NEXT k
    ELSEIF a$ = "gift" THEN
        IF at < 1.2 ANDALSO by <> onto THEN
            poses[by] = Reach(poses[by], poses[onto]{"x"}, 80)
            poses[onto]{"mouth"} = 0.6
        ELSEIF at > 1.6 THEN
            FOR k = 0 TO n - 1
                poses[k] = Cheer(poses[k], at, k)
            NEXT k
        ENDIF
    ELSEIF a$ = "hug" ANDALSO by <> onto THEN
        DIM f = MIN([1, at / 1.2])
        poses = HugShift(poses, by, onto, f)
        poses[by] = Reach(poses[by], poses[onto]{"x"}, 75 + f * 15)
        poses[onto] = Reach(poses[onto], poses[by]{"x"}, 75 + f * 15)
        poses[by]{"tilt"} = f * IIF(poses[by]{"x"} < poses[onto]{"x"}, 6, -6)
        poses[onto]{"tilt"} = f * IIF(poses[onto]{"x"} < poses[by]{"x"}, 6, -6)
        IF f >= 1 THEN
            poses[by]{"eyes"} = "happy"
            poses[onto]{"eyes"} = "happy"
        ENDIF
    ELSEIF a$ = "snowball" ANDALSO by <> onto THEN
        DIM thrower = Thrower(by, onto, at)
        DIM target = IIF(thrower = by, onto, by)
        DIM p = at / 1.2 - INT(at / 1.2)
        IF poses[thrower]{"x"} < poses[target]{"x"} THEN
            poses[thrower]{"arm_r"} = -160 + p * 130
        ELSE
            poses[thrower]{"arm_l"} = 160 - p * 130
        ENDIF
        IF p > 0.8 THEN
            poses[target]{"eyes"} = "happy"
            poses[target]{"laugh"} = TRUE
            poses[target]{"tilt"} = SIN(p * 40) * 6
        ENDIF
        poses[thrower]{"mouth"} = 0.5
    ELSEIF a$ = "kiss" ANDALSO by <> onto THEN
        IF at < 0.5 THEN
            poses[by] = Reach(poses[by], poses[onto]{"x"}, 120)
            poses[by]{"eyes"} = "blink"
        ELSE
            poses[by] = Reach(poses[by], poses[onto]{"x"}, 70)
            poses[by]{"eyes"} = "happy"
        ENDIF
        IF at > 1.4 THEN
            poses[onto]{"eyes"} = "happy"
            poses[onto]{"laugh"} = TRUE
            poses[onto]{"y"} = poses[onto]{"y"} - ABS(SIN(at * 7)) * 16
        ENDIF
    ELSEIF a$ = "wave" THEN
        FOR k = 0 TO n - 1
            IF k = by ORELSE at > 0.7 THEN
                IF poses[k]{"x"} <= FW / 2 THEN
                    poses[k]{"arm_r"} = -150 + SIN(at * 9 + k) * 22
                ELSE
                    poses[k]{"arm_l"} = 150 + SIN(at * 9 + k) * 22
                ENDIF
                poses[k]{"laugh"} = (k = by)
            ENDIF
        NEXT k
    ELSEIF a$ = "surprise" THEN
        DIM jump = 0
        IF at < 0.6 THEN jump = SIN(at / 0.6 * MATH.PI) * 70
        FOR k = 0 TO n - 1
            poses[k]{"y"} = poses[k]{"y"} - jump
            poses[k]{"mouth"} = 1
            poses[k]{"arm_l"} = 60
            poses[k]{"arm_r"} = -60
        NEXT k
    ELSE
        FOR k = 0 TO n - 1
            poses[k]{"laugh"} = TRUE
            poses[k]{"eyes"} = "happy"
            poses[k]{"y"} = poses[k]{"y"} - ABS(SIN(at * 9 + k)) * 22
        NEXT k
    ENDIF
    RETURN poses
ENDFUNC

SUB Sparkle(x, y, r, w)
    GFX.STROKE x - r, y, x + r, y, w, 255, 250, 210
    GFX.STROKE x, y - r, x, y + r, w, 255, 250, 210
ENDSUB

SUB GiftBox(gx, gy, at, room)
    ROUNDED_RECT gx - 56, gy - 96, 112, 96, 8, TRUE, 120, 200, 255
    RECT gx - 9, gy - 96, 18, 96, TRUE, 255, 214, 70
    DIM ly = gy - 112
    DIM lx = gx - 64
    DIM i = 0
    IF at > 1.6 THEN
        DIM opened = at - 1.6
        ly = ly - opened * 520 + opened * opened * 140
        lx = lx + opened * 90
        FOR i = 0 TO 9
            DIM sa = i * 0.63 + at
            DIM sr = 40 + opened * 160
            Sparkle(gx + COS(sa) * sr, gy - 110 - ABS(SIN(sa)) * sr, 10, 4)
        NEXT i
        DrawHearts(room{"heart"}, at, gx, gy - 120)
    ENDIF
    ROUNDED_RECT lx, ly, 128, 24, 8, TRUE, 90, 170, 240
    RECT lx + 55, ly, 18, 24, TRUE, 255, 214, 70
    DRAWCOLOR 255, 214, 70
    ELLIPSE lx + 50, ly - 6, 16, 9, TRUE
    ELLIPSE lx + 78, ly - 6, 16, 9, TRUE
ENDSUB

' What an action shows besides the figures.
SUB ActionFx(a$, room, poses, at, by, onto)
    DIM n = LEN(poses)
    DIM i = 0
    IF a$ = "gift" THEN
        IF by = onto THEN
            ' one figure alone: the present drops from the sky beside it
            DIM gx = poses[by]{"x"} + IIF(poses[by]{"x"} < FW / 2, 190, -190)
            DIM fall = MAX([0, 1 - at * 2])
            GiftBox(gx, 1150 - fall * 700, at, room)
        ELSE
            ' the present travels from the giver's hands to the other's feet
            DIM q = MIN([1, at / 1.2])
            DIM side = IIF(poses[onto]{"x"} > poses[by]{"x"}, 1, -1)
            DIM x0 = poses[by]{"x"} + side * 90
            DIM y0 = poses[by]{"y"} - 120
            DIM x1 = poses[onto]{"x"} - side * 110
            DIM y1 = 1150
            GiftBox(LERP(x0, x1, q), LERP(y0, y1, q) - SIN(q * MATH.PI) * 160, at, room)
        ENDIF
    ELSEIF a$ = "hug" ANDALSO by <> onto THEN
        IF at > 1.0 THEN DrawHearts(room{"heart"}, at, (poses[by]{"x"} + poses[onto]{"x"}) / 2, 700)
    ELSEIF a$ = "snowball" ANDALSO by <> onto THEN
        DIM thrower = Thrower(by, onto, at)
        DIM target = IIF(thrower = by, onto, by)
        DIM p = at / 1.2 - INT(at / 1.2)
        DIM sx0 = poses[thrower]{"x"} + IIF(poses[thrower]{"x"} < poses[target]{"x"}, 70, -70)
        DIM sy0 = poses[thrower]{"y"} - 220
        DIM sx1 = poses[target]{"x"}
        DIM sy1 = poses[target]{"y"} - 330
        IF p <= 0.82 THEN
            DIM sq = p / 0.82
            DIM bx = LERP(sx0, sx1, sq)
            DIM ball_y = LERP(sy0, sy1, sq) - SIN(sq * MATH.PI) * 180
            CIRCLE bx, ball_y, 19, TRUE, 150, 175, 215
            CIRCLE bx, ball_y, 16, TRUE, 250, 252, 255
            CIRCLE bx - 5, ball_y - 5, 6, TRUE, 255, 255, 255
        ELSE
            DIM sp = (p - 0.82) / 0.18
            FOR i = 0 TO 7
                DIM ang = i * 0.785
                CIRCLE sx1 + COS(ang) * sp * 70, sy1 + SIN(ang) * sp * 70, 9 * (1 - sp) + 2, TRUE, 250, 252, 255
            NEXT i
        ENDIF
    ELSEIF a$ = "kiss" ANDALSO by <> onto THEN
        DIM heart = room{"heart"}
        IF at >= 0.4 ANDALSO at < 1.5 THEN
            DIM kq = (at - 0.4) / 1.1
            DIM hx = LERP(poses[by]{"x"}, poses[onto]{"x"}, kq)
            DIM hy = LERP(poses[by]{"y"} - 300, poses[onto]{"y"} - 300, kq) - SIN(kq * MATH.PI) * 90
            DIM hs = 1.2 + SIN(at * 12) * 0.15
            GFX.DRAWIMAGE_EX(heart[0], hx - 24 * hs, hy - 22 * hs, heart[1] * hs, heart[2] * hs, SIN(at * 6) * 12)
        ELSEIF at >= 1.5 THEN
            DrawHearts(heart, at, poses[onto]{"x"}, poses[onto]{"y"} - 260)
        ENDIF
    ELSEIF a$ = "surprise" THEN
        FOR i = 0 TO n - 1
            DIM ex = poses[i]{"x"} + 70
            DIM ey = poses[i]{"y"} - 470 + SIN(at * 6 + i) * 6
            CIRCLE ex, ey, 26, TRUE, 255, 214, 70
            TEXT ex - 6, ey - 18, "!", 120, 40, 40
        NEXT i
    ELSEIF a$ = "laugh" THEN
        FOR i = 0 TO n - 1
            DIM hp = (at * 0.8 + i * 0.3) - INT(at * 0.8 + i * 0.3)
            TEXT poses[i]{"x"} - 40 + SIN(at * 4 + i) * 20, poses[i]{"y"} - 420 - hp * 120, "Ha ha!", 255, 240, 120
        NEXT i
    ENDIF
ENDSUB


' The figures of a scene in their places, facing the middle.
FUNC ScenePoses(sc, t)
    DIM cast = sc{"c"}
    DIM slots = Slots(LEN(cast))
    DIM poses = []
    DIM k = 0
    FOR k = 0 TO LEN(cast) - 1
        DIM p = IdlePose(slots[k][0], slots[k][1] + Sink(cast[k]) * slots[k][2], BaseScale(cast[k]) * slots[k][2], t, k * 1.7)
        p{"head"} = p{"head"} + IIF(slots[k][0] < FW / 2, 5, IIF(slots[k][0] > FW / 2, -5, 0))
        poses = APPEND(poses, p)
    NEXT k
    RETURN poses
ENDFUNC

SUB DrawCast(parts, sc, poses)
    DIM k = 0
    FOR k = 0 TO LEN(poses) - 1
        DrawFigure(parts{"cast"}{sc{"c"}[k]}, poses[k])
    NEXT k
ENDSUB

' The mood of a line from how it is written: "laugh" for haha, hihi, hehe or
' hoho, "ask" for a question, "think" for an ellipsis, "shout" for an
' exclamation, else "say".
FUNC Mood$(text$)
    DIM low$ = LCASE$(text$)
    IF INSTR(low$, "haha") >= 0 ORELSE INSTR(low$, "hihi") >= 0 ORELSE INSTR(low$, "hehe") >= 0 ORELSE INSTR(low$, "hoho") >= 0 THEN RETURN "laugh"
    DIM tail$ = RIGHT$(RTRIM$(text$), 3)
    IF tail$ = "..." THEN RETURN "think"
    IF RIGHT$(tail$, 1) = "?" THEN RETURN "ask"
    IF RIGHT$(tail$, 1) = "!" THEN RETURN "shout"
    RETURN "say"
ENDFUNC

' One frame of the story: t counts seconds since the program started (idle
' motion), st seconds since the story started, below 0 while it waits for
' the tap. The scenes play one after the other, each its steps in turn
' (bubbles and actions); after the last one everybody dances under confetti.
EXPORT SUB FRAME(parts, story, t, st)
    DIM room = parts{"room"}
    DIM scenes = story{"s"}
    DIM si = 0
    DIM rest = MAX([0, st])
    DO WHILE si < LEN(scenes) - 1 ANDALSO rest >= SCENELEN(scenes[si])
        rest = rest - SCENELEN(scenes[si])
        si = si + 1
    LOOP
    DIM sc = scenes[si]
    Backdrop(room, sc{"b"}, t)
    DIM poses = ScenePoses(sc, t)
    DIM steps = sc{"l"}
    IF st < 0 THEN
        DrawCast(parts, sc, poses)
        DIM pulse = SIN(t * 4) * 6
        ROUNDED_RECT 150 - pulse, 1150 - pulse / 2, 420 + pulse * 2, 90 + pulse, 34, TRUE, 216, 34, 52
        DIM lang$ = parts{"lang"} ?? "de"
        DIM call$ = Say$(lang$, "tap")
        IF story{"t"} <> "" THEN call$ = Say$(lang$, "for") + " " + story{"t"} + ": " + Say$(lang$, "tap_low")
        DIM cw = GFX.TEXTSIZE(call$)[0]
        TEXT (FW - cw) / 2, 1176, call$, 255, 255, 255
        RETURN
    ENDIF
    IF si < LEN(scenes) - 1 ORELSE rest < SCENELEN(sc) THEN
        ' the step at this moment, and the hugs before it, which keep the
        ' two together for the rest of the scene
        DIM idx = 0
        DIM lt = rest
        DO WHILE idx < LEN(steps) - 1 ANDALSO lt >= STEPLEN(steps[idx])
            IF ISACT(steps[idx]) THEN
                IF steps[idx][0] = "hug" THEN poses = HugShift(poses, steps[idx][1], steps[idx][2], 1)
            ENDIF
            lt = lt - STEPLEN(steps[idx])
            idx = idx + 1
        LOOP
        DIM cur = steps[idx]
        IF ISACT(cur) THEN
            poses = ActionPoses(cur[0], poses, lt, cur[1], cur[2])
            DrawCast(parts, sc, poses)
            ActionFx(cur[0], room, poses, lt, cur[1], cur[2])
            RETURN
        ENDIF
        DIM who = cur[0]
        DIM text$ = cur[1]
        DIM mood$ = Mood$(text$)
        DIM n_chars = INT(lt * 22)
        DIM k = 0
        IF n_chars < LENW(text$) THEN
            poses[who]{"mouth"} = ABS(SIN(lt * IIF(mood$ = "think", 8, 14)))
            IF poses[who]{"x"} <= FW / 2 THEN
                poses[who]{"arm_r"} = -40 + SIN(lt * 5) * 25
            ELSE
                poses[who]{"arm_l"} = 40 - SIN(lt * 5) * 25
            ENDIF
            IF idx = 0 ANDALSO si = 0 THEN poses[who]{"arm_r"} = -150 + SIN(lt * 9) * 22
            IF mood$ = "ask" THEN poses[who]{"head"} = poses[who]{"head"} + 12
            IF mood$ = "shout" THEN poses[who]{"y"} = poses[who]{"y"} - ABS(SIN(lt * 8)) * 16
            IF mood$ = "think" ANDALSO (INT(lt * 2) MOD 3) = 0 THEN poses[who]{"eyes"} = "blink"
            IF mood$ = "laugh" THEN
                poses[who]{"eyes"} = "happy"
                poses[who]{"laugh"} = TRUE
            ENDIF
        ELSE
            ' the line is said: the others answer its mood
            FOR k = 0 TO LEN(poses) - 1
                IF mood$ = "laugh" ORELSE mood$ = "shout" THEN
                    poses[k]{"laugh"} = TRUE
                    poses[k]{"eyes"} = "happy"
                    IF k <> who THEN poses[k]{"y"} = poses[k]{"y"} - ABS(SIN(lt * 9)) * 18
                ELSEIF mood$ = "ask" ANDALSO k <> who THEN
                    poses[k]{"head"} = poses[k]{"head"} - 10
                ELSEIF mood$ = "say" ANDALSO k <> who THEN
                    poses[k]{"eyes"} = "happy"
                ENDIF
            NEXT k
        ENDIF
        DrawCast(parts, sc, poses)
        DIM top = HeadTop(parts{"cast"}{sc{"c"}[who]}, poses[who])
        DrawBubble(text$, n_chars, top[0], top[1])
        RETURN
    ENDIF
    ' the happy end
    DIM et = rest - SCENELEN(sc)
    DIM j = 0
    FOR j = 0 TO LEN(poses) - 1
        poses[j] = Dance(poses[j], et * 6 + j * MATH.PI)
    NEXT j
    DrawHearts(room{"heart"}, et, 360, 760)
    DrawCast(parts, sc, poses)
    DrawConfetti(et)
    DIM lang$ = parts{"lang"} ?? "de"
    DIM rows = [Say$(lang$, "merry")]
    DIM names$ = ""
    IF story{"f"} <> "" ANDALSO story{"t"} <> "" THEN
        names$ = Say$(lang$, "from") + " " + story{"f"} + " " + Say$(lang$, "for_low") + " " + story{"t"}
    ELSEIF story{"f"} <> "" THEN
        names$ = Say$(lang$, "from") + " " + story{"f"}
    ENDIF
    IF names$ <> "" THEN rows = APPEND(rows, Wrap(names$, FW - 120))
    DIM widest = MAX(SELECT(LAMBDA r -> GFX.TEXTSIZE(r)[0], rows))
    ROUNDED_RECT (FW - widest) / 2 - 30, 140, widest + 60, 40 + LEN(rows) * 44, 30, TRUE, 216, 34, 52
    DIM ri = 0
    FOR ri = 0 TO LEN(rows) - 1
        DIM rw = GFX.TEXTSIZE(rows[ri])[0]
        TEXT (FW - rw) / 2, 160 + ri * 44, rows[ri], 255, 245, 220
    NEXT ri
    IF et > 4 THEN
        DIM again$ = Say$(lang$, "again")
        TEXT (FW - GFX.TEXTSIZE(again$)[0]) / 2, 1200, again$, 255, 255, 255
    ENDIF
ENDSUB


' The player's own words in German or English.
FUNC Say$(lang$, key$)
    DIM de = {"tap": "Tippen!", "tap_low": "tippen!", "for": "Für", "for_low": "für", "from": "Von", "merry": "Frohe Weihnachten!", "again": "Nochmal? Tippen!"}
    DIM en = {"tap": "Tap!", "tap_low": "tap!", "for": "For", "for_low": "for", "from": "From", "merry": "Merry Christmas!", "again": "Again? Tap!"}
    IF lang$ = "en" THEN RETURN en{key$}
    RETURN de{key$}
ENDFUNC

' ---------------------------------------------------------------- music

' A carol: its tempo, melody bars, the bass root and chord of each bar, the
' bell accents per bar ("~" for none) and whether sleigh bells fit it. All
' three are in the public domain.
FUNC Song(m)
    IF m = 1 THEN
        ' Jingle Bells (James Lord Pierpont, 1857), the chorus, 4/4
        RETURN {"bpm": 118, "bars": ["e5 e5 e5@2", "e5 e5 e5@2", "e5@2 g5@2 c5@3 d5", "e5@4", "f5 f5 f5 f5", "f5 e5 e5 [e5 e5]", "e5 d5 d5 e5", "d5@2 g5@2", "e5 e5 e5@2", "e5 e5 e5@2", "e5@2 g5@2 c5@3 d5", "e5@4", "f5 f5 f5 f5", "f5 e5 e5 [e5 e5]", "g5 g5 f5 d5", "c5@4"], "roots": ["c2", "c2", "c2", "c2", "f1", "c2", "g1", "g1", "c2", "c2", "c2", "c2", "f1", "c2", "g1", "c2"], "chords": ["C", "C", "C", "C", "F", "C", "G7", "G7", "C", "C", "C", "C", "F", "C", "G7", "C"], "bells": ["~", "~", "~", "e6 ~ ~ ~", "~", "~", "~", "g6 ~ ~ ~", "~", "~", "~", "e6 ~ ~ ~", "~", "~", "~", "c6 ~ ~ ~"], "sleigh": TRUE}
    ENDIF
    IF m = 2 THEN
        ' We Wish You a Merry Christmas (English traditional), 3/4
        RETURN {"bpm": 100, "bars": ["c5@2 c5 d5 c5 b4", "a4@2 a4@2 a4@2", "d5@2 d5 e5 d5 c5", "b4@2 g4@2 g4@2", "e5@2 e5 f5 e5 d5", "c5@2 a4@2 g4 g4", "a4@2 d5@2 b4@2", "c5@4 g4@2"], "roots": ["c2", "f1", "d2", "g1", "c2", "f1", "g1", "c2"], "chords": ["C", "F", "D7", "G", "C", "F", "G7", "C"], "bells": ["c6 ~ ~", "~", "d6 ~ ~", "~", "~", "~", "~", "c6 ~ ~"], "sleigh": FALSE}
    ENDIF
    ' Stille Nacht (Franz Xaver Gruber, 1818), 6/8
    RETURN {"bpm": 92, "bars": ["g4@3 a4 g4@2 e4@6", "g4@3 a4 g4@2 e4@6", "d5@4 d5@2 b4@6", "c5@4 c5@2 g4@6", "a4@4 a4@2 c5@3 b4 a4@2", "g4@3 a4 g4@2 e4@6", "a4@4 a4@2 c5@3 b4 a4@2", "g4@3 a4 g4@2 e4@6", "d5@4 d5@2 f5@3 d5 b4@2", "c5@12", "e5@12", "c5@3 g4 e4@2 g4@3 f4 d4@2", "c4@12", "~@12"], "roots": ["c2", "c2", "g1", "c2", "f1", "c2", "f1", "c2", "g1", "c2", "c2", "g1", "c2", "c2"], "chords": ["C", "C", "G7", "C", "F", "C", "F", "C", "G7", "C", "C", "G7", "C", "C"], "bells": ["e6", "~", "~", "~", "~", "~", "~", "~", "~", "c6", "e6", "~", "c6", "~"], "sleigh": FALSE}
ENDFUNC

EXPORT FUNC GENRES()
    RETURN [["cozy", "Stimmungsvoll", "Cozy"], ["trance", "Trance", "Trance"], ["rock", "Rock", "Rock"], ["swing", "Swing", "Swing"], ["chip", "8-Bit", "8-bit"]]
ENDFUNC

' A note name moved by semis semitones: NoteAdd$("g1", 7) is "d2".
FUNC NoteAdd$(n$, semis)
    DIM names = ["c", "c#", "d", "d#", "e", "f", "f#", "g", "g#", "a", "a#", "b"]
    DIM octave = VAL(RIGHT$(n$, 1))
    DIM midi = FIND_IN_ARRAY(names, LEFT$(n$, LEN(n$) - 1)) + 12 * (octave + 1) + semis
    RETURN names[midi MOD 12] + STR$(INT(midi / 12) - 1)
ENDFUNC

' The root of a chord symbol: "G7" is "G", "F#m" is "F#".
FUNC ChordRoot$(c$)
    IF LEN(c$) > 1 ANDALSO (MID$(c$, 1, 1) = "#" ORELSE MID$(c$, 1, 1) = "b") THEN RETURN LEFT$(c$, 2)
    RETURN LEFT$(c$, 1)
ENDFUNC

' One step per bar, cycling: "<a b c>".
FUNC PerBar$(items)
    RETURN "<" + JOIN(items, " ") + ">"
ENDFUNC

' The patterns of carol m in genre g, track by track: 0 melody, 1 bass,
' 2 chords, 3 drums, 4 bells, 5 sleigh bells, 6 arpeggio; with the tempo.
EXPORT FUNC PATTERNS(m, g)
    DIM song = Song(m)
    DIM bars = song{"bars"}
    DIM roots = song{"roots"}
    DIM chords = song{"chords"}
    DIM p = {}
    p{"mel"} = "[[" + JOIN(bars, "] [") + "]]/" + STR$(LEN(bars))
    p{"bells"} = PerBar$(SELECT(LAMBDA b -> "[" + b + "]", song{"bells"}))
    p{"sleigh"} = ""
    IF song{"sleigh"} THEN p{"sleigh"} = "gain([0.9 0.5]*4, sh*8)"
    p{"drums"} = ""
    p{"arp"} = ""
    IF g = 1 THEN
        p{"bpm"} = INT(song{"bpm"} * 1.35)
        p{"bass"} = PerBar$(SELECT(LAMBDA r -> "[~ " + NoteAdd$(r, 12) + "]*4", roots))
        p{"chords"} = PerBar$(chords)
        p{"arp"} = PerBar$(SELECT(LAMBDA c -> "arp(up, add(12, " + c + "*4))", chords))
        p{"drums"} = "bd*4, [~ hh]*4, [~ cp]*2, <cr ~ ~ ~>"
    ELSEIF g = 2 THEN
        p{"bpm"} = INT(song{"bpm"} * 1.3)
        p{"bass"} = PerBar$(SELECT(LAMBDA r -> NoteAdd$(r, 12) + "*8", roots))
        p{"chords"} = PerBar$(SELECT(LAMBDA c -> "[" + ChordRoot$(c) + "5 ~ " + ChordRoot$(c) + "5 " + ChordRoot$(c) + "5]*2", chords))
        p{"drums"} = "bd ~ [bd bd] ~, ~ sd ~ sd, hh*8, <cr ~ ~ ~>"
    ELSEIF g = 3 THEN
        p{"bpm"} = INT(song{"bpm"} * 1.15)
        p{"mel"} = "swing(8, " + p{"mel"} + ")"
        p{"bass"} = PerBar$(SELECT(LAMBDA r -> "[" + NoteAdd$(r, 12) + " " + NoteAdd$(r, 16) + " " + NoteAdd$(r, 19) + " " + NoteAdd$(r, 21) + "]", roots))
        p{"chords"} = PerBar$(SELECT(LAMBDA c -> "[~ " + c + " ~ " + c + "]", chords))
        p{"drums"} = "swing(4, [hh hh hh hh]), ~ rim ~ rim, bd ~ ~ ~"
    ELSEIF g = 4 THEN
        p{"bpm"} = INT(song{"bpm"} * 1.4)
        p{"bass"} = PerBar$(SELECT(LAMBDA r -> "[" + NoteAdd$(r, 12) + " " + NoteAdd$(r, 24) + "]*4", roots))
        p{"chords"} = ""
        p{"arp"} = PerBar$(SELECT(LAMBDA c -> "arp(up, add(12, " + c + "*8))", chords))
        p{"drums"} = "bd ~ sd ~, hh*8"
    ELSE
        p{"bpm"} = song{"bpm"}
        p{"bass"} = PerBar$(roots)
        p{"chords"} = PerBar$(chords)
    ENDIF
    RETURN p
ENDFUNC

' Starts carol m of MUSICS() in genre g of GENRES() on the sequencer.
EXPORT SUB MUSIC(m, g)
    DIM p = PATTERNS(m, g)
    SOUND.INIT
    SOUND.RESET
    SOUND.MASTER "FIXED", 0.32
    SOUND.REVERB 0.7, 0.4, 0.8, 0.3
    SOUND.DISTORTION 0
    SOUND.BPM p{"bpm"}
    ' melody, bass, chords: the voices of the genre
    IF g = 1 THEN
        SOUND.VOICE 0, "SAW", 0.01, 0.3, 0.7, 0.3
        SOUND.UNISON 0, 5, 0.2, 0.9
        SOUND.FILTER 0, 4200
        SOUND.DELAY TRUE, "1/8.", 0.35, 0.25
        SOUND.DELAYSEND 0, 0.3
        SOUND.VOICE 1, "SAW", 0.005, 0.12, 0.0, 0.08
        SOUND.FILTER 1, 900, 0.3, "LP"
        SOUND.VOICE 2, "SAW", 0.4, 0.5, 0.7, 1.0
        SOUND.UNISON 2, 5, 0.25, 1.0
        SOUND.FILTER 2, 1800
        SOUND.VOICE 6, "SAW", 0.003, 0.15, 0.0, 0.1
        SOUND.OSC2 6, "SQUARE", -12, 0.5
        SOUND.FILTER 6, 2600
        SOUND.DELAYSEND 6, 0.35
    ELSEIF g = 2 THEN
        SOUND.DISTORTION 0.35
        SOUND.VOICE 0, "SQUARE", 0.01, 0.2, 0.8, 0.25
        SOUND.OSC2 0, "SAW", 0, 0.5, 7
        SOUND.FILTER 0, 3200
        SOUND.VOICE 1, "SAW", 0.005, 0.1, 0.6, 0.06
        SOUND.FILTER 1, 700
        SOUND.VOICE 2, "SAW", 0.005, 0.15, 0.6, 0.08
        SOUND.UNISON 2, 3, 0.1, 0.8
        SOUND.FILTER 2, 2400
    ELSEIF g = 3 THEN
        SOUND.VOICE 0, "TRIANGLE", 0.01, 0.3, 0.5, 0.3
        SOUND.FM 0, 0.6, 2
        SOUND.FILTER 0, 3000
        SOUND.VOICE 1, "SINE", 0.005, 0.25, 0.4, 0.15
        SOUND.OSC2 1, "TRIANGLE", 0, 0.4
        SOUND.VOICE 2, "SINE", 0.005, 0.3, 0.2, 0.2
        SOUND.FM 2, 0.8, 1
    ELSEIF g = 4 THEN
        SOUND.VOICE 0, "SQUARE", 0.002, 0.1, 0.7, 0.08
        SOUND.VOICE 1, "TRIANGLE", 0.002, 0.08, 0.6, 0.05
        SOUND.VOICE 6, "SQUARE", 0.002, 0.05, 0.3, 0.03
        SOUND.FILTER 6, 3000
    ELSE
        SOUND.VOICE 0, "TRIANGLE", 0.03, 0.4, 0.6, 0.6
        SOUND.UNISON 0, 3, 0.12, 0.6
        SOUND.OSC2 0, "SINE", -12, 0.35
        SOUND.FILTER 0, 2200
        SOUND.LFO 0, 5.2, 0.12
        SOUND.REVERBSEND 0, 0.45
        SOUND.VOICE 1, "SINE", 0.01, 0.3, 0.6, 0.5
        SOUND.VOICE 2, "SINE", 1.0, 0.5, 0.8, 1.8
        SOUND.UNISON 2, 3, 0.15, 0.8
        SOUND.REVERBSEND 2, 0.6
    ENDIF
    ' a glockenspiel and sleigh bells, the same in every genre
    SOUND.VOICE 4, "SINE", 0.002, 1.4, 0.0, 1.4
    SOUND.FM 4, 2.2, 3.5
    SOUND.REVERBSEND 4, 0.6
    SOUND.SEQ 0, p{"mel"}, "VOICE"
    SOUND.SEQ 1, p{"bass"}, "VOICE"
    IF p{"chords"} <> "" THEN SOUND.SEQ 2, p{"chords"}, "VOICE"
    IF p{"drums"} <> "" THEN
        SOUND.KIT 3, "SYNTH"
        SOUND.SEQ 3, p{"drums"}, "VOICE"
        SOUND.GAIN 3, 0.5
    ENDIF
    SOUND.SEQ 4, p{"bells"}, "VOICE"
    IF p{"sleigh"} <> "" THEN
        SOUND.KIT 5, "SYNTH"
        SOUND.FILTER 5, 5000, 0.2, "HP"
        SOUND.SEQ 5, p{"sleigh"}, "VOICE"
        SOUND.GAIN 5, 0.18
    ENDIF
    IF p{"arp"} <> "" THEN
        SOUND.SEQ 6, p{"arp"}, "VOICE"
        SOUND.GAIN 6, 0.12
    ENDIF
    SOUND.GAIN 0, 0.32
    SOUND.GAIN 1, 0.35
    SOUND.GAIN 2, IIF(g = 0, 0.14, 0.12)
    SOUND.GAIN 4, 0.14
ENDSUB
