' Spike for the Christmas story cards: the player of xmasplay.jdb full
' screen, a story read from the link, Stille Nacht after the first tap.
' Desktop: run from jdb/xmas, an optional argument is a story code.
' Browser: the page hands the code over as "s" in /url_params.json.
OPTION "EXPLICIT"

IMPORT XMASPLAY

DIM on_web = OS.GETOS$() = "WEB"
DIM art_dir$ = IIF(on_web, "/art/", "art/")
DIM font$ = "/jdbasic_default.ttf"
IF NOT on_web THEN font$ = PATH.DIRNAME$(OS.SELF$()) + "/jdbasic_default.ttf"

FUNC UrlParams()
    IF NOT on_web ORELSE NOT FILE.EXISTS("/url_params.json") THEN RETURN {}
    RETURN JSON.PARSE(TXTREADER$("/url_params.json"))
ENDFUNC

DIM url_params = UrlParams()
DIM muted = GETENV$("XMAS_MUTE") <> "" ORELSE MAP.EXISTS(url_params, "mute")

FUNC LinkCode$()
    IF on_web THEN RETURN "" + (url_params{"s"} ?? "")
    DIM a = OS.ARGS()
    IF LEN(a) > 0 THEN RETURN a[LEN(a) - 1]
    RETURN ""
ENDFUNC

DIM story = XMASPLAY.DECODE(LinkCode$())
IF ISNONE(story) THEN story = XMASPLAY.DEMO()
DIM demo_code$ = XMASPLAY.ENCODE$(XMASPLAY.DEMO())

SCREEN XMASPLAY.FW, XMASPLAY.FH, "Xmas spike"
SETFONT font$, 30

DIM t_load = TICK()
DIM parts = XMASPLAY.LOADPARTS(art_dir$)
DIM load_ms = TICK() - t_load

DIM started = FALSE
DIM running = TRUE

' ?ask=1 on the web: the first tap asks for the first line through the page's text field.
DIM ask_mode = on_web ANDALSO MAP.EXISTS(url_params, "ask")
DIM asking = FALSE

SUB AskText(prompt$, max_chars, value$)
    IF FILE.EXISTS("/input_reply.json") THEN KILL "/input_reply.json"
    TXTWRITER "/input_request.json", JSON.STRINGIFY$({"prompt": prompt$, "max": max_chars, "value": value$})
    asking = TRUE
ENDSUB

' The reply map once the page has answered, NONE before.
FUNC TextReply()
    IF NOT FILE.EXISTS("/input_reply.json") THEN RETURN NONE
    DIM reply = JSON.PARSE(TXTREADER$("/input_reply.json"))
    KILL "/input_reply.json"
    asking = FALSE
    RETURN reply
ENDFUNC

SUB OnTap(info)
    IF NOT started ANDALSO NOT asking THEN
        IF ask_mode THEN
            AskText("Dein Gruß (max. 80 Zeichen)", XMASPLAY.MAX_LINE, story{"s"}[0]{"l"}[0][1])
        ELSE
            started = TRUE
        ENDIF
        IF muted THEN RETURN
        TRY
            XMASPLAY.MUSIC()
        CATCH
            PRINT "music: "; ERRMSG$
        ENDTRY
    ENDIF
ENDSUB

SUB OnQuit(info)
    running = FALSE
ENDSUB

ON "MOUSEDOWN" CALL OnTap@
ON "QUIT" CALL OnQuit@

PRINT "parts "; load_ms; " ms, demo link "; LEN(demo_code$); " chars"

DIM t_start = TICK()
DIM t_run = 0
DIM frames = 0
DIM fps = 0
DIM fps_mark = TICK()

' XMAS_SHOTS=<dir> starts without a tap, saves frames at these story seconds and quits.
DIM shot_dir$ = GETENV$("XMAS_SHOTS")
DIM shot_times = [1, 18.6, 24, 34.4, XMASPLAY.LENGTH(story) + 1.5]
IF GETENV$("XMAS_SHOTS_AT") <> "" THEN shot_times = SELECT(LAMBDA s -> VAL(s), SPLIT(GETENV$("XMAS_SHOTS_AT"), ","))

' The story with its first bubble replaced.
FUNC WithFirstLine(s, text$)
    DIM scenes = s{"s"}
    DIM sc = scenes[0]
    DIM lines = sc{"l"}
    lines[0] = [lines[0][0], text$]
    sc{"l"} = lines
    scenes[0] = sc
    s{"s"} = scenes
    RETURN s
ENDFUNC

DIM fallback = XMASPLAY.DEMO()
DIM shot_i = 0

DO WHILE running
    DIM ms_now = TICK()
    IF asking THEN
        DIM reply = TextReply()
        IF NOT ISNONE(reply) THEN
            IF reply{"ok"} ANDALSO TRIM$(reply{"text"}) <> "" THEN story = WithFirstLine(story, XMASPLAY.CLEANTEXT$(reply{"text"}, XMASPLAY.MAX_LINE))
            started = TRUE
        ENDIF
    ENDIF
    IF NOT started THEN t_run = ms_now
    TRY
        XMASPLAY.FRAME(parts, story, (ms_now - t_start) / 1000, IIF(started, (ms_now - t_run) / 1000, -1))
    CATCH
        PRINT "frame: "; ERRMSG$; " "; STACK$
        story = fallback
    ENDTRY
    frames = frames + 1
    IF ms_now - fps_mark >= 1000 THEN
        fps = frames
        frames = 0
        fps_mark = ms_now
    ENDIF
    TEXT 10, XMASPLAY.FH - 40, STR$(fps) + " fps  parts " + STR$(INT(load_ms)) + " ms  link " + STR$(LEN(demo_code$)), 255, 255, 0
    IF shot_dir$ <> "" THEN
        IF NOT started THEN started = TRUE
        IF shot_i < LEN(shot_times) ANDALSO (ms_now - t_run) / 1000 >= shot_times[shot_i] THEN
            GFX.SAVE_SCREENSHOT(shot_dir$ + "/xmas_shot" + STR$(shot_i) + ".png")
            shot_i = shot_i + 1
            IF shot_i = LEN(shot_times) THEN running = FALSE
        ENDIF
    ENDIF
    SCREENFLIP
    SLEEP 1
LOOP
