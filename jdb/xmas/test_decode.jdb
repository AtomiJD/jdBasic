' Attacks XMASPLAY.DECODE with broken, random and crafted links: nothing may
' throw, and whatever decodes stays inside the editor's limits.
'
'   jdBasic jdb/xmas/test_decode.jdb
OPTION "EXPLICIT"

IMPORT XMASPLAY

DIM passed = 0
DIM failed = 0

SUB Check(ok, what$)
    IF ok THEN
        passed = passed + 1
    ELSE
        failed = failed + 1
        PRINT "FAIL "; what$
    ENDIF
ENDSUB

FUNC B64Url$(raw$)
    DIM s$ = REPLACE$(REPLACE$(CODEC.BASE64_ENCODE$(raw$), "+", "-"), "/", "_")
    DO WHILE ENDSWITH(s$, "=")
        s$ = LEFT$(s$, LEN(s$) - 1)
    LOOP
    RETURN s$
ENDFUNC

' A version 2 code with a right checksum around any JSON text.
FUNC Craft$(json$)
    DIM packed$ = CODEC.DEFLATE$(json$, 9, "raw")
    RETURN "2" + B64Url$(PACK$("<I", CODEC.CRC32(packed$)) + packed$)
ENDFUNC

' TRUE when the story keeps every limit the player relies on.
FUNC InLimits(s)
    IF NOT ISMAP(s) THEN RETURN FALSE
    IF LENW(s{"f"}) > XMASPLAY.MAX_NAME ORELSE LENW(s{"t"}) > XMASPLAY.MAX_NAME THEN RETURN FALSE
    IF LEN(s{"s"}) < 1 ORELSE LEN(s{"s"}) > XMASPLAY.MAX_SCENES THEN RETURN FALSE
    DIM sc = NONE
    FOR EACH sc IN s{"s"}
        IF LEN(sc{"c"}) < 1 ORELSE LEN(sc{"c"}) > XMASPLAY.MAX_CAST THEN RETURN FALSE
        IF LEN(sc{"l"}) = 0 THEN RETURN FALSE
        DIM n_lines = 0
        DIM n_acts = 0
        DIM ln = NONE
        FOR EACH ln IN sc{"l"}
            IF XMASPLAY.ISACT(ln) THEN
                n_acts = n_acts + 1
                IF LEN(ln) <> 3 THEN RETURN FALSE
                IF ln[1] < 0 ORELSE ln[1] >= LEN(sc{"c"}) ORELSE ln[2] < 0 ORELSE ln[2] >= LEN(sc{"c"}) THEN RETURN FALSE
            ELSE
                n_lines = n_lines + 1
                IF ln[0] < 0 ORELSE ln[0] >= LEN(sc{"c"}) THEN RETURN FALSE
                IF LENW(ln[1]) > XMASPLAY.MAX_LINE ORELSE ln[1] = "" THEN RETURN FALSE
            ENDIF
        NEXT ln
        IF n_lines > XMASPLAY.MAX_SCENE_LINES ORELSE n_acts > XMASPLAY.MAX_SCENE_ACTIONS THEN RETURN FALSE
    NEXT sc
    RETURN TRUE
ENDFUNC

' DECODE must answer NONE or a story in its limits, never throw.
FUNC Safe(code$)
    DIM s = NONE
    TRY
        s = XMASPLAY.DECODE(code$)
    CATCH
        PRINT "threw on "; LEFT$(code$, 40); ": "; ERRMSG$
        RETURN FALSE
    ENDTRY
    IF ISNONE(s) THEN RETURN TRUE
    RETURN InLimits(s)
ENDFUNC

' the demo goes there and back
DIM demo = XMASPLAY.DEMO()
DIM code$ = XMASPLAY.ENCODE$(demo)
DIM back = XMASPLAY.DECODE(code$)
Check(NOT ISNONE(back), "demo decodes")
Check(JSON.STRINGIFY$(back) = JSON.STRINGIFY$(XMASPLAY.CLEAN(demo)), "demo comes back the same")
Check(InLimits(back), "demo in limits")

' a link of the first format still plays: two lines, Santa and Lina in turn
DIM old = XMASPLAY.DECODE("1FYw9CgIxEEav8u3UwQNsp4VoZWFhIRaz2XFnID-QRATFa3kBL2YWXvOK994ULEml8UqHDF0ZsC-_rwbzKriIaWKvTZJDMJkEp8gDOTp6hXL32QqkPbli4fTCTmpOsxSpiNYWmcqab3D2yg9EDgPdHN1LjjTS1qvFPmu5Sx_T5w8")
Check(NOT ISNONE(old), "v1 link decodes")
IF NOT ISNONE(old) THEN
    Check(LEN(old{"s"}) = 1 ANDALSO LEN(old{"s"}[0]{"l"}) = 3, "v1 link: one scene, two lines and its action")
    Check(XMASPLAY.ISACT(old{"s"}[0]{"l"}[2]) ANDALSO old{"s"}[0]{"l"}[2][0] = "dance", "v1 link: the action comes last")
    Check(old{"s"}[0]{"l"}[1][0] = 1, "v1 link: the second line is Lina's")
ENDIF

' every single character changed, every length cut
DIM alphabet$ = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
DIM i = 0
DIM accepted = 0
FOR i = 1 TO LEN(code$) - 1
    DIM c$ = MID$(code$, i, 1)
    DIM swap$ = IIF(c$ = "A", "B", "A")
    DIM bent$ = LEFT$(code$, i) + swap$ + MID$(code$, i + 1)
    Check(Safe(bent$), "flip at " + STR$(i))
    IF NOT ISNONE(XMASPLAY.DECODE(bent$)) THEN accepted = accepted + 1
NEXT i
Check(accepted = 0, "a changed character never passes the checksum (" + STR$(accepted) + " did)")
FOR i = 0 TO LEN(code$) - 1
    Check(Safe(LEFT$(code$, i)), "cut at " + STR$(i))
NEXT i

' random links
RANDOMSEED(1048)
FOR i = 1 TO 400
    DIM n = INT(RND() * 300)
    DIM junk$ = IIF(RND() < 0.5, "2", "1")
    DIM k = 0
    FOR k = 1 TO n
        IF RND() < 0.9 THEN
            junk$ = junk$ + MID$(alphabet$, INT(RND() * 64), 1)
        ELSE
            junk$ = junk$ + CHR$(INT(RND() * 255) + 1)
        ENDIF
    NEXT k
    Check(Safe(junk$), "random link " + STR$(i))
NEXT i

' crafted links that pass the checksum
Check(ISNONE(XMASPLAY.DECODE(Craft$(SPACE$(1000000)))), "a deflate bomb is refused")
Check(ISNONE(XMASPLAY.DECODE(Craft$(REPEAT$("[", 5000) + REPEAT$("]", 5000)))), "deep nesting is refused")
Check(Safe(Craft$("5")), "a number")
Check(Safe(Craft$("[]")), "an empty list")
Check(Safe(Craft$("null")), "null")
Check(Safe(Craft$("{" + CHR$(34) + "s" + CHR$(34) + ":5}")), "scenes as a number")
DIM q$ = CHR$(34)
DIM wild$ = "{" + q$ + "f" + q$ + ":7," + q$ + "t" + q$ + ":[1]," + q$ + "m" + q$ + ":99," + q$ + "s" + q$ + ":[1," + q$ + "x" + q$ + ",{" + q$ + "b" + q$ + ":7," + q$ + "c" + q$ + ":" + q$ + "santa" + q$ + "," + q$ + "l" + q$ + ":[[99," + q$ + "hi" + q$ + "],[" + q$ + "x" + q$ + ",5],[0]]," + q$ + "a" + q$ + ":[]}]}"
DIM w = XMASPLAY.DECODE(Craft$(wild$))
Check(NOT ISNONE(w) ANDALSO InLimits(w), "wrong types are cleaned")
IF NOT ISNONE(w) THEN
    Check(w{"m"} = 0 ANDALSO w{"f"} = "" ANDALSO w{"s"}[0]{"b"} = "room" ANDALSO LEN(w{"s"}[0]{"l"}) = 1, "wrong types fall back to defaults, an unknown action is dropped")
ENDIF
DIM many = {"f": REPEAT$("x", 500), "t": "y", "s": []}
FOR i = 1 TO 5
    many{"s"} = APPEND(many{"s"}, {"b": "snow", "c": ["santa", "lina", "santa", "nobody", "lina"], "l": [[0, REPEAT$("ä", 120)], [1, "a"], [2, "b"], [0, "c"], [1, "d"], [0, "e"]], "a": "hug"})
NEXT i
DIM m = XMASPLAY.DECODE(Craft$(JSON.STRINGIFY$(many)))
Check(NOT ISNONE(m) ANDALSO InLimits(m), "too much of everything is cut to the limits")
DIM brackets = {"f": "a", "t": "b", "s": [{"b": "room", "c": ["santa"], "l": [[0, REPEAT$("[", 70)]], "a": "dance"}]}
DIM br = XMASPLAY.DECODE(XMASPLAY.ENCODE$(brackets))
Check(NOT ISNONE(br), "brackets inside a bubble are text, not nesting")
DIM gap = {"f": "a", "t": "b", "s": [{"b": "room", "c": ["santa"], "l": [[0, "  "], [0, ""]]}, {"b": "snow", "c": ["lina"], "l": [[0, "hallo"]], "a": "hug"}]}
DIM gp = XMASPLAY.DECODE(XMASPLAY.ENCODE$(gap))
Check(NOT ISNONE(gp) ANDALSO LEN(gp{"s"}) = 1 ANDALSO gp{"s"}[0]{"b"} = "snow", "a scene without text is dropped")
DIM trio = {"f": "a", "t": "b", "s": [{"b": "room", "c": ["pip", "rudi", "pino"], "l": [[2, "hallo"]], "a": "dance"}]}
DIM tr = XMASPLAY.DECODE(XMASPLAY.ENCODE$(trio))
Check(NOT ISNONE(tr) ANDALSO JSON.STRINGIFY$(tr{"s"}[0]{"c"}) = JSON.STRINGIFY$(["pip", "rudi", "pino"]), "every known figure keeps its place in the cast")
DIM bunnies = XMASPLAY.CLEAN({"f": "a", "t": "b", "s": [{"b": "snow", "c": ["hasi", "vally", "moehrchen"], "l": [[1, "hallo"]]}]})
Check(NOT ISNONE(bunnies) ANDALSO JSON.STRINGIFY$(bunnies{"s"}[0]{"c"}) = JSON.STRINGIFY$(["hasi", "vally", "moehrchen"]), "the three bunnies keep their places in the cast")
DIM couple = XMASPLAY.CLEAN({"f": "a", "t": "b", "s": [{"b": "room", "c": ["loni", "jd"], "l": [[1, "hallo"]]}]})
Check(NOT ISNONE(couple) ANDALSO JSON.STRINGIFY$(couple{"s"}[0]{"c"}) = JSON.STRINGIFY$(["loni", "jd"]), "Loni and JD keep their places in the cast")
DIM guest = XMASPLAY.CLEAN({"f": "a", "t": "b", "s": [{"b": "room", "c": ["chris", "jd"], "l": [[1, "hallo"]]}]})
Check(NOT ISNONE(guest) ANDALSO JSON.STRINGIFY$(guest{"s"}[0]{"c"}) = JSON.STRINGIFY$(["chris", "jd"]), "Chris keeps his place in the cast")
Check(NOT ISNONE(tr) ANDALSO tr{"s"}[0]{"l"}[0][0] = 2, "a bubble keeps its third speaker")
' actions between the bubbles keep their order; too many are cut, unknown ones and wrong figures are mended
DIM mixed = {"f": "a", "t": "b", "s": [{"b": "room", "c": ["santa", "lina"], "l": [[0, "eins"], ["gift", 0, 1], [1, "zwei"], ["hug", 1, 9], ["boom", 0, 1], ["kiss", "x", 0], ["wave", 0], ["dance", 0, 0], ["laugh", 1, 1], [0, "drei"]]}]}
DIM mx = XMASPLAY.DECODE(XMASPLAY.ENCODE$(mixed))
Check(NOT ISNONE(mx) ANDALSO InLimits(mx), "a mixed scene stays in its limits")
IF NOT ISNONE(mx) THEN
    DIM got = mx{"s"}[0]{"l"}
    Check(LEN(got) = 7, "four actions and three bubbles are kept, the unknown action is dropped (" + STR$(LEN(got)) + ")")
    IF LEN(got) = 7 THEN
    Check(JSON.STRINGIFY$(got[1]) = JSON.STRINGIFY$(["gift", 0, 1]), "an action keeps its place between the bubbles")
    Check(got[3][2] = 1, "a figure out of the cast is clamped into it")
    Check(got[4][1] = 0, "a figure that is no number becomes the first")
    Check(JSON.STRINGIFY$(got[6]) = JSON.STRINGIFY$([0, "drei"]), "a bubble after the fifth action still counts")
    ENDIF
ENDIF
DIM only_act = {"f": "a", "t": "b", "s": [{"b": "room", "c": ["santa", "lina"], "l": [["dance", 0, 1]]}]}
Check(NOT ISNONE(XMASPLAY.DECODE(XMASPLAY.ENCODE$(only_act))), "a scene of actions alone plays")
' every template of both languages survives the link and keeps all its steps; {name} becomes the recipient
DIM lg$ = ""
FOR EACH lg$ IN ["de", "en"]
    DIM tl = XMASPLAY.TEMPLATES(lg$)
    DIM ti = 0
    FOR ti = 1 TO LEN(tl) - 1
        DIM tdoc = tl[ti][1]
        tdoc{"f"} = "Anna"
        tdoc{"t"} = "Ben"
        DIM back_t = XMASPLAY.DECODE(XMASPLAY.ENCODE$(tdoc))
        Check(NOT ISNONE(back_t) ANDALSO InLimits(back_t), lg$ + " template " + tl[ti][0] + " plays")
        IF NOT ISNONE(back_t) THEN
            DIM want = SUM(SELECT(LAMBDA sc -> LEN(sc{"l"}), tdoc{"s"}))
            DIM have = SUM(SELECT(LAMBDA sc -> LEN(sc{"l"}), back_t{"s"}))
            Check(want = have, lg$ + " template " + tl[ti][0] + " keeps its " + STR$(want) + " steps (" + STR$(have) + ")")
            Check(INSTR(JSON.STRINGIFY$(back_t), "{name}") < 0, lg$ + " template " + tl[ti][0] + " names its recipient")
        ENDIF
    NEXT ti
NEXT lg$
Check(ISNONE(XMASPLAY.DECODE("2" + REPEAT$("A", 2100))), "an overlong code is refused")
Check(ISNONE(XMASPLAY.DECODE("")), "an empty code")
Check(ISNONE(XMASPLAY.DECODE("9abc")), "an unknown version")

' the closing greeting: kept through a link, a stranger becomes the first
DIM greet_story = {"f": "a", "t": "b", "e": 2, "s": [{"b": "snow", "c": ["santa", "lina"], "l": [[0, "hallo"]]}]}
DIM greet_back = XMASPLAY.DECODE(XMASPLAY.ENCODE$(XMASPLAY.CLEAN(greet_story)))
Check(NOT ISNONE(greet_back) ANDALSO greet_back{"e"} = 2, "the closing greeting survives a link")
DIM bad_e = NONE
FOR EACH bad_e IN [-1, 4, 99, "x", [1], 1.7]
    greet_story{"e"} = bad_e
    DIM ge = XMASPLAY.CLEAN(greet_story)
    Check(NOT ISNONE(ge) ANDALSO ISNUM(ge{"e"}) ANDALSO ge{"e"} >= 0 ANDALSO ge{"e"} < LEN(XMASPLAY.GREETINGS()), "a closing greeting of " + JSON.STRINGIFY$(bad_e) + " is mended")
NEXT bad_e
Check(XMASPLAY.CLEAN({"s": [{"b": "snow", "c": ["santa"], "l": [[0, "x"]]}]}){"e"} = 0, "a story without one says Merry Christmas")

' the reply link: the sender's name as a URL query, bytes outside the plain
' set percent-encoded, nothing when there is no sender
Check(XMASPLAY.URLENC$("aZ9-_.~") = "aZ9-_.~", "plain characters stay")
Check(XMASPLAY.URLENC$("a b&c=d?#") = "a%20b%26c%3Dd%3F%23", "query characters are encoded")
Check(XMASPLAY.URLENC$("ü") = "%C3%BC", "an umlaut is two UTF-8 bytes")
Check(XMASPLAY.REPLYLINK$("https://x/", "Santa & Lina", "de") = "https://x/?lang=de&to=Santa%20%26%20Lina", "reply link with a sender")
Check(XMASPLAY.REPLYLINK$("https://x/", "", "en") = "https://x/?lang=en", "reply link without a sender")
Check(LEN(XMASPLAY.REPLYLINK$("https://x/", REPEAT$("ü", 200), "de")) <= 30 + XMASPLAY.MAX_NAME * 6, "a long sender is cut to a name")
Check(XMASPLAY.SAY$("de", "reply") = "Antworten" ANDALSO XMASPLAY.SAY$("en", "reply") = "Reply", "the reply button in both languages")

PRINT "RESULTS: "; passed; " passed, "; failed; " failed"
IF failed > 0 THEN END 1
