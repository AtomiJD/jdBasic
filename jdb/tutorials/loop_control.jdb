PRINT "--- TEST: Loop Continue Functionality ---"
DIM I, J

' ==========================================
' TEST 1: FOR Loop (CONTINUEFOR)
' Goal: Print 1, 2, 4, 5 (Skip 3)
' ==========================================
PRINT "1. Testing FOR Loop (Skip 3):"
FOR I = 1 TO 5
    IF I = 3 THEN 
        PRINT "   [Skipping 3]"
        CONTINUEFOR
    ENDIF
    PRINT "   Val: " + I
NEXT
PRINT "-------------------------------------"

' ==========================================
' TEST 2: DO WHILE Loop (CONTINUEDO)
' Goal: Print 1, 2, 4, 5 (Skip 3)
' Note: Increment must happen BEFORE continue to avoid infinite loop
' ==========================================
PRINT "2. Testing DO WHILE Loop (Skip 3):"
I = 0
DO WHILE I < 5
    I = I + 1
    IF I = 3 THEN 
        PRINT "   [Skipping 3]"
        CONTINUEDO
    ENDIF
    PRINT "   Val: " + I
LOOP
PRINT "-------------------------------------"

' ==========================================
' TEST 3: DO UNTIL Loop (CONTINUEDO)
' Goal: Print 1, 2, 4, 5 (Skip 3)
' ==========================================
PRINT "3. Testing DO UNTIL Loop (Skip 3):"
I = 0
DO UNTIL I >= 5
    I = I + 1
    IF I = 3 THEN 
        PRINT "   [Skipping 3]"
        CONTINUEDO
    ENDIF
    PRINT "   Val: " + I
LOOP
PRINT "-------------------------------------"

' ==========================================
' TEST 4: DO ... LOOP WHILE (Post-test)
' Goal: Print 1, 2, 4, 5 (Skip 3)
' ==========================================
PRINT "4. Testing DO...LOOP WHILE (Skip 3):"
I = 0
DO
    I = I + 1
    IF I = 3 THEN 
        PRINT "   [Skipping 3]"
        CONTINUEDO
    ENDIF
    PRINT "   Val: " + I
LOOP WHILE I < 5
PRINT "-------------------------------------"

' ==========================================
' TEST 5: DO ... LOOP UNTIL (Post-test)
' Goal: Print 1, 2, 4, 5 (Skip 3)
' ==========================================
PRINT "5. Testing DO...LOOP UNTIL (Skip 3):"
I = 0
DO
    I = I + 1
    IF I = 3 THEN 
        PRINT "   [Skipping 3]"
        CONTINUEDO
    ENDIF
    PRINT "   Val: " + I
LOOP UNTIL I >= 5
PRINT "-------------------------------------"

' ==========================================
' TEST 6: Infinite DO Loop with Exit
' Goal: Print 1, 2 (Skip 3), 4, then EXIT at 5
' ==========================================
PRINT "6. Testing Infinite DO (Skip 3, Exit 5):"
I = 0
DO
    I = I + 1
    IF I = 3 THEN 
        PRINT "   [Skipping 3]"
        CONTINUEDO
    ENDIF
    
    IF I = 5 THEN
        PRINT "   [Exiting at 5]"
        EXITDO
    ENDIF
    
    PRINT "   Val: " + I
LOOP
PRINT "-------------------------------------"

' ==========================================
' TEST 7: Nested Loops
' Goal: Outer loop 1-3, Inner loop 1-3. 
'       Inner loop skips printing if J=2.
' ==========================================
PRINT "7. Testing Nested FOR Loops:"
FOR I = 1 TO 3
    PRINT "Outer " + I + ":"
    FOR J = 1 TO 3
        IF J = 2 THEN 
            PRINT "Skipping 2"
            CONTINUEFOR            
        ENDIF
        PRINT "   Inner " + J
    NEXT
NEXT
PRINT "-------------------------------------"

' ==========================================
' TEST 8: Mixed Nested Loops (DO inside FOR)
' Goal: Skip even numbers in inner DO loop
' ==========================================
PRINT "8. Testing DO inside FOR:"
FOR I = 1 TO 2
    PRINT "Round " + I + ":"
    J = 0
    DO WHILE J < 4
        J = J + 1
        ' Skip even numbers
        IF J MOD 2 > 0 THEN CONTINUEDO 
        PRINT "   Odd Val: " + J
    LOOP
NEXT
PRINT "-------------------------------------"

PRINT "All tests completed."