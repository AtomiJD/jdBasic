' Train jdBasic - lesson 13: 13 | HTTP and JSON | Talk to the Web
' Chapter: HTTP.GET$ - raw response
' Source: jdb/tv/scripts/script_13_http_json.txt

DIM url$ = "https://api.open-meteo.com/v1/forecast?latitude=49.40&longitude=8.69&current_weather=true"
PRINT "Fetching..."
DIM body$ = HTTP.GET$(url$)
PRINT body$
