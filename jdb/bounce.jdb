' ===================================================================
' == Amiga "Boing Ball" Demo in jdBasic
' ===================================================================
'
' This program is a translation and modernization of the classic
' Amiga bouncing ball demo from 1984.
'
' --- jdBasic Features Showcased ---
' - SCREEN, CLS, SCREENFLIP for graphics and animation.
' - LINE and CIRCLE for procedural drawing.
' - SOUND.INIT, SOUND.VOICE, and SOUND.PLAY for procedural audio.
' - MOUSEB() and INKEY$() for user input.
'
' -------------------------------------------------------------------

' ===================================================================
' 1. INITIALIZATION AND SETUP
' ===================================================================

' --- Graphics and Screen Setup ---
SCREEN_W = 640
SCREEN_H = 400
SCREEN SCREEN_W, SCREEN_H, "jdBasic Boing Ball Demo"
OPTION "NOPAUSE" ' Prevent program from pausing on ESC

' --- Ball Physics Variables ---
BallX = 100
BallY = 100
BallRadius = 30
VelX = 150  ' Velocity in pixels per second
VelY = 100

' --- Animation and State Variables ---
IsRunning = TRUE
TimeStep = 0
LastTick = TICK()

' --- Sound Setup ---
SOUND.INIT
' Create a simple "thump" sound for wall collisions
SOUND.VOICE 0, "SINE", 0.01, 0.2, 0.1, 0.2
' Create a deeper "thump" for floor/ceiling collisions
SOUND.VOICE 1, "SINE", 0.01, 0.3, 0.1, 0.3

' ===================================================================
' 2. DRAWING SUBROUTINES
' ===================================================================

SUB DrawBackground()
    ' This subroutine replicates the grid background from the original demo.
    
    ' Draw vertical lines
    FOR x = 0 TO SCREEN_W STEP 16
        LINE x, 0, x, SCREEN_H, 100, 100, 120 ' Dark blue-gray
    NEXT x
    
    ' Draw horizontal lines
    FOR y = 0 TO SCREEN_H STEP 16
        LINE 0, y, SCREEN_W, y, 100, 100, 120
    NEXT y
ENDSUB

SUB DrawBall(x, y, radius, time)
    ' This subroutine draws a "rotating" 3D-like ball. The rotation is
    ' simulated by moving a highlight. This version avoids using arc
    ' parameters in the CIRCLE command to fix the "Wrong number of arguments" error.
    
    ' 1. Draw the main red body of the ball (assuming TRUE is for fill)
    CIRCLE x, y, radius, 255, 0, 0' , TRUE
    
    ' 2. Calculate the position for a moving highlight
    highlight_angle = time * 3 ' Control rotation speed
    highlight_dist = radius * 0.3
    highlightX = x + COS(highlight_angle) * highlight_dist
    highlightY = y - SIN(highlight_angle) * highlight_dist ' Use minus for a top-left lighting feel
    
    ' 3. Draw the white highlight
    highlight_radius = radius * 0.6
    CIRCLE highlightX, highlightY, highlight_radius, 255, 255, 255' , TRUE
    
    ' 4. Draw a black outline for the ball
    CIRCLE x, y, radius, 0, 0, 0' , FALSE
ENDSUB


' ===================================================================
' 3. MAIN ANIMATION LOOP
' ===================================================================

PRINT "Click mouse to pause/resume. Press Q to quit."

DO
    ' --- Delta Time Calculation for smooth, frame-rate independent movement ---
    CurrentTick = TICK()
    DeltaTime = (CurrentTick - LastTick) / 1000.0
    LastTick = CurrentTick

    ' --- Handle Input ---
    IF UCASE$(INKEY$()) = "Q" THEN EXITDO
    
    ' Check for a mouse click to toggle the animation
    IF MOUSEB(1) THEN
        IsRunning = NOT IsRunning
        ' Add a small delay to prevent rapid toggling from a single click
        SLEEP 200
    ENDIF

    ' --- Update Game Logic ---
    IF IsRunning THEN
        ' Update ball position based on velocity and delta time
        BallX = BallX + VelX * DeltaTime
        BallY = BallY + VelY * DeltaTime
        
        ' Update the "time" variable for the rotation animation
        TimeStep = TimeStep + DeltaTime

        ' --- Collision Detection and Response ---
        ' Bounce off left or right walls
        IF BallX < BallRadius OR BallX > SCREEN_W - BallRadius THEN
            VelX = -VelX
            SOUND.PLAY 0, 150 ' Play side collision sound
        ENDIF
        
        ' Bounce off top or bottom walls
        IF BallY < BallRadius OR BallY > SCREEN_H - BallRadius THEN
            VelY = -VelY
            SOUND.PLAY 1, 100 ' Play top/bottom collision sound
        ENDIF
    ENDIF

    ' --- Drawing Phase ---
    CLS 0, 0, 0 ' Clear the screen to black
    
    DrawBackground
    DrawBall BallX, BallY, BallRadius, TimeStep
    
    ' If paused, draw a message
    IF NOT IsRunning THEN
        TEXT 10, 10, "PAUSED", 255, 255, 0
    ENDIF
    
    SCREENFLIP ' Show the completed frame
    
    SLEEP 1 ' Yield CPU time to the OS
LOOP

' --- Shutdown ---
PRINT "Demo finished."
