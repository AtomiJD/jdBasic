DIM Position[1] AS LIVE INTEGER
DIM Description[1] AS LIVE STRING
DIM Quantity[1] AS LIVE INTEGER
DIM Price[1] AS LIVE DOUBLE
DIM Total[1] AS LIVE DOUBLE

DIM VAT As LIVE DOUBLE
DIM SumSubTotal As LIVE DOUBLE
DIM SumVAT As LIVE DOUBLE
DIM SumTotal As LIVE DOUBLE

VAT = 19.0

SALES_ARRAY = CSVREADER("order.csv", ";", TRUE)

Position = SLICE(SALES_ARRAY, 1, 0)
Description = SLICE(SALES_ARRAY, 1, 1)
Quantity = SLICE(SALES_ARRAY, 1, 2)
Price = SLICE(SALES_ARRAY, 1, 3)

Total -> Quantity * Price
SumSubTotal -> SUM(Total)
SumVAT -> SumSubTotal * VAT / 100
SumTotal -> SumSubTotal + SumVAT

CLS
PRINT "--- Simple reactive order sample ---"
PRINT 
PRINT "Customer ordered: "
Order = STACK(1, Position, Description, Quantity, Price, Total)
PRINT FRMV$(Order)
PRINT

PRINT "Regular order:"
PRINT "Subtotal: ", SumSubTotal
PRINT "VAT:      ", SumVAT
PRINT "Total:    ", SumTotal
PRINT 

PRINT "We need new prices up to 10 Percent!"
Price = Price * 1.1
PRINT "Subtotal: ", SumSubTotal
PRINT "VAT:      ", SumVAT
PRINT "Total:    ", SumTotal
PRINT 

PRINT "Administration reduced VAT to 7.0 %"
VAT = 7.0
PRINT "Subtotal: ", SumSubTotal
PRINT "VAT:      ", SumVAT
PRINT "Total:    ", SumTotal
PRINT 
