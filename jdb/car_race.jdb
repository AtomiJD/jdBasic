B=RESHAPE([" "*40],[19]): P=20: S=0: CLS: CURSOR FALSE : 
DO: B=SHIFT(B,[1],LEFT$(" "*FLOOR(RND(0)*40)+"*"+" "*40,40)): 
K$=INKEY$() : P=CLAMP(P-(K$="1")+(K$="9"),0,39): 
C$=MID$(B[18],P,1) : B[18]=LEFT$(B[18],P)+"V"+RIGHT$(B[18],39-P): 
LOCATE 1,1: PRINT FRMV$(B+VBNEWLINE) : 
IF C$="*" OR S=420 THEN PRINT IIF(S=420,"WIN!","DIED"): END ELSE S=S+1: SLEEP 50: LOOP