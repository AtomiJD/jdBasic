' jdBasic MCP server — Streamable-HTTP transport.
'
' Spec: https://modelcontextprotocol.io
' Transport: HTTP, JSON-RPC 2.0 over POST /mcp.
' Bound to 127.0.0.1 only (localhost). Run as:
'   build/jdBasic.exe mcp/server.jdb
'
' Implements the three required JSON-RPC methods:
'   - initialize       : handshake, returns server capabilities,
'                        issues a fresh Mcp-Session-Id response header
'   - tools/list       : enumerates available tools
'   - tools/call       : invokes a tool by name with JSON args
'
' Session model (MCP "Streamable HTTP"):
'   - Server issues an Mcp-Session-Id on initialize.
'   - Clients echo it back as a request header on every later call.
'   - Unknown session id ⇒ HTTP 404 (forces the client to re-initialize).
'   - Notifications (method = "notifications/*") ⇒ HTTP 202 with no body.

OPTION "EXPLICIT"

CONST MCP_PORT = 7321
CONST MCP_VERSION$ = "2024-11-05"
CONST SERVER_NAME$ = "jdbasic-mcp"
CONST SERVER_VERSION$ = "0.1.0"

' session_id$ → TRUE. Populated on initialize, consulted on every other request.
DIM SESSIONS AS MAP = {}

' label$ → MAP of name$ → value. Populated by jdb_save_state, drained by
' jdb_restore_state. Lives for the server process's lifetime.
DIM SNAPSHOTS AS MAP = {}

' ── Tool descriptors (declared once, served by tools/list) ─────
' Each entry: {"name", "description", "inputSchema"}.
' inputSchema follows JSON Schema (draft-07) — clients use it to validate
' arguments before calling.

FUNC BUILD_TOOLS()
    DIM tools = []

    ' jdb_eval — execute jdBasic code on the persistent VM, capture
    ' everything the snippet PRINTs, return it as text.
    DIM eval_tool AS MAP = {                                           _
        "name": "jdb_eval",                                            _
        "description": "Execute jdBasic statements on the persistent VM and return any captured stdout. Variables defined here persist between calls.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "code": {                                              _
                    "type": "string",                                  _
                    "description": "jdBasic source to EXECUTE. Use PRINT to surface values." _
                }                                                      _
            },                                                         _
            "required": ["code"]                                       _
        }                                                              _
    }
    PUSH tools, eval_tool

    ' jdb_vars — list all global variables on the persistent VM.
    DIM vars_tool AS MAP = {                                           _
        "name": "jdb_vars",                                            _
        "description": "List all global variables currently defined on the persistent VM, including server internals (prefixed __ are hidden).", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {}                                           _
        }                                                              _
    }
    PUSH tools, vars_tool

    ' jdb_load — read a project file and EXECUTE it on the persistent VM.
    DIM load_tool AS MAP = {                                           _
        "name": "jdb_load",                                            _
        "description": "Read a jdBasic source file (path is relative to the server's working directory, usually the project root) and EXECUTE its contents on the persistent VM. Avoids round-tripping the file's bytes through tool arguments. Returns captured stdout, or isError on read/parse/runtime failure.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "path": {                                              _
                    "type": "string",                                  _
                    "description": "Relative path to a .jdb file (e.g. tests/test_output_capture.jdb)." _
                }                                                      _
            },                                                         _
            "required": ["path"]                                       _
        }                                                              _
    }
    PUSH tools, load_tool

    ' jdb_save_state — snapshot current user-var values under a label.
    DIM save_tool AS MAP = {                                           _
        "name": "jdb_save_state",                                      _
        "description": "Snapshot the current values of every user-defined global (filters server internals the same way jdb_vars does) under a string label. Multiple snapshots can coexist. Use jdb_restore_state to roll back.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "label": {                                             _
                    "type": "string",                                  _
                    "description": "Snapshot identifier — pick anything memorable." _
                }                                                      _
            },                                                         _
            "required": ["label"]                                      _
        }                                                              _
    }
    PUSH tools, save_tool

    ' jdb_restore_state — restore a previously saved snapshot.
    DIM restore_tool AS MAP = {                                        _
        "name": "jdb_restore_state",                                   _
        "description": "Restore a previously saved snapshot. Re-assigns each variable that was captured under the label. Variables added after the save are left in place — this is restore-by-overwrite, not a hard rollback.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "label": {                                             _
                    "type": "string",                                  _
                    "description": "Label passed to a previous jdb_save_state." _
                }                                                      _
            },                                                         _
            "required": ["label"]                                      _
        }                                                              _
    }
    PUSH tools, restore_tool

    ' jdb_run_native — run a compiled .exe or jdBasic file in a child process.
    DIM run_native_tool AS MAP = {                                     _
        "name": "jdb_run_native",                                      _
        "description": "Run a command line in a child process and capture combined stdout+stderr plus the exit code. Useful for testing native-compiled .exes (e.g. tests/comprehensive_test.exe) or one-off interpreter runs without going through the persistent VM. Path and any args are concatenated into a single shell command — quote arguments with spaces yourself. v1 has no timeout; long-running processes block.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "command": {                                           _
                    "type": "string",                                  _
                    "description": "The command to run, e.g. 'tests/comprehensive_test.exe' or 'build/jdBasic.exe tests/foo.jdb'." _
                }                                                      _
            },                                                         _
            "required": ["command"]                                    _
        }                                                              _
    }
    PUSH tools, run_native_tool

    ' jdb_doc — fuzzy-search doc/languages.md by symbol or topic.
    DIM doc_tool AS MAP = {                                            _
        "name": "jdb_doc",                                             _
        "description": "Look up jdBasic syntax / built-in functions in doc/languages.md. Returns the bullet entry or section that contains the query string (case-insensitive). Matches against symbol bullets like '* **MAP.EXISTS(...)**' and against ## / ### / #### section headings. Up to 8 hits are concatenated. Faster and more focused than grepping the whole file.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "query": {                                             _
                    "type": "string",                                  _
                    "description": "Symbol name (e.g. MAP.EXISTS, CODEC.UUID$) or topic substring (e.g. random, json)." _
                }                                                      _
            },                                                         _
            "required": ["query"]                                      _
        }                                                              _
    }
    PUSH tools, doc_tool

    ' jdb_funcs — list user-defined FUNCs/SUBs (filters server internals).
    DIM funcs_tool AS MAP = {                                          _
        "name": "jdb_funcs",                                           _
        "description": "List user-defined FUNC / SUB / ASYNC FUNC currently registered on the persistent VM, with their parameter signatures. Server-internal helpers (BUILD_TOOLS, MAKE_TEXT_RESULT, etc.) are filtered out — you only see what your own snippets defined.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {}                                           _
        }                                                              _
    }
    PUSH tools, funcs_tool

    ' jdb_check — Lex + Parse only. No execution, no VM mutation.
    DIM check_tool AS MAP = {                                          _
        "name": "jdb_check",                                           _
        "description": "Validate jdBasic source by running Lex + Parse only. Returns 'ok' if the snippet is syntactically valid, or the parse-error message otherwise. Does NOT execute the code or touch the persistent VM — safe to call before jdb_eval to avoid contaminating state with half-executed snippets.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "code": {                                              _
                    "type": "string",                                  _
                    "description": "jdBasic source to validate."       _
                }                                                      _
            },                                                         _
            "required": ["code"]                                       _
        }                                                              _
    }
    PUSH tools, check_tool

    ' echo — kept as a connectivity smoke test.
    DIM echo_tool AS MAP = {                                           _
        "name": "echo",                                                _
        "description": "Echo back the message you sent. Connectivity smoke test.", _
        "inputSchema": {                                               _
            "type": "object",                                          _
            "properties": {                                            _
                "message": {                                           _
                    "type": "string",                                  _
                    "description": "Text to echo back"                 _
                }                                                      _
            },                                                         _
            "required": ["message"]                                    _
        }                                                              _
    }
    PUSH tools, echo_tool

    RETURN tools
ENDFUNC

DIM TOOLS = BUILD_TOOLS()

' ── Tool dispatch ──────────────────────────────────────────────
' Returns the JSON-RPC `result` payload for a tools/call response.
' MCP convention: result has `content` (array of {type, text/...}) and
' optionally `isError: true`.

FUNC DISPATCH_TOOL(tool_name$, args)
    SWITCH tool_name$
        CASE "jdb_eval"
            RETURN TOOL_JDB_EVAL(args)
        CASE "jdb_vars"
            RETURN TOOL_JDB_VARS(args)
        CASE "jdb_load"
            RETURN TOOL_JDB_LOAD(args)
        CASE "jdb_funcs"
            RETURN TOOL_JDB_FUNCS(args)
        CASE "jdb_check"
            RETURN TOOL_JDB_CHECK(args)
        CASE "jdb_doc"
            RETURN TOOL_JDB_DOC(args)
        CASE "jdb_save_state"
            RETURN TOOL_JDB_SAVE_STATE(args)
        CASE "jdb_restore_state"
            RETURN TOOL_JDB_RESTORE_STATE(args)
        CASE "jdb_run_native"
            RETURN TOOL_JDB_RUN_NATIVE(args)
        CASE "echo"
            RETURN TOOL_ECHO(args)
        DEFAULT
            RETURN MAKE_TEXT_RESULT("Unknown tool: " + tool_name$, TRUE)
    ENDSWITCH
ENDFUNC

' ── Tool implementations ──────────────────────────────────────
' All return a {content: [{type:"text", text}], isError?: bool} map.

FUNC MAKE_TEXT_RESULT(text$, is_error)
    DIM content = []
    DIM block AS MAP = {"type": "text", "text": text$}
    PUSH content, block
    DIM r AS MAP = {"content": content}
    IF is_error THEN r{"isError"} = TRUE
    RETURN r
ENDFUNC

FUNC TOOL_ECHO(args)
    RETURN MAKE_TEXT_RESULT("Echo: " + args{"message"}, FALSE)
ENDFUNC

' jdb_eval — captures everything the snippet PRINTs and returns it.
' Errors come back as a structured MCP isError block (text content =
' whatever was printed before the throw, followed by the error message).
FUNC TOOL_JDB_EVAL(args)
    DIM code$ AS STRING = args{"code"}
    OUTPUT.CAPTURE_BEGIN
    TRY
        EXECUTE code$
        DIM out$ AS STRING = OUTPUT.CAPTURE_END$
        RETURN MAKE_TEXT_RESULT(out$, FALSE)
    CATCH
        DIM partial$ AS STRING = OUTPUT.CAPTURE_END$
        DIM err$ AS STRING = "Error: " + ERRMSG$
        IF partial$ <> "" THEN err$ = partial$ + err$
        RETURN MAKE_TEXT_RESULT(err$, TRUE)
    ENDTRY
ENDFUNC

' jdb_load — read a project file from disk and EXECUTE it. Errors from
' reading, parsing, or runtime all surface as isError MCP results.
FUNC TOOL_JDB_LOAD(args)
    DIM path$ AS STRING = args{"path"}
    DIM code$ AS STRING = ""
    TRY
        code$ = TXTREADER$(path$)
    CATCH
        RETURN MAKE_TEXT_RESULT("Cannot read " + path$ + ": " + ERRMSG$, TRUE)
    ENDTRY

    OUTPUT.CAPTURE_BEGIN
    TRY
        EXECUTE code$
        DIM out$ AS STRING = OUTPUT.CAPTURE_END$
        DIM banner$ AS STRING = "[loaded " + path$ + ", " + STR$(LEN(code$)) + " bytes]"
        DIM result$ AS STRING = banner$
        IF out$ <> "" THEN result$ = banner$ + CHR$(10) + out$
        RETURN MAKE_TEXT_RESULT(result$, FALSE)
    CATCH
        DIM partial$ AS STRING = OUTPUT.CAPTURE_END$
        DIM err$ AS STRING = "Error in " + path$ + ": " + ERRMSG$
        IF partial$ <> "" THEN err$ = partial$ + err$
        RETURN MAKE_TEXT_RESULT(err$, TRUE)
    ENDTRY
ENDFUNC

' Parse FUNCS() output — "  NAME(params)  KIND" lines → array of NAMES.
FUNC EXTRACT_FUNC_NAMES(captured$)
    DIM names = []
    DIM lines = SPLIT(captured$, CHR$(10))
    FOR i = 0 TO LEN(lines) - 1
        DIM line$ AS STRING = lines[i]
        IF LEFT$(line$, 2) <> "  " THEN CONTINUEFOR
        DIM rest$ AS STRING = MID$(line$, 2)
        DIM lp AS INTEGER = INSTR(rest$, "(")
        IF lp < 0 THEN CONTINUEFOR
        PUSH names, LEFT$(rest$, lp)
    NEXT
    RETURN names
ENDFUNC

' jdb_funcs — runs FUNCS() and filters out server-internal functions.
FUNC TOOL_JDB_FUNCS(args)
    OUTPUT.CAPTURE_BEGIN
    FUNCS()
    DIM raw$ AS STRING = OUTPUT.CAPTURE_END$
    DIM lines = SPLIT(raw$, CHR$(10))
    DIM kept = []
    FOR i = 0 TO LEN(lines) - 1
        DIM line$ AS STRING = lines[i]
        IF LEFT$(line$, 2) <> "  " THEN CONTINUEFOR
        DIM rest$ AS STRING = MID$(line$, 2)
        DIM lp AS INTEGER = INSTR(rest$, "(")
        IF lp < 0 THEN CONTINUEFOR
        DIM nm$ AS STRING = LEFT$(rest$, lp)
        IF MAP.EXISTS(__SYSTEM_FUNCS, nm$) THEN CONTINUEFOR
        IF LEFT$(nm$, 2) = "__" THEN CONTINUEFOR
        PUSH kept, line$
    NEXT
    DIM out$ AS STRING = ""
    IF LEN(kept) = 0 THEN
        out$ = "(no user functions)"
    ELSE
        out$ = JOIN(kept, CHR$(10))
    ENDIF
    RETURN MAKE_TEXT_RESULT(out$, FALSE)
ENDFUNC

' Snapshot every user variable (those NOT in __SYSTEM_VARS, not __ prefixed,
' not dotted symbol-table noise) into a {name → JSON-serialised value} map.
'
' Maps and arrays in jdBasic are reference types — JDB.GLOBAL_GET on them
' returns the same underlying object, so a later in-place mutation
' (m{"k"} = v, PUSH arr x) would corrupt the snapshot. JSON.STRINGIFY
' produces a deep-copy as a string; JSON.PARSE rebuilds a fresh tree on
' restore. Limitation: values that don't round-trip through JSON
' (functions, COM handles, NONE) are dropped.
FUNC CAPTURE_USER_VARS()
    OUTPUT.CAPTURE_BEGIN
    VARS()
    DIM raw$ AS STRING = OUTPUT.CAPTURE_END$
    DIM names = EXTRACT_VAR_NAMES(raw$)
    DIM snap AS MAP = {}
    FOR i = 0 TO LEN(names) - 1
        DIM nm$ AS STRING = names[i]
        IF MAP.EXISTS(__SYSTEM_VARS, nm$) THEN CONTINUEFOR
        IF LEFT$(nm$, 2) = "__" THEN CONTINUEFOR
        IF INSTR(nm$, ".") >= 0 THEN CONTINUEFOR
        TRY
            DIM v = JDB.GLOBAL_GET(nm$)
            snap{nm$} = JSON.STRINGIFY$(v)
        CATCH
            ' Skip values that can't round-trip through JSON.
        ENDTRY
    NEXT
    RETURN snap
ENDFUNC

FUNC TOOL_JDB_SAVE_STATE(args)
    DIM label$ AS STRING = args{"label"}
    IF label$ = "" THEN
        RETURN MAKE_TEXT_RESULT("label is empty", TRUE)
    ENDIF
    DIM snap = CAPTURE_USER_VARS()
    SNAPSHOTS{label$} = snap
    DIM count AS INTEGER = LEN(MAP.KEYS(snap))
    RETURN MAKE_TEXT_RESULT("saved '" + label$ + "' (" + STR$(count) + " vars)", FALSE)
ENDFUNC

FUNC TOOL_JDB_RESTORE_STATE(args)
    DIM label$ AS STRING = args{"label"}
    IF NOT MAP.EXISTS(SNAPSHOTS, label$) THEN
        RETURN MAKE_TEXT_RESULT("no snapshot named '" + label$ + "'", TRUE)
    ENDIF
    DIM snap = SNAPSHOTS{label$}
    DIM keys = MAP.KEYS(snap)
    FOR i = 0 TO LEN(keys) - 1
        DIM k$ AS STRING = keys[i]
        DIM json$ AS STRING = snap{k$}
        DIM v = JSON.PARSE$(json$)
        JDB.GLOBAL_SET(k$, v)
    NEXT
    RETURN MAKE_TEXT_RESULT("restored '" + label$ + "' (" + STR$(LEN(keys)) + " vars)", FALSE)
ENDFUNC

' jdb_run_native — thin wrapper around OS.EXEC. Returns stdout+stderr,
' exit code, and the rough wall time so the caller can correlate.
FUNC TOOL_JDB_RUN_NATIVE(args)
    DIM cmd$ AS STRING = args{"command"}
    IF cmd$ = "" THEN
        RETURN MAKE_TEXT_RESULT("command is empty", TRUE)
    ENDIF
    ' OS.EXEC wraps the command in `cmd /c` on Windows, which mis-parses
    ' forward slashes as switch markers. Translate to backslashes so the
    ' caller can pass POSIX-looking paths like "tests/foo.exe".
    IF OS.GETOS$() = "WINDOWS" THEN cmd$ = REPLACE$(cmd$, "/", CHR$(92))
    DIM t0 AS INTEGER = TICK()
    DIM r = OS.EXEC(cmd$)
    DIM elapsed_ms AS INTEGER = TICK() - t0
    DIM exit_code AS INTEGER = r{"EXIT_CODE"}
    DIM out$ AS STRING = r{"OUTPUT"}
    DIM banner$ AS STRING = "[exit=" + STR$(exit_code) + " " + STR$(elapsed_ms) + "ms] " + cmd$
    DIM body$ AS STRING = banner$
    IF out$ <> "" THEN body$ = banner$ + CHR$(10) + out$
    DIM is_err = (exit_code <> 0)
    RETURN MAKE_TEXT_RESULT(body$, is_err)
ENDFUNC

' Anchor test — TRUE if `line$` starts a doc entry we want to match against
' (a bullet-style symbol entry or a markdown heading).
FUNC IS_DOC_ANCHOR(line$)
    IF LEFT$(line$, 4) = "* **" THEN RETURN TRUE
    IF LEFT$(line$, 1) = "#" THEN RETURN TRUE
    RETURN FALSE
ENDFUNC

' jdb_doc — search doc/languages.md for the query (case-insensitive) on
' bullet-symbol or heading lines. Returns up to 8 entries, each entry
' being the matching anchor line plus its following body lines until the
' next anchor.
FUNC TOOL_JDB_DOC(args)
    DIM query$ AS STRING = args{"query"}
    IF query$ = "" THEN
        RETURN MAKE_TEXT_RESULT("query is empty", TRUE)
    ENDIF

    DIM doc$ AS STRING = ""
    TRY
        doc$ = TXTREADER$("doc/languages.md")
    CATCH
        RETURN MAKE_TEXT_RESULT("Cannot read doc/languages.md: " + ERRMSG$, TRUE)
    ENDTRY

    DIM q_up$ AS STRING = UCASE$(query$)
    DIM lines = SPLIT(doc$, CHR$(10))
    DIM n AS INTEGER = LEN(lines)
    DIM hits = []
    DIM max_hits AS INTEGER = 8
    DIM max_body AS INTEGER = 30

    DIM i AS INTEGER = 0
    DO WHILE i < n
        DIM line$ AS STRING = lines[i]
        IF NOT IS_DOC_ANCHOR(line$) THEN
            i = i + 1
            CONTINUEDO
        ENDIF
        IF INSTR(UCASE$(line$), q_up$) < 0 THEN
            i = i + 1
            CONTINUEDO
        ENDIF
        DIM entry$ AS STRING = line$
        DIM body AS INTEGER = 1
        DIM j AS INTEGER = i + 1
        DO WHILE j < n ANDALSO body < max_body
            DIM nxt$ AS STRING = lines[j]
            IF IS_DOC_ANCHOR(nxt$) THEN EXITDO
            entry$ = entry$ + CHR$(10) + nxt$
            body = body + 1
            j = j + 1
        LOOP
        PUSH hits, entry$
        IF LEN(hits) >= max_hits THEN EXITDO
        i = j
    LOOP

    IF LEN(hits) = 0 THEN
        RETURN MAKE_TEXT_RESULT("(no matches for: " + query$ + ")", TRUE)
    ENDIF

    DIM sep$ AS STRING = CHR$(10) + CHR$(10) + "---" + CHR$(10) + CHR$(10)
    DIM result$ AS STRING = JOIN(hits, sep$)
    RETURN MAKE_TEXT_RESULT(result$, FALSE)
ENDFUNC

' jdb_check — Lex + Parse only. Returns "ok" or the parse error.
' isError flips on any error so MCP clients can branch.
FUNC TOOL_JDB_CHECK(args)
    DIM code$ AS STRING = args{"code"}
    DIM err$ AS STRING = JDB.CHECK$(code$)
    IF err$ = "" THEN
        RETURN MAKE_TEXT_RESULT("ok", FALSE)
    ELSE
        RETURN MAKE_TEXT_RESULT(err$, TRUE)
    ENDIF
ENDFUNC

' Parse VARS() output ("  NAME = VALUE" lines) → array of NAMES.
FUNC EXTRACT_VAR_NAMES(captured$)
    DIM names = []
    DIM lines = SPLIT(captured$, CHR$(10))
    FOR i = 0 TO LEN(lines) - 1
        DIM line$ AS STRING = lines[i]
        IF LEFT$(line$, 2) = "  " THEN
            DIM rest$ AS STRING = MID$(line$, 2)
            DIM eq AS INTEGER = INSTR(rest$, " = ")
            IF eq >= 0 THEN
                PUSH names, LEFT$(rest$, eq)
            ENDIF
        ENDIF
    NEXT
    RETURN names
ENDFUNC

' jdb_vars — runs VARS() and filters out server-internal globals (anything
' that already existed at boot, plus any name with a leading "__"). Returns
' just the user's own variables.
FUNC TOOL_JDB_VARS(args)
    OUTPUT.CAPTURE_BEGIN
    VARS()
    DIM raw$ AS STRING = OUTPUT.CAPTURE_END$
    DIM lines = SPLIT(raw$, CHR$(10))
    DIM kept = []
    FOR i = 0 TO LEN(lines) - 1
        DIM line$ AS STRING = lines[i]
        IF LEFT$(line$, 2) <> "  " THEN
            CONTINUEFOR
        ENDIF
        DIM rest$ AS STRING = MID$(line$, 2)
        DIM eq AS INTEGER = INSTR(rest$, " = ")
        IF eq < 0 THEN CONTINUEFOR
        DIM nm$ AS STRING = LEFT$(rest$, eq)
        IF MAP.EXISTS(__SYSTEM_VARS, nm$) THEN CONTINUEFOR
        IF LEFT$(nm$, 2) = "__" THEN CONTINUEFOR
        ' Names with "." (e.g. REQ.BODY, OUTPUT.CAPTURE_END$) are symbol-table
        ' artefacts created by handler invocations / native-call captures —
        ' the user can't create a dotted top-level global, so anything dotted
        ' is engine noise.
        IF INSTR(nm$, ".") >= 0 THEN CONTINUEFOR
        PUSH kept, line$
    NEXT
    DIM out$ AS STRING = ""
    IF LEN(kept) = 0 THEN
        out$ = "(no user variables)"
    ELSE
        out$ = JOIN(kept, CHR$(10))
    ENDIF
    RETURN MAKE_TEXT_RESULT(out$, FALSE)
ENDFUNC

' ── JSON-RPC dispatcher ────────────────────────────────────────
FUNC HANDLE_RPC(rpc)
    DIM resp AS MAP = {"jsonrpc": "2.0"}
    ' MCP id can be any JSON value (or absent for notifications).
    IF MAP.EXISTS(rpc, "id") THEN resp{"id"} = rpc{"id"}

    DIM method$ AS STRING = rpc{"method"}

    SWITCH method$
        CASE "initialize"
            DIM init_result AS MAP = {                                  _
                "protocolVersion": MCP_VERSION$,                        _
                "capabilities": {"tools": {}},                          _
                "serverInfo": {                                         _
                    "name": SERVER_NAME$,                               _
                    "version": SERVER_VERSION$                          _
                }                                                       _
            }
            resp{"result"} = init_result
        CASE "tools/list"
            resp{"result"} = {"tools": TOOLS}
        CASE "tools/call"
            DIM params = rpc{"params"}
            DIM tool_name$ AS STRING = params{"name"}
            DIM tool_args = params{"arguments"}
            resp{"result"} = DISPATCH_TOOL(tool_name$, tool_args)
        DEFAULT
            DIM err AS MAP = {                                          _
                "code": -32601,                                         _
                "message": "Method not found: " + method$               _
            }
            resp{"error"} = err
    ENDSWITCH

    RETURN resp
ENDFUNC

' ── Rich-response helpers ──────────────────────────────────────
' The HTTP layer recognises maps that carry __http_status / __http_body /
' __http_headers / __http_content_type and uses them to control the raw
' HTTP response (status code, headers, body bytes). Without those keys it
' falls back to auto-JSON-encoding the returned map at HTTP 200.

FUNC RICH_JSON(status, payload, headers AS MAP)
    DIM body$ AS STRING = JSON.STRINGIFY$(payload)
    DIM r AS MAP = {                                                    _
        "__http_status": status,                                        _
        "__http_body": body$,                                           _
        "__http_content_type": "application/json",                      _
        "__http_headers": headers                                       _
    }
    RETURN r
ENDFUNC

FUNC RICH_EMPTY(status, headers AS MAP)
    DIM r AS MAP = {                                                    _
        "__http_status": status,                                        _
        "__http_headers": headers                                       _
    }
    RETURN r
ENDFUNC

' ── HTTP entrypoint ────────────────────────────────────────────
' The HTTP server passes the request as a map with PATH/METHOD/BODY/
' HEADERS/PARAMS keys. We parse the body as JSON-RPC, hand it to
' HANDLE_RPC, and wrap the result with proper HTTP status / session
' headers.

' HEADERS keys are normalised to lowercase by the HTTP layer (HTTP header
' names are case-insensitive per RFC 7230) — pass the lowercase form here.
FUNC GET_HEADER$(req, name$)
    IF MAP.EXISTS(req{"HEADERS"}, name$) THEN RETURN req{"HEADERS"}{name$}
    RETURN ""
ENDFUNC

FUNC MCP_POST(req)
    DIM body_preview$ AS STRING = LEFT$(req.BODY, 160)
    PRINT "[MCP] POST /mcp body=" + body_preview$

    DIM rpc = JSON.PARSE$(req.BODY)
    DIM method$ AS STRING = ""
    IF MAP.EXISTS(rpc, "method") THEN method$ = rpc{"method"}

    ' --- Notifications: per JSON-RPC, no response. MCP says HTTP 202, no body.
    IF STARTSWITH(method$, "notifications/") THEN
        PRINT "[MCP]   notification " + method$ + " -> 202"
        RETURN RICH_EMPTY(202, {})
    ENDIF

    DIM client_sid$ AS STRING = GET_HEADER$(req, "mcp-session-id")

    ' --- initialize: issue a fresh session id, attach as response header
    IF method$ = "initialize" THEN
        DIM new_sid$ AS STRING = CODEC.UUID$()
        SESSIONS{new_sid$} = TRUE
        PRINT "[MCP]   initialize -> sid=" + new_sid$
        DIM init_resp = HANDLE_RPC(rpc)
        DIM hdrs AS MAP = {"Mcp-Session-Id": new_sid$}
        RETURN RICH_JSON(200, init_resp, hdrs)
    ENDIF

    ' --- All other methods require a known session.
    IF client_sid$ = "" OR NOT MAP.EXISTS(SESSIONS, client_sid$) THEN
        PRINT "[MCP]   unknown session sid='" + client_sid$ + "' for " + method$ + " -> 404"
        RETURN RICH_EMPTY(404, {})
    ENDIF

    PRINT "[MCP]   " + method$ + " (sid=" + client_sid$ + ")"
    DIM resp = HANDLE_RPC(rpc)
    RETURN RICH_JSON(200, resp, {})
ENDFUNC

' ── Boot ───────────────────────────────────────────────────────
' Snapshot the names of every global VARS() can see right now — they
' belong to the server, not the user. jdb_vars filters them out so
' Atomi only sees the variables his own snippets defined.
OUTPUT.CAPTURE_BEGIN
VARS()
DIM __BOOT_VARS$ AS STRING = OUTPUT.CAPTURE_END$
DIM __SYSTEM_VARS AS MAP = {}
DIM __snap = EXTRACT_VAR_NAMES(__BOOT_VARS$)
FOR i = 0 TO LEN(__snap) - 1
    __SYSTEM_VARS{__snap[i]} = TRUE
NEXT

' Same idea for FUNCs/SUBs — the helpers in this file (MCP_POST,
' BUILD_TOOLS, MAKE_TEXT_RESULT, …) shouldn't pollute jdb_funcs.
OUTPUT.CAPTURE_BEGIN
FUNCS()
DIM __BOOT_FUNCS$ AS STRING = OUTPUT.CAPTURE_END$
DIM __SYSTEM_FUNCS AS MAP = {}
DIM __fsnap = EXTRACT_FUNC_NAMES(__BOOT_FUNCS$)
FOR i = 0 TO LEN(__fsnap) - 1
    __SYSTEM_FUNCS{__fsnap[i]} = TRUE
NEXT

PRINT "── jdBasic MCP server ──"
PRINT "binding 127.0.0.1:"; MCP_PORT
PRINT "system vars filtered:  "; LEN(__snap)
PRINT "system funcs filtered: "; LEN(__fsnap)
HTTP.SERVER.ON_POST "/mcp", "MCP_POST"
IF HTTP.SERVER.START(MCP_PORT, "127.0.0.1") THEN
    PRINT "ready. POST JSON-RPC to http://127.0.0.1:" + STR$(MCP_PORT) + "/mcp"
    PRINT "Ctrl+C (or HTTP.SERVER.STOP from another VM) to stop."
    DO
        SLEEP 1000
    LOOP
ELSE
    PRINT "FAILED to start server"
ENDIF
