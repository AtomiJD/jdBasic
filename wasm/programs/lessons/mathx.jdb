' Train jdBasic - lesson 10: 10 | Modules | Code Worth Reusing
' Chapter: Writing a module
' Source: jdb/tv/scripts/script_10_modules.txt

EXPORT MODULE MATHX

EXPORT FUNC CLAMP(x, lo, hi)
    IF x < lo THEN RETURN lo
    IF x > hi THEN RETURN hi
    RETURN x
ENDFUNC

EXPORT FUNC PERCENT(part, whole)
    RETURN (part / whole) * 100
ENDFUNC
