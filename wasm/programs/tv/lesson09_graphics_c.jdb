' Train jdBasic - lesson 09: 09 | Graphics | Pixels on Screen
' Chapter: Drawing in a loop
' Source: jdb/tv/scripts/script_09_graphics.txt

SCREEN 600, 400, "Loop"
DRAWCOLOR 0, 0, 0
RECT 0, 0, 600, 400, TRUE
FOR i = 0 TO 9
    DRAWCOLOR 255 - i * 25, 100, i * 25
    CIRCLE 60 + i * 55, 200, 25, TRUE
NEXT i
SCREENFLIP
DIM ev
FOR f = 0 TO 220
    ev = GFX.POLLEVENT()
    SLEEP 16
NEXT f
GFX.CLOSE
