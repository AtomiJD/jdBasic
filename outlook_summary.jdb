' outlook_summary.jdb — Backend für das Outlook-Conversation-Summary-Tool.
'
' Wird aufgerufen aus dem VBA-Macro "outlook_summary.bas" via:
'   jdBasic.exe outlook_summary.jdb <input.json> <output.txt>
'
' Input-JSON (wie das VBA-Macro es schreibt):
' {
'   "subject":  "RE: Projektplan Q3",
'   "thread":   "<conversation-id>",
'   "messages": [
'     { "from": "...", "date": "2026-04-01 10:23", "to": "...",
'       "cc": "...", "body": "..." },
'     ...
'   ]
' }
'
' Output: Plain-Text Zusammenfassung in <output.txt> für VBA zum Anzeigen.

OPTION "EXPLICIT"

' ── Argument-Check ───────────────────────────────────────────────
' args[0] ist immer der Script-Pfad selbst, args[1..] die User-Args.
DIM args AS ARRAY = OS.ARGS()
IF LEN(args) < 3 THEN
    PRINT "Usage: jdbasic outlook_summary.jdb <input.json> <output.txt>"
    END
ENDIF

DIM in_path  AS STRING = args[1]
DIM out_path AS STRING = args[2]

IF NOT FILE.EXISTS(in_path) THEN
    PRINT "Input not found: "; in_path
    END
ENDIF

' ── API-Key holen ────────────────────────────────────────────────
DIM api_key AS STRING = GETENV$("ANTHROPIC_API_KEY")
IF LEN(api_key) = 0 THEN
    DIM err1$ = "ANTHROPIC_API_KEY environment variable is not set." + CHR$(10) + _
                "Set it via:" + CHR$(10) + _
                "  setx ANTHROPIC_API_KEY ""sk-ant-...""" + CHR$(10) + _
                "(then restart Outlook so it picks up the new env)."
    TXTWRITER out_path, err1$
    PRINT err1$
    END
ENDIF

' ── Conversation-Daten einlesen ──────────────────────────────────
DIM raw AS STRING = TXTREADER$(in_path)
DIM thread = JSON.PARSE$(raw)

DIM subject  AS STRING = thread{"subject"}
DIM messages = thread{"messages"}
DIM n AS INTEGER = LEN(messages)

IF n = 0 THEN
    DIM err2$ = "Conversation contains no messages."
    TXTWRITER out_path, err2$
    PRINT err2$
    END
ENDIF

PRINT "Summarising "; n; " messages on subject: "; subject

' ── Prompt zusammenbauen ─────────────────────────────────────────
DIM prompt AS STRING
prompt = "Du bekommst eine E-Mail-Konversation aus Outlook." + CHR$(10) + _
         "Fasse sie kurz und prägnant auf Deutsch zusammen. Gliedere in:" + CHR$(10) + _
         "  - Thema in einem Satz" + CHR$(10) + _
         "  - Beteiligte (mit Rolle, falls erkennbar)" + CHR$(10) + _
         "  - Verlauf chronologisch (1-2 Bullets pro Mail)" + CHR$(10) + _
         "  - Offene Punkte / Action Items / Entscheidungen" + CHR$(10) + _
         "Halte dich an die Fakten — keine Spekulation." + CHR$(10) + CHR$(10) + _
         "Subject: " + subject + CHR$(10) + _
         "----------------------------------------" + CHR$(10)

DIM i AS INTEGER
FOR i = 0 TO n - 1
    DIM msg = messages[i]
    prompt = prompt + CHR$(10) + _
             "[" + STR$(i + 1) + "/" + STR$(n) + "] " + _
             msg{"date"} + " — Von: " + msg{"from"} + CHR$(10) + _
             "An: " + msg{"to"} + CHR$(10)
    IF LEN(msg{"cc"}) > 0 THEN
        prompt = prompt + "Cc: " + msg{"cc"} + CHR$(10)
    ENDIF
    prompt = prompt + CHR$(10) + msg{"body"} + CHR$(10) + _
             "----------------------------------------" + CHR$(10)
NEXT i

' ── Claude API Request bauen ─────────────────────────────────────
DIM body_map AS MAP
body_map{"model"}      = "claude-haiku-4-5"
body_map{"max_tokens"} = 2048

DIM msg_user AS MAP
msg_user{"role"}    = "user"
msg_user{"content"} = prompt

DIM msgs_arr AS ARRAY = [msg_user]
body_map{"messages"} = msgs_arr

DIM body_json AS STRING = JSON.STRINGIFY$(body_map)

' ── HTTP-Headers + POST ──────────────────────────────────────────
HTTP.SETHEADER "x-api-key", api_key
HTTP.SETHEADER "anthropic-version", "2023-06-01"
HTTP.SETHEADER "content-type", "application/json"

PRINT "Calling Anthropic API ("; LEN(prompt); " bytes prompt)..."
DIM resp AS STRING = HTTP.POST$("https://api.anthropic.com/v1/messages", body_json, "application/json")

IF LEN(resp) = 0 THEN
    DIM err3$ = "Empty response from Anthropic API. Network/proxy issue?"
    TXTWRITER out_path, err3$
    PRINT err3$
    END
ENDIF

' ── Antwort parsen ───────────────────────────────────────────────
DIM parsed = JSON.PARSE$(resp)

' Anthropic-Response: { "content": [ {"type":"text","text":"..."} ], ... }
' Bei Fehler:        { "type":"error", "error": {"type":"...","message":"..."} }
DIM resp_type AS STRING = parsed{"type"}
IF resp_type = "error" THEN
    DIM err_obj = parsed{"error"}
    DIM err4$ = "Anthropic API error: " + err_obj{"type"} + " — " + err_obj{"message"}
    TXTWRITER out_path, err4$
    PRINT err4$
    END
ENDIF

DIM content = parsed{"content"}
IF LEN(content) = 0 THEN
    TXTWRITER out_path, "API returned content array of length 0. Raw response:" + CHR$(10) + resp
    END
ENDIF

DIM first = content[0]
DIM summary AS STRING = first{"text"}

' ── Header dazu, dann ablegen ────────────────────────────────────
DIM out AS STRING
out = "===  Outlook-Conversation-Summary  ===" + CHR$(10) + _
      "Subject: " + subject + CHR$(10) + _
      "Messages: " + STR$(n) + CHR$(10) + _
      "Generated: " + DATE$ + " " + TIME$ + CHR$(10) + _
      "Model: " + body_map{"model"} + CHR$(10) + _
      "----------------------------------------" + CHR$(10) + CHR$(10) + _
      summary + CHR$(10)

TXTWRITER out_path, out
PRINT "Summary written to "; out_path; " ("; LEN(summary); " chars)."
