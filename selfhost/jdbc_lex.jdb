OPTION EXPLICIT

' S1 of the self-hosting plan: the jdBasic lexer.
'
' Reads a source file and prints the token stream in exactly the format
' `jdbasic --dump-tokens` prints, so the two can be compared line by line over
' the whole test tree.
'
' It mirrors src/lexer.cpp deliberately, including the parts that look odd:
' the recorded column is the one *after* the token, identifiers and keywords
' are upper-cased, REM turns into a NEWLINE, and the NEWLINE token carries the
' two characters backslash and n rather than a line break.
'
'   jdbasic selfhost/jdbc_lex.jdb <file.jdb>

CONST MAX_TOKENS = 200000

' Nothing here hard-codes a token number. Every one is looked up by name in
' the table generated from src/token.h, so a reordered enum cannot put the two
' lexers quietly out of step.
DIM T_INTEGER_LIT AS INTEGER
DIM T_FLOAT_LIT AS INTEGER
DIM T_STRING_LIT AS INTEGER
DIM T_IDENTIFIER AS INTEGER
DIM T_NEWLINE AS INTEGER
DIM T_EOF AS INTEGER

DIM tokName[400] AS STRING
DIM tokCount AS INTEGER

DIM src AS STRING
DIM pos AS INTEGER
DIM lineNo AS INTEGER
DIM colNo AS INTEGER

DIM tkType[MAX_TOKENS]
DIM tkLine[MAX_TOKENS]
DIM tkCol[MAX_TOKENS]
DIM tkVal[MAX_TOKENS] AS STRING
DIM tkCount AS INTEGER

DIM kwWord[400] AS STRING
DIM kwType[400]
DIM kwCount AS INTEGER

DIM opName[64] AS STRING
DIM opType[64]
DIM opCount AS INTEGER

DIM lexError AS STRING

' ── Character tests ────────────────────────────────────────────────────────

FUNC IS_DIGIT_C(c AS INTEGER) AS INTEGER
    IF c >= 48 AND c <= 57 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_ALPHA_C(c AS INTEGER) AS INTEGER
    IF c >= 65 AND c <= 90 THEN RETURN 1
    IF c >= 97 AND c <= 122 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_ALNUM_C(c AS INTEGER) AS INTEGER
    IF IS_DIGIT_C(c) = 1 THEN RETURN 1
    IF IS_ALPHA_C(c) = 1 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_HEX_C(c AS INTEGER) AS INTEGER
    IF IS_DIGIT_C(c) = 1 THEN RETURN 1
    IF c >= 65 AND c <= 70 THEN RETURN 1
    IF c >= 97 AND c <= 102 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC HEX_VAL(c AS INTEGER) AS INTEGER
    IF c >= 48 AND c <= 57 THEN RETURN c - 48
    IF c >= 65 AND c <= 70 THEN RETURN c - 55
    RETURN c - 87
ENDFUNC

' ── Cursor ─────────────────────────────────────────────────────────────────

FUNC PEEKCH() AS INTEGER
    IF pos >= LEN(src) THEN RETURN 0
    RETURN BYTEAT(src, pos)
ENDFUNC

FUNC PEEKNEXT() AS INTEGER
    IF pos + 1 >= LEN(src) THEN RETURN 0
    RETURN BYTEAT(src, pos + 1)
ENDFUNC

FUNC ADVANCE() AS INTEGER
    DIM c AS INTEGER
    c = CINT(BYTEAT(src, pos))
    pos = pos + 1
    IF c = 10 THEN
        lineNo = lineNo + 1
        colNo = 1
    ELSE
        colNo = colNo + 1
    ENDIF
    RETURN c
ENDFUNC

' The line and column recorded are the ones current *after* the token text has
' been consumed, which is what the reference lexer does.
SUB ADDTOK(ty AS INTEGER, val AS STRING)
    IF tkCount >= MAX_TOKENS THEN
        lexError = "too many tokens"
        RETURN
    ENDIF
    tkType[tkCount] = ty
    tkLine[tkCount] = lineNo
    tkCol[tkCount] = colNo
    tkVal[tkCount] = val
    tkCount = tkCount + 1
ENDSUB

' ── Tables ─────────────────────────────────────────────────────────────────

SUB KW_ADD(w AS STRING, t AS INTEGER)
    kwWord[kwCount] = w
    kwType[kwCount] = t
    kwCount = kwCount + 1
ENDSUB

FUNC KW_LOOKUP(w AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO kwCount - 1
        IF kwWord[i] = w THEN RETURN CINT(kwType[i])
    NEXT i
    RETURN -1
ENDFUNC

FUNC TOK_BY_NAME(n AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO tokCount - 1
        IF tokName[i] = n THEN RETURN i
    NEXT i
    PRINT "LEX SETUP: unknown token name "; n
    RETURN -1
ENDFUNC

SUB OP_ADD(w AS STRING, n AS STRING)
    opName[opCount] = w
    opType[opCount] = CINT(TOK_BY_NAME(n))
    opCount = opCount + 1
ENDSUB

' ── Scanners ───────────────────────────────────────────────────────────────

' Raw literals: a backslash is an ordinary character and a doubled quote is
' how a quote gets in, so this one is built up rather than sliced out.
SUB READ_STRING()
    DIM r AS STRING
    DIM c AS INTEGER
    DIM discard AS INTEGER

    discard = CINT(ADVANCE())
    r = ""
    DO
        IF pos >= LEN(src) THEN EXITDO
        c = CINT(PEEKCH())
        IF c = 34 THEN
            IF pos + 1 < LEN(src) ANDALSO PEEKNEXT() = 34 THEN
                r = r + CHR$(34)
                discard = CINT(ADVANCE())
                discard = CINT(ADVANCE())
            ELSE
                EXITDO
            ENDIF
        ELSE
            r = r + CHR$(CINT(ADVANCE()))
        ENDIF
    LOOP
    IF pos < LEN(src) THEN discard = CINT(ADVANCE())
    ADDTOK(T_STRING_LIT, r)
ENDSUB

SUB READ_NUMBER()
    DIM start AS INTEGER
    DIM isFloat AS INTEGER
    DIM c AS INTEGER
    DIM discard AS INTEGER

    start = pos
    isFloat = 0
    DO
        IF pos >= LEN(src) THEN EXITDO
        c = CINT(PEEKCH())
        IF IS_DIGIT_C(c) = 0 AND c <> 46 THEN EXITDO
        IF c = 46 THEN
            IF isFloat = 1 THEN EXITDO
            isFloat = 1
        ENDIF
        discard = CINT(ADVANCE())
    LOOP

    IF pos < LEN(src) THEN
        c = CINT(PEEKCH())
        IF c = 101 OR c = 69 THEN
            isFloat = 1
            discard = CINT(ADVANCE())
            IF pos < LEN(src) THEN
                c = CINT(PEEKCH())
                IF c = 43 OR c = 45 THEN discard = CINT(ADVANCE())
            ENDIF
            DO
                IF pos >= LEN(src) THEN EXITDO
                IF IS_DIGIT_C(CINT(PEEKCH())) = 0 THEN EXITDO
                discard = CINT(ADVANCE())
            LOOP
        ENDIF
    ENDIF

    IF isFloat = 1 THEN
        ADDTOK(T_FLOAT_LIT, MID$(src, start, pos - start))
    ELSE
        ADDTOK(T_INTEGER_LIT, MID$(src, start, pos - start))
    ENDIF
ENDSUB

SUB SKIP_COMMENT()
    DIM discard AS INTEGER
    DO
        IF pos >= LEN(src) THEN RETURN
        IF PEEKCH() = 10 THEN RETURN
        discard = CINT(ADVANCE())
    LOOP
ENDSUB

SUB READ_IDENT()
    DIM start AS INTEGER
    DIM id AS STRING
    DIM up AS STRING
    DIM t AS INTEGER
    DIM discard AS INTEGER

    start = pos
    DO
        IF pos >= LEN(src) THEN EXITDO
        IF IS_ALNUM_C(CINT(PEEKCH())) = 0 AND PEEKCH() <> 95 THEN EXITDO
        discard = CINT(ADVANCE())
    LOOP
    ' A trailing $ belongs to the name: GETENV$, DATE$ and friends.
    IF pos < LEN(src) THEN
        IF PEEKCH() = 36 THEN discard = CINT(ADVANCE())
    ENDIF

    id = MID$(src, start, pos - start)
    up = UCASE$(id)

    IF up = "REM" THEN
        SKIP_COMMENT()
        ADDTOK(T_NEWLINE, "\n")
        RETURN
    ENDIF

    t = CINT(KW_LOOKUP(up))
    IF t >= 0 THEN
        ADDTOK(t, up)
    ELSE
        ADDTOK(T_IDENTIFIER, up)
    ENDIF
ENDSUB

' $FF and %0101 both become an INTEGER_LIT carrying the decimal text.
SUB READ_RADIX(base AS INTEGER)
    DIM v AS DOUBLE
    DIM c AS INTEGER
    DIM discard AS INTEGER

    discard = CINT(ADVANCE())
    v = 0
    DO
        IF pos >= LEN(src) THEN EXITDO
        c = CINT(PEEKCH())
        IF base = 16 THEN
            IF IS_HEX_C(c) = 0 THEN EXITDO
            v = v * 16 + HEX_VAL(c)
        ELSE
            IF c <> 48 AND c <> 49 THEN EXITDO
            v = v * 2 + (c - 48)
        ENDIF
        discard = CINT(ADVANCE())
    LOOP
    ADDTOK(T_INTEGER_LIT, STR$(v))
ENDSUB

' ── The loop ───────────────────────────────────────────────────────────────

SUB TOKENIZE()
    DIM c AS INTEGER
    DIM lastWasNewline AS INTEGER
    DIM i AS INTEGER
    DIM matched AS INTEGER
    DIM two AS STRING
    DIM one AS STRING
    DIM discard AS INTEGER

    pos = 0
    lineNo = 1
    colNo = 1
    tkCount = 0
    lastWasNewline = 1

    DO
        IF pos >= LEN(src) THEN EXITDO
        IF lexError <> "" THEN RETURN

        ' Spaces, tabs and carriage returns carry no token.
        DO
            IF pos >= LEN(src) THEN EXITDO
            c = CINT(PEEKCH())
            IF c <> 32 AND c <> 9 AND c <> 13 THEN EXITDO
            discard = CINT(ADVANCE())
        LOOP
        IF pos >= LEN(src) THEN EXITDO

        c = CINT(PEEKCH())

        IF c = 10 THEN
            discard = CINT(ADVANCE())
            ' A trailing _ joins this line with the next, so it and the break
            ' both disappear.
            IF tkCount > 0 ANDALSO tkType[tkCount - 1] = T_IDENTIFIER ANDALSO tkVal[tkCount - 1] = "_" THEN
                tkCount = tkCount - 1
                CONTINUEDO
            ENDIF
            IF lastWasNewline = 0 THEN
                ADDTOK(T_NEWLINE, "\n")
                lastWasNewline = 1
            ENDIF
            CONTINUEDO
        ENDIF

        lastWasNewline = 0

        IF c = 39 THEN
            SKIP_COMMENT()
            CONTINUEDO
        ENDIF

        IF c = 34 THEN
            READ_STRING()
            CONTINUEDO
        ENDIF

        IF c = 36 AND IS_HEX_C(CINT(PEEKNEXT())) = 1 THEN
            READ_RADIX(16)
            CONTINUEDO
        ENDIF

        IF c = 37 AND (PEEKNEXT() = 48 OR PEEKNEXT() = 49) THEN
            READ_RADIX(2)
            CONTINUEDO
        ENDIF

        IF IS_DIGIT_C(c) = 1 OR (c = 46 AND IS_DIGIT_C(CINT(PEEKNEXT())) = 1) THEN
            READ_NUMBER()
            CONTINUEDO
        ENDIF

        IF IS_ALPHA_C(c) = 1 OR c = 95 THEN
            READ_IDENT()
            CONTINUEDO
        ENDIF

        ' Operators, longest first so <= wins over <.
        two = MID$(src, pos, 2)
        one = MID$(src, pos, 1)
        matched = 0
        FOR i = 0 TO opCount - 1
            IF LEN(opName[i]) = 2 AND opName[i] = two THEN
                discard = CINT(ADVANCE())
                discard = CINT(ADVANCE())
                ADDTOK(CINT(opType[i]), opName[i])
                matched = 1
                EXITFOR
            ENDIF
        NEXT i
        IF matched = 0 THEN
            FOR i = 0 TO opCount - 1
                IF LEN(opName[i]) = 1 AND opName[i] = one THEN
                    discard = CINT(ADVANCE())
                    ADDTOK(CINT(opType[i]), opName[i])
                    matched = 1
                    EXITFOR
                ENDIF
            NEXT i
        ENDIF
        IF matched = 0 THEN
            lexError = "Unexpected character " + one + " at line " + STR$(lineNo)
            RETURN
        ENDIF
    LOOP

    IF lastWasNewline = 0 THEN ADDTOK(T_NEWLINE, "\n")
    ADDTOK(T_EOF, "")
ENDSUB

' ── Output, in the shape --dump-tokens uses ────────────────────────────────

FUNC ESCAPE$(v AS STRING) AS STRING
    DIM r AS STRING
    DIM i AS INTEGER
    DIM c AS INTEGER
    r = ""
    FOR i = 0 TO LEN(v) - 1
        c = CINT(BYTEAT(v, i))
        IF c = 92 THEN
            r = r + "\\"
        ELSE
            IF c = 10 THEN
                r = r + "\n"
            ELSE
                IF c = 9 THEN
                    r = r + "\t"
                ELSE
                    IF c = 13 THEN
                        r = r + "\r"
                    ELSE
                        r = r + CHR$(c)
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT i
    RETURN r
ENDFUNC

SUB EMIT_TOKENS()
    DIM i AS INTEGER
    DIM out AS STRING
    out = ""
    FOR i = 0 TO tkCount - 1
        out = out + STR$(tkType[i]) + CHR$(9) + STR$(tkLine[i]) + CHR$(9)
        out = out + STR$(tkCol[i]) + CHR$(9) + ESCAPE$(tkVal[i]) + CHR$(10)
    NEXT i
    PRINT out;
ENDSUB

' ── Main ───────────────────────────────────────────────────────────────────

SUB LOAD_TABLES()
    DIM txt AS STRING
    DIM lineStart AS INTEGER
    DIM lineEnd AS INTEGER
    DIM ln AS STRING
    DIM p AS INTEGER
    DIM w AS STRING
    DIM t AS STRING

    kwCount = 0
    tokCount = 0
    txt = TXTREADER$("selfhost/jdbc_tokens.jdb")
    lineStart = 0
    DO
        IF lineStart >= LEN(txt) THEN EXITDO
        lineEnd = CINT(INSTR(MID$(txt, lineStart, LEN(txt) - lineStart), CHR$(10)))
        IF lineEnd < 0 THEN
            ln = MID$(txt, lineStart, LEN(txt) - lineStart)
            lineStart = LEN(txt)
        ELSE
            ln = MID$(txt, lineStart, lineEnd)
            lineStart = lineStart + lineEnd + 1
        ENDIF

        p = CINT(INSTR(ln, "TOK_NAME["))
        IF p >= 0 THEN
            p = CINT(INSTR(ln, "["))
            t = MID$(ln, p + 1, LEN(ln) - p - 1)
            p = CINT(INSTR(t, "]"))
            w = LEFT$(t, p)
            p = CINT(INSTR(ln, CHR$(34)))
            t = MID$(ln, p + 1, LEN(ln) - p - 1)
            p = CINT(INSTR(t, CHR$(34)))
            tokName[CINT(VAL(w))] = LEFT$(t, p)
            IF CINT(VAL(w)) + 1 > tokCount THEN tokCount = CINT(VAL(w)) + 1
        ENDIF

        p = CINT(INSTR(ln, "KW_WORD["))
        IF p >= 0 THEN
            p = CINT(INSTR(ln, CHR$(34)))
            ln = MID$(ln, p + 1, LEN(ln) - p - 1)
            p = CINT(INSTR(ln, CHR$(34)))
            w = LEFT$(ln, p)
            ln = MID$(ln, p + 1, LEN(ln) - p - 1)
            p = CINT(INSTR(ln, "] = "))
            IF p >= 0 THEN
                t = TRIM$(MID$(ln, p + 4, LEN(ln) - p - 4))
                KW_ADD(w, CINT(VAL(t)))
            ENDIF
        ENDIF
    LOOP

    T_INTEGER_LIT = CINT(TOK_BY_NAME("INTEGER_LIT"))
    T_FLOAT_LIT = CINT(TOK_BY_NAME("FLOAT_LIT"))
    T_STRING_LIT = CINT(TOK_BY_NAME("STRING_LIT"))
    T_IDENTIFIER = CINT(TOK_BY_NAME("IDENTIFIER"))
    T_NEWLINE = CINT(TOK_BY_NAME("NEWLINE"))
    T_EOF = CINT(TOK_BY_NAME("EOF_TOKEN"))

    ' Two-character spellings come first so <= is not read as < then =.
    opCount = 0
    OP_ADD("->", "ARROW")
    OP_ADD("|>", "PIPE")
    OP_ADD("<=", "LE")
    OP_ADD("<>", "NE")
    OP_ADD(">=", "GE")
    OP_ADD("+", "PLUS")
    OP_ADD("-", "MINUS")
    OP_ADD("*", "STAR")
    OP_ADD("/", "SLASH")
    ' One backslash. jdBasic string literals are raw, so this is not an escape.
    OP_ADD("\", "BACKSLASH")
    OP_ADD("^", "CARET")
    OP_ADD("(", "LPAREN")
    OP_ADD(")", "RPAREN")
    OP_ADD("[", "LBRACKET")
    OP_ADD("]", "RBRACKET")
    OP_ADD(",", "COMMA")
    OP_ADD(":", "COLON")
    OP_ADD(";", "SEMICOLON")
    OP_ADD(".", "DOT")
    OP_ADD("@", "AT")
    OP_ADD("?", "PLACEHOLDER")
    OP_ADD("{", "LBRACE")
    OP_ADD("}", "RBRACE")
    OP_ADD("<", "LT")
    OP_ADD(">", "GT")
    OP_ADD("=", "ASSIGN")
ENDSUB

DIM args AS ARRAY
DIM path AS STRING

lexError = ""
args = OS.ARGS
' OS.ARGS carries the script itself at index 0.
IF LEN(args) < 2 THEN
    PRINT "usage: jdbasic selfhost/jdbc_lex.jdb <file.jdb>"
    END
ENDIF
path = args[1]

LOAD_TABLES()

' The reference reads its source through an ifstream in text mode, which turns
' CRLF into LF on Windows. TXTREADER$ reads the bytes as they are, so the same
' normalisation has to happen here or every CRLF file is off by a column.
src = REPLACE$(TXTREADER$(path), CHR$(13) + CHR$(10), CHR$(10))
TOKENIZE()

IF lexError <> "" THEN
    PRINT "LEX ERROR: "; lexError
    END
ENDIF

EMIT_TOKENS()
