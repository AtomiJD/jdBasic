OPTION EXPLICIT

' The jdBasic compiler, written in jdBasic.
'
' Three modes:
'   jdbasic selfhost/jdbc.jdb --tokens <file>   token stream, as --dump-tokens
'   jdbasic selfhost/jdbc.jdb --ast <file>      parse tree, as --dump-ast
'   jdbasic selfhost/jdbc.jdb <file> <out.ll>   LLVM IR for clang
'
' The first two exist so the front end can be compared against the reference
' line by line rather than inspected.
'
' jdBasic-0 has no records, so the tree lives in parallel arrays with integer
' indices standing in for pointers, and the variable-length lists (bodies,
' arguments, parameters) live in shared arenas addressed by a start and a
' count. A body is parsed into a local scratch list first and copied into its
' arena afterwards, because nested bodies would otherwise interleave.
'
CONST MAX_TOKENS = 200000
CONST MAX_NODES = 120000
CONST MAX_BUF = 120000
CONST MAX_LOCAL = 400

' ── Token stream, produced the same way jdbc_lex.jdb produces it ───────────

DIM T_INTEGER_LIT AS INTEGER
DIM T_FLOAT_LIT AS INTEGER
DIM T_STRING_LIT AS INTEGER
DIM T_IDENTIFIER AS INTEGER
DIM T_NEWLINE AS INTEGER
DIM T_EOF AS INTEGER

DIM tokName[400] AS STRING
DIM tokNameCount AS INTEGER

DIM kwWord[400] AS STRING
DIM kwType[400]
DIM kwCount AS INTEGER

DIM opName[64] AS STRING
DIM opType[64]
DIM opCount AS INTEGER

DIM src AS STRING
DIM pos AS INTEGER
DIM lineNo AS INTEGER
DIM colNo AS INTEGER

DIM tkType[MAX_TOKENS]
DIM tkLine[MAX_TOKENS]
DIM tkCol[MAX_TOKENS]
DIM tkVal[MAX_TOKENS] AS STRING
DIM tkCount AS INTEGER

DIM lexError AS STRING

' ── Expression nodes ───────────────────────────────────────────────────────

DIM exKind[MAX_NODES]
DIM exLine[MAX_NODES]
DIM exInt[MAX_NODES]
DIM exFloat[MAX_NODES]
DIM exStr[MAX_NODES] AS STRING
DIM exOp[MAX_NODES]
DIM exBool[MAX_NODES]
DIM exKeyAt[MAX_NODES]
DIM exKeyN[MAX_NODES]
DIM exLpAt[MAX_NODES]
DIM exLpN[MAX_NODES]
DIM exLcAt[MAX_NODES]
DIM exLcN[MAX_NODES]
DIM exFuncRef[MAX_NODES]
DIM exFn[MAX_NODES] AS STRING
DIM exLeft[MAX_NODES]
DIM exRight[MAX_NODES]
DIM exArgAt[MAX_NODES]
DIM exArgN[MAX_NODES]
DIM exCount AS INTEGER

DIM argBuf[MAX_BUF]
DIM keyBuf[MAX_BUF] AS STRING
DIM keyN AS INTEGER
DIM lpBuf[MAX_BUF] AS STRING
DIM lpN AS INTEGER
DIM lcBuf[MAX_BUF] AS STRING
DIM lcN AS INTEGER
DIM tmpNodes[MAX_BUF]
DIM tmpNodeN AS INTEGER
DIM argN AS INTEGER

' ── Statement nodes ────────────────────────────────────────────────────────

DIM stKind[MAX_NODES]
DIM stLine[MAX_NODES]
DIM stVar[MAX_NODES] AS STRING
DIM stVType[MAX_NODES]
DIM stEType[MAX_NODES]
DIM stConst[MAX_NODES]
DIM stLabel[MAX_NODES] AS STRING
DIM stFunc[MAX_NODES] AS STRING
DIM stRType[MAX_NODES]
DIM stAsync[MAX_NODES]
DIM stExpr[MAX_NODES]
DIM stCond[MAX_NODES]
DIM stEnd[MAX_NODES]
DIM stStep[MAX_NODES]
DIM stTop[MAX_NODES]
DIM stUntil[MAX_NODES]
DIM stNoNl[MAX_NODES]
DIM stPrAt[MAX_NODES]
DIM stPrN[MAX_NODES]
DIM stSepAt[MAX_NODES]
DIM stSepN[MAX_NODES]
DIM stIxAt[MAX_NODES]
DIM stIxN[MAX_NODES]
DIM stTmAt[MAX_NODES]
DIM stTmN[MAX_NODES]
DIM stEmAt[MAX_NODES]
DIM stEmN[MAX_NODES]
DIM stStatic[MAX_NODES]
DIM stParAt[MAX_NODES]
DIM stParN[MAX_NODES]
DIM stBodyAt[MAX_NODES]
DIM stCatchAt[MAX_NODES]
DIM stCatchN[MAX_NODES]
DIM stFinAt[MAX_NODES]
DIM stFinN[MAX_NODES]
DIM stBodyN[MAX_NODES]
DIM stBrAt[MAX_NODES]
DIM stBrN[MAX_NODES]
DIM stCount AS INTEGER

DIM prBuf[MAX_BUF]
DIM prN AS INTEGER
DIM sepBuf[MAX_BUF]
DIM sepN AS INTEGER
DIM ixBuf[MAX_BUF]
DIM ixN AS INTEGER
DIM bodyBuf[MAX_BUF]
DIM bodyN AS INTEGER

DIM tmName[MAX_BUF] AS STRING
DIM tmType[MAX_BUF]
DIM tmN AS INTEGER

DIM emName[MAX_BUF] AS STRING
DIM emVal[MAX_BUF]
DIM emN AS INTEGER

DIM parName[MAX_BUF] AS STRING
DIM parType[MAX_BUF]
DIM parN AS INTEGER

DIM brCond[MAX_BUF]
DIM brBodyAt[MAX_BUF]
DIM brBodyN[MAX_BUF]
DIM brN AS INTEGER

DIM topAt AS INTEGER
DIM topN AS INTEGER

' ── Parser cursor ──────────────────────────────────────────────────────────

DIM cur AS INTEGER
DIM parseError AS STRING

' ── Token type shorthands, all looked up by name ───────────────────────────

DIM TT_ASSIGN AS INTEGER
DIM TT_LPAREN AS INTEGER
DIM TT_RPAREN AS INTEGER
DIM TT_LBRACKET AS INTEGER
DIM TT_RBRACKET AS INTEGER
DIM TT_LBRACE AS INTEGER
DIM TT_RBRACE AS INTEGER
DIM TT_COMMA AS INTEGER
DIM TT_COLON AS INTEGER
DIM TT_SEMICOLON AS INTEGER
DIM TT_DOT AS INTEGER
DIM TT_ARROW AS INTEGER
DIM TT_PIPE AS INTEGER
DIM TT_AT AS INTEGER
DIM TT_PLACEHOLDER AS INTEGER
DIM TT_MINUS AS INTEGER
DIM TT_BNOT AS INTEGER
DIM TT_NOT AS INTEGER
DIM TT_AND AS INTEGER
DIM TT_ANDALSO AS INTEGER
DIM TT_OR AS INTEGER
DIM TT_ORELSE AS INTEGER
DIM TT_NE AS INTEGER
DIM TT_CARET AS INTEGER
DIM TT_TRUE AS INTEGER
DIM TT_FALSE AS INTEGER

DIM cmpOps[16]
DIM cmpN AS INTEGER
DIM addOps[8]
DIM addN AS INTEGER
DIM mulOps[8]
DIM mulN AS INTEGER

DIM K_LET AS INTEGER
DIM K_DIM AS INTEGER
DIM K_PRINT AS INTEGER
DIM K_IF AS INTEGER
DIM K_SUB AS INTEGER
DIM K_FUNCTION AS INTEGER
DIM K_DO_LOOP AS INTEGER
DIM K_FOR_LOOP AS INTEGER
DIM K_RETURN AS INTEGER
DIM K_EXPR_STMT AS INTEGER
DIM K_ASSIGN AS INTEGER
DIM K_INDEX_ASSIGN AS INTEGER
DIM K_FOR_EACH AS INTEGER
DIM K_TYPE_DECL AS INTEGER
DIM K_ENUM AS INTEGER
DIM K_SWITCH AS INTEGER
DIM K_TRY_CATCH AS INTEGER
DIM K_THROW AS INTEGER
DIM K_SLEEP AS INTEGER
DIM K_STOP AS INTEGER
DIM K_CLS AS INTEGER
DIM K_LOCATE AS INTEGER
DIM K_COLOR AS INTEGER
DIM K_CURSOR AS INTEGER
DIM K_END_STMT AS INTEGER
DIM K_OPTION AS INTEGER
DIM K_EXIT_LOOP AS INTEGER
DIM K_CONTINUE_LOOP AS INTEGER

DIM X_LIT_INT AS INTEGER
DIM X_LIT_FLOAT AS INTEGER
DIM X_LIT_STR AS INTEGER
DIM X_LIT_BOOL AS INTEGER
DIM X_VARIABLE AS INTEGER
DIM X_BINARY AS INTEGER
DIM X_UNARY AS INTEGER
DIM X_CALL AS INTEGER
DIM X_INDEX AS INTEGER
DIM X_ARRAY_LIT AS INTEGER
DIM X_MAP_LIT AS INTEGER
DIM X_MEMBER AS INTEGER
DIM X_LAMBDA AS INTEGER
DIM X_PIPE AS INTEGER
DIM X_PLACEHOLDER AS INTEGER

DIM TOK_PLUS AS INTEGER
DIM TOK_MINUS AS INTEGER
DIM TOK_STAR AS INTEGER
DIM TOK_SLASH AS INTEGER
DIM TOK_MOD AS INTEGER
DIM TOK_BSLASH AS INTEGER
DIM TOK_LT AS INTEGER
DIM TOK_GT AS INTEGER
DIM TOK_LE AS INTEGER
DIM TOK_GE AS INTEGER
DIM TOK_NE AS INTEGER
DIM TOK_ASSIGN AS INTEGER
DIM TOK_AND AS INTEGER
DIM TOK_ANDALSO AS INTEGER
DIM TOK_OR AS INTEGER
DIM TOK_ORELSE AS INTEGER

DIM strDecl AS STRING

' ── Tables, all numbers read from the generated file ───────────────────────

FUNC PARSE_INT(t AS STRING) AS INTEGER
    RETURN CINT(VAL(t))
ENDFUNC

SUB LOAD_TABLES()
    DIM txt AS STRING
    DIM at AS INTEGER
    DIM ln AS STRING
    DIM p AS INTEGER
    DIM w AS STRING
    DIM t AS STRING
    DIM nl AS INTEGER

    kwCount = 0
    tokNameCount = 0
    txt = TXTREADER$("selfhost/jdbc_tokens.jdb")
    at = 0
    DO
        IF at >= LEN(txt) THEN EXITDO
        nl = CINT(INSTR(MID$(txt, at, LEN(txt) - at), CHR$(10)))
        IF nl < 0 THEN
            ln = MID$(txt, at, LEN(txt) - at)
            at = LEN(txt)
        ELSE
            ln = MID$(txt, at, nl)
            at = at + nl + 1
        ENDIF

        p = CINT(INSTR(ln, "TOK_NAME["))
        IF p >= 0 ANDALSO INSTR(ln, "TOK_NAME_COUNT") < 0 THEN
            p = CINT(INSTR(ln, "["))
            t = MID$(ln, p + 1, LEN(ln) - p - 1)
            p = CINT(INSTR(t, "]"))
            w = LEFT$(t, p)
            p = CINT(INSTR(ln, CHR$(34)))
            t = MID$(ln, p + 1, LEN(ln) - p - 1)
            p = CINT(INSTR(t, CHR$(34)))
            tokName[PARSE_INT(w)] = LEFT$(t, p)
            IF PARSE_INT(w) + 1 > tokNameCount THEN tokNameCount = PARSE_INT(w) + 1
        ENDIF

        p = CINT(INSTR(ln, "KW_WORD["))
        IF p >= 0 ANDALSO INSTR(ln, "KW_COUNT") < 0 THEN
            p = CINT(INSTR(ln, CHR$(34)))
            t = MID$(ln, p + 1, LEN(ln) - p - 1)
            p = CINT(INSTR(t, CHR$(34)))
            w = LEFT$(t, p)
            t = MID$(t, p + 1, LEN(t) - p - 1)
            p = CINT(INSTR(t, "] = "))
            IF p >= 0 THEN KW_ADD(w, PARSE_INT(TRIM$(MID$(t, p + 4, LEN(t) - p - 4))))
        ENDIF
    LOOP

    TOK_PLUS = CINT(TOK_BY_NAME("PLUS"))
    TOK_MINUS = CINT(TOK_BY_NAME("MINUS"))
    TOK_STAR = CINT(TOK_BY_NAME("STAR"))
    TOK_SLASH = CINT(TOK_BY_NAME("SLASH"))
    TOK_MOD = CINT(TOK_BY_NAME("MOD"))
    TOK_BSLASH = CINT(TOK_BY_NAME("BACKSLASH"))
    TOK_LT = CINT(TOK_BY_NAME("LT"))
    TOK_GT = CINT(TOK_BY_NAME("GT"))
    TOK_LE = CINT(TOK_BY_NAME("LE"))
    TOK_GE = CINT(TOK_BY_NAME("GE"))
    TOK_NE = CINT(TOK_BY_NAME("NE"))
    TOK_ASSIGN = CINT(TOK_BY_NAME("ASSIGN"))
    TOK_AND = CINT(TOK_BY_NAME("AND"))
    TOK_ANDALSO = CINT(TOK_BY_NAME("ANDALSO"))
    TOK_OR = CINT(TOK_BY_NAME("OR"))
    TOK_ORELSE = CINT(TOK_BY_NAME("ORELSE"))
    T_INTEGER_LIT = CINT(TOK_BY_NAME("INTEGER_LIT"))
    T_FLOAT_LIT = CINT(TOK_BY_NAME("FLOAT_LIT"))
    T_STRING_LIT = CINT(TOK_BY_NAME("STRING_LIT"))
    T_IDENTIFIER = CINT(TOK_BY_NAME("IDENTIFIER"))
    T_NEWLINE = CINT(TOK_BY_NAME("NEWLINE"))
    T_EOF = CINT(TOK_BY_NAME("EOF_TOKEN"))

    TT_ASSIGN = CINT(TOK_BY_NAME("ASSIGN"))
    TT_LPAREN = CINT(TOK_BY_NAME("LPAREN"))
    TT_RPAREN = CINT(TOK_BY_NAME("RPAREN"))
    TT_LBRACKET = CINT(TOK_BY_NAME("LBRACKET"))
    TT_RBRACKET = CINT(TOK_BY_NAME("RBRACKET"))
    TT_LBRACE = CINT(TOK_BY_NAME("LBRACE"))
    TT_RBRACE = CINT(TOK_BY_NAME("RBRACE"))
    TT_COMMA = CINT(TOK_BY_NAME("COMMA"))
    TT_COLON = CINT(TOK_BY_NAME("COLON"))
    TT_SEMICOLON = CINT(TOK_BY_NAME("SEMICOLON"))
    TT_DOT = CINT(TOK_BY_NAME("DOT"))
    TT_ARROW = CINT(TOK_BY_NAME("ARROW"))
    TT_PIPE = CINT(TOK_BY_NAME("PIPE"))
    TT_AT = CINT(TOK_BY_NAME("AT"))
    TT_PLACEHOLDER = CINT(TOK_BY_NAME("PLACEHOLDER"))
    TT_MINUS = CINT(TOK_BY_NAME("MINUS"))
    TT_BNOT = CINT(TOK_BY_NAME("BNOT"))
    TT_NOT = CINT(TOK_BY_NAME("NOT"))
    TT_AND = CINT(TOK_BY_NAME("AND"))
    TT_ANDALSO = CINT(TOK_BY_NAME("ANDALSO"))
    TT_OR = CINT(TOK_BY_NAME("OR"))
    TT_ORELSE = CINT(TOK_BY_NAME("ORELSE"))
    TT_NE = CINT(TOK_BY_NAME("NE"))
    TT_CARET = CINT(TOK_BY_NAME("CARET"))
    TT_TRUE = CINT(TOK_BY_NAME("TRUE_KW"))
    TT_FALSE = CINT(TOK_BY_NAME("FALSE_KW"))

    cmpN = 0
    cmpOps[cmpN] = TOK_BY_NAME("GT") : cmpN = cmpN + 1
    cmpOps[cmpN] = TOK_BY_NAME("LT") : cmpN = cmpN + 1
    cmpOps[cmpN] = TOK_BY_NAME("GE") : cmpN = cmpN + 1
    cmpOps[cmpN] = TOK_BY_NAME("LE") : cmpN = cmpN + 1
    cmpOps[cmpN] = TOK_BY_NAME("NE") : cmpN = cmpN + 1
    cmpOps[cmpN] = TOK_BY_NAME("ASSIGN") : cmpN = cmpN + 1
    cmpOps[cmpN] = TOK_BY_NAME("IN") : cmpN = cmpN + 1

    addN = 0
    addOps[addN] = TOK_BY_NAME("PLUS") : addN = addN + 1
    addOps[addN] = TOK_BY_NAME("MINUS") : addN = addN + 1

    mulN = 0
    mulOps[mulN] = TOK_BY_NAME("STAR") : mulN = mulN + 1
    mulOps[mulN] = TOK_BY_NAME("SLASH") : mulN = mulN + 1
    mulOps[mulN] = TOK_BY_NAME("BACKSLASH") : mulN = mulN + 1
    mulOps[mulN] = TOK_BY_NAME("MOD") : mulN = mulN + 1

    K_LET = 0
    K_DIM = 1
    K_PRINT = 2
    K_IF = 6
    K_SUB = 7
    K_FUNCTION = 8
    K_DO_LOOP = 9
    K_FOR_LOOP = 10
    K_RETURN = 11
    K_EXPR_STMT = 12
    K_ASSIGN = 13
    K_INDEX_ASSIGN = 14
    K_FOR_EACH = 21
    K_TYPE_DECL = 20
    K_ENUM = 16
    K_SWITCH = 17
    K_TRY_CATCH = 18
    K_THROW = 19
    K_SLEEP = 22
    K_STOP = 23
    K_CLS = 25
    K_LOCATE = 26
    K_COLOR = 27
    K_CURSOR = 28
    K_END_STMT = 24
    K_OPTION = 29
    K_EXIT_LOOP = 30
    K_CONTINUE_LOOP = 31

    X_LIT_INT = 0
    X_LIT_FLOAT = 1
    X_LIT_STR = 2
    X_LIT_BOOL = 3
    X_VARIABLE = 4
    X_BINARY = 5
    X_UNARY = 6
    X_CALL = 7
    X_INDEX = 8
    X_ARRAY_LIT = 9
    X_MAP_LIT = 10
    X_MEMBER = 11
    X_LAMBDA = 12
    X_PIPE = 13
    X_PLACEHOLDER = 14

    opCount = 0
    OP_ADD("->", "ARROW")
    OP_ADD("|>", "PIPE")
    OP_ADD("<=", "LE")
    OP_ADD("<>", "NE")
    OP_ADD(">=", "GE")
    OP_ADD("+", "PLUS")
    OP_ADD("-", "MINUS")
    OP_ADD("*", "STAR")
    OP_ADD("/", "SLASH")
    ' One backslash. jdBasic string literals are raw, so this is not an escape.
    OP_ADD("\", "BACKSLASH")
    OP_ADD("^", "CARET")
    OP_ADD("(", "LPAREN")
    OP_ADD(")", "RPAREN")
    OP_ADD("[", "LBRACKET")
    OP_ADD("]", "RBRACKET")
    OP_ADD(",", "COMMA")
    OP_ADD(":", "COLON")
    OP_ADD(";", "SEMICOLON")
    OP_ADD(".", "DOT")
    OP_ADD("@", "AT")
    OP_ADD("?", "PLACEHOLDER")
    OP_ADD("{", "LBRACE")
    OP_ADD("}", "RBRACE")
    OP_ADD("<", "LT")
    OP_ADD(">", "GT")
    OP_ADD("=", "ASSIGN")
ENDSUB

' ── Lexer ───────────────────────────────────────────────────────────────────
'
' Taken verbatim from selfhost/jdbc_lex.jdb, which is the copy the token
' comparison runs against. jdBasic-0 has no include, and modules do not carry
' their state across an IMPORT here, so the scanner lives in both files. A
' drift between them shows up as a different tree in the AST comparison.
' ── Character tests ────────────────────────────────────────────────────────

FUNC IS_DIGIT_C(c AS INTEGER) AS INTEGER
    IF c >= 48 AND c <= 57 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_ALPHA_C(c AS INTEGER) AS INTEGER
    IF c >= 65 AND c <= 90 THEN RETURN 1
    IF c >= 97 AND c <= 122 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_ALNUM_C(c AS INTEGER) AS INTEGER
    IF IS_DIGIT_C(c) = 1 THEN RETURN 1
    IF IS_ALPHA_C(c) = 1 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_HEX_C(c AS INTEGER) AS INTEGER
    IF IS_DIGIT_C(c) = 1 THEN RETURN 1
    IF c >= 65 AND c <= 70 THEN RETURN 1
    IF c >= 97 AND c <= 102 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC HEX_VAL(c AS INTEGER) AS INTEGER
    IF c >= 48 AND c <= 57 THEN RETURN c - 48
    IF c >= 65 AND c <= 70 THEN RETURN c - 55
    RETURN c - 87
ENDFUNC

' ── Cursor ─────────────────────────────────────────────────────────────────

FUNC PEEKCH() AS INTEGER
    IF pos >= LEN(src) THEN RETURN 0
    RETURN BYTEAT(src, pos)
ENDFUNC

FUNC PEEKNEXT() AS INTEGER
    IF pos + 1 >= LEN(src) THEN RETURN 0
    RETURN BYTEAT(src, pos + 1)
ENDFUNC

FUNC ADVANCE() AS INTEGER
    DIM c AS INTEGER
    c = CINT(BYTEAT(src, pos))
    pos = pos + 1
    IF c = 10 THEN
        lineNo = lineNo + 1
        colNo = 1
    ELSE
        colNo = colNo + 1
    ENDIF
    RETURN c
ENDFUNC

' The line and column recorded are the ones current *after* the token text has
' been consumed, which is what the reference lexer does.
SUB ADDTOK(ty AS INTEGER, val AS STRING)
    IF tkCount >= MAX_TOKENS THEN
        lexError = "too many tokens"
        RETURN
    ENDIF
    tkType[tkCount] = ty
    tkLine[tkCount] = lineNo
    tkCol[tkCount] = colNo
    tkVal[tkCount] = val
    tkCount = tkCount + 1
ENDSUB

' ── Tables ─────────────────────────────────────────────────────────────────

SUB KW_ADD(w AS STRING, t AS INTEGER)
    kwWord[kwCount] = w
    kwType[kwCount] = t
    kwCount = kwCount + 1
ENDSUB

FUNC KW_LOOKUP(w AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO kwCount - 1
        IF kwWord[i] = w THEN RETURN CINT(kwType[i])
    NEXT i
    RETURN -1
ENDFUNC

FUNC TOK_BY_NAME(n AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO tokNameCount - 1
        IF tokName[i] = n THEN RETURN i
    NEXT i
    PRINT "LEX SETUP: unknown token name "; n
    RETURN -1
ENDFUNC

SUB OP_ADD(w AS STRING, n AS STRING)
    opName[opCount] = w
    opType[opCount] = CINT(TOK_BY_NAME(n))
    opCount = opCount + 1
ENDSUB

' ── Scanners ───────────────────────────────────────────────────────────────

' Raw literals: a backslash is an ordinary character and a doubled quote is
' how a quote gets in, so this one is built up rather than sliced out.
SUB READ_STRING()
    DIM r AS STRING
    DIM c AS INTEGER
    DIM discard AS INTEGER

    discard = CINT(ADVANCE())
    r = ""
    DO
        IF pos >= LEN(src) THEN EXITDO
        c = CINT(PEEKCH())
        IF c = 34 THEN
            IF pos + 1 < LEN(src) ANDALSO PEEKNEXT() = 34 THEN
                r = r + CHR$(34)
                discard = CINT(ADVANCE())
                discard = CINT(ADVANCE())
            ELSE
                EXITDO
            ENDIF
        ELSE
            r = r + CHR$(CINT(ADVANCE()))
        ENDIF
    LOOP
    IF pos < LEN(src) THEN discard = CINT(ADVANCE())
    ADDTOK(T_STRING_LIT, r)
ENDSUB

SUB READ_NUMBER()
    DIM start AS INTEGER
    DIM isFloat AS INTEGER
    DIM c AS INTEGER
    DIM discard AS INTEGER

    start = pos
    isFloat = 0
    DO
        IF pos >= LEN(src) THEN EXITDO
        c = CINT(PEEKCH())
        IF IS_DIGIT_C(c) = 0 AND c <> 46 THEN EXITDO
        IF c = 46 THEN
            IF isFloat = 1 THEN EXITDO
            isFloat = 1
        ENDIF
        discard = CINT(ADVANCE())
    LOOP

    IF pos < LEN(src) THEN
        c = CINT(PEEKCH())
        IF c = 101 OR c = 69 THEN
            isFloat = 1
            discard = CINT(ADVANCE())
            IF pos < LEN(src) THEN
                c = CINT(PEEKCH())
                IF c = 43 OR c = 45 THEN discard = CINT(ADVANCE())
            ENDIF
            DO
                IF pos >= LEN(src) THEN EXITDO
                IF IS_DIGIT_C(CINT(PEEKCH())) = 0 THEN EXITDO
                discard = CINT(ADVANCE())
            LOOP
        ENDIF
    ENDIF

    IF isFloat = 1 THEN
        ADDTOK(T_FLOAT_LIT, MID$(src, start, pos - start))
    ELSE
        ADDTOK(T_INTEGER_LIT, MID$(src, start, pos - start))
    ENDIF
ENDSUB

SUB SKIP_COMMENT()
    DIM discard AS INTEGER
    DO
        IF pos >= LEN(src) THEN RETURN
        IF PEEKCH() = 10 THEN RETURN
        discard = CINT(ADVANCE())
    LOOP
ENDSUB

SUB READ_IDENT()
    DIM start AS INTEGER
    DIM id AS STRING
    DIM up AS STRING
    DIM t AS INTEGER
    DIM discard AS INTEGER

    start = pos
    DO
        IF pos >= LEN(src) THEN EXITDO
        IF IS_ALNUM_C(CINT(PEEKCH())) = 0 AND PEEKCH() <> 95 THEN EXITDO
        discard = CINT(ADVANCE())
    LOOP
    ' A trailing $ belongs to the name: GETENV$, DATE$ and friends.
    IF pos < LEN(src) THEN
        IF PEEKCH() = 36 THEN discard = CINT(ADVANCE())
    ENDIF

    id = MID$(src, start, pos - start)
    up = UCASE$(id)

    IF up = "REM" THEN
        SKIP_COMMENT()
        ADDTOK(T_NEWLINE, "\n")
        RETURN
    ENDIF

    t = CINT(KW_LOOKUP(up))
    IF t >= 0 THEN
        ADDTOK(t, up)
    ELSE
        ADDTOK(T_IDENTIFIER, up)
    ENDIF
ENDSUB

' $FF and %0101 both become an INTEGER_LIT carrying the decimal text.
SUB READ_RADIX(base AS INTEGER)
    DIM v AS DOUBLE
    DIM c AS INTEGER
    DIM discard AS INTEGER

    discard = CINT(ADVANCE())
    v = 0
    DO
        IF pos >= LEN(src) THEN EXITDO
        c = CINT(PEEKCH())
        IF base = 16 THEN
            IF IS_HEX_C(c) = 0 THEN EXITDO
            v = v * 16 + HEX_VAL(c)
        ELSE
            IF c <> 48 AND c <> 49 THEN EXITDO
            v = v * 2 + (c - 48)
        ENDIF
        discard = CINT(ADVANCE())
    LOOP
    ADDTOK(T_INTEGER_LIT, STR$(v))
ENDSUB

' ── The loop ───────────────────────────────────────────────────────────────

SUB TOKENIZE()
    DIM c AS INTEGER
    DIM lastWasNewline AS INTEGER
    DIM i AS INTEGER
    DIM matched AS INTEGER
    DIM two AS STRING
    DIM one AS STRING
    DIM discard AS INTEGER

    pos = 0
    lineNo = 1
    colNo = 1
    tkCount = 0
    lastWasNewline = 1

    DO
        IF pos >= LEN(src) THEN EXITDO
        IF lexError <> "" THEN RETURN

        ' Spaces, tabs and carriage returns carry no token.
        DO
            IF pos >= LEN(src) THEN EXITDO
            c = CINT(PEEKCH())
            IF c <> 32 AND c <> 9 AND c <> 13 THEN EXITDO
            discard = CINT(ADVANCE())
        LOOP
        IF pos >= LEN(src) THEN EXITDO

        c = CINT(PEEKCH())

        IF c = 10 THEN
            discard = CINT(ADVANCE())
            ' A trailing _ joins this line with the next, so it and the break
            ' both disappear.
            IF tkCount > 0 ANDALSO tkType[tkCount - 1] = T_IDENTIFIER ANDALSO tkVal[tkCount - 1] = "_" THEN
                tkCount = tkCount - 1
                CONTINUEDO
            ENDIF
            IF lastWasNewline = 0 THEN
                ADDTOK(T_NEWLINE, "\n")
                lastWasNewline = 1
            ENDIF
            CONTINUEDO
        ENDIF

        lastWasNewline = 0

        IF c = 39 THEN
            SKIP_COMMENT()
            CONTINUEDO
        ENDIF

        IF c = 34 THEN
            READ_STRING()
            CONTINUEDO
        ENDIF

        IF c = 36 AND IS_HEX_C(CINT(PEEKNEXT())) = 1 THEN
            READ_RADIX(16)
            CONTINUEDO
        ENDIF

        IF c = 37 AND (PEEKNEXT() = 48 OR PEEKNEXT() = 49) THEN
            READ_RADIX(2)
            CONTINUEDO
        ENDIF

        IF IS_DIGIT_C(c) = 1 OR (c = 46 AND IS_DIGIT_C(CINT(PEEKNEXT())) = 1) THEN
            READ_NUMBER()
            CONTINUEDO
        ENDIF

        IF IS_ALPHA_C(c) = 1 OR c = 95 THEN
            READ_IDENT()
            CONTINUEDO
        ENDIF

        ' Operators, longest first so <= wins over <.
        two = MID$(src, pos, 2)
        one = MID$(src, pos, 1)
        matched = 0
        FOR i = 0 TO opCount - 1
            IF LEN(opName[i]) = 2 AND opName[i] = two THEN
                discard = CINT(ADVANCE())
                discard = CINT(ADVANCE())
                ADDTOK(CINT(opType[i]), opName[i])
                matched = 1
                EXITFOR
            ENDIF
        NEXT i
        IF matched = 0 THEN
            FOR i = 0 TO opCount - 1
                IF LEN(opName[i]) = 1 AND opName[i] = one THEN
                    discard = CINT(ADVANCE())
                    ADDTOK(CINT(opType[i]), opName[i])
                    matched = 1
                    EXITFOR
                ENDIF
            NEXT i
        ENDIF
        IF matched = 0 THEN
            lexError = "Unexpected character " + one + " at line " + STR$(lineNo)
            RETURN
        ENDIF
    LOOP

    IF lastWasNewline = 0 THEN ADDTOK(T_NEWLINE, "\n")
    ADDTOK(T_EOF, "")
ENDSUB

' ── Node builders ──────────────────────────────────────────────────────────

FUNC NEW_EXPR(k AS INTEGER, ln AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    i = exCount
    exKind[i] = k
    exLine[i] = ln
    exInt[i] = 0
    exFloat[i] = 0
    exStr[i] = ""
    exOp[i] = 0
    exBool[i] = 0
    exKeyAt[i] = 0
    exKeyN[i] = 0
    exLpAt[i] = 0
    exLpN[i] = 0
    exLcAt[i] = 0
    exLcN[i] = 0
    exFuncRef[i] = 0
    exFn[i] = ""
    exLeft[i] = -1
    exRight[i] = -1
    exArgAt[i] = 0
    exArgN[i] = 0
    exCount = exCount + 1
    RETURN i
ENDFUNC

FUNC NEW_STMT(k AS INTEGER, ln AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    i = stCount
    stKind[i] = k
    stLine[i] = ln
    stVar[i] = ""
    stVType[i] = 0
    stEType[i] = 0
    stConst[i] = 0
    stLabel[i] = ""
    stFunc[i] = ""
    stRType[i] = 0
    stAsync[i] = 0
    stExpr[i] = -1
    stCond[i] = -1
    stEnd[i] = -1
    stStep[i] = -1
    stTop[i] = 0
    stUntil[i] = 0
    stNoNl[i] = 0
    stPrAt[i] = 0
    stPrN[i] = 0
    stSepAt[i] = 0
    stSepN[i] = 0
    stIxAt[i] = 0
    stIxN[i] = 0
    stTmAt[i] = 0
    stTmN[i] = 0
    stEmAt[i] = 0
    stEmN[i] = 0
    stStatic[i] = 0
    stParAt[i] = 0
    stParN[i] = 0
    stBodyAt[i] = 0
    stCatchAt[i] = 0
    stCatchN[i] = 0
    stFinAt[i] = 0
    stFinN[i] = 0
    stBodyN[i] = 0
    stBrAt[i] = 0
    stBrN[i] = 0
    stCount = stCount + 1
    RETURN i
ENDFUNC

' ── Cursor over the token stream ───────────────────────────────────────────

FUNC TT() AS INTEGER
    IF cur >= tkCount THEN RETURN T_EOF
    RETURN CINT(tkType[cur])
ENDFUNC

FUNC TT_AT(k AS INTEGER) AS INTEGER
    IF cur + k >= tkCount THEN RETURN T_EOF
    RETURN CINT(tkType[cur + k])
ENDFUNC

FUNC TV$() AS STRING
    IF cur >= tkCount THEN RETURN ""
    RETURN tkVal[cur]
ENDFUNC

FUNC TL() AS INTEGER
    IF cur >= tkCount THEN RETURN 0
    RETURN CINT(tkLine[cur])
ENDFUNC

SUB EAT()
    cur = cur + 1
ENDSUB

FUNC IS_ONE_OF(t AS INTEGER, list AS ARRAY, n AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF list[i] = t THEN RETURN 1
    NEXT i
    RETURN 0
ENDFUNC

SUB FAIL(msg AS STRING)
    IF parseError = "" THEN parseError = msg + " at line " + STR$(TL())
ENDSUB

SUB SKIP_SEPS()
    DO
        IF TT() = T_NEWLINE OR TT() = TT_COLON THEN
            EAT()
        ELSE
            RETURN
        ENDIF
    LOOP
ENDSUB

' ── Expressions ────────────────────────────────────────────────────────────


FUNC P_PRIMARY() AS INTEGER
    DIM ln AS INTEGER
    DIM nd AS INTEGER
    DIM nm AS STRING
    DIM a AS INTEGER
    DIM start AS INTEGER
    DIM n AS INTEGER
    DIM tmp[MAX_LOCAL]
    DIM tmpK[MAX_LOCAL] AS STRING
    DIM tmpC[MAX_LOCAL] AS STRING
    DIM nCap AS INTEGER
    DIM i AS INTEGER

    ln = CINT(TL())

    IF TT() = T_INTEGER_LIT THEN
        nd = CINT(NEW_EXPR(X_LIT_INT, ln))
        exInt[nd] = VAL(TV$())
        EAT()
        RETURN nd
    ENDIF
    IF TT() = T_FLOAT_LIT THEN
        nd = CINT(NEW_EXPR(X_LIT_FLOAT, ln))
        exFloat[nd] = VAL(TV$())
        EAT()
        RETURN nd
    ENDIF
    IF TT() = T_STRING_LIT THEN
        nd = CINT(NEW_EXPR(X_LIT_STR, ln))
        exStr[nd] = TV$()
        EAT()
        RETURN nd
    ENDIF
    IF TT() = TT_TRUE OR TT() = TT_FALSE THEN
        nd = CINT(NEW_EXPR(X_LIT_BOOL, ln))
        IF TT() = TT_TRUE THEN exBool[nd] = 1
        EAT()
        RETURN nd
    ENDIF

    IF TT() = TT_LPAREN THEN
        EAT()
        nd = CINT(P_EXPR())
        IF TT() <> TT_RPAREN THEN
            FAIL("expected )")
            RETURN nd
        ENDIF
        EAT()
        RETURN nd
    ENDIF

    ' [a, b, c] is an array literal; its elements are the arguments.
    IF TT() = TT_LBRACKET THEN
        EAT()
        n = 0
        DO
            IF TT() = TT_RBRACKET THEN EXITDO
            IF TT() = T_EOF THEN
                FAIL("expected ]")
                EXITDO
            ENDIF
            IF parseError <> "" THEN EXITDO
            IF n >= MAX_LOCAL THEN
                FAIL("too many items in one list")
                EXITDO
            ENDIF
            tmp[n] = P_EXPR()
            n = n + 1
            IF TT() = TT_COMMA THEN EAT()
        LOOP
        IF TT() = TT_RBRACKET THEN EAT()
        nd = CINT(NEW_EXPR(X_ARRAY_LIT, ln))
        start = argN
        FOR i = 0 TO n - 1
            argBuf[argN] = tmp[i]
            argN = argN + 1
        NEXT i
        exArgAt[nd] = start
        exArgN[nd] = n
        RETURN nd
    ENDIF

    ' AWAIT reads as a prefix and is a call on the thing it waits for.
    IF TT() = KT_AWAIT THEN
        EAT()
        nd = CINT(NEW_EXPR(X_CALL, ln))
        exFn[nd] = "AWAIT"
        start = argN
        argBuf[argN] = P_UNARY()
        argN = argN + 1
        exArgAt[nd] = start
        exArgN[nd] = 1
        RETURN nd
    ENDIF

    ' ? stands where a piped value will land.
    IF TT() = TT_PLACEHOLDER THEN
        nd = CINT(NEW_EXPR(X_PLACEHOLDER, ln))
        EAT()
        RETURN nd
    ENDIF

    ' LAMBDA a, b -> expr. The parameters sit beside the node and the body
    ' hangs under it.
    IF TT() = KT_LAMBDA THEN
        EAT()

        ' USE(a, b) names what the lambda takes with it.
        nCap = 0
        IF TV$() = "USE" ANDALSO TT_AT(1) = TT_LPAREN THEN
            EAT()
            EAT()
            DO
                IF parseError <> "" THEN EXITDO
                IF TT() = TT_RPAREN OR TT() = T_EOF THEN EXITDO
                IF TT() = TT_COMMA THEN
                    EAT()
                    CONTINUEDO
                ENDIF
                IF nCap >= MAX_LOCAL THEN
                    FAIL("too many captures")
                    EXITDO
                ENDIF
                tmpC[nCap] = TV$()
                nCap = nCap + 1
                EAT()
            LOOP
            IF TT() = TT_RPAREN THEN EAT()
        ENDIF

        n = 0
        DO
            IF parseError <> "" THEN EXITDO
            IF TT() = TT_ARROW OR TT() = T_NEWLINE OR TT() = T_EOF THEN EXITDO
            IF n >= MAX_LOCAL THEN
                FAIL("too many parameters")
                EXITDO
            ENDIF
            tmpK[n] = TV$()
            n = n + 1
            EAT()
            IF TT() <> TT_COMMA THEN EXITDO
            EAT()
        LOOP
        IF TT() = TT_ARROW THEN EAT()

        nd = CINT(NEW_EXPR(X_LAMBDA, ln))
        start = lpN
        FOR i = 0 TO n - 1
            lpBuf[lpN] = tmpK[i]
            lpN = lpN + 1
        NEXT i
        exLpAt[nd] = start
        exLpN[nd] = n
        start = lcN
        FOR i = 0 TO nCap - 1
            lcBuf[lcN] = tmpC[i]
            lcN = lcN + 1
        NEXT i
        exLcAt[nd] = start
        exLcN[nd] = nCap
        exLeft[nd] = P_EXPR()
        RETURN nd
    ENDIF

    ' { "k": v, ... } is a map literal: the keys sit beside the node, the
    ' values are its arguments.
    IF TT() = TT_LBRACE THEN
        EAT()
        n = 0
        DO
            IF TT() = TT_RBRACE THEN EXITDO
            IF TT() = T_EOF THEN
                FAIL("expected }")
                EXITDO
            ENDIF
            IF parseError <> "" THEN EXITDO
            IF n >= MAX_LOCAL THEN
                FAIL("too many items in one list")
                EXITDO
            ENDIF
            IF TT() = T_NEWLINE THEN
                EAT()
                CONTINUEDO
            ENDIF
            tmpK[n] = TV$()
            EAT()
            IF TT() = TT_COLON THEN EAT()
            tmp[n] = P_EXPR()
            n = n + 1
            IF TT() = TT_COMMA THEN EAT()
        LOOP
        IF TT() = TT_RBRACE THEN EAT()

        nd = CINT(NEW_EXPR(X_MAP_LIT, ln))
        start = keyN
        FOR i = 0 TO n - 1
            keyBuf[keyN] = tmpK[i]
            keyN = keyN + 1
        NEXT i
        exKeyAt[nd] = start
        exKeyN[nd] = n
        start = argN
        FOR i = 0 TO n - 1
            argBuf[argN] = tmp[i]
            argN = argN + 1
        NEXT i
        exArgAt[nd] = start
        exArgN[nd] = n
        RETURN nd
    ENDIF

    ' A name is a call when a parenthesis follows it, otherwise a variable.
    ' A dotted name is one identifier as far as the tree is concerned.
    IF TT() = T_IDENTIFIER THEN
        nm = TV$()
        EAT()
        DO
            IF TT() <> TT_DOT THEN EXITDO
            EAT()
            nm = nm + "." + TV$()
            EAT()
        LOOP
        ' name@ is a reference to the routine, carried as its name.
        IF TT() = TT_AT THEN
            EAT()
            nd = CINT(NEW_EXPR(X_LIT_STR, ln))
            exStr[nd] = nm
            exFuncRef[nd] = 1
            RETURN nd
        ENDIF

        IF TT() = TT_LPAREN THEN
            EAT()
            n = 0
            DO
                IF TT() = TT_RPAREN THEN EXITDO
                IF TT() = T_EOF THEN
                    FAIL("expected )")
                    EXITDO
                ENDIF
                IF parseError <> "" THEN EXITDO
                IF n >= MAX_LOCAL THEN
                    FAIL("too many items in one list")
                    EXITDO
                ENDIF
                tmp[n] = P_EXPR()
                n = n + 1
                IF TT() = TT_COMMA THEN EAT()
            LOOP
            IF TT() = TT_RPAREN THEN EAT()
            nd = CINT(NEW_EXPR(X_CALL, ln))
            exFn[nd] = nm
            start = argN
            FOR i = 0 TO n - 1
                argBuf[argN] = tmp[i]
                argN = argN + 1
            NEXT i
            exArgAt[nd] = start
            exArgN[nd] = n
            RETURN nd
        ENDIF
        nd = CINT(NEW_EXPR(X_VARIABLE, ln))
        exStr[nd] = nm
        RETURN nd
    ENDIF

    FAIL("unexpected token " + TV$())
    RETURN CINT(NEW_EXPR(X_LIT_INT, ln))
ENDFUNC

' Indexing binds tighter than any operator. C[a, b] is C[a][b].
FUNC P_POSTFIX(lhs AS INTEGER) AS INTEGER
    DIM ln AS INTEGER
    DIM idx AS INTEGER
    DIM nd AS INTEGER
    DIM node AS INTEGER

    node = lhs
    DO
        ' m{"k"} reads a map the way a[i] reads an array.
        IF TT() = TT_LBRACE THEN
            ln = CINT(TL())
            EAT()
            idx = CINT(P_EXPR())
            IF TT() = TT_RBRACE THEN
                EAT()
            ELSE
                FAIL("expected }")
            ENDIF
            nd = CINT(NEW_EXPR(X_INDEX, ln))
            exLeft[nd] = node
            exRight[nd] = idx
            node = nd
            CONTINUEDO
        ENDIF
        IF TT() <> TT_LBRACKET THEN RETURN node
        ln = CINT(TL())
        EAT()
        idx = CINT(P_EXPR())
        DO
            IF TT() <> TT_COMMA THEN EXITDO
            EAT()
            nd = CINT(NEW_EXPR(X_INDEX, ln))
            exLeft[nd] = node
            exRight[nd] = idx
            node = nd
            idx = CINT(P_EXPR())
        LOOP
        IF TT() = TT_RBRACKET THEN
            EAT()
        ELSE
            FAIL("expected ]")
        ENDIF
        nd = CINT(NEW_EXPR(X_INDEX, ln))
        exLeft[nd] = node
        exRight[nd] = idx
        node = nd
    LOOP
ENDFUNC

FUNC P_UNARY() AS INTEGER
    DIM ln AS INTEGER
    DIM nd AS INTEGER
    IF TT() = TT_MINUS OR TT() = TT_BNOT THEN
        ln = CINT(TL())
        nd = CINT(NEW_EXPR(X_UNARY, ln))
        exOp[nd] = TT()
        EAT()
        exRight[nd] = P_UNARY()
        RETURN nd
    ENDIF
    RETURN CINT(P_POSTFIX(CINT(P_PRIMARY())))
ENDFUNC

FUNC P_POW() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    lhs = CINT(P_UNARY())
    DO
        IF TT() <> TT_CARET THEN RETURN lhs
        ln = CINT(TL())
        EAT()
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = TT_CARET
        exLeft[nd] = lhs
        exRight[nd] = P_UNARY()
        lhs = nd
    LOOP
ENDFUNC

FUNC P_MUL() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM op AS INTEGER
    lhs = CINT(P_POW())
    DO
        IF IS_ONE_OF(TT(), mulOps, mulN) = 0 THEN RETURN lhs
        ln = CINT(TL())
        op = TT()
        EAT()
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = op
        exLeft[nd] = lhs
        exRight[nd] = P_POW()
        lhs = nd
    LOOP
ENDFUNC

FUNC P_ADD() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM op AS INTEGER
    lhs = CINT(P_MUL())
    DO
        IF IS_ONE_OF(TT(), addOps, addN) = 0 THEN RETURN lhs
        ln = CINT(TL())
        op = TT()
        EAT()
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = op
        exLeft[nd] = lhs
        exRight[nd] = P_MUL()
        lhs = nd
    LOOP
ENDFUNC

' = doubles as equality here, which is why assignment is decided by the
' statement parser before the expression parser ever sees the line.
' Classic BASIC reads `IF x NOT y` as `x <> y`. Only a NOT with a value after
' it is the infix one; NOT before THEN or a line end is the prefix form that
' belongs to the level above.
FUNC IS_INFIX_NOT() AS INTEGER
    DIM nt AS INTEGER
    IF TT() <> TT_NOT THEN RETURN 0
    nt = CINT(TT_AT(1))
    IF nt = KT_THEN OR nt = T_NEWLINE OR nt = T_EOF THEN RETURN 0
    IF nt = TT_AND OR nt = TT_OR THEN RETURN 0
    RETURN 1
ENDFUNC

' The shifts bind tighter than a comparison and looser than a sum.
FUNC P_SHIFT() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM op AS INTEGER
    lhs = CINT(P_ADD())
    DO
        IF TT() <> TT_SHL ANDALSO TT() <> TT_SHR THEN RETURN lhs
        ln = CINT(TL())
        op = TT()
        EAT()
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = op
        exLeft[nd] = lhs
        exRight[nd] = P_ADD()
        lhs = nd
    LOOP
ENDFUNC

FUNC P_CMP() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM op AS INTEGER
    lhs = CINT(P_SHIFT())
    DO
        IF IS_ONE_OF(TT(), cmpOps, cmpN) = 0 ANDALSO IS_INFIX_NOT() = 0 THEN RETURN lhs
        ln = CINT(TL())
        op = TT()
        IF op = TT_NOT THEN op = TOK_NE
        EAT()
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = op
        exLeft[nd] = lhs
        exRight[nd] = P_SHIFT()
        lhs = nd
    LOOP
ENDFUNC

' NOT binds looser than the bitwise operators and tighter than AND.
FUNC P_NOT() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    IF TT() <> TT_NOT THEN RETURN CINT(P_BOR())
    ln = CINT(TL())
    nd = CINT(NEW_EXPR(X_UNARY, ln))
    exOp[nd] = TT()
    EAT()
    exRight[nd] = P_NOT()
    RETURN nd
ENDFUNC

' The bitwise three, each looser than the one below it, and all tighter than
' a comparison.
FUNC P_BOR() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    lhs = CINT(P_BXOR())
    DO
        IF TT() <> TT_BOR THEN RETURN lhs
        ln = CINT(TL())
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = TT()
        EAT()
        exLeft[nd] = lhs
        exRight[nd] = P_BXOR()
        lhs = nd
    LOOP
ENDFUNC

FUNC P_BXOR() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    lhs = CINT(P_BAND())
    DO
        ' Both spellings mean the same operation, and the tree records one.
        IF TT() <> TT_XOR ANDALSO TT() <> TT_BXOR THEN RETURN lhs
        ln = CINT(TL())
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = TT_XOR
        EAT()
        exLeft[nd] = lhs
        exRight[nd] = P_BAND()
        lhs = nd
    LOOP
ENDFUNC

FUNC P_BAND() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    lhs = CINT(P_CMP())
    DO
        IF TT() <> TT_BAND THEN RETURN lhs
        ln = CINT(TL())
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = TT()
        EAT()
        exLeft[nd] = lhs
        exRight[nd] = P_CMP()
        lhs = nd
    LOOP
ENDFUNC

FUNC P_AND() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM op AS INTEGER
    lhs = CINT(P_NOT())
    DO
        IF TT() <> TT_AND ANDALSO TT() <> TT_ANDALSO THEN RETURN lhs
        ln = CINT(TL())
        op = TT()
        EAT()
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = op
        exLeft[nd] = lhs
        exRight[nd] = P_NOT()
        lhs = nd
    LOOP
ENDFUNC

' The pipe binds looser than anything else, so it sits at the top.
FUNC P_EXPR() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    lhs = CINT(P_OR())
    DO
        IF TT() <> TT_PIPE THEN RETURN lhs
        ln = CINT(TL())
        EAT()
        nd = CINT(NEW_EXPR(X_PIPE, ln))
        exLeft[nd] = lhs
        exRight[nd] = P_OR()
        lhs = nd
    LOOP
ENDFUNC

FUNC P_OR() AS INTEGER
    DIM lhs AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM op AS INTEGER
    lhs = CINT(P_AND())
    DO
        IF TT() <> TT_OR ANDALSO TT() <> TT_ORELSE THEN RETURN lhs
        ln = CINT(TL())
        op = TT()
        EAT()
        nd = CINT(NEW_EXPR(X_BINARY, ln))
        exOp[nd] = op
        exLeft[nd] = lhs
        exRight[nd] = P_AND()
        lhs = nd
    LOOP
ENDFUNC

' ── Statement keywords, all looked up by name ──────────────────────────────

DIM KT_OPTION AS INTEGER
DIM KT_CONST AS INTEGER
DIM KT_DIM AS INTEGER
DIM KT_PRINT AS INTEGER
DIM KT_IF AS INTEGER
DIM KT_THEN AS INTEGER
DIM KT_ELSE AS INTEGER
DIM KT_ENDIF AS INTEGER
DIM KT_DO AS INTEGER
DIM KT_LOOP AS INTEGER
DIM KT_WHILE AS INTEGER
DIM KT_UNTIL AS INTEGER
DIM KT_FOR AS INTEGER
DIM KT_TO AS INTEGER
DIM KT_STEP AS INTEGER
DIM KT_LET AS INTEGER
DIM KT_EACH AS INTEGER
DIM KT_IN AS INTEGER
DIM KT_TYPE AS INTEGER
DIM KT_ENDTYPE AS INTEGER
DIM KT_TRY AS INTEGER
DIM KT_CATCH AS INTEGER
DIM KT_FINALLY AS INTEGER
DIM KT_ENDTRY AS INTEGER
DIM KT_LAMBDA AS INTEGER
DIM KT_ENUM AS INTEGER
DIM KT_ENDENUM AS INTEGER
DIM KT_STATIC AS INTEGER
DIM KT_AWAIT AS INTEGER
DIM KT_SWITCH AS INTEGER
DIM KT_CASE AS INTEGER
DIM KT_DEFAULT AS INTEGER
DIM KT_ENDSWITCH AS INTEGER
DIM KT_ELSEIF AS INTEGER
DIM KT_ASYNC AS INTEGER
DIM KT_ON AS INTEGER
DIM KT_CALL AS INTEGER
DIM TT_IN AS INTEGER
DIM TT_BAND AS INTEGER
DIM TT_BOR AS INTEGER
DIM TT_BXOR AS INTEGER
DIM TT_XOR AS INTEGER
DIM TT_SHL AS INTEGER
DIM TT_SHR AS INTEGER
DIM KT_EXPORT AS INTEGER
DIM KT_MODULE AS INTEGER
DIM KT_SLEEP AS INTEGER
DIM KT_STOP AS INTEGER
DIM KT_CLS AS INTEGER
DIM KT_SCREEN AS INTEGER
DIM KT_LOCATE AS INTEGER
DIM KT_COLOR AS INTEGER
DIM KT_CURSOR AS INTEGER
DIM KT_THROW AS INTEGER
DIM KT_DECLARE AS INTEGER
DIM KT_NEXT AS INTEGER
DIM KT_FUNC AS INTEGER
DIM KT_ENDFUNC AS INTEGER
DIM KT_SUB AS INTEGER
DIM KT_ENDSUB AS INTEGER
DIM KT_RETURN AS INTEGER
DIM KT_END AS INTEGER
DIM KT_EXITDO AS INTEGER
DIM KT_EXITFOR AS INTEGER
DIM KT_EXITFUNC AS INTEGER
DIM KT_CONTDO AS INTEGER
DIM KT_CONTFOR AS INTEGER
DIM KT_AS AS INTEGER

DIM vtypeTok[32]
DIM vtypeVal[32]
DIM vtypeN AS INTEGER

DIM V_ARRAY AS INTEGER

SUB LOAD_STMT_TABLES()
    DIM i AS INTEGER
    DIM t AS INTEGER

    KT_OPTION = CINT(TOK_BY_NAME("OPTION_KW"))
    KT_CONST = CINT(TOK_BY_NAME("CONST_KW"))
    KT_DIM = CINT(TOK_BY_NAME("DIM"))
    KT_PRINT = CINT(TOK_BY_NAME("PRINT"))
    KT_IF = CINT(TOK_BY_NAME("IF"))
    KT_THEN = CINT(TOK_BY_NAME("THEN"))
    KT_ELSE = CINT(TOK_BY_NAME("ELSE"))
    KT_ENDIF = CINT(TOK_BY_NAME("ENDIF_KW"))
    KT_DO = CINT(TOK_BY_NAME("DO"))
    KT_LOOP = CINT(TOK_BY_NAME("LOOP"))
    KT_WHILE = CINT(TOK_BY_NAME("WHILE"))
    KT_UNTIL = CINT(TOK_BY_NAME("UNTIL"))
    KT_FOR = CINT(TOK_BY_NAME("FOR"))
    KT_TO = CINT(TOK_BY_NAME("TO"))
    KT_STEP = CINT(TOK_BY_NAME("STEP"))
    KT_NEXT = CINT(TOK_BY_NAME("NEXT"))
    KT_LET = CINT(TOK_BY_NAME("LET"))
    KT_EACH = CINT(TOK_BY_NAME("EACH"))
    KT_IN = CINT(TOK_BY_NAME("IN"))
    KT_TYPE = CINT(TOK_BY_NAME("TYPE_KW"))
    KT_ENDTYPE = CINT(TOK_BY_NAME("ENDTYPE"))
    KT_TRY = CINT(TOK_BY_NAME("TRY"))
    KT_CATCH = CINT(TOK_BY_NAME("CATCH"))
    KT_FINALLY = CINT(TOK_BY_NAME("FINALLY"))
    KT_ENDTRY = CINT(TOK_BY_NAME("ENDTRY"))
    KT_LAMBDA = CINT(TOK_BY_NAME("LAMBDA"))
    KT_ENUM = CINT(TOK_BY_NAME("ENUM"))
    KT_ENDENUM = CINT(TOK_BY_NAME("ENDENUM"))
    KT_STATIC = CINT(TOK_BY_NAME("STATIC_KW"))
    KT_AWAIT = CINT(TOK_BY_NAME("AWAIT_KW"))
    KT_SWITCH = CINT(TOK_BY_NAME("SWITCH"))
    KT_CASE = CINT(TOK_BY_NAME("CASE"))
    KT_DEFAULT = CINT(TOK_BY_NAME("DEFAULT"))
    KT_ENDSWITCH = CINT(TOK_BY_NAME("ENDSWITCH"))
    KT_ELSEIF = CINT(TOK_BY_NAME("ELSEIF"))
    KT_ASYNC = CINT(TOK_BY_NAME("ASYNC"))
    KT_ON = CINT(TOK_BY_NAME("ON_KW"))
    KT_CALL = CINT(TOK_BY_NAME("CALL"))
    TT_IN = CINT(TOK_BY_NAME("IN"))
    TT_BAND = CINT(TOK_BY_NAME("BAND"))
    TT_BOR = CINT(TOK_BY_NAME("BOR"))
    TT_BXOR = CINT(TOK_BY_NAME("BXOR"))
    TT_XOR = CINT(TOK_BY_NAME("XOR"))
    TT_SHL = CINT(TOK_BY_NAME("SHL"))
    TT_SHR = CINT(TOK_BY_NAME("SHR"))
    KT_EXPORT = CINT(TOK_BY_NAME("EXPORT_KW"))
    KT_MODULE = CINT(TOK_BY_NAME("MODULE_KW"))
    KT_SLEEP = CINT(TOK_BY_NAME("SLEEP_KW"))
    KT_STOP = CINT(TOK_BY_NAME("STOP_KW"))
    KT_CLS = CINT(TOK_BY_NAME("CLS_KW"))
    KT_SCREEN = CINT(TOK_BY_NAME("SCREEN_KW"))
    KT_LOCATE = CINT(TOK_BY_NAME("LOCATE_KW"))
    KT_COLOR = CINT(TOK_BY_NAME("COLOR_KW"))
    KT_CURSOR = CINT(TOK_BY_NAME("CURSOR_KW"))
    KT_THROW = CINT(TOK_BY_NAME("THROW_KW"))
    KT_DECLARE = CINT(TOK_BY_NAME("DECLARE_KW"))
    KT_FUNC = CINT(TOK_BY_NAME("FUNCTION"))
    KT_ENDFUNC = CINT(TOK_BY_NAME("ENDFUNC"))
    KT_SUB = CINT(TOK_BY_NAME("SUB"))
    KT_ENDSUB = CINT(TOK_BY_NAME("ENDSUB"))
    KT_RETURN = CINT(TOK_BY_NAME("RETURN"))
    KT_END = CINT(TOK_BY_NAME("END"))
    KT_EXITDO = CINT(TOK_BY_NAME("EXITDO"))
    KT_EXITFOR = CINT(TOK_BY_NAME("EXITFOR"))
    KT_EXITFUNC = CINT(TOK_BY_NAME("EXITFUNC"))
    KT_CONTDO = CINT(TOK_BY_NAME("CONTINUEDO"))
    KT_CONTFOR = CINT(TOK_BY_NAME("CONTINUEFOR"))
    KT_AS = CINT(TOK_BY_NAME("AS"))

    ' A type keyword is TY_ plus the VarType name, so the pairing is derived
    ' rather than written out.
    vtypeN = 0
    V_ARRAY = 13
    FOR i = 0 TO 14
        t = -1
        IF i = 1 THEN t = CINT(TOK_BY_NAME("TY_BOOLEAN"))
        IF i = 2 THEN t = CINT(TOK_BY_NAME("TY_BYTE"))
        IF i = 3 THEN t = CINT(TOK_BY_NAME("TY_CHAR"))
        IF i = 4 THEN t = CINT(TOK_BY_NAME("TY_INT16"))
        IF i = 5 THEN t = CINT(TOK_BY_NAME("TY_INT32"))
        IF i = 6 THEN t = CINT(TOK_BY_NAME("TY_INT64"))
        IF i = 7 THEN t = CINT(TOK_BY_NAME("TY_FLOAT16"))
        IF i = 8 THEN t = CINT(TOK_BY_NAME("TY_FLOAT32"))
        IF i = 9 THEN t = CINT(TOK_BY_NAME("TY_FLOAT64"))
        IF i = 10 THEN t = CINT(TOK_BY_NAME("TY_STRING"))
        IF i = 11 THEN t = CINT(TOK_BY_NAME("TY_OBJECT"))
        IF i = 12 THEN t = CINT(TOK_BY_NAME("TY_TENSOR"))
        IF i = 13 THEN t = CINT(TOK_BY_NAME("TY_ARRAY"))
        IF i = 14 THEN t = CINT(TOK_BY_NAME("TY_ANY"))
        IF t >= 0 THEN
            vtypeTok[vtypeN] = t
            vtypeVal[vtypeN] = i
            vtypeN = vtypeN + 1
        ENDIF
    NEXT i
ENDSUB

FUNC VTYPE_OF(t AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO vtypeN - 1
        IF vtypeTok[i] = t THEN RETURN CINT(vtypeVal[i])
    NEXT i
    RETURN -1
ENDFUNC

' ── Statements ─────────────────────────────────────────────────────────────


' Collects statements until one of the closing keywords, then copies them into
' the body arena. The scratch list is local so nested bodies do not interleave.
' endFollow is the keyword that has to follow END for it to close this block.
' Without that check a bare END, which is a statement of its own, ends every
' body it appears in.
FUNC P_BODY(stop1 AS INTEGER, stop2 AS INTEGER, stop3 AS INTEGER, endFollow AS INTEGER) AS INTEGER
    DIM tmp[MAX_BUF]
    DIM n AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER

    n = 0
    DO
        IF parseError <> "" THEN EXITDO
        SKIP_SEPS()
        IF TT() = T_EOF THEN EXITDO
        IF TT() = stop1 OR TT() = stop2 OR TT() = stop3 THEN EXITDO
        IF n >= MAX_BUF THEN
            FAIL("too many statements in one block")
            EXITDO
        ENDIF
        IF endFollow >= 0 ANDALSO TT() = KT_END ANDALSO TT_AT(1) = endFollow THEN EXITDO
        tmp[n] = P_STMT()
        n = n + 1
    LOOP

    start = bodyN
    FOR i = 0 TO n - 1
        bodyBuf[bodyN] = tmp[i]
        bodyN = bodyN + 1
    NEXT i
    ' Packed as start times 4096 plus count, because jdBasic-0 has no way to
    ' answer two numbers from one call.
    RETURN start * 4096 + n
ENDFUNC

FUNC P_IF() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM cond AS INTEGER
    DIM packed AS INTEGER
    DIM nbr AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER
    ' Branches are collected here first. A nested IF inside a body allocates
    ' from the same arena, so writing straight into it would both scatter this
    ' statement's branches and overwrite the inner one's.
    DIM myCond[64]
    DIM myAt[64]
    DIM myN[64]
    DIM thenS[64]
    DIM elseS[64]
    DIM nThen AS INTEGER
    DIM nElse AS INTEGER
    DIM wasElseIf AS INTEGER

    ln = CINT(TL())
    EAT()
    cond = CINT(P_EXPR())
    IF TT() = KT_THEN THEN EAT()

    nbr = 0
    nd = CINT(NEW_STMT(K_IF, ln))

    ' Single line form: IF c THEN stmt [: stmt ...] [ELSE stmt [: stmt ...]],
    ' which ends at the end of the line.
    IF TT() <> T_NEWLINE AND TT() <> TT_COLON THEN
        nThen = 0
        DO
            IF parseError <> "" THEN EXITDO
            IF TT() = KT_ELSE OR TT() = T_NEWLINE OR TT() = T_EOF THEN EXITDO
            IF nThen >= 64 THEN
                FAIL("too many statements on one line")
                EXITDO
            ENDIF
            thenS[nThen] = P_STMT()
            nThen = nThen + 1
            IF TT() = TT_COLON THEN EAT()
            IF CINT(TL()) <> ln THEN EXITDO
        LOOP

        nElse = 0
        IF TT() = KT_ELSE ANDALSO CINT(TL()) = ln THEN
            EAT()
            DO
                IF parseError <> "" THEN EXITDO
                IF TT() = T_NEWLINE OR TT() = T_EOF THEN EXITDO
                IF nElse >= 64 THEN
                    FAIL("too many statements on one line")
                    EXITDO
                ENDIF
                elseS[nElse] = P_STMT()
                nElse = nElse + 1
                IF TT() = TT_COLON THEN EAT()
                IF CINT(TL()) <> ln THEN EXITDO
            LOOP
        ENDIF

        myCond[0] = cond
        myAt[0] = bodyN
        myN[0] = nThen
        FOR i = 0 TO nThen - 1
            bodyBuf[bodyN] = thenS[i]
            bodyN = bodyN + 1
        NEXT i
        nbr = 1
        IF nElse > 0 THEN
            myCond[1] = -1
            myAt[1] = bodyN
            myN[1] = nElse
            FOR i = 0 TO nElse - 1
                bodyBuf[bodyN] = elseS[i]
                bodyN = bodyN + 1
            NEXT i
            nbr = 2
        ENDIF
    ELSE
        packed = CINT(P_BODY(KT_ELSE, KT_ENDIF, KT_ELSEIF, KT_IF))
        myCond[nbr] = cond
        myAt[nbr] = packed \ 4096
        myN[nbr] = packed MOD 4096
        nbr = nbr + 1

        DO
            IF parseError <> "" THEN EXITDO
            IF TT() <> KT_ELSE ANDALSO TT() <> KT_ELSEIF THEN EXITDO
            IF nbr >= 64 THEN
                FAIL("too many branches in one IF")
                EXITDO
            ENDIF
            wasElseIf = 0
            IF TT() = KT_ELSEIF THEN wasElseIf = 1
            EAT()
            IF TT() = KT_IF OR wasElseIf = 1 THEN
                IF wasElseIf = 0 THEN EAT()
                cond = CINT(P_EXPR())
                IF TT() = KT_THEN THEN EAT()
                packed = CINT(P_BODY(KT_ELSE, KT_ENDIF, KT_ELSEIF, KT_IF))
                myCond[nbr] = cond
            ELSE
                packed = CINT(P_BODY(KT_ELSE, KT_ENDIF, KT_ELSEIF, KT_IF))
                myCond[nbr] = -1
            ENDIF
            myAt[nbr] = packed \ 4096
            myN[nbr] = packed MOD 4096
            nbr = nbr + 1
        LOOP

        IF TT() = KT_ENDIF THEN
            EAT()
        ELSE
            IF TT() = KT_END THEN
                EAT()
                IF TT() = KT_IF THEN EAT()
            ENDIF
        ENDIF
    ENDIF

    start = brN
    FOR i = 0 TO nbr - 1
        brCond[brN] = myCond[i]
        brBodyAt[brN] = myAt[i]
        brBodyN[brN] = myN[i]
        brN = brN + 1
    NEXT i
    stBrAt[nd] = start
    stBrN[nd] = nbr
    RETURN nd
ENDFUNC

FUNC P_DO() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM packed AS INTEGER

    ln = CINT(TL())
    EAT()
    nd = CINT(NEW_STMT(K_DO_LOOP, ln))

    IF TT() = KT_WHILE OR TT() = KT_UNTIL THEN
        stTop[nd] = 1
        IF TT() = KT_UNTIL THEN stUntil[nd] = 1
        EAT()
        stCond[nd] = P_EXPR()
    ENDIF

    packed = CINT(P_BODY(KT_LOOP, -1, -1, -1))
    stBodyAt[nd] = packed \ 4096
    stBodyN[nd] = packed MOD 4096

    IF TT() = KT_LOOP THEN
        EAT()
        IF TT() = KT_WHILE OR TT() = KT_UNTIL THEN
            IF TT() = KT_UNTIL THEN stUntil[nd] = 1
            EAT()
            stCond[nd] = P_EXPR()
        ENDIF
    ENDIF
    RETURN nd
ENDFUNC

' TYPE Name / member AS type / ... / ENDTYPE. The members sit beside the node
' rather than under it, so nothing is nested here.
FUNC P_TYPE() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM start AS INTEGER
    DIM n AS INTEGER
    DIM vt AS INTEGER
    DIM myName[MAX_LOCAL] AS STRING
    DIM myType[MAX_LOCAL]
    DIM i AS INTEGER

    ln = CINT(TL())
    EAT()
    nd = CINT(NEW_STMT(K_TYPE_DECL, ln))
    stFunc[nd] = TV$()
    EAT()

    n = 0
    DO
        IF parseError <> "" THEN EXITDO
        SKIP_SEPS()
        IF TT() = KT_ENDTYPE OR TT() = T_EOF THEN EXITDO
        IF TT() = KT_END THEN EXITDO
        IF n >= MAX_LOCAL THEN
            FAIL("too many members in one TYPE")
            EXITDO
        ENDIF
        myName[n] = TV$()
        myType[n] = 0
        EAT()
        IF TT() = KT_AS THEN
            EAT()
            vt = CINT(VTYPE_OF(TT()))
            IF vt >= 0 THEN myType[n] = vt
            EAT()
        ENDIF
        n = n + 1
    LOOP

    IF TT() = KT_ENDTYPE THEN
        EAT()
    ELSE
        IF TT() = KT_END THEN
            EAT()
            IF TT() = KT_TYPE THEN EAT()
        ENDIF
    ENDIF

    start = tmN
    FOR i = 0 TO n - 1
        tmName[tmN] = myName[i]
        tmType[tmN] = myType[i]
        tmN = tmN + 1
    NEXT i
    stTmAt[nd] = start
    stTmN[nd] = n
    RETURN nd
ENDFUNC

' TRY / CATCH / FINALLY / ENDTRY. The three blocks are separate lists, and
' the dump prints them one after another with nothing between, so the order
' is what has to match.
FUNC P_TRY() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM packed AS INTEGER

    ln = CINT(TL())
    EAT()
    nd = CINT(NEW_STMT(K_TRY_CATCH, ln))

    packed = CINT(P_BODY(KT_CATCH, KT_FINALLY, KT_ENDTRY, KT_TRY))
    stBodyAt[nd] = packed \ 4096
    stBodyN[nd] = packed MOD 4096

    IF TT() = KT_CATCH THEN
        EAT()
        ' CATCH may name the variable it binds the error to.
        IF TT() = T_IDENTIFIER THEN
            stVar[nd] = TV$()
            EAT()
        ENDIF
        packed = CINT(P_BODY(KT_FINALLY, KT_ENDTRY, -1, KT_TRY))
        stCatchAt[nd] = packed \ 4096
        stCatchN[nd] = packed MOD 4096
    ENDIF

    IF TT() = KT_FINALLY THEN
        EAT()
        packed = CINT(P_BODY(KT_ENDTRY, -1, -1, KT_TRY))
        stFinAt[nd] = packed \ 4096
        stFinN[nd] = packed MOD 4096
    ENDIF

    IF TT() = KT_ENDTRY THEN
        EAT()
    ELSE
        IF TT() = KT_END THEN
            EAT()
            IF TT() = KT_TRY THEN EAT()
        ENDIF
    ENDIF
    RETURN nd
ENDFUNC

' A name after AS that is not one of the built-in type words is a declared
' type: the statement carries it as its label and the slot itself is an
' object. MAP is the spelling of a plain object and names nothing, and DATE
' is kept as a string because that is how the runtime stores one.
FUNC TYPE_AFTER_AS(nd AS INTEGER) AS INTEGER
    DIM nm AS STRING
    DIM vt AS INTEGER

    IF TT() <> T_IDENTIFIER THEN
        vt = CINT(VTYPE_OF(TT()))
        EAT()
        RETURN vt
    ENDIF

    nm = TV$()
    IF nm = "MAP" THEN
        EAT()
        RETURN 11
    ENDIF

    ' A type name may be qualified by the module that declares it.
    EAT()
    DO
        IF TT() <> TT_DOT THEN EXITDO
        IF TT_AT(1) <> T_IDENTIFIER THEN EXITDO
        EAT()
        nm = nm + "." + TV$()
        EAT()
    LOOP
    stLabel[nd] = nm

    IF nm = "DATE" THEN RETURN 10
    RETURN 11
ENDFUNC

FUNC DOTTED_NAME$() AS STRING
    DIM nm AS STRING
    nm = TV$()
    EAT()
    DO
        IF TT() <> TT_DOT THEN EXITDO
        EAT()
        nm = nm + "." + TV$()
        EAT()
    LOOP
    RETURN nm
ENDFUNC

' obj.method arg, arg. The reference tells a method call from a namespaced
' one by how the name reads: a single dot whose left side is shorter than
' three characters is an object, anything longer is a module.
FUNC P_METHOD(ln AS INTEGER) AS INTEGER
    DIM nd AS INTEGER
    DIM obj AS INTEGER
    DIM member AS INTEGER
    DIM callNd AS INTEGER
    DIM tmp[MAX_LOCAL]
    DIM n AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER
    DIM parens AS INTEGER

    obj = CINT(NEW_EXPR(X_VARIABLE, ln))
    exStr[obj] = TV$()
    EAT()
    EAT()
    member = CINT(NEW_EXPR(X_MEMBER, ln))
    exStr[member] = TV$()
    exLeft[member] = obj
    EAT()

    parens = 0
    IF TT() = TT_LPAREN THEN
        parens = 1
        EAT()
    ENDIF

    n = 0
    DO
        IF parseError <> "" THEN EXITDO
        IF parens = 1 ANDALSO TT() = TT_RPAREN THEN EXITDO
        IF TT() = T_NEWLINE OR TT() = T_EOF OR TT() = TT_COLON THEN EXITDO
        IF n >= MAX_LOCAL THEN
            FAIL("too many items in one list")
            EXITDO
        ENDIF
        tmp[n] = P_EXPR()
        n = n + 1
        IF TT() <> TT_COMMA THEN EXITDO
        EAT()
    LOOP
    IF parens = 1 ANDALSO TT() = TT_RPAREN THEN EAT()

    nd = CINT(NEW_STMT(K_EXPR_STMT, ln))
    IF n = 0 ANDALSO parens = 0 THEN
        stExpr[nd] = member
        RETURN nd
    ENDIF

    callNd = CINT(NEW_EXPR(X_CALL, ln))
    exFn[callNd] = "__METHOD__"
    exLeft[callNd] = member
    start = argN
    FOR i = 0 TO n - 1
        argBuf[argN] = tmp[i]
        argN = argN + 1
    NEXT i
    exArgAt[callNd] = start
    exArgN[callNd] = n
    stExpr[nd] = callNd
    RETURN nd
ENDFUNC

FUNC MKSTR(s AS STRING, ln AS INTEGER) AS INTEGER
    DIM nd AS INTEGER
    nd = CINT(NEW_EXPR(X_LIT_STR, ln))
    exStr[nd] = s
    RETURN nd
ENDFUNC

FUNC MKLIST(at AS INTEGER, n AS INTEGER, ln AS INTEGER) AS INTEGER
    DIM nd AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER
    nd = CINT(NEW_EXPR(X_ARRAY_LIT, ln))
    start = argN
    FOR i = 0 TO n - 1
        argBuf[argN] = tmpNodes[at + i]
        argN = argN + 1
    NEXT i
    exArgAt[nd] = start
    exArgN[nd] = n
    RETURN nd
ENDFUNC

' DECLARE SUB|FUNCTION name LIB "l" [ALIAS "a"] (params) [AS type] is not a
' statement of its own in the tree: it becomes a call that hands the runtime
' the name, the library, the alias, the parameter types, the parameter names
' and the return type.
FUNC P_DECLARE() AS INTEGER
    DIM nd AS INTEGER
    DIM callNd AS INTEGER
    DIM ln AS INTEGER
    DIM nm AS STRING
    DIM libS AS STRING
    DIM aliasS AS STRING
    DIM retS AS STRING
    DIM pName[MAX_LOCAL] AS STRING
    DIM pType[MAX_LOCAL] AS STRING
    DIM n AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER
    DIM tyAt AS INTEGER
    DIM nmAt AS INTEGER
    DIM tyArr AS INTEGER
    DIM nmArr AS INTEGER

    ln = CINT(TL())
    EAT()
    EAT()
    nm = TV$()
    EAT()

    libS = ""
    IF TV$() = "LIB" THEN
        EAT()
        libS = TV$()
        EAT()
    ENDIF

    aliasS = nm
    IF TV$() = "ALIAS" THEN
        EAT()
        aliasS = TV$()
        EAT()
    ENDIF

    n = 0
    IF TT() = TT_LPAREN THEN
        EAT()
        DO
            IF parseError <> "" THEN EXITDO
            IF TT() = TT_RPAREN OR TT() = T_EOF THEN EXITDO
            IF TT() = TT_COMMA THEN
                EAT()
                CONTINUEDO
            ENDIF
            IF n >= MAX_LOCAL THEN
                FAIL("too many parameters")
                EXITDO
            ENDIF
            pName[n] = TV$()
            pType[n] = ""
            EAT()
            IF TT() = KT_AS THEN
                EAT()
                pType[n] = TV$()
                EAT()
            ENDIF
            n = n + 1
        LOOP
        IF TT() = TT_RPAREN THEN EAT()
    ENDIF

    retS = "VOID"
    IF TT() = KT_AS THEN
        EAT()
        retS = TV$()
        EAT()
    ENDIF

    tyAt = tmpNodeN
    FOR i = 0 TO n - 1
        tmpNodes[tmpNodeN] = MKSTR(pType[i], ln)
        tmpNodeN = tmpNodeN + 1
    NEXT i
    nmAt = tmpNodeN
    FOR i = 0 TO n - 1
        tmpNodes[tmpNodeN] = MKSTR(pName[i], ln)
        tmpNodeN = tmpNodeN + 1
    NEXT i
    tyArr = CINT(MKLIST(tyAt, n, ln))
    nmArr = CINT(MKLIST(nmAt, n, ln))
    tmpNodeN = tyAt

    callNd = CINT(NEW_EXPR(X_CALL, ln))
    exFn[callNd] = "__FFI_DECLARE"
    start = argN
    argBuf[argN] = MKSTR(nm, ln)
    argN = argN + 1
    argBuf[argN] = MKSTR(libS, ln)
    argN = argN + 1
    argBuf[argN] = MKSTR(aliasS, ln)
    argN = argN + 1
    argBuf[argN] = tyArr
    argN = argN + 1
    argBuf[argN] = nmArr
    argN = argN + 1
    argBuf[argN] = MKSTR(retS, ln)
    argN = argN + 1
    exArgAt[callNd] = start
    exArgN[callNd] = 6

    nd = CINT(NEW_STMT(K_EXPR_STMT, ln))
    stExpr[nd] = callNd
    RETURN nd
ENDFUNC

' SWITCH subject / CASE value / ... / DEFAULT / ENDSWITCH. Each case is a
' branch whose condition is the value it matches; DEFAULT has none.
FUNC P_SWITCH() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM packed AS INTEGER
    DIM nbr AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER
    DIM myCond[64]
    DIM myAt[64]
    DIM myN[64]

    ln = CINT(TL())
    EAT()
    nd = CINT(NEW_STMT(K_SWITCH, ln))
    stExpr[nd] = P_EXPR()

    nbr = 0
    DO
        IF parseError <> "" THEN EXITDO
        SKIP_SEPS()
        IF TT() = KT_ENDSWITCH OR TT() = T_EOF THEN EXITDO
        IF nbr >= 64 THEN
            FAIL("too many branches in one SWITCH")
            EXITDO
        ENDIF

        IF TT() = KT_CASE THEN
            EAT()
            myCond[nbr] = P_EXPR()
        ELSE
            IF TT() = KT_DEFAULT THEN
                EAT()
                myCond[nbr] = -1
            ELSE
                FAIL("expected CASE or DEFAULT")
                EXITDO
            ENDIF
        ENDIF

        packed = CINT(P_BODY(KT_CASE, KT_DEFAULT, KT_ENDSWITCH, -1))
        myAt[nbr] = packed \ 4096
        myN[nbr] = packed MOD 4096
        nbr = nbr + 1
    LOOP

    IF TT() = KT_ENDSWITCH THEN EAT()

    start = brN
    FOR i = 0 TO nbr - 1
        brCond[brN] = myCond[i]
        brBodyAt[brN] = myAt[i]
        brBodyN[brN] = myN[i]
        brN = brN + 1
    NEXT i
    stBrAt[nd] = start
    stBrN[nd] = nbr
    RETURN nd
ENDFUNC

' ON event CALL handler registers the handler by name.
FUNC P_ON(ln AS INTEGER) AS INTEGER
    DIM nd AS INTEGER
    DIM callNd AS INTEGER
    DIM subject AS INTEGER
    DIM start AS INTEGER

    EAT()
    subject = CINT(P_EXPR())
    IF TT() = KT_CALL THEN EAT()

    callNd = CINT(NEW_EXPR(X_CALL, ln))
    exFn[callNd] = "__EVENT_ON"
    start = argN
    argBuf[argN] = subject
    argN = argN + 1
    argBuf[argN] = MKSTR(TV$(), ln)
    argN = argN + 1
    EAT()
    exArgAt[callNd] = start
    exArgN[callNd] = 2

    nd = CINT(NEW_STMT(K_EXPR_STMT, ln))
    stExpr[nd] = callNd
    RETURN nd
ENDFUNC

' ENUM Name / member [= value] / ... / ENDENUM. A member without a value
' carries on from the one before it.
FUNC P_ENUM() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM start AS INTEGER
    DIM n AS INTEGER
    DIM nextVal AS INTEGER
    DIM sign AS INTEGER
    DIM myName[MAX_LOCAL] AS STRING
    DIM myVal[MAX_LOCAL]
    DIM i AS INTEGER

    ln = CINT(TL())
    EAT()
    nd = CINT(NEW_STMT(K_ENUM, ln))
    stFunc[nd] = TV$()
    EAT()

    n = 0
    nextVal = 0
    DO
        IF parseError <> "" THEN EXITDO
        SKIP_SEPS()
        IF TT() = KT_ENDENUM OR TT() = T_EOF THEN EXITDO
        IF TT() = KT_END THEN EXITDO
        IF n >= MAX_LOCAL THEN
            FAIL("too many members in one ENUM")
            EXITDO
        ENDIF

        myName[n] = TV$()
        EAT()
        IF TT() = TT_ASSIGN THEN
            EAT()
            sign = 1
            IF TT() = TT_MINUS THEN
                sign = -1
                EAT()
            ENDIF
            nextVal = CINT(VAL(TV$())) * sign
            EAT()
        ENDIF
        myVal[n] = nextVal
        nextVal = nextVal + 1
        n = n + 1
    LOOP

    IF TT() = KT_ENDENUM THEN
        EAT()
    ELSE
        IF TT() = KT_END THEN
            EAT()
            IF TT() = KT_ENUM THEN EAT()
        ENDIF
    ENDIF

    start = emN
    FOR i = 0 TO n - 1
        emName[emN] = myName[i]
        emVal[emN] = myVal[i]
        emN = emN + 1
    NEXT i
    stEmAt[nd] = start
    stEmN[nd] = n
    RETURN nd
ENDFUNC

FUNC P_FOR() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM packed AS INTEGER

    ln = CINT(TL())
    EAT()

    ' FOR EACH walks a collection instead of counting.
    IF TT() = KT_EACH THEN
        EAT()
        nd = CINT(NEW_STMT(K_FOR_EACH, ln))
        stVar[nd] = TV$()
        EAT()
        IF TT() = KT_IN THEN EAT()
        stExpr[nd] = P_EXPR()

        packed = CINT(P_BODY(KT_NEXT, -1, -1, -1))
        stBodyAt[nd] = packed \ 4096
        stBodyN[nd] = packed MOD 4096

        IF TT() = KT_NEXT THEN
            EAT()
            IF TT() = T_IDENTIFIER THEN EAT()
        ENDIF
        RETURN nd
    ENDIF

    nd = CINT(NEW_STMT(K_FOR_LOOP, ln))
    stVar[nd] = TV$()
    EAT()
    IF TT() = TT_ASSIGN THEN EAT()
    stExpr[nd] = P_EXPR()
    IF TT() = KT_TO THEN EAT()
    stEnd[nd] = P_EXPR()
    IF TT() = KT_STEP THEN
        EAT()
        stStep[nd] = P_EXPR()
    ENDIF

    packed = CINT(P_BODY(KT_NEXT, -1, -1, -1))
    stBodyAt[nd] = packed \ 4096
    stBodyN[nd] = packed MOD 4096

    IF TT() = KT_NEXT THEN
        EAT()
        IF TT() = T_IDENTIFIER THEN EAT()
    ENDIF
    RETURN nd
ENDFUNC

SUB P_PARAMS(nd AS INTEGER)
    DIM start AS INTEGER
    DIM n AS INTEGER
    DIM vt AS INTEGER

    start = parN
    n = 0
    IF TT() <> TT_LPAREN THEN
        stParAt[nd] = start
        stParN[nd] = 0
        RETURN
    ENDIF
    EAT()
    DO
        IF TT() = TT_RPAREN THEN EXITDO
        IF TT() = T_EOF THEN EXITDO
        IF TT() = TT_COMMA THEN
            EAT()
            CONTINUEDO
        ENDIF
        parName[parN] = TV$()
        parType[parN] = 0
        EAT()
        IF TT() = KT_AS THEN
            EAT()
            vt = CINT(VTYPE_OF(TT()))
            IF vt >= 0 THEN parType[parN] = vt
            EAT()
        ENDIF
        parN = parN + 1
        n = n + 1
    LOOP
    IF TT() = TT_RPAREN THEN EAT()
    stParAt[nd] = start
    stParN[nd] = n
ENDSUB

FUNC P_ROUTINE(isFunc AS INTEGER) AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM packed AS INTEGER
    DIM vt AS INTEGER

    ln = CINT(TL())
    EAT()
    IF isFunc = 1 THEN
        nd = CINT(NEW_STMT(K_FUNCTION, ln))
    ELSE
        nd = CINT(NEW_STMT(K_SUB, ln))
    ENDIF
    stFunc[nd] = TV$()
    EAT()
    P_PARAMS(nd)
    IF TT() = KT_AS THEN
        EAT()
        vt = CINT(VTYPE_OF(TT()))
        IF vt >= 0 THEN stRType[nd] = vt
        EAT()
    ENDIF

    IF isFunc = 1 THEN
        packed = CINT(P_BODY(KT_ENDFUNC, -1, -1, KT_FUNC))
    ELSE
        packed = CINT(P_BODY(KT_ENDSUB, -1, -1, KT_SUB))
    ENDIF
    stBodyAt[nd] = packed \ 4096
    stBodyN[nd] = packed MOD 4096

    IF TT() = KT_ENDFUNC OR TT() = KT_ENDSUB THEN
        EAT()
    ELSE
        IF TT() = KT_END THEN
            EAT()
            IF TT() = KT_FUNC OR TT() = KT_SUB THEN EAT()
        ENDIF
    ENDIF
    RETURN nd
ENDFUNC

' DIM name[dims] AS type desugars to a ZEROS call over an array literal, which
' is the shape the reference produces.
FUNC P_DIM() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM vt AS INTEGER
    DIM dims[16]
    DIM ndim AS INTEGER
    DIM lit AS INTEGER
    DIM callNd AS INTEGER
    DIM start AS INTEGER
    DIM i AS INTEGER

    ln = CINT(TL())
    EAT()
    nd = CINT(NEW_STMT(K_DIM, ln))
    stVar[nd] = TV$()
    EAT()

    ndim = 0
    IF TT() = TT_LBRACKET THEN
        EAT()
        DO
            IF TT() = TT_RBRACKET THEN EXITDO
            IF TT() = T_EOF THEN EXITDO
            IF TT() = TT_COMMA THEN
                EAT()
                CONTINUEDO
            ENDIF
            IF parseError <> "" THEN EXITDO
            IF ndim >= 16 THEN
                FAIL("too many dimensions")
                EXITDO
            ENDIF
            dims[ndim] = P_EXPR()
            ndim = ndim + 1
        LOOP
        IF TT() = TT_RBRACKET THEN EAT()
    ENDIF

    IF TT() = KT_AS THEN
        EAT()
        vt = CINT(TYPE_AFTER_AS(nd))
        IF vt >= 0 THEN
            IF ndim > 0 THEN
                stVType[nd] = V_ARRAY
                stEType[nd] = vt
            ELSE
                stVType[nd] = vt
            ENDIF
        ENDIF
    ELSE
        IF ndim > 0 THEN stVType[nd] = V_ARRAY
    ENDIF

    IF ndim > 0 THEN
        lit = CINT(NEW_EXPR(X_ARRAY_LIT, ln))
        start = argN
        FOR i = 0 TO ndim - 1
            argBuf[argN] = dims[i]
            argN = argN + 1
        NEXT i
        exArgAt[lit] = start
        exArgN[lit] = ndim
        callNd = CINT(NEW_EXPR(X_CALL, ln))
        ' An array of a declared type is built by the runtime, which needs to
        ' be told which type, so it does not go through ZEROS.
        exFn[callNd] = "ZEROS"
        start = argN
        argBuf[argN] = lit
        argN = argN + 1
        exArgN[callNd] = 1
        IF stEType[nd] = 11 ANDALSO stLabel[nd] <> "" THEN
            exFn[callNd] = "__MAKE_UDT_ARRAY__"
            argBuf[argN] = MKSTR(stLabel[nd], ln)
            argN = argN + 1
            exArgN[callNd] = 2
        ENDIF
        exArgAt[callNd] = start
        stExpr[nd] = callNd
    ELSE
        IF TT() = TT_ASSIGN THEN
            EAT()
            stExpr[nd] = P_EXPR()
        ENDIF
    ENDIF
    RETURN nd
ENDFUNC

FUNC P_PRINT() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM tmpE[MAX_LOCAL]
    DIM tmpS[MAX_LOCAL]
    DIM n AS INTEGER
    DIM sep AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER

    ln = CINT(TL())
    EAT()
    nd = CINT(NEW_STMT(K_PRINT, ln))
    n = 0
    sep = 0
    DO
        IF TT() = T_NEWLINE OR TT() = T_EOF OR TT() = TT_COLON THEN EXITDO
        IF parseError <> "" THEN EXITDO
        IF n >= MAX_LOCAL THEN
            FAIL("too many items in one list")
            EXITDO
        ENDIF
        tmpE[n] = P_EXPR()
        tmpS[n] = sep
        n = n + 1
        IF TT() = TT_SEMICOLON THEN
            sep = 2
            EAT()
        ELSE
            IF TT() = TT_COMMA THEN
                sep = 1
                EAT()
            ELSE
                EXITDO
            ENDIF
        ENDIF
        IF TT() = T_NEWLINE OR TT() = T_EOF OR TT() = TT_COLON THEN
            stNoNl[nd] = 1
            EXITDO
        ENDIF
    LOOP

    start = prN
    FOR i = 0 TO n - 1
        prBuf[prN] = tmpE[i]
        prN = prN + 1
    NEXT i
    stPrAt[nd] = start
    stPrN[nd] = n

    start = sepN
    FOR i = 0 TO n - 1
        sepBuf[sepN] = tmpS[i]
        sepN = sepN + 1
    NEXT i
    stSepAt[nd] = start
    stSepN[nd] = n
    RETURN nd
ENDFUNC

' What may follow a command name as its first argument. An operator here
' means the line is an ordinary expression instead.
FUNC STARTS_ARGS(t AS INTEGER) AS INTEGER
    IF t = T_IDENTIFIER THEN RETURN 1
    IF t = T_INTEGER_LIT THEN RETURN 1
    IF t = T_FLOAT_LIT THEN RETURN 1
    IF t = T_STRING_LIT THEN RETURN 1
    IF t = TT_TRUE THEN RETURN 1
    IF t = TT_FALSE THEN RETURN 1
    IF t = TT_MINUS THEN RETURN 1
    IF t = TT_NOT THEN RETURN 1
    ' A bare name is a call too, so its terminators count as the empty
    ' argument list.
    IF t = T_NEWLINE THEN RETURN 1
    IF t = T_EOF THEN RETURN 1
    IF t = TT_COLON THEN RETURN 1
    IF t = KT_ELSE THEN RETURN 1
    RETURN 0
ENDFUNC

' Eight names are read as commands whatever follows them, unless what follows
' makes the name a call or the left side of something. CD and PWD answer the
' path they moved to, and the reference shows it, so they carry a PRINT.
' TUI.BEGIN "hello" is a command whose name happens to carry dots, so what
' decides the form is the token after the whole name.
FUNC AFTER_DOTTED() AS INTEGER
    DIM at AS INTEGER
    at = 1
    DO
        IF TT_AT(at) <> TT_DOT THEN EXITDO
        at = at + 2
    LOOP
    RETURN at
ENDFUNC

' Sixteen words that are calls with their arguments beside them rather than
' statements of their own. REACT is not among them: it lexes as a plain name.
DIM cmdKw[32]
DIM cmdKwN AS INTEGER

SUB CMD_KW_ADD(n AS STRING)
    cmdKw[cmdKwN] = CINT(TOK_BY_NAME(n))
    cmdKwN = cmdKwN + 1
ENDSUB

SUB LOAD_CMD_KEYWORDS()
    cmdKwN = 0
    CMD_KW_ADD("HELP_KW")
    CMD_KW_ADD("SCREEN_KW")
    CMD_KW_ADD("SCREENFLIP_KW")
    CMD_KW_ADD("DRAWCOLOR_KW")
    CMD_KW_ADD("SETFONT_KW")
    CMD_KW_ADD("PSET_KW")
    CMD_KW_ADD("LINE_KW")
    CMD_KW_ADD("RECT_KW")
    CMD_KW_ADD("CIRCLE_KW")
    CMD_KW_ADD("ELLIPSE_KW")
    CMD_KW_ADD("ROUNDED_RECT_KW")
    CMD_KW_ADD("CIRCLE_SECTOR_KW")
    CMD_KW_ADD("TEXT_KW")
    CMD_KW_ADD("PLOTRAW_KW")
    CMD_KW_ADD("TOGGLE_FULLSCREEN_KW")
ENDSUB

FUNC IS_CMD_KEYWORD(t AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO cmdKwN - 1
        IF cmdKw[i] = t THEN RETURN 1
    NEXT i
    RETURN 0
ENDFUNC

FUNC IS_BUILTIN_CMD(nm AS STRING) AS INTEGER
    IF nm = "CD" OR nm = "PWD" OR nm = "MKDIR" OR nm = "KILL" THEN RETURN 1
    IF nm = "DIR" OR nm = "TRON" OR nm = "TROFF" OR nm = "DUMP" THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC TAKES_BUILTIN_CMD(nt AS INTEGER) AS INTEGER
    IF nt = TT_LPAREN OR nt = TT_ASSIGN OR nt = TT_DOT THEN RETURN 0
    IF nt = TT_COLON OR nt = TT_ARROW THEN RETURN 0
    RETURN 1
ENDFUNC

FUNC P_BUILTIN_CMD(ln AS INTEGER) AS INTEGER
    DIM nd AS INTEGER
    DIM callNd AS INTEGER
    DIM nm AS STRING
    DIM tmp[MAX_LOCAL]
    DIM n AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER

    nm = TV$()
    EAT()

    n = 0
    IF TT() <> T_NEWLINE AND TT() <> T_EOF AND TT() <> TT_COLON THEN
        DO
            IF parseError <> "" THEN EXITDO
            IF n >= MAX_LOCAL THEN
                FAIL("too many items in one list")
                EXITDO
            ENDIF
            tmp[n] = P_EXPR()
            n = n + 1
            IF TT() <> TT_COMMA THEN EXITDO
            EAT()
        LOOP
    ENDIF

    callNd = CINT(NEW_EXPR(X_CALL, ln))
    exFn[callNd] = nm
    start = argN
    FOR i = 0 TO n - 1
        argBuf[argN] = tmp[i]
        argN = argN + 1
    NEXT i
    exArgAt[callNd] = start
    exArgN[callNd] = n

    IF nm = "CD" OR nm = "PWD" THEN
        nd = CINT(NEW_STMT(K_PRINT, ln))
        stPrAt[nd] = prN
        prBuf[prN] = callNd
        prN = prN + 1
        stPrN[nd] = 1
        stSepAt[nd] = sepN
        sepBuf[sepN] = 0
        sepN = sepN + 1
        stSepN[nd] = 1
        RETURN nd
    ENDIF

    nd = CINT(NEW_STMT(K_EXPR_STMT, ln))
    stExpr[nd] = callNd
    RETURN nd
ENDFUNC

' NAME arg, arg  and a bare NAME, both of which are calls in the tree.
FUNC P_COMMAND(ln AS INTEGER) AS INTEGER
    DIM nd AS INTEGER
    DIM callNd AS INTEGER
    DIM nm AS STRING
    DIM tmp[MAX_LOCAL]
    DIM n AS INTEGER
    DIM i AS INTEGER
    DIM start AS INTEGER

    nm = TV$()
    EAT()
    DO
        IF TT() <> TT_DOT THEN EXITDO
        EAT()
        nm = nm + "." + TV$()
        EAT()
    LOOP

    n = 0
    DO
        IF TT() = T_NEWLINE OR TT() = T_EOF OR TT() = TT_COLON THEN EXITDO
        IF TT() = KT_ELSE THEN EXITDO
        IF parseError <> "" THEN EXITDO
        IF n >= MAX_LOCAL THEN
            FAIL("too many items in one list")
            EXITDO
        ENDIF
        tmp[n] = P_EXPR()
        n = n + 1
        IF TT() = TT_COMMA THEN
            EAT()
        ELSE
            EXITDO
        ENDIF
    LOOP

    callNd = CINT(NEW_EXPR(X_CALL, ln))
    exFn[callNd] = nm
    start = argN
    FOR i = 0 TO n - 1
        argBuf[argN] = tmp[i]
        argN = argN + 1
    NEXT i
    exArgAt[callNd] = start
    exArgN[callNd] = n

    nd = CINT(NEW_STMT(K_EXPR_STMT, ln))
    stExpr[nd] = callNd
    RETURN nd
ENDFUNC

FUNC P_STMT() AS INTEGER
    DIM nd AS INTEGER
    DIM ln AS INTEGER
    DIM t AS INTEGER
    DIM save AS INTEGER
    DIM start AS INTEGER
    DIM myIdx[MAX_LOCAL]
    DIM nIdx AS INTEGER
    DIM closer AS INTEGER
    DIM after AS INTEGER
    DIM i AS INTEGER

    SKIP_SEPS()
    ln = CINT(TL())
    t = CINT(TT())

    IF t = KT_OPTION THEN
        EAT()
        nd = CINT(NEW_STMT(K_OPTION, ln))
        stExpr[nd] = NEW_EXPR(X_LIT_STR, ln)
        exStr[CINT(stExpr[nd])] = TV$()
        EAT()
        RETURN nd
    ENDIF

    IF t = KT_CONST THEN
        EAT()
        nd = CINT(NEW_STMT(K_LET, ln))
        stVar[nd] = TV$()
        stConst[nd] = 1
        EAT()
        IF TT() = TT_ASSIGN THEN EAT()
        stExpr[nd] = P_EXPR()
        RETURN nd
    ENDIF

    IF t = KT_DIM THEN RETURN CINT(P_DIM())
    IF t = KT_PRINT THEN RETURN CINT(P_PRINT())
    IF t = KT_IF THEN RETURN CINT(P_IF())
    IF t = KT_DO THEN RETURN CINT(P_DO())
    IF t = KT_FOR THEN RETURN CINT(P_FOR())
    IF t = KT_TYPE THEN RETURN CINT(P_TYPE())
    IF t = KT_TRY THEN RETURN CINT(P_TRY())
    IF t = KT_SWITCH THEN RETURN CINT(P_SWITCH())
    IF t = KT_ENUM THEN RETURN CINT(P_ENUM())

    IF t = KT_STATIC THEN
        EAT()
        nd = CINT(P_STMT())
        IF nd >= 0 THEN stStatic[nd] = 1
        RETURN nd
    ENDIF
    IF t = KT_ON THEN RETURN CINT(P_ON(ln))

    IF t = KT_ASYNC THEN
        EAT()
        nd = CINT(P_STMT())
        IF nd >= 0 THEN stAsync[nd] = 1
        RETURN nd
    ENDIF
    IF t = KT_DECLARE THEN RETURN CINT(P_DECLARE())

    ' SCREEN takes its arguments the way any command does.
    IF IS_CMD_KEYWORD(t) = 1 THEN RETURN CINT(P_BUILTIN_CMD(ln))

    ' EXPORT MODULE is handled before the tree is built and leaves an empty
    ' statement where it stood. EXPORT on a declaration marks it instead.
    IF t = KT_EXPORT THEN
        EAT()
        IF TT() = KT_MODULE THEN
            EAT()
            IF TT() = T_IDENTIFIER THEN EAT()
            nd = CINT(NEW_STMT(K_EXPR_STMT, ln))
            stExpr[nd] = NEW_EXPR(X_LIT_INT, ln)
            RETURN nd
        ENDIF
        nd = CINT(P_STMT())
        IF nd >= 0 THEN stLabel[nd] = "__EXPORT__"
        RETURN nd
    ENDIF

    IF t = KT_STOP THEN
        EAT()
        RETURN CINT(NEW_STMT(K_STOP, ln))
    ENDIF

    ' CLS on its own clears; with three numbers it clears to a colour.
    IF t = KT_CLS THEN
        EAT()
        nd = CINT(NEW_STMT(K_CLS, ln))
        IF TT() = T_NEWLINE OR TT() = T_EOF OR TT() = TT_COLON THEN RETURN nd
        stExpr[nd] = P_EXPR()
        IF TT() = TT_COMMA THEN
            EAT()
            stCond[nd] = P_EXPR()
        ENDIF
        IF TT() = TT_COMMA THEN
            EAT()
            stEnd[nd] = P_EXPR()
        ENDIF
        RETURN nd
    ENDIF

    IF t = KT_SLEEP OR t = KT_CURSOR OR t = KT_THROW THEN
        EAT()
        IF t = KT_SLEEP THEN nd = CINT(NEW_STMT(K_SLEEP, ln))
        IF t = KT_CURSOR THEN nd = CINT(NEW_STMT(K_CURSOR, ln))
        IF t = KT_THROW THEN nd = CINT(NEW_STMT(K_THROW, ln))
        stExpr[nd] = P_EXPR()
        RETURN nd
    ENDIF

    IF t = KT_LOCATE OR t = KT_COLOR THEN
        EAT()
        IF t = KT_LOCATE THEN
            nd = CINT(NEW_STMT(K_LOCATE, ln))
        ELSE
            nd = CINT(NEW_STMT(K_COLOR, ln))
        ENDIF
        stExpr[nd] = P_EXPR()
        IF TT() = TT_COMMA THEN
            EAT()
            stCond[nd] = P_EXPR()
        ENDIF
        RETURN nd
    ENDIF

    IF t = KT_LET THEN
        EAT()
        nd = CINT(NEW_STMT(K_LET, ln))
        stVar[nd] = TV$()
        EAT()
        IF TT() = TT_ASSIGN THEN
            EAT()
            stExpr[nd] = P_EXPR()
        ENDIF
        RETURN nd
    ENDIF
    IF t = KT_FUNC THEN RETURN CINT(P_ROUTINE(1))
    IF t = KT_SUB THEN RETURN CINT(P_ROUTINE(0))

    IF t = KT_RETURN THEN
        EAT()
        nd = CINT(NEW_STMT(K_RETURN, ln))
        IF TT() <> T_NEWLINE AND TT() <> T_EOF AND TT() <> TT_COLON THEN
            stExpr[nd] = P_EXPR()
        ENDIF
        RETURN nd
    ENDIF

    IF t = KT_END THEN
        EAT()
        RETURN CINT(NEW_STMT(K_END_STMT, ln))
    ENDIF

    ' The reference reuses is_while on an exit to mean EXITFUNC, so leaving a
    ' loop clears it and leaving a function does not. Continue never touches it.
    IF t = KT_EXITDO OR t = KT_EXITFOR OR t = KT_EXITFUNC THEN
        EAT()
        nd = CINT(NEW_STMT(K_EXIT_LOOP, ln))
        IF t <> KT_EXITFUNC THEN stUntil[nd] = 1
        RETURN nd
    ENDIF
    IF t = KT_CONTDO OR t = KT_CONTFOR THEN
        EAT()
        RETURN CINT(NEW_STMT(K_CONTINUE_LOOP, ln))
    ENDIF

    ' A bare name followed by = is an assignment; with a bracket in between it
    ' is an indexed one. A name followed by something that starts a value is
    ' BASIC's command form, TXTWRITER a, b, which is a call without brackets.
    ' Anything else is an expression statement.
    IF t = T_IDENTIFIER THEN
        IF IS_BUILTIN_CMD(TV$()) = 1 ANDALSO TAKES_BUILTIN_CMD(CINT(TT_AT(1))) = 1 THEN
            RETURN CINT(P_BUILTIN_CMD(ln))
        ENDIF
        after = CINT(AFTER_DOTTED())
        IF after > 1 THEN
            ' a.b = expr assigns to the field, whatever the name looks like.
            IF TT_AT(after) = TT_ASSIGN THEN
                nd = CINT(NEW_STMT(K_ASSIGN, ln))
                stVar[nd] = DOTTED_NAME$()
                EAT()
                stExpr[nd] = P_EXPR()
                RETURN nd
            ENDIF
            IF after = 3 ANDALSO LEN(TV$()) < 3 THEN RETURN CINT(P_METHOD(ln))
        ENDIF

        save = cur
        IF TT_AT(1) = TT_ASSIGN THEN
            nd = CINT(NEW_STMT(K_ASSIGN, ln))
            stVar[nd] = TV$()
            EAT()
            EAT()
            stExpr[nd] = P_EXPR()
            RETURN nd
        ENDIF
        ' C[1][2], C[1, 2] and m{"k"} are all subscript lists, and the whole
        ' run of them belongs to the assignment.
        IF TT_AT(1) = TT_LBRACKET OR TT_AT(1) = TT_LBRACE THEN
            nd = CINT(NEW_STMT(K_INDEX_ASSIGN, ln))
            stVar[nd] = TV$()
            EAT()
            nIdx = 0
            DO
                IF parseError <> "" THEN EXITDO
                IF TT() = TT_LBRACKET THEN
                    closer = TT_RBRACKET
                ELSE
                    IF TT() = TT_LBRACE THEN
                        closer = TT_RBRACE
                    ELSE
                        EXITDO
                    ENDIF
                ENDIF
                EAT()
                DO
                    IF parseError <> "" THEN EXITDO
                    IF TT() = closer THEN EXITDO
                    IF nIdx >= MAX_LOCAL THEN
                        FAIL("too many subscripts")
                        EXITDO
                    ENDIF
                    myIdx[nIdx] = P_EXPR()
                    nIdx = nIdx + 1
                    IF TT() <> TT_COMMA THEN EXITDO
                    EAT()
                LOOP
                IF TT() <> closer THEN EXITDO
                EAT()
            LOOP

            IF parseError = "" ANDALSO TT() = TT_ASSIGN THEN
                EAT()
                stExpr[nd] = P_EXPR()
                start = ixN
                FOR i = 0 TO nIdx - 1
                    ixBuf[ixN] = myIdx[i]
                    ixN = ixN + 1
                NEXT i
                stIxAt[nd] = start
                stIxN[nd] = nIdx
                RETURN nd
            ENDIF
            cur = save
            stCount = stCount - 1
        ENDIF

        IF STARTS_ARGS(CINT(TT_AT(CINT(AFTER_DOTTED())))) = 1 THEN RETURN CINT(P_COMMAND(ln))
    ENDIF

    nd = CINT(NEW_STMT(K_EXPR_STMT, ln))
    stExpr[nd] = P_EXPR()
    RETURN nd
ENDFUNC

' The top level is held in its own arena rather than a local, because a
' program has as many statements as it has, and a nested body allocates from
' bodyBuf while this is still collecting.
SUB P_PROGRAM()
    DIM tmp[MAX_BUF]
    DIM n AS INTEGER
    DIM i AS INTEGER

    cur = 0
    n = 0
    DO
        IF parseError <> "" THEN EXITDO
        SKIP_SEPS()
        IF TT() = T_EOF THEN EXITDO
        IF n >= MAX_BUF THEN
            FAIL("too many statements in one program")
            EXITDO
        ENDIF
        tmp[n] = P_STMT()
        n = n + 1
    LOOP
    topAt = bodyN
    FOR i = 0 TO n - 1
        bodyBuf[bodyN] = tmp[i]
        bodyN = bodyN + 1
    NEXT i
    topN = n
ENDSUB

' ── Output, in the shape --dump-tokens uses ────────────────────────────────

FUNC ESCAPE$(v AS STRING) AS STRING
    DIM r AS STRING
    DIM i AS INTEGER
    DIM c AS INTEGER
    r = ""
    FOR i = 0 TO LEN(v) - 1
        c = CINT(BYTEAT(v, i))
        IF c = 92 THEN
            r = r + "\\"
        ELSE
            IF c = 10 THEN
                r = r + "\n"
            ELSE
                IF c = 9 THEN
                    r = r + "\t"
                ELSE
                    IF c = 13 THEN
                        r = r + "\r"
                    ELSE
                        r = r + CHR$(c)
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT i
    RETURN r
ENDFUNC

SUB EMIT_TOKENS()
    DIM i AS INTEGER
    DIM out AS STRING
    out = ""
    FOR i = 0 TO tkCount - 1
        out = out + STR$(tkType[i]) + CHR$(9) + STR$(tkLine[i]) + CHR$(9)
        out = out + STR$(tkCol[i]) + CHR$(9) + ESCAPE$(tkVal[i]) + CHR$(10)
    NEXT i
    PRINT out;
ENDSUB

' ── Printing the tree in the shape --dump-ast uses ─────────────────────────

DIM outBuf AS STRING

SUB EMIT(s AS STRING)
    outBuf = outBuf + s
ENDSUB

FUNC PAD$(ind AS INTEGER) AS STRING
    DIM r AS STRING
    DIM i AS INTEGER
    r = ""
    FOR i = 1 TO ind
        r = r + "  "
    NEXT i
    RETURN r
ENDFUNC

FUNC AESC$(v AS STRING) AS STRING
    DIM r AS STRING
    DIM i AS INTEGER
    DIM c AS INTEGER
    r = ""
    FOR i = 0 TO LEN(v) - 1
        c = CINT(BYTEAT(v, i))
        IF c = 92 THEN
            r = r + "\\"
        ELSE
            IF c = 10 THEN
                r = r + "\n"
            ELSE
                IF c = 9 THEN
                    r = r + "\t"
                ELSE
                    IF c = 13 THEN
                        r = r + "\r"
                    ELSE
                        IF c = 32 THEN
                            r = r + "\s"
                        ELSE
                            IF c = 41 THEN
                                r = r + "\)"
                            ELSE
                                r = r + CHR$(c)
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT i
    RETURN r
ENDFUNC

' The reference prints a float literal with C's "%.17g": seventeen significant
' digits, trailing zeros dropped. C++20's "{:.Ng}" counts digits after the
' point instead, so the two only line up once N is shifted by the value's
' decimal exponent. Seventeen significant digits means sixteen after the point
' for a number in [1,10), one more for every power of ten below that.
'
' C switches to exponent notation past 1e17 and below 1e-5 and C++20 does not,
' so a literal out there still reads differently; that is the only band where
' this comparison is not exact.
FUNC NUMTXT$(v AS DOUBLE) AS STRING
    DIM a AS DOUBLE
    DIM expo AS INTEGER
    DIM s AS STRING
    DIM last AS INTEGER

    IF v = 0 THEN RETURN "0"

    a = ABS(v)
    expo = 0
    DO
        IF a < 10 THEN EXITDO
        a = a / 10
        expo = expo + 1
    LOOP
    DO
        IF a >= 1 THEN EXITDO
        a = a * 10
        expo = expo - 1
    LOOP

    s = FORMAT$("{:." + STR$(16 - expo) + "g}", v)
    IF INSTR(s, ".") < 0 THEN RETURN s

    last = CINT(LEN(s)) - 1
    DO
        IF last < 0 THEN EXITDO
        IF MID$(s, last, 1) <> "0" THEN EXITDO
        last = last - 1
    LOOP
    IF last >= 0 ANDALSO MID$(s, last, 1) = "." THEN last = last - 1
    RETURN LEFT$(s, last + 1)
ENDFUNC

SUB D_EXPR(ix AS INTEGER, ind AS INTEGER)
    DIM i AS INTEGER
    DIM k AS INTEGER
    IF ix < 0 THEN RETURN
    k = CINT(exKind[ix])
    EMIT(PAD$(ind) + "(e" + STR$(k) + " l" + STR$(exLine[ix]))
    IF exInt[ix] <> 0 THEN EMIT(" i=" + STR$(exInt[ix]))
    IF exFloat[ix] <> 0 THEN EMIT(" f=" + NUMTXT$(exFloat[ix]))
    IF exStr[ix] <> "" THEN EMIT(" s=" + AESC$(exStr[ix]))
    IF exBool[ix] <> 0 THEN EMIT(" b=1")
    IF exFuncRef[ix] <> 0 THEN EMIT(" fr=1")
    IF k = X_BINARY OR k = X_UNARY THEN EMIT(" op=" + STR$(exOp[ix]))
    IF exFn[ix] <> "" THEN EMIT(" fn=" + AESC$(exFn[ix]))
    FOR i = 0 TO exKeyN[ix] - 1
        EMIT(" k=" + AESC$(keyBuf[CINT(exKeyAt[ix]) + i]))
    NEXT i
    FOR i = 0 TO exLpN[ix] - 1
        EMIT(" lp=" + AESC$(lpBuf[CINT(exLpAt[ix]) + i]))
    NEXT i
    FOR i = 0 TO exLcN[ix] - 1
        EMIT(" lc=" + AESC$(lcBuf[CINT(exLcAt[ix]) + i]))
    NEXT i
    EMIT(CHR$(10))
    D_EXPR(CINT(exLeft[ix]), ind + 1)
    D_EXPR(CINT(exRight[ix]), ind + 1)
    FOR i = 0 TO exArgN[ix] - 1
        D_EXPR(CINT(argBuf[CINT(exArgAt[ix]) + i]), ind + 1)
    NEXT i
    EMIT(PAD$(ind) + ")" + CHR$(10))
ENDSUB

SUB D_STMT(ix AS INTEGER, ind AS INTEGER)
    DIM i AS INTEGER
    DIM b AS INTEGER
    IF ix < 0 THEN RETURN
    EMIT(PAD$(ind) + "(s" + STR$(stKind[ix]) + " l" + STR$(stLine[ix]))
    IF stVar[ix] <> "" THEN EMIT(" v=" + AESC$(stVar[ix]))
    IF stVType[ix] <> 0 THEN EMIT(" vt=" + STR$(stVType[ix]))
    IF stEType[ix] <> 0 THEN EMIT(" et=" + STR$(stEType[ix]))
    IF stConst[ix] <> 0 THEN EMIT(" const=1")
    IF stStatic[ix] <> 0 THEN EMIT(" static=1")
    IF stLabel[ix] <> "" THEN EMIT(" lbl=" + AESC$(stLabel[ix]))
    IF stFunc[ix] <> "" THEN EMIT(" fn=" + AESC$(stFunc[ix]))
    IF stRType[ix] <> 0 THEN EMIT(" rt=" + STR$(stRType[ix]))
    IF stAsync[ix] <> 0 THEN EMIT(" async=1")
    IF stTop[ix] <> 0 THEN EMIT(" top=1")
    IF stUntil[ix] <> 0 THEN EMIT(" until=1")
    IF stNoNl[ix] <> 0 THEN EMIT(" nonl=1")
    FOR i = 0 TO stSepN[ix] - 1
        EMIT(" sep=" + STR$(sepBuf[CINT(stSepAt[ix]) + i]))
    NEXT i
    FOR i = 0 TO stParN[ix] - 1
        EMIT(" p=" + AESC$(parName[CINT(stParAt[ix]) + i]) + ":" + STR$(parType[CINT(stParAt[ix]) + i]))
    NEXT i
    FOR i = 0 TO stEmN[ix] - 1
        EMIT(" em=" + AESC$(emName[CINT(stEmAt[ix]) + i]) + ":" + STR$(emVal[CINT(stEmAt[ix]) + i]))
    NEXT i
    FOR i = 0 TO stTmN[ix] - 1
        EMIT(" tm=" + AESC$(tmName[CINT(stTmAt[ix]) + i]) + ":" + STR$(tmType[CINT(stTmAt[ix]) + i]))
    NEXT i
    EMIT(CHR$(10))

    D_EXPR(CINT(stExpr[ix]), ind + 1)
    D_EXPR(CINT(stCond[ix]), ind + 1)
    D_EXPR(CINT(stEnd[ix]), ind + 1)
    D_EXPR(CINT(stStep[ix]), ind + 1)
    FOR i = 0 TO stPrN[ix] - 1
        D_EXPR(CINT(prBuf[CINT(stPrAt[ix]) + i]), ind + 1)
    NEXT i
    FOR i = 0 TO stIxN[ix] - 1
        D_EXPR(CINT(ixBuf[CINT(stIxAt[ix]) + i]), ind + 1)
    NEXT i

    FOR b = 0 TO stBrN[ix] - 1
        EMIT(PAD$(ind + 1) + "(branch" + CHR$(10))
        D_EXPR(CINT(brCond[CINT(stBrAt[ix]) + b]), ind + 2)
        FOR i = 0 TO brBodyN[CINT(stBrAt[ix]) + b] - 1
            D_STMT(CINT(bodyBuf[CINT(brBodyAt[CINT(stBrAt[ix]) + b]) + i]), ind + 2)
        NEXT i
        EMIT(PAD$(ind + 1) + ")" + CHR$(10))
    NEXT b

    FOR i = 0 TO stBodyN[ix] - 1
        D_STMT(CINT(bodyBuf[CINT(stBodyAt[ix]) + i]), ind + 1)
    NEXT i
    FOR i = 0 TO stCatchN[ix] - 1
        D_STMT(CINT(bodyBuf[CINT(stCatchAt[ix]) + i]), ind + 1)
    NEXT i
    FOR i = 0 TO stFinN[ix] - 1
        D_STMT(CINT(bodyBuf[CINT(stFinAt[ix]) + i]), ind + 1)
    NEXT i

    EMIT(PAD$(ind) + ")" + CHR$(10))
ENDSUB


' ── Code generation ────────────────────────────────────────────────────────
'
' The tree becomes LLVM IR as text, which clang turns into a binary. The
' runtime stays C++: generated code only knows how to call jdb_* entry points,
' the same ones the reference backend calls.
'
' Numbers are f64 and strings are i8*, which is jdBasic's native ABI. An array
' is an opaque runtime handle, and a string element of one is the pointer's
' bits reinterpreted as a double, which is the shape the reference stores.
'
' A routine becomes its own LLVM define. Its parameters and its declarations
' live in allocas in the entry block, so recursion works; everything declared
' at the top level stays a module global.

CONST TY_NUM = 0
CONST TY_STR = 1
' A comparison answers a truth value, and PRINT renders one as TRUE or FALSE
' rather than 1 or 0. It is kept as an i1 until something asks for a number.
CONST TY_BOOL = 2
CONST TY_ARRN = 3
CONST TY_ARRS = 4
' A map, and an array whose elements were never promised to be alike. What
' comes out of either is only known while the program runs.
CONST TY_MAP = 5
' What a call answers when it answers nothing.
CONST TY_VOID = 6
' A value that carries its own tag: the bits, and what to make of them. This
' is what a map answers, and what an array answers when its elements differ.
CONST TY_ANY = 7
CONST TY_ARRA = 8

' How many arguments one bridged call can carry. Every routine keeps scratch
' this wide, so the number is a size rather than a guess.
CONST BRIDGE_MAX = 16

DIM ir AS STRING
DIM fnDefs AS STRING
DIM tmpNo AS INTEGER
DIM lblNo AS INTEGER
DIM genError AS STRING

DIM gvName[1024] AS STRING
DIM gvType[1024]
DIM gvN AS INTEGER

' The routine being generated: its parameters and its declarations, in allocas.
DIM lvName[1024] AS STRING
DIM lvType[1024]
DIM lvN AS INTEGER
DIM inRoutine AS INTEGER
DIM curRet AS INTEGER
DIM curIsSub AS INTEGER

DIM fnName[512] AS STRING
DIM fnRet[512]
DIM fnIsSub[512]
DIM fnParAt[512]
DIM fnParN[512]
DIM fnN AS INTEGER

' Where EXITDO and CONTINUEFOR jump to, innermost last.
DIM loopBreak[64] AS STRING
DIM loopNext[64] AS STRING
DIM loopN AS INTEGER

DIM strLit[4096] AS STRING
DIM strLen[4096]
DIM strN AS INTEGER

' The type of the last expression emitted, since jdBasic-0 cannot answer two
' values from one call.
DIM lastType AS INTEGER

' When the last value was a tagged one, the register holding its tag.
DIM lastTag AS STRING



DIM nativesPath AS STRING

SUB W(s AS STRING)
    ir = ir + s + CHR$(10)
ENDSUB

FUNC NEWTMP$() AS STRING
    tmpNo = tmpNo + 1
    RETURN "%t" + STR$(tmpNo)
ENDFUNC

FUNC NEWLBL$(base AS STRING) AS STRING
    lblNo = lblNo + 1
    RETURN base + STR$(lblNo)
ENDFUNC

' ── Types ──────────────────────────────────────────────────────────────────

' A tagged value needs room for both halves, so its slot is a pair.
FUNC LL_TY$(ty AS INTEGER) AS STRING
    IF ty = TY_ANY THEN RETURN "{i64, i32}"
    IF ty = TY_STR OR ty = TY_MAP THEN RETURN "ptr"
    IF IS_ARR(ty) = 1 THEN RETURN "ptr"
    RETURN "double"
ENDFUNC

FUNC ZERO_OF$(ty AS INTEGER) AS STRING
    IF ty = TY_ANY THEN RETURN "zeroinitializer"
    IF LL_TY$(ty) = "ptr" THEN RETURN "null"
    RETURN "0.0"
ENDFUNC

' What comes out of an array. An array that was told what it holds answers
' that; one that was not answers a tagged value.
FUNC ELEM_TY(ty AS INTEGER) AS INTEGER
    IF ty = TY_ARRS THEN RETURN TY_STR
    IF ty = TY_ARRA OR ty = TY_MAP OR ty = TY_ANY THEN RETURN TY_ANY
    RETURN TY_NUM
ENDFUNC

FUNC IS_ARR(ty AS INTEGER) AS INTEGER
    IF ty = TY_ARRN OR ty = TY_ARRS OR ty = TY_ARRA THEN RETURN 1
    RETURN 0
ENDFUNC

' A tagged value reaches the wire without being touched, and the tag it
' already carries is the one the wire wants.
FUNC IS_PTRISH(ty AS INTEGER) AS INTEGER
    IF ty = TY_STR OR ty = TY_MAP THEN RETURN 1
    IF IS_ARR(ty) = 1 THEN RETURN 1
    RETURN 0
ENDFUNC

' A truth value is only distinct while it is being carried; a slot holds a
' number.
FUNC NORM_TY(ty AS INTEGER) AS INTEGER
    IF ty = TY_BOOL THEN RETURN TY_NUM
    RETURN ty
ENDFUNC

FUNC ENDS_IN_DOLLAR(nm AS STRING) AS INTEGER
    IF LEN(nm) = 0 THEN RETURN 0
    IF MID$(nm, LEN(nm) - 1, 1) = "$" THEN RETURN 1
    RETURN 0
ENDFUNC

' ── Symbols ────────────────────────────────────────────────────────────────

FUNC GV_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO gvN - 1
        IF gvName[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

SUB GV_ADD(nm AS STRING, ty AS INTEGER)
    DIM i AS INTEGER
    i = CINT(GV_FIND(nm))
    IF i >= 0 THEN
        ' AS ARRAY says the name holds an array, not what is in it. The value
        ' assigned to it does, so that answer wins.
        IF gvType[i] = TY_ARRN ANDALSO ty = TY_ARRA THEN gvType[i] = TY_ARRA
        IF gvType[i] = TY_NUM ANDALSO ty = TY_ANY THEN gvType[i] = TY_ANY
        IF gvType[i] = TY_NUM ANDALSO ty = TY_MAP THEN gvType[i] = TY_MAP
        IF gvType[i] = TY_ARRN ANDALSO ty = TY_ARRS THEN gvType[i] = TY_ARRS
        RETURN
    ENDIF
    gvName[gvN] = nm
    gvType[gvN] = ty
    gvN = gvN + 1
ENDSUB

FUNC LV_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO lvN - 1
        IF lvName[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

SUB LV_ADD(nm AS STRING, ty AS INTEGER)
    IF LV_FIND(nm) >= 0 THEN RETURN
    lvName[lvN] = nm
    lvType[lvN] = ty
    lvN = lvN + 1
ENDSUB

FUNC SYM_REF$(nm AS STRING) AS STRING
    IF inRoutine = 1 ANDALSO LV_FIND(nm) >= 0 THEN RETURN "%l_" + nm
    RETURN "@v_" + nm
ENDFUNC

FUNC SYM_TYPE(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    IF inRoutine = 1 THEN
        i = CINT(LV_FIND(nm))
        IF i >= 0 THEN RETURN CINT(lvType[i])
    ENDIF
    i = CINT(GV_FIND(nm))
    IF i < 0 THEN RETURN TY_NUM
    RETURN CINT(gvType[i])
ENDFUNC

FUNC FN_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO fnN - 1
        IF fnName[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

FUNC PARAM_TY(at AS INTEGER) AS INTEGER
    DIM vt AS INTEGER
    vt = CINT(parType[at])
    IF vt = 10 THEN RETURN TY_STR
    IF vt = V_ARRAY THEN RETURN TY_ARRN
    IF vt = 0 ANDALSO ENDS_IN_DOLLAR(parName[at]) = 1 THEN RETURN TY_STR
    RETURN TY_NUM
ENDFUNC

' A literal becomes a private constant. The escaping is LLVM's \XX form, and
' the array length counts the terminator.
FUNC STR_CONST$(v AS STRING) AS STRING
    DIM i AS INTEGER
    DIM idx AS INTEGER
    DIM c AS INTEGER
    DIM body AS STRING
    DIM hexd AS STRING

    FOR i = 0 TO strN - 1
        IF strLit[i] = v THEN RETURN "@.s" + STR$(i)
    NEXT i

    IF strN >= 4096 THEN
        genError = "too many string constants in one module"
        RETURN "@.s0"
    ENDIF
    idx = strN
    strLit[idx] = v
    strLen[idx] = LEN(v) + 1
    strN = strN + 1

    body = ""
    hexd = "0123456789ABCDEF"
    FOR i = 0 TO LEN(v) - 1
        c = CINT(BYTEAT(v, i))
        IF c >= 32 AND c < 127 AND c <> 34 AND c <> 92 THEN
            body = body + CHR$(c)
        ELSE
            body = body + "\" + MID$(hexd, c \ 16, 1) + MID$(hexd, c MOD 16, 1)
        ENDIF
    NEXT i
    body = body + "\00"

    strDecl = strDecl + "@.s" + STR$(idx) + " = private unnamed_addr constant ["
    strDecl = strDecl + STR$(LEN(v) + 1) + " x i8] c" + CHR$(34) + body + CHR$(34) + CHR$(10)
    RETURN "@.s" + STR$(idx)
ENDFUNC

' ── Builtins ───────────────────────────────────────────────────────────────
'
' The runtime is not reimplemented, only called. Each entry names the jdBasic
' spelling, the jdb_* symbol behind it, and how the two sides pass values:
'
'   sig   one letter per argument - S a string pointer, I an i64 the caller
'         truncates a number into, D a double
'   ret   S a string pointer, A an array handle, I an i64 widened back to a
'         double, D a double, V nothing
'   extra literal arguments the symbol takes that the source never writes
'
' declArgs is spelled out rather than derived, so the declare and the call
' cannot drift apart.

DIM biName[64] AS STRING
DIM biSym[64] AS STRING
DIM biSig[64] AS STRING
DIM biRet[64] AS STRING
DIM biExtra[64] AS STRING
DIM biDeclArgs[64] AS STRING
DIM biDeclRet[64] AS STRING
DIM biN AS INTEGER

SUB BI_ADD(nm AS STRING, sym AS STRING, sig AS STRING, ret AS STRING, extra AS STRING, declArgs AS STRING)
    biName[biN] = nm
    biSym[biN] = sym
    biSig[biN] = sig
    biRet[biN] = ret
    biExtra[biN] = extra
    biDeclArgs[biN] = declArgs
    biDeclRet[biN] = "ptr"
    IF ret = "V" THEN biDeclRet[biN] = "void"
    IF ret = "I" THEN biDeclRet[biN] = "i64"
    IF ret = "D" THEN biDeclRet[biN] = "double"
    biN = biN + 1
ENDSUB

SUB BI_INIT()
    biN = 0
    BI_ADD("CINT", "jdb_cint", "D", "I", "", "double")
    BI_ADD("CHR$", "jdb_chr", "I", "S", "", "i64")
    BI_ADD("STR$", "jdb_str", "D", "S", "", "double")
    BI_ADD("VAL", "jdb_val", "S", "D", "", "ptr")
    BI_ADD("ABS", "jdb_abs", "D", "D", "", "double")
    BI_ADD("LEN", "jdb_len_str", "S", "I", "", "ptr")
    BI_ADD("MID$", "jdb_mid_lax", "SII", "S", "", "ptr, i64, i64")
    BI_ADD("LEFT$", "jdb_left", "SI", "S", "", "ptr, i64")
    BI_ADD("RIGHT$", "jdb_right", "SI", "S", "", "ptr, i64")
    BI_ADD("INSTR", "jdb_instr", "SS", "I", "", "ptr, ptr")
    BI_ADD("BYTEAT", "jdb_byteat", "SI", "I", "", "ptr, i64")
    BI_ADD("UCASE$", "jdb_upper", "S", "S", "", "ptr")
    BI_ADD("LCASE$", "jdb_lower", "S", "S", "", "ptr")
    BI_ADD("TRIM$", "jdb_trim", "S", "S", "", "ptr")
    BI_ADD("REPLACE$", "jdb_replace", "SSS", "S", "", "ptr, ptr, ptr")
    ' FORMAT$ is variadic in the language and one symbol per arity in the
    ' runtime. jdBasic-0 only ever formats one number.
    BI_ADD("FORMAT$", "jdb_format1", "SD", "S", "", "ptr, double")
    BI_ADD("TXTREADER$", "jdb_txtreader", "S", "S", "", "ptr")
    BI_ADD("TXTWRITER", "jdb_txtwriter3", "SS", "V", ", i64 0", "ptr, ptr, i64")
    BI_ADD("OS.ARGS", "jdb_os_args", "", "A", "", "")
ENDSUB

FUNC BI_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO biN - 1
        IF biName[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

FUNC BI_RET_TY(bi AS INTEGER) AS INTEGER
    IF biRet[bi] = "S" THEN RETURN TY_STR
    IF biRet[bi] = "A" THEN RETURN TY_ARRS
    RETURN TY_NUM
ENDFUNC

FUNC TO_I64$(v AS STRING, ty AS INTEGER) AS STRING
    DIM t AS STRING
    t = NEWTMP$()
    W("  " + t + " = fptosi double " + AS_NUM$(v, ty) + " to i64")
    RETURN t
ENDFUNC

' Emits the call and leaves lastType describing what came back.
FUNC EMIT_RT$(sym AS STRING, argsTxt AS STRING, ret AS STRING) AS STRING
    DIM t AS STRING
    DIM raw AS STRING

    IF ret = "V" THEN
        W("  call void @" + sym + "(" + argsTxt + ")")
        lastType = TY_NUM
        RETURN "0.0"
    ENDIF
    IF ret = "I" THEN
        raw = NEWTMP$()
        W("  " + raw + " = call i64 @" + sym + "(" + argsTxt + ")")
        t = NEWTMP$()
        W("  " + t + " = sitofp i64 " + raw + " to double")
        lastType = TY_NUM
        RETURN t
    ENDIF
    IF ret = "D" THEN
        t = NEWTMP$()
        W("  " + t + " = call double @" + sym + "(" + argsTxt + ")")
        lastType = TY_NUM
        RETURN t
    ENDIF

    t = NEWTMP$()
    W("  " + t + " = call ptr @" + sym + "(" + argsTxt + ")")
    lastType = TY_STR
    IF ret = "A" THEN lastType = TY_ARRS
    RETURN t
ENDFUNC

' ── The bridge ─────────────────────────────────────────────────────────────
'
' A name the registry does not carry is handed to the running VM by name,
' with its arguments as bits and a tag apiece. That is one mechanism for
' every native the language has rather than one entry per native, and it is
' how the reference reaches everything it did not register either.
'
' Which of the five entry points to call depends on what comes back, and
' nothing here knows that, so the call site says what it expects.

' The wire carries a value as sixty-four bits, whatever it really is.
FUNC AS_BITS$(v AS STRING, ty AS INTEGER) AS STRING
    DIM t AS STRING
    IF ty = TY_ANY THEN RETURN v
    t = NEWTMP$()
    IF IS_PTRISH(ty) = 1 THEN
        W("  " + t + " = ptrtoint ptr " + v + " to i64")
    ELSE
        W("  " + t + " = bitcast double " + AS_NUM$(v, ty) + " to i64")
    ENDIF
    RETURN t
ENDFUNC

FUNC G_BRIDGE$(nm AS STRING, ix AS INTEGER, wantTy AS INTEGER) AS STRING
    DIM i AS INTEGER
    DIM n AS INTEGER
    DIM v AS STRING
    DIM vt AS INTEGER
    DIM slot AS STRING
    DIM cell AS STRING
    DIM bits AS STRING
    DIM rt AS STRING
    DIM nameC AS STRING
    DIM raw AS STRING
    DIM t AS STRING

    n = 0
    IF ix >= 0 THEN n = CINT(exArgN[ix])
    IF n > BRIDGE_MAX THEN
        genError = nm + " takes more arguments than the bridge carries"
        lastType = TY_NUM
        RETURN "0.0"
    ENDIF

    FOR i = 0 TO n - 1
        v = G_EXPR(CINT(argBuf[CINT(exArgAt[ix]) + i]))
        vt = lastType

        bits = AS_BITS$(v, vt)

        slot = NEWTMP$()
        W("  " + slot + " = getelementptr i64, ptr %bargs, i32 " + STR$(i))
        W("  store i64 " + bits + ", ptr " + slot)
        slot = NEWTMP$()
        W("  " + slot + " = getelementptr i32, ptr %btags, i32 " + STR$(i))
        W("  store i32 " + STR$(WIRE_TAG(vt)) + ", ptr " + slot)
    NEXT i

    nameC = STR_CONST$(nm)
    rt = G_RT_HANDLE$()

    IF wantTy = TY_STR OR IS_ARR(wantTy) = 1 THEN
        raw = NEWTMP$()
        IF wantTy = TY_STR THEN
            W("  " + raw + " = call ptr @jdrt_call_typed_str(ptr " + rt + ", ptr " + nameC + ", ptr %bargs, ptr %btags, i32 " + STR$(n) + ")")
        ELSE
            W("  " + raw + " = call ptr @jdrt_call_typed_arr(ptr " + rt + ", ptr " + nameC + ", ptr %bargs, ptr %btags, i32 " + STR$(n) + ")")
        ENDIF
        G_CHECK_ERR(rt)
        lastType = wantTy
        RETURN raw
    ENDIF

    IF wantTy = TY_VOID THEN
        W("  call void @jdrt_call_typed_void(ptr " + rt + ", ptr " + nameC + ", ptr %bargs, ptr %btags, i32 " + STR$(n) + ")")
        G_CHECK_ERR(rt)
        lastType = TY_NUM
        RETURN "0.0"
    ENDIF

    raw = NEWTMP$()
    W("  " + raw + " = call double @jdrt_call_typed_f64(ptr " + rt + ", ptr " + nameC + ", ptr %bargs, ptr %btags, i32 " + STR$(n) + ")")
    G_CHECK_ERR(rt)
    lastType = TY_NUM
    RETURN raw
ENDFUNC

' A registered native: the call goes straight to its jdb_* symbol.
FUNC G_NATIVE$(ni AS INTEGER, ix AS INTEGER) AS STRING
    DIM i AS INTEGER
    DIM n AS INTEGER
    DIM want AS STRING
    DIM v AS STRING
    DIM vt AS INTEGER
    DIM argsTxt AS STRING
    DIM raw AS STRING
    DIM t AS STRING
    DIM rt AS STRING

    natUsed[ni] = 1
    n = CINT(exArgN[ix])
    argsTxt = ""
    FOR i = 0 TO n - 1
        want = MID$(natArgs[ni], i, 1)
        v = G_EXPR(CINT(argBuf[CINT(exArgAt[ix]) + i]))
        vt = lastType
        IF i > 0 THEN argsTxt = argsTxt + ", "
        IF want = "P" THEN
            argsTxt = argsTxt + "ptr " + v
        ELSE
            IF want = "D" THEN
                argsTxt = argsTxt + "double " + AS_NUM$(v, vt)
            ELSE
                argsTxt = argsTxt + LL_OF_LETTER$(want) + " " + TO_INT$(v, vt, LL_OF_LETTER$(want))
            ENDIF
        ENDIF
    NEXT i

    IF natRet[ni] = "V" THEN
        W("  call void @" + natSym[ni] + "(" + argsTxt + ")")
        lastType = TY_NUM
        RETURN "0.0"
    ENDIF

    rt = LL_OF_LETTER$(natRet[ni])
    raw = NEWTMP$()
    W("  " + raw + " = call " + rt + " @" + natSym[ni] + "(" + argsTxt + ")")

    IF rt = "ptr" OR rt = "double" THEN
        lastType = CINT(NAT_RET_TY(ni))
        RETURN raw
    ENDIF

    ' An integer answer is a truth value or a number, never left as an i64.
    IF natTag[ni] = 8 THEN
        t = NEWTMP$()
        W("  " + t + " = icmp ne " + rt + " " + raw + ", 0")
        lastType = TY_BOOL
        RETURN t
    ENDIF
    t = NEWTMP$()
    W("  " + t + " = sitofp " + rt + " " + raw + " to double")
    lastType = TY_NUM
    RETURN t
ENDFUNC

FUNC TO_INT$(v AS STRING, ty AS INTEGER, llty AS STRING) AS STRING
    DIM t AS STRING
    t = NEWTMP$()
    W("  " + t + " = fptosi double " + AS_NUM$(v, ty) + " to " + llty)
    RETURN t
ENDFUNC

FUNC G_BUILTIN$(bi AS INTEGER, ix AS INTEGER) AS STRING
    DIM i AS INTEGER
    DIM n AS INTEGER
    DIM want AS STRING
    DIM v AS STRING
    DIM vt AS INTEGER
    DIM argsTxt AS STRING
    DIM sym AS STRING

    n = 0
    IF ix >= 0 THEN n = CINT(exArgN[ix])

    sym = biSym[bi]
    argsTxt = ""
    FOR i = 0 TO n - 1
        want = MID$(biSig[bi], i, 1)
        v = G_EXPR(CINT(argBuf[CINT(exArgAt[ix]) + i]))
        vt = lastType
        IF i > 0 THEN argsTxt = argsTxt + ", "
        IF want = "S" THEN
            argsTxt = argsTxt + "ptr " + v
            ' LEN is one name over two runtime entry points.
            IF i = 0 ANDALSO IS_ARR(vt) = 1 ANDALSO biName[bi] = "LEN" THEN sym = "jdb_array_len"
        ELSE
            IF want = "I" THEN
                argsTxt = argsTxt + "i64 " + TO_I64$(v, vt)
            ELSE
                argsTxt = argsTxt + "double " + AS_NUM$(v, vt)
            ENDIF
        ENDIF
    NEXT i
    argsTxt = argsTxt + biExtra[bi]
    RETURN EMIT_RT$(sym, argsTxt, biRet[bi])
ENDFUNC

' ── The type an expression will have, without emitting anything ────────────

FUNC E_TYPE(ix AS INTEGER) AS INTEGER
    DIM k AS INTEGER
    DIM f AS INTEGER
    DIM op AS INTEGER

    IF ix < 0 THEN RETURN TY_NUM
    k = CINT(exKind[ix])
    IF k = X_LIT_STR THEN RETURN TY_STR
    IF k = X_MAP_LIT THEN RETURN TY_MAP
    IF k = X_ARRAY_LIT THEN RETURN TY_ARRA
    IF k = X_VARIABLE THEN
        ' A builtin that takes nothing reads like a variable.
        f = CINT(BI_FIND(exStr[ix]))
        IF f >= 0 ANDALSO biSig[f] = "" THEN RETURN CINT(BI_RET_TY(f))
        RETURN CINT(SYM_TYPE(exStr[ix]))
    ENDIF
    IF k = X_INDEX THEN RETURN CINT(ELEM_TY(CINT(E_TYPE(CINT(exLeft[ix])))))
    IF k = X_CALL THEN
        f = CINT(FN_FIND(exFn[ix]))
        IF f >= 0 THEN RETURN CINT(fnRet[f])
        f = CINT(BI_FIND(exFn[ix]))
        IF f >= 0 ANDALSO LEN(biSig[f]) = exArgN[ix] THEN RETURN CINT(BI_RET_TY(f))
        f = CINT(NAT_FIND(exFn[ix], CINT(exArgN[ix])))
        IF f >= 0 THEN RETURN CINT(NAT_RET_TY(f))
        ' Over the bridge the shape comes from the name: the reference's own
        ' list for the array answers, and the dollar for the string ones.
        IF IS_ARR_RETURNER(exFn[ix]) = 1 THEN RETURN TY_ARRN
        IF ENDS_IN_DOLLAR(exFn[ix]) = 1 THEN RETURN TY_STR
        RETURN TY_NUM
    ENDIF
    IF k = X_BINARY THEN
        op = CINT(exOp[ix])
        IF op = TOK_LT OR op = TOK_GT OR op = TOK_LE OR op = TOK_GE THEN RETURN TY_BOOL
        IF op = TOK_NE OR op = TOK_ASSIGN THEN RETURN TY_BOOL
        IF op = TOK_PLUS ANDALSO E_TYPE(CINT(exLeft[ix])) = TY_STR THEN RETURN TY_STR
        RETURN TY_NUM
    ENDIF
    RETURN TY_NUM
ENDFUNC

' Bounds and a value are different things. DIM a[3] carries the call the
' parser desugared the bounds into; DIM a = [1,2,3] carries the value itself
' and wants nothing but a store.
FUNC HAS_BOUNDS(ix AS INTEGER) AS INTEGER
    DIM callNd AS INTEGER
    callNd = CINT(stExpr[ix])
    IF callNd < 0 THEN RETURN 0
    IF exKind[callNd] <> X_CALL THEN RETURN 0
    IF exFn[callNd] = "ZEROS" THEN RETURN 1
    IF exFn[callNd] = "__MAKE_UDT_ARRAY__" THEN RETURN 1
    RETURN 0
ENDFUNC

' A declaration with more than one bound holds arrays, not values.
FUNC IS_MULTIDIM(ix AS INTEGER) AS INTEGER
    DIM callNd AS INTEGER
    DIM lit AS INTEGER
    IF HAS_BOUNDS(ix) = 0 THEN RETURN 0
    callNd = CINT(stExpr[ix])
    lit = CINT(argBuf[CINT(exArgAt[callNd])])
    IF exKind[lit] <> X_ARRAY_LIT THEN RETURN 0
    IF exArgN[lit] > 1 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC DIM_TYPE(ix AS INTEGER) AS INTEGER
    DIM vt AS INTEGER
    vt = CINT(stVType[ix])
    IF vt = 11 ANDALSO stLabel[ix] = "" THEN RETURN TY_MAP
    IF vt = V_ARRAY THEN
        IF IS_MULTIDIM(ix) = 1 THEN RETURN TY_ARRA
        IF stEType[ix] = 10 THEN RETURN TY_ARRS
        RETURN TY_ARRN
    ENDIF
    IF vt = 10 THEN RETURN TY_STR
    IF vt = 0 ANDALSO stExpr[ix] >= 0 THEN RETURN CINT(NORM_TY(CINT(E_TYPE(CINT(stExpr[ix])))))
    RETURN TY_NUM
ENDFUNC

FUNC RET_TY(ix AS INTEGER) AS INTEGER
    IF stRType[ix] = 10 THEN RETURN TY_STR
    IF stRType[ix] = V_ARRAY THEN RETURN TY_ARRN
    IF ENDS_IN_DOLLAR(stFunc[ix]) = 1 THEN RETURN TY_STR
    RETURN TY_NUM
ENDFUNC

' ── Collecting declarations before anything is emitted ─────────────────────
'
' Routines are hoisted, so a call can stand above its definition and a routine
' can read a global declared below it. Both are found first and generated
' afterwards.

SUB SCAN_ROUTINES()
    DIM j AS INTEGER
    DIM ix AS INTEGER
    DIM k AS INTEGER

    fnN = 0
    FOR j = 0 TO topN - 1
        ix = CINT(bodyBuf[topAt + j])
        k = CINT(stKind[ix])
        IF k = K_FUNCTION OR k = K_SUB THEN
            fnName[fnN] = stFunc[ix]
            fnIsSub[fnN] = 0
            fnRet[fnN] = TY_NUM
            IF k = K_SUB THEN
                fnIsSub[fnN] = 1
            ELSE
                fnRet[fnN] = RET_TY(ix)
            ENDIF
            fnParAt[fnN] = stParAt[ix]
            fnParN[fnN] = stParN[ix]
            fnN = fnN + 1
        ENDIF
    NEXT j
ENDSUB

SUB DECLARE_NAME(nm AS STRING, ty AS INTEGER, asLocal AS INTEGER)
    IF asLocal = 0 THEN
        GV_ADD(nm, ty)
        RETURN
    ENDIF
    ' A routine that writes a name it does not declare writes the global.
    IF GV_FIND(nm) >= 0 THEN RETURN
    LV_ADD(nm, ty)
ENDSUB

SUB SCAN_DECLS(at AS INTEGER, n AS INTEGER, asLocal AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        SCAN_ONE(CINT(bodyBuf[at + i]), asLocal)
    NEXT i
ENDSUB

SUB SCAN_ONE(ix AS INTEGER, asLocal AS INTEGER)
    DIM k AS INTEGER
    DIM b AS INTEGER
    DIM at AS INTEGER

    IF ix < 0 THEN RETURN
    k = CINT(stKind[ix])
    IF k = K_FUNCTION OR k = K_SUB THEN RETURN
    ' A declaration inside a routine is that routine's own, even when a global
    ' of the same name exists; only a bare assignment reaches out.
    IF k = K_DIM OR k = K_LET THEN
        IF asLocal = 1 THEN
            LV_ADD(stVar[ix], CINT(DIM_TYPE(ix)))
        ELSE
            GV_ADD(stVar[ix], CINT(DIM_TYPE(ix)))
        ENDIF
        RETURN
    ENDIF
    IF k = K_ASSIGN THEN
        DECLARE_NAME(stVar[ix], CINT(NORM_TY(CINT(E_TYPE(CINT(stExpr[ix]))))), asLocal)
        RETURN
    ENDIF
    IF k = K_FOR_LOOP THEN
        DECLARE_NAME(stVar[ix], TY_NUM, asLocal)
        SCAN_DECLS(CINT(stBodyAt[ix]), CINT(stBodyN[ix]), asLocal)
        RETURN
    ENDIF
    IF k = K_DO_LOOP THEN
        SCAN_DECLS(CINT(stBodyAt[ix]), CINT(stBodyN[ix]), asLocal)
        RETURN
    ENDIF
    IF k = K_IF THEN
        FOR b = 0 TO stBrN[ix] - 1
            at = CINT(stBrAt[ix]) + b
            SCAN_DECLS(CINT(brBodyAt[at]), CINT(brBodyN[at]), asLocal)
        NEXT b
    ENDIF
ENDSUB

' ── Expressions ────────────────────────────────────────────────────────────

FUNC G_STRCMP$(op AS INTEGER, l AS STRING, r AS STRING) AS STRING
    DIM c AS STRING
    DIM t AS STRING
    DIM pred AS STRING

    lastType = TY_BOOL
    IF op = TOK_ASSIGN OR op = TOK_NE THEN
        c = NEWTMP$()
        IF op = TOK_ASSIGN THEN
            W("  " + c + " = call i64 @jdb_str_eq(ptr " + l + ", ptr " + r + ")")
        ELSE
            W("  " + c + " = call i64 @jdb_str_ne(ptr " + l + ", ptr " + r + ")")
        ENDIF
        t = NEWTMP$()
        W("  " + t + " = icmp ne i64 " + c + ", 0")
        RETURN t
    ENDIF

    pred = "slt"
    IF op = TOK_GT THEN pred = "sgt"
    IF op = TOK_LE THEN pred = "sle"
    IF op = TOK_GE THEN pred = "sge"
    c = NEWTMP$()
    W("  " + c + " = call i64 @jdb_str_cmp(ptr " + l + ", ptr " + r + ")")
    t = NEWTMP$()
    W("  " + t + " = icmp " + pred + " i64 " + c + ", 0")
    RETURN t
ENDFUNC

FUNC G_BINARY(ix AS INTEGER) AS STRING
    DIM l AS STRING
    DIM r AS STRING
    DIM lt AS INTEGER
    DIM rt AS INTEGER
    DIM t AS STRING
    DIM q AS STRING
    DIM whole AS STRING
    DIM op AS INTEGER
    DIM arith AS STRING
    DIM bitOp AS STRING
    DIM cmpOp AS STRING

    l = G_EXPR(CINT(exLeft[ix]))
    lt = lastType
    r = G_EXPR(CINT(exRight[ix]))
    rt = lastType
    op = CINT(exOp[ix])

    ' + over two strings is concatenation, not arithmetic.
    IF op = TOK_PLUS ANDALSO lt = TY_STR THEN
        t = NEWTMP$()
        W("  " + t + " = call ptr @jdb_str_concat(ptr " + l + ", ptr " + r + ")")
        lastType = TY_STR
        RETURN t
    ENDIF

    ' `needle IN haystack` asks whether the haystack holds it, which is what
    ' finding its position and testing for one answers.
    IF op = TT_IN THEN
        q = NEWTMP$()
        W("  " + q + " = call i64 @jdb_instr(ptr " + r + ", ptr " + l + ")")
        t = NEWTMP$()
        W("  " + t + " = icmp sge i64 " + q + ", 0")
        lastType = TY_BOOL
        RETURN t
    ENDIF

    IF lt = TY_STR ANDALSO rt = TY_STR THEN RETURN G_STRCMP$(op, l, r)

    l = AS_NUM$(l, lt)
    r = AS_NUM$(r, rt)

    arith = ""
    IF op = TOK_PLUS THEN arith = "fadd"
    IF op = TOK_MINUS THEN arith = "fsub"
    IF op = TOK_STAR THEN arith = "fmul"
    IF op = TOK_SLASH THEN arith = "fdiv"
    IF op = TOK_MOD THEN arith = "frem"
    IF arith <> "" THEN
        t = NEWTMP$()
        W("  " + t + " = " + arith + " double " + l + ", " + r)
        lastType = TY_NUM
        RETURN t
    ENDIF

    ' The bitwise operators and the shifts work on whole numbers, so the
    ' operands go in as integers and the answer comes back out as a number.
    bitOp = ""
    IF op = TT_BAND THEN bitOp = "and"
    IF op = TT_BOR THEN bitOp = "or"
    IF op = TT_XOR OR op = TT_BXOR THEN bitOp = "xor"
    IF op = TT_SHL THEN bitOp = "shl"
    IF op = TT_SHR THEN bitOp = "ashr"
    IF bitOp <> "" THEN
        q = TO_INT$(l, TY_NUM, "i64")
        whole = TO_INT$(r, TY_NUM, "i64")
        t = NEWTMP$()
        W("  " + t + " = " + bitOp + " i64 " + q + ", " + whole)
        q = NEWTMP$()
        W("  " + q + " = sitofp i64 " + t + " to double")
        lastType = TY_NUM
        RETURN q
    ENDIF

    IF op = TT_CARET THEN
        t = NEWTMP$()
        W("  " + t + " = call double @jdb_pow(double " + l + ", double " + r + ")")
        lastType = TY_NUM
        RETURN t
    ENDIF

    ' Integer division keeps the quotient's whole part, towards zero.
    IF op = TOK_BSLASH THEN
        q = NEWTMP$()
        W("  " + q + " = fdiv double " + l + ", " + r)
        whole = NEWTMP$()
        W("  " + whole + " = fptosi double " + q + " to i64")
        t = NEWTMP$()
        W("  " + t + " = sitofp i64 " + whole + " to double")
        lastType = TY_NUM
        RETURN t
    ENDIF

    cmpOp = ""
    IF op = TOK_LT THEN cmpOp = "olt"
    IF op = TOK_GT THEN cmpOp = "ogt"
    IF op = TOK_LE THEN cmpOp = "ole"
    IF op = TOK_GE THEN cmpOp = "oge"
    IF op = TOK_NE THEN cmpOp = "one"
    IF op = TOK_ASSIGN THEN cmpOp = "oeq"

    IF cmpOp <> "" THEN
        t = NEWTMP$()
        W("  " + t + " = fcmp " + cmpOp + " double " + l + ", " + r)
        lastType = TY_BOOL
        RETURN t
    ENDIF

    IF op = TOK_AND OR op = TOK_ANDALSO OR op = TOK_OR OR op = TOK_ORELSE THEN
        RETURN G_LOGICAL(op, l, r)
    ENDIF

    genError = "cannot generate operator " + STR$(op)
    lastType = TY_NUM
    RETURN "0.0"
ENDFUNC

' Widens a truth value to a number, for arithmetic and for conditions. A
' tagged value gives up its bits and is read as the number they spell.
FUNC AS_NUM$(v AS STRING, ty AS INTEGER) AS STRING
    DIM t AS STRING
    IF ty = TY_ANY THEN
        t = NEWTMP$()
        W("  " + t + " = bitcast i64 " + v + " to double")
        RETURN t
    ENDIF
    IF ty <> TY_BOOL THEN RETURN v
    t = NEWTMP$()
    W("  " + t + " = uitofp i1 " + v + " to double")
    RETURN t
ENDFUNC

' The tag a value carries. A tagged one says so at runtime; everything else
' is known while compiling.
FUNC TAG_OF$(ty AS INTEGER) AS STRING
    IF ty = TY_ANY THEN RETURN lastTag
    RETURN STR$(WIRE_TAG(ty))
ENDFUNC

' Reads a tagged value as a pointer, which is what it holds when its tag
' says string or array.
FUNC ANY_AS_PTR$(v AS STRING) AS STRING
    DIM t AS STRING
    t = NEWTMP$()
    W("  " + t + " = inttoptr i64 " + v + " to ptr")
    RETURN t
ENDFUNC

' Brings a value to the shape a slot of the given type holds.
FUNC COERCE$(v AS STRING, from AS INTEGER, dest AS INTEGER) AS STRING
    DIM t AS STRING

    IF from = dest THEN RETURN v
    IF dest = TY_ANY THEN RETURN v
    IF from <> TY_ANY THEN
        IF LL_TY$(dest) = "double" THEN RETURN AS_NUM$(v, from)
        RETURN v
    ENDIF

    ' Out of a tagged value into something that expects one shape.
    IF LL_TY$(dest) = "ptr" THEN RETURN ANY_AS_PTR$(v)
    RETURN AS_NUM$(v, TY_ANY)
ENDFUNC

' Both sides are already evaluated, so these do not short-circuit yet. The
' comparison against the reference is on output, and no test relies on it.
FUNC G_LOGICAL(op AS INTEGER, l AS STRING, r AS STRING) AS STRING
    DIM lb AS STRING
    DIM rb AS STRING
    DIM t AS STRING
    lb = NEWTMP$()
    W("  " + lb + " = fcmp one double " + l + ", 0.0")
    rb = NEWTMP$()
    W("  " + rb + " = fcmp one double " + r + ", 0.0")
    t = NEWTMP$()
    IF op = TOK_AND OR op = TOK_ANDALSO THEN
        W("  " + t + " = and i1 " + lb + ", " + rb)
    ELSE
        W("  " + t + " = or i1 " + lb + ", " + rb)
    ENDIF
    lastType = TY_BOOL
    RETURN t
ENDFUNC

' An index is a number in the source and an i64 to the runtime.
FUNC G_IDX$(ix AS INTEGER) AS STRING
    DIM v AS STRING
    DIM t AS STRING
    v = G_EXPR(ix)
    t = NEWTMP$()
    W("  " + t + " = fptosi double " + AS_NUM$(v, lastType) + " to i64")
    RETURN t
ENDFUNC

FUNC G_INDEX$(ix AS INTEGER) AS STRING
    DIM handle AS STRING
    DIM ht AS INTEGER
    DIM iv AS STRING
    DIM raw AS STRING
    DIM bits AS STRING
    DIM t AS STRING
    DIM keyV AS STRING

    handle = G_EXPR(CINT(exLeft[ix]))
    ht = lastType

    ' What a tagged container is cannot be read off the tag while compiling,
    ' but the subscript says it: a name keys a map, a number indexes an array.
    IF ht = TY_ANY THEN
        handle = ANY_AS_PTR$(handle)
        ht = TY_ARRA
        IF E_TYPE(CINT(exRight[ix])) = TY_STR THEN ht = TY_MAP
    ENDIF

    IF ht = TY_MAP THEN
        keyV = G_EXPR(CINT(exRight[ix]))
        RETURN G_TAGGED_READ$(handle, keyV, 1)
    ENDIF

    iv = G_IDX$(CINT(exRight[ix]))

    IF ELEM_TY(ht) = TY_ANY THEN RETURN G_TAGGED_READ$(handle, iv, 0)

    raw = NEWTMP$()
    W("  " + raw + " = call double @jdb_array_get(ptr " + handle + ", i64 " + iv + ")")
    IF ELEM_TY(ht) <> TY_STR THEN
        lastType = TY_NUM
        RETURN raw
    ENDIF

    ' A string element is the pointer's bits, stored in the cell as a double.
    bits = NEWTMP$()
    W("  " + bits + " = bitcast double " + raw + " to i64")
    t = NEWTMP$()
    W("  " + t + " = inttoptr i64 " + bits + " to ptr")
    lastType = TY_STR
    RETURN t
ENDFUNC

FUNC G_CALL$(ix AS INTEGER) AS STRING
    DIM f AS INTEGER
    DIM i AS INTEGER
    DIM pat AS INTEGER
    DIM n AS INTEGER
    DIM av[64] AS STRING
    DIM avt[64]
    DIM argsTxt AS STRING
    DIM pty AS INTEGER
    DIM rty AS INTEGER
    DIM t AS STRING

    f = CINT(FN_FIND(exFn[ix]))
    IF f < 0 THEN
        ' A routine of the program wins, then the natives spelled out here,
        ' then the registry lifted from the reference, then the bridge, which
        ' answers for everything else.
        ' Spelled out here only when the shape matches; a different number of
        ' arguments is a different call and belongs further down.
        f = CINT(BI_FIND(exFn[ix]))
        IF f >= 0 ANDALSO LEN(biSig[f]) = exArgN[ix] THEN RETURN G_BUILTIN$(f, ix)
        f = CINT(NAT_FIND(exFn[ix], CINT(exArgN[ix])))
        IF f >= 0 THEN RETURN G_NATIVE$(f, ix)
        RETURN G_BRIDGE$(exFn[ix], ix, CINT(E_TYPE(ix)))
    ENDIF

    n = CINT(exArgN[ix])
    IF n <> fnParN[f] THEN
        genError = exFn[ix] + " wants " + STR$(fnParN[f]) + " arguments, given " + STR$(n)
        lastType = TY_NUM
        RETURN "0.0"
    ENDIF

    FOR i = 0 TO n - 1
        av[i] = G_EXPR(CINT(argBuf[CINT(exArgAt[ix]) + i]))
        avt[i] = lastType
    NEXT i

    pat = CINT(fnParAt[f])
    argsTxt = ""
    FOR i = 0 TO n - 1
        IF i > 0 THEN argsTxt = argsTxt + ", "
        pty = CINT(PARAM_TY(pat + i))
        IF LL_TY$(pty) = "ptr" THEN
            argsTxt = argsTxt + "ptr " + av[i]
        ELSE
            argsTxt = argsTxt + "double " + AS_NUM$(av[i], CINT(avt[i]))
        ENDIF
    NEXT i

    IF fnIsSub[f] = 1 THEN
        W("  call void @f_" + exFn[ix] + "(" + argsTxt + ")")
        lastType = TY_NUM
        RETURN "0.0"
    ENDIF

    rty = CINT(fnRet[f])
    t = NEWTMP$()
    W("  " + t + " = call " + LL_TY$(rty) + " @f_" + exFn[ix] + "(" + argsTxt + ")")
    lastType = rty
    RETURN t
ENDFUNC

' ── The natives the runtime exports ────────────────────────────────────────
'
' Read from selfhost/jdbc_natives.txt, which gen_natives.jdb lifts out of the
' reference backend's own registry. A name found here is called directly; a
' name that is not goes over the bridge, which needs no table at all.

DIM natName[512] AS STRING
DIM natSym[512] AS STRING
DIM natRet[512] AS STRING
DIM natArgs[512] AS STRING
DIM natTag[512]
DIM natUsed[512]
DIM natN AS INTEGER

' Names that answer an array over the bridge, from the reference's own list.
DIM arrRet[256] AS STRING
DIM arrRetN AS INTEGER

FUNC LL_OF_LETTER$(c AS STRING) AS STRING
    IF c = "V" THEN RETURN "void"
    IF c = "D" THEN RETURN "double"
    IF c = "I" THEN RETURN "i64"
    IF c = "N" THEN RETURN "i32"
    RETURN "ptr"
ENDFUNC

SUB LOAD_NATIVES()
    DIM txt AS STRING
    DIM ln AS STRING
    DIM at AS INTEGER
    DIM p AS INTEGER
    DIM rest AS STRING

    natN = 0
    arrRetN = 0
    txt = REPLACE$(TXTREADER$(nativesPath), CHR$(13) + CHR$(10), CHR$(10))
    at = 0
    DO
        IF at >= LEN(txt) THEN EXITDO
        p = CINT(INSTR(MID$(txt, at, LEN(txt) - at), CHR$(10)))
        IF p < 0 THEN
            ln = MID$(txt, at, LEN(txt) - at)
            at = LEN(txt)
        ELSE
            ln = MID$(txt, at, p)
            at = at + p + 1
        ENDIF
        IF LEN(ln) = 0 THEN CONTINUEDO

        IF LEFT$(ln, 5) = "@ARR" + CHR$(9) THEN
            IF arrRetN < 256 THEN
                arrRet[arrRetN] = MID$(ln, 5, LEN(ln) - 5)
                arrRetN = arrRetN + 1
            ENDIF
            CONTINUEDO
        ENDIF
        IF natN >= 512 THEN EXITDO

        rest = ln
        p = CINT(INSTR(rest, CHR$(9)))
        IF p < 0 THEN CONTINUEDO
        natName[natN] = LEFT$(rest, p)
        rest = MID$(rest, p + 1, LEN(rest) - p - 1)

        p = CINT(INSTR(rest, CHR$(9)))
        IF p < 0 THEN CONTINUEDO
        natSym[natN] = LEFT$(rest, p)
        rest = MID$(rest, p + 1, LEN(rest) - p - 1)

        p = CINT(INSTR(rest, CHR$(9)))
        IF p < 0 THEN CONTINUEDO
        natRet[natN] = LEFT$(rest, p)
        rest = MID$(rest, p + 1, LEN(rest) - p - 1)

        p = CINT(INSTR(rest, CHR$(9)))
        IF p < 0 THEN
            natArgs[natN] = rest
            natTag[natN] = -1
        ELSE
            natArgs[natN] = LEFT$(rest, p)
            natTag[natN] = CINT(VAL(MID$(rest, p + 1, LEN(rest) - p - 1)))
        ENDIF
        natUsed[natN] = 0
        natN = natN + 1
    LOOP
ENDSUB

' A native that takes a different number of arguments than it was registered
' with is a different call, and goes over the bridge instead.
FUNC NAT_FIND(nm AS STRING, argc AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO natN - 1
        IF natName[i] = nm ANDALSO LEN(natArgs[i]) = argc THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

FUNC IS_ARR_RETURNER(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO arrRetN - 1
        IF arrRet[i] = nm THEN RETURN 1
    NEXT i
    RETURN 0
ENDFUNC

FUNC NAT_RET_TY(i AS INTEGER) AS INTEGER
    IF natRet[i] = "P" THEN
        IF natTag[i] = 3 THEN RETURN TY_ARRN
        RETURN TY_STR
    ENDIF
    IF natTag[i] = 8 THEN RETURN TY_BOOL
    RETURN TY_NUM
ENDFUNC

' ── The runtime handle ─────────────────────────────────────────────────────
'
' Anything that goes through the bridge needs the running VM behind it, and
' after every such call the runtime is asked whether it left an error. The
' reference emits the same sequence, and a program that skips it reports
' wrong answers instead of failures.

SUB G_RUNTIME_INIT()
    W("  %bargs = alloca i64, i32 " + STR$(BRIDGE_MAX))
    W("  %btags = alloca i32, i32 " + STR$(BRIDGE_MAX))
    W("  %tvval = alloca i64")
    W("  %tvtag = alloca i32")
    W("  call void @jdb_set_args(i32 %argc, ptr %argv)")
    W("  %jdrt = call ptr @jdrt_init()")
    W("  store ptr %jdrt, ptr @__jdrt_handle")
    W("  call void @jdb_runtime_set_handle(ptr %jdrt)")
    W("  %rt0 = load ptr, ptr @__jdrt_handle")
    W("  call void @jdrt_set_event_dispatcher(ptr %rt0, ptr @jdrt_dispatch_event)")
ENDSUB

FUNC G_RT_HANDLE$() AS STRING
    DIM t AS STRING
    t = NEWTMP$()
    W("  " + t + " = load ptr, ptr @__jdrt_handle")
    RETURN t
ENDFUNC

' Inside a TRY the failure path leads to its CATCH instead of out of the
' program, innermost last.
DIM catchLbl[64] AS STRING
DIM catchN AS INTEGER

' Each FOR EACH keeps its own cursor and its own hold on the collection.
DIM eachNo AS INTEGER

SUB G_CHECK_ERR(rt AS STRING)
    DIM last AS STRING
    DIM hasMsg AS STRING
    DIM rc AS STRING
    DIM hasErr AS STRING
    DIM pullL AS STRING
    DIM postL AS STRING
    DIM errL AS STRING
    DIM okL AS STRING

    pullL = NEWLBL$("bmsg.pull")
    postL = NEWLBL$("bmsg.post")
    okL = NEWLBL$("call.ok")

    errL = NEWLBL$("call.err")
    IF catchN > 0 THEN errL = catchLbl[catchN - 1]

    last = NEWTMP$()
    W("  " + last + " = call ptr @jdrt_last_error(ptr " + rt + ")")
    hasMsg = NEWTMP$()
    W("  " + hasMsg + " = icmp ne ptr " + last + ", null")
    W("  br i1 " + hasMsg + ", label %" + pullL + ", label %" + postL)

    W(pullL + ":")
    W("  call void @jdb_err_set(ptr " + last + ", i64 1)")
    W("  call void @jdrt_clear_last_error(ptr " + rt + ")")
    W("  br label %" + postL)

    W(postL + ":")
    rc = NEWTMP$()
    W("  " + rc + " = call i64 @jdb_err_code()")
    hasErr = NEWTMP$()
    W("  " + hasErr + " = icmp ne i64 " + rc + ", 0")
    W("  br i1 " + hasErr + ", label %" + errL + ", label %" + okL)

    IF catchN = 0 THEN
        W(errL + ":")
        W("  call void @jdb_throw_uncaught()")
        W("  unreachable")
    ENDIF

    W(okL + ":")
ENDSUB

' The wire tags the runtime uses for a value, from jdb_tags.h.
CONST TAG_I64 = 0
CONST TAG_F64 = 1
CONST TAG_STR = 2
CONST TAG_ARR = 3
CONST TAG_MAP = 4

FUNC WIRE_TAG(ty AS INTEGER) AS INTEGER
    IF ty = TY_STR THEN RETURN TAG_STR
    IF ty = TY_MAP THEN RETURN TAG_MAP
    IF IS_ARR(ty) = 1 THEN RETURN TAG_ARR
    RETURN TAG_F64
ENDFUNC

' Anything that is not already a double reaches the runtime as its bits in
' one, with the tag saying what to make of them.
FUNC AS_CELL$(v AS STRING, ty AS INTEGER) AS STRING
    DIM bits AS STRING
    DIM t AS STRING
    IF ty = TY_ANY THEN
        t = NEWTMP$()
        W("  " + t + " = bitcast i64 " + v + " to double")
        RETURN t
    ENDIF
    IF IS_PTRISH(ty) = 0 THEN RETURN AS_NUM$(v, ty)
    bits = NEWTMP$()
    W("  " + bits + " = ptrtoint ptr " + v + " to i64")
    t = NEWTMP$()
    W("  " + t + " = bitcast i64 " + bits + " to double")
    RETURN t
ENDFUNC

' { "k": v, ... } sets each entry with the tag its value carries, so what
' goes in is what comes back out.
FUNC G_MAP_LIT$(ix AS INTEGER) AS STRING
    DIM i AS INTEGER
    DIM n AS INTEGER
    DIM handle AS STRING
    DIM v AS STRING
    DIM vt AS INTEGER
    DIM cell AS STRING
    DIM tag AS STRING
    DIM keyC AS STRING

    handle = NEWTMP$()
    W("  " + handle + " = call ptr @jdb_map_new()")

    n = CINT(exArgN[ix])
    FOR i = 0 TO n - 1
        keyC = STR_CONST$(keyBuf[CINT(exKeyAt[ix]) + i])
        v = G_EXPR(CINT(argBuf[CINT(exArgAt[ix]) + i]))
        vt = lastType
        cell = AS_CELL$(v, vt)
        tag = TAG_OF$(vt)
        W("  call void @jdb_map_set_tagged(ptr " + handle + ", ptr " + keyC + ", double " + cell + ", i32 " + tag + ")")
    NEXT i

    lastType = TY_MAP
    RETURN handle
ENDFUNC

' Reading a map or a mixed array gives back both halves: the bits, and what
' to make of them.
FUNC G_TAGGED_READ$(handle AS STRING, keyOrIdx AS STRING, isMap AS INTEGER) AS STRING
    DIM slot AS STRING
    DIM tag AS STRING
    DIM raw AS STRING
    DIM bits AS STRING

    IF isMap = 1 THEN
        tag = NEWTMP$()
        W("  " + tag + " = call i32 @jdb_map_get_tagged(ptr " + handle + ", ptr " + keyOrIdx + ", ptr %tvval)")
        bits = NEWTMP$()
        W("  " + bits + " = load i64, ptr %tvval")
        lastTag = tag
        lastType = TY_ANY
        RETURN bits
    ENDIF

    raw = NEWTMP$()
    W("  " + raw + " = call double @jdb_array_get_tagged(ptr " + handle + ", i64 " + keyOrIdx + ", ptr %tvtag)")
    tag = NEWTMP$()
    W("  " + tag + " = load i32, ptr %tvtag")
    bits = NEWTMP$()
    W("  " + bits + " = bitcast double " + raw + " to i64")
    lastTag = tag
    lastType = TY_ANY
    RETURN bits
ENDFUNC

' [a, b, c] grows an empty array one element at a time, which is what the
' reference does and what lets the elements differ from each other.
FUNC G_ARRAY_LIT$(ix AS INTEGER) AS STRING
    DIM i AS INTEGER
    DIM n AS INTEGER
    DIM handle AS STRING
    DIM nextH AS STRING
    DIM v AS STRING
    DIM vt AS INTEGER

    handle = NEWTMP$()
    W("  " + handle + " = call ptr @jdb_array_new(i64 0)")

    n = CINT(exArgN[ix])
    FOR i = 0 TO n - 1
        v = G_EXPR(CINT(argBuf[CINT(exArgAt[ix]) + i]))
        vt = lastType
        nextH = NEWTMP$()
        W("  " + nextH + " = call ptr @jdb_array_append_tagged(ptr " + handle + ", double " + AS_CELL$(v, vt) + ", i32 " + STR$(WIRE_TAG(vt)) + ")")
        handle = nextH
    NEXT i

    lastType = TY_ARRA
    RETURN handle
ENDFUNC

FUNC G_EXPR(ix AS INTEGER) AS STRING
    DIM k AS INTEGER
    DIM t AS STRING
    DIM nm AS STRING
    DIM ty AS INTEGER
    DIM v AS STRING

    IF ix < 0 THEN
        lastType = TY_NUM
        RETURN "0.0"
    ENDIF
    k = CINT(exKind[ix])

    IF k = X_LIT_INT THEN
        lastType = TY_NUM
        RETURN NUMLIT$(exInt[ix])
    ENDIF
    IF k = X_LIT_FLOAT THEN
        lastType = TY_NUM
        RETURN NUMLIT$(exFloat[ix])
    ENDIF
    IF k = X_LIT_STR THEN
        lastType = TY_STR
        RETURN STR_CONST$(exStr[ix])
    ENDIF

    IF k = X_VARIABLE THEN
        nm = exStr[ix]
        ty = CINT(BI_FIND(nm))
        IF ty >= 0 ANDALSO biSig[ty] = "" THEN RETURN G_BUILTIN$(ty, -1)
        ty = CINT(SYM_TYPE(nm))
        t = NEWTMP$()
        W("  " + t + " = load " + LL_TY$(ty) + ", ptr " + SYM_REF$(nm))
        IF ty = TY_ANY THEN
            lastTag = EXTRACT_TAG$(t)
            lastType = TY_ANY
            RETURN EXTRACT_BITS$(t)
        ENDIF
        lastType = ty
        RETURN t
    ENDIF

    IF k = X_UNARY THEN
        v = G_EXPR(CINT(exRight[ix]))
        t = NEWTMP$()
        W("  " + t + " = fneg double " + AS_NUM$(v, lastType))
        lastType = TY_NUM
        RETURN t
    ENDIF

    IF k = X_LIT_BOOL THEN
        lastType = TY_BOOL
        IF exBool[ix] <> 0 THEN RETURN "true"
        RETURN "false"
    ENDIF

    IF k = X_ARRAY_LIT THEN RETURN G_ARRAY_LIT$(ix)
    IF k = X_MAP_LIT THEN RETURN G_MAP_LIT$(ix)

    IF k = X_BINARY THEN RETURN G_BINARY(ix)
    IF k = X_INDEX THEN RETURN G_INDEX$(ix)
    IF k = X_CALL THEN RETURN G_CALL$(ix)

    genError = "cannot generate expression kind " + STR$(k)
    lastType = TY_NUM
    RETURN "0.0"
ENDFUNC

' LLVM wants a decimal point on a floating literal.
FUNC NUMLIT$(v AS DOUBLE) AS STRING
    DIM s AS STRING
    s = STR$(v)
    IF INSTR(s, ".") < 0 ANDALSO INSTR(s, "e") < 0 THEN s = s + ".0"
    RETURN s
ENDFUNC

' ── Statements ─────────────────────────────────────────────────────────────


SUB G_BODY(at AS INTEGER, n AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF genError <> "" THEN RETURN
        G_STMT(CINT(bodyBuf[at + i]))
    NEXT i
ENDSUB

FUNC EMIT_FRMV$(v AS STRING) AS STRING
    DIM t AS STRING
    t = NEWTMP$()
    W("  " + t + " = call ptr @jdb_frmv(ptr " + v + ")")
    RETURN t
ENDFUNC

' A tagged value is printed for what its tag says it is, decided while the
' program runs rather than while it is compiled.
SUB G_PRINT_TAGGED(bits AS STRING, tag AS STRING)
    DIM isArr AS STRING
    DIM isBool AS STRING
    DIM isStr AS STRING
    DIM arrL AS STRING
    DIM boolL AS STRING
    DIM strL AS STRING
    DIM numL AS STRING
    DIM chk1 AS STRING
    DIM chk2 AS STRING
    DIM joinL AS STRING
    DIM p AS STRING

    arrL = NEWLBL$("pr.arr")
    boolL = NEWLBL$("pr.bool")
    strL = NEWLBL$("pr.str")
    numL = NEWLBL$("pr.num")
    chk1 = NEWLBL$("pr.chk1")
    chk2 = NEWLBL$("pr.chk2")
    joinL = NEWLBL$("pr.join")

    isArr = NEWTMP$()
    W("  " + isArr + " = icmp eq i32 " + tag + ", " + STR$(TAG_ARR))
    W("  br i1 " + isArr + ", label %" + arrL + ", label %" + chk1)

    W(arrL + ":")
    W("  call void @jdb_print_str(ptr " + EMIT_FRMV$(ANY_AS_PTR$(bits)) + ")")
    W("  br label %" + joinL)

    W(chk1 + ":")
    isBool = NEWTMP$()
    W("  " + isBool + " = icmp eq i32 " + tag + ", 8")
    W("  br i1 " + isBool + ", label %" + boolL + ", label %" + chk2)

    W(boolL + ":")
    W("  call void @jdb_print_bool(i64 " + bits + ")")
    W("  br label %" + joinL)

    W(chk2 + ":")
    isStr = NEWTMP$()
    W("  " + isStr + " = icmp eq i32 " + tag + ", " + STR$(TAG_STR))
    W("  br i1 " + isStr + ", label %" + strL + ", label %" + numL)

    W(strL + ":")
    p = ANY_AS_PTR$(bits)
    W("  call void @jdb_print_str(ptr " + p + ")")
    W("  br label %" + joinL)

    W(numL + ":")
    W("  call void @jdb_print_double(double " + AS_NUM$(bits, TY_ANY) + ")")
    W("  br label %" + joinL)

    W(joinL + ":")
ENDSUB

SUB G_PRINT(ix AS INTEGER)
    DIM i AS INTEGER
    DIM v AS STRING
    DIM w2 AS STRING
    DIM sep AS INTEGER

    FOR i = 0 TO stPrN[ix] - 1
        sep = CINT(sepBuf[CINT(stSepAt[ix]) + i])
        IF sep = 1 THEN W("  call void @jdb_print_space()")
        v = G_EXPR(CINT(prBuf[CINT(stPrAt[ix]) + i]))
        IF lastType = TY_ANY THEN
            G_PRINT_TAGGED(v, lastTag)
            CONTINUEFOR
        ENDIF
        IF IS_ARR(lastType) = 1 OR lastType = TY_MAP THEN
            W("  call void @jdb_print_str(ptr " + EMIT_FRMV$(v) + ")")
            CONTINUEFOR
        ENDIF
        IF lastType = TY_STR THEN
            W("  call void @jdb_print_str(ptr " + v + ")")
        ELSE
            IF lastType = TY_BOOL THEN
                w2 = NEWTMP$()
                W("  " + w2 + " = zext i1 " + v + " to i64")
                W("  call void @jdb_print_bool(i64 " + w2 + ")")
            ELSE
                W("  call void @jdb_print_double(double " + v + ")")
            ENDIF
        ENDIF
    NEXT i
    IF stNoNl[ix] = 0 THEN W("  call void @jdb_print_nl()")
ENDSUB

SUB G_IF(ix AS INTEGER)
    DIM b AS INTEGER
    DIM cond AS STRING
    DIM cmp AS STRING
    DIM thenL AS STRING
    DIM elseL AS STRING
    DIM endL AS STRING
    DIM at AS INTEGER

    endL = NEWLBL$("if.end")
    FOR b = 0 TO stBrN[ix] - 1
        at = CINT(stBrAt[ix]) + b
        IF brCond[at] < 0 THEN
            G_BODY(CINT(brBodyAt[at]), CINT(brBodyN[at]))
        ELSE
            thenL = NEWLBL$("if.then")
            elseL = NEWLBL$("if.else")
            cond = AS_NUM$(G_EXPR(CINT(brCond[at])), lastType)
            cmp = NEWTMP$()
            W("  " + cmp + " = fcmp one double " + cond + ", 0.0")
            W("  br i1 " + cmp + ", label %" + thenL + ", label %" + elseL)
            W(thenL + ":")
            G_BODY(CINT(brBodyAt[at]), CINT(brBodyN[at]))
            W("  br label %" + endL)
            W(elseL + ":")
        ENDIF
    NEXT b
    W("  br label %" + endL)
    W(endL + ":")
ENDSUB

SUB PUSH_LOOP(breakL AS STRING, nextL AS STRING)
    loopBreak[loopN] = breakL
    loopNext[loopN] = nextL
    loopN = loopN + 1
ENDSUB

SUB POP_LOOP()
    IF loopN > 0 THEN loopN = loopN - 1
ENDSUB

SUB G_DO(ix AS INTEGER)
    DIM topL AS STRING
    DIM bodyL AS STRING
    DIM endL AS STRING
    DIM cond AS STRING
    DIM cmp AS STRING

    topL = NEWLBL$("do.top")
    bodyL = NEWLBL$("do.body")
    endL = NEWLBL$("do.end")

    W("  br label %" + topL)
    W(topL + ":")
    IF stCond[ix] >= 0 ANDALSO stTop[ix] = 1 THEN
        cond = AS_NUM$(G_EXPR(CINT(stCond[ix])), lastType)
        cmp = NEWTMP$()
        IF stUntil[ix] = 1 THEN
            W("  " + cmp + " = fcmp oeq double " + cond + ", 0.0")
        ELSE
            W("  " + cmp + " = fcmp one double " + cond + ", 0.0")
        ENDIF
        W("  br i1 " + cmp + ", label %" + bodyL + ", label %" + endL)
    ELSE
        W("  br label %" + bodyL)
    ENDIF
    W(bodyL + ":")
    PUSH_LOOP(endL, topL)
    G_BODY(CINT(stBodyAt[ix]), CINT(stBodyN[ix]))
    POP_LOOP()
    IF stCond[ix] >= 0 ANDALSO stTop[ix] = 0 THEN
        cond = AS_NUM$(G_EXPR(CINT(stCond[ix])), lastType)
        cmp = NEWTMP$()
        IF stUntil[ix] = 1 THEN
            W("  " + cmp + " = fcmp oeq double " + cond + ", 0.0")
        ELSE
            W("  " + cmp + " = fcmp one double " + cond + ", 0.0")
        ENDIF
        W("  br i1 " + cmp + ", label %" + topL + ", label %" + endL)
    ELSE
        W("  br label %" + topL)
    ENDIF
    W(endL + ":")
ENDSUB

SUB G_FOR(ix AS INTEGER)
    DIM nm AS STRING
    DIM slot AS STRING
    DIM startV AS STRING
    DIM endV AS STRING
    DIM stepV AS STRING
    DIM topL AS STRING
    DIM bodyL AS STRING
    DIM stepL AS STRING
    DIM endL AS STRING
    DIM curV AS STRING
    DIM upTest AS STRING
    DIM downTest AS STRING
    DIM goingUp AS STRING
    DIM cmp AS STRING
    DIM nextV AS STRING
    DIM loadV AS STRING

    nm = stVar[ix]
    slot = SYM_REF$(nm)
    startV = G_EXPR(CINT(stExpr[ix]))
    W("  store double " + AS_NUM$(startV, lastType) + ", ptr " + slot)

    ' The step is evaluated once, before the loop, because the direction of the
    ' comparison depends on its sign and the condition sits at the top.
    IF stStep[ix] >= 0 THEN
        stepV = AS_NUM$(G_EXPR(CINT(stStep[ix])), lastType)
    ELSE
        stepV = "1.0"
    ENDIF
    goingUp = NEWTMP$()
    W("  " + goingUp + " = fcmp oge double " + stepV + ", 0.0")

    topL = NEWLBL$("for.top")
    bodyL = NEWLBL$("for.body")
    stepL = NEWLBL$("for.step")
    endL = NEWLBL$("for.end")

    W("  br label %" + topL)
    W(topL + ":")
    curV = NEWTMP$()
    W("  " + curV + " = load double, ptr " + slot)
    endV = AS_NUM$(G_EXPR(CINT(stEnd[ix])), lastType)
    upTest = NEWTMP$()
    W("  " + upTest + " = fcmp ole double " + curV + ", " + endV)
    downTest = NEWTMP$()
    W("  " + downTest + " = fcmp oge double " + curV + ", " + endV)
    cmp = NEWTMP$()
    W("  " + cmp + " = select i1 " + goingUp + ", i1 " + upTest + ", i1 " + downTest)
    W("  br i1 " + cmp + ", label %" + bodyL + ", label %" + endL)
    W(bodyL + ":")
    PUSH_LOOP(endL, stepL)
    G_BODY(CINT(stBodyAt[ix]), CINT(stBodyN[ix]))
    POP_LOOP()
    W("  br label %" + stepL)
    W(stepL + ":")
    loadV = NEWTMP$()
    W("  " + loadV + " = load double, ptr " + slot)
    nextV = NEWTMP$()
    W("  " + nextV + " = fadd double " + loadV + ", " + stepV)
    W("  store double " + nextV + ", ptr " + slot)
    W("  br label %" + topL)
    W(endL + ":")
ENDSUB

' DIM a[n] is a runtime handle rather than a stack object, so the slot holds a
' pointer the runtime owns.
SUB G_DIM_ARRAY(ix AS INTEGER, nm AS STRING, ty AS INTEGER)
    DIM callNd AS INTEGER
    DIM lit AS INTEGER
    DIM n64 AS STRING
    DIM handle AS STRING

    callNd = CINT(stExpr[ix])
    IF callNd < 0 THEN
        ' DIM x AS ARRAY names a slot without sizing it, the same empty array
        ' the reference puts there until something is assigned.
        n64 = "0"
    ELSE
        lit = CINT(argBuf[CINT(exArgAt[callNd])])
        IF exArgN[lit] = 2 THEN
            G_DIM_2D(nm, ty, CINT(argBuf[CINT(exArgAt[lit])]), CINT(argBuf[CINT(exArgAt[lit]) + 1]))
            RETURN
        ENDIF
        IF exArgN[lit] <> 1 THEN
            genError = "only one or two dimensions are supported, " + nm + " has " + STR$(exArgN[lit])
            RETURN
        ENDIF
        n64 = G_IDX$(CINT(argBuf[CINT(exArgAt[lit])]))
    ENDIF
    handle = NEWTMP$()
    W("  " + handle + " = call ptr @jdb_array_new(i64 " + n64 + ")")
    IF ty = TY_ARRS THEN W("  call void @jdb_array_set_string_elems(ptr " + handle + ")")
    W("  store ptr " + handle + ", ptr " + SYM_REF$(nm))
ENDSUB

' DIM a[rows, cols] is an array of arrays, built a row at a time. Reading it
' back needs nothing new: the outer read answers a tagged value whose tag
' says array, and the second subscript works on that.
SUB G_DIM_2D(nm AS STRING, ty AS INTEGER, rowsE AS INTEGER, colsE AS INTEGER)
    DIM iName AS STRING
    DIM oName AS STRING
    DIM rows AS STRING
    DIM topL AS STRING
    DIM bodyL AS STRING
    DIM endL AS STRING
    DIM outer AS STRING
    DIM inner AS STRING
    DIM idxV AS STRING
    DIM cmp AS STRING
    DIM cols AS STRING
    DIM grown AS STRING
    DIM nextV AS STRING

    iName = "__dim" + STR$(eachNo) + "i"
    oName = "__dim" + STR$(eachNo) + "o"
    eachNo = eachNo + 1
    GV_ADD(iName, TY_NUM)
    GV_ADD(oName, TY_ARRA)

    outer = NEWTMP$()
    W("  " + outer + " = call ptr @jdb_array_new(i64 0)")
    W("  store ptr " + outer + ", ptr @v_" + oName)
    W("  store double 0.0, ptr @v_" + iName)
    rows = G_IDX$(rowsE)

    topL = NEWLBL$("dim2d.top")
    bodyL = NEWLBL$("dim2d.body")
    endL = NEWLBL$("dim2d.end")

    W("  br label %" + topL)
    W(topL + ":")
    idxV = NEWTMP$()
    W("  " + idxV + " = load double, ptr @v_" + iName)
    nextV = NEWTMP$()
    W("  " + nextV + " = sitofp i64 " + rows + " to double")
    cmp = NEWTMP$()
    W("  " + cmp + " = fcmp olt double " + idxV + ", " + nextV)
    W("  br i1 " + cmp + ", label %" + bodyL + ", label %" + endL)

    W(bodyL + ":")
    cols = G_IDX$(colsE)
    inner = NEWTMP$()
    W("  " + inner + " = call ptr @jdb_array_new(i64 " + cols + ")")
    IF ty = TY_ARRS THEN W("  call void @jdb_array_set_string_elems(ptr " + inner + ")")
    outer = NEWTMP$()
    W("  " + outer + " = load ptr, ptr @v_" + oName)
    grown = NEWTMP$()
    W("  " + grown + " = call ptr @jdb_array_append_tagged(ptr " + outer + ", double " + AS_CELL$(inner, TY_ARRA) + ", i32 " + STR$(TAG_ARR) + ")")
    W("  store ptr " + grown + ", ptr @v_" + oName)
    idxV = NEWTMP$()
    W("  " + idxV + " = load double, ptr @v_" + iName)
    nextV = NEWTMP$()
    W("  " + nextV + " = fadd double " + idxV + ", 1.0")
    W("  store double " + nextV + ", ptr @v_" + iName)
    W("  br label %" + topL)

    W(endL + ":")
    outer = NEWTMP$()
    W("  " + outer + " = load ptr, ptr @v_" + oName)
    W("  call void @jdb_array_set_nested(ptr " + outer + ")")
    W("  store ptr " + outer + ", ptr " + SYM_REF$(nm))
ENDSUB

SUB G_INDEX_ASSIGN(ix AS INTEGER)
    DIM nm AS STRING
    DIM ty AS INTEGER
    DIM handle AS STRING
    DIM iv AS STRING
    DIM v AS STRING
    DIM bits AS STRING
    DIM cell AS STRING
    DIM keyV AS STRING
    DIM i AS INTEGER

    nm = stVar[ix]
    ty = CINT(SYM_TYPE(nm))
    IF IS_ARR(ty) = 0 ANDALSO ty <> TY_MAP ANDALSO ty <> TY_ANY THEN
        genError = nm + " is not an array"
        RETURN
    ENDIF

    handle = NEWTMP$()
    W("  " + handle + " = load " + LL_TY$(ty) + ", ptr " + SYM_REF$(nm))
    IF ty = TY_ANY THEN
        handle = ANY_AS_PTR$(EXTRACT_BITS$(handle))
        ty = TY_ARRA
        IF E_TYPE(CINT(ixBuf[CINT(stIxAt[ix])])) = TY_STR THEN ty = TY_MAP
    ENDIF

    ' Every subscript but the last walks one level in; the last one is where
    ' the value lands.
    FOR i = 0 TO stIxN[ix] - 2
        handle = G_STEP_IN$(handle, ty, CINT(ixBuf[CINT(stIxAt[ix]) + i]))
        ty = TY_ARRA
        IF E_TYPE(CINT(ixBuf[CINT(stIxAt[ix]) + i + 1])) = TY_STR THEN ty = TY_MAP
    NEXT i

    IF ty = TY_MAP THEN
        keyV = G_EXPR(CINT(ixBuf[CINT(stIxAt[ix]) + stIxN[ix] - 1]))
        v = G_EXPR(CINT(stExpr[ix]))
        W("  call void @jdb_map_set_tagged(ptr " + handle + ", ptr " + keyV + ", double " + AS_CELL$(v, lastType) + ", i32 " + TAG_OF$(lastType) + ")")
        RETURN
    ENDIF

    iv = G_IDX$(CINT(ixBuf[CINT(stIxAt[ix]) + stIxN[ix] - 1]))
    v = G_EXPR(CINT(stExpr[ix]))
    W("  call void @jdb_array_set(ptr " + handle + ", i64 " + iv + ", double " + AS_CELL$(v, lastType) + ")")
    IF ELEM_TY(ty) = TY_STR THEN W("  call void @jdb_array_set_string_elems(ptr " + handle + ")")
ENDSUB

' Reads one subscript of a nested container and hands back the pointer the
' next subscript works on.
FUNC G_STEP_IN$(handle AS STRING, ty AS INTEGER, idxExpr AS INTEGER) AS STRING
    DIM iv AS STRING
    DIM keyV AS STRING
    DIM bits AS STRING

    IF ty = TY_MAP THEN
        keyV = G_EXPR(idxExpr)
        bits = G_TAGGED_READ$(handle, keyV, 1)
        RETURN ANY_AS_PTR$(bits)
    ENDIF
    iv = G_IDX$(idxExpr)
    bits = G_TAGGED_READ$(handle, iv, 0)
    RETURN ANY_AS_PTR$(bits)
ENDFUNC

FUNC EXTRACT_BITS$(pair AS STRING) AS STRING
    DIM t AS STRING
    t = NEWTMP$()
    W("  " + t + " = extractvalue {i64, i32} " + pair + ", 0")
    RETURN t
ENDFUNC

FUNC EXTRACT_TAG$(pair AS STRING) AS STRING
    DIM t AS STRING
    t = NEWTMP$()
    W("  " + t + " = extractvalue {i64, i32} " + pair + ", 1")
    RETURN t
ENDFUNC

SUB G_STORE(nm AS STRING, ix AS INTEGER)
    DIM v AS STRING
    DIM ty AS INTEGER
    DIM vt AS INTEGER
    DIM half AS STRING
    DIM pair AS STRING

    v = G_EXPR(ix)
    vt = lastType
    ty = CINT(SYM_TYPE(nm))

    ' A tagged slot keeps both halves, so a plain value has to be dressed as
    ' one on the way in.
    IF ty = TY_ANY THEN
        half = NEWTMP$()
        W("  " + half + " = insertvalue {i64, i32} undef, i64 " + AS_BITS$(v, vt) + ", 0")
        pair = NEWTMP$()
        W("  " + pair + " = insertvalue {i64, i32} " + half + ", i32 " + TAG_OF$(vt) + ", 1")
        W("  store {i64, i32} " + pair + ", ptr " + SYM_REF$(nm))
        RETURN
    ENDIF

    IF LL_TY$(ty) = "ptr" THEN
        W("  store ptr " + COERCE$(v, vt, ty) + ", ptr " + SYM_REF$(nm))
    ELSE
        W("  store double " + COERCE$(v, vt, ty) + ", ptr " + SYM_REF$(nm))
    ENDIF
ENDSUB

SUB G_RETURN(ix AS INTEGER)
    DIM v AS STRING

    IF inRoutine = 0 THEN
        genError = "RETURN outside a routine"
        RETURN
    ENDIF
    IF curIsSub = 1 THEN
        W("  ret void")
    ELSE
        IF ix >= 0 ANDALSO stExpr[ix] >= 0 THEN
            v = G_EXPR(CINT(stExpr[ix]))
            IF LL_TY$(curRet) = "ptr" THEN
                W("  ret ptr " + v)
            ELSE
                W("  ret double " + AS_NUM$(v, lastType))
            ENDIF
        ELSE
            W("  ret " + LL_TY$(curRet) + " " + ZERO_OF$(curRet))
        ENDIF
    ENDIF
    W(NEWLBL$("after.ret") + ":")
ENDSUB

' A routine becomes its own define. Parameters arrive in registers and are
' copied into the same kind of slot a declaration gets, so both are assignable.
SUB G_ROUTINE(ix AS INTEGER)
    DIM nm AS STRING
    DIM f AS INTEGER
    DIM i AS INTEGER
    DIM pat AS INTEGER
    DIM pty AS INTEGER
    DIM sig AS STRING
    DIM prologue AS STRING
    DIM savedIr AS STRING
    DIM rty AS STRING

    nm = stFunc[ix]
    f = CINT(FN_FIND(nm))
    IF f < 0 THEN RETURN

    lvN = 0
    inRoutine = 1
    curIsSub = CINT(fnIsSub[f])
    curRet = CINT(fnRet[f])
    pat = CINT(fnParAt[f])

    FOR i = 0 TO fnParN[f] - 1
        LV_ADD(parName[pat + i], CINT(PARAM_TY(pat + i)))
    NEXT i
    SCAN_DECLS(CINT(stBodyAt[ix]), CINT(stBodyN[ix]), 1)

    sig = ""
    FOR i = 0 TO fnParN[f] - 1
        IF i > 0 THEN sig = sig + ", "
        sig = sig + LL_TY$(CINT(PARAM_TY(pat + i))) + " %p" + STR$(i)
    NEXT i

    prologue = ""
    prologue = prologue + "  %bargs = alloca i64, i32 " + STR$(BRIDGE_MAX) + CHR$(10)
    prologue = prologue + "  %btags = alloca i32, i32 " + STR$(BRIDGE_MAX) + CHR$(10)
    prologue = prologue + "  %tvval = alloca i64" + CHR$(10)
    prologue = prologue + "  %tvtag = alloca i32" + CHR$(10)
    FOR i = 0 TO lvN - 1
        prologue = prologue + "  %l_" + lvName[i] + " = alloca " + LL_TY$(CINT(lvType[i])) + CHR$(10)
        prologue = prologue + "  store " + LL_TY$(CINT(lvType[i])) + " " + ZERO_OF$(CINT(lvType[i]))
        prologue = prologue + ", ptr %l_" + lvName[i] + CHR$(10)
    NEXT i
    FOR i = 0 TO fnParN[f] - 1
        pty = CINT(PARAM_TY(pat + i))
        prologue = prologue + "  store " + LL_TY$(pty) + " %p" + STR$(i)
        prologue = prologue + ", ptr %l_" + parName[pat + i] + CHR$(10)
    NEXT i

    savedIr = ir
    ir = ""
    G_BODY(CINT(stBodyAt[ix]), CINT(stBodyN[ix]))

    rty = "void"
    IF curIsSub = 0 THEN rty = LL_TY$(curRet)
    fnDefs = fnDefs + "define " + rty + " @f_" + nm + "(" + sig + ") {" + CHR$(10)
    fnDefs = fnDefs + "entry:" + CHR$(10) + prologue + ir
    IF curIsSub = 1 THEN
        fnDefs = fnDefs + "  ret void" + CHR$(10)
    ELSE
        fnDefs = fnDefs + "  ret " + rty + " " + ZERO_OF$(curRet) + CHR$(10)
    ENDIF
    fnDefs = fnDefs + "}" + CHR$(10) + CHR$(10)

    ir = savedIr
    inRoutine = 0
    lvN = 0
ENDSUB

' TRY runs its body with the failure path aimed at CATCH, which clears the
' error before it runs. FINALLY follows either way.
SUB G_TRY(ix AS INTEGER)
    DIM bodyL AS STRING
    DIM catchL AS STRING
    DIM endL AS STRING

    bodyL = NEWLBL$("try.body")
    catchL = NEWLBL$("try.catch")
    endL = NEWLBL$("try.end")

    W("  br label %" + bodyL)
    W(bodyL + ":")

    catchLbl[catchN] = catchL
    catchN = catchN + 1
    G_BODY(CINT(stBodyAt[ix]), CINT(stBodyN[ix]))
    catchN = catchN - 1

    W("  br label %" + endL)
    W(catchL + ":")
    W("  call void @jdb_err_code_clear()")
    G_BODY(CINT(stCatchAt[ix]), CINT(stCatchN[ix]))
    W("  br label %" + endL)

    W(endL + ":")
    G_BODY(CINT(stFinAt[ix]), CINT(stFinN[ix]))
ENDSUB

' FOR EACH walks the collection by index, which is what the reference does.
SUB G_FOR_EACH(ix AS INTEGER)
    DIM nm AS STRING
    DIM idxName AS STRING
    DIM handleName AS STRING
    DIM topL AS STRING
    DIM bodyL AS STRING
    DIM stepL AS STRING
    DIM endL AS STRING
    DIM src AS STRING
    DIM srcTy AS INTEGER
    DIM idxV AS STRING
    DIM iv AS STRING
    DIM lim AS STRING
    DIM cmp AS STRING
    DIM elem AS STRING
    DIM bits AS STRING
    DIM nextV AS STRING
    DIM handle AS STRING

    nm = stVar[ix]
    idxName = "__each" + STR$(eachNo)
    handleName = "__eachsrc" + STR$(eachNo)
    eachNo = eachNo + 1
    GV_ADD(idxName, TY_NUM)
    GV_ADD(handleName, TY_ARRN)

    src = G_EXPR(CINT(stExpr[ix]))
    srcTy = lastType
    W("  store ptr " + src + ", ptr @v_" + handleName)
    W("  store double 0.0, ptr @v_" + idxName)

    topL = NEWLBL$("each.top")
    bodyL = NEWLBL$("each.body")
    stepL = NEWLBL$("each.step")
    endL = NEWLBL$("each.end")

    W("  br label %" + topL)
    W(topL + ":")
    idxV = NEWTMP$()
    W("  " + idxV + " = load double, ptr @v_" + idxName)
    handle = NEWTMP$()
    W("  " + handle + " = load ptr, ptr @v_" + handleName)
    lim = EMIT_RT$("jdb_array_len", "ptr " + handle, "I")
    cmp = NEWTMP$()
    W("  " + cmp + " = fcmp olt double " + idxV + ", " + lim)
    W("  br i1 " + cmp + ", label %" + bodyL + ", label %" + endL)

    W(bodyL + ":")
    iv = NEWTMP$()
    W("  " + iv + " = fptosi double " + idxV + " to i64")
    elem = NEWTMP$()
    W("  " + elem + " = call double @jdb_array_get(ptr " + handle + ", i64 " + iv + ")")
    IF ELEM_TY(CINT(SYM_TYPE(nm))) = TY_STR OR SYM_TYPE(nm) = TY_STR THEN
        bits = NEWTMP$()
        W("  " + bits + " = bitcast double " + elem + " to i64")
        nextV = NEWTMP$()
        W("  " + nextV + " = inttoptr i64 " + bits + " to ptr")
        W("  store ptr " + nextV + ", ptr " + SYM_REF$(nm))
    ELSE
        W("  store double " + elem + ", ptr " + SYM_REF$(nm))
    ENDIF

    PUSH_LOOP(endL, stepL)
    G_BODY(CINT(stBodyAt[ix]), CINT(stBodyN[ix]))
    POP_LOOP()

    W("  br label %" + stepL)
    W(stepL + ":")
    idxV = NEWTMP$()
    W("  " + idxV + " = load double, ptr @v_" + idxName)
    nextV = NEWTMP$()
    W("  " + nextV + " = fadd double " + idxV + ", 1.0")
    W("  store double " + nextV + ", ptr @v_" + idxName)
    W("  br label %" + topL)
    W(endL + ":")
ENDSUB

SUB G_STMT(ix AS INTEGER)
    DIM k AS INTEGER
    DIM nm AS STRING

    IF ix < 0 THEN RETURN
    IF genError <> "" THEN RETURN
    k = CINT(stKind[ix])

    IF k = K_OPTION THEN RETURN

    IF k = K_DIM OR k = K_LET THEN
        nm = stVar[ix]
        IF IS_ARR(CINT(SYM_TYPE(nm))) = 1 ANDALSO HAS_BOUNDS(ix) = 1 THEN
            G_DIM_ARRAY(ix, nm, CINT(SYM_TYPE(nm)))
            RETURN
        ENDIF
        IF stExpr[ix] >= 0 THEN G_STORE(nm, CINT(stExpr[ix]))
        RETURN
    ENDIF

    IF k = K_ASSIGN THEN
        G_STORE(stVar[ix], CINT(stExpr[ix]))
        RETURN
    ENDIF

    IF k = K_INDEX_ASSIGN THEN
        G_INDEX_ASSIGN(ix)
        RETURN
    ENDIF

    IF k = K_PRINT THEN
        G_PRINT(ix)
        RETURN
    ENDIF
    IF k = K_IF THEN
        G_IF(ix)
        RETURN
    ENDIF
    IF k = K_DO_LOOP THEN
        G_DO(ix)
        RETURN
    ENDIF
    IF k = K_FOR_LOOP THEN
        G_FOR(ix)
        RETURN
    ENDIF
    IF k = K_FOR_EACH THEN
        G_FOR_EACH(ix)
        RETURN
    ENDIF
    IF k = K_TRY_CATCH THEN
        G_TRY(ix)
        RETURN
    ENDIF

    ' A type declaration says what a name means and asks for no code.
    IF k = K_TYPE_DECL THEN RETURN
    ' STOP is a place to break into a debugger, and compiles away.
    IF k = K_STOP THEN RETURN

    IF k = K_SLEEP THEN
        nm = TO_INT$(G_EXPR(CINT(stExpr[ix])), lastType, "i64")
        W("  call void @jdb_sleep(i64 " + nm + ")")
        RETURN
    ENDIF

    IF k = K_THROW THEN
        nm = G_EXPR(CINT(stExpr[ix]))
        W("  call void @jdb_err_set(ptr " + nm + ", i64 1)")
        G_CHECK_ERR(G_RT_HANDLE$())
        RETURN
    ENDIF

    IF k = K_FUNCTION OR k = K_SUB THEN
        G_ROUTINE(ix)
        RETURN
    ENDIF
    IF k = K_RETURN THEN
        G_RETURN(ix)
        RETURN
    ENDIF
    IF k = K_EXPR_STMT THEN
        nm = G_EXPR(CINT(stExpr[ix]))
        RETURN
    ENDIF

    ' EXITFUNC is the exit that names no loop.
    IF k = K_EXIT_LOOP THEN
        IF stUntil[ix] = 0 THEN
            G_RETURN(-1)
            RETURN
        ENDIF
        IF loopN = 0 THEN
            genError = "EXIT outside a loop"
            RETURN
        ENDIF
        W("  br label %" + loopBreak[loopN - 1])
        W(NEWLBL$("after.exit") + ":")
        RETURN
    ENDIF
    IF k = K_CONTINUE_LOOP THEN
        IF loopN = 0 THEN
            genError = "CONTINUE outside a loop"
            RETURN
        ENDIF
        W("  br label %" + loopNext[loopN - 1])
        W(NEWLBL$("after.continue") + ":")
        RETURN
    ENDIF

    IF k = K_END_STMT THEN
        IF inRoutine = 1 THEN
            genError = "END inside a routine"
            RETURN
        ENDIF
        W("  ret i32 0")
        W(NEWLBL$("after.end") + ":")
        RETURN
    ENDIF

    genError = "cannot generate statement kind " + STR$(k)
ENDSUB

' ── Assembling the module ──────────────────────────────────────────────────

FUNC DECLS$() AS STRING
    DIM d AS STRING
    DIM i AS INTEGER
    d = "declare void @jdb_print_double(double)" + CHR$(10)
    d = d + "declare void @jdb_print_str(ptr)" + CHR$(10)
    d = d + "declare void @jdb_print_bool(i64)" + CHR$(10)
    d = d + "declare void @jdb_print_space()" + CHR$(10)
    d = d + "declare void @jdb_print_nl()" + CHR$(10)
    d = d + "declare ptr @jdb_str_concat(ptr, ptr)" + CHR$(10)
    d = d + "declare i64 @jdb_str_eq(ptr, ptr)" + CHR$(10)
    d = d + "declare i64 @jdb_str_ne(ptr, ptr)" + CHR$(10)
    d = d + "declare i64 @jdb_str_cmp(ptr, ptr)" + CHR$(10)
    d = d + "declare ptr @jdb_array_new(i64)" + CHR$(10)
    d = d + "declare void @jdb_array_set(ptr, i64, double)" + CHR$(10)
    d = d + "declare double @jdb_array_get(ptr, i64)" + CHR$(10)
    d = d + "declare void @jdb_array_set_string_elems(ptr)" + CHR$(10)
    d = d + "declare i64 @jdb_array_len(ptr)" + CHR$(10)
    d = d + "declare ptr @jdb_array_append_tagged(ptr, double, i32)" + CHR$(10)
    d = d + "declare void @jdb_set_args(i32, ptr)" + CHR$(10)
    d = d + "declare ptr @jdrt_init()" + CHR$(10)
    d = d + "declare void @jdb_runtime_set_handle(ptr)" + CHR$(10)
    d = d + "declare void @jdrt_set_event_dispatcher(ptr, ptr)" + CHR$(10)
    d = d + "declare void @jdrt_dispatch_event(ptr, ptr, ptr, i32)" + CHR$(10)
    d = d + "declare ptr @jdrt_last_error(ptr)" + CHR$(10)
    d = d + "declare void @jdrt_clear_last_error(ptr)" + CHR$(10)
    d = d + "declare void @jdb_err_set(ptr, i64)" + CHR$(10)
    d = d + "declare i64 @jdb_err_code()" + CHR$(10)
    d = d + "declare void @jdb_throw_uncaught()" + CHR$(10)
    d = d + "declare void @jdb_err_code_clear()" + CHR$(10)
    d = d + "declare void @jdb_sleep(i64)" + CHR$(10)
    d = d + "declare double @jdb_pow(double, double)" + CHR$(10)
    d = d + "declare ptr @jdb_map_new()" + CHR$(10)
    d = d + "declare void @jdb_map_set_tagged(ptr, ptr, double, i32)" + CHR$(10)
    d = d + "declare i32 @jdb_map_get_tagged(ptr, ptr, ptr)" + CHR$(10)
    d = d + "declare double @jdb_array_get_tagged(ptr, i64, ptr)" + CHR$(10)
    d = d + "declare ptr @jdb_frmv(ptr)" + CHR$(10)
    d = d + "declare void @jdb_array_set_nested(ptr)" + CHR$(10)
    d = d + "declare double @jdrt_call_typed_f64(ptr, ptr, ptr, ptr, i32)" + CHR$(10)
    d = d + "declare ptr @jdrt_call_typed_str(ptr, ptr, ptr, ptr, i32)" + CHR$(10)
    d = d + "declare ptr @jdrt_call_typed_arr(ptr, ptr, ptr, ptr, i32)" + CHR$(10)
    d = d + "declare void @jdrt_call_typed_void(ptr, ptr, ptr, ptr, i32)" + CHR$(10)
    FOR i = 0 TO biN - 1
        d = d + "declare " + biDeclRet[i] + " @" + biSym[i]
        d = d + "(" + biDeclArgs[i] + ")" + CHR$(10)
    NEXT i

    ' Only the registry entries this module actually called, and only once
    ' each: a symbol the list above already names is not repeated.
    FOR i = 0 TO natN - 1
        IF natUsed[i] = 1 ANDALSO INSTR(d, "@" + natSym[i] + "(") < 0 THEN
            d = d + "declare " + LL_OF_LETTER$(natRet[i]) + " @" + natSym[i]
            d = d + "(" + NAT_DECL_ARGS$(i) + ")" + CHR$(10)
        ENDIF
    NEXT i
    RETURN d
ENDFUNC

FUNC NAT_DECL_ARGS$(i AS INTEGER) AS STRING
    DIM j AS INTEGER
    DIM s AS STRING
    s = ""
    FOR j = 0 TO LEN(natArgs[i]) - 1
        IF j > 0 THEN s = s + ", "
        s = s + LL_OF_LETTER$(MID$(natArgs[i], j, 1))
    NEXT j
    RETURN s
ENDFUNC

FUNC GENERATE$() AS STRING
    DIM body AS STRING
    DIM head AS STRING
    DIM i AS INTEGER
    DIM j AS INTEGER

    ir = ""
    fnDefs = ""
    strDecl = ""
    tmpNo = 0
    lblNo = 0
    gvN = 0
    lvN = 0
    loopN = 0
    catchN = 0
    eachNo = 0
    strN = 0
    inRoutine = 0
    genError = ""

    BI_INIT()
    FOR i = 0 TO natN - 1
        natUsed[i] = 0
    NEXT i

    ' Routines are hoisted and a global can be declared below the routine that
    ' reads it, so both are collected before a single instruction is emitted.
    SCAN_ROUTINES()
    SCAN_DECLS(topAt, topN, 0)

    G_RUNTIME_INIT()
    FOR j = 0 TO topN - 1
        G_STMT(CINT(bodyBuf[topAt + j]))
    NEXT j
    body = ir

    IF genError <> "" THEN RETURN ""

    head = "; generated by selfhost/jdbc.jdb" + CHR$(10)
    head = head + "target triple = " + CHR$(34) + "x86_64-pc-windows-msvc" + CHR$(34) + CHR$(10)
    head = head + CHR$(10) + DECLS$()
    head = head + CHR$(10) + strDecl + CHR$(10)

    FOR i = 0 TO gvN - 1
        head = head + "@v_" + gvName[i] + " = internal global "
        head = head + LL_TY$(CINT(gvType[i])) + " " + ZERO_OF$(CINT(gvType[i])) + CHR$(10)
    NEXT i

    head = head + "@__jdrt_handle = internal global ptr null" + CHR$(10)
    head = head + CHR$(10) + fnDefs
    head = head + "define i32 @main(i32 %argc, ptr %argv) {" + CHR$(10)
    head = head + "entry:" + CHR$(10)
    RETURN head + body + "  ret i32 0" + CHR$(10) + "}" + CHR$(10)
ENDFUNC

' ── Main ───────────────────────────────────────────────────────────────────

DIM args AS ARRAY
DIM path AS STRING
DIM mode AS STRING
DIM argAt AS INTEGER
DIM j AS INTEGER

lexError = ""
parseError = ""
exCount = 0
stCount = 0
argN = 0
keyN = 0
lpN = 0
lcN = 0
tmpNodeN = 0
tmN = 0
emN = 0
prN = 0
sepN = 0
ixN = 0
bodyN = 0
parN = 0
brN = 0
outBuf = ""

args = OS.ARGS
IF LEN(args) < 2 THEN
    PRINT "usage: jdbasic selfhost/jdbc.jdb [--tokens|--ast] <file.jdb> [out.ll]"
    END
ENDIF

mode = "compile"
argAt = 1
IF args[1] = "--tokens" THEN
    mode = "tokens"
    argAt = 2
ENDIF
IF args[1] = "--ast" THEN
    mode = "ast"
    argAt = 2
ENDIF
IF LEN(args) <= argAt THEN
    PRINT "usage: jdbasic selfhost/jdbc.jdb [--tokens|--ast] <file.jdb> [out.ll]"
    END
ENDIF
path = args[argAt]

nativesPath = "selfhost/jdbc_natives.txt"

LOAD_TABLES()
LOAD_NATIVES()
LOAD_CMD_KEYWORDS()
LOAD_STMT_TABLES()

' The reference reads source in text mode, which folds CRLF to LF.
src = REPLACE$(TXTREADER$(path), CHR$(13) + CHR$(10), CHR$(10))
TOKENIZE()
IF lexError <> "" THEN
    PRINT "LEX ERROR: "; lexError
    END
ENDIF

IF mode = "tokens" THEN
    EMIT_TOKENS()
    END
ENDIF

P_PROGRAM()
IF parseError <> "" THEN
    PRINT "PARSE ERROR: "; parseError
    END
ENDIF

IF mode = "ast" THEN
    FOR j = 0 TO topN - 1
        D_STMT(CINT(bodyBuf[topAt + j]), 0)
    NEXT j
    PRINT outBuf;
    END
ENDIF

DIM modText AS STRING
modText = GENERATE$()
IF genError <> "" THEN
    PRINT "CODEGEN ERROR: "; genError
    END
ENDIF
IF LEN(args) > argAt + 1 THEN
    TXTWRITER args[argAt + 1], modText
ELSE
    PRINT modText;
ENDIF
