DIM KT_AS AS INTEGER

DIM vtypeTok[32]
DIM vtypeVal[32]
DIM vtypeN AS INTEGER

DIM V_ARRAY AS INTEGER

' State shared between the import machinery and the driver.

DIM baseDir AS STRING

DIM impMods[64] AS STRING
DIM impModsN AS INTEGER

' Statements an import hands back, in a bump arena so nesting cannot
' step on a window someone else is still copying out of.
DIM impBuf[8192]
DIM impN AS INTEGER
DIM impRetAt AS INTEGER
DIM impRetN AS INTEGER

' Buffers the stages fill and the driver reads out.

DIM outBuf AS STRING
DIM genError AS STRING
DIM nativesPath AS STRING

' ── The compiler proper, one module per stage ──────────────────────────────

IMPORT JDBC_LEX
IMPORT JDBC_PAR
IMPORT JDBC_DMP
IMPORT JDBC_GEN

' ── Main ───────────────────────────────────────────────────────────────────

DIM args AS ARRAY
DIM path AS STRING
DIM mode AS STRING
DIM argAt AS INTEGER
DIM j AS INTEGER

lexError = ""
parseError = ""
exCount = 0
stCount = 0
argN = 0
keyN = 0
lpN = 0
lcN = 0
tmpNodeN = 0
tmN = 0
emN = 0
prN = 0
sepN = 0
ixN = 0
ctN = 0
dvN = 0
pendHead = 0
pendTail = 0
bodyN = 0
parN = 0
brN = 0
caseN = 0
outBuf = ""

args = OS.ARGS
IF LEN(args) < 2 THEN
    PRINT "usage: jdbasic selfhost/jdbc.jdb [--tokens|--ast] <file.jdb> [out.ll]"
    END
ENDIF

mode = "compile"
argAt = 1
IF args[1] = "--tokens" THEN
    mode = "tokens"
    argAt = 2
ENDIF
IF args[1] = "--ast" THEN
    mode = "ast"
    argAt = 2
ENDIF
IF LEN(args) <= argAt THEN
    PRINT "usage: jdbasic selfhost/jdbc.jdb [--tokens|--ast] <file.jdb> [out.ll]"
    END
ENDIF
path = args[argAt]

' Modules are looked for beside the program, the way the reference does.
baseDir = ""
FOR j = LEN(path) - 1 TO 0 STEP -1
    IF MID$(path, j, 1) = "/" ORELSE MID$(path, j, 1) = CHR$(92) THEN
        baseDir = LEFT$(path, j)
        EXITFOR
    ENDIF
NEXT j
IF baseDir = "" THEN baseDir = "."
impModsN = 0
impN = 0

nativesPath = "selfhost/jdbc_natives.txt"

LOAD_TABLES()
JDBC_GEN.LOAD_NATIVES()
JDBC_PAR.LOAD_CMD_KEYWORDS()
JDBC_GEN.LOAD_HOF()
JDBC_PAR.LOAD_STMT_TABLES()

' The reference reads source in text mode, which folds CRLF to LF.
src = REPLACE$(TXTREADER$(path), CHR$(13) + CHR$(10), CHR$(10))
JDBC_LEX.TOKENIZE()
IF lexError <> "" THEN
    PRINT "LEX ERROR: "; lexError
    END
ENDIF

IF mode = "tokens" THEN
    JDBC_DMP.EMIT_TOKENS()
    END
ENDIF

JDBC_PAR.P_PROGRAM()
IF parseError <> "" THEN
    PRINT "PARSE ERROR: "; parseError
    END
ENDIF

IF mode = "ast" THEN
    FOR j = 0 TO topN - 1
        JDBC_DMP.D_STMT(CINT(bodyBuf[topAt + j]), 0)
    NEXT j
    PRINT outBuf;
    END
ENDIF

DIM modText AS STRING
modText = JDBC_GEN.GENERATE$()
IF genError <> "" THEN
    PRINT "CODEGEN ERROR: "; genError
    END
ENDIF
IF LEN(args) > argAt + 1 THEN
    TXTWRITER args[argAt + 1], modText
ELSE
    PRINT modText;
ENDIF
