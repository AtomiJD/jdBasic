OPTION EXPLICIT

' Generates selfhost/jdbc_tokens.jdb from src/token.h.
'
' The self-hosted lexer has to agree with the reference lexer on the numeric
' TokenType, because that is what --dump-tokens prints and what the
' differential test compares. Typing 141 enum entries by hand would be a
' source of exactly the errors the test is meant to catch, so they are read
' out of the header instead.
'
'   jdbasic selfhost/gen_tokens.jdb

DIM src AS STRING
DIM out AS STRING
DIM i AS INTEGER
DIM lineStart AS INTEGER
DIM lineEnd AS INTEGER
DIM ln AS STRING
DIM inEnum AS INTEGER
DIM inKw AS INTEGER
DIM idx AS INTEGER
DIM piece AS STRING
DIM rest AS STRING
DIM p AS INTEGER
DIM nameCount AS INTEGER
DIM kwCount AS INTEGER

DIM tokNames[400] AS STRING
DIM kwWord[400] AS STRING
DIM kwName[400] AS STRING

' ── Read the header line by line ───────────────────────────────────────────

src = TXTREADER$("src/token.h")
PRINT "read src/token.h ("; LEN(src); " bytes)"

inEnum = 0
inKw = 0
idx = 0
nameCount = 0
kwCount = 0
lineStart = 0

DO
    IF lineStart >= LEN(src) THEN EXITDO
    lineEnd = INSTR(MID$(src, lineStart, LEN(src) - lineStart), CHR$(10))
    IF lineEnd < 0 THEN
        ln = MID$(src, lineStart, LEN(src) - lineStart)
        lineStart = LEN(src)
    ELSE
        ln = MID$(src, lineStart, lineEnd)
        lineStart = lineStart + lineEnd + 1
    ENDIF

    ' Strip a trailing carriage return and any // comment.
    IF LEN(ln) > 0 AND BYTEAT(ln, LEN(ln) - 1) = 13 THEN ln = LEFT$(ln, LEN(ln) - 1)
    p = INSTR(ln, "//")
    IF p >= 0 THEN ln = LEFT$(ln, p)
    ln = TRIM$(ln)

    ' ── The enum gives the numbering: position is the value ────────────────
    IF INSTR(ln, "enum class TokenType") >= 0 THEN
        inEnum = 1
    ELSE
        IF inEnum = 1 AND INSTR(ln, "};") >= 0 THEN
            inEnum = 0
        ELSE
            IF inEnum = 1 AND LEN(ln) > 0 THEN
                rest = ln
                DO
                    IF LEN(rest) = 0 THEN EXITDO
                    p = INSTR(rest, ",")
                    IF p < 0 THEN
                        piece = TRIM$(rest)
                        rest = ""
                    ELSE
                        piece = TRIM$(LEFT$(rest, p))
                        rest = MID$(rest, p + 1, LEN(rest) - p - 1)
                    ENDIF
                    IF LEN(piece) > 0 THEN
                        tokNames[nameCount] = piece
                        nameCount = nameCount + 1
                    ENDIF
                LOOP
            ENDIF
        ENDIF
    ENDIF

    ' ── The keyword map gives word to token name ───────────────────────────
    IF INSTR(ln, "keywords()") >= 0 THEN inKw = 1
    IF inKw = 1 AND INSTR(ln, "TokenType::") >= 0 THEN
        rest = ln
        DO
            p = INSTR(rest, CHR$(34))
            IF p < 0 THEN EXITDO
            rest = MID$(rest, p + 1, LEN(rest) - p - 1)
            p = INSTR(rest, CHR$(34))
            IF p < 0 THEN EXITDO
            piece = LEFT$(rest, p)
            rest = MID$(rest, p + 1, LEN(rest) - p - 1)

            p = INSTR(rest, "TokenType::")
            IF p < 0 THEN EXITDO
            rest = MID$(rest, p + 11, LEN(rest) - p - 11)
            p = INSTR(rest, "}")
            IF p < 0 THEN EXITDO
            kwWord[kwCount] = piece
            kwName[kwCount] = TRIM$(LEFT$(rest, p))
            kwCount = kwCount + 1
            rest = MID$(rest, p + 1, LEN(rest) - p - 1)
        LOOP
    ENDIF
    IF inKw = 1 AND INSTR(ln, "return kw;") >= 0 THEN inKw = 0
LOOP

PRINT "enum entries: "; nameCount
PRINT "keywords:     "; kwCount

' ── Write the jdBasic table ────────────────────────────────────────────────

out = ""
out = out + "' Generated by selfhost/gen_tokens.jdb from src/token.h." + CHR$(10)
out = out + "' The numbers are the TokenType enum values the reference lexer prints." + CHR$(10)
out = out + "' Regenerate after any change to that enum." + CHR$(10)
out = out + CHR$(10)
out = out + "EXPORT MODULE JDBC_TOKENS" + CHR$(10)
out = out + CHR$(10)
out = out + "DIM TOK_NAME[" + STR$(nameCount) + "] AS STRING" + CHR$(10)
out = out + "DIM KW_WORD[" + STR$(kwCount) + "] AS STRING" + CHR$(10)
out = out + "DIM KW_TYPE[" + STR$(kwCount) + "]" + CHR$(10)
out = out + "DIM TOK_COUNT AS INTEGER" + CHR$(10)
out = out + "DIM KW_COUNT AS INTEGER" + CHR$(10)
out = out + CHR$(10)
out = out + "SUB INIT()" + CHR$(10)
out = out + "    TOK_COUNT = " + STR$(nameCount) + CHR$(10)
out = out + "    KW_COUNT = " + STR$(kwCount) + CHR$(10)

FOR i = 0 TO nameCount - 1
    out = out + "    TOK_NAME[" + STR$(i) + "] = " + CHR$(34) + tokNames[i] + CHR$(34) + CHR$(10)
NEXT i

FOR i = 0 TO kwCount - 1
    out = out + "    KW_WORD[" + STR$(i) + "] = " + CHR$(34) + kwWord[i] + CHR$(34)
    out = out + " : KW_TYPE[" + STR$(i) + "] = " + STR$(TOK_INDEX(tokNames, nameCount, kwName[i]))
    out = out + CHR$(10)
NEXT i

out = out + "ENDSUB" + CHR$(10)

TXTWRITER "selfhost/jdbc_tokens.jdb", out
PRINT "wrote selfhost/jdbc_tokens.jdb ("; LEN(out); " bytes)"

FUNC TOK_INDEX(names AS ARRAY, n AS INTEGER, want AS STRING) AS INTEGER
    DIM j AS INTEGER
    FOR j = 0 TO n - 1
        IF names[j] = want THEN RETURN j
    NEXT j
    PRINT "WARNING: no enum entry for "; want
    RETURN -1
ENDFUNC
