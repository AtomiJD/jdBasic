OPTION EXPLICIT

' Generates selfhost/jdbc_tokens.jdb from src/token.h and src/ast.h.
'
' The self-hosted front end has to agree with the reference on four numberings:
' TokenType, which --dump-tokens prints, and StmtKind, ExprKind and VarType,
' which --dump-ast prints. Writing 300-odd enum entries by hand would be a
' source of exactly the errors those comparisons exist to catch, so they are
' read out of the headers instead.
'
'   jdbasic selfhost/gen_tokens.jdb

DIM eNames[400] AS STRING
DIM eCount AS INTEGER

DIM kwWord[400] AS STRING
DIM kwName[400] AS STRING
DIM kwCount AS INTEGER

DIM tokNames[400] AS STRING
DIM tokCount AS INTEGER

DIM out AS STRING

' ── Reading an enum out of a header ────────────────────────────────────────

FUNC NEXT_LINE$(txt AS STRING, fromPos AS INTEGER) AS STRING
    DIM nl AS INTEGER
    nl = CINT(INSTR(MID$(txt, fromPos, LEN(txt) - fromPos), CHR$(10)))
    IF nl < 0 THEN RETURN MID$(txt, fromPos, LEN(txt) - fromPos)
    RETURN MID$(txt, fromPos, nl)
ENDFUNC

FUNC STRIP$(ln AS STRING) AS STRING
    DIM p AS INTEGER
    DIM r AS STRING
    r = ln
    IF LEN(r) > 0 ANDALSO BYTEAT(r, LEN(r) - 1) = 13 THEN r = LEFT$(r, LEN(r) - 1)
    p = CINT(INSTR(r, "//"))
    IF p >= 0 THEN r = LEFT$(r, p)
    RETURN TRIM$(r)
ENDFUNC

' Fills eNames in declaration order, which is what the enum values are.
SUB READ_ENUM(path AS STRING, enumName AS STRING)
    DIM txt AS STRING
    DIM ln AS STRING
    DIM rest AS STRING
    DIM piece AS STRING
    DIM at AS INTEGER
    DIM p AS INTEGER
    DIM inside AS INTEGER

    eCount = 0
    inside = 0
    txt = TXTREADER$(path)
    at = 0
    DO
        IF at >= LEN(txt) THEN EXITDO
        ln = NEXT_LINE$(txt, at)
        at = at + LEN(ln) + 1
        ln = STRIP$(ln)

        IF INSTR(ln, "enum class " + enumName) >= 0 THEN
            inside = 1
            CONTINUEDO
        ENDIF
        IF inside = 0 THEN CONTINUEDO
        IF INSTR(ln, "};") >= 0 THEN EXITDO
        IF LEN(ln) = 0 THEN CONTINUEDO

        rest = ln
        DO
            IF LEN(rest) = 0 THEN EXITDO
            p = CINT(INSTR(rest, ","))
            IF p < 0 THEN
                piece = TRIM$(rest)
                rest = ""
            ELSE
                piece = TRIM$(LEFT$(rest, p))
                rest = MID$(rest, p + 1, LEN(rest) - p - 1)
            ENDIF
            IF LEN(piece) > 0 THEN
                eNames[eCount] = piece
                eCount = eCount + 1
            ENDIF
        LOOP
    LOOP
ENDSUB

FUNC E_INDEX(want AS STRING) AS INTEGER
    DIM j AS INTEGER
    FOR j = 0 TO tokCount - 1
        IF tokNames[j] = want THEN RETURN j
    NEXT j
    PRINT "WARNING: no TokenType entry for "; want
    RETURN -1
ENDFUNC

SUB EMIT_TABLE(prefix AS STRING)
    DIM i AS INTEGER
    out = out + "    " + prefix + "_COUNT = " + STR$(eCount) + CHR$(10)
    FOR i = 0 TO eCount - 1
        out = out + "    " + prefix + "[" + STR$(i) + "] = "
        out = out + CHR$(34) + eNames[i] + CHR$(34) + CHR$(10)
    NEXT i
ENDSUB

SUB EMIT_HEADER(prefix AS STRING, n AS INTEGER)
    out = out + "DIM " + prefix + "[" + STR$(n) + "] AS STRING" + CHR$(10)
    out = out + "DIM " + prefix + "_COUNT AS INTEGER" + CHR$(10)
ENDSUB

' ── The keyword map ────────────────────────────────────────────────────────

SUB READ_KEYWORDS()
    DIM txt AS STRING
    DIM ln AS STRING
    DIM rest AS STRING
    DIM at AS INTEGER
    DIM p AS INTEGER
    DIM inKw AS INTEGER

    kwCount = 0
    inKw = 0
    txt = TXTREADER$("src/token.h")
    at = 0
    DO
        IF at >= LEN(txt) THEN EXITDO
        ln = NEXT_LINE$(txt, at)
        at = at + LEN(ln) + 1
        ln = STRIP$(ln)

        IF INSTR(ln, "keywords()") >= 0 THEN inKw = 1
        IF inKw = 1 ANDALSO INSTR(ln, "TokenType::") >= 0 THEN
            rest = ln
            DO
                p = CINT(INSTR(rest, CHR$(34)))
                IF p < 0 THEN EXITDO
                rest = MID$(rest, p + 1, LEN(rest) - p - 1)
                p = CINT(INSTR(rest, CHR$(34)))
                IF p < 0 THEN EXITDO
                kwWord[kwCount] = LEFT$(rest, p)
                rest = MID$(rest, p + 1, LEN(rest) - p - 1)

                p = CINT(INSTR(rest, "TokenType::"))
                IF p < 0 THEN EXITDO
                rest = MID$(rest, p + 11, LEN(rest) - p - 11)
                p = CINT(INSTR(rest, "}"))
                IF p < 0 THEN EXITDO
                kwName[kwCount] = TRIM$(LEFT$(rest, p))
                kwCount = kwCount + 1
                rest = MID$(rest, p + 1, LEN(rest) - p - 1)
            LOOP
        ENDIF
        IF inKw = 1 ANDALSO INSTR(ln, "return kw;") >= 0 THEN inKw = 0
    LOOP
ENDSUB

' ── Main ───────────────────────────────────────────────────────────────────

DIM i AS INTEGER

out = ""
out = out + "' Generated by selfhost/gen_tokens.jdb from src/token.h and src/ast.h." + CHR$(10)
out = out + "' These are the numbers --dump-tokens and --dump-ast print." + CHR$(10)
out = out + "' Regenerate after any change to those enums." + CHR$(10)
out = out + CHR$(10)
out = out + "EXPORT MODULE JDBC_TOKENS" + CHR$(10)
out = out + CHR$(10)

READ_ENUM("src/token.h", "TokenType")
tokCount = eCount
FOR i = 0 TO eCount - 1
    tokNames[i] = eNames[i]
NEXT i
EMIT_HEADER("TOK_NAME", tokCount)

READ_ENUM("src/ast.h", "StmtKind")
EMIT_HEADER("STMT_NAME", eCount)

READ_ENUM("src/ast.h", "ExprKind")
EMIT_HEADER("EXPR_NAME", eCount)

READ_ENUM("src/ast.h", "VarType")
EMIT_HEADER("VTYPE_NAME", eCount)

READ_KEYWORDS()
out = out + "DIM KW_WORD[" + STR$(kwCount) + "] AS STRING" + CHR$(10)
out = out + "DIM KW_TYPE[" + STR$(kwCount) + "]" + CHR$(10)
out = out + "DIM KW_COUNT AS INTEGER" + CHR$(10)
out = out + CHR$(10)
out = out + "SUB INIT()" + CHR$(10)

READ_ENUM("src/token.h", "TokenType")
EMIT_TABLE("TOK_NAME")
READ_ENUM("src/ast.h", "StmtKind")
EMIT_TABLE("STMT_NAME")
READ_ENUM("src/ast.h", "ExprKind")
EMIT_TABLE("EXPR_NAME")
READ_ENUM("src/ast.h", "VarType")
EMIT_TABLE("VTYPE_NAME")

out = out + "    KW_COUNT = " + STR$(kwCount) + CHR$(10)
FOR i = 0 TO kwCount - 1
    out = out + "    KW_WORD[" + STR$(i) + "] = " + CHR$(34) + kwWord[i] + CHR$(34)
    out = out + " : KW_TYPE[" + STR$(i) + "] = " + STR$(E_INDEX(kwName[i]))
    out = out + CHR$(10)
NEXT i

out = out + "ENDSUB" + CHR$(10)

TXTWRITER "selfhost/jdbc_tokens.jdb", out
PRINT "TokenType entries: "; tokCount
PRINT "keywords:          "; kwCount
PRINT "wrote selfhost/jdbc_tokens.jdb ("; LEN(out); " bytes)"
