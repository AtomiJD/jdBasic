OPTION EXPLICIT

' S0 of the self-hosting plan: prove the back half of the pipeline from
' jdBasic. This program writes LLVM IR as text, hands it to the clang that
' ships in libs/LLVM/bin, and runs what comes back.
'
' No compiler in here yet. The point is that a jdBasic program can produce a
' working binary without touching the LLVM C API, without encoding a single
' instruction, and without a linker of its own.
'
'   jdbasic selfhost/s0_pipeline.jdb

DIM root AS STRING
DIM outDir AS STRING
DIM irPath AS STRING
DIM exePath AS STRING
DIM ir AS STRING
DIM msg AS STRING
DIM cmd AS STRING
DIM res AS MAP

root = "."
outDir = root + "/tmp"
irPath = outDir + "/s0_hello.ll"
exePath = outDir + "/s0_hello.exe"

' ── The module ─────────────────────────────────────────────────────────────
'
' Two declarations from the jdBasic runtime and a main that calls them. This
' is the shape the self-hosted compiler will emit: the runtime stays C++ and
' the generated code only knows how to call it.

ir = ""
ir = ir + "; generated by selfhost/s0_pipeline.jdb" + CHR$(10)
ir = ir + "target triple = " + CHR$(34) + "x86_64-pc-windows-msvc" + CHR$(34) + CHR$(10)
ir = ir + CHR$(10)
ir = ir + "declare void @jdb_print_str(ptr)" + CHR$(10)
ir = ir + "declare void @jdb_print_int(i64)" + CHR$(10)
ir = ir + "declare void @jdb_print_nl()" + CHR$(10)
ir = ir + CHR$(10)
' The array length is computed rather than counted by hand: the text plus a
' newline and the terminator.
msg = "jdBasic emitted this module"
ir = ir + "@.msg = private unnamed_addr constant ["
ir = ir + STR$(LEN(msg) + 2) + " x i8] c" + CHR$(34)
ir = ir + msg + "\0A\00" + CHR$(34) + CHR$(10)
ir = ir + CHR$(10)
ir = ir + "define i32 @main(i32 %argc, ptr %argv) {" + CHR$(10)
ir = ir + "entry:" + CHR$(10)
ir = ir + "  call void @jdb_print_str(ptr @.msg)" + CHR$(10)
ir = ir + "  %sum = add i64 40, 2" + CHR$(10)
ir = ir + "  call void @jdb_print_int(i64 %sum)" + CHR$(10)
ir = ir + "  call void @jdb_print_nl()" + CHR$(10)
ir = ir + "  ret i32 0" + CHR$(10)
ir = ir + "}" + CHR$(10)

MKDIR outDir
TXTWRITER irPath, ir
PRINT "wrote "; irPath; " ("; LEN(ir); " bytes)"

' ── Hand it to clang ───────────────────────────────────────────────────────
'
' jdb_runtime.obj carries the runtime entry points the module calls; jdbrt.lib
' resolves what that object needs in turn.

' The program itself needs backslashes for the Windows shell; its arguments
' are fine either way.
cmd = "libs\LLVM\bin\clang.exe " + irPath
cmd = cmd + " " + root + "/build/jdb_runtime.obj"
cmd = cmd + " " + root + "/build/jdbrt.lib"
cmd = cmd + " -o " + exePath

PRINT "clang ..."
res = OS.EXEC(cmd)
IF res{"EXIT_CODE"} <> 0 THEN
    PRINT "clang failed with "; res{"EXIT_CODE"}
    PRINT res{"OUTPUT"}
    END
ENDIF

' ── Run it ─────────────────────────────────────────────────────────────────

' Same rule for the produced binary: the shell wants a backslash path.
res = OS.EXEC("tmp\s0_hello.exe")
PRINT "--- output of the generated binary ---"
PRINT res{"OUTPUT"};
PRINT "--- exit "; res{"EXIT_CODE"}; " ---"

IF INSTR(res{"OUTPUT"}, "42") >= 0 THEN
    PRINT "S0 OK"
ELSE
    PRINT "S0 FAILED: expected 42 in the output"
ENDIF
