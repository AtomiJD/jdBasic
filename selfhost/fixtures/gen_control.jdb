DIM n AS INTEGER
DIM total AS INTEGER
DIM i AS INTEGER
n = 0
DO
    n = n + 1
LOOP WHILE n < 10
PRINT "loop n="; n
total = 0
FOR i = 1 TO 5
    total = total + i * i
NEXT i
PRINT "squares="; total
IF total > 50 THEN
    PRINT "big"
ELSE
    PRINT "small"
ENDIF
IF n = 10 THEN PRINT "ten"
FOR i = 10 TO 1 STEP -3
    PRINT i
NEXT i
