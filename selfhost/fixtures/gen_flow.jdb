OPTION EXPLICIT

' The statement forms that reach the runtime rather than plain arithmetic.

DIM total AS DOUBLE
DIM it AS DOUBLE
DIM name AS STRING

PRINT 2 ^ 10
PRINT 3 ^ 0.5

total = 0
FOR EACH it IN [5, 10, 15, 20]
    total = total + it
NEXT it
PRINT total

total = 0
FOR EACH it IN IOTA(6)
    IF it = 3 THEN CONTINUEFOR
    IF it > 5 THEN EXITFOR
    total = total + it
NEXT it
PRINT total

DIM words AS ARRAY
words = ["alpha", "beta", "gamma"]
FOR EACH name IN words
    PRINT name
NEXT name

TRY
    PRINT "before"
    THROW "deliberate"
    PRINT "unreachable"
CATCH
    PRINT "caught"
ENDTRY
PRINT "after"

TRY
    PRINT "quiet"
CATCH
    PRINT "not reached"
FINALLY
    PRINT "finally"
ENDTRY

' Bit patterns and membership.
DIM p AS DOUBLE
DIM q AS DOUBLE
p = 6
q = 3
PRINT p BAND q
PRINT p BOR q
PRINT p BXOR q
PRINT p SHL 2
PRINT p SHR 1
DIM hay AS STRING
hay = "haystack"
PRINT "stack" IN hay
PRINT "needle" IN hay

' Taking a value apart, and choosing among cases.
DIM u
DIM v
[u, v] = [11, 22]
PRINT u
PRINT v

DIM pick AS DOUBLE
pick = 2
SWITCH pick
  CASE 1
    PRINT "one"
  CASE 2
    PRINT "two"
  DEFAULT
    PRINT "other"
ENDSWITCH

SWITCH pick
  CASE 9
    PRINT "nine"
  DEFAULT
    PRINT "fell through"
ENDSWITCH
