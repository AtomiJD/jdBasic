' Find a substring with INSTR. INSTR is 0-based and returns -1 when the
' substring is absent, so presence is tested with >= 0.
OPTION "EXPLICIT"
OPTION "STRICT"
DIM haystack$ = "jdBasic compiles to native code"
DIM needle$ = "native"
DIM pos = INSTR(haystack$, needle$)
IF pos >= 0 THEN
    PRINT "found at 0-based position "; pos
ELSE
    PRINT "not found"
ENDIF
