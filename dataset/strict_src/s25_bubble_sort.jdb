' Sort an array in place with bubble sort. The source array is copied
' with + 0 first so the original stays untouched.
OPTION "EXPLICIT"
OPTION "STRICT"
DIM nums = [5, 1, 4, 2, 8]
DIM work = nums + 0
DIM n_items = LEN(work)
DIM i = 0
DIM j = 0
DIM tmp = 0.0
FOR i = 0 TO n_items - 2
    FOR j = 0 TO n_items - 2 - i
        IF work[j] > work[j + 1] THEN
            tmp = work[j]
            work[j] = work[j + 1]
            work[j + 1] = tmp
        ENDIF
    NEXT j
NEXT i
PRINT "original: "; nums
PRINT "sorted  : "; work
