' Define a recursive function for the n-th Fibonacci number and print
' the first 12 Fibonacci numbers.
OPTION "EXPLICIT"
OPTION "STRICT"
FUNC fib(n)
    IF n < 2 THEN
        RETURN n
    ENDIF
    RETURN fib(n - 1) + fib(n - 2)
ENDFUNC
DIM i = 0
FOR i = 0 TO 11
    PRINT fib(i);
    IF i < 11 THEN PRINT ", ";
NEXT i
PRINT ""
