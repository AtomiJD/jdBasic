' Check whether a word is a palindrome by comparing it with its reverse.
OPTION "EXPLICIT"
OPTION "STRICT"
FUNC is_palindrome(w$)
    RETURN w$ = REVERSE$(w$)
ENDFUNC
DIM words = ["level", "world", "racecar"]
DIM i = 0
DIM w$ = ""
FOR i = 0 TO LEN(words) - 1
    w$ = words[i]
    IF is_palindrome(w$) THEN
        PRINT w$; " is a palindrome"
    ELSE
        PRINT w$; " is not a palindrome"
    ENDIF
NEXT i
