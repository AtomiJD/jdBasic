' Encrypt an uppercase word with a Caesar cipher (shift 3), wrapping
' around inside A to Z.
OPTION "EXPLICIT"
OPTION "STRICT"
DIM msg$ = "HELLO"
DIM chars = -msg$
DIM shift_by = 3
DIM i = 0
DIM c$ = ""
DIM code = 0
DIM out$ = ""
FOR i = 0 TO LEN(chars) - 1
    c$ = chars[i]
    code = ASC(c$)
    code = ((code - 65 + shift_by) MOD 26) + 65
    out$ = out$ + CHR$(code)
NEXT i
PRINT msg$; " -> "; out$
