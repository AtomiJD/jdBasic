' Store prices in a map, add an entry, and print every key with its value.
OPTION "EXPLICIT"
OPTION "STRICT"
DIM prices = {}
prices{"apple"} = 1.2
prices{"bread"} = 2.5
prices{"milk"} = 0.9
DIM ks = MAP.KEYS(prices)
DIM i = 0
DIM k$ = ""
FOR i = 0 TO LEN(ks) - 1
    k$ = ks[i]
    PRINT k$; " costs "; prices{k$}
NEXT i
