' jdPlot mini - what fits on the board today.
'
' The full jdm.jdb is roughly three times more than an RP2350 can hold:
' each loaded chunk costs about nine times its source and fragments the
' heap, so the later parts fail even with 90 KB reported free. This is
' one SUB, no styles, no log axes, no legend: a title, a frame, the two
' extremes of the range, and the curve.
'
'   MTITLE$ = "sin"
'   PLOT SIN(IOTA(64, 0) / 8)

DIM MTITLE$

SUB PLOT(ys)
    DIM i, n, x0, y0, x1, y1, lo, hi, px, py
    x0 = 40
    y0 = 20
    x1 = 302
    y1 = 300
    n = LEN(ys)
    lo = MIN(ys)
    hi = MAX(ys)
    IF hi - lo <= 0 THEN hi = lo + 1
    DRAWCOLOR 0, 0, 0
    RECT 0, 0, 320, 320, 1
    DRAWCOLOR 192, 192, 192
    RECT x0, y0, x1 - x0, y1 - y0, 0
    TEXT x0, 6, MTITLE$
    TEXT 2, y0, FORMAT$("{:.2f}", hi)
    TEXT 2, y1 - 8, FORMAT$("{:.2f}", lo)
    px = x0 + IOTA(n, 0) * (x1 - x0) / (n - 1)
    py = y1 - (ys - lo) * (y1 - y0) / (hi - lo)
    DRAWCOLOR 48, 252, 48
    FOR i = 1 TO n - 1
        LINE INT(px[i - 1]), INT(py[i - 1]), INT(px[i]), INT(py[i])
    NEXT i
    SCREENFLIP
ENDSUB
