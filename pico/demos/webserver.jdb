' The board serves its own page. Keep such a program short: while it
' runs, the interpreter holds roughly thirty times its source size, and
' what is left has to cover the request, the handler and the answer.
' SYS.FREE on the page shows how much that is.
DIM hits
hits = 0

FUNC HOMEPAGE(req)
    hits = hits + 1
    RETURN "<h1>jdBasic on the PicoCalc</h1><p>hit " + STR$(hits) + _
           ", free " + STR$(SYS.FREE()) + " bytes, " + TIME$ + "</p>"
ENDFUNC

IF WIFI.CONNECT("flupp", "flupp1234") <> 0 THEN
    PRINT "no connection"
ELSE
    HTTP.SERVER.ON_GET("/", "HOMEPAGE")
    IF HTTP.SERVER.START(80) <> 0 THEN
        PRINT "cannot listen"
    ELSE
        PRINT "http://"; WIFI.IP$(); "/  free "; SYS.FREE()
        HTTP.SERVER.WAIT(300000)
        HTTP.SERVER.STOP()
        PRINT "served "; hits
    ENDIF
ENDIF
