# The 8 MB of octal PSRAM an S3R8 carries in package, layered on top of
# sdkconfig.defaults. Leaving it out is the S3FN8 configuration, which
# is what a Cardputer would give us.
#
# This needs CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240, which sdkconfig.defaults
# sets. At IDF's default of 160 MHz the first real access to PSRAM stalls
# the bus: the boot hangs inside esp_psram_extram_test(), which cpu_start
# runs right after starting the second core, and the RTC watchdog resets
# the board. The PSRAM answers on its configuration registers and the
# MSPI timing tuning completes and picks a point before that, so the
# failure looks like broken hardware and is not.
#
# Espressif's own test settles it. components/esp_psram/test_apps/psram
# with their CI configuration sdkconfig.ci.esp32s3_octal_release hangs on
# this board at 160 MHz and reports "SPI SRAM memory test OK" at 240 MHz,
# same board, same everything else. Two DevKitC-1 N16R8 behave alike, so
# it is the clock and not a bad module. esphome/esphome#15907 describes
# the same failure on the same board designation and is open.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Allocations below this stay in internal RAM. At the IDF default the
# interpreter's own tables are small enough to stay internal, which is
# what should happen, while arrays and programs go to PSRAM. Measured:
# a jdBasic array costs about 24.2 bytes an element and lands in PSRAM
# from roughly 700 elements up.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
