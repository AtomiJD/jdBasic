{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "jdbasic",
    "scopeName": "source.jdbasic",
    "patterns": [
        {
            "name": "comment.line.jdbasic",
            "patterns": [
                {
                    "name": "comment.line.rem.jdbasic",
                    "begin": "(?i)\\b(REM)\\b",
                    "end": "(?=$)"
                },
                {
                    "name": "comment.line.quote.jdbasic",
                    "begin": "'",
                    "end": "(?=$)"
                }
            ]
        },
        {
            "name": "string.quoted.double.jdbasic",
            "begin": "\"",
            "end": "\""
        },
        {
            "name": "keyword.control.jdbasic",
            "match": "(?i)\\b(IF|THEN|ELSE|ELSEIF|ENDIF|FOR|TO|STEP|NEXT|EACH|IN|DO|LOOP|WHILE|UNTIL|SWITCH|CASE|DEFAULT|ENDSWITCH|SUB|ENDSUB|FUNC|ENDFUNC|RETURN|GOTO|CALL|EXITFUNC|EXITDO|EXITFOR|TRY|CATCH|FINALLY|ENDTRY|THROW|AWAIT|ASYNC|DIM|AS|LET|TYPE|ENDTYPE|ENUM|ENDENUM|THIS|REACT|IMPORT|EXPORT|MODULE|DECLARE|OPTION|STOP|RESUME)\\b"
        },
        {
            "name": "storage.type.jdbasic",
            "match": "(?i)\\b(INTEGER|DOUBLE|STRING|MAP|ARRAY|TENSOR|JSON|DATE|BOOLEAN|BOOL|BYTE|CHAR|INT16|INT32|INT64|FLOAT16|FLOAT32|FLOAT64|OBJECT)\\b"
        },
        {
            "name": "constant.language.jdbasic",
            "match": "(?i)\\b(TRUE|FALSE|PI|E|VBNEWLINE|NONE|NULL)\\b"
        },
        {
            "name": "entity.name.type.class.jdbasic",
            "match": "(?i)\\b(AI|AUDIO|CLIPBOARD|CODEC|GFX|GUI|HTTP|JOY|JSON|MAP|MUSIC|OS|PATH|REGEX|SERIAL|SFX|SOUND|THREAD|TURTLE)\\b"
        },
        {
            "name": "support.function.jdbasic",
            "match": "(?i)\\b(TOGGLE_FULLSCREEN|REGEX_REPLACE\\$|CIRCLE_SECTOR|FIND_IN_ARRAY|RELEASEOBJECT|CREATEOBJECT|ROUNDED_RECT|CLEAR_RECUR|FORMAT_DATE|REGEX_MATCH|BINREADER\\$|LIST_RECUR|RANDOMSEED|REACT_BIND|RELEASEALL|SCREENFLIP|STARTSWITH|TXTREADER\\$|BINWRITER|CSVREADER|CSVWRITER|DRAWCOLOR|HISTOGRAM|INTEGRATE|NORMALIZE|SETLOCALE|TRANSPOSE|TXTWRITER|CONVOLVE|DATEDIFF|DISTANCE|ENDSWITH|LINSPACE|REPLACE\\$|REVERSE\\$|VARIANCE|WAITKEY\\$|CUMPROD|DATEADD|ELLIPSE|EXECUTE|FLATTEN|FORMAT\\$|GETENV\\$|INDEXOF|INSERT\\$|PLOTRAW|PRODUCT|RESHAPE|REVERSE|SETFONT|SHUFFLE|UNREACT|WEEKDAY|APPEND|BYTEAT|CIRCLE|CUMSUM|CURSOR|CVDATE|FILTER|INKEY\\$|INSTR\\$|INVERT|ISBOOL|ISNONE|ISNULL|LCASE\\$|LOCATE|LTRIM\\$|MATMUL|MEDIAN|MINUTE|MOUSEB|MOUSEX|MOUSEY|OPTION|RANDOM|REDUCE|RIGHT\\$|ROTATE|RTRIM\\$|SCREEN|SECOND|SELECT|SPACE\\$|TENSOR|TYPEOF|UCASE\\$|UNIQUE|UNPACK|ATAN2|AWAIT|CLAMP|COLOR|COUNT|CROSS|DATE\\$|FLOOR|FRMV\\$|GRADE|HELP\\$|INSTR|ISARR|ISMAP|ISNUM|ISSTR|LCASE|LEFT\\$|LOG10|MKDIR|MONTH|MVLET|OUTER|PACK\\$|PLACE|RANGE|RECUR|RIGHT|ROUND|SHIFT|SLEEP|SLICE|SOLVE|SPLIT|STACK|STDEV|TIME\\$|TONUM|TOSTR|TRIM\\$|TROFF|TRUNC|UCASE|XSORT|ZEROS|ACOS|ASIN|ATAN|BIN\\$|CDBL|CEIL|CHR\\$|COSH|DIFF|DIR\\$|DROP|DUMP|EVAL|GETX|GETY|HELP|HEX\\$|HOUR|IOTA|JOIN|KILL|LEFT|LERP|LINE|LIST|LOAD|MEAN|MID\\$|OCT\\$|ONES|PSET|PUSH|RECT|SAVE|SCAN|SINH|STR\\$|TAKE|TANH|TEXT|TICK|TRIM|TRON|VARS|YEAR|ABS|ALL|ANY|ASC|CHR|CLS|COS|DAY|DIR|DOT|EXP|FAC|IIF|INT|LEN|LOG|MAX|MID|MIN|NOW|POP|PWD|RND|SGN|SHL|SHR|SIN|SQR|STR|SUM|TAN|VAL|ZIP|CD|PI|E)\\b"
        },
        {
            "name": "support.function.jdbasic",
            "match": "(?i)\\.(ITEM_DEACTIVATED_AFTER_EDIT|CLASSIFIER_BUILD_INDEX|TABLE_SET_COLUMN_INDEX|SET_CURSOR_SCREEN_POS|CLASSIFIER_ADD_BATCH|BEGIN_MAIN_MENU_BAR|CLOSE_CURRENT_POPUP|SET_NEXT_ITEM_WIDTH|CLASSIFIER_PREDICT|SET_KEYBOARD_FOCUS|TABLE_SETUP_COLUMN|BEGIN_POPUP_MODAL|CLASSIFIER_CREATE|COLLAPSING_HEADER|END_MAIN_MENU_BAR|TABLE_HEADERS_ROW|TABLE_NEXT_COLUMN|RAG_QUERY_STREAM|CLASSIFIER_FREE|CLASSIFIER_INFO|CLASSIFIER_LOAD|CLASSIFIER_SAVE|LOAD_EMBEDDINGS|RAG_BUILD_INDEX|SHOW_FONT_ATLAS|BASE64_DECODE\\$|BASE64_ENCODE\\$|BEGIN_MENU_BAR|BEGIN_TAB_ITEM|CLASSIFIER_ADD|PLOT_HISTOGRAM|RAG_QUERY_FULL|SEPARATOR_TEXT|TABLE_NEXT_ROW|BEGIN_TAB_BAR|CLEAR_GRAMMAR|CLEAR_HISTORY|SET_JSON_MODE|WINDOW_HEIGHT|AVAIL_HEIGHT|CLEARHEADERS|END_MENU_BAR|END_TAB_ITEM|GET_BUS_WAVE|INPUT_DOUBLE|RAG_ADD_FILE|TEXT_WRAPPED|WINDOW_WIDTH|AVAIL_WIDTH|BEGIN_CHILD|BEGIN_POPUP|BEGIN_TABLE|CHAT_STREAM|END_TAB_BAR|GET_HISTORY|MOUSEBUTTON|POST_ASYNC\\$|RAG_ADD_DIR|SET_GRAMMAR|TOKEN_COUNT|TOOL_REMOVE|BEGIN_MENU|COMPRESSOR|COSINE_SIM|DETOKENIZE|DISTORTION|GET_ASYNC\\$|HELPMARKER|OPEN_POPUP|PLOT_LINES|PUT_ASYNC\\$|RAG_CREATE|RAG_SEARCH|REVERBSEND|SELECTABLE|SETHEADING|SIMILARITY|STATUSCODE|STRINGIFY\\$|AVAILABLE|BASENAME\\$|CHAT_JSON|DELAYSEND|DRAWIMAGE|EMBED_LLM|END_CHILD|END_POPUP|END_TABLE|FREEIMAGE|GETRESULT|HOSTNAME\\$|INPUT_INT|ITEM_RECT|LOADIMAGE|MENU_ITEM|NORMALIZE|POLLEVENT|RAG_CLEAR|RAG_QUERY|RESUMEMUS|SAME_LINE|SEPARATOR|SETHEADER|SET_COLOR|SIDECHAIN|TOOL_CHAT|TOOL_LIST|TREE_NODE|VOLUMEMUS|BACKWARD|BITCRUSH|CHAT_RAW|CHECKBOX|END_MENU|FREE_LLM|GET_WAVE|KEYSTATE|LLM_INFO|LOAD_LLM|PAUSEMUS|PROGRESS|RAG_FREE|RAG_INFO|RAG_LOAD|RAG_SAVE|SHUTDOWN|TEXTSIZE|TOKENIZE|TOOL_ADD|TREE_POP|FINDALL|FORWARD|FREEMUS|LISTBOX|LOADMUS|LOADWAV|PENDOWN|PLAYMUS|PUSH_ID|RAG_ADD|RELEASE|REPLACE|RINGMOD|SHA256\\$|SOFTMAX|STOPMUS|TOOLTIP|ARGMAX|BUTTON|DELETE|EXISTS|FILTER|GETOS\\$|ISDONE|MOUSEX|MOUSEY|PARSE\\$|POP_ID|RESUME|REVERB|SAMPLE|SERVER|SETPOS|SLIDER|TENSOR|UNISON|VALUES|VOLUME|BEGIN|CLEAR|CLOSE|COLOR|COMBO|COUNT|DEBUG|DELAY|DUMMY|EMBED|FLUSH|GETOS|INPUT|ITEMS|JOIN\\$|MATCH|MERGE|NAME\\$|PAUSE|PENUP|POST\\$|RADIO|READ\\$|RESET|RIGHT|SCALE|THEME|TICKS|UUID\\$|VOICE|WRITE|ARGS|AXIS|CHAT|DRAW|EXEC|EXT\\$|FLAG|FREE|FROM|GAIN|GET\\$|HOME|INFO|INIT|KEYS|LEFT|LIST|LOAD|OPEN|PLAY|PUT\\$|SIZE|STOP|TEXT|TOPK|BPM|COL|END|HAT|IP\\$|LFO|PAN|RUN|SEQ|SET|EQ|FM)\\b"
        },
        {
            "name": "keyword.operator.jdbasic",
            "match": "(?i)(\\+|-|\\*|/|\\\\|MOD|<>|<=|>=|<|>|=|\\^|AND|OR|NOT|XOR|BAND|BOR|BXOR|ANDALSO|ORELSE|IN|->|@)\\b"
        },
        {
            "name": "constant.numeric.jdbasic",
            "match": "\\b([0-9]+(\\.[0-9]*)?|\\.[0-9]+)\\b"
        },
        {
            "comment": "User-defined function calls (a word followed by a parenthesis).",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_\\$]*)(?=\\()",
            "name": "entity.name.function.jdbasic"
        },
        {
            "name": "variable.other.string.jdbasic",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\$"
        },
        {
            "name": "variable.other.jdbasic",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        }
    ]
}