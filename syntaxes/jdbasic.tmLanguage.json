{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "jdbasic",
    "scopeName": "source.jdbasic",
    "patterns": [
        {
            "comment": "Line comments: REM ... or ' ... to end of line.",
            "name": "comment.line.jdbasic",
            "patterns": [
                {
                    "name": "comment.line.rem.jdbasic",
                    "begin": "(?i)\\b(REM)\\b",
                    "end": "(?=$)"
                },
                {
                    "name": "comment.line.quote.jdbasic",
                    "begin": "'",
                    "end": "(?=$)"
                }
            ]
        },
        {
            "comment": "String literal (double-quoted only — jdBasic has no single-quote strings).",
            "name": "string.quoted.double.jdbasic",
            "begin": "\"",
            "end": "\""
        },
        {
            "comment": "TYPE-block lifecycle hooks: SUB INIT(...) and SUB DISPOSE() — highlight INIT/DISPOSE distinctly when they follow SUB.",
            "match": "(?i)\\b(SUB)\\s+(INIT|DISPOSE)\\b",
            "captures": {
                "1": { "name": "keyword.control.jdbasic" },
                "2": { "name": "keyword.other.lifecycle.jdbasic" }
            }
        },
        {
            "comment": "Function and Sub declarations: highlight the name as entity.name.function.",
            "match": "(?i)\\b(SUB|FUNC)\\b\\s+([a-zA-Z_][a-zA-Z0-9_$]*)",
            "captures": {
                "1": { "name": "keyword.control.jdbasic" },
                "2": { "name": "entity.name.function.jdbasic" }
            }
        },
        {
            "comment": "Control flow, structure, declaration, and module keywords.",
            "name": "keyword.control.jdbasic",
            "match": "(?i)\\b(IF|THEN|ELSE|ELSEIF|ENDIF|FOR|TO|STEP|NEXT|EACH|IN|DO|LOOP|WHILE|UNTIL|SWITCH|CASE|DEFAULT|ENDSWITCH|EXITSWITCH|SUB|ENDSUB|FUNC|ENDFUNC|RETURN|GOTO|CALL|EXIT|EXITFUNC|EXITDO|EXITFOR|CONTINUEFOR|CONTINUEDO|CONTINUELOOP|TRY|CATCH|FINALLY|ENDTRY|THROW|AWAIT|ASYNC|CONST|DIM|STATIC|AS|LET|TYPE|ENDTYPE|ENUM|ENDENUM|THIS|REACT|IMPORT|EXPORT|MODULE|DECLARE|OPTION|STOP|RESUME|CHAN|END)\\b"
        },
        {
            "comment": "Type names used in DIM AS / FUNC ... AS / CONST AS statements.",
            "name": "storage.type.jdbasic",
            "match": "(?i)\\b(INTEGER|DOUBLE|STRING|MAP|ARRAY|DYNAMIC|TENSOR|JSON|DATE|BOOLEAN|BOOL|BYTE|CHAR|INT16|INT32|INT64|FLOAT16|FLOAT32|FLOAT64|OBJECT)\\b"
        },
        {
            "comment": "General console + REPL commands and core GFX statements that aren't namespaced. Distinct scope from support.function so themes can colour 'PRINT' / 'CLS' / 'SCREEN' like keywords, not like library calls.",
            "name": "keyword.other.jdbasic",
            "match": "(?i)\\b(PRINT|INPUT|CLS|COLOR|LOCATE|CURSOR|SLEEP|LIST|LIST_RECUR|RUN|EDIT|SAVE|LOAD|NEW|COMPILE|DUMP|TRON|TROFF|SAVEWS|LOADWS|CLEARWS|UNREACT|LINT|PRETTY|EXECUTE|EVAL|LAMBDA|DIR|CD|PWD|MKDIR|KILL|RMDIR|SCREEN|SCREENFLIP|DRAWCOLOR|SETFONT|PSET|LINE|RECT|CIRCLE|ELLIPSE|ROUNDED_RECT|CIRCLE_SECTOR|TEXT|PLOTRAW|TOGGLE_FULLSCREEN|TEXTSIZE|RECUR|CLEAR_RECUR)\\b"
        },
        {
            "comment": "Language constants and well-known literals.",
            "name": "constant.language.jdbasic",
            "match": "(?i)\\b(TRUE|FALSE|PI|E|VBNEWLINE|VBCRLF|VBTAB|NONE|NULL|INF|NAN)\\b"
        },
        {
            "comment": "Built-in namespaces — anything that appears before a '.' as a grouping prefix. Catches the bare namespace token; the methods after the dot are highlighted by the dotted-method rule further down.",
            "name": "entity.name.type.class.jdbasic",
            "match": "(?i)\\b(AI|AUDIO|CAM|CHAN|CLIPBOARD|CODEC|DATE|FILE|GFX|GL|GUI|HTTP|JDB|JOY|JSON|MAP|MAT4|MUSIC|OS|OUTPUT|PARTICLE|PATH|REGEX|SERIAL|SFX|SOUND|SPRITE|THREAD|TILED|TILEMAP|TUI|TURTLE)\\b"
        },
        {
            "comment": "Built-in standalone functions (no namespace). Long alternation — keep alphabetised by length-desc to give regex backtracking the best chance.",
            "name": "support.function.jdbasic",
            "match": "(?i)\\b(TOGGLE_FULLSCREEN|REGEX_REPLACE\\$|CIRCLE_SECTOR|FIND_IN_ARRAY|RELEASEOBJECT|CREATEOBJECT|ROUNDED_RECT|SCREENHEIGHT|CLEAR_RECUR|FORMAT_DATE|REGEX_MATCH|SCREENWIDTH|BINREADER\\$|LIST_RECUR|DROP_WHILE|RANDOMSEED|REACT_BIND|RELEASEALL|SCREENFLIP|STARTSWITH|TAKE_WHILE|TXTREADER\\$|BINWRITER|CSVREADER|CSVWRITER|DRAWCOLOR|ENUMERATE|HISTOGRAM|INTEGRATE|NORMALIZE|SETLOCALE|TRANSPOSE|TXTWRITER|VBNEWLINE|CONVOLVE|DATEDIFF|DISTANCE|ENDSWITH|LINSPACE|REPLACE\\$|REVERSE\\$|VARIANCE|WAITKEY\\$|CUMPROD|DATEADD|ELLIPSE|EXECUTE|FLATTEN|FORMAT\\$|GETENV\\$|GROUPBY|INDEXOF|INSERT\\$|MKTEMP\\$|PLOTRAW|PRODUCT|REPEAT\\$|RESHAPE|REVERSE|SETENV|SETFONT|SHUFFLE|UNREACT|WEEKDAY|APPEND|BYTEAT|CIRCLE|CUMSUM|CURSOR|CVDATE|FILTER|INKEY\\$|INSTR\\$|INVERT|ISBOOL|ISNONE|ISNULL|LCASE\\$|LOCATE|LTRIM\\$|MATMUL|MEDIAN|MINUTE|MOUSEB|MOUSEX|MOUSEY|OPTION|RANDOM|REDUCE|RIGHT\\$|ROTATE|RTRIM\\$|SCREEN|SECOND|SELECT|SPACE\\$|TENSOR|TYPEOF|UCASE\\$|UNIQUE|UNPACK|VBCRLF|ATAN2|AWAIT|CBOOL|CDATE|CHUNK|CLAMP|COLOR|COUNT|CROSS|DATE\\$|FLOOR|FRMV\\$|GRADE|HELP\\$|INSTR|ISARR|ISMAP|ISNUM|ISSTR|LCASE|LEFT\\$|LOG10|LPAD\\$|MKDIR|MONTH|MVLET|OUTER|PACK\\$|PLACE|RANGE|RECUR|RIGHT|RMDIR|ROUND|RPAD\\$|SHIFT|SLEEP|SLICE|SOLVE|SPLIT|STACK|STDEV|TIME\\$|TONUM|TOSTR|TRIM\\$|TROFF|TRUNC|UCASE|VBTAB|XSORT|ZEROS|ACOS|ASIN|ATAN|BIN\\$|CDBL|CEIL|CHR\\$|CINT|CLNG|COSH|CSNG|CSTR|DIFF|DIR\\$|DROP|DUMP|EVAL|GETX|GETY|HELP|HEX\\$|HOUR|IOTA|JOIN|KILL|LEFT|LENV|LERP|LINE|LIST|LOAD|MEAN|MID\\$|OCT\\$|ONES|PSET|PUSH|RECT|ROTL|ROTR|SAVE|SCAN|SINH|STR\\$|TAKE|TANH|TEXT|TICK|TRIM|TRON|VARS|YEAR|ABS|ALL|ANY|ASC|CHR|CLS|COS|DAY|DIR|DOT|EXP|FAC|GCD|IIF|INT|LCM|LEN|LOG|MAX|MID|MIN|NOW|POP|PWD|RND|SGN|SHL|SHR|SIN|SQR|STR|SUM|TAN|VAL|ZIP|CD|PI|E)\\b"
        },
        {
            "comment": "Built-in methods following a dot. Big alternation; covers AI, GUI, HTTP, JOY, RAG, GFX, GL, SOUND, SPRITE, TUI etc. method names.",
            "name": "support.function.jdbasic",
            "match": "(?i)\\.(CAPTURE_BEGIN|CAPTURE_END\\$|CAPTURE_PEEK\\$|ITEM_DEACTIVATED_AFTER_EDIT|CLASSIFIER_BUILD_INDEX|TABLE_SET_COLUMN_INDEX|SET_CURSOR_SCREEN_POS|CLASSIFIER_ADD_BATCH|BEGIN_MAIN_MENU_BAR|CLOSE_CURRENT_POPUP|SET_NEXT_ITEM_WIDTH|CLASSIFIER_PREDICT|SET_KEYBOARD_FOCUS|TABLE_SETUP_COLUMN|BEGIN_POPUP_MODAL|CLASSIFIER_CREATE|COLLAPSING_HEADER|END_MAIN_MENU_BAR|TABLE_HEADERS_ROW|TABLE_NEXT_COLUMN|DRAWIMAGE_REGION|PUSH_STYLE_COLOR|RAG_QUERY_STREAM|CLASSIFIER_FREE|CLASSIFIER_INFO|CLASSIFIER_LOAD|CLASSIFIER_SAVE|COLLISION_FIRST|LOAD_EMBEDDINGS|PLOT_POINTS_TEX|POP_STYLE_COLOR|RAG_BUILD_INDEX|SAVE_SCREENSHOT|SHOW_FONT_ATLAS|BASE64_DECODE\\$|BASE64_ENCODE\\$|BEGIN_MENU_BAR|BEGIN_TAB_ITEM|CLASSIFIER_ADD|COLOR_TO_ALPHA|PLOT_HISTOGRAM|RAG_QUERY_FULL|SEPARATOR_TEXT|TABLE_NEXT_ROW|BEGIN_TAB_BAR|CLEAR_GRAMMAR|CLEAR_HISTORY|SET_JSON_MODE|WINDOW_HEIGHT|AVAIL_HEIGHT|FOLLOWREDIRECTS|CLEARCOOKIES|CLEARHEADERS|CLEARPARAMS|DRAWIMAGE_EX|DRAW_CAPTURE|END_MENU_BAR|END_TAB_ITEM|GET_BUS_WAVE|INPUT_DOUBLE|RAG_ADD_FILE|TEXT_WRAPPED|WINDOW_WIDTH|AVAIL_WIDTH|BEGIN_CHILD|BEGIN_POPUP|BEGIN_TABLE|CHAT_STREAM|END_TAB_BAR|GET_HISTORY|MOUSEBUTTON|PLOT_POINTS|POST_ASYNC\\$|RAG_ADD_DIR|SET_GRAMMAR|TOKEN_COUNT|TOOL_REMOVE|BEGIN_MENU|COLLISIONS|COMPRESSOR|COSINE_SIM|DETOKENIZE|DISTORTION|DRAW_LAYER|GET_ASYNC\\$|GETCOOKIE\\$|HELPMARKER|OPEN_POPUP|PLOT_LINES|PROPERTIES|PUT_ASYNC\\$|RAG_CREATE|RAG_SEARCH|REVERBSEND|SAVE_IMAGE|SELECTABLE|SETCOOKIE|SETHEADING|SETPARAM|SETTIMEOUT|SET_ORIGIN|SIMILARITY|STATUSCODE|STRINGIFY\\$|AVAILABLE|BASENAME\\$|DIRNAME\\$|CHAT_JSON|COLLISION|DELAYSEND|DRAWIMAGE|EMBED_LLM|END_CHILD|END_POPUP|END_TABLE|FREEIMAGE|GETRESULT|HOSTNAME\\$|INPUT_INT|ITEM_RECT|LOADIMAGE|MENU_ITEM|NORMALIZE|ON_GROUND|POLLEVENT|RAG_CLEAR|RAG_QUERY|RESUMEMUS|SAME_LINE|SEPARATOR|SETHEADER|SET_COLOR|SIDECHAIN|TILE_SIZE|TOOL_CHAT|TOOL_LIST|TREE_NODE|VOLUMEMUS|BACKWARD|BITCRUSH|CHAT_RAW|CHECKBOX|COLLIDES|DRAW_ALL|END_MENU|FREE_LLM|GET_WAVE|KEYSTATE|LLM_INFO|LOAD_LLM|PAUSEMUS|PROGRESS|RAG_FREE|RAG_INFO|RAG_LOAD|RAG_SAVE|SHUTDOWN|TEXTSIZE|TOKENIZE|TOOL_ADD|TREE_POP|VELOCITY|CAPTURE|FEATURE|FINDALL|FORWARD|FREEMUS|GRAVITY|HSV_RGB|LAYERS\\$|LISTBOX|LOADMUS|LOADWAV|OBJECTS|PENDOWN|PLAYING|PLAYMUS|PUSH_ID|RAG_ADD|RELEASE|REPLACE|REQUEST|RINGMOD|SHA256\\$|SOFTMAX|STOPMUS|TILE_AT|TOOLTIP|VISIBLE|ARGMAX|BOUNDS|BUTTON|CREATE|DELETE|EXISTS|ISDIR|FILTER|FOLLOW|GETOS\\$|GET_VX|GET_VY|HEIGHT|ISDONE|MOUSEX|MOUSEY|PARSE\\$|PARTS|POP_ID|RENDER|RESUME|REVERB|ROTATE|SAMPLE|SERVER|SETPOS|SLIDER|TENSOR|UNISON|UPDATE|VALUES|VOLUME|ZORDER|ALPHA|BEGIN|CLEAR|CLOSE|COLOR|COMBO|COUNT|DEBUG|DELAY|DUMMY|EMBED|FLUSH|FRAME|GETOS|GET_X|GET_Y|GROUP|INPUT|ITEMS|JOIN\\$|MATCH|MERGE|NAME\\$|DELETE\\$|PAUSE|PENUP|POST\\$|RADIO|READ\\$|RESET|RIGHT|SCALE|SHAKE|STATS|THEME|TICKS|UTC|UUID\\$|VOICE|WIDTH|WRITE|ANIM|ARGS|AXIS|CHAT|DRAW|EMIT|EXEC|EXT\\$|FADE|FLAG|FLIP|FREE|FROM|GAIN|GET\\$|HOME|INFO|INIT|KEYS|LAND|LEFT|LIST|LOAD|MOVE|NOTE|OPEN|PLAY|PUT\\$|SIZE|STAT|STOP|TEXT|TOPK|BPM|COL|END|GET|HAT|IP\\$|LFO|PAN|POS|RUN|SEQ|SET|EQ|FM|X|Y)\\b"
        },
        {
            "comment": "Operators: arithmetic, comparison, boolean (short-circuit and vectorised), bitwise, arrow/decorator.",
            "name": "keyword.operator.jdbasic",
            "match": "(?i)(\\+|-|\\*|/|\\\\|MOD|<>|<=|>=|<|>|=|\\^|AND|OR|NOT|XOR|BAND|BOR|BXOR|BNOT|SHL|SHR|ANDALSO|ORELSE|IN|->|@)\\b"
        },
        {
            "comment": "Numeric literals (integer, decimal, leading dot).",
            "name": "constant.numeric.jdbasic",
            "match": "\\b([0-9]+(\\.[0-9]*)?|\\.[0-9]+)\\b"
        },
        {
            "comment": "User-defined function call: a word immediately followed by an opening parenthesis.",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_\\$]*)(?=\\()",
            "name": "entity.name.function.jdbasic"
        },
        {
            "comment": "String-typed variable: identifier ending in $.",
            "name": "variable.other.string.jdbasic",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\$"
        },
        {
            "comment": "Plain variable identifier (fall-through; runs last).",
            "name": "variable.other.jdbasic",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        }
    ]
}
