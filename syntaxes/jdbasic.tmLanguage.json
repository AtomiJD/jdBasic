{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "jdbasic",
    "scopeName": "source.jdbasic",
    "patterns": [
        {
            "comment": "Line comments: REM ... or ' ... to end of line.",
            "name": "comment.line.jdbasic",
            "patterns": [
                {
                    "name": "comment.line.rem.jdbasic",
                    "begin": "(?i)\\b(REM)\\b",
                    "end": "(?=$)"
                },
                {
                    "name": "comment.line.quote.jdbasic",
                    "begin": "'",
                    "end": "(?=$)"
                }
            ]
        },
        {
            "comment": "String literal (double-quoted only — jdBasic has no single-quote strings).",
            "name": "string.quoted.double.jdbasic",
            "begin": "\"",
            "end": "\""
        },
        {
            "comment": "TYPE-block lifecycle hooks: SUB INIT(...) and SUB DISPOSE() — highlight INIT/DISPOSE distinctly when they follow SUB.",
            "match": "(?i)\\b(SUB)\\s+(INIT|DISPOSE)\\b",
            "captures": {
                "1": {
                    "name": "keyword.control.jdbasic"
                },
                "2": {
                    "name": "keyword.other.lifecycle.jdbasic"
                }
            }
        },
        {
            "comment": "Function and Sub declarations: highlight the name as entity.name.function.",
            "match": "(?i)\\b(SUB|FUNC)\\b\\s+([a-zA-Z_][a-zA-Z0-9_$]*)",
            "captures": {
                "1": {
                    "name": "keyword.control.jdbasic"
                },
                "2": {
                    "name": "entity.name.function.jdbasic"
                }
            }
        },
        {
            "comment": "Control flow, structure, declaration, and module keywords.",
            "name": "keyword.control.jdbasic",
            "match": "(?i)\\b(IF|THEN|ELSE|ELSEIF|ENDIF|FOR|TO|STEP|NEXT|EACH|IN|DO|LOOP|WHILE|UNTIL|SWITCH|CASE|DEFAULT|ENDSWITCH|EXITSWITCH|SUB|ENDSUB|FUNC|ENDFUNC|RETURN|GOTO|CALL|EXIT|EXITFUNC|EXITDO|EXITFOR|CONTINUEFOR|CONTINUEDO|CONTINUELOOP|TRY|CATCH|FINALLY|ENDTRY|THROW|AWAIT|ASYNC|CONST|DIM|STATIC|AS|LET|TYPE|ENDTYPE|ENUM|ENDENUM|THIS|REACT|IMPORT|EXPORT|MODULE|DECLARE|OPTION|STOP|RESUME|CHAN|END)\\b"
        },
        {
            "comment": "Type names used in DIM AS / FUNC ... AS / CONST AS statements.",
            "name": "storage.type.jdbasic",
            "match": "(?i)\\b(INTEGER|DOUBLE|STRING|MAP|ARRAY|DYNAMIC|TENSOR|JSON|DATE|BOOLEAN|BOOL|BYTE|CHAR|INT16|INT32|INT64|FLOAT16|FLOAT32|FLOAT64|OBJECT)\\b"
        },
        {
            "comment": "General console + REPL commands and core GFX statements that aren't namespaced. Distinct scope from support.function so themes can colour 'PRINT' / 'CLS' / 'SCREEN' like keywords, not like library calls.",
            "name": "keyword.other.jdbasic",
            "match": "(?i)\\b(PRINT|INPUT|CLS|COLOR|LOCATE|CURSOR|SLEEP|LIST|LIST_RECUR|RUN|EDIT|SAVE|LOAD|NEW|COMPILE|DUMP|TRON|TROFF|SAVEWS|LOADWS|CLEARWS|UNREACT|LINT|PRETTY|EXECUTE|EVAL|LAMBDA|DIR|CD|PWD|MKDIR|KILL|RMDIR|SCREEN|SCREENFLIP|DRAWCOLOR|SETFONT|PSET|LINE|RECT|CIRCLE|ELLIPSE|ROUNDED_RECT|CIRCLE_SECTOR|TEXT|PLOTRAW|TOGGLE_FULLSCREEN|TEXTSIZE|RECUR|CLEAR_RECUR)\\b"
        },
        {
            "comment": "Language constants and well-known literals.",
            "name": "constant.language.jdbasic",
            "match": "(?i)\\b(TRUE|FALSE|PI|E|VBNEWLINE|VBCRLF|VBTAB|NONE|NULL|INF|NAN)\\b"
        },
        {
            "comment": "Audio subsystem dotted calls (FX / MIDI / MON / WAV). Colours the whole call as one library token so new method names need no per-name upkeep.",
            "name": "support.function.jdbasic",
            "match": "(?i)\\b(TOGGLE_FULLSCREEN|REGEX_REPLACE\\$|CIRCLE_SECTOR|FIND_IN_ARRAY|RELEASEOBJECT|CREATEOBJECT|ROUNDED_RECT|SCREENHEIGHT|CLEAR_RECUR|COLORDIALOG|FONTDIALOG\\$|FORMAT_DATE|REGEX_MATCH|SCREENWIDTH|BINREADER\\$|DROP_WHILE|LIST_RECUR|RANDOMSEED|REACT_BIND|RELEASEALL|SCREENFLIP|STARTSWITH|TAKE_WHILE|TXTREADER\\$|BINWRITER|CSVHEADER|CSVREADER|CSVWRITER|DATERANGE|DRAWCOLOR|ENUMERATE|FILEOPEN\\$|FILESAVE\\$|HISTOGRAM|INPUTBOX\\$|INTEGRATE|NORMALIZE|NOW_EPOCH|SETLOCALE|TRANSPOSE|TXTWRITER|VBNEWLINE|CONVOLVE|DATEDIFF|DISTANCE|ENDSWITH|LINSPACE|REPLACE\\$|REVERSE\\$|VARIANCE|WAITKEY\\$|CUMPROD|DATEADD|ELLIPSE|EOMONTH|EXECUTE|FLATTEN|FORMAT\\$|GETENV\\$|GROUPBY|INDEXOF|INSERT\\$|MKTEMP\\$|PLOTRAW|PRODUCT|PYTHON\\$|REPEAT\\$|RESHAPE|REVERSE|SETFONT|SHUFFLE|UNREACT|WEEKDAY|APPEND|BYTEAT|CIRCLE|CUMSUM|CURSOR|CVDATE|FILTER|INKEY\\$|INSTR\\$|INVERT|ISBOOL|ISNONE|ISNULL|LCASE\\$|LOCATE|LOWER\\$|LTRIM\\$|MATMUL|MEDIAN|MINUTE|MOUSEB|MOUSEX|MOUSEY|MSGBOX|OPTION|RANDOM|REDUCE|RIGHT\\$|ROTATE|RTRIM\\$|SCREEN|SECOND|SELECT|SETENV|SPACE\\$|TENSOR|TYPEOF|UCASE\\$|UNIQUE|UNPACK|UPPER\\$|VBCRLF|ATAN2|AWAIT|CBOOL|CDATE|CHUNK|CLAMP|COLOR|COPYV|COUNT|CROSS|DATE\\$|FILLV|FLOOR|FRMV\\$|FUNCS|GRADE|HELP\\$|INSTR|ISARR|ISMAP|ISNUM|ISSTR|LCASE|LEFT\\$|LOG10|LPAD\\$|MKDIR|MONTH|MVINS|MVLET|OUTER|PACK\\$|PLACE|RANGE|RECUR|RIGHT|RMDIR|ROUND|RPAD\\$|SHIFT|SLEEP|SLICE|SOLVE|SPLIT|STACK|STDEV|TALLY|TIME\\$|TONUM|TOSTR|TRIM\\$|TROFF|TRUNC|UCASE|VBTAB|XSORT|YIELD|ZEROS|ACOS|ASIN|ATAN|BIN\\$|CDBL|CEIL|CHR\\$|CINT|CLNG|COSH|CSNG|CSTR|DIFF|DIR\\$|DROP|DUMP|EVAL|GETX|GETY|HELP|HEX\\$|HOUR|IFFT|IOTA|JOIN|KILL|LEFT|LENV|LERP|LINE|LIST|LOAD|MEAN|MID\\$|OCT\\$|ONES|PSET|PUSH|RECT|ROTL|ROTR|SAVE|SCAN|SIGN|SINH|SORT|STR\\$|TAKE|TANH|TEXT|TICK|TRIM|TRON|VARS|YEAR|ABS|AGG|ALL|ANY|ASC|CHR|CLS|COS|DAY|DET|DIR|DOT|EIG|EXP|FAC|FFT|GCD|IIF|INT|LCM|LEN|LOG|MAX|MID|MIN|NOW|POP|PWD|RND|SGN|SHL|SHR|SIN|SQR|STR|SUM|SVD|TAN|VAL|ZIP|CD|PI|QR|E)\\b"
        },
        {
            "comment": "Built-in namespaces — anything that appears before a '.' as a grouping prefix. Catches the bare namespace token; the methods after the dot are highlighted by the dotted-method rule further down.",
            "name": "entity.name.type.class.jdbasic",
            "match": "(?i)\\b(AI|AUDIO|CAM|CHAN|CLIPBOARD|CODEC|DATE|DEBUG|FILE|FORM|FX|GFX|GL|GUI|HTTP|JDB|JOY|JSON|MAP|MAT4|MIDI|MON|MUSIC|OS|OUTPUT|PARTICLE|PATH|PDF|PY|REGEX|SERIAL|SFX|SOUND|SPRITE|SQL|THREAD|TILED|TILEMAP|TUI|TURTLE|WAV)\\b"
        },
        {
            "comment": "Built-in standalone functions (no namespace). Long alternation — keep alphabetised by length-desc to give regex backtracking the best chance.",
            "name": "support.function.jdbasic",
            "match": "(?i)\\b(TOGGLE_FULLSCREEN|REGEX_REPLACE\\$|CIRCLE_SECTOR|FIND_IN_ARRAY|RELEASEOBJECT|CREATEOBJECT|ROUNDED_RECT|SCREENHEIGHT|CLEAR_RECUR|COLORDIALOG|FONTDIALOG\\$|FORMAT_DATE|REGEX_MATCH|SCREENWIDTH|BINREADER\\$|DROP_WHILE|LIST_RECUR|RANDOMSEED|REACT_BIND|RELEASEALL|SCREENFLIP|STARTSWITH|TAKE_WHILE|TXTREADER\\$|BINWRITER|CSVHEADER|CSVREADER|CSVWRITER|DATERANGE|DRAWCOLOR|ENUMERATE|FILEOPEN\\$|FILESAVE\\$|HISTOGRAM|INPUTBOX\\$|INTEGRATE|NORMALIZE|NOW_EPOCH|SETLOCALE|TRANSPOSE|TXTWRITER|VBNEWLINE|CONVOLVE|DATEDIFF|DISTANCE|ENDSWITH|LINSPACE|REPLACE\\$|REVERSE\\$|VARIANCE|WAITKEY\\$|CUMPROD|DATEADD|ELLIPSE|EOMONTH|EXECUTE|FLATTEN|FORMAT\\$|GETENV\\$|GROUPBY|INDEXOF|INSERT\\$|MKTEMP\\$|PLOTRAW|PRODUCT|PYTHON\\$|REPEAT\\$|RESHAPE|REVERSE|SETFONT|SHUFFLE|UNREACT|WEEKDAY|APPEND|BYTEAT|CIRCLE|CUMSUM|CURSOR|CVDATE|FILTER|INKEY\\$|INSTR\\$|INVERT|ISBOOL|ISNONE|ISNULL|LCASE\\$|LOCATE|LOWER\\$|LTRIM\\$|MATMUL|MEDIAN|MINUTE|MOUSEB|MOUSEX|MOUSEY|MSGBOX|OPTION|RANDOM|REDUCE|RIGHT\\$|ROTATE|RTRIM\\$|SCREEN|SECOND|SELECT|SETENV|SPACE\\$|TENSOR|TYPEOF|UCASE\\$|UNIQUE|UNPACK|UPPER\\$|VBCRLF|ATAN2|AWAIT|CBOOL|CDATE|CHUNK|CLAMP|COLOR|COPYV|COUNT|CROSS|DATE\\$|FILLV|FLOOR|FRMV\\$|FUNCS|GRADE|HELP\\$|INSTR|ISARR|ISMAP|ISNUM|ISSTR|LCASE|LEFT\\$|LOG10|LPAD\\$|MKDIR|MONTH|MVINS|MVLET|OUTER|PACK\\$|PLACE|RANGE|RECUR|RIGHT|RMDIR|ROUND|RPAD\\$|SHIFT|SLEEP|SLICE|SOLVE|SPLIT|STACK|STDEV|TALLY|TIME\\$|TONUM|TOSTR|TRIM\\$|TROFF|TRUNC|UCASE|VBTAB|XSORT|YIELD|ZEROS|ACOS|ASIN|ATAN|BIN\\$|CDBL|CEIL|CHR\\$|CINT|CLNG|COSH|CSNG|CSTR|DIFF|DIR\\$|DROP|DUMP|EVAL|GETX|GETY|HELP|HEX\\$|HOUR|IFFT|IOTA|JOIN|KILL|LEFT|LENV|LERP|LINE|LIST|LOAD|MEAN|MID\\$|OCT\\$|ONES|PSET|PUSH|RECT|ROTL|ROTR|SAVE|SCAN|SIGN|SINH|SORT|STR\\$|TAKE|TANH|TEXT|TICK|TRIM|TRON|VARS|YEAR|ABS|AGG|ALL|ANY|ASC|CHR|CLS|COS|DAY|DET|DIR|DOT|EIG|EXP|FAC|FFT|GCD|IIF|INT|LCM|LEN|LOG|MAX|MID|MIN|NOW|POP|PWD|RND|SGN|SHL|SHR|SIN|SQR|STR|SUM|SVD|TAN|VAL|ZIP|CD|PI|QR|E)\\b"
        },
        {
            "comment": "Built-in methods following a dot. Big alternation; covers AI, GUI, HTTP, JOY, RAG, GFX, GL, SOUND, SPRITE, TUI etc. method names.",
            "name": "support.function.jdbasic",
            "match": "(?i)\\.(ITEM_DEACTIVATED_AFTER_EDIT|CLASSIFIER_BUILD_INDEX|TABLE_SET_COLUMN_INDEX|SET_CURSOR_SCREEN_POS|CLASSIFIER_ADD_BATCH|BEGIN_MAIN_MENU_BAR|CLOSE_CURRENT_POPUP|SET_NEXT_ITEM_WIDTH|CLASSIFIER_PREDICT|SET_KEYBOARD_FOCUS|TABLE_SETUP_COLUMN|BEGIN_POPUP_MODAL|CLASSIFIER_CREATE|COLLAPSING_HEADER|END_MAIN_MENU_BAR|TABLE_HEADERS_ROW|TABLE_NEXT_COLUMN|DRAWIMAGE_REGION|PUSH_STYLE_COLOR|RAG_QUERY_STREAM|RENDER_HEADLESS\\$|CLASSIFIER_FREE|CLASSIFIER_INFO|CLASSIFIER_LOAD|CLASSIFIER_SAVE|COLLISION_FIRST|FOLLOWREDIRECTS|LOAD_EMBEDDINGS|PLOT_POINTS_TEX|POP_STYLE_COLOR|RAG_BUILD_INDEX|SAVE_SCREENSHOT|SHOW_FONT_ATLAS|BASE64_DECODE\\$|BASE64_ENCODE\\$|BEGIN_MENU_BAR|BEGIN_TAB_ITEM|CLASSIFIER_ADD|COLOR_TO_ALPHA|DISPLAY_HEIGHT|LAST_RENDER_MS|PLOT_HISTOGRAM|RAG_QUERY_FULL|SEPARATOR_TEXT|TABLE_NEXT_ROW|BEGIN_TAB_BAR|CAPTURE_BEGIN|CAPTURE_PEEK\\$|CLEAR_GRAMMAR|CLEAR_HISTORY|DISPLAY_WIDTH|MENUBAR_BEGIN|SET_JSON_MODE|SUBMENU_BEGIN|TAB_BAR_BEGIN|WINDOW_HEIGHT|AVAIL_HEIGHT|BORDER_BEGIN|CANVAS_BEGIN|CAPTURE_END\\$|CLEARCOOKIES|CLEARHEADERS|DRAWIMAGE_EX|DRAW_CAPTURE|END_MENU_BAR|END_TAB_ITEM|GET_BUS_WAVE|INPUT_DOUBLE|RAG_ADD_FILE|STREAM_LINES|TEXT_WRAPPED|WINDOW_WIDTH|AVAIL_WIDTH|BEGIN_CHILD|BEGIN_POPUP|BEGIN_TABLE|CHAT_STREAM|CHAT_TOKENS|CLEARPARAMS|END_TAB_BAR|GET_HISTORY|MENUBAR_END|MODAL_BEGIN|MODAL_CLOSE|MOUSEBUTTON|MOUSE_WHEEL|PERSPECTIVE|PLOT_POINTS|POST_ASYNC\\$|RAG_ADD_DIR|SET_GRAMMAR|STREAM_TAIL|SUBMENU_END|TABLE_BEGIN|TAB_BAR_END|TOKEN_COUNT|TOOL_REMOVE|BEGIN_MENU|BORDER_END|CANVAS_END|COLLISIONS|COMPRESSOR|COSINE_SIM|DETOKENIZE|DISTORTION|DRAW_LAYER|GETCOOKIE\\$|GET_ASYNC\\$|GLOBAL_GET|GLOBAL_SET|GRID_BEGIN|HBOX_BEGIN|HELPMARKER|MODAL_OPEN|NORMALIZE\\$|OPEN_LINES|OPEN_POPUP|PLAYBUFFER|PLOT_LINES|PROPERTIES|PUT_ASYNC\\$|RAG_CREATE|RAG_SEARCH|REVERBSEND|SAVE_IMAGE|SCREENSHOT|SELECTABLE|SETHEADING|SETTIMEOUT|SET_ORIGIN|SIMILARITY|STATUSCODE|STRINGIFY\\$|STYLE_PUSH|VBOX_BEGIN|WAIT_EVENT|AVAILABLE|BASENAME\\$|CHAT_JSON|COLLISION|DELAYSEND|DRAWIMAGE|EMBED_LLM|END_CHILD|END_POPUP|END_TABLE|FREEIMAGE|GETRESULT|HOSTNAME\\$|INPUT_INT|IS_CLOSED|ITEM_RECT|LOADIMAGE|MENU_ITEM|MODAL_END|MOUSE_BTN|NORMALIZE|ON_GROUND|OPEN_TAIL|PARAGRAPH|POLLEVENT|POP_COLOR|RAG_CLEAR|RAG_QUERY|READLINE\\$|RESUMEMUS|SAME_LINE|SEPARATOR|SETBUFFER|SETCOOKIE|SETHEADER|SET_COLOR|SIDECHAIN|STATUSBAR|STYLE_POP|TABLE_END|TABLE_ROW|TAB_BEGIN|TILE_SIZE|TOOL_CHAT|TOOL_LIST|TRANSLATE|TREE_NODE|VOLUMEMUS|BACKEND\\$|BACKWARD|BG_COLOR|BITCRUSH|CHAT_RAW|CHECKBOX|COLLIDES|DATETIME|DIRNAME\\$|DOEVENTS|DRAW_ALL|DROPDOWN|END_MENU|FREE_LLM|GET_WAVE|GRID_END|HBOX_END|IDENTITY|KEYSTATE|LISTVIEW|LLM_INFO|LOAD_LLM|MENUITEM|OPEN_OUT|PAUSEMUS|PROGRESS|RAG_FREE|RAG_INFO|RAG_LOAD|RAG_SAVE|RECSTART|RICHTEXT|SETPARAM|SETPIXEL|SHUTDOWN|TEXTSIZE|TOKENIZE|TOOL_ADD|TREEVIEW|TREE_POP|VBOX_END|VELOCITY|VERSION\\$|VIEWPORT|CAPTURE|COLUMNS|DELETE\\$|DEVICES|DISABLE|ERRMSG\\$|FEATURE|FINDALL|FORWARD|FREEMUS|GRAVITY|HEADING|HSV_RGB|LAYERS\\$|LISTBOX|LOADMUS|LOADWAV|MOUSE_X|MOUSE_Y|NOTEOFF|OBJECTS|OPEN_IN|PENDOWN|PICTURE|PLAYING|PLAYMUS|PROCESS|PUSH_ID|RAG_ADD|RECSTOP|RELEASE|REPLACE|REQUEST|RINGMOD|RUNNING|SHA256\\$|SOFTMAX|SPINNER|STOPMUS|TABPAGE|TAB_END|TEXTBOX|TILE_AT|TOOLBAR|TOOLTIP|UNIFORM|VISIBLE|ARGMAX|ASSERT|ATTRIB|AT_EOF|BOUNDS|BUFFER|BUTTON|CHECK\\$|CREATE|DELETE|ENABLE|EXISTS|FILTER|FOLLOW|GETOS\\$|GET_VX|GET_VY|HEIGHT|ISDONE|IS_EOF|LOOKAT|MOUSEX|MOUSEY|NOTEON|PARSE\\$|POP_ID|QUEUED|RECLEN|RECORD|RENDER|RESUME|REVERB|ROTATE|SAMPLE|SERVER|SETPOS|SHADER|SLIDER|SPACER|TENSOR|UNISON|UPDATE|UPDOWN|VALUES|VOLUME|WINDOW|ZORDER|ALPHA|BEGIN|CHILD|CLEAR|CLOSE|COLOR|COMBO|COUNT|DEBUG|DELAY|DUMMY|DUMP\\$|EMBED|FLUSH|FRAME|GAUGE|GETOS|GET_X|GET_Y|GROUP|HELP\\$|IMAGE|INPUT|ISDIR|ITEMS|JOIN\\$|LABEL|LEVEL|MATCH|MERGE|NAME\\$|PARTS|PAUSE|PENUP|PITCH|PIXEL|POPUP|PORTS|POST\\$|PRINT|QUERY|RADIO|READ\\$|RESET|RIGHT|SCALE|SCOPE|SHAKE|SHAPE|SPLIT|START|STATS|TABLE|TEXT\\$|THEME|TICKS|TIMER|UUID\\$|VOICE|WIDTH|WRITE|ANIM|ARGS|AXIS|CHAT|DIR\\$|DRAW|EMIT|EVAL|EXEC|EXIT|EXT\\$|FADE|FIND|FLAG|FLIP|FREE|FROM|GAIN|GET\\$|HOME|INFO|INIT|KEY\\$|KEYS|LAND|LEFT|LINE|LINK|LIST|LOAD|MENU|MOVE|NODE|NOTE|OPEN|PLAY|POLL|PUT\\$|QUIT|READ|RECV|SAVE|SEND|SHOW|SIZE|STAT|STOP|TABS|TEXT|TOPK|ADD|BPM|CAP|COL|EBO|END|GET|HAT|IP\\$|LEN|LFO|MDI|MIX|MUL|NEW|PAN|POS|RUN|SEQ|SET|TEX|USE|UTC|VAO|VBO|CC|EQ|FM|FX|X|Y)\\b"
        },
        {
            "comment": "Operators: arithmetic, comparison, boolean (short-circuit and vectorised), bitwise, arrow/decorator.",
            "name": "keyword.operator.jdbasic",
            "match": "(?i)(\\+|-|\\*|/|\\\\|MOD|<>|<=|>=|<|>|=|\\^|AND|OR|NOT|XOR|BAND|BOR|BXOR|BNOT|SHL|SHR|ANDALSO|ORELSE|IN|->|@)\\b"
        },
        {
            "comment": "Numeric literals (integer, decimal, leading dot).",
            "name": "constant.numeric.jdbasic",
            "match": "\\b([0-9]+(\\.[0-9]*)?|\\.[0-9]+)\\b"
        },
        {
            "comment": "User-defined function call: a word immediately followed by an opening parenthesis.",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_\\$]*)(?=\\()",
            "name": "entity.name.function.jdbasic"
        },
        {
            "comment": "String-typed variable: identifier ending in $.",
            "name": "variable.other.string.jdbasic",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\$"
        },
        {
            "comment": "Plain variable identifier (fall-through; runs last).",
            "name": "variable.other.jdbasic",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        }
    ]
}