' ===================================================================
' == RPG Dialog Module
' == Typewriter-style dialog boxes for jdBasic RPG
' ==
' == Usage: IMPORT RPG_DIALOG
' ==   RPG_DIALOG.SAY "Name", "Message text here"
' ==   choice = RPG_DIALOG.CHOICE("Yes|No|Maybe")
' ===================================================================
OPTION "EXPLICIT"
OPTION "STRICT"

EXPORT MODULE RPG_DIALOG

' --- Font metric (set by engine after SETFONT) ---
EXPORT DIM FS = 16             ' font size — all layout derives from this

' --- Shared paths (set by engine from game.json) ---
EXPORT DIM SPRITE_PATH$ = ""   ' path to sprite assets
EXPORT DIM ITEM_PATH$ = ""     ' path to item icon assets
EXPORT DIM BATTLE_BG$ = ""     ' default battle background path
EXPORT DIM MAP_BATTLE_BG$ = "" ' per-map battle background (set by engine on map change)

' --- Shared sprite config (set by engine from game.json) ---
EXPORT DIM FRAME_W = 64        ' sprite sheet frame width
EXPORT DIM FRAME_H = 64        ' sprite sheet frame height

' --- Color palette (set by engine from game.json colors) ---
EXPORT DIM C_BOX_BG    = [20, 20, 55]
EXPORT DIM C_BOX_BD    = [100, 120, 180]
EXPORT DIM C_TEXT      = [230, 230, 240]
EXPORT DIM C_TEXT_DIM  = [140, 140, 160]
EXPORT DIM C_TEXT_BR   = [255, 255, 255]
EXPORT DIM C_TITLE     = [255, 220, 80]
EXPORT DIM C_GOLD      = [255, 215, 0]
EXPORT DIM C_MENU_SEL  = [60, 60, 120]
EXPORT DIM C_MENU_TXT  = [140, 140, 180]
EXPORT DIM C_HP_BAR    = [80, 200, 80]
EXPORT DIM C_HP_BG     = [60, 30, 30]
EXPORT DIM C_ENEMY_HP  = [200, 60, 60]
EXPORT DIM C_HINT      = [200, 255, 200]
EXPORT DIM C_MSG       = [255, 255, 100]

' --- Configuration (can be changed before calling SAY) ---
EXPORT DIM DLG_SPEED = 2          ' characters per frame
' Legacy aliases (kept for backward compat, derived from C_BOX_*)
EXPORT DIM DLG_COLOR_R = 20
EXPORT DIM DLG_COLOR_G = 20
EXPORT DIM DLG_COLOR_B = 60
EXPORT DIM DLG_BORDER_R = 120
EXPORT DIM DLG_BORDER_G = 140
EXPORT DIM DLG_BORDER_B = 200

' --- Internal state ---
EXPORT DIM dlg_active = FALSE

' ===================================================================
' SAY name$, text$ — Show a dialog box with typewriter effect
' Pauses game until player presses Space/Enter
' ===================================================================
EXPORT SUB SAY(name$, text$)
    dlg_active = TRUE
    LET char_idx = 0
    LET total_chars = LEN(text$)
    LET done_typing = FALSE

    ' Font-relative layout
    LET line_h = INT(FS * 1.3)
    LET char_w = INT(FS * 0.65)
    LET margin = INT(FS * 1.0)
    LET box_h = INT(FS * 6)
    LET name_h = INT(FS * 1.4)

    ' Capture the current scene as background
    LET bg_capture = GFX.CAPTURE()

    DO
        ' Redraw the frozen scene as background (prevents flicker)
        GFX.DRAW_CAPTURE bg_capture

        ' Draw semi-transparent dialog box at bottom of screen
        LET sw = SCREENWIDTH()
        LET sh = SCREENHEIGHT()
        LET box_w = INT(sw * 3 / 4)
        LET box_x = INT((sw - box_w) / 2)
        LET box_y = sh - box_h - 10

        ' Box background (dark, semi-transparent)
        DRAWCOLOR DLG_COLOR_R, DLG_COLOR_G, DLG_COLOR_B
        RECT box_x, box_y, box_w, box_h, DLG_COLOR_R, DLG_COLOR_G, DLG_COLOR_B, TRUE

        ' Box border
        RECT box_x, box_y, box_w, box_h, DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B, FALSE

        ' Speaker name
        IF name$ <> "" THEN
            LET name_w = LEN(name$) * char_w + INT(FS * 1.2)
            RECT box_x + 10, box_y - INT(name_h * 0.7), name_w, name_h, _
                DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B, TRUE
            TEXT box_x + 10 + INT(FS * 0.6), box_y - INT(name_h * 0.55), name$, 255, 255, 255
        ENDIF

        ' Typewriter text
        IF NOT done_typing THEN
            char_idx = char_idx + DLG_SPEED
            IF char_idx >= total_chars THEN
                char_idx = total_chars
                done_typing = TRUE
            ENDIF
        ENDIF

        LET visible_text$ = LEFT$(text$, char_idx)

        ' Word-wrap and draw text
        LET tx = box_x + margin
        LET ty = box_y + margin
        LET max_w = box_w - margin * 2
        LET chars_per_line = INT(max_w / char_w)
        IF chars_per_line < 10 THEN chars_per_line = 40

        LET line_start = 0
        LET line_num = 0
        DO WHILE line_start < LEN(visible_text$)
            LET remaining = LEN(visible_text$) - line_start
            IF remaining <= chars_per_line THEN
                LET line$ = MID$(visible_text$, line_start, remaining)
                line_start = LEN(visible_text$)
            ELSE
                ' Find last space before chars_per_line
                LET cut = chars_per_line
                FOR j = line_start + chars_per_line TO line_start STEP -1
                    IF MID$(text$, j, 1) = " " THEN
                        cut = j - line_start
                        EXITFOR
                    ENDIF
                NEXT j
                line$ = MID$(visible_text$, line_start, cut)
                line_start = line_start + cut + 1
            ENDIF
            TEXT tx, ty + line_num * line_h, line$, 230, 230, 230
            line_num = line_num + 1
        LOOP

        ' Prompt indicator
        IF done_typing THEN
            LET blink = (INT(TICK() / 400) MOD 2) = 0
            IF blink THEN
                TEXT box_x + box_w - INT(FS * 2.5), box_y + box_h - line_h, ">>>", _
                    DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B
            ENDIF
        ENDIF

        SCREENFLIP
        SLEEP 16

        ' Input: Space/Enter to advance, or skip typing
        LET ev$ = GFX.POLLEVENT()
        IF ev$ = "KEYDOWN:Space" OR ev$ = "KEYDOWN:Return" THEN
            IF done_typing THEN
                EXITDO
            ELSE
                char_idx = total_chars
                done_typing = TRUE
            ENDIF
        ENDIF
        IF ev$ = "QUIT" OR ev$ = "KEYDOWN:Escape" THEN EXITDO
    LOOP

    GFX.FREEIMAGE bg_capture
    dlg_active = FALSE
ENDSUB

' ===================================================================
' CHOICE(options$) — Show choices separated by |, returns 0-based index
' Example: idx = RPG_DIALOG.CHOICE("Yes|No|Cancel")
' ===================================================================
EXPORT FUNC CHOICE(options$)
    LET items = SPLIT(options$, "|")
    LET num_items = LEN(items)
    LET selected = 0
    LET choice_bg = GFX.CAPTURE()

    LET item_h = INT(FS * 1.6)
    LET box_w = INT(FS * 12)

    DO
        GFX.DRAW_CAPTURE choice_bg
        LET sw = SCREENWIDTH()
        LET sh = SCREENHEIGHT()
        LET box_h = num_items * item_h + INT(FS * 1.2)
        LET box_y = sh - box_h - 10
        LET box_x = sw - box_w - 10

        ' Box
        RECT box_x, box_y, box_w, box_h, DLG_COLOR_R, DLG_COLOR_G, DLG_COLOR_B, TRUE
        RECT box_x, box_y, box_w, box_h, DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B, FALSE

        ' Items
        FOR i = 0 TO num_items - 1
            LET iy = box_y + INT(FS * 0.6) + i * item_h
            IF i = selected THEN
                RECT box_x + 4, iy - 2, box_w - 8, INT(FS * 1.3), DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B, TRUE
                TEXT box_x + INT(FS * 1.5), iy, "> " + items[i], 255, 255, 255
            ELSE
                TEXT box_x + INT(FS * 1.5), iy, "  " + items[i], 180, 180, 180
            ENDIF
        NEXT i

        SCREENFLIP
        SLEEP 16

        LET ev$ = GFX.POLLEVENT()
        IF ev$ = "KEYDOWN:Down" THEN
            selected = (selected + 1) MOD num_items
        ENDIF
        IF ev$ = "KEYDOWN:Up" THEN
            selected = selected - 1
            IF selected < 0 THEN selected = num_items - 1
        ENDIF
        IF ev$ = "KEYDOWN:Space" OR ev$ = "KEYDOWN:Return" THEN
            GFX.FREEIMAGE choice_bg
            RETURN selected
        ENDIF
        IF ev$ = "QUIT" OR ev$ = "KEYDOWN:Escape" THEN
            GFX.FREEIMAGE choice_bg
            RETURN -1
        ENDIF
    LOOP
ENDFUNC

' ===================================================================
' ASK(name$, question$) — Text input dialog, returns typed string
' ===================================================================
EXPORT FUNC ASK$(name$, question$)
    dlg_active = TRUE
    LET input$ = ""
    LET cursor_blink = 0
    LET ask_bg = GFX.CAPTURE()

    LET line_h = INT(FS * 1.3)
    LET char_w = INT(FS * 0.65)
    LET margin = INT(FS * 1.0)
    LET box_h = INT(FS * 6)
    LET name_h = INT(FS * 1.4)
    LET input_h = INT(FS * 1.6)

    DO
        GFX.DRAW_CAPTURE ask_bg
        LET sw = SCREENWIDTH()
        LET sh = SCREENHEIGHT()
        LET box_w = INT(sw * 3 / 4)
        LET box_x = INT((sw - box_w) / 2)
        LET box_y = sh - box_h - 10

        ' Box
        RECT box_x, box_y, box_w, box_h, DLG_COLOR_R, DLG_COLOR_G, DLG_COLOR_B, TRUE
        RECT box_x, box_y, box_w, box_h, DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B, FALSE

        ' Name tag
        IF name$ <> "" THEN
            LET name_w = LEN(name$) * char_w + INT(FS * 1.2)
            RECT box_x + 10, box_y - INT(name_h * 0.7), name_w, name_h, _
                DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B, TRUE
            TEXT box_x + 10 + INT(FS * 0.6), box_y - INT(name_h * 0.55), name$, 255, 255, 255
        ENDIF

        ' Question
        TEXT box_x + margin, box_y + margin, question$, 230, 230, 230

        ' Input field
        LET input_y = box_y + margin + line_h + INT(FS * 0.4)
        RECT box_x + margin, input_y, box_w - margin*2, input_h, 10, 10, 40, TRUE
        RECT box_x + margin, input_y, box_w - margin*2, input_h, _
            DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B, FALSE

        ' Typed text + cursor
        cursor_blink = cursor_blink + 1
        LET cursor$ = ""
        IF (cursor_blink MOD 40) < 20 THEN cursor$ = "_"
        TEXT box_x + margin + INT(FS * 0.4), input_y + INT(FS * 0.3), input$ + cursor$, 255, 255, 255

        ' Hint
        TEXT box_x + box_w - INT(FS * 10), box_y + box_h - line_h, "Enter to confirm", _
            DLG_BORDER_R, DLG_BORDER_G, DLG_BORDER_B

        SCREENFLIP
        SLEEP 16

        LET ev$ = GFX.POLLEVENT()
        IF ev$ = "QUIT" OR ev$ = "KEYDOWN:Escape" THEN
            GFX.FREEIMAGE ask_bg
            dlg_active = FALSE
            RETURN ""
        ENDIF
        IF ev$ = "KEYDOWN:Return" THEN
            GFX.FREEIMAGE ask_bg
            dlg_active = FALSE
            RETURN input$
        ENDIF
        IF ev$ = "KEYDOWN:Backspace" THEN
            IF LEN(input$) > 0 THEN input$ = LEFT$(input$, LEN(input$) - 1)
        ENDIF
        ' Regular key input
        IF LEFT$(ev$, 8) = "KEYDOWN:" THEN
            LET key$ = MID$(ev$, 8)
            IF LEN(key$) = 1 THEN
                LET ch$ = key$
                ' Check shift for uppercase (simplified)
                IF GFX.KEYSTATE("Left Shift") OR GFX.KEYSTATE("Right Shift") THEN
                    ch$ = UCASE$(ch$)
                ELSE
                    ch$ = LCASE$(ch$)
                ENDIF
                IF LEN(input$) < 30 THEN input$ = input$ + ch$
            ELSEIF key$ = "Space" THEN
                IF LEN(input$) < 30 THEN input$ = input$ + " "
            ENDIF
        ENDIF
    LOOP
ENDFUNC

' ===================================================================
' IS_ACTIVE() — Returns TRUE if a dialog is currently showing
' ===================================================================
EXPORT FUNC IS_ACTIVE()
    RETURN dlg_active
ENDFUNC
