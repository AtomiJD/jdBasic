' ══════════════════════════════════════════════════════════════
' ══ ITEM SPRITES (16x16 each, in a strip) ════════════════════
' ══════════════════════════════════════════════════════════════
S = 16  ' item sprite size

' Health Potion (red bottle)
CLS 0, 0, 0
RECT 5, 2, 6, 3, 200, 200, 220, TRUE     ' neck
RECT 3, 5, 10, 9, 200, 40, 40, TRUE      ' body
RECT 5, 6, 6, 6, 240, 60, 60, TRUE       ' highlight
RECT 6, 3, 4, 2, 160, 160, 180, TRUE     ' cork
SAVE_TRANSPARENT OUT$ + "item_health_potion.png", 0, 0, S, S
PRINT "  Health Potion OK"

' Iron Sword (gray blade, brown handle)
