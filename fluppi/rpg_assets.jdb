' ══════════════════════════════════════════════════════════════
' ══ CHEST (2 frames, transparent background) ═════════════════
' ══════════════════════════════════════════════════════════════
CLS 0, 0, 0
' Frame 0: Closed
RECT 4, 12, T-8, T-14, 140, 90, 30, TRUE
RECT 6, 14, T-12, T-18, 170, 120, 50, TRUE
RECT 4, 17, T-8, 3, 200, 150, 60, TRUE
RECT 13, 19, 6, 4, 255, 215, 0, TRUE
' Lid
RECT 3, 8, T-6, 6, 160, 100, 35, TRUE
RECT 5, 9, T-10, 4, 180, 120, 45, TRUE

' Frame 1: Open (at T offset)
RECT T+4, 14, T-8, T-16, 140, 90, 30, TRUE
RECT T+6, 16, T-12, T-20, 170, 120, 50, TRUE
' Open lid (tilted back)
RECT T+3, 4, T-6, 6, 160, 100, 35, TRUE
RECT T+5, 5, T-10, 4, 140, 85, 30, TRUE
' Sparkle inside
RECT T+12, 16, 4, 3, 255, 255, 150, TRUE
RECT T+18, 18, 3, 2, 255, 255, 150, TRUE

SAVE_TRANSPARENT OUT$ + "chest.png", 0, 0, T*2, T
PRINT "  Chest OK"

