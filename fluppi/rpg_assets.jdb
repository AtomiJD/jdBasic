PRINT "  Wooden Shield OK"

' Magic Ring (golden with gem)
CLS 0, 0, 0
CIRCLE 8, 8, 5, 220, 180, 50, FALSE
CIRCLE 8, 8, 4, 240, 200, 60, FALSE
RECT 6, 3, 4, 3, 100, 50, 200, TRUE      ' gem
RECT 7, 4, 2, 1, 150, 100, 255, TRUE     ' gem highlight
SAVE_TRANSPARENT OUT$ + "item_magic_ring.png", 0, 0, S, S
PRINT "  Magic Ring OK"

' Torch (wooden stick with flame)
CLS 0, 0, 0
RECT 7, 6, 2, 10, 120, 80, 40, TRUE      ' stick
RECT 6, 2, 4, 5, 255, 160, 30, TRUE      ' flame outer
RECT 7, 3, 2, 3, 255, 220, 50, TRUE      ' flame inner
RECT 7, 1, 2, 2, 255, 255, 150, TRUE     ' flame tip
SAVE_TRANSPARENT OUT$ + "item_torch.png", 0, 0, S, S
PRINT "  Torch OK"

' Rusty Key
CLS 0, 0, 0
RECT 3, 4, 4, 4, 180, 140, 60, TRUE      ' head ring
RECT 5, 5, 2, 2, 0, 0, 0, TRUE           ' hole in ring (will be transparent)
RECT 7, 6, 7, 2, 160, 120, 50, TRUE      ' shaft
RECT 12, 4, 2, 4, 160, 120, 50, TRUE     ' teeth 1
RECT 10, 4, 2, 3, 140, 100, 40, TRUE     ' teeth 2
SAVE_TRANSPARENT OUT$ + "item_rusty_key.png", 0, 0, S, S
PRINT "  Rusty Key OK"

' Lucky Charm (four-leaf clover)
CLS 0, 0, 0
CIRCLE 5, 5, 3, 50, 180, 50, TRUE
CIRCLE 11, 5, 3, 50, 180, 50, TRUE
CIRCLE 5, 10, 3, 50, 180, 50, TRUE
CIRCLE 11, 10, 3, 50, 180, 50, TRUE
RECT 7, 7, 2, 2, 80, 200, 80, TRUE       ' center
RECT 7, 12, 2, 4, 100, 70, 30, TRUE      ' stem
SAVE_TRANSPARENT OUT$ + "item_lucky_charm.png", 0, 0, S, S
PRINT "  Lucky Charm OK"

' Map Fragment
CLS 0, 0, 0
RECT 2, 2, 12, 10, 220, 200, 160, TRUE   ' parchment
RECT 3, 3, 10, 8, 230, 210, 170, TRUE    ' lighter inner
RECT 4, 4, 3, 1, 100, 80, 60, TRUE       ' lines
RECT 4, 6, 5, 1, 100, 80, 60, TRUE
RECT 4, 8, 4, 1, 100, 80, 60, TRUE
RECT 10, 5, 2, 2, 200, 50, 50, TRUE      ' X mark
RECT 2, 10, 3, 2, 200, 180, 140, TRUE    ' torn edge
SAVE_TRANSPARENT OUT$ + "item_map_fragment.png", 0, 0, S, S
PRINT "  Map Fragment OK"

' Old Map
CLS 0, 0, 0
RECT 1, 1, 14, 12, 210, 190, 140, TRUE
RECT 2, 2, 12, 10, 225, 205, 155, TRUE
RECT 3, 3, 4, 1, 100, 80, 60, TRUE
RECT 3, 5, 6, 1, 100, 80, 60, TRUE
RECT 3, 7, 5, 1, 100, 80, 60, TRUE
RECT 3, 9, 3, 1, 100, 80, 60, TRUE
RECT 10, 4, 3, 3, 180, 40, 40, TRUE      ' X mark
RECT 1, 11, 2, 3, 190, 170, 120, TRUE    ' scroll roll
RECT 13, 11, 2, 3, 190, 170, 120, TRUE
SAVE_TRANSPARENT OUT$ + "item_old_map.png", 0, 0, S, S
PRINT "  Old Map OK"

CLS 40, 40, 40
TEXT 10, 10, "All assets generated!", 255, 255, 255
TEXT 10, 40, "Output: " + OUT$, 200, 200, 200
TEXT 10, 80, "Files:", 180, 180, 180
TEXT 20, 100, "rpg_tileset2.png  (8x2 tiles)", 160, 160, 160
TEXT 20, 120, "npc_oldman.png    (blue robe)", 160, 160, 160
TEXT 20, 140, "npc_guard.png     (armored)", 160, 160, 160
TEXT 20, 160, "npc_hermit.png    (green cloak)", 160, 160, 160
TEXT 20, 180, "npc_merchant.png  (red vest)", 160, 160, 160
TEXT 20, 200, "npc.png           (generic fallback)", 160, 160, 160
TEXT 20, 220, "coin.png          (golden, transparent)", 160, 160, 160
TEXT 20, 240, "chest.png         (2 frames, transparent)", 160, 160, 160
TEXT 10, 280, "Press any key to exit.", 255, 255, 100
SCREENFLIP
WAITKEY$()
END
