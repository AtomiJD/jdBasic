RECT 7, 1, 2, 9, 180, 190, 200, TRUE     ' blade
RECT 6, 0, 4, 2, 200, 210, 220, TRUE     ' tip
RECT 4, 10, 8, 2, 160, 130, 60, TRUE     ' guard
RECT 7, 12, 2, 4, 120, 80, 40, TRUE      ' handle
SAVE_TRANSPARENT OUT$ + "item_iron_sword.png", 0, 0, S, S
