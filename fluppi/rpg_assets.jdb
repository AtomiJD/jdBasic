' ===================================================================
' == RPG Asset Generator v2
' == Creates all tile/sprite PNGs with transparent backgrounds.
' == Each NPC type gets a unique character sprite.
' == Run ONCE, then use the generated files.
' ===================================================================

T = 32
OUT$ = "generated_sprites/"
SCREEN 640, 480, "RPG Asset Generator v2"
SETFONT "C:/Windows/Fonts/arial.ttf", 14
PRINT "Generating RPG assets..."

' ══════════════════════════════════════════════════════════════
' Helper: save a region and make background transparent
' ══════════════════════════════════════════════════════════════
SUB SAVE_TRANSPARENT(filename$, x, y, w, h)
    temp$ = OUT$ + "_temp.png"
    GFX.SAVE_SCREENSHOT temp$, x, y, w, h
    img = GFX.LOADIMAGE(temp$)
    GFX.COLOR_TO_ALPHA img, 30
    GFX.SAVE_IMAGE img, filename$
    GFX.FREEIMAGE img
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ TILESET (no transparency needed — tiles fill their space)
' ══════════════════════════════════════════════════════════════
CLS 0, 0, 0
' Row 1: 1=Grass 2=Wall 3=Water 4=Path 5=Flowers 6=TreeTrunk 7=TreeTop 8=Door
RECT 0, 0, T, T, 45, 120, 45, TRUE
RECT 8, 8, 2, 2, 55, 140, 55, TRUE
RECT 20, 16, 2, 2, 55, 140, 55, TRUE
RECT 12, 24, 2, 2, 50, 135, 50, TRUE

RECT T, 0, T, T, 90, 90, 100, TRUE
RECT T+2, 2, T-4, 14, 110, 110, 120, TRUE
RECT T+2, 17, T-4, 13, 100, 100, 110, TRUE

RECT T*2, 0, T, T, 30, 60, 160, TRUE
RECT T*2+4, 4, 8, 4, 40, 80, 180, TRUE
RECT T*2+16, 12, 10, 4, 40, 80, 180, TRUE

RECT T*3, 0, T, T, 160, 140, 90, TRUE
RECT T*3+6, 6, 3, 3, 150, 130, 80, TRUE
RECT T*3+20, 18, 3, 3, 150, 130, 80, TRUE

RECT T*4, 0, T, T, 45, 120, 45, TRUE
RECT T*4+8, 8, 4, 4, 255, 100, 100, TRUE
RECT T*4+20, 20, 4, 4, 255, 255, 100, TRUE
RECT T*4+14, 14, 4, 4, 200, 100, 255, TRUE

RECT T*5, 0, T, T, 45, 120, 45, TRUE
RECT T*5+12, 0, 8, T, 100, 70, 40, TRUE

RECT T*6, 0, T, T, 30, 100, 30, TRUE
RECT T*6+2, 2, T-4, T-4, 40, 130, 40, TRUE

RECT T*7, 0, T, T, 120, 80, 40, TRUE
RECT T*7+8, 4, T-16, T-4, 80, 50, 25, TRUE

' Row 2: 9=WoodFloor 10=DarkWall
RECT 0, T, T, T, 130, 100, 60, TRUE
RECT 4, T+4, T-8, 2, 120, 90, 50, TRUE
RECT 4, T+14, T-8, 2, 120, 90, 50, TRUE
RECT 4, T+24, T-8, 2, 120, 90, 50, TRUE

RECT T, T, T, T, 70, 60, 50, TRUE
RECT T+2, T+2, T-4, 14, 85, 75, 65, TRUE
RECT T+2, T+17, T-4, 13, 75, 65, 55, TRUE

GFX.SAVE_SCREENSHOT OUT$ + "rpg_tileset2.png", 0, 0, T*8, T*2
PRINT "  Tileset OK"

' ══════════════════════════════════════════════════════════════
' ══ NPC: Old Man (blue robe, gray beard) ═════════════════════
' ══════════════════════════════════════════════════════════════
CLS 0, 0, 0
' Body (blue robe)
RECT 8, 10, 16, 18, 60, 80, 160, TRUE
RECT 10, 12, 12, 14, 70, 90, 170, TRUE
' Head
CIRCLE 16, 8, 6, 220, 180, 140, TRUE
' Eyes
RECT 13, 6, 2, 2, 0, 0, 0, TRUE
RECT 17, 6, 2, 2, 0, 0, 0, TRUE
' Beard (gray)
RECT 12, 10, 8, 4, 180, 180, 180, TRUE
' Hat
RECT 10, 2, 12, 4, 60, 60, 140, TRUE
SAVE_TRANSPARENT OUT$ + "npc_oldman.png", 0, 0, T, T
PRINT "  Old Man OK"

