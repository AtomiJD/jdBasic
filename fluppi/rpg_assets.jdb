RECT 3, 2, 10, 12, 140, 100, 50, TRUE    ' wood
RECT 5, 4, 6, 8, 160, 120, 60, TRUE      ' lighter center
RECT 7, 6, 2, 4, 200, 170, 80, TRUE      ' boss
RECT 3, 2, 10, 1, 160, 160, 170, TRUE    ' top rim
