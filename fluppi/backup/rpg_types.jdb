' ===================================================================
' == RPG Types Module
' == EXPORT TYPEs for all game entities
' ===================================================================

EXPORT MODULE RPG_TYPES

' ── NPC ──────────────────────────────────────────────────────
EXPORT TYPE T_NPC
    sprite_id
    name$
    dialog$
    dialog_key$
    room$
    patrol
    patrol_speed
    patrol_range
    start_x
    visible
    is_shop
    shop_items
    can_recruit
    recruit_id$
    dialog_joined$
    recruited
    ' Path system: array of [x,y] waypoints
    path
    path_idx
    path_wait
    path_wait_timer

    SUB INIT(data, asset_path$, room_name$)
        THIS.name$ = data{"name"}
        THIS.dialog$ = data{"dialog"}
        THIS.room$ = room_name$
        THIS.patrol = FALSE
        THIS.visible = TRUE
        IF MAP.EXISTS(data, "dialog_key") THEN THIS.dialog_key$ = data{"dialog_key"}
        IF MAP.EXISTS(data, "is_shop") THEN THIS.is_shop = data{"is_shop"}
        IF MAP.EXISTS(data, "shop_items") THEN THIS.shop_items = data{"shop_items"}
        THIS.can_recruit = FALSE : THIS.recruited = FALSE
        IF MAP.EXISTS(data, "can_recruit") THEN THIS.can_recruit = data{"can_recruit"}
        IF MAP.EXISTS(data, "recruit_id") THEN THIS.recruit_id$ = data{"recruit_id"}
        IF MAP.EXISTS(data, "dialog_joined") THEN THIS.dialog_joined$ = data{"dialog_joined"}
        ' Load NPC-specific sprite based on name
        npc_file$ = asset_path$ + "npc.png"  ' fallback
        n$ = LCASE$(THIS.name$)
        IF INSTR$(n$, "old man") >= 0 THEN npc_file$ = asset_path$ + "npc_oldman.png"
        IF INSTR$(n$, "guard") >= 0 THEN npc_file$ = asset_path$ + "npc_guard.png"
        IF INSTR$(n$, "hermit") >= 0 THEN npc_file$ = asset_path$ + "npc_hermit.png"
        IF INSTR$(n$, "merchant") >= 0 THEN npc_file$ = asset_path$ + "npc_merchant.png"
        IF INSTR$(n$, "hasi") >= 0 THEN npc_file$ = asset_path$ + "npc_hasi.png"
        IF INSTR$(n$, "moehrchen") >= 0 OR INSTR$(n$, "möhrchen") >= 0 THEN npc_file$ = asset_path$ + "npc_moehrchen.png"
        TRY
            THIS.sprite_id = SPRITE.LOAD(npc_file$)
        CATCH
            THIS.sprite_id = SPRITE.LOAD(asset_path$ + "npc.png")
        ENDTRY
        SPRITE.POS THIS.sprite_id, data{"x"}, data{"y"}
        SPRITE.ZORDER THIS.sprite_id, 10
        SPRITE.GROUP THIS.sprite_id, "npc"
        IF MAP.EXISTS(data, "patrol") AND data{"patrol"} THEN
            THIS.patrol = TRUE
            THIS.patrol_range = data{"patrol_range"}
            THIS.patrol_speed = data{"patrol_speed"}
            THIS.start_x = data{"x"}
            SPRITE.VELOCITY THIS.sprite_id, THIS.patrol_speed, 0
        ENDIF
        ' Path waypoints: [[x1,y1],[x2,y2],...] with optional wait time
        THIS.path = []
        THIS.path_idx = 0
        THIS.path_wait = 0
        THIS.path_wait_timer = 0
        IF MAP.EXISTS(data, "path") THEN
            THIS.path = data{"path"}
            IF MAP.EXISTS(data, "path_wait") THEN THIS.path_wait = data{"path_wait"}
        ENDIF
    ENDSUB

    SUB UPDATE()
        IF NOT THIS.visible THEN RETURN

        ' Path-following mode
        path_len = LEN(THIS.path)
        IF TYPEOF(path_len) = "ARRAY" THEN path_len = path_len[0]
        IF path_len > 0 THEN
            ' Wait at waypoint?
            IF THIS.path_wait_timer > 0 THEN
                THIS.path_wait_timer = THIS.path_wait_timer - 1
                SPRITE.VELOCITY THIS.sprite_id, 0, 0
                RETURN
            ENDIF

            ' Move toward current waypoint
            wp = THIS.path[THIS.path_idx]
            tx = wp[0] : ty = wp[1]
            cx = SPRITE.GET_X(THIS.sprite_id)
            cy = SPRITE.GET_Y(THIS.sprite_id)
            dx = tx - cx : dy = ty - cy
            dist = SQR(dx*dx + dy*dy)

            IF dist < 3 THEN
                ' Reached waypoint — advance to next
                SPRITE.VELOCITY THIS.sprite_id, 0, 0
                THIS.path_idx = (THIS.path_idx + 1) MOD path_len
                THIS.path_wait_timer = THIS.path_wait
            ELSE
                ' Move toward target
                spd = THIS.patrol_speed
                IF spd = 0 THEN spd = 30
                vx = (dx / dist) * spd
                vy = (dy / dist) * spd
                SPRITE.VELOCITY THIS.sprite_id, vx, vy
            ENDIF
            RETURN
        ENDIF

        ' Simple patrol mode (fallback)
        IF THIS.patrol THEN
            nx = SPRITE.GET_X(THIS.sprite_id)
            IF nx > THIS.start_x + THIS.patrol_range THEN _
                SPRITE.VELOCITY THIS.sprite_id, -THIS.patrol_speed, 0
            IF nx < THIS.start_x THEN _
                SPRITE.VELOCITY THIS.sprite_id, THIS.patrol_speed, 0
        ENDIF
    ENDSUB

    SUB INTERACT(has_key, player_name$)
        IF has_key AND THIS.dialog_key$ <> "" THEN
            dlg$ = THIS.dialog_key$
        ELSE
            dlg$ = THIS.dialog$
        ENDIF
        ' Replace {PLAYER} placeholder with actual name
        IF player_name$ <> "" THEN
            dlg$ = REPLACE$(dlg$, "{PLAYER}", player_name$)
        ENDIF
        RPG_DIALOG.SAY THIS.name$, dlg$
    ENDSUB

    SUB SET_VISIBLE(v)
        THIS.visible = v
        SPRITE.VISIBLE THIS.sprite_id, v
        IF NOT v THEN
            ' Stop all movement when hidden
            SPRITE.VELOCITY THIS.sprite_id, 0, 0
        ENDIF
        IF v THEN
            ' Restart patrol movement when shown
            IF THIS.patrol THEN
                SPRITE.VELOCITY THIS.sprite_id, THIS.patrol_speed, 0
            ENDIF
            ' Reset path NPCs to first waypoint
            path_len = LEN(THIS.path)
            IF TYPEOF(path_len) = "ARRAY" THEN path_len = path_len[0]
            IF path_len > 0 THEN
                THIS.path_idx = 0
                wp = THIS.path[0]
                SPRITE.POS THIS.sprite_id, wp[0], wp[1]
            ENDIF
        ENDIF
    ENDSUB
ENDTYPE

' ── Chest ────────────────────────────────────────────────────
EXPORT TYPE T_CHEST
    sprite_id
    content$
    room$
    opened
    visible

    SUB INIT(data, asset_path$, room_name$)
        THIS.content$ = data{"content"}
        THIS.room$ = room_name$
        THIS.opened = FALSE
        THIS.visible = TRUE
        THIS.sprite_id = SPRITE.LOAD(asset_path$ + "chest.png", 32, 32)
        SPRITE.POS THIS.sprite_id, data{"x"}, data{"y"}
        SPRITE.ZORDER THIS.sprite_id, 8
        SPRITE.GROUP THIS.sprite_id, "chest"
        SPRITE.FRAME THIS.sprite_id, 0
    ENDSUB

    FUNC OPEN$()
        IF THIS.opened THEN RETURN ""
        THIS.opened = TRUE
        SPRITE.FRAME THIS.sprite_id, 1
        SPRITE.GROUP THIS.sprite_id, "opened"
        content$ = THIS.content$
        IF LEFT$(content$, 5) = "gold:" THEN
            gold = VAL(MID$(content$, 5))
            RPG_DIALOG.SAY "", "You found " + STR$(INT(gold)) + " gold coins!"
            RETURN "gold:" + STR$(INT(gold))
        ELSEIF content$ = "key" THEN
            RPG_DIALOG.SAY "", "You found a rusty key!"
            RETURN "key"
        ELSE
            RPG_DIALOG.SAY "", "You found: " + content$
            RETURN content$
        ENDIF
    ENDFUNC

    SUB SET_VISIBLE(v)
        THIS.visible = v
        IF THIS.opened THEN v = FALSE
        SPRITE.VISIBLE THIS.sprite_id, v
    ENDSUB
ENDTYPE

' ── Coin ─────────────────────────────────────────────────────
EXPORT TYPE T_COIN
    sprite_id
    value
    room$
    collected

    SUB INIT(data, asset_path$, room_name$)
        THIS.value = data{"value"}
        THIS.room$ = room_name$
        THIS.collected = FALSE
        THIS.sprite_id = SPRITE.LOAD(asset_path$ + "coin.png")
        SPRITE.POS THIS.sprite_id, data{"x"}, data{"y"}
        SPRITE.ZORDER THIS.sprite_id, 5
        SPRITE.GROUP THIS.sprite_id, "coin"
    ENDSUB

    SUB COLLECT()
        IF THIS.collected THEN RETURN
        THIS.collected = TRUE
        PARTICLE.EMIT SPRITE.GET_X(THIS.sprite_id)+8, _
            SPRITE.GET_Y(THIS.sprite_id)+8, _
            15, 255, 215, 0, 80, 0.5, -50, 3
        SPRITE.DELETE THIS.sprite_id
        THIS.sprite_id = -1
    ENDSUB

    SUB SET_VISIBLE(v)
        IF THIS.collected OR THIS.sprite_id < 0 THEN RETURN
        SPRITE.VISIBLE THIS.sprite_id, v
    ENDSUB
ENDTYPE

' ── Door (data only, no sprite) ──────────────────────────────
EXPORT TYPE T_DOOR
    col
    row
    target$
    spawn_x
    spawn_y
    room$

    SUB INIT(data, room_name$)
        THIS.col = data{"col"}
        THIS.row = data{"row"}
        THIS.target$ = data{"target"}
        THIS.spawn_x = data{"spawn_x"}
        THIS.spawn_y = data{"spawn_y"}
        THIS.room$ = room_name$
    ENDSUB
ENDTYPE
