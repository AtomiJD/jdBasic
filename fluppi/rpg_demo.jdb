' ===================================================================
' == Vallys Reise - Pirate Island RPG
' == Built on the Tiled Map engine
' ===================================================================
OPTION "EXPLICIT"
OPTION "STRICT"

IMPORT RPG_ENGINE
IMPORT RPG_DIALOG
CD "D:\usr\dev\cc\fluppi"
LET config$ = "D:/usr/dev/cc/fluppi/rpg_data/game.json"

' ── Input wiring ──────────────────────────────────────────────
' ON-handlers bypass the ImGui POLLEVENT filter that swallows keys;
' every modal loop in the engine drains RPG_DIALOG.DRAIN_KEY$() instead.
SUB ON_KEY(KeyData)
    RPG_DIALOG.SET_KEY KeyData[0]{"key"}
ENDSUB

SUB ON_QUIT(QuitData)
    RPG_DIALOG.SET_QUIT
ENDSUB

ON "KEYDOWN" CALL ON_KEY
ON "QUIT"    CALL ON_QUIT

' ── Title Screen ──────────────────────────────────────────────
LET menu_choice = RPG_ENGINE.SHOW_TITLE(config$)
IF menu_choice = 2 THEN END

' ── Initialize Game ───────────────────────────────────────────
RPG_ENGINE.INIT config$

' ── Load Game (if selected) ───────────────────────────────────
IF menu_choice = 1 THEN
    IF RPG_ENGINE.LOAD_GAME() THEN
        PRINT "Spielstand geladen!"
    ELSE
        PRINT "Kein Spielstand gefunden, starte neues Spiel."
    ENDIF
ENDIF

GFX.FADE 1, 0.5

' ── Game Loop ─────────────────────────────────────────────────
DO
    RPG_ENGINE.UPDATE
    IF RPG_ENGINE.quit_flag THEN EXITDO
    RPG_ENGINE.DRAW
    SCREENFLIP
    SLEEP 16
LOOP

' ── Shutdown (no auto-save — player saves manually via ESC menu) ──
RPG_ENGINE.SHUTDOWN
END
