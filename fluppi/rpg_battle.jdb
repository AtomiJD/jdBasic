' ===================================================================
' == RPG Battle Module v2
' == Party-based turn combat with skills
' ===================================================================
OPTION "EXPLICIT"
OPTION "STRICT"

EXPORT MODULE RPG_BATTLE

IMPORT RPG_DIALOG
IMPORT RPG_INVENTORY
IMPORT RPG_COMBAT
IMPORT RPG_PARTY
IMPORT RPG_MUSIC

EXPORT DIM battle_bg = -1
EXPORT DIM encounter_steps = 0
EXPORT DIM encounter_rate = 30

' ══════════════════════════════════════════════════════════════
' ══ MAIN BATTLE ══════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT FUNC FIGHT$(enemy_id$)
    LET sw = SCREENWIDTH() : LET sh = SCREENHEIGHT()
    LET fs = RPG_DIALOG.FS
    LET lh = INT(fs * 1.3)
    LET bar_h = INT(fs * 0.45)
    LET bar_w = INT(fs * 5)
    LET name_col_w = INT(fs * 4)
    LET member_h = INT(fs * 3.0)
    LET menu_item_h = INT(fs * 1.5)

    ' Spawn enemy
    LET enemy = RPG_COMBAT.SPAWN_ENEMY(enemy_id$)
    LET e_name$ = enemy{"name"}
    LET e_hp = INT(enemy{"hp"}) : LET e_max_hp = INT(enemy{"max_hp"})
    LET e_atk = INT(enemy{"atk"}) : LET e_def = INT(enemy{"def"})
    LET e_xp = INT(enemy{"xp"}) : LET e_gold = INT(enemy{"gold"})
    LET e_drop$ = enemy{"drop_item"} : LET e_drop_chance = enemy{"drop_chance"}

    ' ── Calculate all positions FIRST, then load sprites ──
    LET arena_bottom = sh/2 - 20        ' bottom edge of arena area

    ' Enemy position — right side, feet on arena floor
    LET e_fw = INT(enemy{"frame_w"}) : LET e_fh = INT(enemy{"frame_h"})
    LET e_scale = 2
    LET e_sprite_h = INT(e_fh * e_scale)
    LET e_x = sw/2 + 80
    LET e_y = arena_bottom - e_sprite_h - 5

    ' Party position — side-by-side, feet on arena floor
    LET sfw = RPG_DIALOG.FRAME_W : LET sfh = RPG_DIALOG.FRAME_H
    LET p_scale = 1.5
    LET p_sprite_h = INT(sfh * p_scale)
    LET p_sprite_w = INT(sfw * p_scale)
    LET p_y = arena_bottom - p_sprite_h - 5
    LET p_gap = INT(p_sprite_w + fs * 0.5)    ' sprite width + small gap

    ' Load enemy sprite
    LET enemy_sprite = -1
    TRY
        LET sf$ = enemy{"sprite_file"}
        IF sf$ <> "" THEN
            enemy_sprite = SPRITE.LOAD(sf$, e_fw, e_fh)
            SPRITE.POS enemy_sprite, e_x, e_y
            SPRITE.SCALE enemy_sprite, e_scale
            LET af = enemy{"anim_frames"}
            LET af_len = LEN(af)
            IF TYPEOF(af_len) = "ARRAY" THEN af_len = af_len[0]
            IF af_len > 0 THEN
                SPRITE.ANIM enemy_sprite, "idle", af, INT(enemy{"anim_fps"})
                SPRITE.PLAY enemy_sprite, "idle"
            ENDIF
        ENDIF
    CATCH
    ENDTRY

    ' Load player sprites for battle
    DIM p_sprites[3]
    FOR pidx = 0 TO RPG_PARTY.member_count - 1
        p_sprites[pidx] = -1
        LET pm = RPG_PARTY.GET_MEMBER(pidx)
        TRY
            LET sprite_path$ = RPG_DIALOG.SPRITE_PATH$ + pm{"sprite"}
            LET ps = SPRITE.LOAD(sprite_path$, sfw, sfh)
            SPRITE.FRAME ps, 6
            SPRITE.SCALE ps, p_scale
            SPRITE.POS ps, 30 + pidx * p_gap, p_y
            p_sprites[pidx] = ps
        CATCH
        ENDTRY
    NEXT pidx

    LET battle_msg$ = "Ein " + e_name$ + " erscheint!"
    LET prev_music$ = RPG_MUSIC.current_theme$
    RPG_MUSIC.PLAY "battle"
    LET result$ = ""
    LET cur_member = 0
    LET selected = 0
    LET shake_x = 0 : LET shake_y = 0
    LET turn$ = "player"
    LET anim_timer = 0
    LET action_delay = 0   ' frames to wait showing battle_msg before next turn
    LET player_defending = []
    FOR pidx = 0 TO RPG_PARTY.member_count - 1
        PUSH player_defending, FALSE
    NEXT pidx

    ' Load battle background — per-map override or default
    IF battle_bg <= 0 THEN
        LET bg_path$ = RPG_DIALOG.MAP_BATTLE_BG$
        IF bg_path$ = "" THEN bg_path$ = RPG_DIALOG.BATTLE_BG$
        IF bg_path$ <> "" THEN
            TRY : battle_bg = CINT(GFX.LOADIMAGE(bg_path$)) : CATCH : ENDTRY
        ENDIF
    ENDIF

    ' Color aliases from palette
    LET cbg = RPG_DIALOG.C_BOX_BG : LET cbd = RPG_DIALOG.C_BOX_BD
    LET ctx = RPG_DIALOG.C_TEXT : LET ctd = RPG_DIALOG.C_TEXT_DIM
    LET ctb = RPG_DIALOG.C_TEXT_BR : LET cms = RPG_DIALOG.C_MENU_SEL
    LET cmt = RPG_DIALOG.C_MENU_TXT : LET chp = RPG_DIALOG.C_HP_BAR
    LET chb = RPG_DIALOG.C_HP_BG : LET ceh = RPG_DIALOG.C_ENEMY_HP
    LET cmsg = RPG_DIALOG.C_MSG

    DO
        ' ── DRAW BATTLE SCREEN ───────────────────────────────
        CLS cbg[0], cbg[1], cbg[2]

        ' Arena (background image or fallback color)
        IF battle_bg > 0 THEN
            GFX.DRAWIMAGE battle_bg, 10, 10, sw - 20, sh/2 - 20
        ELSE
            RECT 10, 10, sw - 20, sh/2 - 20, cbg[0]+5, cbg[1], cbg[2]-15, TRUE
        ENDIF
        RECT 10, 10, sw - 20, sh/2 - 20, cbd[0]-40, cbd[1]-70, cbd[2]-90, FALSE

        ' Player party sprites (side-by-side, bottom of arena)
        FOR pidx = 0 TO RPG_PARTY.member_count - 1
            IF p_sprites[pidx] > 0 THEN
                pm = RPG_PARTY.GET_MEMBER(pidx)
                SPRITE.POS p_sprites[pidx], 30 + pidx * p_gap, p_y
                IF pm{"hp"} <= 0 THEN
                    SPRITE.ALPHA p_sprites[pidx], 80
                ELSEIF pidx = cur_member AND turn$ = "player" THEN
                    SPRITE.ALPHA p_sprites[pidx], 255
                ELSE
                    SPRITE.ALPHA p_sprites[pidx], 180
                ENDIF
                SPRITE.DRAW p_sprites[pidx]
            ENDIF
        NEXT pidx

        ' Enemy sprite (right side, bottom of arena, with shake)
        IF enemy_sprite > 0 THEN
            SPRITE.POS enemy_sprite, e_x + shake_x, e_y + shake_y
            SPRITE.DRAW enemy_sprite
        ELSE
            RECT e_x + shake_x, e_y + shake_y, 60, 60, ceh[0], ceh[1], ceh[2], TRUE
        ENDIF

        ' Enemy HP bar (above enemy, inside arena)
        LET e_bar_w = INT(fs * 6)
        LET hp_label_y = e_y - INT(fs * 1.5)
        TEXT e_x - INT(fs*2), hp_label_y, e_name$, ceh[0], ceh[1]+140, ceh[2]+140
        LET e_bar_x = e_x - INT(fs*2) + INT(fs * 5)
        RECT e_bar_x, hp_label_y + INT(fs*0.1), e_bar_w, bar_h, chb[0], chb[1], chb[2], TRUE
        LET efill = 0
        IF e_max_hp > 0 THEN efill = INT((e_hp / e_max_hp) * e_bar_w)
        IF efill > 0 THEN RECT e_bar_x, hp_label_y + INT(fs*0.1), efill, bar_h, ceh[0], ceh[1], ceh[2], TRUE
        RECT e_bar_x, hp_label_y + INT(fs*0.1), e_bar_w, bar_h, cbd[0]+20, cbd[1]-40, cbd[2]-100, FALSE
        TEXT e_bar_x + e_bar_w + 5, hp_label_y, STR$(INT(e_hp)) + "/" + STR$(INT(e_max_hp)), ctd[0]+20, ctd[1]-10, ctd[2]-30

        ' ── Bottom Panel (sized to fit party + menu + message) ──
        LET panel_y = sh/2 + 10
        LET panel_h = sh - panel_y - 10
        RECT 10, panel_y, sw - 20, panel_h, cbg[0], cbg[1], cbg[2], TRUE
        RECT 10, panel_y, sw - 20, panel_h, cbd[0], cbd[1], cbd[2], FALSE

        ' Party stats (left side)
        FOR pidx = 0 TO RPG_PARTY.member_count - 1
            pm = RPG_PARTY.GET_MEMBER(pidx)
            LET py = panel_y + INT(fs*0.5) + pidx * member_h
            ' Highlight active member
            IF pidx = cur_member AND turn$ = "player" THEN
                RECT 15, py - 3, INT(fs * 14), INT(fs * 2.7), cms[0]-20, cms[1]-20, cms[2]-50, TRUE
            ENDIF
            LET nm$ = LEFT$(pm{"name"}, 8)
            TEXT 20, py, nm$, ctx[0]-30, ctx[1]-30, ctx[2]
            ' HP
            LET hbar_x = 20 + name_col_w
            RECT hbar_x, py + INT(fs*0.15), bar_w, bar_h, chb[0], chb[1], chb[2], TRUE
            IF pm{"max_hp"} > 0 THEN
                LET hf = INT((pm{"hp"} / pm{"max_hp"}) * bar_w)
                IF hf > 0 THEN RECT hbar_x, py + INT(fs*0.15), hf, bar_h, chp[0], chp[1], chp[2], TRUE
            ENDIF
            TEXT hbar_x + bar_w + 5, py, STR$(INT(pm{"hp"})), chp[0]+100, chp[1], chp[2]+100
            ' MP
            TEXT 20, py + lh, "MP", cbd[0]+20, cbd[1], cbd[2]
            RECT hbar_x, py + lh + INT(fs*0.15), bar_w, bar_h, 30, 30, cbg[2]+5, TRUE
            IF pm{"max_mp"} > 0 THEN
                LET mf = INT((pm{"mp"} / pm{"max_mp"}) * bar_w)
                IF mf > 0 THEN RECT hbar_x, py + lh + INT(fs*0.15), mf, bar_h, chp[0], chp[1]-120, chp[2]+120, TRUE
            ENDIF
            TEXT hbar_x + bar_w + 5, py + lh, STR$(INT(pm{"mp"})), cbd[0]+30, cbd[1]+10, cbd[2]+20
        NEXT pidx

        ' Battle menu (right side) — only during player turn
        IF turn$ = "player" THEN
            LET mx = sw - INT(fs * 12) : LET my = panel_y + INT(fs*0.5)
            pm = RPG_PARTY.GET_MEMBER(cur_member)

            LET menu_items = ["Angriff", "Fähigkeit", "Gegenstand", "Verteidigen", "Fliehen"]
            LET num_menu = 5
            LET menu_w = INT(fs * 11)

            RECT mx - INT(fs*0.6), my - INT(fs*0.3), menu_w, num_menu * menu_item_h + INT(fs*0.6), cbg[0]+10, cbg[1]+5, cbg[2], TRUE
            RECT mx - INT(fs*0.6), my - INT(fs*0.3), menu_w, num_menu * menu_item_h + INT(fs*0.6), cbd[0], cbd[1], cbd[2], FALSE

            FOR mi = 0 TO num_menu - 1
                LET iy = my + mi * menu_item_h
                IF mi = selected THEN
                    RECT mx - INT(fs*0.3), iy - 2, menu_w - INT(fs*0.6), INT(fs*1.2), cms[0], cms[1]-10, cms[2]-20, TRUE
                    TEXT mx + INT(fs*0.6), iy, "> " + menu_items[mi], ctb[0], ctb[1], ctb[2]
                ELSE
                    TEXT mx + INT(fs*0.9), iy, menu_items[mi], cmt[0], cmt[1], cmt[2]
                ENDIF
            NEXT mi
        ENDIF

        ' Message
        TEXT 25, sh - INT(fs * 1.5), battle_msg$, cmsg[0], cmsg[1], cmsg[2]

        ' Shake decay
        shake_x = shake_x * 0.8 : shake_y = shake_y * 0.8
        IF ABS(shake_x) < 0.5 THEN shake_x = 0
        IF ABS(shake_y) < 0.5 THEN shake_y = 0

        SPRITE.UPDATE
        PARTICLE.DRAW
        SCREENFLIP : SLEEP 16

        ' ── INPUT ────────────────────────────────────────────
        ' Action delay: show battle message before next turn
        IF action_delay > 0 THEN
            action_delay = action_delay - 1
            RPG_DIALOG.DRAIN_KEY$()  ' discard buffered keys during delay
            CONTINUELOOP
        ENDIF

        IF turn$ = "player" THEN
            ' Skip dead members automatically
            LET skip_count = 0
            DO WHILE skip_count < RPG_PARTY.member_count
                pm = RPG_PARTY.GET_MEMBER(cur_member)
                IF pm{"hp"} > 0 THEN EXITDO
                cur_member = cur_member + 1
                IF cur_member >= RPG_PARTY.member_count THEN
                    cur_member = 0 : turn$ = "enemy" : anim_timer = 15 : battle_msg$ = e_name$ + " bereitet einen Angriff vor..."
                    EXITDO
                ENDIF
                skip_count = skip_count + 1
            LOOP
            pm = RPG_PARTY.GET_MEMBER(cur_member)

            LET ev$ = RPG_DIALOG.DRAIN_KEY$()
            IF ev$ = "Down" THEN selected = (selected + 1) MOD num_menu
            IF ev$ = "Up" THEN
                selected = selected - 1
                IF selected < 0 THEN selected = num_menu - 1
            ENDIF

            IF ev$ = "Return" OR ev$ = "Space" THEN
                player_defending[cur_member] = FALSE

                IF selected = 0 THEN
                    ' ── ATTACK ──
                    LET patk = INT(pm{"atk"})
                    LET dmg = INT(patk * (0.8 + RND(1) * 0.4)) - e_def
                    IF dmg < 1 THEN dmg = 1
                    e_hp = e_hp - dmg
                    IF e_hp < 0 THEN e_hp = 0
                    battle_msg$ = pm{"name"} + " greift an und macht " + STR$(dmg) + " Schaden!"
                    shake_x = (RND(1) - 0.5) * 20 : shake_y = (RND(1) - 0.5) * 10
                    PARTICLE.EMIT e_x + 30, e_y + 30, 8, 255, 100, 50, 60, 0.3, 0, 3

                ELSEIF selected = 1 THEN
                    ' ── SKILL MENU ──
                    LET skills = RPG_PARTY.GET_LEARNED_SKILLS(cur_member)
                    LET sk_count = LEN(skills)
                    IF sk_count = 0 THEN
                        battle_msg$ = "Noch keine Fähigkeiten erlernt!"
                    ELSE
                        LET sk_sel = 0
                        LET sk_chosen = FALSE
                        LET sk_box_w = INT(fs * 13)
                        DO
                            CLS cbg[0], cbg[1], cbg[2]
                            IF battle_bg > 0 THEN GFX.DRAWIMAGE battle_bg, 10, 10, sw-20, sh/2-20 ELSE RECT 10, 10, sw-20, sh/2-20, cbg[0]+5, cbg[1], cbg[2]-15, TRUE
                            IF enemy_sprite > 0 THEN SPRITE.DRAW enemy_sprite
                            RECT 10, sh/2+10, sw-20, sh/2-20, cbg[0], cbg[1], cbg[2], TRUE
                            ' Skill list
                            RECT sw - sk_box_w - 15, sh/2+15, sk_box_w, sk_count * menu_item_h + INT(fs*2), cbg[0]+10, cbg[1]+5, cbg[2]+5, TRUE
                            RECT sw - sk_box_w - 15, sh/2+15, sk_box_w, sk_count * menu_item_h + INT(fs*2), cbd[0], cbd[1], cbd[2], FALSE
                            TEXT sw - sk_box_w - 5, sh/2 + INT(fs*0.8), "Fähigkeit wählen:", ctx[0]-30, ctx[1]-30, ctx[2]+15
                            FOR ski = 0 TO sk_count - 1
                                LET sk = skills[ski]
                                LET sky = sh/2 + INT(fs*2) + ski * menu_item_h
                                LET can_use = (pm{"mp"} >= INT(sk{"mp_cost"}))
                                IF ski = sk_sel THEN
                                    RECT sw - sk_box_w - 10, sky-2, sk_box_w - 10, INT(fs*1.2), cms[0], cms[1]-10, cms[2]-20, TRUE
                                    IF can_use THEN
                                        TEXT sw - sk_box_w, sky, "> " + sk{"name"}, ctb[0], ctb[1], ctb[2]
                                    ELSE
                                        TEXT sw - sk_box_w, sky, "> " + sk{"name"}, 150, 80, 80
                                    ENDIF
                                ELSE
                                    IF can_use THEN
                                        TEXT sw - sk_box_w + INT(fs*0.3), sky, sk{"name"}, cmt[0]+40, cmt[1]+40, cmt[2]+20
                                    ELSE
                                        TEXT sw - sk_box_w + INT(fs*0.3), sky, sk{"name"}, 100, 80, 80
                                    ENDIF
                                ENDIF
                                TEXT sw - INT(fs*4), sky, STR$(INT(sk{"mp_cost"})) + "MP", cbd[0]+20, cbd[1], cbd[2]+20
                            NEXT ski
                            TEXT 20, sh - INT(fs*1.5), skills[sk_sel]{"desc"}, ctx[0]-30, ctx[1]-30, ctx[2]-10
                            SPRITE.UPDATE : SCREENFLIP : SLEEP 16
                            LET sev$ = RPG_DIALOG.DRAIN_KEY$()
                            IF sev$ = "Down" THEN sk_sel = (sk_sel + 1) MOD sk_count
                            IF sev$ = "Up" THEN
                                sk_sel = sk_sel - 1
                                IF sk_sel < 0 THEN sk_sel = sk_count - 1
                            ENDIF
                            IF sev$ = "Escape" THEN EXITDO
                            IF sev$ = "Return" OR sev$ = "Space" THEN
                                sk = skills[sk_sel]
                                LET mp_cost = INT(sk{"mp_cost"})
                                IF pm{"mp"} >= mp_cost THEN
                                    sk_chosen = TRUE
                                    EXITDO
                                ELSE
                                    battle_msg$ = "Nicht genug MP!"
                                ENDIF
                            ENDIF
                        LOOP

                        IF sk_chosen THEN
                            sk = skills[sk_sel]
                            mp_cost = INT(sk{"mp_cost"})
                            pm{"mp"} = pm{"mp"} - mp_cost
                            RPG_PARTY.UPDATE_MEMBER cur_member, pm
                            LET stype$ = sk{"type"}
                            IF stype$ = "attack" OR stype$ = "attack_all" THEN
                                LET power = INT(sk{"power"})
                                LET hits = 1
                                IF MAP.EXISTS(sk, "hits") THEN hits = INT(sk{"hits"})
                                LET total_dmg = 0
                                FOR hi = 0 TO hits - 1
                                    LET d = INT(power * (0.8 + RND(1) * 0.4)) - e_def
                                    IF d < 1 THEN d = 1
                                    total_dmg = total_dmg + d
                                NEXT hi
                                e_hp = e_hp - total_dmg
                                IF e_hp < 0 THEN e_hp = 0
                                battle_msg$ = pm{"name"} + " setzt " + sk{"name"} + " ein! " + STR$(total_dmg) + " Schaden!"
                                shake_x = (RND(1) - 0.5) * 25
                                PARTICLE.EMIT e_x + 30, e_y + 30, 12, 100, 150, 255, 80, 0.4, 0, 3
                            ELSEIF stype$ = "heal" OR stype$ = "heal_all" THEN
                                RPG_PARTY.HEAL_ALL INT(sk{"power"})
                                battle_msg$ = pm{"name"} + " setzt " + sk{"name"} + " ein! Gruppe geheilt!"
                                PARTICLE.EMIT 30 + p_gap, p_y + 30, 12, 80, 255, 80, 50, 0.5, -30, 3
                            ELSEIF stype$ = "buff_atk" THEN
                                battle_msg$ = pm{"name"} + " setzt " + sk{"name"} + " ein! ATK erhöht!"
                            ELSEIF stype$ = "buff_def" OR stype$ = "buff_def_all" THEN
                                battle_msg$ = pm{"name"} + " setzt " + sk{"name"} + " ein! DEF erhöht!"
                            ELSEIF stype$ = "restore_mp" THEN
                                pm{"mp"} = pm{"mp"} + INT(sk{"power"})
                                IF pm{"mp"} > pm{"max_mp"} THEN pm{"mp"} = pm{"max_mp"}
                                RPG_PARTY.UPDATE_MEMBER cur_member, pm
                                battle_msg$ = pm{"name"} + " setzt " + sk{"name"} + " ein! MP wiederhergestellt!"
                            ELSE
                                battle_msg$ = pm{"name"} + " setzt " + sk{"name"} + " ein!"
                            ENDIF
                        ENDIF
                    ENDIF

                ELSEIF selected = 2 THEN
                    ' ── ITEM (selection dialog) ──
                    ' Build list of usable consumables from inventory
                    LET use_items = []
                    LET all_inv = RPG_INVENTORY.GET_ALL_ITEMS()
                    FOR ui = 0 TO LEN(all_inv) - 1
                        LET uitm = all_inv[ui]
                        IF uitm{"qty"} > 0 THEN
                            LET utype$ = RPG_INVENTORY.GET_TYPE$(uitm{"name"})
                            IF utype$ = "consumable" THEN PUSH use_items, uitm
                        ENDIF
                    NEXT ui
                    LET use_count = LEN(use_items)

                    IF use_count = 0 THEN
                        battle_msg$ = "Keine Heilitems!"
                    ELSE
                        ' Build choice string: "Heiltrank x2|Mega-Heiltrank x1|Abbrechen"
                        LET choice_str$ = ""
                        FOR ui = 0 TO use_count - 1
                            IF ui > 0 THEN choice_str$ = choice_str$ + "|"
                            choice_str$ = choice_str$ + use_items[ui]{"name"} + " x" + STR$(INT(use_items[ui]{"qty"}))
                        NEXT ui
                        choice_str$ = choice_str$ + "|Abbrechen"

                        LET item_choice = RPG_DIALOG.CHOICE(choice_str$)
                        IF item_choice >= 0 AND item_choice < use_count THEN
                            LET chosen_item = use_items[item_choice]
                            LET chosen_name$ = chosen_item{"name"}
                            ' Look up effects from item database
                            LET effects = RPG_INVENTORY.GET_EFFECTS(chosen_name$)
                            LET heal_amt = 0
                            IF MAP.EXISTS(effects, "heal") THEN heal_amt = INT(effects{"heal"})
                            IF heal_amt > 0 THEN
                                RPG_PARTY.HEAL_MEMBER cur_member, heal_amt
                                PARTICLE.EMIT 30 + cur_member * p_gap + 30, p_y + 30, 10, chp[0], chp[1], chp[2], 40, 0.5, -30, 2
                            ENDIF
                            RPG_INVENTORY.REMOVE_ITEM chosen_name$, 1
                            IF heal_amt > 0 THEN
                                battle_msg$ = pm{"name"} + " benutzt " + chosen_name$ + "! HP +" + STR$(heal_amt)
                            ELSE
                                battle_msg$ = pm{"name"} + " benutzt " + chosen_name$ + "!"
                            ENDIF
                        ELSE
                            ' Cancelled — don't advance turn
                            CONTINUELOOP
                        ENDIF
                    ENDIF

                ELSEIF selected = 3 THEN
                    ' ── DEFEND ──
                    player_defending[cur_member] = TRUE
                    battle_msg$ = pm{"name"} + " verteidigt sich!"

                ELSEIF selected = 4 THEN
                    ' ── FLEE ──
                    IF RND(1) > 0.3 THEN
                        result$ = "flee" : battle_msg$ = "Erfolgreich geflohen!"
                    ELSE
                        battle_msg$ = "Flucht gescheitert!"
                    ENDIF
                ENDIF

                ' Check if enemy died from this attack
                IF e_hp <= 0 THEN
                    result$ = "win"
                ENDIF
                ' Show battle message for ~0.5s before advancing turn
                IF result$ = "" THEN
                    action_delay = 30
                    cur_member = cur_member + 1
                    IF cur_member >= RPG_PARTY.member_count THEN
                        cur_member = 0 : turn$ = "enemy" : anim_timer = 30
                    ENDIF
                    selected = 0
                ENDIF
            ENDIF

        ELSEIF turn$ = "enemy" THEN
            RPG_DIALOG.DRAIN_KEY$()  ' discard input during enemy turn
            anim_timer = anim_timer - 1
            IF anim_timer <= 0 THEN
                IF e_hp > 0 THEN
                    LET target = -1
                    FOR try_t = 0 TO 10
                        LET t = INT(RND(1) * RPG_PARTY.member_count)
                        pm = RPG_PARTY.GET_MEMBER(t)
                        IF pm{"hp"} > 0 THEN target = t : EXITFOR
                    NEXT try_t

                    IF target >= 0 THEN
                        pm = RPG_PARTY.GET_MEMBER(target)
                        LET edef = INT(pm{"def"})
                        IF player_defending[target] THEN edef = edef * 2
                        LET edmg = INT(e_atk * (0.8 + RND(1) * 0.4)) - edef
                        IF edmg < 1 THEN edmg = 1
                        LET new_hp = INT(pm{"hp"}) - edmg
                        IF new_hp < 0 THEN new_hp = 0
                        pm{"hp"} = new_hp
                        RPG_PARTY.UPDATE_MEMBER target, pm
                        battle_msg$ = e_name$ + " greift " + pm{"name"} + " an und macht " + STR$(edmg) + " Schaden!"
                        PARTICLE.EMIT 30 + target * p_gap + 30, p_y + 30, 6, 255, 50, 50, 50, 0.3, 0, 2
                    ENDIF

                    ' Check all dead
                    LET all_dead = TRUE
                    FOR cd = 0 TO RPG_PARTY.member_count - 1
                        LET cpm = RPG_PARTY.GET_MEMBER(cd)
                        IF cpm{"hp"} > 0 THEN all_dead = FALSE
                    NEXT cd
                    IF all_dead THEN result$ = "dead"
                ELSE
                    result$ = "win"
                ENDIF
                turn$ = "player" : cur_member = 0 : selected = 0
                FOR pd = 0 TO RPG_PARTY.member_count - 1
                    player_defending[pd] = FALSE
                NEXT pd
            ENDIF
        ENDIF

        ' ── BATTLE END ───────────────────────────────────────
        IF result$ <> "" THEN
            IF result$ = "win" THEN
                battle_msg$ = "Sieg! +" + STR$(INT(e_xp)) + " XP, +" + STR$(INT(e_gold)) + " Gold"
                RPG_COMBAT.ADD_XP e_xp
                RPG_PARTY.ADD_XP_ALL e_xp
                RPG_INVENTORY.ADD_GOLD e_gold
                IF e_drop$ <> "" AND RND(1) < e_drop_chance THEN
                    ' Look up real item name from database
                    LET drop_data = RPG_INVENTORY.GET_ITEM_DATA(e_drop$)
                    LET drop_name$ = e_drop$
                    LET drop_desc$ = "Monster drop"
                    IF MAP.EXISTS(drop_data, "name") THEN drop_name$ = drop_data{"name"}
                    IF MAP.EXISTS(drop_data, "desc") THEN drop_desc$ = drop_data{"desc"}
                    battle_msg$ = battle_msg$ + ", " + drop_name$ + " erhalten!"
                    RPG_INVENTORY.ADD_ITEM drop_name$, drop_desc$, 1
                ENDIF
                PARTICLE.EMIT e_x + 30, e_y + 20, 20, 255, 215, 0, 80, 1.0, -40, 3
            ELSEIF result$ = "dead" THEN
                battle_msg$ = "Deine Gruppe wurde besiegt..."
            ENDIF

            ' Show result
            FOR wi = 0 TO 90
                RPG_DIALOG.DRAIN_KEY$()  ' discard input during result animation
                CLS cbg[0], cbg[1], cbg[2]
                RECT 10, 10, sw-20, sh/2-20, cbg[0]+5, cbg[1], cbg[2]-15, TRUE
                IF enemy_sprite > 0 AND result$ = "win" THEN
                    LET a = 255 - wi * 3 : IF a < 0 THEN a = 0
                    SPRITE.ALPHA enemy_sprite, a
                    SPRITE.DRAW enemy_sprite
                ENDIF
                RECT 10, sh/2+10, sw-20, sh/2-20, cbg[0], cbg[1], cbg[2], TRUE
                TEXT 25, sh - INT(fs*1.8), battle_msg$, cmsg[0], cmsg[1], cmsg[2]
                PARTICLE.DRAW : SPRITE.UPDATE
                SCREENFLIP : SLEEP 16
            NEXT wi

            ' Wait for confirm
            RPG_DIALOG.DRAIN_KEY$()  ' discard any latched key before waiting
            SLEEP 200
            DO
                ev$ = RPG_DIALOG.DRAIN_KEY$()
                CLS cbg[0], cbg[1], cbg[2]
                RECT 10, sh/2+10, sw-20, sh/2-20, cbg[0], cbg[1], cbg[2], TRUE
                TEXT 25, sh - INT(fs*1.8), battle_msg$, cmsg[0], cmsg[1], cmsg[2]
                LET blink = (INT(TICK() / 400) MOD 2) = 0
                IF blink THEN TEXT sw/2 - INT(fs*8), sh/2 + INT(fs*1.2), "Leertaste zum Fortfahren", ctx[0]-30, ctx[1]-30, ctx[2]+15
                SCREENFLIP : SLEEP 16
            LOOP UNTIL ev$ = "Space" OR ev$ = "Return" OR ev$ = "Escape"

            ' Cleanup
            IF enemy_sprite > 0 THEN SPRITE.DELETE enemy_sprite
            FOR pidx = 0 TO RPG_PARTY.member_count - 1
                IF p_sprites[pidx] > 0 THEN SPRITE.DELETE p_sprites[pidx]
            NEXT pidx
            IF battle_bg > 0 THEN GFX.FREEIMAGE battle_bg : battle_bg = -1
            RPG_MUSIC.PLAY prev_music$
            RETURN result$
        ENDIF
    LOOP
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ ENCOUNTER ════════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT SUB RESET_ENCOUNTER()
    encounter_steps = 0
ENDSUB

EXPORT FUNC CHECK_ENCOUNTER$(room$)
    IF room$ <> "overworld" THEN RETURN ""
    encounter_steps = encounter_steps + 1
    IF encounter_steps > encounter_rate THEN
        IF RND(1) < 0.05 THEN
            encounter_steps = 0
            RETURN RPG_COMBAT.RANDOM_ENEMY_ID$()
        ENDIF
    ENDIF
    RETURN ""
ENDFUNC
