' ===================================================================
' == RPG Inventory Module
' == Item management + bag display + shop system (buy & sell)
' ===================================================================
OPTION "EXPLICIT"
OPTION "STRICT"

EXPORT MODULE RPG_INVENTORY

IMPORT RPG_DIALOG

' ── Inventory ────────────────────────────────────────────────
EXPORT DIM items = []
EXPORT DIM item_count = 0
EXPORT DIM gold = 0
EXPORT DIM asset_path$ = "generated_sprites/"

' ── Item Database (loaded from items.json) ───────────────────
EXPORT DIM item_db = {}

EXPORT SUB SET_ASSET_PATH(path$)
    asset_path$ = path$
ENDSUB

EXPORT SUB LOAD_ITEM_DB(json_file$)
    LET data = JSON.PARSE$(TXTREADER$(json_file$))
    item_db = data{"items"}
ENDSUB

' Look up item data by ID
EXPORT FUNC GET_ITEM_DATA(item_id$)
    IF MAP.EXISTS(item_db, item_id$) THEN RETURN item_db{item_id$}
    RETURN {}
ENDFUNC

' Resolve shop item IDs to full item data array
EXPORT FUNC RESOLVE_SHOP_ITEMS(id_list)
    LET result = []
    FOR i = 0 TO LEN(id_list) - 1
        LET id$ = id_list[i]
        IF MAP.EXISTS(item_db, id$) THEN
            LET itm = item_db{id$}
            PUSH result, itm
        ENDIF
    NEXT i
    RETURN result
ENDFUNC

' Get item effects by name (for combat)
EXPORT FUNC GET_EFFECTS(item_name$)
    LET keys = MAP.KEYS(item_db)
    FOR i = 0 TO LEN(keys) - 1
        LET itm = item_db{keys[i]}
        IF itm{"name"} = item_name$ THEN
            IF MAP.EXISTS(itm, "effects") THEN RETURN itm{"effects"}
        ENDIF
    NEXT i
    RETURN {}
ENDFUNC

' Get item type by name
EXPORT FUNC GET_TYPE$(item_name$)
    LET keys = MAP.KEYS(item_db)
    FOR i = 0 TO LEN(keys) - 1
        LET itm = item_db{keys[i]}
        IF itm{"name"} = item_name$ THEN RETURN itm{"type"}
    NEXT i
    RETURN "unknown"
ENDFUNC

' Get item sell price by name (50% of buy price)
EXPORT FUNC GET_SELL_PRICE(item_name$)
    LET keys = MAP.KEYS(item_db)
    FOR i = 0 TO LEN(keys) - 1
        LET itm = item_db{keys[i]}
        IF itm{"name"} = item_name$ THEN
            IF MAP.EXISTS(itm, "price") THEN RETURN INT(itm{"price"} / 2)
        ENDIF
    NEXT i
    RETURN 1
ENDFUNC

' ── Add item to inventory ────────────────────────────────────
EXPORT SUB ADD_ITEM(name$, desc$, qty)
    ' Check if item already exists — update via copy-back
    FOR i = 0 TO item_count - 1
        LET itm = items[i]
        IF itm{"name"} = name$ THEN
            itm{"qty"} = itm{"qty"} + qty
            items[i] = itm
            RETURN
        ENDIF
    NEXT i
    ' New item
    itm = {}
    itm{"name"} = name$
    itm{"desc"} = desc$
    itm{"qty"} = qty
    PUSH items, itm
    item_count = item_count + 1
ENDSUB

' ── Remove item (returns TRUE if successful) ─────────────────
EXPORT FUNC REMOVE_ITEM(name$, qty)
    FOR i = 0 TO item_count - 1
        LET itm = items[i]
        IF itm{"name"} = name$ THEN
            IF itm{"qty"} >= qty THEN
                itm{"qty"} = itm{"qty"} - qty
                items[i] = itm
                RETURN TRUE
            ELSE
                RETURN FALSE
            ENDIF
        ENDIF
    NEXT i
    RETURN FALSE
ENDFUNC

' ── Check if player has item ─────────────────────────────────
EXPORT FUNC HAS_ITEM(name$)
    FOR i = 0 TO item_count - 1
        IF items[i]{"name"} = name$ AND items[i]{"qty"} > 0 THEN RETURN TRUE
    NEXT i
    RETURN FALSE
ENDFUNC

' ── Get item count ───────────────────────────────────────────
EXPORT FUNC GET_QTY(name$)
    FOR i = 0 TO item_count - 1
        IF items[i]{"name"} = name$ THEN RETURN items[i]{"qty"}
    NEXT i
    RETURN 0
ENDFUNC

' ── Get all items (for equipment scanning) ───────────────────
EXPORT FUNC GET_ALL_ITEMS()
    RETURN items
ENDFUNC

' ── Gold management ──────────────────────────────────────────
EXPORT SUB ADD_GOLD(amount)
    gold = gold + INT(amount)
ENDSUB

EXPORT FUNC GET_GOLD()
    RETURN gold
ENDFUNC

EXPORT FUNC SPEND_GOLD(amount)
    IF gold >= amount THEN
        gold = gold - amount
        RETURN TRUE
    ENDIF
    RETURN FALSE
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ BAG DISPLAY (Tab key) ════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT SUB SHOW_BAG()
    LET bag_bg = GFX.CAPTURE()
    LET sw = SCREENWIDTH()
    LET sh = SCREENHEIGHT()
    LET fs = RPG_DIALOG.FS
    LET lh = INT(fs * 2.4)   ' 2 lines per item: name+type, then description

    ' Color palette
    LET cbg = RPG_DIALOG.C_BOX_BG : LET cbd = RPG_DIALOG.C_BOX_BD
    LET ctx = RPG_DIALOG.C_TEXT : LET ctd = RPG_DIALOG.C_TEXT_DIM
    LET ctb = RPG_DIALOG.C_TEXT_BR : LET ctl = RPG_DIALOG.C_TITLE
    LET cgl = RPG_DIALOG.C_GOLD

    DO
        GFX.DRAW_CAPTURE bag_bg

        ' Semi-transparent overlay
        RECT 0, 0, sw, sh, 0, 0, 0, TRUE

        ' Bag window
        LET bx = INT(fs * 4) : LET by = INT(fs * 2)
        LET bw = sw - bx * 2 : LET bh = sh - by * 2

        RECT bx, by, bw, bh, cbg[0], cbg[1], cbg[2], TRUE
        RECT bx, by, bw, bh, cbd[0], cbd[1], cbd[2], FALSE

        ' Title
        TEXT bx + bw/2 - INT(fs*3), by + INT(fs*0.5), "INVENTAR", ctl[0], ctl[1], ctl[2]
        RECT bx + 10, by + INT(fs*1.8), bw - 20, 2, cbd[0]-20, cbd[1]-40, cbd[2]-40, TRUE

        ' Gold
        TEXT bx + INT(fs*1.2), by + INT(fs*2.2), "Gold: " + STR$(INT(gold)), cgl[0], cgl[1], cgl[2]

        ' Items
        LET iy = by + INT(fs * 3.5)
        IF item_count = 0 THEN
            TEXT bx + INT(fs*1.2), iy, "(leer)", ctd[0]-20, ctd[1]-20, ctd[2]-10
        ELSE
            FOR i = 0 TO item_count - 1
                LET itm = items[i]
                IF itm{"qty"} > 0 THEN
                    TRY
                        LET icon_name$ = LCASE$(REPLACE$(itm{"name"}, " ", "_"))
                        LET icon = GFX.LOADIMAGE(asset_path$ + "item_" + icon_name$ + ".png")
                        GFX.DRAWIMAGE icon, bx + INT(fs*1.2), iy, 16, 16
                        GFX.FREEIMAGE icon
                    CATCH
                    ENDTRY
                    TEXT bx + INT(fs*2.5), iy, itm{"name"}, ctx[0]-10, ctx[1]-10, ctx[2]
                    TEXT bx + INT(fs*12), iy, "x" + STR$(INT(itm{"qty"})), ctd[0]+40, ctd[1]+40, ctd[2]+40
                    LET itype$ = GET_TYPE$(itm{"name"})
                    LET type_x = bx + INT(fs*15)
                    IF itype$ = "weapon" THEN TEXT type_x, iy, "[WAF]", 255, 120, 120
                    IF itype$ = "armor" THEN TEXT type_x, iy, "[RÜS]", 120, 120, 255
                    IF itype$ = "consumable" THEN TEXT type_x, iy, "[VER]", 120, 255, 120
                    IF itype$ = "accessory" THEN TEXT type_x, iy, "[ZUB]", 255, 200, 100
                    IF itype$ = "key" THEN TEXT type_x, iy, "[SCH]", 255, 255, 150
                    ' Description on second line
                    TEXT bx + INT(fs*2.5), iy + INT(fs*1.2), itm{"desc"}, ctd[0], ctd[1], ctd[2]+10
                    iy = iy + lh
                ENDIF
            NEXT i
        ENDIF

        ' Footer
        TEXT bx + bw/2 - INT(fs*5), by + bh - INT(fs*1.5), "Tab zum Schließen", ctd[0]-40, ctd[1]-40, ctd[2]-20

        SCREENFLIP
        SLEEP 16

        IF RPG_DIALOG.quit_event THEN EXITDO
        LET ev$ = RPG_DIALOG.DRAIN_KEY$()
        IF ev$ = "Tab" OR ev$ = "Escape" OR ev$ = "Space" THEN EXITDO
    LOOP

    GFX.FREEIMAGE bag_bg
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ SHOP DIALOG (Buy & Sell) ═════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT DIM shop_purchases = 0

EXPORT FUNC OPEN_SHOP(shop_name$, shop_items)
    LET shop_bg = GFX.CAPTURE()
    LET sw = SCREENWIDTH()
    LET sh = SCREENHEIGHT()
    LET fs = RPG_DIALOG.FS
    LET lh = INT(fs * 1.6)
    LET num_items = LEN(shop_items)
    ' Color palette
    LET cbg = RPG_DIALOG.C_BOX_BG : LET cbd = RPG_DIALOG.C_BOX_BD
    LET ctx = RPG_DIALOG.C_TEXT : LET ctd = RPG_DIALOG.C_TEXT_DIM
    LET ctb = RPG_DIALOG.C_TEXT_BR : LET ctl = RPG_DIALOG.C_TITLE
    LET cgl = RPG_DIALOG.C_GOLD : LET cms = RPG_DIALOG.C_MENU_SEL
    LET cmt = RPG_DIALOG.C_MENU_TXT
    LET selected = 0
    LET mode$ = "buy"   ' "buy" or "sell"

    DO
        GFX.DRAW_CAPTURE shop_bg

        ' Shop window
        LET bx = INT(fs*3) : LET by = INT(fs*1.5)
        LET bw = sw - bx*2 : LET bh = sh - by*2
        RECT bx, by, bw, bh, cbg[0]+5, cbg[1], cbg[2]-10, TRUE
        RECT bx, by, bw, bh, cbd[0]+20, cbd[1]-20, cbd[2]-120, FALSE

        ' Title + Gold
        TEXT bx + INT(fs*1), by + INT(fs*0.5), shop_name$, ctl[0], ctl[1], ctl[2]
        TEXT bx + bw - INT(fs*8), by + INT(fs*0.5), "Gold: " + STR$(INT(gold)), cgl[0], cgl[1], cgl[2]

        ' Tabs: Buy / Sell
        LET tab_y = by + INT(fs * 2)
        LET tab_w = INT(fs * 6)
        IF mode$ = "buy" THEN
            RECT bx + 10, tab_y, tab_w, INT(fs*1.4), cms[0], cms[1]-10, cms[2]-40, TRUE
            TEXT bx + 10 + INT(fs*1), tab_y + INT(fs*0.15), "Kaufen", ctb[0], ctb[1], ctb[2]
            TEXT bx + 10 + tab_w + INT(fs*1.5), tab_y + INT(fs*0.15), "Verkaufen", cmt[0], cmt[1], cmt[2]
        ELSE
            TEXT bx + 10 + INT(fs*1), tab_y + INT(fs*0.15), "Kaufen", cmt[0], cmt[1], cmt[2]
            RECT bx + 10 + tab_w + INT(fs*0.5), tab_y, tab_w + INT(fs*2), INT(fs*1.4), cms[0], cms[1]-10, cms[2]-40, TRUE
            TEXT bx + 10 + tab_w + INT(fs*1.5), tab_y + INT(fs*0.15), "Verkaufen", ctb[0], ctb[1], ctb[2]
        ENDIF
        RECT bx + 10, tab_y + INT(fs*1.4), bw - 20, 2, cbd[0], cbd[1]-40, cbd[2]-140, TRUE

        ' Content area
        LET content_y = tab_y + INT(fs * 2)

        IF mode$ = "buy" THEN
            ' ── BUY MODE ──
            FOR i = 0 TO num_items - 1
                LET itm = shop_items[i]
                LET iy = content_y + i * lh
                IF i = selected THEN
                    RECT bx + 10, iy - INT(fs*0.2), bw - 20, INT(fs*1.4), cms[0]-10, cms[1]-20, cms[2]-50, TRUE
                    TEXT bx + INT(fs*2.5), iy, "> " + itm{"name"}, ctb[0], ctb[1], ctb[2]
                ELSE
                    TEXT bx + INT(fs*3), iy, itm{"name"}, cmt[0]+40, cmt[1]+40, cmt[2]+20
                ENDIF
                TRY
                    LET icon_name$ = LCASE$(REPLACE$(itm{"name"}, " ", "_"))
                    LET icon = GFX.LOADIMAGE(asset_path$ + "item_" + icon_name$ + ".png")
                    GFX.DRAWIMAGE icon, bx + INT(fs*1.2), iy, 16, 16
                    GFX.FREEIMAGE icon
                CATCH
                ENDTRY
                TEXT bx + INT(fs*15), iy, itm{"desc"}, ctd[0], ctd[1], ctd[2]+10
                TEXT bx + bw - INT(fs*5), iy, STR$(INT(itm{"price"})) + "g", cgl[0], cgl[1], cgl[2]
            NEXT i

            ' Leave option
            LET leave_y = content_y + num_items * lh
            IF selected = num_items THEN
                RECT bx + 10, leave_y - INT(fs*0.2), bw - 20, INT(fs*1.4), cms[0]-10, cms[1]-20, cms[2]-50, TRUE
                TEXT bx + INT(fs*1.2), leave_y, "> Verlassen", ctb[0], ctb[1]-55, ctb[2]-55
            ELSE
                TEXT bx + INT(fs*1.8), leave_y, "Verlassen", ctd[0]+10, ctd[1]-20, ctd[2]-40
            ENDIF

            LET max_sel = num_items

        ELSE
            ' ── SELL MODE ──
            LET sell_list = []
            FOR i = 0 TO item_count - 1
                IF items[i]{"qty"} > 0 THEN PUSH sell_list, items[i]
            NEXT i
            LET sell_count = LEN(sell_list)

            IF sell_count = 0 THEN
                TEXT bx + INT(fs*2), content_y, "Keine Gegenstände zum Verkaufen.", ctd[0]+10, ctd[1]+10, ctd[2]+20
            ELSE
                FOR i = 0 TO sell_count - 1
                    LET sitm = sell_list[i]
                    iy = content_y + i * lh
                    LET sell_price = GET_SELL_PRICE(sitm{"name"})
                    IF i = selected THEN
                        RECT bx + 10, iy - INT(fs*0.2), bw - 20, INT(fs*1.4), cms[0]-10, cms[1]-20, cms[2]-50, TRUE
                        TEXT bx + INT(fs*2.5), iy, "> " + sitm{"name"}, ctb[0], ctb[1], ctb[2]
                    ELSE
                        TEXT bx + INT(fs*3), iy, sitm{"name"}, cmt[0]+40, cmt[1]+40, cmt[2]+20
                    ENDIF
                    TEXT bx + INT(fs*13), iy, "x" + STR$(INT(sitm{"qty"})), ctd[0]+40, ctd[1]+40, ctd[2]+40
                    TEXT bx + bw - INT(fs*5), iy, STR$(sell_price) + "g", 120, 255, 120
                NEXT i
            ENDIF

            ' Leave option
            leave_y = content_y + sell_count * lh
            IF selected = sell_count THEN
                RECT bx + 10, leave_y - INT(fs*0.2), bw - 20, INT(fs*1.4), cms[0]-10, cms[1]-20, cms[2]-50, TRUE
                TEXT bx + INT(fs*1.2), leave_y, "> Zurück", ctb[0], ctb[1]-55, ctb[2]-55
            ELSE
                TEXT bx + INT(fs*1.8), leave_y, "Zurück", ctd[0]+10, ctd[1]-20, ctd[2]-40
            ENDIF

            max_sel = sell_count
        ENDIF

        ' Footer
        IF mode$ = "buy" THEN
            TEXT bx + 10, by + bh - INT(fs*1.5), "Hoch/Runter  Enter:Kaufen  S:Verkaufen  Esc:Verlassen", ctd[0]-40, ctd[1]-40, ctd[2]-30
        ELSE
            TEXT bx + 10, by + bh - INT(fs*1.5), "Hoch/Runter  Enter:Verkaufen  K:Kaufen  Esc:Verlassen", ctd[0]-40, ctd[1]-40, ctd[2]-30
        ENDIF

        SCREENFLIP
        SLEEP 16

        IF RPG_DIALOG.quit_event THEN EXITDO
        LET ev$ = RPG_DIALOG.DRAIN_KEY$()
        IF ev$ = "Down" THEN selected = (selected + 1) MOD (max_sel + 1)
        IF ev$ = "Up" THEN
            selected = selected - 1
            IF selected < 0 THEN selected = max_sel
        ENDIF

        ' Tab switching: S for sell, K for buy
        IF ev$ = "S" AND mode$ = "buy" THEN
            mode$ = "sell" : selected = 0
        ENDIF
        IF ev$ = "K" AND mode$ = "sell" THEN
            mode$ = "buy" : selected = 0
        ENDIF

        IF ev$ = "Return" OR ev$ = "Space" THEN
            IF mode$ = "buy" THEN
                IF selected = num_items THEN
                    EXITDO  ' Leave shop
                ELSE
                    itm = shop_items[selected]
                    IF gold >= itm{"price"} THEN
                        gold = gold - itm{"price"}
                        ADD_ITEM itm{"name"}, itm{"desc"}, 1
                        shop_purchases = shop_purchases + 1
                        RPG_DIALOG.SAY shop_name$, "Danke! Hier ist dein " + itm{"name"} + "."
                        GFX.DRAW_CAPTURE shop_bg
                    ELSE
                        RPG_DIALOG.SAY shop_name$, "Dafür hast du nicht genug Gold!"
                        GFX.DRAW_CAPTURE shop_bg
                    ENDIF
                ENDIF
            ELSE
                ' SELL MODE
                IF selected = sell_count THEN
                    mode$ = "buy" : selected = 0  ' Back to buy
                ELSE
                    sitm = sell_list[selected]
                    sell_price = GET_SELL_PRICE(sitm{"name"})
                    IF REMOVE_ITEM(sitm{"name"}, 1) THEN
                        gold = gold + sell_price
                        RPG_DIALOG.SAY shop_name$, sitm{"name"} + " für " + STR$(sell_price) + " Gold verkauft!"
                        GFX.DRAW_CAPTURE shop_bg
                        ' Reset selection if list shrunk
                        IF selected > 0 THEN selected = selected - 1
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        IF ev$ = "Escape" THEN EXITDO
    LOOP

    GFX.FREEIMAGE shop_bg
    LET result = shop_purchases
    shop_purchases = 0
    RETURN result
ENDFUNC

' ── Save/Load helpers ────────────────────────────────────────
EXPORT FUNC GET_SAVE_DATA()
    LET sg = {}
    sg{"gold"} = gold
    sg{"items"} = items
    RETURN sg
ENDFUNC

EXPORT SUB LOAD_SAVE_DATA(sg)
    IF MAP.EXISTS(sg, "gold") THEN gold = sg{"gold"}
    IF MAP.EXISTS(sg, "items") THEN
        items = sg{"items"}
        item_count = LEN(items)
    ENDIF
ENDSUB
