' ===================================================================
' == RPG Engine Module - Generic TiledMap System
' == Loads all entities from TMX objects, supports map transitions
' ===================================================================

EXPORT MODULE RPG_ENGINE

IMPORT RPG_TYPES
IMPORT RPG_DIALOG
IMPORT RPG_MUSIC
IMPORT RPG_INVENTORY
IMPORT RPG_QUEST
IMPORT RPG_BATTLE
IMPORT RPG_PARTY

' ── Global State ─────────────────────────────────────────────
EXPORT DIM quit_flag = FALSE
EXPORT DIM player_name$ = ""
EXPORT DIM hero = -1
EXPORT DIM has_sheet = FALSE
EXPORT DIM direction$ = "down"
EXPORT DIM moving = FALSE
EXPORT DIM speed = 3
EXPORT DIM msg$ = ""
EXPORT DIM msg_timer = 0
EXPORT DIM hint$ = ""

' Map state
EXPORT DIM current_map$ = ""
EXPORT DIM current_map_file$ = ""
EXPORT DIM map_w = 0
EXPORT DIM map_h = 0

' Config
EXPORT DIM T = 32
EXPORT DIM SW = 1280
EXPORT DIM SH = 720
EXPORT DIM sprite_path$ = ""
EXPORT DIM sprite_scale = 1.0
EXPORT DIM sprite_frame_w = 64
EXPORT DIM sprite_frame_h = 64
EXPORT DIM data_dir$ = "D:/usr/dev/cc/fluppi/rpg_data/"
EXPORT DIM game = {}

' Ground layers (auto-detected from map)
EXPORT DIM ground_layers = []
EXPORT DIM cam_off_x = 0
EXPORT DIM cam_off_y = 0

' Entities on current map
EXPORT DIM npcs = []
EXPORT DIM npc_count = 0
EXPORT DIM monsters = []
EXPORT DIM monster_count = 0
EXPORT DIM portals = []
EXPORT DIM portal_count = 0
EXPORT DIM chests = []
EXPORT DIM chest_count = 0

' Party following
EXPORT DIM recruit_data = {}
EXPORT DIM follow_sprites = []
EXPORT DIM follow_count = 0
EXPORT DIM path_trail = []
EXPORT DIM last_trail_x = -999
EXPORT DIM last_trail_y = -999

' Per-map saved state: map_states{map_id} = {chests_opened:[], monsters_defeated:[]}
EXPORT DIM map_states = {}

' ══════════════════════════════════════════════════════════════
' ══ TITLE SCREEN ═════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT FUNC SHOW_TITLE(config_file$)
    game = JSON.PARSE$(TXTREADER$(config_file$))
    SW = game{"screen_w"} : SH = game{"screen_h"}
    SCREEN SW, SH, game{"title"}

    font$ = "C:/Windows/Fonts/arial.ttf"
    IF MAP.EXISTS(game, "font") THEN font$ = game{"font"}
    font_size = 16
    IF MAP.EXISTS(game, "font_size") THEN font_size = game{"font_size"}
    TRY : SETFONT font$, font_size
    CATCH : SETFONT "C:/Windows/Fonts/arial.ttf", 14 : ENDTRY

    c = game{"colors"}
    cb = c{"text_bright"} : cm = c{"menu_text"}
    cs = c{"menu_sel"} : cbd = c{"box_border"} : cd = c{"text_dim"}

    RPG_MUSIC.SETUP
    RPG_MUSIC.PLAY "title"

    welcome_bg = -1
    TRY : welcome_bg = GFX.LOADIMAGE(game{"welcome_bg"}) : CATCH : ENDTRY

    selected = 0
    num_items = 3
    items = ["Neues Spiel", "Laden", "Beenden"]

    DO
        CLS 10, 10, 30
        IF welcome_bg > 0 THEN GFX.DRAWIMAGE welcome_bg, 0, 0, SW, SH

        menu_y = SH / 2 + 20
        FOR i = 0 TO num_items - 1
            iy = menu_y + i * 44
            IF i = selected THEN
                RECT SW/2 - 100, iy - 6, 200, 36, cs[0], cs[1], cs[2], TRUE
                RECT SW/2 - 100, iy - 6, 200, 36, cbd[0], cbd[1], cbd[2], FALSE
                TEXT SW/2 - 50, iy, "> " + items[i], cb[0], cb[1], cb[2]
            ELSE
                TEXT SW/2 - 40, iy, items[i], cm[0], cm[1], cm[2]
            ENDIF
        NEXT i
        TEXT SW/2 - 80, SH - 30, "Pfeiltasten + Enter", cd[0], cd[1], cd[2]
        SCREENFLIP : SLEEP 16

        ev$ = GFX.POLLEVENT()
        IF ev$ = "KEYDOWN:F11" THEN TOGGLE_FULLSCREEN
        IF ev$ = "KEYDOWN:Down" THEN selected = (selected + 1) MOD num_items
        IF ev$ = "KEYDOWN:Up" THEN
            selected = selected - 1
            IF selected < 0 THEN selected = num_items - 1
        ENDIF
        IF ev$ = "KEYDOWN:Return" OR ev$ = "KEYDOWN:Space" THEN
            IF selected = 2 THEN RETURN 2
            GFX.FADE 0, 0.5
            RETURN selected
        ENDIF
        IF ev$ = "QUIT" OR ev$ = "KEYDOWN:Escape" THEN RETURN 2
    LOOP
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ INIT ═════════════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT SUB INIT(config_file$)
    game = JSON.PARSE$(TXTREADER$(config_file$))
    SW = game{"screen_w"} : SH = game{"screen_h"}
    sprite_path$ = game{"sprite_path"}
    IF MAP.EXISTS(game, "sprite_scale") THEN sprite_scale = game{"sprite_scale"}
    IF MAP.EXISTS(game, "sprite_frame_w") THEN sprite_frame_w = INT(game{"sprite_frame_w"})
    IF MAP.EXISTS(game, "sprite_frame_h") THEN sprite_frame_h = INT(game{"sprite_frame_h"})

    IF SCREENWIDTH() = 0 THEN
        SCREEN SW, SH, game{"title"}
        TRY : SETFONT game{"font"}, game{"font_size"}
        CATCH : SETFONT "C:/Windows/Fonts/arial.ttf", 14 : ENDTRY
        RPG_MUSIC.SETUP
    ENDIF

    RPG_INVENTORY.SET_ASSET_PATH "generated_sprites/"

    ' Apply colors from config to dialog system
    IF MAP.EXISTS(game, "colors") THEN
        c = game{"colors"}
        IF MAP.EXISTS(c, "box_bg") THEN
            bg = c{"box_bg"}
            RPG_DIALOG.DLG_COLOR_R = bg[0]
            RPG_DIALOG.DLG_COLOR_G = bg[1]
            RPG_DIALOG.DLG_COLOR_B = bg[2]
        ENDIF
        IF MAP.EXISTS(c, "box_border") THEN
            bd = c{"box_border"}
            RPG_DIALOG.DLG_BORDER_R = bd[0]
            RPG_DIALOG.DLG_BORDER_G = bd[1]
            RPG_DIALOG.DLG_BORDER_B = bd[2]
        ENDIF
    ENDIF
    RPG_INVENTORY.LOAD_ITEM_DB data_dir$ + "items.json"

    IF MAP.EXISTS(game, "player_stats") THEN
        RPG_COMBAT.INIT_PLAYER game{"player_stats"}
    ENDIF
    RPG_COMBAT.LOAD_ENEMIES data_dir$ + "enemies.json", sprite_path$
    RPG_QUEST.LOAD_QUESTS data_dir$ + "quests.json"

    RPG_PARTY.LOAD_DATA data_dir$ + "characters.json", data_dir$ + "skills.json", sprite_path$
    RPG_PARTY.ADD_MEMBER "vally"

    ' Create player sprite
    TRY
        hero = SPRITE.LOAD(sprite_path$ + game{"player_sprite"}, sprite_frame_w, sprite_frame_h)
        SPRITE.SCALE hero, sprite_scale
        has_sheet = TRUE
    CATCH
        PRINT "Kein Spieler-Sprite!" : END
    ENDTRY
    SPRITE.ZORDER hero, 10 : SPRITE.GROUP hero, "player"
    IF has_sheet THEN
        SPRITE.ANIM hero, "idle_down",  [0, 1, 0, 2], 3
        SPRITE.ANIM hero, "idle_left",  [3, 4, 3, 5], 3
        SPRITE.ANIM hero, "idle_right", [6, 7, 6, 8], 3
        SPRITE.ANIM hero, "idle_up",    [9, 10, 9, 11], 3
        SPRITE.ANIM hero, "walk_down",  [0, 1, 0, 2], 6
        SPRITE.ANIM hero, "walk_left",  [3, 4, 3, 5], 6
        SPRITE.ANIM hero, "walk_right", [6, 7, 6, 8], 6
        SPRITE.ANIM hero, "walk_up",    [9, 10, 9, 11], 6
        SPRITE.PLAY hero, "idle_down"
    ENDIF

    ' Load start map
    ENTER_MAP game{"start_map"}, "default_spawn"
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ MAP MANAGER ══════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT SUB ENTER_MAP(map_file$, spawn_name$)
    ' Save state of current map before leaving
    IF current_map$ <> "" THEN
        SAVE_MAP_STATE
        CLEAR_MAP_ENTITIES
        TILED.FREE current_map$
    ENDIF

    ' Load new map
    current_map_file$ = map_file$
    ok = TILED.LOAD("world", map_file$)
    IF NOT ok THEN
        PRINT "FEHLER: Map nicht geladen: "; map_file$
        RETURN
    ENDIF
    current_map$ = "world"

    sz = TILED.SIZE(current_map$)
    map_w = sz[0] : map_h = sz[1]

    ' Read map properties
    map_props = TILED.PROPERTIES(current_map$)
    map_id$ = ""
    IF MAP.EXISTS(map_props, "map_id") THEN map_id$ = map_props{"map_id"}
    IF MAP.EXISTS(map_props, "music") THEN RPG_MUSIC.PLAY map_props{"music"}

    ' Detect ground layers
    ground_layers = []
    layers = TILED.LAYERS$(current_map$)
    FOR i = 0 TO LEN(layers) - 1
        IF LEFT$(layers[i], 7) = "ground_" THEN PUSH ground_layers, layers[i]
    NEXT

    ' Camera
    camera_fixed = FALSE
    IF MAP.EXISTS(map_props, "camera_fixed") THEN
        IF map_props{"camera_fixed"} = "true" THEN camera_fixed = TRUE
    ENDIF
    ' Camera offset for centering maps smaller than screen
    IF map_w < SW THEN
        cam_off_x = -(SW - map_w) / 2
    ELSE
        cam_off_x = 0
    ENDIF
    IF map_h < SH THEN
        cam_off_y = -(SH - map_h) / 2
    ELSE
        cam_off_y = 0
    ENDIF

    IF camera_fixed THEN
        CAM.FOLLOW -1, 0
        CAM.SET cam_off_x, cam_off_y
        CAM.BOUNDS cam_off_x, cam_off_y, map_w, map_h
    ELSE
        CAM.FOLLOW hero, 0.15
        CAM.BOUNDS cam_off_x, cam_off_y, map_w, map_h
    ENDIF

    ' Load entities from TMX objects
    LOAD_MAP_ENTITIES

    ' Find spawn point and position player
    spawn_x = 0 : spawn_y = 0
    found_spawn = FALSE
    FOR i = 0 TO LEN(layers) - 1
        objs = TILED.OBJECTS(current_map$, layers[i])
        FOR j = 0 TO LEN(objs) - 1
            o = objs[j]
            IF o{"type"} = "player_spawn" THEN
                IF o{"name"} = spawn_name$ OR NOT found_spawn THEN
                    spawn_x = o{"x"} : spawn_y = o{"y"}
                    IF MAP.EXISTS(o, "properties") THEN
                        p = o{"properties"}
                        IF MAP.EXISTS(p, "direction") THEN direction$ = p{"direction"}
                    ENDIF
                    IF o{"name"} = spawn_name$ THEN found_spawn = TRUE
                ENDIF
            ENDIF
        NEXT
    NEXT
    SPRITE.POS hero, spawn_x, spawn_y
    last_trail_x = spawn_x : last_trail_y = spawn_y
    path_trail = []

    ' Restore saved state for this map
    IF map_id$ <> "" AND MAP.EXISTS(map_states, map_id$) THEN
        RESTORE_MAP_STATE map_id$
    ENDIF

    ' Recreate follow sprites for recruited party members
    follow_sprites = []
    follow_count = 0
    UPDATE_FOLLOW_SPRITES

    PRINT "Map: "; map_file$; " ("; map_w; "x"; map_h; ")"
ENDSUB

' ── Load all entities from TMX object layers ─────────────────
SUB LOAD_MAP_ENTITIES()
    npcs = [] : npc_count = 0
    monsters = [] : monster_count = 0
    portals = [] : portal_count = 0
    chests = [] : chest_count = 0

    layers = TILED.LAYERS$(current_map$)
    edata = JSON.PARSE$(TXTREADER$(data_dir$ + "enemies.json"))
    elist = edata{"enemies"}

    FOR li = 0 TO LEN(layers) - 1
        objs = TILED.OBJECTS(current_map$, layers[li])
        FOR j = 0 TO LEN(objs) - 1
            o = objs[j]
            obj_type$ = o{"type"}
            obj_name$ = o{"name"}
            props = {}
            IF MAP.EXISTS(o, "properties") THEN props = o{"properties"}

            IF obj_type$ = "npc" THEN
                ' Build NPC data dict from TMX properties
                npc_data = {}
                npc_data{"name"} = obj_name$
                npc_data{"x"} = o{"x"}
                npc_data{"y"} = o{"y"}
                IF MAP.EXISTS(props, "dialog") THEN npc_data{"dialog"} = props{"dialog"}
                IF MAP.EXISTS(props, "sprite") THEN npc_data{"sprite"} = props{"sprite"}
                npc_data{"frame_w"} = sprite_frame_w
                npc_data{"frame_h"} = sprite_frame_h
                npc_data{"scale"} = sprite_scale
                IF MAP.EXISTS(props, "frame_w") THEN npc_data{"frame_w"} = VAL(props{"frame_w"})
                IF MAP.EXISTS(props, "frame_h") THEN npc_data{"frame_h"} = VAL(props{"frame_h"})
                IF MAP.EXISTS(props, "scale") THEN npc_data{"scale"} = VAL(props{"scale"})
                IF MAP.EXISTS(props, "can_recruit") THEN npc_data{"can_recruit"} = (props{"can_recruit"} = "true")
                IF MAP.EXISTS(props, "recruit_id") THEN npc_data{"recruit_id"} = props{"recruit_id"}
                IF MAP.EXISTS(props, "dialog_joined") THEN npc_data{"dialog_joined"} = props{"dialog_joined"}
                IF MAP.EXISTS(props, "is_shop") THEN npc_data{"is_shop"} = (props{"is_shop"} = "true")
                IF MAP.EXISTS(props, "shop_items") THEN npc_data{"shop_items"} = props{"shop_items"}

                DIM npc AS RPG_TYPES.T_NPC
                npc.INIT npc_data, sprite_path$
                ' Hide if already recruited
                rpid$ = ""
                IF MAP.EXISTS(npc_data, "recruit_id") THEN rpid$ = npc_data{"recruit_id"}
                IF rpid$ <> "" AND MAP.EXISTS(recruit_data, rpid$) THEN
                    npc.SET_VISIBLE FALSE
                ENDIF
                PUSH npcs, npc
                npc_count = npc_count + 1

            ELSEIF obj_type$ = "monster" THEN
                eid$ = ""
                IF MAP.EXISTS(props, "enemy_id") THEN eid$ = props{"enemy_id"}
                IF eid$ = "" THEN CONTINUEFOR
                FOR ei = 0 TO LEN(elist) - 1
                    IF elist[ei]{"id"} = eid$ AND elist[ei]{"sprite"} <> "" THEN
                        TRY
                            sf$ = sprite_path$ + elist[ei]{"sprite"}
                            fw = INT(elist[ei]{"frame_w"}) : fh = INT(elist[ei]{"frame_h"})
                            sid = SPRITE.LOAD(sf$, fw, fh)
                            SPRITE.POS sid, o{"x"}, o{"y"}
                            SPRITE.SCALE sid, sprite_scale
                            SPRITE.ZORDER sid, 6
                            SPRITE.GROUP sid, "monster"
                            af = elist[ei]{"anim_frames"}
                            af_len = LEN(af)
                            IF TYPEOF(af_len) = "ARRAY" THEN af_len = af_len[0]
                            IF af_len > 0 THEN
                                SPRITE.ANIM sid, "idle", af, INT(elist[ei]{"anim_fps"})
                                SPRITE.PLAY sid, "idle"
                            ENDIF
                            nm = {}
                            nm{"id"} = eid$ : nm{"name"} = obj_name$
                            nm{"defeated"} = FALSE : nm{"sprite_id"} = sid
                            nm{"orig_x"} = o{"x"} : nm{"orig_y"} = o{"y"}
                            PUSH monsters, nm
                            monster_count = monster_count + 1
                        CATCH
                        ENDTRY
                        EXITFOR
                    ENDIF
                NEXT ei

            ELSEIF obj_type$ = "portal" THEN
                portal = {}
                portal{"name"} = obj_name$
                portal{"x"} = o{"x"} : portal{"y"} = o{"y"}
                portal{"width"} = o{"width"} : portal{"height"} = o{"height"}
                portal{"gid"} = o{"gid"}
                IF MAP.EXISTS(props, "target_map") THEN portal{"target_map"} = props{"target_map"}
                portal{"target_spawn"} = "default_spawn"
                IF MAP.EXISTS(props, "target_spawn") THEN portal{"target_spawn"} = props{"target_spawn"}
                PUSH portals, portal
                portal_count = portal_count + 1

            ELSEIF obj_type$ = "chest" THEN
                chest = {}
                chest{"name"} = obj_name$
                chest{"x"} = o{"x"} : chest{"y"} = o{"y"}
                chest{"opened"} = FALSE
                chest{"content_type"} = "gold"
                IF MAP.EXISTS(props, "content_type") THEN chest{"content_type"} = props{"content_type"}
                chest{"content_amount"} = 1
                IF MAP.EXISTS(props, "content_amount") THEN chest{"content_amount"} = VAL(props{"content_amount"})
                IF MAP.EXISTS(props, "content_id") THEN chest{"content_id"} = props{"content_id"}
                ' Create chest sprite (2 frames: closed/open)
                TRY
                    csid = SPRITE.LOAD(sprite_path$ + "chest.png", 32, 32)
                    SPRITE.POS csid, o{"x"}, o{"y"}
                    SPRITE.ZORDER csid, 8
                    SPRITE.GROUP csid, "chest"
                    SPRITE.FRAME csid, 0
                    chest{"sprite_id"} = csid
                CATCH
                    chest{"sprite_id"} = -1
                ENDTRY
                PUSH chests, chest
                chest_count = chest_count + 1
            ENDIF
        NEXT
    NEXT
ENDSUB

' ── Clear all entities (before map switch) ────────────────────
SUB CLEAR_MAP_ENTITIES()
    FOR i = 0 TO npc_count - 1
        n = npcs[i]
        TRY : SPRITE.DELETE n.sprite_id : CATCH : ENDTRY
    NEXT
    FOR i = 0 TO monster_count - 1
        m = monsters[i]
        IF m{"sprite_id"} > 0 THEN
            TRY : SPRITE.DELETE m{"sprite_id"} : CATCH : ENDTRY
        ENDIF
    NEXT
    FOR i = 0 TO chest_count - 1
        c = chests[i]
        IF c{"sprite_id"} > 0 THEN
            TRY : SPRITE.DELETE c{"sprite_id"} : CATCH : ENDTRY
        ENDIF
    NEXT
    FOR i = 0 TO follow_count - 1
        IF follow_sprites[i] > 0 THEN
            TRY : SPRITE.DELETE follow_sprites[i] : CATCH : ENDTRY
        ENDIF
    NEXT
    npcs = [] : npc_count = 0
    monsters = [] : monster_count = 0
    portals = [] : portal_count = 0
    chests = [] : chest_count = 0
    follow_sprites = [] : follow_count = 0
ENDSUB

' ── Save current map state ────────────────────────────────────
SUB SAVE_MAP_STATE()
    map_props = TILED.PROPERTIES(current_map$)
    mid$ = ""
    IF MAP.EXISTS(map_props, "map_id") THEN mid$ = map_props{"map_id"}
    IF mid$ = "" THEN RETURN

    state = {}
    ' Defeated monsters
    defeated = []
    FOR i = 0 TO monster_count - 1
        m = monsters[i]
        IF m{"defeated"} THEN PUSH defeated, m{"name"}
    NEXT
    state{"monsters_defeated"} = defeated

    ' Opened chests
    opened = []
    FOR i = 0 TO chest_count - 1
        c = chests[i]
        IF c{"opened"} THEN PUSH opened, c{"name"}
    NEXT
    state{"chests_opened"} = opened

    map_states{mid$} = state
ENDSUB

' ── Restore saved map state ───────────────────────────────────
SUB RESTORE_MAP_STATE(map_id$)
    IF NOT MAP.EXISTS(map_states, map_id$) THEN RETURN
    state = map_states{map_id$}

    ' Restore defeated monsters
    IF MAP.EXISTS(state, "monsters_defeated") THEN
        defeated = state{"monsters_defeated"}
        FOR di = 0 TO LEN(defeated) - 1
            dname$ = defeated[di]
            FOR mi = 0 TO monster_count - 1
                m = monsters[mi]
                IF m{"name"} = dname$ AND NOT m{"defeated"} THEN
                    IF m{"sprite_id"} > 0 THEN
                        TRY : SPRITE.DELETE m{"sprite_id"} : CATCH : ENDTRY
                    ENDIF
                    m{"defeated"} = TRUE : m{"sprite_id"} = -1
                    monsters[mi] = m
                ENDIF
            NEXT
        NEXT
    ENDIF

    ' Restore opened chests
    IF MAP.EXISTS(state, "chests_opened") THEN
        opened = state{"chests_opened"}
        FOR oi = 0 TO LEN(opened) - 1
            oname$ = opened[oi]
            FOR ci = 0 TO chest_count - 1
                IF chests[ci]{"name"} = oname$ THEN
                    chests[ci]{"opened"} = TRUE
                    IF chests[ci]{"sprite_id"} > 0 THEN
                        TRY
                            SPRITE.FRAME chests[ci]{"sprite_id"}, 1
                            SPRITE.GROUP chests[ci]{"sprite_id"}, "opened"
                        CATCH
                        ENDTRY
                    ENDIF
                ENDIF
            NEXT
        NEXT
    ENDIF
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ COLLISION ════════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
FUNC IS_WALKABLE(px, py)
    ' Map bounds check
    IF px < 0 OR py < 0 OR px >= map_w OR py >= map_h THEN RETURN FALSE
    ' Ground check
    FOR li = 0 TO LEN(ground_layers) - 1
        tid = TILED.TILE_AT(current_map$, ground_layers[li], px, py)
        IF tid > 0 THEN
            ' Collision layer check
            ctid = TILED.TILE_AT(current_map$, "collision", px, py)
            IF ctid > 0 THEN RETURN FALSE
            RETURN TRUE
        ENDIF
    NEXT li
    RETURN FALSE
ENDFUNC

FUNC CAN_MOVE_TO(x, y, w, h)
    inset = 4
    IF NOT IS_WALKABLE(x + inset, y + inset) THEN RETURN FALSE
    IF NOT IS_WALKABLE(x + w - inset - 1, y + inset) THEN RETURN FALSE
    IF NOT IS_WALKABLE(x + inset, y + h - inset - 1) THEN RETURN FALSE
    IF NOT IS_WALKABLE(x + w - inset - 1, y + h - inset - 1) THEN RETURN FALSE
    RETURN TRUE
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ FACING / INTERACTION HELPERS ═════════════════════════════
' ══════════════════════════════════════════════════════════════
FUNC FACING_SPRITE_CHECK(dir$, group$)
    cx = SPRITE.GET_X(hero) : cy = SPRITE.GET_Y(hero)
    IF dir$ = "up"    THEN cy = cy - T
    IF dir$ = "down"  THEN cy = cy + T
    IF dir$ = "left"  THEN cx = cx - T
    IF dir$ = "right" THEN cx = cx + T
    ox = SPRITE.GET_X(hero) : oy = SPRITE.GET_Y(hero)
    SPRITE.POS hero, cx, cy
    result = SPRITE.COLLISION_FIRST(hero, group$)
    SPRITE.POS hero, ox, oy
    RETURN result
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ PORTAL CHECK ═════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
SUB CHECK_PORTALS()
    hx = SPRITE.GET_X(hero) : hy = SPRITE.GET_Y(hero)
    hsw = SPRITE.WIDTH(hero) : hsh = SPRITE.HEIGHT(hero)

    FOR i = 0 TO portal_count - 1
        p = portals[i]
        px = p{"x"} : py = p{"y"}
        pw = p{"width"} : ph = p{"height"}
        ' For tile-objects (with gid), y is bottom-left in Tiled
        IF MAP.EXISTS(p, "gid") AND p{"gid"} > 0 THEN py = py - ph

        ' Simple rectangle overlap
        IF hx + hsw > px AND hx < px + pw AND hy + hsh > py AND hy < py + ph THEN
            IF MAP.EXISTS(p, "target_map") THEN
                target_map$ = p{"target_map"}
                target_spawn$ = p{"target_spawn"}
                ' Ensure .tmx extension
                IF RIGHT$(target_map$, 4) <> ".tmx" THEN target_map$ = "maps/" + target_map$ + ".tmx"
                IF LEFT$(target_map$, 5) <> "maps/" THEN target_map$ = "maps/" + target_map$
                GFX.FADE 0, 0.3
                ENTER_MAP target_map$, target_spawn$
                GFX.FADE 1, 0.3
                RETURN
            ENDIF
        ENDIF
    NEXT
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ PARTY FOLLOWING ══════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
SUB UPDATE_FOLLOW_SPRITES()
    FOR fi = 1 TO RPG_PARTY.member_count - 1
        IF fi - 1 >= follow_count THEN
            pm = RPG_PARTY.GET_MEMBER(fi)
            TRY
                fs = SPRITE.LOAD(sprite_path$ + pm{"sprite"}, sprite_frame_w, sprite_frame_h)
                SPRITE.SCALE fs, sprite_scale
                SPRITE.ANIM fs, "idle_down",  [0, 1, 0, 2], 3
                SPRITE.ANIM fs, "walk_down",  [0, 1, 0, 2], 6
                SPRITE.ANIM fs, "walk_left",  [3, 4, 3, 5], 6
                SPRITE.ANIM fs, "walk_right", [6, 7, 6, 8], 6
                SPRITE.ANIM fs, "walk_up",    [9, 10, 9, 11], 6
                SPRITE.PLAY fs, "idle_down"
                SPRITE.ZORDER fs, 9
                ' Position at hero
                SPRITE.POS fs, SPRITE.GET_X(hero), SPRITE.GET_Y(hero)
                ' Hide original NPC sprite
                pm_name$ = pm{"name"}
                FOR ni = 0 TO npc_count - 1
                    nn = npcs[ni]
                    IF nn.name$ = pm_name$ THEN
                        nn.SET_VISIBLE FALSE
                    ENDIF
                NEXT ni
                PUSH follow_sprites, fs
                follow_count = follow_count + 1
            CATCH
                PUSH follow_sprites, -1
                follow_count = follow_count + 1
            ENDTRY
        ENDIF
    NEXT fi
ENDSUB

SUB UPDATE_FOLLOW_POSITIONS()
    IF follow_count = 0 THEN RETURN
    hx = SPRITE.GET_X(hero) : hy = SPRITE.GET_Y(hero)
    dx = hx - last_trail_x : dy = hy - last_trail_y
    dist = SQR(dx*dx + dy*dy)
    IF dist >= T THEN
        PUSH path_trail, [last_trail_x, last_trail_y]
        last_trail_x = hx : last_trail_y = hy
        DO WHILE LEN(path_trail) > 50
            new_trail = []
            tl = LEN(path_trail)
            FOR ti = 1 TO tl - 1
                PUSH new_trail, path_trail[ti]
            NEXT ti
            path_trail = new_trail
        LOOP
    ENDIF
    tl = LEN(path_trail)
    IF TYPEOF(tl) = "ARRAY" THEN tl = tl[0]
    FOR fi = 0 TO follow_count - 1
        IF follow_sprites[fi] < 0 THEN CONTINUEFOR
        crumb_idx = tl - (fi + 1)
        IF crumb_idx < 0 THEN crumb_idx = 0
        cur_x = SPRITE.GET_X(follow_sprites[fi])
        cur_y = SPRITE.GET_Y(follow_sprites[fi])
        IF crumb_idx < tl THEN
            target = path_trail[crumb_idx]
            tx = target[0] : ty = target[1]
        ELSE
            tx = cur_x : ty = cur_y
        ENDIF
        fdx = tx - cur_x : fdy = ty - cur_y
        fdist = SQR(fdx*fdx + fdy*fdy)
        IF fdist > 2 THEN
            fspeed = 2.5
            new_x = cur_x : new_y = cur_y
            IF ABS(fdx) >= ABS(fdy) THEN
                IF ABS(fdx) < fspeed THEN new_x = tx ELSE new_x = cur_x + SGN(fdx) * fspeed
            ELSE
                IF ABS(fdy) < fspeed THEN new_y = ty ELSE new_y = cur_y + SGN(fdy) * fspeed
            ENDIF
            hdx = new_x - hx : hdy = new_y - hy
            hdist = SQR(hdx*hdx + hdy*hdy)
            IF hdist >= T THEN
                SPRITE.POS follow_sprites[fi], new_x, new_y
                IF ABS(fdx) >= ABS(fdy) THEN
                    IF fdx > 0 THEN SPRITE.PLAY follow_sprites[fi], "walk_right"
                    IF fdx < 0 THEN SPRITE.PLAY follow_sprites[fi], "walk_left"
                ELSE
                    IF fdy > 0 THEN SPRITE.PLAY follow_sprites[fi], "walk_down"
                    IF fdy < 0 THEN SPRITE.PLAY follow_sprites[fi], "walk_up"
                ENDIF
            ENDIF
        ELSE
            SPRITE.PLAY follow_sprites[fi], "idle_down"
        ENDIF
    NEXT fi
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ UPDATE ═══════════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT SUB UPDATE()
    TILED.UPDATE 0.016

    ev$ = GFX.POLLEVENT()
    IF ev$ = "QUIT" OR ev$ = "KEYDOWN:Escape" THEN quit_flag = TRUE : RETURN
    IF ev$ = "KEYDOWN:F11" THEN TOGGLE_FULLSCREEN
    IF ev$ = "KEYDOWN:Tab" THEN DRAW_SCENE : RPG_INVENTORY.SHOW_BAG
    IF ev$ = "KEYDOWN:P" THEN DRAW_SCENE : RPG_PARTY.SHOW_PARTY
    IF ev$ = "KEYDOWN:S" THEN DRAW_SCENE : RPG_PARTY.SHOW_SKILL_TREE 0
    IF ev$ = "KEYDOWN:Q" THEN DRAW_SCENE : RPG_QUEST.SHOW_LOG

    ' Movement
    old_x = SPRITE.GET_X(hero) : old_y = SPRITE.GET_Y(hero)
    moving = FALSE
    IF GFX.KEYSTATE("Right") THEN SPRITE.MOVE hero, speed, 0 : direction$ = "right" : moving = TRUE
    IF GFX.KEYSTATE("Left")  THEN SPRITE.MOVE hero, -speed, 0 : direction$ = "left" : moving = TRUE
    IF GFX.KEYSTATE("Down")  THEN SPRITE.MOVE hero, 0, speed : direction$ = "down" : moving = TRUE
    IF GFX.KEYSTATE("Up")    THEN SPRITE.MOVE hero, 0, -speed : direction$ = "up" : moving = TRUE

    ' Collision
    new_x = SPRITE.GET_X(hero) : new_y = SPRITE.GET_Y(hero)
    hero_w = SPRITE.WIDTH(hero) : hero_h = SPRITE.HEIGHT(hero)
    blocked = NOT CAN_MOVE_TO(new_x, new_y, hero_w, hero_h)
    IF NOT blocked THEN blocked = (SPRITE.COLLISION_FIRST(hero, "npc") > 0)
    IF NOT blocked THEN blocked = (SPRITE.COLLISION_FIRST(hero, "chest") > 0)
    IF blocked THEN SPRITE.POS hero, old_x, old_y

    IF has_sheet THEN
        IF moving THEN SPRITE.PLAY hero, "walk_" + direction$
        IF NOT moving THEN SPRITE.PLAY hero, "idle_" + direction$
    ENDIF

    ' Party follow
    UPDATE_FOLLOW_POSITIONS

    ' Portal check
    CHECK_PORTALS

    ' Monster respawn check
    FOR mi = 0 TO monster_count - 1
        m = monsters[mi]
        IF m{"defeated"} THEN
            IF NOT MAP.EXISTS(m, "respawn_at") THEN
                m{"respawn_at"} = TICK() + 10000
                monsters[mi] = m
            ENDIF
            IF MAP.EXISTS(m, "respawn_at") AND TICK() >= m{"respawn_at"} THEN
                ' Respawn at original position
                TRY
                    edata = JSON.PARSE$(TXTREADER$(data_dir$ + "enemies.json"))
                    elist = edata{"enemies"}
                    FOR ei = 0 TO LEN(elist) - 1
                        IF elist[ei]{"id"} = m{"id"} AND elist[ei]{"sprite"} <> "" THEN
                            sid = SPRITE.LOAD(sprite_path$ + elist[ei]{"sprite"}, INT(elist[ei]{"frame_w"}), INT(elist[ei]{"frame_h"}))
                            SPRITE.POS sid, m{"orig_x"}, m{"orig_y"}
                            SPRITE.SCALE sid, sprite_scale
                            SPRITE.ZORDER sid, 6
                            SPRITE.GROUP sid, "monster"
                            af = elist[ei]{"anim_frames"}
                            IF LEN(af) > 0 THEN
                                SPRITE.ANIM sid, "idle", af, INT(elist[ei]{"anim_fps"})
                                SPRITE.PLAY sid, "idle"
                            ENDIF
                            m{"defeated"} = FALSE : m{"sprite_id"} = sid
                            MAP.DELETE m, "respawn_at"
                            monsters[mi] = m
                            EXITFOR
                        ENDIF
                    NEXT ei
                CATCH
                ENDTRY
            ENDIF
        ENDIF
    NEXT mi

    ' Monster combat
    monster_hit = SPRITE.COLLISION_FIRST(hero, "monster")
    IF monster_hit > 0 THEN
        FOR mi = 0 TO monster_count - 1
            m = monsters[mi]
            IF m{"sprite_id"} = monster_hit AND NOT m{"defeated"} THEN
                GFX.FADE 0, 0.3
                battle_result$ = RPG_BATTLE.FIGHT$(m{"id"})
                GFX.FADE 1, 0.3
                IF battle_result$ = "win" THEN
                    SPRITE.DELETE monster_hit
                    m{"defeated"} = TRUE : m{"sprite_id"} = -1
                    m{"respawn_at"} = TICK() + 10000
                    monsters[mi] = m
                    RPG_QUEST.PROGRESS "defeat:" + m{"id"}, 1
                ELSEIF battle_result$ = "dead" THEN
                    RPG_DIALOG.SAY "System", "Du bist gefallen... Eine geheimnisvolle Kraft erweckt dich."
                    RPG_COMBAT.HEAL_PLAYER INT(RPG_COMBAT.player{"max_hp"} / 2)
                    SPRITE.POS hero, old_x, old_y
                ENDIF
                EXITFOR
            ENDIF
        NEXT mi
    ENDIF

    ' Facing detection
    npc_hit = FACING_SPRITE_CHECK(direction$, "npc")
    chest_hit = FACING_SPRITE_CHECK(direction$, "chest")
    hint$ = ""
    IF npc_hit > 0 THEN hint$ = "[Leertaste] Reden"
    IF chest_hit > 0 THEN hint$ = "[Leertaste] Öffnen"

    IF ev$ = "KEYDOWN:Space" AND msg_timer <= 0 THEN
        ' Chest interaction
        IF chest_hit > 0 THEN
            FOR ci = 0 TO chest_count - 1
                c = chests[ci]
                IF c{"sprite_id"} = chest_hit AND NOT c{"opened"} THEN
                    c{"opened"} = TRUE
                    TRY : SPRITE.FRAME chest_hit, 1 : CATCH : ENDTRY
                    SPRITE.GROUP chest_hit, "opened"
                    ct$ = c{"content_type"}
                    ca = INT(c{"content_amount"})
                    IF ct$ = "gold" THEN
                        RPG_INVENTORY.ADD_GOLD ca
                        RPG_DIALOG.SAY "", "Du hast " + STR$(ca) + " Gold gefunden!"
                        msg$ = "+" + STR$(ca) + " Gold!" : msg_timer = 60
                    ELSEIF ct$ = "item" AND MAP.EXISTS(c, "content_id") THEN
                        RPG_INVENTORY.ADD_ITEM c{"content_id"}, "", 1
                        RPG_DIALOG.SAY "", "Du hast " + c{"content_id"} + " gefunden!"
                        msg$ = c{"content_id"} + " erhalten!" : msg_timer = 60
                    ELSEIF ct$ = "key" THEN
                        RPG_DIALOG.SAY "", "Du hast einen Schlüssel gefunden!"
                    ENDIF
                    chests[ci] = c
                    EXITFOR
                ENDIF
            NEXT ci
        ENDIF
        IF npc_hit > 0 THEN
            FOR i = 0 TO npc_count - 1
                n = npcs[i]
                IF n.sprite_id = npc_hit THEN
                    IF player_name$ = "" THEN
                        DRAW_SCENE
                        player_name$ = RPG_DIALOG.ASK$("", "Wie heisst du, Abenteurerin?")
                        IF player_name$ = "" THEN player_name$ = "Vally"
                    ENDIF
                    rpid$ = n.recruit_id$
                    already = MAP.EXISTS(recruit_data, rpid$)

                    ' Quest handling first (may show quest dialog instead)
                    DRAW_SCENE
                    quest_handled = RPG_QUEST.HANDLE_NPC(n.name$, player_name$)

                    ' If no quest handled, show normal dialog
                    IF NOT quest_handled THEN
                        n.INTERACT player_name$, already
                    ENDIF

                    ' Recruitment offer
                    IF n.can_recruit AND NOT already THEN
                        DRAW_SCENE
                        RPG_DIALOG.SAY n.name$, n.name$ + " möchte sich deiner Gruppe anschließen!"
                        DRAW_SCENE
                        recruit_choice = RPG_DIALOG.CHOICE("Ja, willkommen!|Vielleicht später")
                        IF recruit_choice = 0 THEN
                            RPG_PARTY.ADD_MEMBER rpid$
                            recruit_data{rpid$} = TRUE
                            hx_now = SPRITE.GET_X(hero) : hy_now = SPRITE.GET_Y(hero)
                            last_trail_x = hx_now : last_trail_y = hy_now
                            path_trail = [] : PUSH path_trail, [hx_now, hy_now]
                            UPDATE_FOLLOW_SPRITES
                            msg$ = n.name$ + " ist der Gruppe beigetreten!" : msg_timer = 90
                            IF n.dialog_joined$ <> "" THEN
                                jdlg$ = REPLACE$(n.dialog_joined$, "{PLAYER}", player_name$)
                                DRAW_SCENE : RPG_DIALOG.SAY n.name$, jdlg$
                            ENDIF
                        ENDIF
                    ENDIF

                    ' Shop
                    IF n.is_shop AND n.shop_items$ <> "" THEN
                        item_ids = SPLIT(n.shop_items$, ",")
                        DRAW_SCENE
                        resolved = RPG_INVENTORY.RESOLVE_SHOP_ITEMS(item_ids)
                        purchases = RPG_INVENTORY.OPEN_SHOP(n.name$, resolved)
                        IF purchases > 0 THEN
                            RPG_QUEST.PROGRESS "buy:item", purchases
                        ENDIF
                    ENDIF

                    ' Progress talk quests
                    RPG_QUEST.PROGRESS "talk:" + n.name$, 1

                    EXITFOR
                ENDIF
            NEXT i
            msg_timer = 30
        ENDIF
    ENDIF

    IF msg_timer > 0 THEN msg_timer = msg_timer - 1
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ DRAW ═════════════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
SUB DRAW_SCENE()
    CLS 20, 40, 80
    SPRITE.UPDATE

    ' Get current camera position for explicit draw calls
    cx = CAM.X() : cy = CAM.Y()

    ' Draw layers below sprites, then sprites, then layers above
    layers = TILED.LAYERS$(current_map$)
    FOR li = 0 TO LEN(layers) - 1
        ln$ = layers[li]
        IF LEFT$(ln$, 11) <> "decor_above" THEN
            TILED.DRAW_LAYER current_map$, ln$, cx, cy
        ENDIF
    NEXT

    SPRITE.DRAW_ALL
    PARTICLE.DRAW

    ' Draw above-layers on top of sprites
    FOR li = 0 TO LEN(layers) - 1
        ln$ = layers[li]
        IF LEFT$(ln$, 11) = "decor_above" THEN
            TILED.DRAW_LAYER current_map$, ln$, cx, cy
        ENDIF
    NEXT

    ' HUD (screen-space, top-left)
    hud_x = 10 : hud_y = 10
    IF player_name$ <> "" THEN
        TEXT hud_x, hud_y, player_name$, 255, 220, 80
        hud_y = hud_y + 18
    ENDIF
    gold = RPG_INVENTORY.GET_GOLD()
    IF gold > 0 THEN
        TEXT hud_x, hud_y, "Gold: " + STR$(INT(gold)), 255, 215, 0
        hud_y = hud_y + 18
    ENDIF
    FOR pidx = 0 TO RPG_PARTY.member_count - 1
        pm = RPG_PARTY.GET_MEMBER(pidx)
        TEXT hud_x, hud_y, LEFT$(pm{"name"}, 8), 180, 180, 220
        bar_x = hud_x + 70 : bar_w = 60
        hp_pct = pm{"hp"} / pm{"max_hp"}
        RECT bar_x, hud_y + 2, bar_w, 10, 60, 30, 30, TRUE
        RECT bar_x, hud_y + 2, INT(bar_w * hp_pct), 10, 80, 200, 80, TRUE
        TEXT bar_x + bar_w + 4, hud_y, STR$(INT(pm{"hp"})), 180, 200, 180
        hud_y = hud_y + 16
    NEXT pidx
ENDSUB

EXPORT SUB DRAW()
    DRAW_SCENE
    scrw = SCREENWIDTH() : scrh = SCREENHEIGHT()
    TEXT scrw-420, 10, "Pfeile:Laufen Space:Aktion Tab:Inventar P:Gruppe Q:Quests", 130, 130, 150
    qc = RPG_QUEST.ACTIVE_COUNT()
    IF qc > 0 THEN TEXT scrw-150, 28, "Quests: " + STR$(qc) + " (Q)", 180, 180, 100
    IF hint$ <> "" THEN TEXT scrw/2-60, scrh-30, hint$, 200, 255, 200
    IF msg_timer > 0 THEN TEXT scrw/2-100, scrh-55, msg$, 255, 255, 100
ENDSUB

' ══════════════════════════════════════════════════════════════
' ══ SAVE / LOAD ══════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT DIM save_file$ = "D:/usr/dev/cc/fluppi/rpg_data/savegame.json"

EXPORT SUB SAVE_GAME()
    SAVE_MAP_STATE
    sg = {}
    sg{"player_name"} = player_name$
    sg{"player_x"} = SPRITE.GET_X(hero)
    sg{"player_y"} = SPRITE.GET_Y(hero)
    sg{"direction"} = direction$
    sg{"current_map_file"} = current_map_file$
    sg{"map_states"} = map_states
    sg{"recruit_data"} = recruit_data
    sg{"inventory"} = RPG_INVENTORY.GET_SAVE_DATA()
    sg{"player_combat"} = RPG_COMBAT.GET_SAVE_DATA()
    sg{"party"} = RPG_PARTY.GET_SAVE_DATA()
    sg{"quests"} = RPG_QUEST.GET_SAVE_DATA()
    TXTWRITER save_file$, JSON.STRINGIFY$(sg)
    PRINT "Spiel gespeichert."
ENDSUB

EXPORT FUNC LOAD_GAME()
    TRY
        sg = JSON.PARSE$(TXTREADER$(save_file$))
        IF MAP.EXISTS(sg, "player_name") THEN player_name$ = sg{"player_name"}
        IF MAP.EXISTS(sg, "direction") THEN direction$ = sg{"direction"}
        IF MAP.EXISTS(sg, "map_states") THEN map_states = sg{"map_states"}
        IF MAP.EXISTS(sg, "inventory") THEN RPG_INVENTORY.LOAD_SAVE_DATA sg{"inventory"}
        IF MAP.EXISTS(sg, "player_combat") THEN RPG_COMBAT.LOAD_SAVE_DATA sg{"player_combat"}
        IF MAP.EXISTS(sg, "quests") THEN RPG_QUEST.LOAD_SAVE_DATA sg{"quests"}

        ' Restore recruits
        IF MAP.EXISTS(sg, "recruit_data") THEN
            recruit_data = sg{"recruit_data"}
            rkeys = MAP.KEYS(recruit_data)
            FOR ri = 0 TO LEN(rkeys) - 1
                IF recruit_data{rkeys[ri]} THEN RPG_PARTY.ADD_MEMBER rkeys[ri]
            NEXT ri
        ENDIF
        IF MAP.EXISTS(sg, "party") THEN RPG_PARTY.LOAD_SAVE_DATA sg{"party"}

        ' Load saved map
        IF MAP.EXISTS(sg, "current_map_file") THEN
            ENTER_MAP sg{"current_map_file"}, "default_spawn"
            IF MAP.EXISTS(sg, "player_x") THEN
                SPRITE.POS hero, sg{"player_x"}, sg{"player_y"}
                last_trail_x = sg{"player_x"} : last_trail_y = sg{"player_y"}
            ENDIF
        ENDIF
        PRINT "Spielstand geladen."
        RETURN TRUE
    CATCH
        RETURN FALSE
    ENDTRY
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ SHUTDOWN ═════════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════
EXPORT SUB SHUTDOWN()
    IF current_map$ <> "" THEN
        SAVE_MAP_STATE
        TILED.FREE current_map$
    ENDIF
ENDSUB
