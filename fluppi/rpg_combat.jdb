' ===================================================================
' == RPG Combat Module
' == Player stats, enemy spawning, and encounter system
' ===================================================================

EXPORT MODULE RPG_COMBAT

IMPORT RPG_DIALOG
IMPORT RPG_INVENTORY

' ══════════════════════════════════════════════════════════════
' ══ PLAYER STATS ═════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════

' Player stats are stored as a MAP (player{"hp"}, player{"atk"}, etc.)
' These helper functions operate on the global player MAP.

EXPORT SUB HEAL_PLAYER(amount)
    player{"hp"} = player{"hp"} + INT(amount)
    IF player{"hp"} > player{"max_hp"} THEN player{"hp"} = player{"max_hp"}
ENDSUB

EXPORT SUB ADD_XP(amount)
    player{"xp"} = player{"xp"} + INT(amount)
    IF player{"xp"} >= player{"xp_next"} THEN
        player{"level"} = player{"level"} + 1
        player{"xp"} = player{"xp"} - player{"xp_next"}
        player{"xp_next"} = INT(player{"xp_next"} * 1.5)
        player{"max_hp"} = player{"max_hp"} + 10
        player{"hp"} = player{"max_hp"}
        player{"atk"} = player{"atk"} + 2
        player{"def"} = player{"def"} + 1
    ENDIF
ENDSUB

EXPORT FUNC TOTAL_ATK()
    total = player{"atk"}
    inv = RPG_INVENTORY.GET_ALL_ITEMS()
    FOR i = 0 TO LEN(inv) - 1
        itm = inv[i]
        IF itm{"qty"} > 0 THEN
            eff = RPG_INVENTORY.GET_EFFECTS(itm{"name"})
            IF MAP.EXISTS(eff, "atk") THEN total = total + INT(eff{"atk"})
        ENDIF
    NEXT i
    RETURN total
ENDFUNC

EXPORT FUNC TOTAL_DEF()
    total = player{"def"}
    inv = RPG_INVENTORY.GET_ALL_ITEMS()
    FOR i = 0 TO LEN(inv) - 1
        itm = inv[i]
        IF itm{"qty"} > 0 THEN
            eff = RPG_INVENTORY.GET_EFFECTS(itm{"name"})
            IF MAP.EXISTS(eff, "def") THEN total = total + INT(eff{"def"})
        ENDIF
    NEXT i
    RETURN total
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ ENEMY TYPE ═══════════════════════════════════════════════
' ══════════════════════════════════════════════════════════════

EXPORT TYPE T_ENEMY
    id$
    name$
    sprite_file$
    frame_w
    frame_h
    anim_frames
    anim_fps
    hp
    max_hp
    atk
    def
    xp
    gold
    drop_item$
    drop_chance
    sprite_id

    SUB INIT_FROM_MAP(data, asset_path$)
        THIS.id$ = data{"id"}
        THIS.name$ = data{"name"}
        THIS.frame_w = INT(data{"frame_w"})
        THIS.frame_h = INT(data{"frame_h"})
        THIS.anim_frames = data{"anim_frames"}
        THIS.anim_fps = INT(data{"anim_fps"})
        THIS.hp = INT(data{"hp"})
        THIS.max_hp = THIS.hp
        THIS.atk = INT(data{"atk"})
        THIS.def = INT(data{"def"})
        THIS.xp = INT(data{"xp"})
        THIS.gold = INT(data{"gold"})
        THIS.drop_item$ = data{"drop_item"}
        THIS.drop_chance = data{"drop_chance"}
        THIS.sprite_id = -1
        THIS.sprite_file$ = ""
        IF data{"sprite"} <> "" THEN
            THIS.sprite_file$ = asset_path$ + data{"sprite"}
        ENDIF
    ENDSUB

    ' Load sprite for battle display
    FUNC LOAD_BATTLE_SPRITE()
        IF THIS.sprite_file$ = "" THEN RETURN -1
        TRY
            sid = SPRITE.LOAD(THIS.sprite_file$, THIS.frame_w, THIS.frame_h)
            THIS.sprite_id = sid
            SPRITE.ANIM sid, "idle", THIS.anim_frames, THIS.anim_fps
            SPRITE.PLAY sid, "idle"
            RETURN sid
        CATCH
            RETURN -1
        ENDTRY
    ENDFUNC

    SUB TAKE_DAMAGE(amount)
        dmg = INT(amount) - THIS.def
        IF dmg < 1 THEN dmg = 1
        THIS.hp = THIS.hp - dmg
        IF THIS.hp < 0 THEN THIS.hp = 0
    ENDSUB

    FUNC IS_ALIVE()
        RETURN THIS.hp > 0
    ENDFUNC
ENDTYPE

' ══════════════════════════════════════════════════════════════
' ══ ENEMY REGISTRY ═══════════════════════════════════════════
' ══════════════════════════════════════════════════════════════

EXPORT DIM enemy_templates = []
EXPORT DIM template_count = 0
EXPORT DIM asset_path$ = ""

EXPORT SUB LOAD_ENEMIES(json_file$, apath$)
    asset_path$ = apath$
    data = JSON.PARSE$(TXTREADER$(json_file$))
    elist = data{"enemies"}
    FOR i = 0 TO LEN(elist) - 1
        DIM en AS RPG_COMBAT.T_ENEMY
        en.INIT_FROM_MAP elist[i], asset_path$
        PUSH enemy_templates, en
        template_count = template_count + 1
    NEXT i
ENDSUB

' Create a fresh enemy MAP by ID (for battle)
EXPORT FUNC SPAWN_ENEMY(id$)
    tc = LEN(enemy_templates)
    FOR i = 0 TO tc - 1
        t = enemy_templates[i]
        IF t.id$ = id$ THEN
            en = {}
            en{"id"} = t.id$
            en{"name"} = t.name$
            en{"sprite_file"} = t.sprite_file$
            en{"frame_w"} = t.frame_w
            en{"frame_h"} = t.frame_h
            en{"anim_frames"} = t.anim_frames
            en{"anim_fps"} = t.anim_fps
            en{"hp"} = t.max_hp
            en{"max_hp"} = t.max_hp
            en{"atk"} = t.atk
            en{"def"} = t.def
            en{"xp"} = t.xp
            en{"gold"} = t.gold
            en{"drop_item"} = t.drop_item$
            en{"drop_chance"} = t.drop_chance
            RETURN en
        ENDIF
    NEXT i
    RETURN {}
ENDFUNC

' Get a random enemy ID
EXPORT FUNC RANDOM_ENEMY_ID$()
    tc = LEN(enemy_templates)
    IF tc = 0 THEN RETURN ""
    idx = INT(RND(1) * tc)
    IF idx >= tc THEN idx = tc - 1
    RETURN enemy_templates[idx].id$
ENDFUNC

' ══════════════════════════════════════════════════════════════
' ══ PLAYER STATS INSTANCE ════════════════════════════════════
' ══════════════════════════════════════════════════════════════

EXPORT DIM player = {}

EXPORT SUB INIT_PLAYER(stats_data)
    player{"hp"} = INT(stats_data{"hp"})
    player{"max_hp"} = INT(stats_data{"max_hp"})
    player{"atk"} = INT(stats_data{"atk"})
    player{"def"} = INT(stats_data{"def"})
    player{"level"} = INT(stats_data{"level"})
    player{"xp"} = INT(stats_data{"xp"})
    player{"xp_next"} = INT(stats_data{"xp_next"})
ENDSUB

' ── Use an item (heal, etc.) ─────────────────────────────────
EXPORT SUB USE_ITEM(item_name$)
    IF NOT RPG_INVENTORY.HAS_ITEM(item_name$) THEN
        RPG_DIALOG.SAY "", "Du hast diesen Gegenstand nicht!"
        RETURN
    ENDIF
    eff = RPG_INVENTORY.GET_EFFECTS(item_name$)
    itype$ = RPG_INVENTORY.GET_TYPE$(item_name$)
    IF itype$ = "consumable" AND MAP.EXISTS(eff, "heal") THEN
        heal_amt = INT(eff{"heal"})
        HEAL_PLAYER heal_amt
        RPG_INVENTORY.REMOVE_ITEM item_name$, 1
        RPG_DIALOG.SAY "", item_name$ + " benutzt! HP +" + STR$(heal_amt)
    ELSEIF itype$ = "weapon" OR itype$ = "armor" OR itype$ = "accessory" THEN
        RPG_DIALOG.SAY "", item_name$ + " ist passiv ausgerüstet."
    ELSE
        RPG_DIALOG.SAY "", "Diesen Gegenstand kannst du hier nicht benutzen."
    ENDIF
ENDSUB

' ── Save/Load ────────────────────────────────────────────────
EXPORT FUNC GET_SAVE_DATA()
    RETURN player
ENDFUNC

EXPORT SUB LOAD_SAVE_DATA(data)
    INIT_PLAYER data
ENDSUB

' ── Draw HP bar (for HUD) ────────────────────────────────────
EXPORT SUB DRAW_HP_BAR(x, y, w, h)
    RECT x, y, w, h, 60, 30, 30, TRUE
    IF player{"max_hp"} > 0 THEN
        fill = INT((player{"hp"} / player{"max_hp"}) * w)
        IF fill > w THEN fill = w
        IF fill > 0 THEN RECT x, y, fill, h, 80, 200, 80, TRUE
    ENDIF
    RECT x, y, w, h, 100, 100, 120, FALSE
ENDSUB
