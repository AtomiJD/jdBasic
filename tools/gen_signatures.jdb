' Writes doc/signatures.md: every builtin the language reference documents,
' as its signature alone, grouped by the section of doc/languages.md that
' describes it. The file is the reference at a glance - small enough to be
' read whole before writing jdBasic, while the reference says what each
' builtin does. With --check it only reports whether the file is current
' and exits 1 if not. With --core it writes nothing and prints the sections
' every program draws on, read from the reference as it stands, and names
' the sections it left out; a session start hook hands that to an agent.
' A hook's output has a size limit, so --core N prints the Nth piece of at
' most PIECE_CHARS characters, cut between sections, and nothing when there
' is no such piece. Run from the repository root.
'
'   jdbasic tools/gen_signatures.jdb [--check | --core [N]]

DIM doc_path$ = "doc/languages.md"
DIM out_path$ = "doc/signatures.md"
DIM table_path$ = "src/builtin_sigs.h"
DIM nl$ = CHR$(10)

' Sections --core leaves out: one subsystem each, looked up when a task
' needs it. A section that is not named here is part of the core.
DIM SUBSYSTEMS = ["Graphics and Multimedia Functions", "ImGui Functions", "Native Windows Forms (FORM.*)", "Terminal UI (TUI.*)", _
    "Live Coding Sequencer", "Track Sends and Sidechain", "Visualization & Analysis", "WAV I/O (FX flag)", "FX chain (FX flag)", _
    "MIDI (MIDI flag)", "Live monitor (MINIAUDIO flag)", "Capture (MINIAUDIO flag)", "Mouse / Joystick / Gamepad Input", _
    "Local LLMs (llama.cpp)", "RAG (Retrieval Augmented Generation)", "Text Classifier (k-NN on Embeddings)", _
    "ONNX Runtime (Classical ML)", "Serial Communication (COM)", "Python Integration (build flag PYTHON)", _
    "Bare metal: the kernel target", "Nodes and messages", "Calls", "Topics", "The prompt and the flash store", _
    "The radio on the ESP32-S3", "COM Automation Functions", "Building a Web Server & API", "TCP and UDP Sockets (NET)"]

DIM PIECE_CHARS = 3500

DIM check_only = FALSE
DIM core_only = FALSE
DIM piece_wanted = 0
DIM cli = OS.ARGS()
FOR a = 0 TO LEN(cli) - 1
    IF cli[a] = "--check" THEN check_only = TRUE
    IF cli[a] = "--core" THEN
        core_only = TRUE
        IF a + 1 < LEN(cli) THEN piece_wanted = VAL(cli[a + 1])
    ENDIF
NEXT a

' Whether a signature opens with the name of a builtin: upper case, at least
' two characters. A parameter, a field or a key is written in lower case.
FUNC NamesBuiltin(sig$)
    DIM name$ = ""
    FOR EACH ch IN -sig$
        IF ch = "(" OR ch = " " OR ch = "[" OR ch = "," THEN EXITFOR
        name$ = name$ + ch
    NEXT
    IF LEN(name$) < 2 ORELSE LEFT$(name$, 1) = "_" THEN RETURN FALSE
    FOR EACH ch IN -name$
        IF NOT ((ch >= "A" AND ch <= "Z") OR (ch >= "0" AND ch <= "9") OR ch = "_" OR ch = "." OR ch = "$") THEN RETURN FALSE
    NEXT
    RETURN TRUE
ENDFUNC

' The name a signature opens with.
FUNC SigName$(sig$)
    DIM name$ = ""
    FOR EACH ch IN -sig$
        IF ch = "(" OR ch = " " OR ch = "[" OR ch = "," THEN EXITFOR
        name$ = name$ + ch
    NEXT
    RETURN name$
ENDFUNC

' The signatures a reference bullet opens with. One bullet may describe
' several builtins: **`A(x)`**, **`B(x)`** / **`C(x)`** and **`D(x)`**: ...
FUNC BulletSignatures(row$)
    DIM found = []
    DIM rest$ = MID$(row$, 2, LEN(row$) - 2)
    DIM joints = [", ", " / ", " and ", " + ", " or "]
    DO WHILE STARTSWITH(rest$, "**`")
        DIM closeAt = INSTR(rest$, "`**")
        IF closeAt < 4 THEN EXITDO
        DIM sig$ = MID$(rest$, 3, closeAt - 3)
        IF NOT NamesBuiltin(sig$) THEN EXITDO
        found = APPEND(found, sig$)
        rest$ = MID$(rest$, closeAt + 3, LEN(rest$))
        FOR EACH joint$ IN joints
            IF STARTSWITH(rest$, joint$ + "**`") THEN
                rest$ = MID$(rest$, LEN(joint$), LEN(rest$))
                EXITFOR
            ENDIF
        NEXT
    LOOP
    RETURN found
ENDFUNC

' The signature a fourth-level heading consists of (#### `NAME(args)`), or "".
FUNC HeadingSignature$(row$)
    DIM body$ = TRIM$(MID$(row$, 5, LEN(row$) - 5))
    IF LEN(body$) < 4 ORELSE LEFT$(body$, 1) <> "`" ORELSE RIGHT$(body$, 1) <> "`" THEN RETURN ""
    DIM sig$ = MID$(body$, 1, LEN(body$) - 2)
    IF INSTR(sig$, "`") >= 0 ORELSE NOT NamesBuiltin(sig$) THEN RETURN ""
    RETURN sig$
ENDFUNC

DIM rows = SPLIT(REPLACE$(TXTREADER$(doc_path$), CHR$(13), ""), nl$)

DIM out_rows = ["# jdBasic signatures", ""]
out_rows = APPEND(out_rows, "Generated by `tools/gen_signatures.jdb` from [languages.md](languages.md); do not edit.")
out_rows = APPEND(out_rows, "Every documented builtin as its signature, under the section of the reference that")
out_rows = APPEND(out_rows, "describes it. `[x]` is an optional argument, `-> kind` the answer. Strings and arrays")
out_rows = APPEND(out_rows, "count from 0. The last section names the builtins the reference describes in another")
out_rows = APPEND(out_rows, "form (a table, running text); a builtin that is nowhere in this file does not exist.")

DIM core_rows = ["jdBasic builtins every program draws on (signatures from doc/languages.md, read now):"]
DIM left_out = []
DIM in_fence = FALSE
DIM title$ = ""
DIM sigs = []
DIM n_sigs = 0
DIM n_sections = 0
DIM listed = {}
FOR EACH row$ IN APPEND(rows, "## ")
    IF STARTSWITH(LTRIM$(row$), "```") THEN in_fence = NOT in_fence
    IF in_fence THEN CONTINUEFOR
    DIM level = 0
    IF STARTSWITH(row$, "## ") THEN level = 2
    IF STARTSWITH(row$, "### ") THEN level = 3
    IF level > 0 THEN
        IF LEN(sigs) > 0 THEN
            out_rows = APPEND(APPEND(APPEND(out_rows, ""), "## " + title$), "")
            out_rows = APPEND(out_rows, "`" + JOIN(sigs, "` · `") + "`")
            n_sections = n_sections + 1
            n_sigs = n_sigs + LEN(sigs)
            IF FIND_IN_ARRAY(SUBSYSTEMS, title$) >= 0 THEN
                left_out = APPEND(left_out, title$)
            ELSE
                core_rows = APPEND(core_rows, title$ + ": " + JOIN(sigs, " | "))
            ENDIF
        ENDIF
        title$ = REPLACE$(TRIM$(MID$(row$, level + 1, LEN(row$) - level - 1)), "`", "")
        sigs = []
    ELSEIF STARTSWITH(row$, "* **`") THEN
        FOR EACH bullet_sig$ IN BulletSignatures(row$)
            sigs = APPEND(sigs, bullet_sig$)
            listed{SigName$(bullet_sig$)} = TRUE
        NEXT
    ELSEIF STARTSWITH(row$, "#### `") THEN
        DIM heading_sig$ = HeadingSignature$(row$)
        IF LEN(heading_sig$) > 0 THEN
            sigs = APPEND(sigs, heading_sig$)
            listed{SigName$(heading_sig$)} = TRUE
        ENDIF
    ENDIF
NEXT
' The builtin table knows every name; what no signature above names is
' described in the reference in another form.
DIM unlisted = []
FOR EACH table_row$ IN SPLIT(REPLACE$(TXTREADER$(table_path$), CHR$(13), ""), nl$)
    DIM entry$ = LTRIM$(table_row$)
    IF NOT STARTSWITH(entry$, "{" + CHR$(34)) THEN CONTINUEFOR
    DIM table_name$ = MID$(entry$, 2, INSTR(MID$(entry$, 2, LEN(entry$)), CHR$(34)))
    IF LEN(table_name$) > 1 ANDALSO TYPEOF(listed{table_name$}) = "NONE" THEN unlisted = APPEND(unlisted, table_name$)
NEXT
IF LEN(unlisted) > 0 THEN
    out_rows = APPEND(APPEND(APPEND(out_rows, ""), "## Described in another form"), "")
    out_rows = APPEND(out_rows, "Names only; `jdb_doc NAME` or a search of languages.md gives the signature.")
    out_rows = APPEND(APPEND(out_rows, ""), "`" + JOIN(unlisted, "` · `") + "`")
ENDIF
DIM result$ = JOIN(out_rows, nl$) + nl$

IF core_only THEN
    core_rows = APPEND(core_rows, "Not listed, in " + out_path$ + " under these headings: " + JOIN(left_out, "; "))
    core_rows = APPEND(core_rows, "Exist as well, signature by jdb_doc <NAME>: " + JOIN(unlisted, " "))
    core_rows = APPEND(core_rows, "What a builtin does: jdb_doc <NAME>, or its section in " + doc_path$ + ". A builtin that is in none of these lists does not exist.")
    IF piece_wanted < 1 THEN
        PRINT JOIN(core_rows, nl$)
    ELSE
        DIM pieces = []
        DIM piece$ = ""
        FOR EACH core_row$ IN core_rows
            IF LEN(piece$) > 0 ANDALSO LEN(piece$) + LEN(core_row$) + 1 > PIECE_CHARS THEN
                pieces = APPEND(pieces, piece$)
                piece$ = ""
            ENDIF
            IF LEN(piece$) > 0 THEN piece$ = piece$ + nl$
            piece$ = piece$ + core_row$
        NEXT
        pieces = APPEND(pieces, piece$)
        IF piece_wanted <= LEN(pieces) THEN
            PRINT "jdBasic signatures, part " + STR$(piece_wanted) + " of " + STR$(LEN(pieces)) + ":"
            PRINT pieces[piece_wanted - 1]
        ENDIF
    ENDIF
ELSEIF check_only THEN
    DIM have$ = ""
    IF FILE.EXISTS(out_path$) THEN have$ = REPLACE$(TXTREADER$(out_path$), CHR$(13), "")
    IF have$ = result$ THEN
        PRINT "signatures: "; n_sigs; " builtins in "; n_sections; " sections, current"
    ELSE
        PRINT out_path$; ": out of date - run jdbasic tools/gen_signatures.jdb"
        END 1
    ENDIF
ELSE
    TXTWRITER out_path$, result$
    PRINT "signatures written: "; n_sigs; " builtins in "; n_sections; " sections"
ENDIF
