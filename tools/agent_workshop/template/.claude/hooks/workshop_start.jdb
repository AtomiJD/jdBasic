' SessionStart hook: names this project's workspace and summarises what the
' saved workspace holds, so the agent knows what to restore before it starts.
' Usage: jdbasic workshop_start.jdb [project_dir]

FUNC WsName$(folder$)
    DIM chars = -LCASE$(PATH.BASENAME$(PATH.NORMALIZE$(folder$)))
    IF LEN(chars) = 0 THEN RETURN "workshop"
    RETURN JOIN(SELECT(LAMBDA c -> IIF(INSTR("abcdefghijklmnopqrstuvwxyz0123456789_-", c) >= 0, c, "_"), chars), "")
END FUNC

FUNC DefinedNames(lines)
    DIM found = []
    FOR EACH src_chunk IN lines
        FOR EACH ln IN SPLIT(src_chunk, CHR$(10))
            DIM t$ = UCASE$(TRIM$(ln))
            IF STARTSWITH(t$, "ASYNC FUNC ") THEN t$ = MID$(t$, 6)
            IF STARTSWITH(t$, "FUNC ") ORELSE STARTSWITH(t$, "SUB ") THEN
                DIM head$ = TRIM$(MID$(t$, INSTR(t$, " ") + 1))
                DIM paren = INSTR(head$, "(")
                IF paren >= 0 THEN head$ = LEFT$(head$, paren)
                IF NOT (head$ IN found) THEN found = APPEND(found, head$)
            ENDIF
        NEXT ln
    NEXT src_chunk
    RETURN found
END FUNC

DIM argv = OS.ARGS()
DIM proj$ = PATH.ABS$(".")
IF LEN(argv) > 1 THEN proj$ = argv[1]
DIM ws$ = WsName$(proj$)
DIM file$ = PATH.JOIN$(proj$, ws$ + ".jsws")
DIM tag$ = "[jdBasic workshop] "

PRINT tag$; "jdBasic is installed. This project's workspace name is '"; ws$; "'."
IF NOT FILE.EXISTS(file$) THEN
    PRINT tag$; "No saved workspace yet - fresh workshop. Save with jdb_savews name="; CHR$(34); ws$; CHR$(34); " at the first milestone."
ELSE
    DIM saved = JSON.PARSE(TXTREADER$(file$))
    DIM func_names = DefinedNames(saved{"source_code"})
    DIM var_names = MAP.KEYS(saved{"variables"})
    PRINT tag$; "Saved workspace "; ws$; ".jsws ("; FILE.STAT(file$){"mtime"}; "): "; LEN(func_names); IIF(LEN(func_names) = 1, " function, ", " functions, "); LEN(var_names); IIF(LEN(var_names) = 1, " variable.", " variables.")
    IF LEN(func_names) > 0 THEN PRINT tag$; "Functions: "; JOIN(func_names, " ")
    IF LEN(var_names) > 0 THEN PRINT tag$; "Variables: "; JOIN(var_names, " ")
    IF "WORKSHOP_NOTES$" IN var_names THEN PRINT tag$; "Notes: "; saved{"variables"}{"WORKSHOP_NOTES$"}
    PRINT tag$; "Restore it first: jdb_loadws name="; CHR$(34); ws$; CHR$(34); ", then jdb_funcs."
ENDIF
