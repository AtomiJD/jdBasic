# systemd user unit for the nightly squad chain.
#
#   mkdir -p ~/.config/systemd/user
#   cp tools/squad/squad.service tools/squad/squad.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now squad.timer
#   loginctl enable-linger "$USER"        # runs without a login session
#
# One run by hand: systemctl --user start squad.service
# Its output:      journalctl --user -u squad.service
#
# ~/squad/squad.env is optional and holds what stays out of the repository:
#   SQUAD_ARGS=--scout-only          (default; empty for the full chain)
#   JDTRAKR_URL=...  JDTRAKR_API=... (tickets are filed when both are set)

[Unit]
Description=jdBasic squad: nightly hardening chain

[Service]
Type=oneshot
WorkingDirectory=%h/squad/cc
Environment=HTTP=1 GFX=1 IMGUI=1 NATIVEC=1
Environment=LD_LIBRARY_PATH=%h/squad/cc/build
Environment=SQUAD_ARGS=--scout-only
EnvironmentFile=-%h/squad/squad.env
# The chain rebuilds build/jdbasic, so the driver runs from a copy
ExecStartPre=/bin/cp %h/squad/cc/build/jdbasic %h/squad/jdbasic.driver
ExecStart=%h/squad/jdbasic.driver tools/squad/squad.jdb $SQUAD_ARGS
TimeoutStartSec=7h
MemoryMax=48G
TasksMax=4000
Nice=10
KillMode=control-group
