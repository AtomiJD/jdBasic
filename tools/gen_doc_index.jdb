' Writes the table of contents and the A-Z index of doc/languages.md
' between their marker comments. With --check it only reports whether
' both are current and exits 1 if not. Run from the repository root.

DIM doc_path$ = "doc/languages.md"
DIM toc_begin$ = "<!-- TOC:BEGIN - generated by tools/gen_doc_index.jdb -->"
DIM toc_end$ = "<!-- TOC:END -->"
DIM idx_begin$ = "<!-- INDEX:BEGIN - generated by tools/gen_doc_index.jdb -->"
DIM idx_end$ = "<!-- INDEX:END -->"
DIM idx_title$ = "## Index A-Z"
DIM nl$ = CHR$(10)

DIM check_only = FALSE
FOR EACH arg IN OS.ARGS()
    IF arg = "--check" THEN check_only = TRUE
NEXT

' GitHub's heading anchor: lower case, letters, digits, - and _ kept,
' spaces turned into -, everything else dropped.
FUNC Slug$(title$)
    DIM out$ = ""
    FOR EACH ch IN -LCASE$(title$)
        IF (ch >= "a" AND ch <= "z") OR (ch >= "0" AND ch <= "9") OR ch = "-" OR ch = "_" THEN
            out$ = out$ + ch
        ELSEIF ch = " " THEN
            out$ = out$ + "-"
        ENDIF
    NEXT
    RETURN out$
ENDFUNC

' The builtin name a reference bullet documents, or "" for a bullet that
' describes something else (a parameter, a field).
FUNC BulletName$(row$)
    DIM rest$ = MID$(row$, 5, LEN(row$) - 5)
    DIM name$ = ""
    FOR EACH ch IN -rest$
        IF ch = "(" OR ch = "`" OR ch = " " OR ch = "[" OR ch = "," THEN EXITFOR
        name$ = name$ + ch
    NEXT
    IF LEN(name$) < 2 THEN RETURN ""
    IF LEFT$(name$, 1) = "_" THEN RETURN ""
    FOR EACH ch IN -name$
        IF NOT ((ch >= "A" AND ch <= "Z") OR (ch >= "0" AND ch <= "9") OR ch = "_" OR ch = "." OR ch = "$") THEN RETURN ""
    NEXT
    RETURN name$
ENDFUNC

DIM raw$ = REPLACE$(TXTREADER$(doc_path$), CHR$(13), "")
DIM rows = SPLIT(raw$, nl$)

' Pass 1: the document without the generated blocks, and what they list.
DIM body = []
DIM toc = []
DIM seen = {}
DIM entry_anchor = {}
DIM entry_names = []
DIM in_fence = FALSE
DIM in_block = FALSE
DIM after_block = FALSE
DIM section$ = ""
FOR EACH row$ IN rows
    IF row$ = toc_begin$ OR row$ = idx_begin$ THEN in_block = TRUE
    IF in_block THEN
        IF row$ = toc_end$ OR row$ = idx_end$ THEN
            in_block = FALSE
            after_block = TRUE
        ENDIF
        CONTINUEFOR
    ENDIF
    IF after_block THEN
        after_block = FALSE
        IF row$ = "" THEN CONTINUEFOR
    ENDIF
    body = APPEND(body, row$)
    IF STARTSWITH(LTRIM$(row$), "```") THEN in_fence = NOT in_fence
    IF in_fence THEN CONTINUEFOR
    DIM level = 0
    IF STARTSWITH(row$, "## ") THEN level = 2
    IF STARTSWITH(row$, "### ") THEN level = 3
    IF level > 0 THEN
        DIM title$ = TRIM$(MID$(row$, level + 1, LEN(row$) - level - 1))
        DIM anchor$ = Slug$(title$)
        IF TYPEOF(seen{anchor$}) = "NONE" THEN
            seen{anchor$} = 0
        ELSE
            seen{anchor$} = seen{anchor$} + 1
            anchor$ = anchor$ + "-" + STR$(seen{anchor$})
        ENDIF
        section$ = anchor$
        DIM shown$ = REPLACE$(title$, "`", "")
        IF level = 2 THEN
            toc = APPEND(toc, "- [" + shown$ + "](#" + anchor$ + ")")
        ELSE
            toc = APPEND(toc, "  - [" + shown$ + "](#" + anchor$ + ")")
        ENDIF
    ELSEIF STARTSWITH(row$, "* **`") THEN
        DIM fn$ = BulletName$(row$)
        IF LEN(fn$) > 0 ANDALSO TYPEOF(entry_anchor{fn$}) = "NONE" THEN
            entry_anchor{fn$} = section$
            entry_names = APPEND(entry_names, fn$)
        ENDIF
    ENDIF
NEXT
toc = APPEND(toc, "- [Index A-Z](#" + Slug$("Index A-Z") + ")")

' Pass 2: the index, one line per initial letter.
DIM index_rows = [idx_begin$, idx_title$, "", "Every documented builtin, linked to the section that describes it.", ""]
DIM letter$ = ""
DIM line_out$ = ""
FOR EACH fn$ IN SORT(entry_names)
    IF LEFT$(fn$, 1) <> letter$ THEN
        IF LEN(line_out$) > 0 THEN index_rows = APPEND(APPEND(index_rows, line_out$), "")
        letter$ = LEFT$(fn$, 1)
        line_out$ = "**" + letter$ + "**"
    ENDIF
    line_out$ = line_out$ + " · [" + fn$ + "](#" + entry_anchor{fn$} + ")"
NEXT
IF LEN(line_out$) > 0 THEN index_rows = APPEND(index_rows, line_out$)
index_rows = APPEND(index_rows, idx_end$)

' Pass 3: the contents go after the introduction, the index at the end.
DIM toc_rows = APPEND(APPEND([toc_begin$, "## Contents", ""], toc), toc_end$)
DO WHILE LEN(body) > 0 ANDALSO body[LEN(body) - 1] = ""
    body = TAKE(LEN(body) - 1, body)
LOOP
DIM first_section = 0
FOR i = 0 TO LEN(body) - 1
    IF STARTSWITH(body[i], "## ") THEN
        first_section = i
        EXITFOR
    ENDIF
NEXT
DIM out_rows = APPEND(APPEND(TAKE(first_section, body), toc_rows), "")
out_rows = APPEND(APPEND(APPEND(out_rows, DROP(first_section, body)), ""), index_rows)
DIM result$ = JOIN(out_rows, nl$) + nl$

IF check_only THEN
    IF result$ = raw$ THEN
        PRINT "doc index: "; LEN(toc); " contents entries, "; LEN(entry_names); " builtins, current"
    ELSE
        PRINT "doc/languages.md: contents or index out of date - run jdbasic tools/gen_doc_index.jdb"
        END 1
    ENDIF
ELSE
    TXTWRITER doc_path$, result$
    PRINT "doc index written: "; LEN(toc); " contents entries, "; LEN(entry_names); " builtins"
ENDIF
