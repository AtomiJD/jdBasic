' Reports what every native builtin actually answers. For each
' register_native() in src/*.cpp it brace-matches the registered lambda and
' classifies the kind of every return statement in it, skipping returns that
' belong to nested lambdas. The result is compared against the BuiltinRet
' column in src/builtin_sigs.h. Run from the repository root.

DIM q$ = CHR$(34)
DIM nl$ = CHR$(10)

DIM sigs$ = TXTREADER$("src/builtin_sigs.h")

' The table entry for a name, from the return kind to the end of the line.
FUNC EntryOf(n$)
    DIM at = INSTR(sigs$, CHR$(34) + n$ + CHR$(34) + ", BuiltinRet::")
    IF at < 0 THEN RETURN ""
    DIM rest$ = MID$(sigs$, at + LEN(n$) + 16, 90)
    DIM cut = INSTR(rest$, "}")
    IF cut < 0 THEN RETURN rest$
    RETURN LEFT$(rest$, cut)
ENDFUNC

FUNC SigOf(n$)
    DIM entry$ = EntryOf(n$)
    IF entry$ = "" THEN RETURN "-"
    DIM cut = INSTR(entry$, ",")
    DIM found$ = entry$
    IF cut >= 0 THEN found$ = LEFT$(entry$, cut)
    ' An Unknown entry is as unclassified as an absent one.
    IF found$ = "Unknown" THEN RETURN "-"
    RETURN found$
ENDFUNC

' The signature a scanned kind asks for. BF_DATE outranks the return kind:
' the table records what the ISO-string form answered, the flag records that
' the value is a date, and a date rides the f64 variant.
FUNC WantsSig(kind$)
    IF kind$ = "NONE" THEN RETURN "None"
    IF kind$ = "STR" THEN RETURN "Str"
    IF kind$ = "BOOL" THEN RETURN "Bool"
    IF kind$ = "I64" THEN RETURN "I64"
    IF kind$ = "F64" THEN RETURN "F64"
    IF kind$ = "ARR" THEN RETURN "Arr"
    IF kind$ = "OBJ" THEN RETURN "Handle"
    RETURN ""
ENDFUNC

FUNC NumOf(s$, ch$)
    RETURN LEN(SPLIT(s$, ch$)) - 1
ENDFUNC

' A lambda introducer of any capture list: the closing bracket of the
' capture is followed by the parameter list, and the line goes on to open a
' body or name a return type.
FUNC HasLambda(s$)
    IF INSTR(s$, "](") < 0 THEN RETURN FALSE
    RETURN INSTR(s$, "{") >= 0 ORELSE INSTR(s$, "->") >= 0
ENDFUNC

' The kind a single return statement answers, read off the Value factory.
FUNC RetKind(s$)
    DIM expr$ = LTRIM$(MID$(s$, 7))
    IF LEFT$(expr$, 2) = "{}" THEN RETURN "NONE"
    IF LEFT$(expr$, 7) = "Value()" THEN RETURN "NONE"
    ' The kind is whatever the returned expression itself is, so a factory
    ' that only fills an argument of a helper call decides nothing.
    IF LEFT$(expr$, 12) <> "Value::make_" THEN RETURN "?"
    DIM head$ = MID$(expr$, 7)
    DIM paren = INSTR(head$, "(")
    IF paren >= 0 THEN head$ = LEFT$(head$, paren)
    IF head$ = "make_none" THEN RETURN "NONE"
    IF head$ = "make_string" THEN RETURN "STR"
    IF head$ = "make_bool" THEN RETURN "BOOL"
    IF head$ = "make_i64" ORELSE head$ = "make_int" THEN RETURN "I64"
    IF head$ = "make_f64" ORELSE head$ = "make_double" THEN RETURN "F64"
    IF head$ = "make_array" ORELSE head$ = "make_tensor" THEN RETURN "ARR"
    IF head$ = "make_object" ORELSE head$ = "make_map" THEN RETURN "OBJ"
    RETURN "?"
ENDFUNC

DIM names = []
DIM kinds = []
DIM srcs = []

DIM srcfiles = DIR$("src/*.cpp")
FOR EACH f$ IN srcfiles
    DIM text$ = TXTREADER$("src/" + f$)
    IF INSTR(text$, "register_native(" + q$) < 0 THEN CONTINUEFOR
    DIM src_lines = SPLIT(text$, nl$)
    DIM n_lines = LEN(src_lines)
    DIM i = 0
    WHILE i < n_lines
        DIM ln$ = src_lines[i]
        DIM at = INSTR(ln$, "register_native(" + q$)
        IF at < 0 THEN
            i = i + 1
            CONTINUEDO
        ENDIF
        DIM tail$ = MID$(ln$, at + 17)
        DIM reg_name$ = LEFT$(tail$, INSTR(tail$, q$))

        ' The lambda introducer is on the registration line or just below it.
        ' The lambda belongs to this registration only until the next one
        ' starts: a registration that passes a named function has none.
        DIM lam = -1
        DIM k = i
        WHILE k < n_lines AND k < i + 4
            IF k > i AND INSTR(src_lines[k], "register_native(") >= 0 THEN EXITDO
            IF HasLambda(src_lines[k]) THEN
                lam = k
                EXITDO
            ENDIF
            k = k + 1
        WEND
        IF lam < 0 THEN
            names = APPEND(names, reg_name$)
            kinds = APPEND(kinds, "nolambda")
            srcs = APPEND(srcs, f$)
            i = i + 1
            CONTINUEDO
        ENDIF

        DIM depth = 0
        DIM started = FALSE
        DIM skip_at = -1
        DIM seen$ = ""
        DIM j = lam
        WHILE j < n_lines
            DIM bl$ = src_lines[j]
            DIM d0 = depth
            IF skip_at >= 0 AND d0 < skip_at THEN skip_at = -1
            IF skip_at < 0 AND (started ORELSE j = lam) THEN
                DIM rat = INSTR(bl$, "return ")
                IF rat >= 0 THEN
                    DIM rk$ = RetKind(MID$(bl$, rat))
                    IF INSTR(seen$, rk$) < 0 THEN seen$ = seen$ + rk$ + " "
                ENDIF
            ENDIF
            depth = depth + NumOf(bl$, "{") - NumOf(bl$, "}")
            IF depth > 0 THEN started = TRUE
            IF skip_at < 0 AND j > lam AND depth > d0 AND HasLambda(bl$) THEN skip_at = depth
            IF started AND depth <= 0 THEN EXITDO
            j = j + 1
        WEND

        names = APPEND(names, reg_name$)
        kinds = APPEND(kinds, RTRIM$(seen$))
        srcs = APPEND(srcs, f$)
        i = j + 1
    WEND
NEXT

' --check reports only the contradictions and fails on them, which is what
' CI needs. The unlisted names are a backlog, not a breakage.
DIM check_only = FALSE
FOR EACH arg IN OS.ARGS()
    IF arg = "--check" THEN check_only = TRUE
NEXT

IF check_only THEN
    DIM found = 0
    FOR i = 0 TO LEN(names) - 1
        DIM s2$ = SigOf(names[i])
        DIM w2$ = WantsSig(kinds[i])
        IF s2$ <> "-" AND w2$ <> "" AND w2$ <> s2$ AND INSTR(EntryOf(names[i]), "BF_DATE") < 0 THEN
            PRINT names[i]; " answers "; kinds[i]; ", builtin_sigs.h says "; s2$; " ("; srcs[i]; ")"
            found = found + 1
        ENDIF
    NEXT
    IF found = 0 THEN
        PRINT "builtin returns: "; LEN(names); " registrations, none contradicts the table"
    ELSE
        PRINT found; " builtin(s) answer a kind the table does not record"
        END 1
    ENDIF
    END
ENDIF

PRINT "scanned "; LEN(names); " registrations"
PRINT ""

DIM n_none_new = 0
DIM n_kind_new = 0

PRINT "== answers NONE only, signature not listed =="
FOR i = 0 TO LEN(names) - 1
    IF kinds[i] = "NONE" AND SigOf(names[i]) = "-" THEN
        PRINT names[i]; "  ("; srcs[i]; ")"
        n_none_new = n_none_new + 1
    ENDIF
NEXT

PRINT ""
PRINT "== one kind, and the signature says another =="
DIM n_conflict = 0
FOR i = 0 TO LEN(names) - 1
    DIM sig$ = SigOf(names[i])
    DIM wants$ = WantsSig(kinds[i])
    IF sig$ <> "-" AND wants$ <> "" AND wants$ <> sig$ THEN
        ' A name carrying BF_DATE answers a date, whatever the kind the
        ' factory in its body names.
        IF INSTR(EntryOf(names[i]), "BF_DATE") < 0 THEN
            PRINT names[i]; "  answers "; kinds[i]; ", table says "; sig$; "  ("; srcs[i]; ")"
            n_conflict = n_conflict + 1
        ENDIF
    ENDIF
NEXT

PRINT ""
PRINT "== answers one kind, signature not listed =="
FOR i = 0 TO LEN(names) - 1
    DIM kk$ = kinds[i]
    IF kk$ <> "NONE" AND kk$ <> "nolambda" AND kk$ <> "" AND INSTR(kk$, " ") < 0 AND kk$ <> "?" AND SigOf(names[i]) = "-" THEN
        PRINT names[i]; "  -> "; kk$; "  ("; srcs[i]; ")"
        n_kind_new = n_kind_new + 1
    ENDIF
NEXT

PRINT ""
PRINT "== several kinds or opaque, signature not listed =="
FOR i = 0 TO LEN(names) - 1
    DIM km$ = kinds[i]
    DIM many = INSTR(km$, " ") >= 0 ORELSE km$ = "?" ORELSE km$ = "" ORELSE km$ = "nolambda"
    IF many AND SigOf(names[i]) = "-" THEN PRINT names[i]; "  -> ["; km$; "]  ("; srcs[i]; ")"
NEXT

PRINT ""
PRINT "NONE-only and unlisted: "; n_none_new
PRINT "single-kind and unlisted: "; n_kind_new
PRINT "conflicts with the table: "; n_conflict
