print "Simple recursion"
print

func count_asc(n)
   if n < 0 then return n
   count_asc(n-1)
   print n
endfunc

func count_desc(n)
    if n >= 0 then
        print n
	r=count_desc(n - 1)
    endif
endfunc

print "Result ASC: "
count_asc(5)
print "Result DEC: "
count_desc(5)

