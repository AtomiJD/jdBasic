print "------------------------"

PRINT "Array Test"

Dim a[20]

for i = 0 to 19
  a[i] = i*2
next i

for i = 0 to 19
  print "Zahl #",i, " ist: ", a[i]
next i

my_numbers = [10, 20, 30, 40, 50]
my_strings$ = ["alpha", "beta", "gamma"]

PRINT "--- Strings ---"
FOR i = 0 TO len(my_strings$)-1
    PRINT my_strings$[i]
NEXT i

PRINT "--- Numbers ---"
FOR i = 0 TO len(my_numbers)-1
    PRINT my_numbers[i]
NEXT i

