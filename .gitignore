# ──────────────────────────────────────────────────────────────────
# jdBasic .gitignore
# ──────────────────────────────────────────────────────────────────

# ── User convention: anything starting with "_" is private ────────
_*

# ── Local AI co-processor: per-repo semantic index + file lists ──
.jdco*

# ── Personal scratch / current tests (not for git) ────────────────
fluppi/tiled/
fluppi/generated_sprites/
vo/
VBA 6.0/
vba/
# Scratch sprite sheets + game-art piles (pacman/ghost/parallax PNGs etc.)
art/
jdb/art/
jdb/parallax_game/art/
# One-off scratch files at the jdb/ root
jdb/a
jdb/prime.jdb
# Personal reset-snapshot of the Stellar Drift live-coding template
jdb/demos/games/space_shooter/space_shooter_templare_for_reset_code_only.jdb

# ── godot/rpg-demo: heavy generated / third-party content ─────────
# 1.1GB of CUDA + ggml DLLs in addons/jdb_godot/bin (rebuild from
# build_rt.bat LLM + stage script), Godot editor cache, and the
# 117MB KayKit Adventurers character/animation pack (download from
# kaylousberg.com; see godot/rpg-demo/README.md for instructions).
godot/Assets/
godot/rpg-demo/.godot/
godot/rpg-demo/addons/jdb_godot/bin/
godot/rpg-demo/assets/characters/
godot/rpg-demo/assets/animations/
godot/rpg-demo/assets/nature/
godot/rpg-demo/assets/dungeon/

# ── Build outputs ─────────────────────────────────────────────────
build/

# Stable jdBasic.exe + DLLs that the MCP server runs against. Decoupled
# from build/ so a fresh `build.bat` can replace build/jdBasic.exe even
# while the MCP server is still serving — the server's own EXE lives in
# mcp-runtime/ and only gets refreshed manually after a successful build.
mcp-runtime/
dist/
*.obj
*.exe
*.dll
*.so
*.os
*.lib
*.exp

# Godot per-machine setting overrides (e.g. absolute LLM model path on render).
godot/rpg-native/override.cfg
*.pdb
*.ilk
*.res
*.idb
*.map
build_number.txt

# ── Third-party libraries (too large for git, install manually) ───
# These are needed to build but must be downloaded separately.
# Win build uses libs/SDL3-3.2.16/ etc.; Linux build uses libs/SDL3/ etc.
# Catch both with a directory-prefix wildcard. `libs/*` (with the
# asterisk) ignores the direct children only — that lets us re-include
# a single sub-tree below. A bare `libs/` excludes the whole subtree
# and gitignore can't re-include from a fully-excluded parent.
libs/*
# FTXUI is vendored (cloned + .git stripped) so the repo stays
# self-contained. Exempt the source tree, keep the build/ subdir
# (compiled .obj + ftxui.lib) ignored.
!libs/ftxui
libs/ftxui/build/
# Eigen 3.4.0 vendored (header-only) for the numerics builtins (SVD/QR/DET/EIG/FFT).
!libs/eigen

# ── LLM models (huge binary blobs) ────────────────────────────────
models/
*.gguf
*.onnx
*.clf

# ── Runtime / interpreter state ───────────────────────────────────
imgui.ini
*_history.txt
basic_history.txt
jdbasic_history.txt

# ── Editor / IDE ──────────────────────────────────────────────────
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# ── Claude Code workspace ─────────────────────────────────────────
.claude/
CLAUDE.md

# ── OS junk ───────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Large data files (training sets, indexes, etc.) ──────────────
*.csv
*.idx
!tests/**/*.csv
!jdb/**/*.csv

# ── Personal data files — must NEVER be committed (override above) ─
# Re-block specific files even though jdb/**/*.csv is whitelisted.
jdb/luli.csv
jdb/luli.clf
jdb/mixdata.csv
# Maven Analytics "Booking Breakdown" data drill - large, download separately:
# https://mavenanalytics.io/data-drills/booking-breakdown
jdb/analytic/hotel_bookings.csv

# ── Temporary / scratch files ─────────────────────────────────────
*.tmp
*.bak
*.log
tmp/
tests/ablage/
# Apple II / C64 ROMs (Atomi's local set; not redistributable)
thingsforyou/

# ── Workspace state (jdBasic REPL saves these on exit) ────────────
*.jsws
*.jdb.props

# ── jdBasic-TV pipeline secrets / generated artefacts ─────────────
jdb/tv/.env
jdb/tv/voice/
jdb/tv/raw/
jdb/tv/final/
jdb/tv/avatar/
# YouTube uploader: OAuth client secret + token caches stay local.
# defaults.json is per-user config (channel title, tags, playlist ID,
# footer) — copy yt/defaults.example.json → yt/defaults.json and edit.
jdb/tv/yt/client_secret*.json
jdb/tv/yt/request.token
jdb/tv/yt/playlist.token
jdb/tv/yt/*.token.expired
jdb/tv/yt/_tmp_*.json
jdb/tv/yt/defaults.json

# ── Claude session bootstrap bundle (config + memories, user-scoped) ─
claude_linux_bootstrap.tar.gz
jdb/tv/OBS/
# CARDS render sidecar JSONs (UTF-8 substitution payloads).
jdb/tv/cards/*.args.json
# Rendered title-cards / thumbnails go through here; only the
# template_*.html sources are tracked.
jdb/tv/cards/*.png
jdb/tv/cards/*.mp3
jdb/tv/cards/*.wav
jdb/tv/cards/script_*.html
jdb/tv/cards/test_*.html
# Side-effects from lesson takes (Lesson 8 writes hello.txt + todo.txt,
# Lesson 10's SAVE drops mathx.jdb).  Keep them out of git.
jdb/tv/hello.txt
jdb/tv/todo.txt
jdb/tv/mathx.jdb

# ── Runtime artefacts (generated by demos / VO / emulator) ────────
jdb/apple2_tape.bin
jdb/sqlite_demo.db
vo.db
# Per-user calibration: monitor geometry for the recording session.
# Each developer's setup is different; re-run winpos_probe.jdb to regen.
jdb/winpos.json
tmp/winpos.json
jdb/demos/games/*/winpos.json
# Default font auto-copied next to native -c outputs (originals live in
# fonts/ and build/ — the per-script copies are just runtime artifacts).
jdbasic_default.ttf
# Local-only reference backup of the syntax file (developer keeps a
# pristine copy to diff against; not part of the source distribution).
syntaxes/jdbasic.tmLanguage_org.json

# ── Release bundles (built by dist.bat, not for source repo) ──────
release/*.zip
release/*.sha256
release/jdbasic-*-windows-x64/
# Release planning notes (drafts, scratch, launch logistics) — these
# evolve fast and are not part of the source distribution.
release/*.md
release/jdbasic-mcp-native-windows-x64/

# ── Test session scratch (interactive-run leftovers) ──────────────
tests/SuperVanilla.ttf
tests/test_chest2.json
tests/test_combo_full.jdb
tests/dupfinder_demo/
jdb/thingsforyou/

# jdb/ build artifacts (.exe per --compile, jdbrt.dll copies)
jdb/*.exe
jdb/jdbrt.dll

# ── DOOM port (local-only, original WADs not redistributable) ─────
jdb/doom/

# ── Published website mirror (jdbasic.dev source lives elsewhere) ──
# Local checkout / wasm build artefacts of the public site go here.
doc/jdBasic/

# ── Godot — per-project caches + GDExtension build outputs ─────────
# .godot/ is the import / shader cache Godot regenerates on first open.
# /android/ holds per-platform export build dirs.
godot/**/.godot/
godot/**/android/
# GDExtension build artefacts go into the addons/.../bin/ dir; the *.dll
# rule at the top of this file catches them, but pin .lib/.exp here too.
godot/**/addons/**/bin/*.lib
godot/**/addons/**/bin/*.exp
godot/**/addons/**/bin/*.pdb
# SCons build cache from embed/godot/godot-cpp builds
embed/godot/.sconsign.dblite
embed/godot/godot-cpp/bin/
embed/godot/godot-cpp/gen/

# rpg-native: project-local LLM model(s) - large, carried via USB not git
godot/rpg-native/models/

# Drum-machine sample sets - licensed audio, carried locally not via git
# (SQ sequencer / livecoder: code + sq_data.json are tracked, the WAVs are not)
Roland TR-808/
Korg_KPR77/
Roland_CR-80/
.DS_Store

# RAG appliance generated indexes
.rag_appliance.idx
.rag_appliance.dirs
.rag_appliance.tfidf

# Local-only backup (untracked, kept on disk)
fluppi/backup/
