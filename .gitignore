# ──────────────────────────────────────────────────────────────────
# jdBasic .gitignore
# ──────────────────────────────────────────────────────────────────

# ── User convention: anything starting with "_" is private ────────
_*

# ── Personal scratch / current tests (not for git) ────────────────
fluppi/tiled/
vo/
VBA 6.0/

# ── Build outputs ─────────────────────────────────────────────────
build/

# Stable jdBasic.exe + DLLs that the MCP server runs against. Decoupled
# from build/ so a fresh `build.bat` can replace build/jdBasic.exe even
# while the MCP server is still serving — the server's own EXE lives in
# mcp-runtime/ and only gets refreshed manually after a successful build.
mcp-runtime/
dist/
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.res
*.idb
*.map
build_number.txt

# ── Third-party libraries (too large for git, install manually) ───
# These are needed to build but must be downloaded separately.
# Win build uses libs/SDL3-3.2.16/ etc.; Linux build uses libs/SDL3/ etc.
# Catch both with a directory-prefix wildcard. `libs/*` (with the
# asterisk) ignores the direct children only — that lets us re-include
# a single sub-tree below. A bare `libs/` excludes the whole subtree
# and gitignore can't re-include from a fully-excluded parent.
libs/*
# FTXUI is vendored (cloned + .git stripped) so the repo stays
# self-contained. Exempt the source tree, keep the build/ subdir
# (compiled .obj + ftxui.lib) ignored.
!libs/ftxui
libs/ftxui/build/

# ── LLM models (huge binary blobs) ────────────────────────────────
models/
*.gguf
*.onnx
*.clf

# ── Runtime / interpreter state ───────────────────────────────────
imgui.ini
*_history.txt
basic_history.txt
jdbasic_history.txt

# ── Editor / IDE ──────────────────────────────────────────────────
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# ── Claude Code workspace ─────────────────────────────────────────
.claude/

# ── OS junk ───────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Large data files (training sets, indexes, etc.) ──────────────
*.csv
*.idx
!tests/**/*.csv
!jdb/**/*.csv

# ── Personal data files — must NEVER be committed (override above) ─
# Re-block specific files even though jdb/**/*.csv is whitelisted.
jdb/luli.csv
jdb/luli.clf

# ── Temporary / scratch files ─────────────────────────────────────
*.tmp
*.bak
*.log
tmp/
tests/ablage/
# Apple II / C64 ROMs (Atomi's local set; not redistributable)
thingsforyou/

# ── Workspace state (jdBasic REPL saves these on exit) ────────────
*.jsws
*.jdb.props

# ── Runtime artefacts (generated by demos / VO / emulator) ────────
jdb/apple2_tape.bin
jdb/sqlite_demo.db
vo.db

# ── Release bundles (built by dist.bat, not for source repo) ──────
release/*.zip
release/*.sha256
release/jdbasic-*-windows-x64/
release/jdbasic-mcp-native-windows-x64/

# ── Test session scratch (interactive-run leftovers) ──────────────
tests/SuperVanilla.ttf
tests/test_chest2.json
tests/test_combo_full.jdb
tests/dupfinder_demo/
jdb/thingsforyou/

# jdb/ build artifacts (.exe per --compile, jdbrt.dll copies)
jdb/*.exe
jdb/jdbrt.dll
