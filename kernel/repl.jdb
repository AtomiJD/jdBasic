OPTION EXPLICIT

' A REPL for the jdBasic kernel target: screen, keyboard and a small
' interpreter, all in jdBasic. Modules route calls through the VM bridge, which
' ring 0 does not have, so this image is one file.
'
' Screen positions, scancodes and scanner offsets are INTEGER; DOUBLE carries
' the values the interpreter computes, so 10/4 stays 2.5.

CONST VGA_BASE = $B8000
CONST SCR_COLS = 80
CONST SCR_ROWS = 25
CONST CRTC_INDEX = $3D4
CONST CRTC_DATA = $3D5
CONST KBD_DATA = $60
CONST KBD_STATUS = $64

CONST KEY_ESC = 27
CONST KEY_BACK = 8
CONST KEY_ENTER = 13

CONST MAX_VARS = 64

CONST K_UP = 256
CONST K_DOWN = 257
CONST K_LEFT = 258
CONST K_RIGHT = 259
CONST K_HOME = 260
CONST K_END = 261
CONST K_DEL = 262
CONST K_PGUP = 263
CONST K_PGDN = 264
CONST K_F2 = 265
CONST K_F5 = 266

CONST ED_MAXLINES = 200
CONST ED_ROWS = 23
CONST DSK_MAX = 16

DIM scrAttr AS INTEGER
DIM scrPos AS INTEGER

DIM kbBase[128]
DIM kbShift[128]
DIM kbAltgr[128]
DIM kbShiftDown AS INTEGER
DIM kbAltgrDown AS INTEGER
DIM kbExtended AS INTEGER
DIM lineExit AS INTEGER

DIM edLines[ED_MAXLINES] AS STRING
DIM edCount AS INTEGER
DIM edRow AS INTEGER
DIM edCol AS INTEGER
DIM edTop AS INTEGER

DIM dskNames[DSK_MAX] AS STRING
DIM dskText[DSK_MAX] AS STRING
DIM dskCount AS INTEGER

DIM srcText AS STRING
DIM cur AS INTEGER
DIM errCode AS INTEGER

DIM varNames[MAX_VARS] AS STRING
DIM varVals[MAX_VARS]
DIM varCount AS INTEGER

' ── Screen ─────────────────────────────────────────────────────────────────

SUB SCR_CURSOR(idx AS INTEGER)
    SYS.OUTB(CRTC_INDEX, 15)
    SYS.OUTB(CRTC_DATA, idx MOD 256)
    SYS.OUTB(CRTC_INDEX, 14)
    SYS.OUTB(CRTC_DATA, (idx \ 256) MOD 256)
ENDSUB

SUB SCR_CELL(idx AS INTEGER, ch AS INTEGER, attr AS INTEGER)
    SYS.POKEW(VGA_BASE + idx * 2, attr * 256 + ch)
ENDSUB

SUB SCR_CLEAR()
    DIM i AS INTEGER
    FOR i = 0 TO SCR_COLS * SCR_ROWS - 1
        SCR_CELL(i, 32, scrAttr)
    NEXT i
    scrPos = 0
    SCR_CURSOR(0)
ENDSUB

SUB SCR_SCROLL()
    DIM i AS INTEGER
    DIM last AS INTEGER
    last = (SCR_ROWS - 1) * SCR_COLS
    FOR i = 0 TO last - 1
        SYS.POKEW(VGA_BASE + i * 2, SYS.PEEKW(VGA_BASE + (i + SCR_COLS) * 2))
    NEXT i
    FOR i = last TO SCR_COLS * SCR_ROWS - 1
        SCR_CELL(i, 32, scrAttr)
    NEXT i
    scrPos = last
ENDSUB

SUB SCR_NEWLINE()
    scrPos = (scrPos \ SCR_COLS + 1) * SCR_COLS
    IF scrPos >= SCR_COLS * SCR_ROWS THEN
        SCR_SCROLL()
    ENDIF
    SCR_CURSOR(scrPos)
ENDSUB

SUB SCR_PUTCHAR(ch AS INTEGER)
    IF ch = 10 THEN
        SCR_NEWLINE()
    ELSE
        SCR_CELL(scrPos, ch, scrAttr)
        scrPos = scrPos + 1
        IF scrPos >= SCR_COLS * SCR_ROWS THEN
            SCR_SCROLL()
        ENDIF
        SCR_CURSOR(scrPos)
    ENDIF
ENDSUB

SUB SCR_BACKSPACE()
    IF scrPos > 0 THEN
        scrPos = scrPos - 1
        SCR_CELL(scrPos, 32, scrAttr)
        SCR_CURSOR(scrPos)
    ENDIF
ENDSUB

SUB SCR_WRITE(msg AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(msg) - 1
        SCR_PUTCHAR(BYTEAT(msg, i))
    NEXT i
ENDSUB

SUB SCR_WRITELN(msg AS STRING)
    SCR_WRITE(msg)
    SCR_NEWLINE()
ENDSUB

SUB SCR_WRITEINT(v AS DOUBLE)
    DIM digits AS STRING
    DIM n AS INTEGER
    n = CINT(v)
    IF n < 0 THEN
        SCR_PUTCHAR(45)
        n = 0 - n
    ENDIF
    IF n = 0 THEN
        SCR_PUTCHAR(48)
        RETURN
    ENDIF
    digits = ""
    DO
        digits = CHR$(48 + n MOD 10) + digits
        n = n \ 10
    LOOP WHILE n > 0
    SCR_WRITE(digits)
ENDSUB

' Whole numbers print bare, anything else gets six decimals.
SUB SCR_WRITEVAL(v AS DOUBLE)
    DIM whole AS INTEGER
    DIM frac AS DOUBLE
    DIM i AS INTEGER
    DIM digit AS INTEGER

    frac = v
    IF frac < 0 THEN frac = 0 - frac
    whole = CINT(frac)
    frac = frac - whole

    IF frac = 0 THEN
        SCR_WRITEINT(v)
        RETURN
    ENDIF

    IF v < 0 THEN SCR_PUTCHAR(45)
    SCR_WRITEINT(whole)
    SCR_PUTCHAR(46)
    FOR i = 1 TO 6
        frac = frac * 10
        digit = CINT(frac)
        SCR_PUTCHAR(48 + digit)
        frac = frac - digit
    NEXT i
ENDSUB

' ── Keyboard ───────────────────────────────────────────────────────────────

SUB KB_ROW(startCode AS INTEGER, chars AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(chars) - 1
        kbBase[startCode + i] = BYTEAT(chars, i)
    NEXT i
ENDSUB

SUB KB_INIT()
    DIM i AS INTEGER

    FOR i = 0 TO 127
        kbBase[i] = 0
        kbShift[i] = 0
        kbAltgr[i] = 0
    NEXT i

    KB_ROW(2, "1234567890")
    KB_ROW(16, "qwertzuiop")
    KB_ROW(30, "asdfghjkl")
    KB_ROW(44, "yxcvbnm")

    kbBase[12] = 225
    kbBase[26] = 129
    kbBase[27] = 43
    kbBase[39] = 148
    kbBase[40] = 132
    kbBase[41] = 94
    kbBase[43] = 35
    kbBase[51] = 44
    kbBase[52] = 46
    kbBase[53] = 45
    kbBase[57] = 32
    kbBase[86] = 60

    FOR i = 0 TO 127
        IF kbBase[i] >= 97 AND kbBase[i] <= 122 THEN
            kbShift[i] = kbBase[i] - 32
        ELSE
            kbShift[i] = kbBase[i]
        ENDIF
    NEXT i

    kbShift[2] = 33
    kbShift[3] = 34
    kbShift[4] = 21
    kbShift[5] = 36
    kbShift[6] = 37
    kbShift[7] = 38
    kbShift[8] = 47
    kbShift[9] = 40
    kbShift[10] = 41
    kbShift[11] = 61
    kbShift[12] = 63
    kbShift[26] = 154
    kbShift[27] = 42
    kbShift[39] = 153
    kbShift[40] = 142
    kbShift[41] = 248
    kbShift[43] = 39
    kbShift[51] = 59
    kbShift[52] = 58
    kbShift[53] = 95
    kbShift[86] = 62

    kbAltgr[8] = 123
    kbAltgr[9] = 91
    kbAltgr[10] = 93
    kbAltgr[11] = 125
    kbAltgr[12] = 92
    kbAltgr[16] = 64
    kbAltgr[27] = 126
    kbAltgr[86] = 124

    kbShiftDown = 0
    kbAltgrDown = 0
    kbExtended = 0
ENDSUB

FUNC KB_EXTENDED(code AS INTEGER) AS INTEGER
    IF code = 72 THEN RETURN K_UP
    IF code = 80 THEN RETURN K_DOWN
    IF code = 75 THEN RETURN K_LEFT
    IF code = 77 THEN RETURN K_RIGHT
    IF code = 71 THEN RETURN K_HOME
    IF code = 79 THEN RETURN K_END
    IF code = 83 THEN RETURN K_DEL
    IF code = 73 THEN RETURN K_PGUP
    IF code = 81 THEN RETURN K_PGDN
    RETURN 0
ENDFUNC

FUNC KB_ASCII(code AS INTEGER) AS INTEGER
    IF code = 1 THEN RETURN KEY_ESC
    IF code = 60 THEN RETURN K_F2
    IF code = 63 THEN RETURN K_F5
    IF code = 14 THEN RETURN KEY_BACK
    IF code = 28 THEN RETURN KEY_ENTER
    IF code > 127 THEN RETURN 0
    IF kbAltgrDown = 1 THEN RETURN kbAltgr[code]
    IF kbShiftDown = 1 THEN RETURN kbShift[code]
    RETURN kbBase[code]
ENDFUNC

FUNC KB_READ() AS INTEGER
    DIM kbStatus AS INTEGER
    DIM code AS INTEGER
    DIM ch AS INTEGER

    DO
        kbStatus = SYS.INB(KBD_STATUS)
        IF (kbStatus MOD 2) = 1 THEN
            code = SYS.INB(KBD_DATA)

            IF code = 224 THEN
                kbExtended = 1
            ELSE
                IF code >= 128 THEN
                    code = code - 128
                    IF code = 42 OR code = 54 THEN kbShiftDown = 0
                    IF code = 56 AND kbExtended = 1 THEN kbAltgrDown = 0
                    kbExtended = 0
                ELSE
                    IF code = 42 OR code = 54 THEN
                        kbShiftDown = 1
                        kbExtended = 0
                    ELSE
                        IF code = 56 AND kbExtended = 1 THEN
                            kbAltgrDown = 1
                            kbExtended = 0
                        ELSE
                            IF kbExtended = 1 THEN
                                kbExtended = 0
                                ch = CINT(KB_EXTENDED(code))
                            ELSE
                                ch = CINT(KB_ASCII(code))
                            ENDIF
                            IF ch > 0 THEN RETURN ch
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    LOOP
ENDFUNC

' lineExit reports how the line ended: 0 Enter, 1 ESC, 2 F2.
FUNC KB_READLINE$() AS STRING
    DIM buf AS STRING
    DIM ch AS INTEGER
    buf = ""
    lineExit = 0
    DO
        ch = CINT(KB_READ())
        IF ch = KEY_ENTER THEN
            SCR_NEWLINE()
            RETURN buf
        ENDIF
        IF ch = KEY_ESC THEN
            lineExit = 1
            RETURN buf
        ENDIF
        IF ch = K_F2 THEN
            lineExit = 2
            RETURN buf
        ENDIF
        IF ch = KEY_BACK THEN
            IF LEN(buf) > 0 THEN
                buf = LEFT$(buf, LEN(buf) - 1)
                SCR_BACKSPACE()
            ENDIF
        ELSE
            IF ch >= 32 AND ch < 256 THEN
                buf = buf + CHR$(ch)
                SCR_PUTCHAR(ch)
            ENDIF
        ENDIF
    LOOP
ENDFUNC

' ── Variables ──────────────────────────────────────────────────────────────

FUNC VAR_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO varCount - 1
        IF varNames[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

FUNC VAR_GET(nm AS STRING) AS DOUBLE
    DIM idx AS INTEGER
    idx = CINT(VAR_FIND(nm))
    IF idx < 0 THEN RETURN 0
    RETURN varVals[idx]
ENDFUNC

SUB VAR_SET(nm AS STRING, v AS DOUBLE)
    DIM idx AS INTEGER
    idx = CINT(VAR_FIND(nm))
    IF idx >= 0 THEN
        varVals[idx] = v
        RETURN
    ENDIF
    IF varCount >= MAX_VARS THEN

        errCode = 6
        RETURN
    ENDIF
    varNames[varCount] = nm
    varVals[varCount] = v
    varCount = varCount + 1
ENDSUB

' ── Scanner ────────────────────────────────────────────────────────────────

FUNC PEEKC() AS INTEGER
    IF cur >= LEN(srcText) THEN RETURN 0
    RETURN BYTEAT(srcText, cur)
ENDFUNC

FUNC PEEKC2() AS INTEGER
    IF cur + 1 >= LEN(srcText) THEN RETURN 0
    RETURN BYTEAT(srcText, cur + 1)
ENDFUNC

SUB SKIPSP()
    DO
        IF PEEKC() <> 32 THEN RETURN
        cur = cur + 1
    LOOP
ENDSUB

FUNC IS_DIGIT(c AS INTEGER) AS INTEGER
    IF c >= 48 AND c <= 57 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC IS_ALPHA(c AS INTEGER) AS INTEGER
    IF c >= 97 AND c <= 122 THEN RETURN 1
    IF c >= 65 AND c <= 90 THEN RETURN 1
    IF c = 95 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC SCAN_NUMBER() AS DOUBLE
    DIM v AS DOUBLE
    DIM scale AS DOUBLE
    v = 0
    DO
        IF IS_DIGIT(PEEKC()) = 0 THEN EXITDO
        v = v * 10 + (PEEKC() - 48)
        cur = cur + 1
    LOOP
    IF PEEKC() = 46 AND IS_DIGIT(PEEKC2()) = 1 THEN
        cur = cur + 1
        scale = 1
        DO
            IF IS_DIGIT(PEEKC()) = 0 THEN EXITDO
            scale = scale / 10
            v = v + (PEEKC() - 48) * scale
            cur = cur + 1
        LOOP
    ENDIF
    RETURN v
ENDFUNC

FUNC SCAN_IDENT$() AS STRING
    DIM start AS INTEGER
    start = cur
    DO
        IF IS_ALPHA(PEEKC()) = 0 AND IS_DIGIT(PEEKC()) = 0 THEN EXITDO
        cur = cur + 1
    LOOP
    RETURN MID$(srcText, start, cur - start)
ENDFUNC

' True when the word at the cursor is exactly lit, not a longer identifier.
FUNC SCAN_KEYWORD(lit AS STRING) AS INTEGER
    DIM after AS INTEGER
    SKIPSP()
    IF MID$(srcText, cur, LEN(lit)) <> lit THEN RETURN 0
    after = cur + LEN(lit)
    IF after < LEN(srcText) THEN
        IF IS_ALPHA(BYTEAT(srcText, after)) = 1 THEN RETURN 0
        IF IS_DIGIT(BYTEAT(srcText, after)) = 1 THEN RETURN 0
    ENDIF
    cur = after
    RETURN 1
ENDFUNC

' ── Expressions ────────────────────────────────────────────────────────────


FUNC EVAL_FACTOR() AS DOUBLE
    DIM v AS DOUBLE
    DIM nm AS STRING

    SKIPSP()

    IF PEEKC() = 45 THEN
        cur = cur + 1
        RETURN 0 - EVAL_FACTOR()
    ENDIF

    IF PEEKC() = 40 THEN
        cur = cur + 1
        v = EVAL_COMPARE()
        SKIPSP()
        IF PEEKC() <> 41 THEN

            errCode = 1
            RETURN 0
        ENDIF
        cur = cur + 1
        RETURN v
    ENDIF

    IF IS_DIGIT(PEEKC()) = 1 THEN RETURN SCAN_NUMBER()

    IF IS_ALPHA(PEEKC()) = 1 THEN
        nm = SCAN_IDENT$()
        RETURN VAR_GET(nm)
    ENDIF


    errCode = 3
    RETURN 0
ENDFUNC

FUNC EVAL_TERM() AS DOUBLE
    DIM v AS DOUBLE
    DIM rhs AS DOUBLE
    DIM op AS INTEGER

    v = EVAL_FACTOR()
    DO
        IF errCode > 0 THEN RETURN v
        SKIPSP()
        op = CINT(PEEKC())
        IF op <> 42 AND op <> 47 AND op <> 37 THEN RETURN v
        cur = cur + 1
        rhs = EVAL_FACTOR()
        IF op = 42 THEN
            v = v * rhs
        ELSE
            IF rhs = 0 THEN

                errCode = 2
                RETURN 0
            ENDIF
            IF op = 47 THEN
                v = v / rhs
            ELSE
                v = v MOD rhs
            ENDIF
        ENDIF
    LOOP
ENDFUNC

FUNC EVAL_EXPR() AS DOUBLE
    DIM v AS DOUBLE
    DIM op AS INTEGER

    v = EVAL_TERM()
    DO
        IF errCode > 0 THEN RETURN v
        SKIPSP()
        op = CINT(PEEKC())
        IF op <> 43 AND op <> 45 THEN RETURN v
        cur = cur + 1
        IF op = 43 THEN
            v = v + EVAL_TERM()
        ELSE
            v = v - EVAL_TERM()
        ENDIF
    LOOP
ENDFUNC

' Assignment uses a single =, so comparison for equality is ==.
FUNC EVAL_COMPARE() AS DOUBLE
    DIM lhs AS DOUBLE
    DIM rhs AS DOUBLE
    DIM c1 AS INTEGER
    DIM c2 AS INTEGER
    DIM kind AS INTEGER

    lhs = EVAL_EXPR()
    IF errCode > 0 THEN RETURN lhs

    SKIPSP()
    c1 = CINT(PEEKC())
    c2 = CINT(PEEKC2())
    kind = 0

    IF c1 = 61 AND c2 = 61 THEN kind = 1
    IF c1 = 60 AND c2 = 62 THEN kind = 2
    IF c1 = 60 AND c2 = 61 THEN kind = 3
    IF c1 = 62 AND c2 = 61 THEN kind = 4

    IF kind > 0 THEN
        cur = cur + 2
    ELSE
        IF c1 = 60 THEN kind = 5
        IF c1 = 62 THEN kind = 6
        IF kind = 0 THEN RETURN lhs
        cur = cur + 1
    ENDIF

    rhs = EVAL_EXPR()
    IF errCode > 0 THEN RETURN 0

    IF kind = 1 AND lhs = rhs THEN RETURN 1
    IF kind = 2 AND lhs <> rhs THEN RETURN 1
    IF kind = 3 AND lhs <= rhs THEN RETURN 1
    IF kind = 4 AND lhs >= rhs THEN RETURN 1
    IF kind = 5 AND lhs < rhs THEN RETURN 1
    IF kind = 6 AND lhs > rhs THEN RETURN 1
    RETURN 0
ENDFUNC

' ── Statements ─────────────────────────────────────────────────────────────

FUNC ERR_TEXT$(code AS INTEGER) AS STRING
    IF code = 1 THEN RETURN "expected )"
    IF code = 2 THEN RETURN "division by zero"
    IF code = 3 THEN RETURN "unexpected character"
    IF code = 4 THEN RETURN "expected {"
    IF code = 5 THEN RETURN "unclosed {"
    IF code = 6 THEN RETURN "too many variables"
    IF code = 7 THEN RETURN "loop ran too long"
    RETURN "error"
ENDFUNC


' Steps the cursor past a brace-delimited block without executing it.
SUB SKIP_BLOCK()
    DIM depth AS INTEGER
    DIM c AS INTEGER
    SKIPSP()
    IF PEEKC() <> 123 THEN

        errCode = 4
        RETURN
    ENDIF
    depth = 0
    DO
        c = CINT(PEEKC())
        IF c = 0 THEN

            errCode = 5
            RETURN
        ENDIF
        IF c = 123 THEN depth = depth + 1
        IF c = 125 THEN depth = depth - 1
        cur = cur + 1
        IF depth = 0 THEN RETURN
    LOOP
ENDSUB

SUB RUN_BLOCK()
    SKIPSP()
    IF PEEKC() <> 123 THEN

        errCode = 4
        RETURN
    ENDIF
    cur = cur + 1
    DO
        IF errCode > 0 THEN RETURN
        SKIPSP()
        IF PEEKC() = 125 THEN
            cur = cur + 1
            RETURN
        ENDIF
        IF PEEKC() = 0 THEN

            errCode = 5
            RETURN
        ENDIF
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            RUN_STATEMENT()
        ENDIF
    LOOP
ENDSUB

SUB RUN_IF()
    IF EVAL_COMPARE() <> 0 THEN
        RUN_BLOCK()
    ELSE
        SKIP_BLOCK()
    ENDIF
ENDSUB

SUB RUN_WHILE()
    DIM condPos AS INTEGER
    DIM guard AS INTEGER
    condPos = cur
    guard = 0
    DO
        IF errCode > 0 THEN RETURN
        guard = guard + 1
        IF guard > 1000000 THEN

            errCode = 7
            RETURN
        ENDIF
        cur = condPos
        IF EVAL_COMPARE() = 0 THEN
            SKIP_BLOCK()
            RETURN
        ENDIF
        RUN_BLOCK()
    LOOP
ENDSUB

SUB RUN_STATEMENT()
    DIM nm AS STRING
    DIM savePos AS INTEGER
    DIM discard AS DOUBLE
    DIM shown AS DOUBLE

    SKIPSP()
    IF PEEKC() = 0 THEN RETURN

    IF PEEKC() = 63 THEN
        cur = cur + 1
        shown = EVAL_COMPARE()
        IF errCode = 0 THEN
            SCR_WRITEVAL(shown)
            SCR_NEWLINE()
        ENDIF
        RETURN
    ENDIF

    IF SCAN_KEYWORD("if") = 1 THEN
        RUN_IF()
        RETURN
    ENDIF

    IF SCAN_KEYWORD("while") = 1 THEN
        RUN_WHILE()
        RETURN
    ENDIF

    ' An identifier followed by a lone = is an assignment; == falls through
    ' to the expression path.
    IF IS_ALPHA(PEEKC()) = 1 THEN
        savePos = cur
        nm = SCAN_IDENT$()
        SKIPSP()
        IF PEEKC() = 61 AND PEEKC2() <> 61 THEN
            cur = cur + 1
            VAR_SET(nm, EVAL_COMPARE())
            RETURN
        ENDIF
        cur = savePos
    ENDIF

    discard = EVAL_COMPARE()
ENDSUB

' Interprets one line. Assigning a string array element straight to a STRING
' global inside a SUB leaves the global RUNTIME-tagged for every function that
' reads it, so the text arrives through a typed parameter instead.
SUB RUN_TEXT(lineIn AS STRING)
    srcText = lineIn
    RUN_LINE()
ENDSUB

SUB RUN_LINE()
    cur = 0
    errCode = 0
    DO
        IF errCode > 0 THEN EXITDO
        SKIPSP()
        IF PEEKC() = 0 THEN EXITDO
        IF PEEKC() = 59 THEN
            cur = cur + 1
        ELSE
            RUN_STATEMENT()
        ENDIF
    LOOP
    IF errCode > 0 THEN
        scrAttr = 12
        SCR_WRITE("error: ")
        SCR_WRITELN(ERR_TEXT$(errCode))
        scrAttr = 7
    ENDIF
ENDSUB

' ── Editor ─────────────────────────────────────────────────────────────────
'
' Lines are held one per array slot, so an edit rewrites a single line rather
' than the whole buffer. lallang keeps one flat byte buffer and rescans it for
' every line boundary, which is what a language without arrays forces.

SUB ED_INIT()
    DIM i AS INTEGER
    FOR i = 0 TO ED_MAXLINES - 1
        edLines[i] = ""
    NEXT i
    edCount = 1
    edRow = 0
    edCol = 0
    edTop = 0
ENDSUB

SUB ED_CLAMP()
    IF edRow < 0 THEN edRow = 0
    IF edRow > edCount - 1 THEN edRow = edCount - 1
    IF edCol < 0 THEN edCol = 0
    IF edCol > LEN(edLines[edRow]) THEN edCol = LEN(edLines[edRow])
ENDSUB

SUB ED_INSERT(ch AS INTEGER)
    DIM s AS STRING
    s = edLines[edRow]
    edLines[edRow] = LEFT$(s, edCol) + CHR$(ch) + MID$(s, edCol, LEN(s) - edCol)
    edCol = edCol + 1
ENDSUB

SUB ED_ENTER()
    DIM s AS STRING
    DIM i AS INTEGER
    IF edCount >= ED_MAXLINES THEN RETURN
    s = edLines[edRow]
    FOR i = edCount TO edRow + 1 STEP -1
        edLines[i] = edLines[i - 1]
    NEXT i
    edLines[edRow] = LEFT$(s, edCol)
    edLines[edRow + 1] = MID$(s, edCol, LEN(s) - edCol)
    edCount = edCount + 1
    edRow = edRow + 1
    edCol = 0
ENDSUB

SUB ED_JOIN(row AS INTEGER)
    DIM i AS INTEGER
    IF row < 0 THEN RETURN
    IF row >= edCount - 1 THEN RETURN
    edLines[row] = edLines[row] + edLines[row + 1]
    FOR i = row + 1 TO edCount - 2
        edLines[i] = edLines[i + 1]
    NEXT i
    edLines[edCount - 1] = ""
    edCount = edCount - 1
ENDSUB

SUB ED_BACKSPACE()
    DIM s AS STRING
    IF edCol > 0 THEN
        s = edLines[edRow]
        edLines[edRow] = LEFT$(s, edCol - 1) + MID$(s, edCol, LEN(s) - edCol)
        edCol = edCol - 1
        RETURN
    ENDIF
    IF edRow = 0 THEN RETURN
    edCol = LEN(edLines[edRow - 1])
    ED_JOIN(edRow - 1)
    edRow = edRow - 1
ENDSUB

SUB ED_DELETE()
    DIM s AS STRING
    s = edLines[edRow]
    IF edCol < LEN(s) THEN
        edLines[edRow] = LEFT$(s, edCol) + MID$(s, edCol + 1, LEN(s) - edCol - 1)
        RETURN
    ENDIF
    ED_JOIN(edRow)
ENDSUB

' ── Rendering ──────────────────────────────────────────────────────────────

FUNC ED_CLASSIFY(word AS STRING) AS INTEGER
    IF word = "if" THEN RETURN 13
    IF word = "while" THEN RETURN 13
    RETURN 10
ENDFUNC

SUB ED_DRAWLINE(screenRow AS INTEGER, msg AS STRING)
    DIM base AS INTEGER
    DIM j AS INTEGER
    DIM c AS INTEGER
    DIM wordStart AS INTEGER
    DIM attr AS INTEGER
    DIM k AS INTEGER

    base = screenRow * SCR_COLS
    j = 0
    DO
        IF j >= LEN(msg) THEN EXITDO
        c = CINT(BYTEAT(msg, j))

        IF c = 39 THEN
            DO
                IF j >= LEN(msg) THEN EXITDO
                IF j >= SCR_COLS THEN EXITDO
                SCR_CELL(base + j, CINT(BYTEAT(msg, j)), 8)
                j = j + 1
            LOOP
            EXITDO
        ENDIF

        IF IS_DIGIT(c) = 1 THEN
            DO
                IF j >= LEN(msg) THEN EXITDO
                IF IS_DIGIT(CINT(BYTEAT(msg, j))) = 0 THEN EXITDO
                IF j < SCR_COLS THEN SCR_CELL(base + j, CINT(BYTEAT(msg, j)), 14)
                j = j + 1
            LOOP
        ELSE
            IF IS_ALPHA(c) = 1 THEN
                wordStart = j
                DO
                    IF j >= LEN(msg) THEN EXITDO
                    IF IS_ALPHA(CINT(BYTEAT(msg, j))) = 0 AND IS_DIGIT(CINT(BYTEAT(msg, j))) = 0 THEN EXITDO
                    j = j + 1
                LOOP
                attr = CINT(ED_CLASSIFY(MID$(msg, wordStart, j - wordStart)))
                FOR k = wordStart TO j - 1
                    IF k < SCR_COLS THEN SCR_CELL(base + k, CINT(BYTEAT(msg, k)), attr)
                NEXT k
            ELSE
                IF j < SCR_COLS THEN SCR_CELL(base + j, c, 15)
                j = j + 1
            ENDIF
        ENDIF
    LOOP

    DO
        IF j >= SCR_COLS THEN EXITDO
        SCR_CELL(base + j, 32, 7)
        j = j + 1
    LOOP
ENDSUB

SUB ED_BAR(screenRow AS INTEGER, msg AS STRING, attr AS INTEGER)
    DIM base AS INTEGER
    DIM j AS INTEGER
    base = screenRow * SCR_COLS
    FOR j = 0 TO SCR_COLS - 1
        IF j < LEN(msg) THEN
            SCR_CELL(base + j, CINT(BYTEAT(msg, j)), attr)
        ELSE
            SCR_CELL(base + j, 32, attr)
        ENDIF
    NEXT j
ENDSUB

FUNC ED_NUM$(v AS INTEGER) AS STRING
    DIM digits AS STRING
    DIM n AS INTEGER
    n = v
    IF n = 0 THEN RETURN "0"
    digits = ""
    DO
        digits = CHR$(48 + n MOD 10) + digits
        n = n \ 10
    LOOP WHILE n > 0
    RETURN digits
ENDFUNC

SUB ED_SCROLL()
    IF edRow < edTop THEN edTop = edRow
    IF edRow > edTop + ED_ROWS - 1 THEN edTop = edRow - ED_ROWS + 1
    IF edTop < 0 THEN edTop = 0
ENDSUB

SUB ED_RENDER()
    DIM sr AS INTEGER
    DIM lineNo AS INTEGER
    DIM base AS INTEGER
    DIM j AS INTEGER
    DIM status AS STRING

    ED_SCROLL()
    FOR sr = 0 TO ED_ROWS - 1
        lineNo = edTop + sr
        IF lineNo < edCount THEN
            ED_DRAWLINE(sr, edLines[lineNo])
        ELSE
            base = sr * SCR_COLS
            SCR_CELL(base, 126, 9)
            FOR j = 1 TO SCR_COLS - 1
                SCR_CELL(base + j, 32, 7)
            NEXT j
        ENDIF
    NEXT sr

    status = " line " + ED_NUM$(edRow + 1) + "/" + ED_NUM$(edCount)
    status = status + "   col " + ED_NUM$(edCol + 1)
    ED_BAR(ED_ROWS, status, 112)
    ED_BAR(ED_ROWS + 1, " F5 run   ESC back to the prompt   arrows move", 112)

    SCR_CURSOR((edRow - edTop) * SCR_COLS + edCol)
ENDSUB

' ── Running the buffer ─────────────────────────────────────────────────────

SUB ED_RUN()
    DIM i AS INTEGER
    DIM discard AS INTEGER
    scrAttr = 7
    SCR_CLEAR()
    FOR i = 0 TO edCount - 1
        IF LEN(edLines[i]) > 0 THEN
            RUN_TEXT(edLines[i])
        ENDIF
    NEXT i
    SCR_NEWLINE()
    scrAttr = 15
    SCR_WRITE("-- press a key --")
    scrAttr = 7
    discard = CINT(KB_READ())
ENDSUB

SUB ED_MAIN()
    DIM ch AS INTEGER
    DIM j AS INTEGER

    DO
        ED_RENDER()
        ch = CINT(KB_READ())

        IF ch = KEY_ESC THEN RETURN
        IF ch = K_F5 THEN ED_RUN()
        IF ch = K_UP THEN edRow = edRow - 1
        IF ch = K_DOWN THEN edRow = edRow + 1
        IF ch = K_LEFT THEN edCol = edCol - 1
        IF ch = K_RIGHT THEN edCol = edCol + 1
        IF ch = K_HOME THEN edCol = 0
        IF ch = K_END THEN edCol = LEN(edLines[edRow])
        IF ch = K_PGUP THEN edRow = edRow - ED_ROWS
        IF ch = K_PGDN THEN edRow = edRow + ED_ROWS
        IF ch = K_DEL THEN ED_DELETE()
        IF ch = KEY_BACK THEN ED_BACKSPACE()
        IF ch = KEY_ENTER THEN ED_ENTER()
        IF ch = 9 THEN
            FOR j = 1 TO 4
                ED_INSERT(32)
            NEXT j
        ENDIF
        IF ch >= 32 AND ch < 256 THEN ED_INSERT(ch)

        ED_CLAMP()
    LOOP
ENDSUB

' ── RAM disk and commands ──────────────────────────────────────────────────
'
' Programs are kept as one string per slot with CHR$(10) between lines, so the
' whole disk is two string arrays. A line whose first character is an uppercase
' letter is a command rather than code.

FUNC IS_UPPER(c AS INTEGER) AS INTEGER
    IF c >= 65 AND c <= 90 THEN RETURN 1
    RETURN 0
ENDFUNC

FUNC ED_TEXT$() AS STRING
    DIM out AS STRING
    DIM i AS INTEGER
    out = ""
    FOR i = 0 TO edCount - 1
        IF i > 0 THEN out = out + CHR$(10)
        out = out + edLines[i]
    NEXT i
    RETURN out
ENDFUNC

SUB ED_SETTEXT(body AS STRING)
    DIM rest AS STRING
    DIM p AS INTEGER
    DIM n AS INTEGER

    ED_INIT()
    rest = body
    n = 0
    DO
        IF n >= ED_MAXLINES THEN EXITDO
        p = CINT(INSTR(rest, CHR$(10)))
        IF p < 0 THEN
            edLines[n] = rest
            n = n + 1
            EXITDO
        ENDIF
        edLines[n] = LEFT$(rest, p)
        n = n + 1
        rest = MID$(rest, p + 1, LEN(rest) - p - 1)
    LOOP
    edCount = n
    IF edCount < 1 THEN edCount = 1
ENDSUB

FUNC DSK_FIND(nm AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO dskCount - 1
        IF dskNames[i] = nm THEN RETURN i
    NEXT i
    RETURN -1
ENDFUNC

SUB DSK_SAVE(nm AS STRING)
    DIM idx AS INTEGER
    IF LEN(nm) = 0 THEN
        SCR_WRITELN("save needs a name")
        RETURN
    ENDIF
    idx = CINT(DSK_FIND(nm))
    IF idx < 0 THEN
        IF dskCount >= DSK_MAX THEN
            SCR_WRITELN("disk full")
            RETURN
        ENDIF
        idx = dskCount
        dskCount = dskCount + 1
    ENDIF
    dskNames[idx] = nm
    dskText[idx] = ED_TEXT$()
    SCR_WRITE("saved ")
    SCR_WRITELN(nm)
ENDSUB

SUB DSK_LOAD(nm AS STRING)
    DIM idx AS INTEGER
    idx = CINT(DSK_FIND(nm))
    IF idx < 0 THEN
        SCR_WRITELN("not found")
        RETURN
    ENDIF
    ED_SETTEXT(dskText[idx])
    SCR_WRITE("loaded ")
    SCR_WRITELN(nm)
ENDSUB

SUB DSK_DIR()
    DIM i AS INTEGER
    IF dskCount = 0 THEN
        SCR_WRITELN("no programs")
        RETURN
    ENDIF
    FOR i = 0 TO dskCount - 1
        SCR_WRITE("  ")
        SCR_WRITELN(dskNames[i])
    NEXT i
ENDSUB

SUB ED_LIST()
    DIM i AS INTEGER
    FOR i = 0 TO edCount - 1
        SCR_WRITELN(edLines[i])
    NEXT i
ENDSUB

SUB RUN_BUFFER()
    DIM i AS INTEGER
    FOR i = 0 TO edCount - 1
        IF LEN(edLines[i]) > 0 THEN
            RUN_TEXT(edLines[i])
        ENDIF
    NEXT i
ENDSUB

SUB CMD_HELP()
    SCR_WRITELN("DIR          list stored programs")
    SCR_WRITELN("SAVE name    store the buffer")
    SCR_WRITELN("LOAD name    recall into the buffer")
    SCR_WRITELN("RUN [name]   run the buffer, or load then run")
    SCR_WRITELN("LIST         print the buffer")
    SCR_WRITELN("NEW          empty the buffer")
    SCR_WRITELN("CLS          clear the screen")
    SCR_WRITELN("F2           open the editor")
ENDSUB

SUB RUN_COMMAND(lineIn AS STRING)
    DIM word AS STRING
    DIM arg AS STRING
    DIM p AS INTEGER

    p = CINT(INSTR(lineIn, " "))
    IF p < 0 THEN
        word = lineIn
        arg = ""
    ELSE
        word = LEFT$(lineIn, p)
        arg = MID$(lineIn, p + 1, LEN(lineIn) - p - 1)
        DO
            IF LEN(arg) = 0 THEN EXITDO
            IF BYTEAT(arg, 0) <> 32 THEN EXITDO
            arg = MID$(arg, 1, LEN(arg) - 1)
        LOOP
    ENDIF

    IF word = "CLS" THEN
        SCR_CLEAR()
        RETURN
    ENDIF
    IF word = "NEW" THEN
        ED_INIT()
        SCR_WRITELN("new")
        RETURN
    ENDIF
    IF word = "LIST" THEN
        ED_LIST()
        RETURN
    ENDIF
    IF word = "DIR" THEN
        DSK_DIR()
        RETURN
    ENDIF
    IF word = "SAVE" THEN
        DSK_SAVE(arg)
        RETURN
    ENDIF
    IF word = "LOAD" THEN
        DSK_LOAD(arg)
        RETURN
    ENDIF
    IF word = "RUN" THEN
        IF LEN(arg) > 0 THEN DSK_LOAD(arg)
        RUN_BUFFER()
        RETURN
    ENDIF
    IF word = "HELP" THEN
        CMD_HELP()
        RETURN
    ENDIF

    SCR_WRITE("unknown command: ")
    SCR_WRITELN(word)
ENDSUB

' ── Main ───────────────────────────────────────────────────────────────────

DIM lineText AS STRING

scrAttr = 7
scrPos = 0
varCount = 0
errCode = 0

SCR_CLEAR()
scrAttr = 15
SCR_WRITELN("jdBasic OS - a REPL written in jdBasic")
scrAttr = 7
SCR_WRITELN("? expr prints    x = expr assigns    if/while cond { }    ; separates")
SCR_WRITELN("F2 opens the editor, HELP lists commands, ESC halts")
SCR_NEWLINE()

KB_INIT()

ED_INIT()
dskCount = 0

DO
    SCR_WRITE("> ")
    lineText = KB_READLINE$()
    IF lineExit = 1 THEN
        SCR_NEWLINE()
        SCR_WRITELN("halted.")
        EXITDO
    ENDIF
    IF lineExit = 2 THEN
        ED_MAIN()
        scrAttr = 7
        SCR_CLEAR()
        SCR_WRITELN("back at the prompt")
    ELSE
        IF LEN(lineText) > 0 AND IS_UPPER(CINT(BYTEAT(lineText, 0))) = 1 THEN
            RUN_COMMAND(lineText)
        ELSE
            RUN_TEXT(lineText)
        ENDIF
    ENDIF
LOOP
